// ДОПОЛНИТЕЛЬНЫЕ ФУНКЦИИ
Функция ОплатаПоСоцтраху(ЛС, ПериодНачисления)
	Запрос = Новый Запрос;
	Запрос.Текст =
	    "ВЫБРАТЬ
	    |	ПоступлениеНаСчет.СуммаДокумента,
	    |	ПоступлениеНаСчет.ВидНачисления,
	    |	ПоступлениеНаСчет.Дата
	    |ИЗ
	    |	Документ.ПоступлениеНаСчет КАК ПоступлениеНаСчет
	    |ГДЕ
	    |	ПоступлениеНаСчет.Проведен = ИСТИНА
	    |	И ПоступлениеНаСчет.ЛицевойСчет = &ЛицевойСчет";
		//|	И ПоступлениеНаСчет.Дата МЕЖДУ &НачПериода И &КонПериода";
	Запрос.УстановитьПараметр("ЛицевойСчет", ЛС);
	//Запрос.УстановитьПараметр("НачПериода", НачалоМесяца(ПериодНачисления));
	//Запрос.УстановитьПараметр("КонПериода", КонецМесяца(ПериодНачисления));
	
	Результат = Запрос.Выполнить();
	Соцстрах = Новый Структура;
	Если НЕ Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл
			Соцстрах.Вставить("СуммаДокумента", Выборка.СуммаДокумента);
			Соцстрах.Вставить("ВидНачисления", Выборка.ВидНачисления);
			Соцстрах.Вставить("Дата", Выборка.Дата);
		КонецЦикла;
	Иначе
		Соцстрах.Вставить("СуммаДокумента", "");
		Соцстрах.Вставить("ВидНачисления", "");
	КонецЕсли;
	Возврат Соцстрах;
КонецФункции

Функция ДанныеПоЛС(ЛицевыеСчета)
	Запрос = Новый Запрос;
	Запрос.Текст =
	    "ВЫБРАТЬ
	    |	НазначенныеУслугиСрезПоследних.Услуга,
	    |	НазначенныеУслугиСрезПоследних.Услуга.ВидУслуги КАК ВидУслуги,
	    |	НазначенныеУслугиСрезПоследних.Услуга.ЕдиницаИзмерения КАК ЕдиницаИзмерения
	    |ИЗ
	    |	РегистрСведений.НазначенныеУслуги.СрезПоследних(
	    |			&НаДату,
	    |			ЛицевойСчет = &ЛицевойСчет
	    |				И Действует = ИСТИНА) КАК НазначенныеУслугиСрезПоследних";
	Запрос.УстановитьПараметр("НаДату", ТекущаяДата());
	Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевыеСчета);
	
	Результат = Запрос.Выполнить().Выгрузить();
	Возврат Результат;
КонецФункции

Функция ЛицевойСчетПоGUID(УИД) Экспорт
	НовыйGUID = Новый УникальныйИдентификатор(УИД);
	ЛС = Справочники.ЛицевыеСчета.ПолучитьСсылку(НовыйGUID);
	Возврат ЛС;
КонецФункции

Функция ПриборУчетаПоGUID(УИД) Экспорт
	НовыйGUID = Новый УникальныйИдентификатор(УИД);
	Прибор = Справочники.ПриборыУчета.ПолучитьСсылку(НовыйGUID);
	Возврат Прибор;
КонецФункции


