// ОСНОВНЫЕ ФУНКЦИИ ДЛЯ ВЫГРУЗКИ

// Дані абонентів – фізичних осіб
Функция ВыборкаЛицевыхСчетов(CODE) Экспорт
	тзЛС = Новый ТаблицаЗначений;
	тзЛС.Колонки.Добавить("ACCOUNT_CODE");                  //Унікальний ідентифікатор (УІД) особового рахунку абонента
	тзЛС.Колонки.Добавить("ACCOUNT_NUMBER");                //Номер особового рахунку
	тзЛС.Колонки.Добавить("ACCOUNT_STATE");                 //Стан особового рахунку   active – відкритий о/р, closed – закритий о/р
	тзЛС.Колонки.Добавить("LOCALITY_CODE");                 //Код КОАТУУ населеного пункту
	тзЛС.Колонки.Добавить("DISTRICT_CODE");                 //Код КОАТУУ району населеного пункту
	тзЛС.Колонки.Добавить("AREA_NAME");                     //Назва місцевості
	тзЛС.Колонки.Добавить("STREET_TYPE");                   //Скорочене найменування типу вулиці
	тзЛС.Колонки.Добавить("STREET_NAME");                   //Найменування вулиці
	тзЛС.Колонки.Добавить("BUILDING_POST_CODE");            //Поштовий індекс
	тзЛС.Колонки.Добавить("BUILDING_ENTRANCES_N");          //Кількість під’їздів в будинку
	тзЛС.Колонки.Добавить("BUILDING_FLOORS_N");             //Кількість поверхів в будинку
	тзЛС.Колонки.Добавить("BUILDING_APARTMENTS_N");         //Кількість квартир в будинку
	тзЛС.Колонки.Добавить("BUILDING_APARTMENTS_PER_FLOOR"); //Кількість квартир на одному поверсі будинку
	тзЛС.Колонки.Добавить("BUILDING_NUMBER");               //Номер будинку
	тзЛС.Колонки.Добавить("ADDRESS_ENTRANCE");              //Номер під’їзду
	тзЛС.Колонки.Добавить("ADDRESS_FLOOR");                 //Поверх
	тзЛС.Колонки.Добавить("ADDRESS_APARTMENT");             //Номер квартири
	тзЛС.Колонки.Добавить("HABITATION_TYPE");               //Тип домоволодіння private – приватний або малоквартирний будинок,
                                                            //condominium – ізольована квартира у багатоквартирному будинку,
                                                            //apartment – кімната у гуртожитку, комунальній квартирі або у будинку
                                                            //            готельного типу
	тзЛС.Колонки.Добавить("DELEGATE_LAST_NAME");            //Прізвище відповідального квартиронаймача
	тзЛС.Колонки.Добавить("DELEGATE_FIRST_NAME");           //Ім’я відповідального квартиронаймача
    тзЛС.Колонки.Добавить("DELEGATE_MIDDLE_NAME");          //По-батькові відповідального квартиронаймача
	тзЛС.Колонки.Добавить("DELEGATE_TAX_CODE");             //ІНН відповідального квартиронаймача
	тзЛС.Колонки.Добавить("DELEGATE_BIRTH_DATE");           //Дата народження відповідального квартиронаймача date(YYYY-MM-DD)
	

	// Выборка ЛС
	Запрос = Новый Запрос;
	Запрос.Текст =
	    "ВЫБРАТЬ
	    |	ЛицевыеСчетаСрезПоследних.ЛицевойСчет КАК НомерЛС,
	    |	ЛицевыеСчетаСрезПоследних.ЛицевойСчет.Владелец КАК Адрес,
	    |	ЛицевыеСчетаСрезПоследних.ЛицевойСчет.ОбъектЛицевогоСчета КАК Квартира,
	    |	ЛицевыеСчетаСрезПоследних.ЛицевойСчет.МобТелефон КАК Телефон,
	    |	ЛицевыеСчетаСрезПоследних.ЛицевойСчет.КодКОАТУУ КАК КОАТУУ,
	    |	ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ОтветственныйВладелец,
	    |	ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ОтветственныйВладелец.ФизЛицо.ДатаРождения КАК ДатаРождения,
	    |	ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ОтветственныйВладелец.ФизЛицо.ИНН КАК ИНН,
	    |	ЛицевыеСчетаСрезПоследних.ЛицевойСчет.Владелец.КоличествоПодъездов КАК КоличествоПодъездов,
	    |	ЛицевыеСчетаСрезПоследних.ЛицевойСчет.Владелец.КоличествоЭтажей КАК КоличествоЭтажей,
	    |	ЛицевыеСчетаСрезПоследних.ЛицевойСчет.Код КАК Код,
	    |	ЛицевыеСчетаСрезПоследних.ЛицевойСчет.Владелец.ЧастныйСектор КАК ЧастныйСектор,
	    |	ЛицевыеСчетаСрезПоследних.ЛицевойСчет.Владелец.МногоКвартирный КАК МногоКвартирный
	    |ИЗ
	    |	РегистрСведений.ЛицевыеСчета.СрезПоследних(&НаДату, Действует = ИСТИНА) КАК ЛицевыеСчетаСрезПоследних
	    |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОтветственныйВладелецЛицевогоСчета.СрезПоследних(&НаДату, ) КАК ОтветственныйВладелецЛицевогоСчетаСрезПоследних
	    |		ПО ЛицевыеСчетаСрезПоследних.ЛицевойСчет = ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ЛицевойСчет";
	Запрос.УстановитьПараметр("НаДату", КонецДня(ТекущаяДата()));
	тзЛицСчета = Запрос.Выполнить().Выгрузить();
	Для Каждого стр ИЗ тзЛицСчета Цикл
		Если стр.НомерЛС.Наименование = "9999" ИЛИ стр.НомерЛС.Наименование = "99999" Тогда
			Продолжить;
		Иначе
			ФИО = УправлениеКонтактнойИнформацией.РазложитьСтрокуНаПодстроки(стр.ОтветственныйВладелец, " ");
			Если ФИО.Количество() = 1 Тогда
				Фамилия = ФИО[0];
			КонецЕсли;
			Если ФИО.Количество() = 2 Тогда
				Фамилия = ФИО[0];
				Имя     = ФИО[1];
			КонецЕсли;
			Если ФИО.Количество() = 3 Тогда
				Фамилия  = ФИО[0];
				Имя      = ФИО[1];
				Отчество = ФИО[2];
			КонецЕсли;
			Адрес = УправлениеКонтактнойИнформацией.РазложитьСтрокуНаПодстроки(стр.Адрес, ",");
			Если Адрес[2] = " м.Миргород" ИЛИ Адрес[2] = " м. Миргород" Тогда
				Индекс  = Адрес[4];
				Область = Адрес[3];
				Город   = Адрес[2];
				Улица   = Адрес[1];
				Дом     = Адрес[0];
			Иначе
				//Индекс  = Адрес[5];
				Область = Адрес[4];
				Район   = Адрес[2];
				Город   = Адрес[3];
				Улица   = Адрес[1];
				Дом     = Адрес[0];
			КонецЕсли;
			НовСтрока = тзЛС.Добавить();
			НовСтрока.ACCOUNT_CODE                  = стр.НомерЛС.УникальныйИдентификатор();
			НовСтрока.ACCOUNT_NUMBER                = Строка(стр.НомерЛС);
			НовСтрока.ACCOUNT_STATE                 = "active";
			НовСтрока.LOCALITY_CODE                 = стр.КОАТУУ;
			НовСтрока.DISTRICT_CODE                 = "";
			НовСтрока.AREA_NAME                     = "";
			НовСтрока.STREET_TYPE                   = "";
			НовСтрока.STREET_NAME                   = Улица;
			НовСтрока.BUILDING_POST_CODE            = Индекс;
			Если стр.КоличествоПодъездов = 0 Тогда
				НовСтрока.BUILDING_ENTRANCES_N      = "";
			Иначе
			    НовСтрока.BUILDING_ENTRANCES_N      = стр.КоличествоПодъездов;
			КонецЕсли;
			Если стр.КоличествоЭтажей = 0 Тогда
				НовСтрока.BUILDING_FLOORS_N         = "";
			Иначе
			    НовСтрока.BUILDING_FLOORS_N         = стр.КоличествоЭтажей;
			КонецЕсли;
			НовСтрока.BUILDING_APARTMENTS_N         = "";
			НовСтрока.BUILDING_APARTMENTS_PER_FLOOR = "";
			НовСтрока.BUILDING_NUMBER               = Сред(Дом, 7);
			НовСтрока.ADDRESS_ENTRANCE              = "";
			НовСтрока.ADDRESS_FLOOR                 = "";
			Если стр.Квартира = "кв. №.  0" Тогда
				НовСтрока.ADDRESS_APARTMENT         = "";
			Иначе
			    НовСтрока.ADDRESS_APARTMENT         = Сред(стр.Квартира, 6);
			КонецЕсли;
			Если стр.ЧастныйСектор = Ложь И стр.МногоКвартирный = Ложь Тогда
				НовСтрока.HABITATION_TYPE           = "private";
			КонецЕсли;
			Если стр.ЧастныйСектор = Истина Тогда
			    НовСтрока.HABITATION_TYPE           = "private";
			КонецЕсли;
			Если стр.МногоКвартирный = Истина Тогда
				НовСтрока.HABITATION_TYPE           = "condominium";
			КонецЕсли;
			НовСтрока.DELEGATE_LAST_NAME            = стр.ОтветственныйВладелец; //Фамилия;
			НовСтрока.DELEGATE_FIRST_NAME           = "";
			НовСтрока.DELEGATE_MIDDLE_NAME          = "";
			НовСтрока.DELEGATE_TAX_CODE             = стр.ИНН;
			Если стр.ДатаРождения                   = '00010101' Тогда
				НовСтрока.DELEGATE_BIRTH_DATE       = "";
			Иначе
			    НовСтрока.DELEGATE_BIRTH_DATE       = Формат(стр.ДатаРождения, "ДФ=dd.MM.yyyy");
			КонецЕсли;
			
			// Очистим переменные
			Фамилия  = "";
			Имя      = "";
			Отчество = "";
			Индекс   = "";
			Область  = "";
			Район    = "";
			Город    = "";
			Улица    = "";
			Дом      = "";
		КонецЕсли;
	КонецЦикла;
	Возврат тзЛС;
КонецФункции

// Контактні дані абонентів, закріплені за особовими рахунками.
Функция КонтактныеДанные() Экспорт
	тзКонтактныеДанные = Новый ТаблицаЗначений;
	тзКонтактныеДанные.Колонки.Добавить("ACCOUNT_CODE");  // УІД особового рахунку абонента
	тзКонтактныеДанные.Колонки.Добавить("PSTN_CODE");     // Телефонний код населеного пункту
	тзКонтактныеДанные.Колонки.Добавить("CONTACT_TYPE");  // Тип контактних даних
														  // enum
													      // Допустимі значення:
														  // cell – мобільний телефон,
														  // pstn – стаціонарний телефон,
														  // phone – телефон невизначеного типу,
														  // phones – декілька телефонів,
														  // mail – електрона пошта
														  // За замовченням дорівнює «phones»
														  // Якщо не ведеться – залишити пустим.
	тзКонтактныеДанные.Колонки.Добавить("CONTACT_DATA");  // Контактні дані (телефон, e-mail)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	    "ВЫБРАТЬ
	    |	ЛицевыеСчетаСрезПоследних.ЛицевойСчет КАК НомерЛС,
	    |	ЛицевыеСчетаСрезПоследних.ЛицевойСчет.МобТелефон КАК Телефон
	    |ИЗ
	    |	РегистрСведений.ЛицевыеСчета.СрезПоследних(&НаДату, Действует = ИСТИНА) КАК ЛицевыеСчетаСрезПоследних";
	Запрос.УстановитьПараметр("НаДату", КонецДня(ТекущаяДата()));
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		НовСтрока = тзКонтактныеДанные.Добавить();
		НовСтрока.ACCOUNT_CODE = Выборка.НомерЛС.УникальныйИдентификатор();
		НовСтрока.PSTN_CODE    = "";
		НовСтрока.CONTACT_TYPE = "cell";
		ДлиннаНомераТелефона = СтрДлина(Выборка.Телефон);
		Если ДлиннаНомераТелефона < 10 Тогда
			НовСтрока.CONTACT_DATA = "";
		Иначе
			НовСтрока.CONTACT_DATA = Выборка.Телефон;
		КонецЕсли;
	КонецЦикла;
	Возврат тзКонтактныеДанные;
КонецФункции

// Дані по діючим послугам, які надаються абонентам по кожному особовому рахунку
Функция УслугиЛицевыхСчетов() Экспорт
	тзУслуги = Новый ТаблицаЗначений;
	тзУслуги.Колонки.Добавить("ACCOUNT_CODE");                          // УІД особового рахунку абонента
	тзУслуги.Колонки.Добавить("PROVIDER_CODE");                         // Код ЕДРПОУ постачальника послуг
	тзУслуги.Колонки.Добавить("INDUSTRY_TYPE");                         // Тип галузі надання послуг 
	                                                                    // house – утримання будинків,
																		// water – водопостачання,
                                                                        // heat – теплопостачання,
                                                                        // garbage – вивіз відходів
	тзУслуги.Колонки.Добавить("GROUP_TYPE");                            // house.maintenance – утримання будинків
																		// water.supply – водопостачання,
																		// water.sewerage – водовідведення,
																		// water.service – сервісні водопровідні послуги,
																		// water.additional – додаткові водопровідні послуги,
																		// heat.heating – опалювання,
																		// heat.water – гаряче водопостачання,
																		// heat.service – сервісні теплові послуги,
																		// heat.additional – додаткові теплові послуги,
																		// garbage.collection – вивіз ТПВ,
	тзУслуги.Колонки.Добавить("SERVICE_TYPE");                          // water.supply.cold – холодна вода,
	                                                                    // water.supply.hot – вода на підігрів,
																		// water.sewerage.cold – стоки хол. води,
                                                                        // water.sewerage.hot – стоки гар. води,
                                                                        // water.service.fee – абонплата за водопостачання
	тзУслуги.Колонки.Добавить("SERVICE_UNIT");							// Одиниця виміру об’єму послуги
	тзУслуги.Колонки.Добавить("CHARACTERISTIC_TYPE");                   // Тип характеристики домоволодіння 
	                                                                    // m3 – метр кубічний
	                                                                    // residentsNumber – кількість мешканців,
                                                                        // livingArea – житлова площа,
                                                                        // heatingArea – площа опалювання
	Запрос = Новый Запрос;
	Запрос.Текст = 
	    "ВЫБРАТЬ
	    |	ЛицевыеСчетаСрезПоследних.ЛицевойСчет
	    |ИЗ
	    |	РегистрСведений.ЛицевыеСчета.СрезПоследних(&НаДату, Действует = ИСТИНА) КАК ЛицевыеСчетаСрезПоследних";
	Запрос.УстановитьПараметр("НаДату", НачалоДня(ТекущаяДата()));
	ЛС = Запрос.Выполнить().Выгрузить();
	Для Каждого стр Из ЛС Цикл
		ДанныеЛС = ДанныеПоЛС(стр.ЛицевойСчет);
		Для Каждого Услуги Из ДанныеЛС Цикл
			Если ДанныеЛС.Количество() <> 0 Тогда
