// Дані по історії показань приладів обліку.
Функция ПоказанияПриборовУчета() Экспорт
	тзПоказания = Новый ТаблицаЗначений;
	тзПоказания.Колонки.Добавить("ACCOUNT_CODE");
	тзПоказания.Колонки.Добавить("GROUP_TYPE");
	тзПоказания.Колонки.Добавить("PACKAGE_INDICATED");
	тзПоказания.Колонки.Добавить("PACKAGE_SOURCE");
	тзПоказания.Колонки.Добавить("INDICATOR_CODE");
	тзПоказания.Колонки.Добавить("INDICATION_PREVENT");
	тзПоказания.Колонки.Добавить("INDICATION_CURRENT");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	    "ВЫБРАТЬ
	    |	ВводПоказанийПриборовЗаМесяцПоказания.ЛицевойСчет,
	    |	ВводПоказанийПриборовЗаМесяцПоказания.ПриборУчета.Услуга КАК Услуга,
	    |	ВводПоказанийПриборовЗаМесяцПоказания.Ссылка.Дата,
	    |	ВводПоказанийПриборовЗаМесяцПоказания.ПриборУчета,
	    |	ВводПоказанийПриборовЗаМесяцПоказания.ПоказаниеПредыдущее,
	    |	ВводПоказанийПриборовЗаМесяцПоказания.Показание,
	    |	ВводПоказанийПриборовЗаМесяцПоказания.Источник
	    |ИЗ
	    |	Документ.ВводПоказанийПриборовЗаМесяц.Показания КАК ВводПоказанийПриборовЗаМесяцПоказания
	    |ГДЕ
	    |	ВводПоказанийПриборовЗаМесяцПоказания.Ссылка.Проведен = ИСТИНА
	    |	И ВводПоказанийПриборовЗаМесяцПоказания.Ссылка.ПометкаУдаления = ЛОЖЬ";
	//Запрос.УстановитьПараметр("НачПериода", НачалоМесяца(ТекущаяДата()));
	//Запрос.УстановитьПараметр("КонПериода", КонецМесяца(ТекущаяДата()));
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		НовСтрока = тзПоказания.Добавить();
		НовСтрока.ACCOUNT_CODE = Выборка.ЛицевойСчет.УникальныйИдентификатор();
		Если Выборка.Услуга         = Справочники.Услуги.НайтиПоКоду("000000048") ИЛИ Выборка.Услуга = Справочники.Услуги.НайтиПоКоду("Р00000148") Тогда
		    НовСтрока.GROUP_TYPE    = "water";
		ИначеЕсли Выборка.Услуга    = Справочники.Услуги.НайтиПоКоду("Р00000178") Тогда
			НовСтрока.GROUP_TYPE    = "heat";
		ИначеЕсли Выборка.Услуга = Справочники.Услуги.НайтиПоКоду("000000020") Тогда
			НовСтрока.GROUP_TYPE    = "water";
		КонецЕсли;
		НовСтрока.PACKAGE_INDICATED = Формат(НачалоМесяца(Выборка.Дата), "ДФ=yyyy.MM.dd");
		НовСтрока.INDICATOR_CODE = Выборка.ПриборУчета.УникальныйИдентификатор();
		НовСтрока.INDICATION_PREVENT = Выборка.ПоказаниеПредыдущее;
		НовСтрока.INDICATION_CURRENT = Выборка.Показание;
		НовСтрока.PACKAGE_SOURCE = "Оператор";
	КонецЦикла;
	Возврат тзПоказания;
КонецФункции

