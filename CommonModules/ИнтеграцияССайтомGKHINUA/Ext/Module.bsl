// Дані по сплатам.
Функция ОплатыПоЛицевымСчетам() Экспорт
	тзОплаты = Новый ТаблицаЗначений;
	тзОплаты.Колонки.Добавить("ACCOUNT_CODE");
	тзОплаты.Колонки.Добавить("INDUSTRY_TYPE");
	тзОплаты.Колонки.Добавить("PROVIDER_CODE");
	тзОплаты.Колонки.Добавить("PAY_SOURCE");
	тзОплаты.Колонки.Добавить("PAY_AGENT");
	тзОплаты.Колонки.Добавить("PAY_DATE");
	тзОплаты.Колонки.Добавить("PAY_SUM");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	    "ВЫБРАТЬ
	    |	ОплатаУслугМВК.Дата,
	    |	ОплатаУслугМВК.ЛицевойСчет,
	    |	ОплатаУслугМВК.ЛицевойСчет.Владелец.Организация.КодПоЕДРПОУ КАК КодЕДРПОУ,
	    |	ОплатаУслугМВК.СуммаПлатежа,
	    |	ОплатаУслугМВК.БанковскийСчет
	    |ИЗ
	    |	Документ.ОплатаУслугМВК КАК ОплатаУслугМВК
	    |ГДЕ
	    |	ОплатаУслугМВК.ПометкаУдаления = ЛОЖЬ
	    |	И ОплатаУслугМВК.Проведен = ИСТИНА";
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		НовСтрока = тзОплаты.Добавить();
		НовСтрока.ACCOUNT_CODE  = Выборка.ЛицевойСчет.УникальныйИдентификатор();
		НовСтрока.PROVIDER_CODE = Выборка.КодЕДРПОУ;
		Организация = Справочники.Организации.НайтиПоРеквизиту("КодПоЕДРПОУ", "03362560");
		Если Выборка.КодЕДРПОУ = Организация.КодПоЕДРПОУ Тогда
			НовСтрока.INDUSTRY_TYPE = "water";
		КонецЕсли;
		НовСтрока.PAY_DATE      = Формат(Выборка.Дата, "ДФ=dd.MM.yyyy");
		НовСтрока.PAY_SUM       = Выборка.СуммаПлатежа;
		НовСтрока.PAY_AGENT     = Выборка.БанковскийСчет.Банк.Наименование;
		НовСтрока.PAY_SOURCE    = "bank";
	КонецЦикла;
	Возврат тзОплаты;
КонецФункции

