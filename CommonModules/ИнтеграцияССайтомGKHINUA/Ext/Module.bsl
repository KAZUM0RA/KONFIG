// Дані по приладам обліку та показникам.
Функция ПриборыУчетаЛицевыхСчетов() Экспорт
	тзПриборы = Новый ТаблицаЗначений;
	тзПриборы.Колонки.Добавить("ACCOUNT_CODE");               // УІД особового рахунку абонента
	тзПриборы.Колонки.Добавить("GROUP_TYPE");                 // Тип групи приладів обліку
	                                                          // power – прилади обліку електроенергії,
                                                              // gas – прилади обліку газу,
                                                              // water – прилади обліку води,
                                                              // heat – прилади обліку тепла
	тзПриборы.Колонки.Добавить("GROUP_START_DAY");            // Перший день місяця прийому показників За замовченням дорівнює «1»
	тзПриборы.Колонки.Добавить("GROUP_FINISH_DAY");           // Останній день місяця прийому показників  «-1» дорівнює останньому календарному дню
	тзПриборы.Колонки.Добавить("METER_CODE");                 // УІД приладу обліку
	тзПриборы.Колонки.Добавить("METER_STATE");                // active – діючий прилад обліку,
                                                              // inactive – на обслуговуванні (наприклад у стані повірки),
                                                              // removed – знятий з обліку.
	тзПриборы.Колонки.Добавить("METER_TYPE");                 // Тип приладу обліку
	                                                          // water.cold – прилад обліку холодної води,
                                                              // water.hot – прилад обліку гарячої води,
                                                              // heat.heating – прилад обліку теплової енергії
	тзПриборы.Колонки.Добавить("METER_SERIAL");				  // Заводський номер приладу обліку
	тзПриборы.Колонки.Добавить("METER_MODEL");                // Модель приладу обліку   
	тзПриборы.Колонки.Добавить("METER_CONFIRMED");            // Дата останньої повірки приладу обліку
	тзПриборы.Колонки.Добавить("METER_NCONFIRMD");            // Дата наступної повірки приладу обліку
    тзПриборы.Колонки.Добавить("METER_INTERVAL");             // Міжповірочний інтервал
	тзПриборы.Колонки.Добавить("INDICATOR_TYPE");             // Тип показника
	                                                          // water.cold – витрата холодної води,
                                                              // water.hot – витрата гарячої води
															  // heat.heating – витрата теплової енергії,
                                                              // heat.volume – об’єм теплоносія,
                                                              // heat.t.in – температура подачі,
                                                              // heat.t.out – температура звороту,
                                                              // heat.time – час зняття показань
	тзПриборы.Колонки.Добавить("INDICATOR_UNIT");             // Одиниця виміру показника
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	    "ВЫБРАТЬ
	    |	УстановленныеПриборыУчетаСрезПоследних.ОбъектУстановки КАК ЛицевойСчет,
	    |	УстановленныеПриборыУчетаСрезПоследних.ПриборУчета.Услуга КАК Услуга,
	    |	УстановленныеПриборыУчетаСрезПоследних.ПриборУчета.ЗаводскойНомер КАК ЗаводскойНомер,
	    |	УстановленныеПриборыУчетаСрезПоследних.ПриборУчета.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	    |	УправлениеПриборамиУчетаПриборыУчета.ДатаПоследнейПоверки КАК ДатаПоследнейПоверки,
	    |	УправлениеПриборамиУчетаПриборыУчета.ДатаСледующейПоверки КАК ДатаСледующейПоверки,
	    |	УправлениеПриборамиУчетаПриборыУчета.ТипПрибора КАК ТипПрибора,
	    |	УстановленныеПриборыУчетаСрезПоследних.ПриборУчета КАК ПриборУчета,
	    |	УстановленныеПриборыУчетаСрезПоследних.ПриборУчета.Услуга.ВидУслуги КАК ВидУслуги
	    |ИЗ
	    |	РегистрСведений.УстановленныеПриборыУчета.СрезПоследних(&НаДату, Действует = ИСТИНА) КАК УстановленныеПриборыУчетаСрезПоследних
	    |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.УправлениеПриборамиУчета.ПриборыУчета КАК УправлениеПриборамиУчетаПриборыУчета
	    |		ПО УстановленныеПриборыУчетаСрезПоследних.ПриборУчета = УправлениеПриборамиУчетаПриборыУчета.ПриборУчета";
	Запрос.УстановитьПараметр("НаДату", ТекущаяДата());
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		НовСтрока = тзПриборы.Добавить();
		НовСтрока.ACCOUNT_CODE      = Выборка.ЛицевойСчет.УникальныйИдентификатор();
		Если Выборка.Услуга         = Справочники.Услуги.НайтиПоКоду("000000048") ИЛИ Выборка.Услуга = Справочники.Услуги.НайтиПоКоду("Р00000148") Тогда
		    НовСтрока.GROUP_TYPE    = "water";
		ИначеЕсли Выборка.Услуга    = Справочники.Услуги.НайтиПоКоду("Р00000178") Тогда
			НовСтрока.GROUP_TYPE    = "heat";
		ИначеЕсли Выборка.Услуга = Справочники.Услуги.НайтиПоКоду("000000020") Тогда
			НовСтрока.GROUP_TYPE    = "water";
		КонецЕсли;
		НовСтрока.GROUP_START_DAY   = 1;
		НовСтрока.GROUP_FINISH_DAY  = -1;
		НовСтрока.METER_CODE        = Выборка.ПриборУчета.УникальныйИдентификатор();
		НовСтрока.METER_STATE       = "active";
		Если Выборка.ВидУслуги = Справочники.ВидыУслуг.ХолоднаяВода Тогда
		    НовСтрока.METER_TYPE    = "water.cold";
			НовСтрока.INDICATOR_TYPE= "water.cold";
		ИначеЕсли Выборка.ВидУслуги = Справочники.ВидыУслуг.Водоотведение Тогда
			НовСтрока.METER_TYPE    = "water.hot";
			НовСтрока.INDICATOR_TYPE= "water.hot";
		ИначеЕсли Выборка.ВидУслуги = Справочники.ВидыУслуг.Отопление Тогда
			НовСтрока.METER_TYPE    = "heat.heating";
			НовСтрока.INDICATOR_TYPE= "heat.heating";
		КонецЕсли;
		НовСтрока.METER_SERIAL      = Выборка.ЗаводскойНомер;
		НовСтрока.METER_MODEL       = Выборка.ТипПрибора;
		Если Выборка.ДатаПоследнейПоверки = '00010101' Тогда
			НовСтрока.METER_CONFIRMED   = "";
		Иначе
		    НовСтрока.METER_CONFIRMED   = Выборка.ДатаПоследнейПоверки;
		КонецЕсли;
		Если Выборка.ДатаСледующейПоверки = '00010101' Тогда
			НовСтрока.METER_NCONFIRMD   = "";
		Иначе
		    НовСтрока.METER_NCONFIRMD   = Выборка.ДатаСледующейПоверки;
		КонецЕсли;
		НовСтрока.METER_INTERVAL    = 48;
		Если Выборка.ЕдиницаИзмерения.Наименование = "м3" Тогда
		    НовСтрока.INDICATOR_UNIT    = "m3";
		ИначеЕсли Выборка.ЕдиницаИзмерения.Наименование = "Гкал" Тогда
			//НовСтрока.INDICATOR_UNIT    = "
		КонецЕсли
	КонецЦикла;
	Возврат тзПриборы;
КонецФункции

// Дані по пломбам приладів обліку.
