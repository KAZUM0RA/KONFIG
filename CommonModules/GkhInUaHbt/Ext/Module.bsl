	    |	НазначенныеУслугиСрезПоследних.ЛицевойСчет.Владелец КАК Здание,
		|	НазначенныеУслугиСрезПоследних.Услуга КАК Услуга,
	    |	ВЫБОР НазначенныеУслугиСрезПоследних.Услуга.ВидУслуги
	    |		КОГДА ЗНАЧЕНИЕ(Справочник.ВидыУслуг.ХолоднаяВода) ТОГДА ""residentsNumber""
	    |		КОГДА ЗНАЧЕНИЕ(Справочник.ВидыУслуг.Водоотведение) ТОГДА ""residentsNumber""
	    |		ИНАЧЕ НЕОПРЕДЕЛЕНО
	    |	КОНЕЦ КАК Характеристика,
	    |	ВЫБОР НазначенныеУслугиСрезПоследних.Услуга.ВидУслуги
	    |		КОГДА ЗНАЧЕНИЕ(Справочник.ВидыУслуг.ХолоднаяВода) ТОГДА ""pp""
	    |		КОГДА ЗНАЧЕНИЕ(Справочник.ВидыУслуг.Водоотведение) ТОГДА ""pp""
	    |		ИНАЧЕ НЕОПРЕДЕЛЕНО
	    |	КОНЕЦ КАК ЕдИзмХарактеристики
	    |ИЗ
	    |	РегистрСведений.НазначенныеУслуги.СрезПоследних(, Действует" + Условие + ") КАК НазначенныеУслугиСрезПоследних
		|ГДЕ
		|	НазначенныеУслугиСрезПоследних.Услуга.СпособНачисления В (
		|		ЗНАЧЕНИЕ(Перечисление.СпособыНачисленияУслуг.ПоПоказаниямПрибораУчета),
		|		ЗНАЧЕНИЕ(Перечисление.СпособыНачисленияУслуг.ПоНормамПотребления),
		|		ЗНАЧЕНИЕ(Перечисление.СпособыНачисленияУслуг.ФиксированноеНачисление)
		|	)";
	Результат = Запрос.Выполнить().Выгрузить();
	ЗапросТариф = Новый Запрос;
	ЗапросТариф.Текст =
		"ВЫБРАТЬ
		|	ВЫБОР ТарифыСрезПоследних.ЗначениеТарифа
		|		КОГДА 0 ТОГДА НЕОПРЕДЕЛЕНО
		|		ИНАЧЕ ТарифыСрезПоследних.ЗначениеТарифа
		|	КОНЕЦ КАК RATE_VALUE,
		|	ВЫБОР ТарифыСрезПоследних.ЗначениеТарифаПоНорме
		|		КОГДА 0 ТОГДА НЕОПРЕДЕЛЕНО
		|		ИНАЧЕ ТарифыСрезПоследних.ЗначениеТарифаПоНорме
		|	КОНЕЦ КАК ТарифЗаЕдХарактеристики
		|ИЗ
		|	РегистрСведений.Тарифы.СрезПоследних(, Услуга = &Услуга И Здание = &Здание) КАК ТарифыСрезПоследних";
	Сч = Результат.Количество()-1;
	Пока Сч >= 0 Цикл
		Строка = Результат.Получить(Сч);
		Строка.ACCOUNT_CODE = Строка(Строка.ЛицевойСчет.УникальныйИдентификатор());
		ЗапросТариф.УстановитьПараметр("Здание", Строка.Здание);
		ЗапросТариф.УстановитьПараметр("Услуга", Строка.Услуга);
		РезультатТариф = ЗапросТариф.Выполнить().Выгрузить();
		Для каждого СтрокаТариф из РезультатТариф Цикл
			Строка.RATE_VALUE = СтрокаТариф.RATE_VALUE;
			Если Строка.SERVICE_CODE <> "water.subsfee.total" Тогда
				Если СтрокаТариф.ТарифЗаЕдХарактеристики <> Неопределено Тогда
					НоваяСтрока = Результат.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка, "ACCOUNT_CODE,PROVIDER_CODE,SERVICE_CODE");
					НоваяСтрока.FEATURE_CODE = Строка.Характеристика;
					НоваяСтрока.RATE_TYPE = "feature";
					НоваяСтрока.RATE_UNIT = Строка.ЕдИзмХарактеристики;
					НоваяСтрока.RATE_VALUE = СтрокаТариф.ТарифЗаЕдХарактеристики;
				КонецЕсли;
			КонецЕсли;				
		КонецЦикла;
		Сч = Сч - 1;
	КонецЦикла;
	Результат.Колонки.Удалить("ЛицевойСчет");
	Результат.Колонки.Удалить("Услуга");
	Результат.Колонки.Удалить("Здание");
	Результат.Колонки.Удалить("Характеристика");
	Результат.Колонки.Удалить("ЕдИзмХарактеристики");
	Результат.Свернуть("ACCOUNT_CODE,PROVIDER_CODE,SERVICE_CODE,FEATURE_CODE,RATE_TYPE,RATE_UNIT,RATE_VALUE");
	Возврат Результат;
КонецФункции

Функция getNorms(CODE) Экспорт
	Запрос = Новый Запрос;
	Если CODE = Null Или CODE = Неопределено Или CODE = "" Тогда
		Условие = "";
	Иначе
		Условие = " И ЛицевойСчет = &ЛицевойСчет";
		Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчетПоGUID(CODE));
	КонецЕсли;
	Запрос.Текст = 
	    "ВЫБРАТЬ
	    |	НЕОПРЕДЕЛЕНО КАК ACCOUNT_CODE,
	    |	НазначенныеУслугиСрезПоследних.Организация.КодПоЕДРПОУ КАК PROVIDER_CODE,
	    |	ВЫБОР НазначенныеУслугиСрезПоследних.Услуга.ВидУслуги
	    |		КОГДА ЗНАЧЕНИЕ(Справочник.ВидыУслуг.ХолоднаяВода) ТОГДА ""water.supply.cold""
	    |		КОГДА ЗНАЧЕНИЕ(Справочник.ВидыУслуг.Водоотведение) ТОГДА
		|			ВЫБОР НазначенныеУслугиСрезПоследних.Услуга.ПУГарячаяВода
	    |				КОГДА ИСТИНА ТОГДА ""water.sewerage.hot""
	    |				ИНАЧЕ ""water.sewerage.cold""
	    |			КОНЕЦ
	    |		ИНАЧЕ НЕОПРЕДЕЛЕНО
	    |	КОНЕЦ КАК SERVICE_CODE,
	    |	ВЫБОР НазначенныеУслугиСрезПоследних.Организация.КодПоЕДРПОУ
	    |		КОГДА ""03362560"" ТОГДА 
	    |			ВЫБОР НазначенныеУслугиСрезПоследних.Услуга.ЕдиницаИзмерения.Наименование
	    |				КОГДА ""м3"" ТОГДА ""m3""
	    |				ИНАЧЕ НЕОПРЕДЕЛЕНО
	    |			КОНЕЦ
	    |		ИНАЧЕ НЕОПРЕДЕЛЕНО
	    |	КОНЕЦ КАК SERVICE_UNIT,
	    |	ВЫБОР НазначенныеУслугиСрезПоследних.Услуга.ВидУслуги
	    |		КОГДА ЗНАЧЕНИЕ(Справочник.ВидыУслуг.ХолоднаяВода) ТОГДА ""residentsNumber""
	    |		КОГДА ЗНАЧЕНИЕ(Справочник.ВидыУслуг.Водоотведение) ТОГДА ""residentsNumber""
	    |		ИНАЧЕ НЕОПРЕДЕЛЕНО
	    |	КОНЕЦ КАК FEATURE_CODE,
	    |	ВЫБОР НазначенныеУслугиСрезПоследних.Услуга.ВидУслуги
	    |		КОГДА ЗНАЧЕНИЕ(Справочник.ВидыУслуг.ХолоднаяВода) ТОГДА ""pp""
	    |		КОГДА ЗНАЧЕНИЕ(Справочник.ВидыУслуг.Водоотведение) ТОГДА ""pp""
	    |		ИНАЧЕ НЕОПРЕДЕЛЕНО
	    |	КОНЕЦ КАК FEATURE_UNIT,
	    |	НЕОПРЕДЕЛЕНО КАК NORM_VALUE,
	    |	НазначенныеУслугиСрезПоследних.ЛицевойСчет КАК ЛицевойСчет,
	    |	НазначенныеУслугиСрезПоследних.ЛицевойСчет.Владелец КАК Здание,
		|	НазначенныеУслугиСрезПоследних.Услуга КАК Услуга
	    |ИЗ
	    |	РегистрСведений.НазначенныеУслуги.СрезПоследних(, Действует" + Условие + ") КАК НазначенныеУслугиСрезПоследних
		|ГДЕ
		|	НазначенныеУслугиСрезПоследних.Услуга.СпособНачисления = Значение(Перечисление.СпособыНачисленияУслуг.ПоНормамПотребления)";
	Результат = Запрос.Выполнить().Выгрузить();
	ЗапросНорма = Новый Запрос;
	ЗапросНорма.Текст =
		"ВЫБРАТЬ
		|	ВЫБОР ТарифыСрезПоследних.НормаПотребления
		|		КОГДА 0 ТОГДА НЕОПРЕДЕЛЕНО
		|		ИНАЧЕ ТарифыСрезПоследних.НормаПотребления
		|	КОНЕЦ КАК NORM_VALUE
		|ИЗ
		|	РегистрСведений.Тарифы.СрезПоследних(, Услуга = &Услуга И Здание = &Здание) КАК ТарифыСрезПоследних";
	Для каждого Строка из Результат Цикл
		Строка.ACCOUNT_CODE = Строка(Строка.ЛицевойСчет.УникальныйИдентификатор());
		ЗапросНорма.УстановитьПараметр("Здание", Строка.Здание);
		ЗапросНорма.УстановитьПараметр("Услуга", Строка.Услуга);
		РезультатНорма = ЗапросНорма.Выполнить().Выгрузить();
		Для каждого СтрокаНорма из РезультатНорма Цикл
			Строка.NORM_VALUE = СтрокаНорма.NORM_VALUE;
		КонецЦикла;
	КонецЦикла;
	Результат.Колонки.Удалить("ЛицевойСчет");
	Результат.Колонки.Удалить("Услуга");
	Результат.Колонки.Удалить("Здание");
	Возврат Результат;
КонецФункции

Функция getBalances(CODE) Экспорт
	Запрос = Новый Запрос;
	Если CODE = Null Или CODE = Неопределено Или CODE = "" Тогда
		Условие = "";
	Иначе
		Условие = "РасчетыПоЛицевымСчетам.ЛицевойСчет = &ЛицевойСчет И ";
		Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчетПоGUID(CODE));
	КонецЕсли;
	Запрос.Текст =
	    "ВЫБРАТЬ
	    |	НЕОПРЕДЕЛЕНО КАК ACCOUNT_CODE,
	    |	РасчетыПоЛицевымСчетам.Организация.КодПоЕДРПОУ КАК PROVIDER_CODE,
	    |	ВЫБОР РасчетыПоЛицевымСчетам.Организация.КодПоЕДРПОУ
	    |		КОГДА ""03362560"" ТОГДА ""water""
	    |		ИНАЧЕ НЕОПРЕДЕЛЕНО
	    |	КОНЕЦ КАК INDUSTRY_TYPE,
	    |	ГОД(РасчетыПоЛицевымСчетам.Период) КАК PERIOD_YEAR,
	    |	МЕСЯЦ(РасчетыПоЛицевымСчетам.Период) КАК PERIOD_MONTH,
	    |	СУММА(ВЫБОР
	    |			КОГДА ТИПЗНАЧЕНИЯ(РасчетыПоЛицевымСчетам.Регистратор) В (
		|				ТИП(Документ.ВводНачальныхОстатков),
		|				ТИП(Документ.ВводНачальныхОстатковПоЛС))
		|			ТОГДА
		|				ВЫБОР РасчетыПоЛицевымСчетам.ВидДвижения
		|					КОГДА ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|					ТОГДА  РасчетыПоЛицевымСчетам.Сумма
	    |					ИНАЧЕ  -РасчетыПоЛицевымСчетам.Сумма
		|				КОНЕЦ
	    |			ИНАЧЕ 0
	    |		КОНЕЦ) КАК CALC_START,
	    |	СУММА(ВЫБОР
	    |			КОГДА ТИПЗНАЧЕНИЯ(РасчетыПоЛицевымСчетам.Регистратор) В (
		|				ТИП(Документ.НачислениеПоЛС),
		|				ТИП(Документ.РазовоеНачислениеУслуг),
		|				ТИП(Документ.РаспределениеДополнительныхНачислений),
		|				ТИП(Документ.КорректировкаНачислений))
	    |			ТОГДА РасчетыПоЛицевымСчетам.Сумма
	    |			ИНАЧЕ 0
	    |		КОНЕЦ) КАК CALC_ACCRUAL,
	    |	СУММА(ВЫБОР
	    |			КОГДА ТИПЗНАЧЕНИЯ(РасчетыПоЛицевымСчетам.Регистратор) В (
		|				ТИП(Документ.НачислениеПениПоЛС))
	    |			ТОГДА РасчетыПоЛицевымСчетам.Сумма
	    |			ИНАЧЕ 0
	    |		КОНЕЦ) КАК CALC_PENALTY,
	    |	0.0 КАК CALC_BENEFIT,
	    |	СУММА(ВЫБОР
	    |			КОГДА ТИПЗНАЧЕНИЯ(РасчетыПоЛицевымСчетам.Регистратор) В (
		|				ТИП(Документ.ОплатаУслугМВК),
		|				ТИП(Документ.ПоступлениеНаСчет),
		|				ТИП(Документ.ПоступлениеВКассу),
		|				ТИП(Документ.ВозвратИзКассы),
		|				ТИП(Документ.ЧекККМ),
		|				ТИП(Документ.ЧекККМВозврат),
		|				ТИП(Документ.КорректировкаДолга))
		|			И РасчетыПоЛицевымСчетам.ВидНачисления <> ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Субсидия) ТОГДА РасчетыПоЛицевымСчетам.Сумма
	    |			ИНАЧЕ 0
	    |		КОНЕЦ) КАК CALC_PAYMENT,
	    |	СУММА(ВЫБОР
	    |			КОГДА ТИПЗНАЧЕНИЯ(РасчетыПоЛицевымСчетам.Регистратор) В (
		|				ТИП(Документ.ПоступлениеНаСчет))
	    |			И РасчетыПоЛицевымСчетам.ВидНачисления = ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Субсидия) ТОГДА РасчетыПоЛицевымСчетам.Сумма
	    |			ИНАЧЕ 0
	    |		КОНЕЦ) КАК CALC_SUBSIDY,
	    |	СУММА(ВЫБОР
	    |			КОГДА ТИПЗНАЧЕНИЯ(РасчетыПоЛицевымСчетам.Регистратор) В (
		|				ТИП(Документ.ПерерасчетПоЛС),
		|				ТИП(Документ.АктСверки),
		|				ТИП(Документ.ДоговорРеструктуризацииДолга),
		|				ТИП(Документ.КорректировкаРегистров))
	    |			ТОГДА РасчетыПоЛицевымСчетам.Сумма
	    |			ИНАЧЕ 0
	    |		КОНЕЦ) КАК CALC_RECALC,
		|	0.0 КАК CALC_INVOICE,
		|	0.0 КАК CALC_FINISH,
	    |	РасчетыПоЛицевымСчетам.ЛицевойСчет КАК ЛицевойСчет
	    |ИЗ
	    |	РегистрНакопления.РасчетыПоЛицевымСчетам КАК РасчетыПоЛицевымСчетам
	    |ГДЕ
	    |	" + Условие + "Активность
		|	И РасчетыПоЛицевымСчетам.Сумма <> 0
	    |	И ТИПЗНАЧЕНИЯ(РасчетыПоЛицевымСчетам.Регистратор) <> ТИП(Документ.ЗакрытиеМесяца) 
	    |
	    |СГРУППИРОВАТЬ ПО
	    |	РасчетыПоЛицевымСчетам.ЛицевойСчет,
	    |	ГОД(РасчетыПоЛицевымСчетам.Период),
	    |	МЕСЯЦ(РасчетыПоЛицевымСчетам.Период),
	    |	РасчетыПоЛицевымСчетам.Организация.КодПоЕДРПОУ,
	    |	ВЫБОР РасчетыПоЛицевымСчетам.Организация.КодПоЕДРПОУ
	    |		КОГДА ""03362560"" ТОГДА ""water""
	    |		ИНАЧЕ НЕОПРЕДЕЛЕНО
	    |	КОНЕЦ
	    |
	    |УПОРЯДОЧИТЬ ПО
	    |	ЛицевойСчет,
	    |	PERIOD_YEAR,
	    |	PERIOD_MONTH";
	Результат = Запрос.Выполнить().Выгрузить();
	ПредыдущийЛС = Справочники.ЛицевыеСчета.ПустаяСсылка();
	Для каждого Строка из Результат Цикл
		Строка.ACCOUNT_CODE = Строка(Строка.ЛицевойСчет.УникальныйИдентификатор());
		Если Строка.ЛицевойСчет <> ПредыдущийЛС Тогда
			ПредыдущийЛС = Строка.ЛицевойСчет;
			КонечныйБаланс = Строка.CALC_START-Строка.CALC_RECALC;
		Иначе
			Строка.CALC_START = КонечныйБаланс;
			КонечныйБаланс = КонечныйБаланс 
			    +Строка.CALC_RECALC
				+Строка.CALC_ACCRUAL
				+Строка.CALC_PENALTY
				-Строка.CALC_PAYMENT
				-Строка.CALC_BENEFIT
				-Строка.CALC_SUBSIDY; 
		КонецЕсли;
		Строка.CALC_INVOICE = КонечныйБаланс;
		Строка.CALC_FINISH  = КонечныйБаланс;
	КонецЦикла;
	Сч = Результат.Количество()-1;
	Пока Сч >=0 Цикл
		Строка = Результат.Получить(Сч);
		Если КонецМесяца(Дата(Строка.PERIOD_YEAR, Строка.PERIOD_MONTH, 1)) < Дата("20200501000000") Тогда
			Результат.Удалить(Сч);
		КонецЕсли;
		Сч = Сч - 1;
	КонецЦикла; 
	Результат.Колонки.Удалить("ЛицевойСчет");
	Возврат Результат;
КонецФункции	

Функция getConsumpts(CODE) Экспорт
	Запрос = Новый Запрос;
	Если CODE = Null Или CODE = Неопределено Или CODE = "" Тогда
		Условие = "";
	Иначе
		Условие = "РасчетыПоЛицевымСчетам.ЛицевойСчет = &ЛицевойСчет И ";
		Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчетПоGUID(CODE));
