		Строка.ACCOUNT_CODE   = Строка(Строка.ЛицевойСчет.УникальныйИдентификатор());
		Строка.INDICATOR_CODE = Строка(Строка.ПриборУчета.УникальныйИдентификатор());
	КонецЦикла;
	Результат.Колонки.Удалить("ЛицевойСчет");
	Результат.Колонки.Удалить("ПриборУчета");
	Возврат Результат;
КонецФункции

Функция putCCEs(DATA) Экспорт
	Возврат ПустойОтвет();
КонецФункции

Функция putIPEs(DATA) Экспорт
	Результат = Новый ТаблицаЗначений();
	Результат.Колонки.Добавить("ACCOUNT_CODE");
	Результат.Колонки.Добавить("PACKAGE_CODE");
	Пакет = "";
	Для каждого Строка Из DATA Цикл
		ЛицевойСчет = ЛицевойСчетПоGUID(Строка.ACCOUNT_CODE);
		ПриборУчета = ПриборУчетаПоGUID(Строка.INDICATOR_CODE);
		НаборЗаписей = РегистрыСведений.ПоказанияПриборовУчетаССайта.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ЛицевойСчет.Установить(ЛицевойСчет);
		НаборЗаписей.Отбор.ПриборУчета.Установить(ПриборУчета);
		НаборЗаписей.Отбор.Период.Установить(ТекущаяДата());		
		НовСтрока = НаборЗаписей.Добавить();
		НовСтрока.ЛицевойСчет 		  = ЛицевойСчет;
		НовСтрока.ПриборУчета 		  = ПриборУчета;
		НовСтрока.Значение 	  		  = Строка.INDICATION_CURR;
		НовСтрока.ПоказаниеПредыдущее = Строка.INDICATION_PREV;
		НовСтрока.Услуга 			  = Справочники.Услуги.НайтиПоКоду(?(Строка.INDICATOR_TYPE = "water.cold.consumption", "000000048", "000000020"));
		НовСтрока.ВидТарифа   		  = Перечисления.ВидыТарифов.Общий;
		НовСтрока.Период 	  		  = ТекущаяДата();
		НовСтрока.Активность  		  = Истина;		
		Если Строка.PACKAGE_CODE <> Пакет Тогда
			Запись = Результат.Добавить();
			Запись.ACCOUNT_CODE = Строка.ACCOUNT_CODE;
			Запись.PACKAGE_CODE = Строка.PACKAGE_CODE;
			Пакет = Строка.PACKAGE_CODE;
		КонецЕсли;
		НаборЗаписей.Записать();
	КонецЦикла;	
	Возврат Результат;
КонецФункции

