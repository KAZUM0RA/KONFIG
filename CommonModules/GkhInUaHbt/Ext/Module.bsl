	Результат.Добавить();
	Возврат Результат;
КонецФункции

Функция getState() Экспорт
	Результат = Новый ТаблицаЗначений();
	Результат.Колонки.Добавить("STATE");
	Запись = Результат.Добавить();
	Запись.STATE = "ready";
	Возврат Результат;
КонецФункции
	
Функция getAccounts(CODE) Экспорт
	Запрос = Новый Запрос;
	Если CODE = Null Или CODE = Неопределено Или CODE = "" Тогда
		Условие = "";
	Иначе
		Условие = " И ЛицевойСчет = &ЛицевойСчет";
		Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчетПоGUID(CODE));
	КонецЕсли;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	НЕОПРЕДЕЛЕНО КАК ACCOUNT_CODE,
		|	ЛицевыеСчетаСрезПоследних.ЛицевойСчет.Представление КАК ACCOUNT_NUMB,
		|	ЛицевыеСчетаСрезПоследних.ЛицевойСчет.КодКОАТУУ КАК LOCALITY_CODE,
		|	НЕОПРЕДЕЛЕНО КАК STREET_NAME,
		|	НЕОПРЕДЕЛЕНО КАК BUILDING_POST,
		|	ВЫБОР ЛицевыеСчетаСрезПоследних.ЛицевойСчет.Владелец.КоличествоПодъездов
		|		КОГДА 0 ТОГДА НЕОПРЕДЕЛЕНО
		|		ИНАЧЕ ЛицевыеСчетаСрезПоследних.ЛицевойСчет.Владелец.КоличествоПодъездов
		|	КОНЕЦ КАК BUILDING_ENTR,
		|	ВЫБОР ЛицевыеСчетаСрезПоследних.ЛицевойСчет.Владелец.КоличествоЭтажей                          
		|		КОГДА 0 ТОГДА НЕОПРЕДЕЛЕНО
		|		ИНАЧЕ ЛицевыеСчетаСрезПоследних.ЛицевойСчет.Владелец.КоличествоЭтажей
		|	КОНЕЦ КАК BUILDING_FLOO,
		|	НЕОПРЕДЕЛЕНО КАК BUILDING_NUMB,
		|	НЕОПРЕДЕЛЕНО КАК ADDRESS_NUMB,
		|	ВЫБОР ЛицевыеСчетаСрезПоследних.ЛицевойСчет.Владелец.МногоКвартирный
		|		КОГДА ИСТИНА ТОГДА ""condominium""
		|		ИНАЧЕ ""private""
		|	КОНЕЦ КАК HABITATION_TYPE,
		|	ЕСТЬNULL(ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ОтветственныйВладелец.ФизЛицо.Представление, НЕОПРЕДЕЛЕНО) КАК DELEGATE_LAST,
		|	ВЫБОР ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ОтветственныйВладелец.ФизЛицо.ИНН
		|		КОГДА """" ТОГДА НЕОПРЕДЕЛЕНО
		|		КОГДА "" "" ТОГДА НЕОПРЕДЕЛЕНО
		|		КОГДА ""-"" ТОГДА НЕОПРЕДЕЛЕНО
		|		ИНАЧЕ ЕСТЬNULL(ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ОтветственныйВладелец.ФизЛицо.ИНН, НЕОПРЕДЕЛЕНО)
		|	КОНЕЦ КАК DELEGATE_TAXID,
		|	ВЫБОР ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ОтветственныйВладелец.ФизЛицо.ДатаРождения
		|		КОГДА ДАТАВРЕМЯ(1, 1, 1) ТОГДА НЕОПРЕДЕЛЕНО
		|		ИНАЧЕ ЕСТЬNULL(ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ОтветственныйВладелец.ФизЛицо.ДатаРождения, НЕОПРЕДЕЛЕНО) 
		|	КОНЕЦ КАК DELEGATE_BIRTH,
	    |	ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ЛицевойСчет КАК ЛицевойСчет,
		|	ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ЛицевойСчет.Владелец.Представление КАК Адрес,
		|	ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ЛицевойСчет.ОбъектЛицевогоСчета.Представление КАК Квартира
		|ИЗ
		|	РегистрСведений.ЛицевыеСчета.СрезПоследних(, Действует" + Условие + ") КАК ЛицевыеСчетаСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ОтветственныйВладелецЛицевогоСчета.СрезПоследних(, ИСТИНА" + Условие + ") КАК ОтветственныйВладелецЛицевогоСчетаСрезПоследних
		|		ПО ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ЛицевойСчет = ЛицевыеСчетаСрезПоследних.ЛицевойСчет";
	Результат = Запрос.Выполнить().Выгрузить();
	Для каждого Строка из Результат Цикл
		Адрес = УправлениеКонтактнойИнформацией.РазложитьСтрокуНаПодстроки(Строка.Адрес, ",");
		Индекс = ?(Адрес[2] = " м.Миргород" ИЛИ Адрес[2] = " м. Миргород", Адрес[4], "");
		Улица  = Адрес[0];
		Дом    = Адрес[1];
		Строка.ACCOUNT_CODE  = Строка(Строка.ЛицевойСчет.УникальныйИдентификатор());
		Строка.STREET_NAME   = СокрЛП(Улица);
		Строка.BUILDING_POST = СокрЛП(СтрЗаменить(СтрЗаменить(Индекс, " ", ""), " ", ""));
		Если Строка.BUILDING_POST = "" Тогда
			Строка.BUILDING_POST = Неопределено;
		КонецЕсли;
		Строка.BUILDING_NUMB = СокрЛП(Сред(Дом, 7));
		Строка.ADDRESS_NUMB  = СокрЛП(Сред(Строка.Квартира, 6));
		Если Строка.ADDRESS_NUMB = "0" Или Строка.ADDRESS_NUMB = "" Тогда
			Строка.ADDRESS_NUMB = Неопределено;
		КонецЕсли;
	КонецЦикла;
	Результат.Колонки.Удалить("ЛицевойСчет");
	Результат.Колонки.Удалить("Адрес");
	Результат.Колонки.Удалить("Квартира");
	Возврат Результат;
КонецФункции	

Функция getContacts(CODE) Экспорт
	Запрос = Новый Запрос;
	Если CODE = Null Или CODE = Неопределено Или CODE = "" Тогда
		Условие = "";
	Иначе
		Условие = " И ЛицевойСчет = &ЛицевойСчет";
		Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчетПоGUID(CODE));
	КонецЕсли;
	Запрос.Текст = 
	    "ВЫБРАТЬ
	    |	НЕОПРЕДЕЛЕНО КАК ACCOUNT_CODE,
	    |	""05355"" КАК LOCALITY_PSTN,
	    |	""phone"" КАК CONTACT_TYPE,
	    |	ЛицевыеСчетаСрезПоследних.ЛицевойСчет.МобТелефон КАК CONTACT_DATA,
	    |	ЛицевыеСчетаСрезПоследних.ЛицевойСчет КАК ЛицевойСчет
	    |ИЗ
	    |	РегистрСведений.ЛицевыеСчета.СрезПоследних(, Действует" + Условие + ") КАК ЛицевыеСчетаСрезПоследних
	    |ГДЕ
	    |	ЛицевыеСчетаСрезПоследних.ЛицевойСчет.МобТелефон <> """"
	    |	И ЛицевыеСчетаСрезПоследних.ЛицевойСчет.МобТелефон <> ""0""
	    |
	    |ОБЪЕДИНИТЬ ВСЕ
	    |
	    |ВЫБРАТЬ
	    |	НЕОПРЕДЕЛЕНО,
	    |	ВЫБОР ЛицевыеСчетаСрезПоследних.ЛицевойСчет.КодКОАТУУ
	    |		КОГДА ""5323280201"" ТОГДА ""05343""
	    |		КОГДА ""5323286001"" ТОГДА ""05346""
	    |		ИНАЧЕ ""05355""
	    |	КОНЕЦ,
	    |	НЕОПРЕДЕЛЕНО,
	    |	ЛицевыеСчетаСрезПоследних.ЛицевойСчет.Телефон,
	    |	ЛицевыеСчетаСрезПоследних.ЛицевойСчет
	    |ИЗ
	    |	РегистрСведений.ЛицевыеСчета.СрезПоследних(, Действует" + Условие + ") КАК ЛицевыеСчетаСрезПоследних
	    |ГДЕ
	    |	ЛицевыеСчетаСрезПоследних.ЛицевойСчет.Телефон <> """"
	    |	И ЛицевыеСчетаСрезПоследних.ЛицевойСчет.Телефон <> ""0""";
	Результат = Запрос.Выполнить().Выгрузить();
	Для каждого Строка из Результат Цикл
		Строка.ACCOUNT_CODE = Строка(Строка.ЛицевойСчет.УникальныйИдентификатор());
		Строка.CONTACT_DATA = СокрЛП(Строка.CONTACT_DATA);
	КонецЦикла;
	Результат.Колонки.Удалить("ЛицевойСчет");
	Возврат Результат;
КонецФункции	

