		|	ВЫБОР ТарифыСрезПоследних.ЗначениеТарифаПоНорме
		|		КОГДА 0 ТОГДА НЕОПРЕДЕЛЕНО
		|		ИНАЧЕ ЕСТЬNULL(ТарифыСрезПоследних.ЗначениеТарифаПоНорме, НЕОПРЕДЕЛЕНО)
		|	КОНЕЦ КАК RATE_VALUE
		|ИЗ
		|	РегистрСведений.ЛицевыеСчета.СрезПоследних(&НаДату, ЛицевойСчет = &ЛицевойСчет) КАК ЛицевыеСчетаСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Тарифы.СрезПоследних(&НаДату, Здание = &Здание И Услуга = &Услуга) КАК ТарифыСрезПоследних
		|		ПО ИСТИНА";
	Для каждого Строка из Результат Цикл
		Строка.ACCOUNT_CODE = Строка(Строка.ЛицевойСчет.УникальныйИдентификатор());
		Если Строка.FEATURE_CODE <> Неопределено Тогда
			ЗапросХарактеристикаНорма.УстановитьПараметр("ЛицевойСчет", Строка.ЛицевойСчет);
			ЗапросХарактеристикаНорма.УстановитьПараметр("Здание", 		Строка.Здание);
			ЗапросХарактеристикаНорма.УстановитьПараметр("Услуга", 		Строка.Услуга);
			ЗапросХарактеристикаНорма.УстановитьПараметр("НаДату", 		?(Строка.PERIOD_ACCOUNT_FINISH <> Неопределено, Строка.PERIOD_ACCOUNT_FINISH, КонецМесяца(Дата(Строка.PERIOD_ACCOUNT_YEAR, Строка.PERIOD_ACCOUNT_MONTH, 1))));
			РезультатХарактеристикаНорма = ЗапросХарактеристикаНорма.Выполнить().Выгрузить();
			Для каждого СтрокаХарактеристикаНорма из РезультатХарактеристикаНорма Цикл
				Строка.FEATURE_VALUE = СтрокаХарактеристикаНорма.FEATURE_VALUE;
				Строка.NORM_VALUE = СтрокаХарактеристикаНорма.NORM_VALUE;
				Если СтрокаХарактеристикаНорма.NORM_VALUE = Неопределено
				   И СтрокаХарактеристикаНорма.FEATURE_VALUE <> Неопределено 
				   И СтрокаХарактеристикаНорма.RATE_VALUE <> Неопределено Тогда
					Строка.CALC_METHOD = "feature";
					Строка.RATE_VALUE = СтрокаХарактеристикаНорма.RATE_VALUE;
					Строка.RATE_UNIT = Строка.FEATURE_UNIT;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;		
	КонецЦикла;
	Результат.Колонки.Удалить("ЛицевойСчет");
	Результат.Колонки.Удалить("Здание");
	Результат.Колонки.Удалить("Услуга");
	Результат.Свернуть(
		"ACCOUNT_CODE,PROVIDER_CODE,SERVICE_CODE,SERVICE_UNIT,
		|FEATURE_CODE,FEATURE_UNIT,FEATURE_VALUE,NORM_VALUE,RATE_TYPE,RATE_UNIT,RATE_VALUE,
		|PERIOD_CURRENT_YEAR,PERIOD_CURRENT_MONTH,
		|PERIOD_ACCOUNT_YEAR,PERIOD_ACCOUNT_MONTH,PERIOD_ACCOUNT_START,PERIOD_ACCOUNT_FINISH,
		|CALC_TYPE,CALC_METHOD,CALC_INTERVAL",
		"CALC_VOLUME,CALC_CSUM"
	);
	Возврат Результат;
КонецФункции	

