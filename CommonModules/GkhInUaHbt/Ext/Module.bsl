Функция getFinances(CODE) Экспорт
	Запрос = Новый Запрос;
	Если CODE = Null Или CODE = Неопределено Или CODE = "" Тогда
		Условие = "";
	Иначе
		Условие = "РасчетыПоЛицевымСчетам.ЛицевойСчет = &ЛицевойСчет И ";
		Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчетПоGUID(CODE));
