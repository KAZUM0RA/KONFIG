Функция ПолучитьПоказанияПрибораУчетаПоГВ(ПриборУчета, ПериодНачисления) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
	    "ВЫБРАТЬ
	    |	АктСнятияПоказанийГорячейВодыСрезПоследних.ПоказаниеПредыдущее
	    |ИЗ
	    |	РегистрСведений.АктСнятияПоказанийГорячейВоды.СрезПоследних(&НаДату, ПриборУчета = &ПриборУчета) КАК АктСнятияПоказанийГорячейВодыСрезПоследних";
	Запрос.УстановитьПараметр("НаДату", КонецМесяца(ПериодНачисления));
	Запрос.УстановитьПараметр("ПриборУчета", ПриборУчета);
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Показание = 0;
		Возврат Показание;
	Иначе
		Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл
		    Показание = Выборка.ПоказаниеПредыдущее;
		КонецЦикла;
	    Возврат Показание;
	КонецЕсли;
КонецФункции

Функция ПолучитьПоказанияПрибораУчетаПоХВ(ПриборУчета, ПериодНачисления) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
	    "ВЫБРАТЬ
	    |	АктСнятияПоказанийХолоднойВодыСрезПоследних.ПоказаниеТекущее
	    |ИЗ
	    |	РегистрСведений.АктСнятияПоказанийХолоднойВоды.СрезПоследних(&НаДату, ПриборУчета = &ПриборУчета) КАК АктСнятияПоказанийХолоднойВодыСрезПоследних";
	Запрос.УстановитьПараметр("НаДату", КонецМесяца(ПериодНачисления));
	Запрос.УстановитьПараметр("ПриборУчета", ПриборУчета);
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Показание = 0;
		Возврат Показание;
	Иначе
		Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл
		    Показание = Выборка.ПоказаниеТекущее;
		КонецЦикла;
	    Возврат Показание;
	КонецЕсли;
КонецФункции


// ДОДАТКОВІ ПРОЦЕДУРИ І ФУНКЦІЇ
