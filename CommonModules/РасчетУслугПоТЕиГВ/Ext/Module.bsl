// Показники приладів по опаленню
//
Функция ПолучитьПоказания(ПриборУчета, ПериодНачисления) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
	    "ВЫБРАТЬ ПЕРВЫЕ 1
	    |	АктСнятияПоказанийТеплосчетчикаСрезПоследних.РазницаПоказания,
	    |	АктСнятияПоказанийТеплосчетчикаСрезПоследних.Период,
	    |	АктСнятияПоказанийТеплосчетчикаСрезПоследних.ЧасыПростояРазница,
	    |	АктСнятияПоказанийТеплосчетчикаСрезПоследних.РазницаЧасы КАК ЧасыРаботы
	    |ИЗ
	    |	РегистрСведений.АктСнятияПоказанийТеплосчетчика.СрезПоследних(
	    |			,
	    |			ПриборУчета = &ПриборУчета
	    |				) КАК АктСнятияПоказанийТеплосчетчикаСрезПоследних";
	Запрос.УстановитьПараметр("ДатаСреза", Новый Граница(ТекущаяДата(), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("ПриборУчета", ПриборУчета);
	Запрос.УстановитьПараметр("ПериодНачисления", НачалоМесяца(ПериодНачисления));
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		ДанныеВыборки = Новый Структура;
		Пока Выборка.Следующий() Цикл
			ДанныеВыборки.Вставить("КвоТЕ",       Выборка.РазницаПоказания);
			ДанныеВыборки.Вставить("ДатаСнятия",  Выборка.Период);
			ДанныеВыборки.Вставить("ЧасыПростоя", Выборка.ЧасыПростояРазница);
			ДанныеВыборки.Вставить("ЧасыРаботы",  Выборка.ЧасыРаботы);
		КонецЦикла;
		Возврат ДанныеВыборки;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
КонецФункции

Функция ПолучитьПоказанияПрибораУчетаПоТЕ(ПриборУчета, ПериодНачисления) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
	    "ВЫБРАТЬ ПЕРВЫЕ 1
	    |	АктСнятияПоказанийТеплосчетчикаСрезПоследних.ПоказаниеТекущее,
	    |	АктСнятияПоказанийТеплосчетчикаСрезПоследних.НаработкаТеплосчетчикаТекущее,
	    |	АктСнятияПоказанийТеплосчетчикаСрезПоследних.ОбъемВодыПоТеплоСчетчикуТекущее,
	    |	АктСнятияПоказанийТеплосчетчикаСрезПоследних.ЧасыПростояТекущие,
	    |	АктСнятияПоказанийТеплосчетчикаСрезПоследних.РазницаПоказания
	    |ИЗ
	    |	РегистрСведений.АктСнятияПоказанийТеплосчетчика.СрезПоследних(, ПриборУчета = &ПриборУчета) КАК АктСнятияПоказанийТеплосчетчикаСрезПоследних
		//|ГДЕ
		//|	АктСнятияПоказанийТеплосчетчикаСрезПоследних.Период МЕЖДУ &ПериодНач И &ПериодКон
	    |
	    |УПОРЯДОЧИТЬ ПО
	    |	АктСнятияПоказанийТеплосчетчикаСрезПоследних.Период УБЫВ";
	////Запрос.УстановитьПараметр("ПериодКон", ДобавитьМесяц(КонецМесяца(ПериодНачисления), -1));
	////Запрос.УстановитьПараметр("ПериодНач", ДобавитьМесяц(НачалоМесяца(ПериодНачисления), -1));
	Запрос.УстановитьПараметр("ПриборУчета", ПриборУчета);

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	ДанныеВыборки = Новый Структура;
	Пока Выборка.Следующий() Цикл
		ДанныеВыборки.Вставить("ПоказаниеПредыдущее",       Выборка.ПоказаниеТекущее);
		ДанныеВыборки.Вставить("ЧасыНаработкиПредыдущие",   Выборка.НаработкаТеплосчетчикаТекущее);
		ДанныеВыборки.Вставить("ОбъемВодыПоТеплоСчетчикуПредыдущие", Выборка.ОбъемВодыПоТеплоСчетчикуТекущее);
		ДанныеВыборки.Вставить("ЧасыПростоя", Выборка.ЧасыПростояТекущие);
		ДанныеВыборки.Вставить("РазницаПоказания", Выборка.РазницаПоказания);
	КонецЦикла;
	Возврат ДанныеВыборки;
КонецФункции

