// Отримати загальну опалювальну площу будинку
//
Функция ПолучитьПлощадьЗдания(Здание) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 
	    "ВЫБРАТЬ
	    |	ПлощадьЗданий.Площадь
	    |ИЗ
	    |	РегистрСведений.ПлощадьЗданий КАК ПлощадьЗданий
	    |ГДЕ
	    |	ПлощадьЗданий.Здание = &Здание
	    |	И ПлощадьЗданий.ВидПлощади = &ВидПлощади";
	Запрос.УстановитьПараметр("Здание", Здание);
	Запрос.УстановитьПараметр("ВидПлощади", Справочники.ВидыПлощадей.ОтапливаемаяПлощадь);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Площадь = Выборка.Площадь;
	КонецЦикла;
	Возврат Площадь;
КонецФункции

// Отримати опалювальну площу споживачів, відповідальних власників 
//
Функция ПолучитьПлощадь(ЛицевойСчет, Период = Неопределено, Услуга = "")
	ТекстЗапроса =
			"ВЫБРАТЬ
			|	НазначенныеУслугиСрезПоследних.ЛицевойСчет КАК ЛицевойСчет,
			|	ЕСТЬNULL(ПлощадьОбъектовЛицевыхСчетовСрезПоследних.Площадь, 0) КАК ЗначениеБазы,
			|	НазначенныеУслугиСрезПоследних.ЛицевойСчет.ОбъектЛицевогоСчета КАК ОбъектЛицевогоСчета,
			|	ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ОтветственныйВладелец КАК ОтветственныйВладелец,
			|	&Период КАК Период
			|ИЗ
			|	РегистрСведений.НазначенныеУслуги.СрезПоследних(
			|			&Период,
			|			ЛицевойСчет.Владелец = &Здание
			|				И Услуга = &Услуга
			|				И ЛицевойСчет = &ЛицевойСчет) КАК НазначенныеУслугиСрезПоследних
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПлощадьОбъектовЛицевыхСчетов.СрезПоследних(&Период, ВидПлощади = &ВидБазыРаспределения) КАК ПлощадьОбъектовЛицевыхСчетовСрезПоследних
			|		ПО НазначенныеУслугиСрезПоследних.ЛицевойСчет.ОбъектЛицевогоСчета = ПлощадьОбъектовЛицевыхСчетовСрезПоследних.Помещение
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОтветственныйВладелецЛицевогоСчета.СрезПоследних(&Период, ) КАК ОтветственныйВладелецЛицевогоСчетаСрезПоследних
			|		ПО НазначенныеУслугиСрезПоследних.ЛицевойСчет = ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ЛицевойСчет
			|ГДЕ
			|	НазначенныеУслугиСрезПоследних.Действует = ИСТИНА
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	НазначенныеУслугиСрезПоследних.ЛицевойСчет,
			|	ЕСТЬNULL(ПлощадьОбъектовЛицевыхСчетовСрезПоследних.Площадь, 0),
			|	НазначенныеУслугиСрезПоследних.ЛицевойСчет.ОбъектЛицевогоСчета,
			|	ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ОтветственныйВладелец,
			|	НазначенныеУслугиСрезПоследних.Период
			|ИЗ
			|	РегистрСведений.НазначенныеУслуги.СрезПоследних(
			|			&Период,
			|			ЛицевойСчет.Владелец = &Здание
			|				И Услуга = &Услуга
			|				И ЛицевойСчет = &ЛицевойСчет) КАК НазначенныеУслугиСрезПоследних
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПлощадьОбъектовЛицевыхСчетов.СрезПоследних(&Период, ВидПлощади = &ВидБазыРаспределения) КАК ПлощадьОбъектовЛицевыхСчетовСрезПоследних
			|		ПО НазначенныеУслугиСрезПоследних.ЛицевойСчет.ОбъектЛицевогоСчета = ПлощадьОбъектовЛицевыхСчетовСрезПоследних.Помещение
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОтветственныйВладелецЛицевогоСчета.СрезПоследних(&Период, ) КАК ОтветственныйВладелецЛицевогоСчетаСрезПоследних
			|		ПО НазначенныеУслугиСрезПоследних.ЛицевойСчет = ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ЛицевойСчет
			|ГДЕ
			|	НазначенныеУслугиСрезПоследних.Действует = ЛОЖЬ
			|	И НазначенныеУслугиСрезПоследних.Период > НАЧАЛОПЕРИОДА(&Период, МЕСЯЦ)";
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
		
	Запрос.УстановитьПараметр("Период", КонецМесяца(Период));		
	Запрос.УстановитьПараметр("Услуга", Услуга);		
	Запрос.УстановитьПараметр("ВидБазыРаспределения", Услуга.БазаРаспределенияРасчетнойУслуги);		
	Запрос.УстановитьПараметр("Здание", ЛицевойСчет.Владелец);
    Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
	ТаблицаЛицевыхСчетов = Запрос.Выполнить().Выгрузить();
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Площадь = 0;
		Возврат Площадь;
	Иначе
		Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл
			Площадь = Выборка.ЗначениеБазы;
		КонецЦикла;
		Возврат Площадь;
	КонецЕсли;
КонецФункции

// Отримати опалювальну площу споживачів з індивідуальним опаленням
//
Функция ВыборкаПлощадейИндОтопления(Здание) Экспорт
    ЗапросЛС = Новый Запрос;
	ЗапросЛС.Текст =
	   "ВЫБРАТЬ
	   |	ЛицевыеСчетаСрезПоследних.ЛицевойСчет,
	   |	ПлощадьОбъектовЛицевыхСчетовСрезПоследних.Площадь
	   |ИЗ
	   |	РегистрСведений.ЛицевыеСчета.СрезПоследних(&НаДату, ) КАК ЛицевыеСчетаСрезПоследних
	   |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПлощадьОбъектовЛицевыхСчетов.СрезПоследних(&НаДату, ) КАК ПлощадьОбъектовЛицевыхСчетовСрезПоследних
	   |		ПО ЛицевыеСчетаСрезПоследних.ЛицевойСчет.ОбъектЛицевогоСчета = ПлощадьОбъектовЛицевыхСчетовСрезПоследних.Помещение
	   |ГДЕ
	   |	ЛицевыеСчетаСрезПоследних.ЛицевойСчет.Владелец = &Владелец
	   |	И ПлощадьОбъектовЛицевыхСчетовСрезПоследних.ВидПлощади = &ВидПлощади
	   |	И ЛицевыеСчетаСрезПоследних.ЛицевойСчет.ИндОтопление = ИСТИНА"; 
	ЗапросЛС.УстановитьПараметр("Владелец", Здание);
	ЗапросЛС.УстановитьПараметр("НаДату", ТекущаяДата());
	ЗапросЛС.УстановитьПараметр("ВидПлощади", Справочники.ВидыПлощадей.ОтапливаемаяПлощадь);
	Результат = ЗапросЛС.Выполнить().Выгрузить();

	Возврат Результат;
КонецФункции

// Отримати опалювальну площу споживачів з лічильниками ВРО
//
Функция ВыборкаПлощадейСВРО(Здание, Подъезд = "") Экспорт
	Запрос = Новый Запрос;
	Условие = "";
	Если Подъезд <> "" Тогда
		Условие = " И ПлощадьОбъектовЛицевыхСчетовСрезПоследних.Помещение.Подъезд = &Подъезд";
		Запрос.УстановитьПараметр("Подъезд", Подъезд);
	КонецЕсли;
	Запрос.Текст =
	    "ВЫБРАТЬ
	    |	ПлощадьОбъектовЛицевыхСчетовСрезПоследних.Площадь,
	    |	УстановленныеПриборыУчетаСрезПоследних.ОбъектУстановки
	    |ИЗ
	    |	РегистрСведений.ПлощадьОбъектовЛицевыхСчетов.СрезПоследних(&НаДату, ) КАК ПлощадьОбъектовЛицевыхСчетовСрезПоследних
	    |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УстановленныеПриборыУчета.СрезПоследних(&НаДату, ) КАК УстановленныеПриборыУчетаСрезПоследних
	    |			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛицевыеСчета.СрезПоследних КАК ЛицевыеСчетаСрезПоследних
	    |			ПО УстановленныеПриборыУчетаСрезПоследних.ОбъектУстановки = ЛицевыеСчетаСрезПоследних.ЛицевойСчет
	    |		ПО (УстановленныеПриборыУчетаСрезПоследних.ОбъектУстановки.ОбъектЛицевогоСчета = ПлощадьОбъектовЛицевыхСчетовСрезПоследних.Помещение)
	    |ГДЕ
	    |	УстановленныеПриборыУчетаСрезПоследних.ПриборУчета.ВРО = ИСТИНА " + Условие + "
	    |	И ПлощадьОбъектовЛицевыхСчетовСрезПоследних.ВидПлощади = &ВидПлощади
	    |	И ЛицевыеСчетаСрезПоследних.ЛицевойСчет.Владелец = &Здание";
	Запрос.УстановитьПараметр("НаДату", ТекущаяДата());
	Запрос.УстановитьПараметр("Здание", Здание);
	Запрос.УстановитьПараметр("ВидПлощади", Справочники.ВидыПлощадей.ОтапливаемаяПлощадь);
	Результат = Запрос.Выполнить().Выгрузить();
	Возврат Результат;
КонецФункции

// Отримати опалювальну площу споживачів без лічильників
//
Функция ПолучитьПлощадьОбъектовЛицевыхСчетов(Помещение, Здание, ПериодНачисления) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
	    "ВЫБРАТЬ
	    |	ПлощадьОбъектовЛицевыхСчетовСрезПоследних.Площадь
	    |ИЗ
	    |	РегистрСведений.ПлощадьОбъектовЛицевыхСчетов.СрезПоследних(
	    |			&НаДату,
	    |			Помещение.Владелец = &Здание
	    |				И ВидПлощади = &ВидПлощади
	    |				И Помещение = &Помещение) КАК ПлощадьОбъектовЛицевыхСчетовСрезПоследних";
	Запрос.УстановитьПараметр("НаДату", КонецМесяца(ПериодНачисления));
	Запрос.УстановитьПараметр("Здание", Здание);
	Запрос.УстановитьПараметр("Помещение", Помещение);
	Запрос.УстановитьПараметр("ВидПлощади", Справочники.ВидыПлощадей.ОтапливаемаяПлощадь);
	Результат = Запрос.Выполнить();
	Если НЕ Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл
			ПлощадьПомещения = Выборка.Площадь;
		КонецЦикла;
		Возврат ПлощадьПомещения;
	Иначе
		ПлощадьПомещения = 0;
		Возврат ПлощадьПомещения;
	КонецЕсли;
КонецФункции

Функция КоличествоПриборовВДоме(МетодУстановкиПрибора, ЛицевойСчет = "", ПериодНачисления) Экспорт
	Запрос = Новый Запрос;
	Условие = "";
	Если ЛицевойСчет <> "" Тогда
		Условие = " И ОбъектУстановки = &ЛицевойСчет";
		Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
	КонецЕсли;
	Если МетодУстановкиПрибора = Перечисления.МетодыУстановкиПриборовУчета.ВКО Тогда
		Условие = Условие + " И ПриборУчета.ВКО = ИСТИНА И ПриборУчета.ОбщедомовойСчетчик = ЛОЖЬ";
	Иначе
		Условие = Условие + " И ПриборУчета.ВРО = ИСТИНА";
	КонецЕсли;
	Запрос.Текст = 
	    "ВЫБРАТЬ ПЕРВЫЕ 1
	    |	УстановленныеПриборыУчетаСрезПоследних.ПриборУчета,
	    |	УстановленныеПриборыУчетаСрезПоследних.ОбъектУстановки,
	    |	УстановленныеПриборыУчетаСрезПоследних.ПриборУчета.ВРО,
	    |	УстановленныеПриборыУчетаСрезПоследних.ПриборУчета.ВКО,
	    |	РасчетПоказанийПриборовОтопление.Значение,
	    |	УстановленныеПриборыУчетаСрезПоследних.ПриборУчета.Коэффициент
	    |ИЗ
	    |	РегистрСведений.УстановленныеПриборыУчета.СрезПоследних(
	    |			&НаДату,
	    |			ПриборУчета.Услуга.ВидУслуги = &ВидУслуги
	    |				И Действует = ИСТИНА " + Условие + ") КАК УстановленныеПриборыУчетаСрезПоследних
	    |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.РасчетПоказанийПриборовОтопление КАК РасчетПоказанийПриборовОтопление
	    |		ПО УстановленныеПриборыУчетаСрезПоследних.ПриборУчета = РасчетПоказанийПриборовОтопление.ПриборУчета
		|УПОРЯДОЧИТЬ ПО
	    |	РасчетПоказанийПриборовОтопление.Период УБЫВ";
	Запрос.УстановитьПараметр("НаДату", НачалоМесяца(ПериодНачисления));
	Запрос.УстановитьПараметр("ВидУслуги", Справочники.ВидыУслуг.Отопление);
	Результат = Запрос.Выполнить().Выгрузить();
	Возврат Результат;
КонецФункции

// " + Условие + " 

Функция ПолучитьТарифПоУслуге(Услуга) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТарифыСрезПоследних.ЗначениеТарифа,
		|	ТарифыСрезПоследних.НормаПотребления,
		|	ТарифыСрезПоследних.ЗначениеТарифаПоНорме
		|ИЗ
		|	РегистрСведений.Тарифы.СрезПоследних(&Период, Услуга = &Услуга)  КАК ТарифыСрезПоследних";
	
	Запрос.УстановитьПараметр("Период", Новый Граница(ТекущаяДата(), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Услуга", Услуга);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Тарифы = Новый Структура;
	
	Пока Выборка.Следующий() Цикл
		Тарифы.Вставить("ЗначениеТарифа", Выборка.ЗначениеТарифа);
		Тарифы.Вставить("НормаПотребления", Выборка.НормаПотребления);
		Тарифы.Вставить("ЗначениеТарифаПоНорме", Выборка.ЗначениеТарифаПоНорме);
	КонецЦикла;
    Возврат Тарифы;
КонецФункции

Функция ПолучитьРаспределениеПрошлогоМесяца(ПриборУчета, Объект = Неопределено) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 
	    "ВЫБРАТЬ
	    |	РаспределениеГорячейВодыСрезПоследних.ЗначениеДляРаспределеня
	    |ИЗ
	    |	РегистрСведений.РаспределениеГорячейВоды.СрезПоследних КАК РаспределениеГорячейВодыСрезПоследних
	    |ГДЕ
	    |	РаспределениеГорячейВодыСрезПоследних.Период МЕЖДУ &НачПериода И &КонПериода
	    |	И РаспределениеГорячейВодыСрезПоследних.ОбщедомовойПриборУчета = &ОбщедомовойПриборУчета
	    |	И РаспределениеГорячейВодыСрезПоследних.Активность = ИСТИНА";
	Запрос.УстановитьПараметр("ОбщедомовойПриборУчета", ПриборУчета);
	Запрос.УстановитьПараметр("НачПериода", ДобавитьМесяц(НачалоМесяца(Объект.Дата), -1));
	Запрос.УстановитьПараметр("КонПериода", ДобавитьМесяц(КонецМесяца(Объект.Дата), -1));
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Значение = Выборка.ЗначениеОбщедомовое;
	КонецЦикла;
	Если Значение = Неопределено Тогда
		Значение = 0;
	КонецЕсли;
	Возврат Значение;
КонецФункции

// Отримати опалювальну площу споживачів з лічильниками ВКО
//
Функция ВыборкаПлощадейСВКО(Здание, Подъезд = "") Экспорт
	Запрос = Новый Запрос;
	Если Подъезд <> "" Тогда
		Условие = " И ПлощадьОбъектовЛицевыхСчетовСрезПоследних.Помещение.Подъезд = &Подъезд";
		Запрос.УстановитьПараметр("Подъезд", Подъезд);
	КонецЕсли;
	Запрос.Текст =
	    "ВЫБРАТЬ
	    |	ПлощадьОбъектовЛицевыхСчетовСрезПоследних.Площадь,
	    |	УстановленныеПриборыУчетаСрезПоследних.ОбъектУстановки
	    |ИЗ
	    |	РегистрСведений.ПлощадьОбъектовЛицевыхСчетов.СрезПоследних(&НаДату, ) КАК ПлощадьОбъектовЛицевыхСчетовСрезПоследних
	    |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УстановленныеПриборыУчета.СрезПоследних(&НаДату, ) КАК УстановленныеПриборыУчетаСрезПоследних
	    |			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛицевыеСчета.СрезПоследних КАК ЛицевыеСчетаСрезПоследних
	    |			ПО УстановленныеПриборыУчетаСрезПоследних.ОбъектУстановки = ЛицевыеСчетаСрезПоследних.ЛицевойСчет
	    |		ПО (УстановленныеПриборыУчетаСрезПоследних.ОбъектУстановки.ОбъектЛицевогоСчета = ПлощадьОбъектовЛицевыхСчетовСрезПоследних.Помещение)
	    |ГДЕ
	    |	УстановленныеПриборыУчетаСрезПоследних.ПриборУчета.ВКО = ИСТИНА " + Условие + "
	    |	И ПлощадьОбъектовЛицевыхСчетовСрезПоследних.ВидПлощади = &ВидПлощади
	    |	И ЛицевыеСчетаСрезПоследних.ЛицевойСчет.Владелец = &Здание";
	Запрос.УстановитьПараметр("НаДату", ТекущаяДата());
	Запрос.УстановитьПараметр("Здание", Здание);
	Запрос.УстановитьПараметр("ВидПлощади", Справочники.ВидыПлощадей.ОтапливаемаяПлощадь);
	Результат = Запрос.Выполнить().Выгрузить();
	Возврат Результат;
КонецФункции

Функция ТаблицаЛС(ПериодНачисления, Услуга, ВидБазыРаспределения, Здание, Подъезд) Экспорт
	ТекстЗапроса =
			"ВЫБРАТЬ
			|	НазначенныеУслугиСрезПоследних.ЛицевойСчет КАК ЛицевойСчет,
			|	ЕСТЬNULL(ПлощадьОбъектовЛицевыхСчетовСрезПоследних.Площадь, 0) КАК ЗначениеБазы,
			|	НазначенныеУслугиСрезПоследних.ЛицевойСчет.ОбъектЛицевогоСчета КАК ОбъектЛицевогоСчета,
			|	ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ОтветственныйВладелец КАК ОтветственныйВладелец,
			|	&Период КАК Период
			|ИЗ
			|	РегистрСведений.НазначенныеУслуги.СрезПоследних(
			|			&Период,
			|			ЛицевойСчет.Владелец = &Здание
			|				И Услуга = &Услуга
			//|				И НЕ ЛицевойСчет В (&СписокЛицевыхСчетов)
			|				И ВЫБОР
			|					КОГДА &Подъезд = ЗНАЧЕНИЕ(Справочник.Подъезды.ПустаяСсылка)
			|						ТОГДА ИСТИНА
			|					ИНАЧЕ ЛицевойСчет.ОбъектЛицевогоСчета.Подъезд = &Подъезд
			|				КОНЕЦ) КАК НазначенныеУслугиСрезПоследних
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПлощадьОбъектовЛицевыхСчетов.СрезПоследних(&Период, ВидПлощади = &ВидБазыРаспределения) КАК ПлощадьОбъектовЛицевыхСчетовСрезПоследних
			|		ПО НазначенныеУслугиСрезПоследних.ЛицевойСчет.ОбъектЛицевогоСчета = ПлощадьОбъектовЛицевыхСчетовСрезПоследних.Помещение
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОтветственныйВладелецЛицевогоСчета.СрезПоследних(&Период, ) КАК ОтветственныйВладелецЛицевогоСчетаСрезПоследних
			|		ПО НазначенныеУслугиСрезПоследних.ЛицевойСчет = ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ЛицевойСчет
			|ГДЕ
			|	НазначенныеУслугиСрезПоследних.Действует = ИСТИНА
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	НазначенныеУслугиСрезПоследних.ЛицевойСчет,
			|	ЕСТЬNULL(ПлощадьОбъектовЛицевыхСчетовСрезПоследних.Площадь, 0),
			|	НазначенныеУслугиСрезПоследних.ЛицевойСчет.ОбъектЛицевогоСчета,
			|	ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ОтветственныйВладелец,
			|	НазначенныеУслугиСрезПоследних.Период
			|ИЗ
			|	РегистрСведений.НазначенныеУслуги.СрезПоследних(
			|			&Период,
			|			ЛицевойСчет.Владелец = &Здание
			|				И Услуга = &Услуга
			//|				И НЕ ЛицевойСчет В (&СписокЛицевыхСчетов)
			|				И ВЫБОР
			|					КОГДА &Подъезд = ЗНАЧЕНИЕ(Справочник.Подъезды.ПустаяСсылка)
			|						ТОГДА ИСТИНА
			|					ИНАЧЕ ЛицевойСчет.ОбъектЛицевогоСчета.Подъезд = &Подъезд
			|				КОНЕЦ) КАК НазначенныеУслугиСрезПоследних
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПлощадьОбъектовЛицевыхСчетов.СрезПоследних(&Период, ВидПлощади = &ВидБазыРаспределения) КАК ПлощадьОбъектовЛицевыхСчетовСрезПоследних
			|		ПО НазначенныеУслугиСрезПоследних.ЛицевойСчет.ОбъектЛицевогоСчета = ПлощадьОбъектовЛицевыхСчетовСрезПоследних.Помещение
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОтветственныйВладелецЛицевогоСчета.СрезПоследних(&Период, ) КАК ОтветственныйВладелецЛицевогоСчетаСрезПоследних
			|		ПО НазначенныеУслугиСрезПоследних.ЛицевойСчет = ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ЛицевойСчет
			|ГДЕ
			|	НазначенныеУслугиСрезПоследних.Действует = ЛОЖЬ
			|	И НазначенныеУслугиСрезПоследних.Период > НАЧАЛОПЕРИОДА(&Период, МЕСЯЦ)";
			
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
		
	Запрос.УстановитьПараметр("Период", КонецМесяца(ПериодНачисления));		
	Запрос.УстановитьПараметр("Услуга", Услуга);		
	Запрос.УстановитьПараметр("ВидБазыРаспределения", Услуга.БазаРаспределенияРасчетнойУслуги);		
	Запрос.УстановитьПараметр("Здание", Здание);
	Запрос.УстановитьПараметр("Подъезд", Подъезд);
	ТаблицаЛицевыхСчетов = Запрос.Выполнить().Выгрузить();
	
	ИтогБазы = ТаблицаЛицевыхСчетов.Итог("ЗначениеБазы");
	Если ИтогБазы = 0 Тогда
		Сообщить(НСтр("ru='Итог по площади равен нулю.';uk='Підсумок по площі дорівнює нулю.'"));
		Возврат 0;
	Иначе
		Возврат ИтогБазы;
	КонецЕсли;
КонецФункции
