	Возврат "4BFE";
КонецФункции

// 
// Подключение компоненты СЛК
//
Процедура ПодключитьКомпоненту() Экспорт
	
	// Подключение компоненты из общего макета "КомпонентаСЛК", в который
	// должен быть загружен zip-архив с модулями компоненты для всех поддерживаемых
	// операционных систем.
	//
	// Архив с компонентой включен в поставку - licenceaddin-{%version%}-template.zip
	//
	// Обязательно указываем тип компоненты - ТипВнешнейКомпоненты.Native
	
	Если НЕ ПодключитьВнешнююКомпоненту("ОбщийМакет.КомпонентаСЛК", "Licence", ТипВнешнейКомпоненты.Native) Тогда
		СисИнфо = Новый СистемнаяИнформация;
		ВызватьИсключение "(EAttachAddIn) Ошибка подключения компоненты СЛК " + СисИнфо.ТипПлатформы;
	КонецЕсли;
	Возврат;
	
	#Область Отладка
	// Подключение компоненты СЛК 2.1
	//ПодключитьВнешнююКомпоненту("d:\Projects\Licence\v2.1\Bin\LicenceAddIn.dll", "Licence", ТипВнешнейКомпоненты.Native);
	
	//
	// Для отладки загрузка из файла, в реальной работе необходимо подключать компоненту 
	// только из макета.
	//
	СисИнфо = Новый СистемнаяИнформация;
	Если СисИнфо.ТипПлатформы = ТипПлатформы.Windows_x86 Тогда
		Компонента = "d:\Projects\Licence\v3.0\LicenceAddIn\bin\Debug\licenceaddin.dll";
		//Компонента = "c:\licenceaddin.dll";
	ИначеЕсли СисИнфо.ТипПлатформы = ТипПлатформы.Windows_x86_64 Тогда
		Компонента = "d:\Projects\Licence\v3.0\LicenceAddIn\bin\Debug\licenceaddin-x86_64.dll";
	ИначеЕсли СисИнфо.ТипПлатформы = ТипПлатформы.Linux_x86 Тогда
		Компонента = "/media/sf_Projects/Licence/v3.0/LicenceAddIn/bin/Debug/licenceaddin.so";
		//Компонента = "/media/sf_Projects/Licence/v3.0/LicenceAddIn/bin/Release/licenceaddin.so";
	ИначеЕсли СисИнфо.ТипПлатформы = ТипПлатформы.Linux_x86_64 Тогда
		Компонента = "/media/sf_Projects/Licence/v3.0/LicenceAddIn/bin/Debug/licenceaddin-x86_64.so";
		//Компонента = "/media/sf_Projects/Licence/v3.0/LicenceAddIn/bin/Release/licenceaddin-x86_64.so";
	Иначе
		ВызватьИсключение "Платформа " + СисИнфо.ТипПлатформы + " не поддерживается";
	КонецЕсли;
	
	Если НЕ ПодключитьВнешнююКомпоненту(Компонента, "Licence", ТипВнешнейКомпоненты.Native) Тогда
		ВызватьИсключение "Ошибка подключения компоненты СЛК " + СисИнфо.ТипПлатформы;
	КонецЕсли;
	#КонецОбласти 
КонецПроцедуры

