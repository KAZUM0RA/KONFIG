//
// Проверка, что версия загруженной компоненты СЛК соответствует (больше или равна)
// переданному значению
//
Процедура ПроверитьВерсию(НеобходимаяВерсия) Экспорт
	Компонента = ОбъектКомпоненты();
	Попытка
		ВерсияПодходит = Компонента.ПроверитьВерсию(НеобходимаяВерсия);
	Исключение
		ВерсияПодходит = Ложь;
	КонецПопытки;
	
	Если ВерсияПодходит = Неопределено Тогда
		ВызватьИсключение Компонента.ПолучитьОписаниеОшибки();
	ИначеЕсли НЕ ВерсияПодходит Тогда
		ВызватьИсключение "(EVersionMismatch) Устаревшая версия СЛК " + Компонента.Версия + ", для работы конфигурации необходима СЛК " + НеобходимаяВерсия + " или выше";
	КонецЕсли;
КонецПроцедуры

//
// Информация о текущем сеансе работы
//
Функция ДанныеСеанса() Экспорт
	НомерСеанса = НомерСеансаИнформационнойБазы();
	
	Сеансы = ПолучитьСеансыИнформационнойБазы();
	Для Каждого С Из Сеансы Цикл
		Если С.НомерСеанса = НомерСеанса Тогда
			Сеанс = С;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Строка(Сеанс.НомерСеанса) + "," + Сеанс.ИмяКомпьютера + "," + Сеанс.ИмяПриложения + "," + Сеанс.Пользователь + "," + ТекущийРежимЗапуска();
КонецФункции

//
// Информация об ИБ
//
Функция ОписаниеИБ() Экспорт
	
	СисИнфо = Новый СистемнаяИнформация;

	ИсходнаяСтрока = СтрокаСоединенияИнформационнойБазы();
	
	Сервер = "";
	ИБ = "";
	
	Фрагменты = СтрЗаменить(ИсходнаяСтрока,";",Символы.ПС);
	Для Ном = 1 По СтрЧислоСтрок(Фрагменты) Цикл
		Стр = СтрЗаменить(СтрПолучитьСтроку(Фрагменты, Ном), "=", Символы.ПС);
		Параметр = СтрПолучитьСтроку(Стр, 1);
		Значение = СтрЗаменить(СтрПолучитьСтроку(Стр, 2), """", "");
		Если Параметр = "File" Тогда
			Возврат СисИнфо.ВерсияПриложения + ", Файл (" + Значение + "), " + СисИнфо.ТипПлатформы + ", " + Метаданные.РежимСовместимости;
		ИначеЕсли Параметр = "Srvr" Тогда
			Сервер = Значение;
		ИначеЕсли Параметр = "Ref" Тогда
			ИБ = Значение;
		КонецЕсли;	
	КонецЦикла;
	Возврат СисИнфо.ВерсияПриложения + ", Сервер (" + Сервер + ", " + ИБ + "), " + СисИнфо.ТипПлатформы + ", " + Метаданные.РежимСовместимости;
КонецФункции

// Получение возможности освобождения лицензии при
// завершении работы
Функция ОсвобождатьЛицензиюПриЗавершенииРаботы() Экспорт
	
	ЭтоКлиентСервернаяБаза = Не Найти(ВРег(СтрокаСоединенияИнформационнойБазы()), "FILE=");
	
	СисИнфо = Новый СистемнаяИнформация();
	
	Версия = СтрЗаменить(Метаданные.РежимСовместимости, "_", ".");
	Позиция = Найти(Версия, "8");
	Версия = ?(Позиция > 0, Прав(Версия, СтрДлина(Версия) - Позиция + 1), СисИнфо.ВерсияПриложения);
	
	ВерсияНиже8_3_8 = СЛКОбщие.СравнитьВерсии(Версия, "8.3.8") < 0;
	
	Возврат ЭтоКлиентСервернаяБаза И ВерсияНиже8_3_8;
КонецФункции 
 
