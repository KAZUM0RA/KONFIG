Функция ДанныеПоЛицевомуСчету(ЛицевойСчет, КодЯзыка)
	
	Результат = НСтр("ru = 'Не вдалося отримати данні за особовим рахунком '; uk = 'Не вдалося отримати данні за особовим рахунком '", КодЯзыка);
	
		
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ЛицевойСчет",ЛицевойСчет);
	ЗАпрос.Текст = "ВЫБРАТЬ
	               |	РасчетыПоЛицевымСчетамОстатки.Организация,
	               |	РасчетыПоЛицевымСчетамОстатки.ЛицевойСчет КАК ЛицевойСчет,
	               |	РасчетыПоЛицевымСчетамОстатки.Услуга,
	               |	СУММА(РасчетыПоЛицевымСчетамОстатки.СуммаОстаток) КАК СуммаОстаток
	               |ИЗ
	               |	РегистрНакопления.РасчетыПоЛицевымСчетам.Остатки(, ЛицевойСчет = &ЛицевойСчет) КАК РасчетыПоЛицевымСчетамОстатки
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	РасчетыПоЛицевымСчетамОстатки.ЛицевойСчет,
	               |	РасчетыПоЛицевымСчетамОстатки.Организация,
	               |	РасчетыПоЛицевымСчетамОстатки.Услуга
	               |ИТОГИ
	               |	СУММА(СуммаОстаток)
	               |ПО
	               |	ЛицевойСчет";
	РезултатЗапроса = Запрос.Выполнить();
	
	Если РезултатЗапроса.Пустой() Тогда
		ТекстОтвета = НСтр("ru = 'Зареєстрованих боргів не знайдено '; uk = 'Зареєстрованих боргів не знайдено '", КодЯзыка);
		Возврат ТекстОтвета;
	КонецЕсли;	
	
	ВыборкаОбщийОстаток = РезултатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);

	
	Пока  ВыборкаОбщийОстаток.Следующий() Цикл
		
		ОбщаяЗадолженность = ВыборкаОбщийОстаток.СуммаОстаток;
		ТекстОтвета = НСтр("ru = 'Загальна заборгованість становить '; uk = 'Загальна заборгованість становить '", КодЯзыка);
		Результат = ТекстОтвета + ОбщаяЗадолженность +Символы.ПС+Символы.ПС;
	
	
		ВыборкаПоУслугам = ВыборкаОбщийОстаток.Выбрать();
		Пока ВыборкаПоУслугам.Следующий() Цикл
			Результат = Результат+ ВыборкаПоУслугам.Услуга.Наименование+"..."+ВыборкаПоУслугам.СуммаОстаток+"грн."+Символы.ПС;
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Результат;
	
