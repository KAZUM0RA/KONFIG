Функция ЗапускОбработкиЗапросов() Экспорт
	
	БазаФайловая = ОбщегоНазначения.ИнформационнаяБазаФайловая("");
	
	Если НЕ БазаФайловая  Тогда
		Возврат Ложь;
	КонецЕсли;  	
	
	АвторизированоПользователей = 0;
	
	МассивСеансов = ПолучитьСеансыИнформационнойБазы();
	Для Инд = 0 По МассивСеансов.ВГраница() Цикл
		Если МассивСеансов[Инд].ИмяПриложения = "1CV8C" Тогда
			АвторизированоПользователей  = АвторизированоПользователей + 1;
		КонецЕсли;
		Инд = Инд+1;
	КонецЦикла;	
	   
	
	Если АвторизированоПользователей <=1 и ЗапускатьКлиент() Тогда
		Возврат Истина;                                                               
	ИНаче
		Возврат Ложь;
	КонецЕсли;	
	                       
КонецФункции








