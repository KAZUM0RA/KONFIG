		//ПоказанияВключённыеВРасчет
		Если ВыборкаДетальныеЗаписи.ЗначениеПослПоказаний <> Null Тогда
			Показания = Показания + Символы.ПС + ТекстВнутриСообщения2 + Строка(ВыборкаДетальныеЗаписи.ПоказанияВключённыеВРасчет)+" "+ Строка(ВыборкаДетальныеЗаписи.ПриборУчетаЕдиницаИзмерения);
		Иначе
			Показания = Показания + Символы.ПС +ТекстВнутриСообщения2 + "0"+" "+ Строка(ВыборкаДетальныеЗаписи.ПриборУчетаЕдиницаИзмерения);
		КонецЕсли;
		//ПоказанияВведенные
		Если ВыборкаДетальныеЗаписи.ЗначениеПослПоказаний <> Null Тогда
			Показания = Показания + Символы.ПС + ТекстВнутриСообщения1 + Строка(ВыборкаДетальныеЗаписи.ЗначениеПослПоказаний)+" "+ Строка(ВыборкаДетальныеЗаписи.ПриборУчетаЕдиницаИзмерения);
			Показания = Показания + Символы.ПС + Строка(ВыборкаДетальныеЗаписи.ИсточникВводаПоказаний) + " "+ Строка(Формат(ВыборкаДетальныеЗаписи.Период,"ДЛФ=Д"));
		Иначе
			Показания = Показания + Символы.ПС +ТекстВнутриСообщения1 + "0"+" "+ Строка(ВыборкаДетальныеЗаписи.ПриборУчетаЕдиницаИзмерения);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Показания;
