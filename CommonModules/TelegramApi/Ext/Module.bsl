		|			ТОГДА ПоказанияПриборовУчета.ВидТарифа
		|		КОГДА НЕ ПоказанияПриборовУчетаССайта.ВидТарифа ЕСТЬ NULL
		|			ТОГДА ПоказанияПриборовУчетаССайта.ВидТарифа
		|		КОГДА НЕ ПоказанияПУИзВнешнихИсточников.ВидТарифа ЕСТЬ NULL
		|			ТОГДА ПоказанияПУИзВнешнихИсточников.ВидТарифа
		|		КОГДА НЕ СнятыеПоказанияПриборовУчета.ПриборУчета ЕСТЬ NULL
		|			ТОГДА ЗНАЧЕНИЕ(перечисление.ВидыТарифов.Общий)
		|	КОНЕЦ КАК ВидТарифаПослПоказаний,
		|	ВЫБОР
		|		КОГДА НЕ ПоказанияПриборовУчетаИзТелеграмм.Значение ЕСТЬ NULL
		|			ТОГДА ""Телеграмм""
		|		КОГДА НЕ ПоказанияПриборовУчета.Значение ЕСТЬ NULL
		|			ТОГДА ""Программа""
		|		КОГДА НЕ ПоказанияПриборовУчетаССайта.Значение ЕСТЬ NULL
		|			ТОГДА ""Сайт""
		|		КОГДА НЕ ПоказанияПУИзВнешнихИсточников.Значение ЕСТЬ NULL
		|			ТОГДА ""Программа""
		|		КОГДА НЕ СнятыеПоказанияПриборовУчета.Значение ЕСТЬ NULL
		|			ТОГДА ""Контролер""
		|	КОНЕЦ КАК ИсточникВводаПоказаний,
		|	отборСамогоПослПУиПерида.ПриборУчета.ЕдиницаИзмерения
		|ИЗ
		|	отборСамогоПослПУиПерида КАК отборСамогоПослПУиПерида
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПоказанияПриборовУчетаИзТелеграмм КАК ПоказанияПриборовУчетаИзТелеграмм
		|		ПО отборСамогоПослПУиПерида.ПриборУчета = ПоказанияПриборовУчетаИзТелеграмм.ПриборУчета
		|			И отборСамогоПослПУиПерида.Период = ПоказанияПриборовУчетаИзТелеграмм.Период
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПоказанияПриборовУчета КАК ПоказанияПриборовУчета
		|		ПО отборСамогоПослПУиПерида.ПриборУчета = ПоказанияПриборовУчета.ПриборУчета
		|			И отборСамогоПослПУиПерида.Период = ПоказанияПриборовУчета.Период
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПоказанияПриборовУчетаССайта КАК ПоказанияПриборовУчетаССайта
		|		ПО отборСамогоПослПУиПерида.ПриборУчета = ПоказанияПриборовУчетаССайта.ПриборУчета
		|			И отборСамогоПослПУиПерида.Период = ПоказанияПриборовУчетаССайта.Период
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПоказанияПУИзВнешнихИсточников КАК ПоказанияПУИзВнешнихИсточников
		|		ПО отборСамогоПослПУиПерида.ПриборУчета = ПоказанияПУИзВнешнихИсточников.ПриборУчета
		|			И отборСамогоПослПУиПерида.Период = ПоказанияПУИзВнешнихИсточников.Период
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СнятыеПоказанияПриборовУчета КАК СнятыеПоказанияПриборовУчета
		|		ПО отборСамогоПослПУиПерида.ПриборУчета = СнятыеПоказанияПриборовУчета.ПриборУчета
		|			И отборСамогоПослПУиПерида.Период = СнятыеПоказанияПриборовУчета.Период";

	
	Запрос.УстановитьПараметр("ЛС", ЛС);
	
	РезультатЗапроса = Запрос.Выполнить();
	 
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	МассивПоказанияСчетчиков = Новый Массив;
			
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Прибор = Новый Структура;
		Прибор.Вставить("ПриборНомер", Строка(ВыборкаДетальныеЗаписи.ПриборУчета));
		//Прибор.Вставить("Услуга", Строка(ВыборкаДетальныеЗаписи.ПриборУчета.Услуга));
		Прибор.Вставить("СсылкаНаПрибор", Строка(ВыборкаДетальныеЗаписи.ПриборУчета.УникальныйИдентификатор()));
		Прибор.Вставить("ВидТарифа", Строка(Перечисления.ВидыТарифов.Индекс(ВыборкаДетальныеЗаписи.ВидТарифаПослПоказаний)));
		Если ВыборкаДетальныеЗаписи.ЗначениеПослПоказаний <> Null Тогда
			Прибор.Вставить("ПоказанияПрибора", Строка(ВыборкаДетальныеЗаписи.ЗначениеПослПоказаний));
			Прибор.Вставить("ЕдиницаИзмерения", Строка(ВыборкаДетальныеЗаписи.ПриборУчетаЕдиницаИзмерения));
		Иначе
			Прибор.Вставить("ПоказанияПрибора", "0");
			Прибор.Вставить("ЕдиницаИзмерения", Строка(ВыборкаДетальныеЗаписи.ПриборУчетаЕдиницаИзмерения));
		КонецЕсли;
		МассивПоказанияСчетчиков.Добавить(Прибор); 
	КонецЦикла;
	
	Возврат МассивПоказанияСчетчиков;
КонецФункции	
	
//Создал Петров В.А Эта функция нужна для индикации что пользователь прислал данные Прибора учета
// определение идет по предидущему запросу  , необработаный запрос перед текущим
//и проверяется на наличие содержимого в команде "/virt_button"
// Возвращает строку в которой есть ссылка на прибор, и Вид тарифа
Функция ЭтоДанныеПоПриборуУчетаДляВнесения(id,ЗП_update_id)
	Результат = Неопределено;	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	update.id,
		|	МАКСИМУМ(update.update_id) КАК update_id
		|ИЗ
		|	РегистрСведений.update КАК update
		|ГДЕ
		|	update.id = &Id
		|	И update.Обработан = ИСТИНА
		|	И update.update_id < &update_id
		|
		|СГРУППИРОВАТЬ ПО
		|	update.id";
		
	Запрос.УстановитьПараметр("Id", id);
	Запрос.УстановитьПараметр("update_id", ЗП_update_id);
	РезультатЗапроса = Запрос.Выполнить();	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		 update_id=ВыборкаДетальныеЗаписи.update_id;		 
	КонецЦикла;
		
	Запрос2 = Новый Запрос;
	Запрос2.Текст = 
	     "ВЫБРАТЬ
	     |	update.text
	     |ИЗ
	     |	РегистрСведений.update КАК update
	     |ГДЕ
	     |	update.update_id = &update_id
	     |	И update.id = &id
	     |	И update.Обработан = ИСТИНА";
	
	Запрос2.УстановитьПараметр("id", id);
	Запрос2.УстановитьПараметр("update_id", update_id);
	
	РезультатЗапроса2 = Запрос2.Выполнить();
	
	ВыборкаДетальныеЗаписи2 = РезультатЗапроса2.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи2.Следующий() Цикл
		text = ВыборкаДетальныеЗаписи2.text;
	КонецЦикла;
	
	Если  СтрЧислоВхождений(text, "/virt_button")  Тогда
		Результат = text; 
	КонецЕсли;	
	
	Возврат Результат;	
КонецФункции

Функция ИзменитьРегПользователиТелеграммПроходящиеРегистрацию(id, КодЯзыка = Неопределено, НомерТелефона = Неопределено)

	ПользовательПроходящийРегистрацию = РегистрыСведений.ПользователиТелеграммПроходящиеРегистрацию.СоздатьМенеджерЗаписи();
	ПользовательПроходящийРегистрацию.idПользователя = id;
	ПользовательПроходящийРегистрацию.Прочитать();
	
	ПользовательПроходящийРегистрацию.idПользователя = id;
	
	Call_backПользователь = Новый Структура;
	Call_backПользователь.Вставить("КодЯзыка",ПользовательПроходящийРегистрацию.КодЯзыка );
	Call_backПользователь.Вставить("НомерТелефона", ПользовательПроходящийРегистрацию.НомерТелефона);
						
	Если КодЯзыка <> Неопределено Тогда
		ПользовательПроходящийРегистрацию.КодЯзыка = КодЯзыка;
	Иначе
		ПользовательПроходящийРегистрацию.КодЯзыка = Call_backПользователь.КодЯзыка;
	КонецЕсли;
	
	Если НомерТелефона <> Неопределено Тогда
		ПользовательПроходящийРегистрацию.НомерТелефона = НомерТелефона;
	Иначе
		ПользовательПроходящийРегистрацию.НомерТелефона = Call_backПользователь.НомерТелефона;
	КонецЕсли;
	
	ПользовательПроходящийРегистрацию.Записать(Истина);	
КонецФункции

Функция ПользователяЕщёНетВЗарегестрированных(idПользователя)
	ПризнакПользователяЕщёНетВЗарегестрированных = Истина;
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПользователиТелеграмм.idПользователя
		|ИЗ
		|	РегистрСведений.ПользователиТелеграмм КАК ПользователиТелеграмм
		|ГДЕ
		|	ПользователиТелеграмм.idПользователя = &idПользователя";
	
	Запрос.УстановитьПараметр("idПользователя", idПользователя);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ПризнакПользователяЕщёНетВЗарегестрированных = Ложь;
		Прервать;
	КонецЦикла;

	Возврат ПризнакПользователяЕщёНетВЗарегестрированных;
	
КонецФункции

Функция ОставитьТолькоЦифрыВСтроке(РазбираемаяСтрока) 

	Цифры = "1234567890";
	ЦифроваяЧасть = "";
	Для НомерСимвола = 1 По СтрДлина(РазбираемаяСтрока) Цикл
		ТекущийСимвол = Сред(РазбираемаяСтрока, НомерСимвола, 1);
		Если Найти(Цифры, ТекущийСимвол) Тогда
			ЦифроваяЧасть = ЦифроваяЧасть + ТекущийСимвол;
		КонецЕсли;
	КонецЦикла;
	Возврат ЦифроваяЧасть;
	
КонецФункции

Функция Найти1ЛСПоНомеруТелефона(ЗначениеПоиска) Экспорт
	
	ЛицевойСчет = Справочники.ЛицевыеСчета.ПустаяСсылка();
	НомерТелефона = СтрЗаменить(ЗначениеПоиска," ","");
	НомерТелефона = СтрЗаменить(НомерТелефона,"+","");
	НомерТелефона = Прав(НомерТелефона,7);		
			
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЛицевыеСчета.Ссылка
	|ИЗ
	|	Справочник.ЛицевыеСчета КАК ЛицевыеСчета
	|ГДЕ
	|	ЛицевыеСчета.Телефон ПОДОБНО ""%"" + &НомерТелефона + ""%""";
		
	Запрос.УстановитьПараметр("НомерТелефона", НомерТелефона);
		
	ВыборкаЛС = Запрос.Выполнить().Выбрать();
		                                       
	Если ВыборкаЛС.Следующий() Тогда
		ЛицевойСчет = ВыборкаЛС.Ссылка;
	КонецЕсли;		
	
	Возврат ЛицевойСчет;
		
КонецФункции

