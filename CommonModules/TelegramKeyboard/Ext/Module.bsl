//Эта функция нужна для Формирования клавиатуры из массива данных описывающих приборы учета подключенных к Лицевому счету
//Кнопки сформированной клавиатуры вернут в callback_data Строки с гуид прибора и тариф
Функция  СоздатьКлавиатуруВиртуальнойКнопки(МассивСчетчиковДляКнопок, Клавиатура, КодЯзыка) Экспорт     
		
	Если ТипЗнч(Клавиатура) = Тип("СправочникСсылка.КлавиатурыTelegram") Тогда
		СоставКлавиатуры = Клавиатура.Состав.Выгрузить(, "Текст,ВозвращаемоеЗначение");
		ДЛя каждого Колонка Из СоставКлавиатуры.Колонки Цикл
			Колонка.Имя = "Клавиатура" + Колонка.Имя;
		КонецЦикла;
		
	Иначе
		СоставКлавиатуры = Клавиатура;             
	КонецЕсли; 
	
	Если СоставКлавиатуры.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли; 
	
	Результат = Новый Структура;
	Результат.Вставить("inline_keyboard");
	МассивСтрока = Новый Массив;
	
	ИндексКнопки = 0;
	Для Каждого Счетчик Из МассивСчетчиковДляКнопок Цикл
		
			Кнопка = Новый Структура;
			МассивЭлементыСтроки = Новый Массив;
			УникальныйИдентификатор = Новый УникальныйИдентификатор(Счетчик.СсылкаНаПрибор);
			СсылкаНаПрибор = Справочники.ПриборыУчета.ПолучитьСсылку(УникальныйИдентификатор);
			
			text = "N" + Строка(СсылкаНаПрибор.Наименование) +
					 "/" + Строка(Перечисления.ВидыТарифов[Число(Счетчик.ВидТарифа)]) +
					"/" + Строка(Счетчик.ПоказанияПрибора) + Строка(Счетчик.ЕдиницаИзмерения) ;
			Кнопка.Вставить("text", text);
			callback_data ="/virt_button"  +Строка(Счетчик.СсылкаНаПрибор) + Строка(Счетчик.ВидТарифа) + Строка(ИндексКнопки);
			Кнопка.Вставить("callback_data", callback_data );
			МассивЭлементыСтроки.Добавить(Кнопка);
			МассивСтрока.Добавить(МассивЭлементыСтроки);
			ИндексКнопки = ИндексКнопки+1;
	КонецЦикла;
	Кнопка = Новый Структура;	
   	МассивЭлементыСтроки = Новый Массив;
	text = НСтр("ru = 'Вернуться в главное меню'; uk = 'Повернутися до головного меню'", КодЯзыка);
	
	Кнопка.Вставить("text", text);
	callback_data ="/start";
	Кнопка.Вставить("callback_data", callback_data );
	МассивЭлементыСтроки.Добавить(Кнопка);
	МассивСтрока.Добавить(МассивЭлементыСтроки);
	
	Результат["inline_keyboard"] = МассивСтрока;
	
	Возврат Результат;
	
КонецФункции


Функция ПолучитьСтруктуруСообщения(chat_id, text, parse_mode = Неопределено, disable_web_page_preview = Неопределено, 
	disable_notification = Неопределено, reply_to_message_id = Неопределено, reply_markup = Неопределено)    Экспорт
	
	СтруктураНастроек = Новый Структура();
	СтруктураНастроек.Вставить("chat_id", 					chat_id);
	СтруктураНастроек.Вставить("text", 						text);

	Если parse_mode <> Неопределено Тогда
		СтруктураНастроек.Вставить("parse_mode", 				parse_mode);
	КонецЕсли;
	Если disable_web_page_preview <> Неопределено Тогда
		СтруктураНастроек.Вставить("disable_web_page_preview", 	disable_web_page_preview);
	КонецЕсли;
	Если disable_notification <> Неопределено Тогда
		СтруктураНастроек.Вставить("disable_notification", 		disable_notification);
	КонецЕсли;
	Если reply_to_message_id <> Неопределено Тогда
		СтруктураНастроек.Вставить("reply_to_message_id", 		reply_to_message_id);
	КонецЕсли;
	Если reply_markup <> Неопределено Тогда
		СтруктураНастроек.Вставить("reply_markup", 				reply_markup);
	КонецЕсли;
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, СтруктураНастроек);
	Возврат СтрЗаменить(ЗаписьJSON.Закрыть(),"\\","\");
	
КонецФункции

Функция ОтправитьСообщение(IDКлиента, ТекстСообщения, Файл = Неопределено, ДопПараметры = Неопределено, мРезультат = Неопределено, Клавиатура = Неопределено) Экспорт
	
	СтруктураОтвет = Новый Структура("ок,ответ");
	Если Не ЗначениеЗаполнено(IDКлиента) Тогда
		СтруктураОтвет.ок = Ложь;
		СтруктураОтвет.Ответ = "Не найден ID контакта в 1С";
		мРезультат = Ложь;
		Возврат СтруктураОтвет;
	КонецЕсли; 
	
	
	//Обычное сообщение (без файлов)
	Если Файл = Неопределено Тогда
		
		ТелоСообщения = ПолучитьСтруктуруСообщения(IDКлиента, ТекстСообщения,,,,, Клавиатура);
		Результат = ОтправитьЗапросКСервисуТелеграмм("sendMessage",, ТелоСообщения,, IDКлиента);

	Иначе
		//значит отправляем файл
		//нужно понять какой
		//Пока берем за основу, что Файл - это Путь к файлу...
		ОтправлятьКакИзображение = ФайлЯвляетсяИзображением(Файл);
		ТелоСообщенияСтруктура = ПолучитьСтруктуруСообщенияСВложением(IDКлиента, ТекстСообщения, Файл, ОтправлятьКакИзображение, Клавиатура);

		Если ОтправлятьКакИзображение Тогда
			Команда = "sendPhoto";
		Иначе
			Команда = "sendDocument";
		КонецЕсли; 
		Результат = ОтправитьЗапросКСервисуТелеграмм(Команда,,  ТелоСообщенияСтруктура.ТелоЗапроса, ТелоСообщенияСтруктура.Boundary, IDКлиента);
		
	КонецЕсли; 
	
	Если ТипЗнч(Результат) = тип("Структура") Тогда
		Результат.Свойство("ok", мРезультат);
		Результат.Свойство("ok", СтруктураОтвет.ок);
		Результат.Свойство("result", СтруктураОтвет.ответ);
	Иначе
		мРезультат = Ложь;
		СтруктураОтвет.ок = Ложь;
	КонецЕсли; 
	
	Возврат СтруктураОтвет;
	
КонецФункции

Функция ОпределитьПараметрыСообщения(ТекстСообщения, ОткрывающийТег = "[", ЗакрывающийТег = "]") Экспорт  

	
	ПараметрыСообщения = Новый Соответствие;
	
	Текст = ТекстСообщения;
	Позиция = СтрНайти(Текст, ОткрывающийТег);
	Пока Позиция > 0 Цикл
		Текст = Сред(Текст, Позиция + 1);
		Позиция = СтрНайти(Текст, ЗакрывающийТег);
		Если Позиция > 0 Тогда
			НайденныйПараметр = Лев(Текст, Позиция-1);
			ПараметрыСообщения.Вставить(НайденныйПараметр);
			Текст = Сред(Текст, Позиция + 1);
		КонецЕсли;
		Позиция = СтрНайти(Текст, ОткрывающийТег);
	КонецЦикла;
	
	Возврат ПараметрыСообщения;
	
КонецФункции
	
Функция СформироватьТекстСоСмайлами(Знач ТекстСообщения) Экспорт 

	
	ПараметрыСообщения = ОпределитьПараметрыСообщения(ТекстСообщения, "{", "}");
	КодыСмайлов = ПрочитатьКодыСмайлов();
	
	РезультатТекст = ТекстСообщения;
	Для Каждого ПараметрСообщения Из ПараметрыСообщения Цикл
		РезультатТекст = СтрЗаменить(РезультатТекст, "{" + ПараметрСообщения.Ключ + "}", КодыСмайлов[ ПараметрСообщения.Ключ]);
	КонецЦикла;

	Возврат РезультатТекст;

КонецФункции 

Функция ОтправитьЗапросКСервисуТелеграмм(ИмяКоманды, СтруктураПараметров = Неопределено, ТелоЗапроса = Неопределено, Boundary = "", IDКонтакта = "") Экспорт
	
	//Попытка
	//	СтруктураПараметров.offset = "626298964";
	//Исключение
	//КонецПопытки;
	
	Сервер = "api.telegram.org";
	Адрес = ПолучитьТекстЗапросаКТелеграмм(ИмяКоманды, СтруктураПараметров);
	
	Соединение = Новый HTTPСоединение(Сервер,,,,Новый ИнтернетПрокси(истина),5, Новый ЗащищенноеСоединениеOpenSSL);
	Запрос = Новый HTTPЗапрос(Адрес);
	Если ТелоЗапроса <> Неопределено Тогда
		Если ТипЗнч(ТелоЗапроса) = Тип("ДвоичныеДанные") Тогда
			Запрос.Заголовки.Вставить("Content-Type","multipart/form-data; boundary=" + Boundary);
			Запрос.УстановитьТелоИзДвоичныхДанных(ТелоЗапроса);
		ИначеЕсли ТипЗнч(ТелоЗапроса) = Тип("Строка") И Boundary = "" Тогда
			Запрос.Заголовки.Вставить("Content-Type","application/json");
			Запрос.УстановитьТелоИзСтроки(ТелоЗапроса, "CESU-8");
		ИначеЕсли ТипЗнч(ТелоЗапроса) = Тип("Строка") И НЕ ПустаяСтрока(Boundary) Тогда
			Запрос.Заголовки.Вставить("Content-Type","multipart/form-data; boundary="+Boundary);
			Запрос.УстановитьИмяФайлаТела(ТелоЗапроса);	
		КонецЕсли; 
		Ответ = Соединение.ОтправитьДляОбработки(Запрос);
	Иначе
		Ответ = Соединение.Получить(Запрос);
	КонецЕсли;

	Чтение = Новый ЧтениеJSON;
	ОтветСтрокой = Ответ.ПолучитьТелоКакСтроку(); 
	Чтение.УстановитьСтроку(ОтветСтрокой);
	Результат = ПрочитатьJSON(Чтение);
	
	Если Результат.Свойство("ok") И НЕ Результат.ok Тогда
		ЗаписьОбОшибке(IDКонтакта, ОтветСтрокой);
	КонецЕсли; 

	Возврат Результат;
	
КонецФункции

Функция ПолучитьТекстЗапросаКТелеграмм(ИмяКоманды, СтруктураПараметров)  
	
	Сервер = "api.telegram.org";
	КлючАПИ = Константы.КлючAPI.Получить();
	
	Адрес = "bot<token>/";
	Адрес = СтрЗаменить(Адрес, "<token>", КлючАПИ);
	Адрес = Адрес + ИмяКоманды;
	
	ТекстПараметров = СформироватьТекстЗапроса(СтруктураПараметров);
	
	Если НЕ ПустаяСтрока(ТекстПараметров) Тогда
		ТекстПараметров = "?" + ТекстПараметров;
		Адрес = Адрес + ТекстПараметров;
	КонецЕсли;
	
	Возврат Адрес;

КонецФункции

Функция СформироватьТекстЗапроса(СтруктураПараметров)        
	
	Если СтруктураПараметров = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	ТекстЗапроса = "";
	
	Для Каждого ЭлементСтруктуры Из СтруктураПараметров Цикл
		
		Если ЭлементСтруктуры.Значение = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если ТипЗнч(ЭлементСтруктуры.Значение) = Тип("Структура") Тогда
			ТекстЗапроса = ТекстЗапроса + СформироватьТекстЗапроса(ЭлементСтруктуры.Значение);
			Продолжить;
		КонецЕсли;
		ТекстЗапроса = ТекстЗапроса + ?(ПустаяСтрока(ТекстЗапроса), "", "&") + ЭлементСтруктуры.Ключ + "=" + ЭлементСтруктуры.Значение;
		
	КонецЦикла;		
	
	Возврат ТекстЗапроса;
	
КонецФункции

