	Возврат Результат;
	
КонецФункции

Функция  СоздатьКлавиатуру(Клавиатура) Экспорт     
	
	Если ТипЗнч(Клавиатура) = Тип("СправочникСсылка.КлавиатурыTelegram") Тогда
		СоставКлавиатуры = Клавиатура.Состав.Выгрузить(, "Текст,ВозвращаемоеЗначение");
		ДЛя каждого Колонка Из СоставКлавиатуры.Колонки Цикл
			Колонка.Имя = "Клавиатура" + Колонка.Имя;
		КонецЦикла;
		
	Иначе
		СоставКлавиатуры = Клавиатура;             
	КонецЕсли; 
	
	Если СоставКлавиатуры.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли; 
	
	Результат = Новый Структура;
	Результат.Вставить("inline_keyboard");
	МассивСтрока = Новый Массив;
	МассивЭлементыСтроки = Новый Массив;
	
	
	Для Каждого Элемент Из СоставКлавиатуры Цикл
		Кнопка = Новый Структура;
		Кнопка.Вставить("text", СформироватьТекстСоСмайлами(Элемент.КлавиатураТекст));
		Кнопка.Вставить("callback_data", Элемент.КлавиатураВозвращаемоеЗначение);
		//Кнопка.Вставить("url", "https://www.google.com.ua");
		МассивЭлементыСтроки.Добавить(Кнопка);
	КонецЦикла;
	
	МассивСтрока.Добавить(МассивЭлементыСтроки);
	
	Результат["inline_keyboard"] = МассивСтрока;
	
	Возврат Результат;
	
КонецФункции

