
Функция ПрочитатьКодыСмайлов() Экспорт    
	
	ТаблицаСмайлов = ПолучитьОбщийМакет("ТЛГ_ТаблицаСмайлов1");
	Высота = ТаблицаСмайлов.ВысотаТаблицы;
	
	Результат = Новый Соответствие;
	Для Сч = 1 По Высота Цикл
		Результат.Вставить(ТаблицаСмайлов.Область(Сч,1,Сч,1).Текст, ТаблицаСмайлов.Область(Сч,2,Сч,2).Текст);
