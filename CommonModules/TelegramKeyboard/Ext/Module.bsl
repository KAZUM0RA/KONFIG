Процедура ОбратнаяСвязь(id, КодЯзыка, ok)Экспорт
	
	Ключ = Константы.КлючAPI.Получить();
	Сервер = "api.telegram.org";
	Команда = "sendMessage";
	
	Структура_keyboardКН = Новый Структура();
	Структура_keyboardКН.Вставить("text", 						"Отправить номер телефона.");
	Структура_keyboardКН.Вставить("request_contact", 			Истина);
	МассивСтрокиКнопки = Новый Массив;
	МассивСтрокиКнопки.Добавить(Структура_keyboardКН);
	МассивКнопок = Новый Массив;
	МассивКнопок.Добавить(МассивСтрокиКнопки);
	Структура_reply_markup = Новый Структура();
	Структура_reply_markup.Вставить("resize_keyboard",Истина);
	Структура_reply_markup.Вставить("one_time_keyboard",Истина);
	Структура_reply_markup.Вставить("keyboard",МассивКнопок);
	
	СтруктураТелаСообщения = Новый Структура;
	СтруктураТелаСообщения.Вставить("chat_id",Формат(id,"ЧГ="));
	КодЯзыка = "ru";
	ТекстСообщения = НСтр("ru = 'Для регистрации нажмите 	\ud83d\udc47 /Отправить номер телефона/ . '; uk = 'Для реєстрації натисніть \ud83d\udc47 /Надіслати номер телефону/ '", КодЯзыка);
	СтруктураТелаСообщения.Вставить("text", ТекстСообщения);
	СтруктураТелаСообщения.Вставить("reply_markup", Структура_reply_markup);

	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, СтруктураТелаСообщения);
	ТелоСообщения =  СтрЗаменить(ЗаписьJSON.Закрыть(),"\\","\");

	Адрес = ПолучитьТекстЗапросаКТелеграмм(Команда, Неопределено);
	
	Соединение = Новый HTTPСоединение(Сервер,,,,Новый ИнтернетПрокси(истина),5, Новый ЗащищенноеСоединениеOpenSSL);
	Запрос = Новый HTTPЗапрос(Адрес);
	
	Запрос.Заголовки.Вставить("Content-Type","application/json");
	Запрос.УстановитьТелоИзСтроки(ТелоСообщения, "CESU-8");
	Ответ = Соединение.ОтправитьДляОбработки(Запрос);
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку());
	
	ОтветСоотв = ПрочитатьJSON(Чтение,Истина);
	ok = ОтветСоотв["ok"] ;

КонецПроцедуры

