Процедура ЗаписьОбОшибке( IDКонтакта = "", ТекстОшибки = "") Экспорт
	
	ЗаписьЖурналаРегистрации("Сообщение в Telegram", УровеньЖурналаРегистрации.Ошибка,
		,, "Ошибка при отправке сообщения на ID - " + IDКонтакта + " : 
		| " + ТекстОшибки);

КонецПроцедуры  

Функция ФайлЯвляетсяИзображением(ПутьКФайлу) 
	
	Файл = Новый Файл(ПутьКФайлу);
	Расширение = НРег(Файл.Расширение) + ";";
	
	Если СтрНайти(МассивФорматовИзображений(), Расширение) <> 0 Тогда
		Возврат Истина;
	КонецЕсли; 
	
	Возврат Ложь;
	
КонецФункции 

Функция ПолучитьСтруктуруСообщенияСВложением(chat_id, text, Файл, КакИзображение = Ложь, Клавиатура = Неопределено) Экспорт
	
	Boundary = ПолучитьРазделитель();
	
	СтруктураНастроекСообщения = Новый Структура();
	СтруктураНастроекСообщения.Вставить("chat_id", chat_id);
	СтруктураНастроекСообщения.Вставить("caption", text);
	Если Клавиатура <> НЕопределено Тогда
		СтруктураНастроекСообщения.Вставить("reply_markup", Клавиатура);		
	КонецЕсли; 
	
	ФайлРезультат =  ПолучитьДанныеДляОтправки(Файл, СтруктураНастроекСообщения, Boundary, КакИзображение);
	Возврат Новый Структура("ТелоЗапроса,Boundary", ФайлРезультат, Boundary);
	

КонецФункции 

Функция ПолучитьДанныеДляОтправки(ПутьКФайлу, СтруктураСообщения, Boundary, КакФото = Ложь) Экспорт
	
	ТипДокумента = "document";
	Если КакФото Тогда
		ТипДокумента = "photo";
	КонецЕсли; 
	Файл = Новый Файл(ПутьКФайлу);
	ЗаголовокФайла = Файл.ИмяБезРасширения;
	
		
	Итог = "";
	
	СтруктураСообщения.Удалить("text");
	Разделитель = Символы.ПС;
	для Каждого стр из СтруктураСообщения Цикл 
		Итог = Итог	+ "--" + Boundary+Разделитель;
		Итог = Итог	+ "Content-Disposition: form-data; name="""+стр.Ключ+""""+Разделитель;
		Итог = Итог + Символы.ПС;    
		ЗначениеПараметра =  стр.Значение;	
		
		Если ТипЗнч(ЗначениеПараметра) = Тип("Структура") Тогда
			ЗначениеПараметра =  ПолучитьСтрокуJSON(ЗначениеПараметра);
		КонецЕсли;
		Итог = Итог	+ ЗначениеПараметра+Разделитель;
	КонецЦикла;
	
	ИмяОтправляемогоФайла = ЗаголовокФайла+Файл.Расширение;
	Итог = Итог+"--" + Boundary+Разделитель;
	Итог = Итог+"Content-Disposition: form-data; name=""" + ТипДокумента + """; filename="""+ИмяОтправляемогоФайла+""" "+Разделитель;
	Итог = Итог+"Content-Type: text/plain"+Разделитель;
	
	ИмяФайлаНачала 		= ПолучитьИмяВременногоФайла("txt");
	ИмяИтоговогоФайла	= ПолучитьИмяВременногоФайла("txt");
	ИмяФайлаОкончания 	= ПолучитьИмяВременногоФайла("txt");
	
	ЗаписьТекста = Новый ЗаписьТекста(ИмяФайлаНачала,КодировкаТекста.ANSI);
	ЗаписьТекста.Закрыть();
	ЗаписьТекста = Новый ЗаписьТекста(ИмяФайлаНачала, КодировкаТекста.UTF8);   
	ЗаписьТекста.ЗаписатьСтроку(Итог);
	ЗаписьТекста.Закрыть();
	
	МассивФайловОбъединения = Новый Массив;
	МассивФайловОбъединения.Добавить(ИмяФайлаНачала);
	МассивФайловОбъединения.Добавить(ПутьКФайлу);
	
	Итог = Разделитель+"--" + Boundary + "--";
	
	ЗаписьТекста = Новый ЗаписьТекста(ИмяФайлаОкончания,КодировкаТекста.ANSI);
	ЗаписьТекста.Закрыть();
	ЗаписьТекста = Новый ЗаписьТекста(ИмяФайлаОкончания,КодировкаТекста.UTF8);
	ЗаписьТекста.ЗаписатьСтроку(Итог);
	ЗаписьТекста.Закрыть();
	
	МассивФайловОбъединения.Добавить(ИмяФайлаОкончания);
	
	ОбъединитьФайлы(МассивФайловОбъединения,ИмяИтоговогоФайла);
	
	УдалитьФайлы(ИмяФайлаНачала);    
	УдалитьФайлы(ИмяФайлаОкончания);    
	
	Возврат ИмяИтоговогоФайла;
	
КонецФункции

