// ПРОЦЕДУРЫ И ФУНКЦИИ ИМПОРТА

// Подключается к сайту и получает Cookie.
// Параметры:
//  HTTPСоединение - COMОбъект
//  АдресСайта - Строка - адрес сайта
//  Логин - Строка - логин доступа к админской части сайта
//  Пароль - Строка - пароль доступа к админской части сайта
//
// Возвращаемое значение:
//  Структура
//
Функция УстановитьСоединениеССайтом(мHTTPСоединение, АдресСайта, Логин, Пароль, СведенияОбОшибке = "",ВидШаблона)
	
	// Формируем файл, необходимый для подключения.
	ИмяФайла = ПолучитьИмяВременногоФайла();
   	ФайлОтправки = Новый ЗаписьТекста(ИмяФайла, КодировкаТекста.ANSI);
	ФайлОтправки.Записать(Логин + ":" + Пароль);
	ФайлОтправки.Закрыть();
	Двоичные = Новый ДвоичныеДанные(ИмяФайла);
	СтрокаBase64 = Base64Строка(Двоичные);
	
	// Отправляем запрос на получение Cookie.
	Попытка

	Если ВидШаблона = Перечисления.ВариантыСайта.ВДГБ Тогда
		мHTTPСоединение.open ("GET", "http://" + UrlEncode(АдресСайта) + "/bitrix/admin/tszh_exchange.php?mode=checkauth", Ложь, Логин, Пароль);
	ИНаче
		мHTTPСоединение.open ("GET", "http://" + UrlEncode(АдресСайта) + "/connect/housing_exchange.php?mode=checkauth", Ложь, Логин, Пароль);
	КонецЕсли;
		мHTTPСоединение.setRequestHeader("Authorization", "Basic " + СтрокаBase64);
		мHTTPСоединение.setRequestHeader("Host", АдресСайта);
	    мHTTPСоединение.setRequestHeader("User-Agent", "Mozilla/5.0");
		мHTTPСоединение.send();
		Ответ = мHTTPСоединение.responseText;
	Исключение
		СведенияОбОшибке = НСтр("ru='Неудачная авторизация: ошибка при получении ответа от сайта';uk='Невдала авторизація: помилка при отриманні відповіді від сайту'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СведенияОбОшибке);
		Возврат Неопределено;
	КонецПопытки;
	
	// При удачной авторизации получим ответ "success".
	Если НЕ Лев(Ответ, 7) = "success" Тогда
		СведенияОбОшибке = НСтр("ru='Неудачная авторизация: ошибка при получении ответа от сайта';uk='Невдала авторизація: помилка при отриманні відповіді від сайту'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СведенияОбОшибке);
		Возврат Неопределено;
	КонецЕсли;
	
	Ответ = Прав(Ответ, СтрДлина(Ответ) - 8);
	ПозПС = Найти(Ответ, Символы.ПС);
	Если ПозПС = 0 Тогда
		
		Если ВидШаблона = Перечисления.ВариантыСайта.ВДГБ Тогда
			СведенияОбОшибке = НСтр("ru='Неудачная авторизация: ошибка при получении ответа от сайта';uk='Невдала авторизація: помилка при отриманні відповіді від сайту'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СведенияОбОшибке);
			Возврат Неопределено;
		Иначе
			Куки = Новый Структура("Имя", Ответ);
			Куки.Вставить("Cookie",Ответ);
			Возврат Куки;
		КонецЕсли;
	КонецЕсли;
	
	Куки = Новый Структура("Имя", Лев(Ответ, ПозПС - 1));
	Ответ = Прав(Ответ, СтрДлина(Ответ) - ПозПС);
	Куки.Вставить("Cookie", Лев(Ответ, СтрДлина(Ответ) - 1));
	
	Возврат Куки;
	
КонецФункции // УстановитьСоединениеССайтом()

// Проверяет подключение к сайту по переданным параметрам доступа.
//
// Параметры:
//  АдресСайта - Строка - адрес сайта
//  Логин - Строка - логин доступа к админской части сайта
//  Пароль - Строка - пароль доступа к админской части сайта
//
// Возвращаемое значение:
//  Булево
//
Функция ПроверитьПодключениеКСайту(АдресСайта, Логин, Пароль, СведенияОбОшибке = "",ВидШаблона) Экспорт
	
	Попытка
		мHTTPСоединение = Новый COMОбъект("MSXML2.XMLHTTP");
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Не зарегистрирован объект MSXML2.XMLHTTP"));
		Возврат Ложь;
	КонецПопытки;
	
	Возврат ?(УстановитьСоединениеССайтом(мHTTPСоединение, АдресСайта, Логин, Пароль,,ВидШаблона) = Неопределено, Ложь, Истина);
	
КонецФункции // ПроверитьПодключениеКСайту()

// Получает максимально объем данных, который можно передать на сайт за 1 раз.
//
// Параметры:
//  HTTPСоединение - COMОбъект
//  АдресСайта - Строка - адрес сайта
//  Логин - Строка - логин доступа к админской части сайта
//  Пароль - Строка - пароль доступа к админской части сайта
//  Куки - Структура - Cookie сайта
//
// Возвращаемое значение:
//  Число
//
Функция ПолучитьРазрешенныйРазмерФайлаОбмена(мHTTPСоединение, АдресСайта, Логин, Пароль, Куки, СведенияОбОшибке,ВидШаблона = Неопределено)
	
	Попытка
		Если ВидШаблона = Перечисления.ВариантыСайта.ВДГБ Тогда
			мHTTPСоединение.open ("GET", "http://" +UrlEncode(АдресСайта) + "/bitrix/admin/tszh_exchange.php?mode=init", Ложь, Логин, Пароль);
		Иначе	
			мHTTPСоединение.open ("GET", "http://" +UrlEncode(АдресСайта) + "/connect/housing_exchange.php?mode=init", Ложь, Логин, Пароль);
		КонецЕсли;
		мHTTPСоединение.setRequestHeader ("Host",       АдресСайта);
		мHTTPСоединение.setRequestHeader ("User-Agent", "Mozilla/5.0");
		мHTTPСоединение.setRequestHeader ("Cookie",     Куки.Имя + "=" + Куки.Cookie);
		мHTTPСоединение.send();
		Ответ = мHTTPСоединение.responseText;
	Исключение
		СведенияОбОшибке = НСтр("ru='Не удалось получить параметры загрузки данных на сайт.';uk='Не вдалося отримати параметри завантаження даних на сайт.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СведенияОбОшибке);
		Возврат 0;
	КонецПопытки;
	
	Если Лев(Ответ, 11) <> "file_limit=" Тогда
		СведенияОбОшибке = НСтр("ru='Не удалось получить параметры загрузки данных на сайт.';uk='Не вдалося отримати параметри завантаження даних на сайт.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СведенияОбОшибке);
		Возврат 0;
	КонецЕсли;
	
	Ответ = Сред(Ответ, 12, СтрДлина(Ответ) - 11);
	Попытка
		Возврат Число(Ответ);
	Исключение
		СведенияОбОшибке = НСтр("ru='Не удалось получить параметры загрузки данных на сайт.';uk='Не вдалося отримати параметри завантаження даних на сайт.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СведенияОбОшибке);
		Возврат 0;
	КонецПопытки;
	
КонецФункции // ПолучитьРазрешенныйРазмерФайлаОбмена()

// Выгружает файл с сайта.
//
// Параметры:
//  ТипДанных - Строка - идентификатор загружаемых данных
//  АдресСайта - Строка - адрес сайта
//  Логин - Строка - логин доступа к админской части сайта
//  Пароль - Строка - пароль доступа к админской части сайта
//  ИННОрганизации - Строка - ИНН организации, на сайт которой передаем файл
//
// Возвращаемое значение:
//  Строка, Неопределено
//
Функция ЗагрузитьДанныеССайта(ТипДанных, АдресСайта, Логин, Пароль, ИННОрганизации, СведенияОбОшибке = "", ДопПараметры = Неопределено, ВидШаблона = Неопределено)
	
	Попытка
		мHTTPСоединение = Новый COMОбъект("MSXML2.XMLHTTP");
	Исключение
		СведенияОбОшибке = НСтр("ru='Не зарегистрирован объект MSXML2.XMLHTTP';uk=""Не зареєстрований об'єкт MSXML2.XMLHTTP""");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СведенияОбОшибке);
		
		Возврат Неопределено;
	КонецПопытки;
	
	Куки = УстановитьСоединениеССайтом(мHTTPСоединение, АдресСайта, Логин, Пароль, СведенияОбОшибке,ВидШаблона);
	
	Если Куки = Неопределено Тогда
		СведенияОбОшибке = НСтр("ru='Неудачное соединение с сервером ЖКХ.';uk=""Невдале з'єднання з сервером ЖКГ.""");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СведенияОбОшибке);
		
		Возврат Неопределено;
	КонецЕсли;
	
	Ответ = ПолучитьФайлССайта(мHTTPСоединение, ТипДанных, Куки, АдресСайта, Логин, Пароль, ИННОрганизации, СведенияОбОшибке, ДопПараметры, ВидШаблона);
	
	Если Ответ = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат СформироватьТекстовыйФайл(Ответ);
	
КонецФункции // ЗагрузитьДанныеССайта()

// Отправляет на сайт запрос на получение файла.
//
// Параметры:
//  HTTPСоединение - COMОбъект
//  ТипДанных - Строка - идентификатор передаваемых данных
//  Куки - Структура - Cookie сайта
//  АдресСайта - Строка - адрес сайта
//  Логин - Строка - логин доступа к админской части сайта
//  Пароль - Строка - пароль доступа к админской части сайта
//  ИННОрганизации - Строка - ИНН организации, на сайт которой передаем файл
//  СведенияОбОшибке - Строка - строка, содержащаясведения об ошибке
//  ДопПараметры - структура с параметрами для запроса на загрузку реестра платажей
//
// Возвращаемое значение:
//  Строка, Неопределено
//
Функция ПолучитьФайлССайта(мHTTPСоединение, ТипДанных, Куки, АдресСайта, Логин, Пароль, ИННОрганизации, СведенияОбОшибке, ДопПараметры,ВидШаблона)
	
	Если ТипДанных = "meters" ИЛИ ТипДанных = "accexistence" Тогда
		Если ВидШаблона = Перечисления.ВариантыСайта.ВДГБ Тогда
			ТекстЗапроса = "http://" + UrlEncode(АдресСайта) + "/bitrix/admin/tszh_exchange.php?mode=export&type=" +
			UrlEncode(ТипДанных) + "&inn=" + UrlEncode(ИННОрганизации);
		Иначе
			ТекстЗапроса = "http://" + UrlEncode(АдресСайта) + "/connect/housing_exchange.php?mode=export&type=" +
			UrlEncode(ТипДанных) + "&inn=" + UrlEncode(ИННОрганизации);
		КонецЕсли;
		
	ИначеЕсли ТипДанных = "monetapayments" Тогда
		Если НЕ ДопПараметры.Свойство("НачальнаяДата") ИЛИ НЕ ДопПараметры.Свойство("КонечнаяДата") Тогда
			СведенияОбОшибке = НСтр("ru='Не заданы параметры обмена.';uk='Не задані параметри обміну.'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СведенияОбОшибке);
			
			Возврат Неопределено;
		КонецЕсли;
		
		Если ВидШаблона = Перечисления.ВариантыСайта.ВДГБ Тогда
			ТекстЗапроса = "http://" + UrlEncode(АдресСайта) + "/bitrix/admin/tszh_exchange.php?mode=export&type=" +UrlEncode(ТипДанных) + "&inn=" + UrlEncode(ИННОрганизации) + "&datebeg=" + UrlEncode(ДопПараметры.НачальнаяДата) + 
			"&dateend=" + UrlEncode(ДопПараметры.КонечнаяДата)
		Иначе
			ТекстЗапроса = "http://" + UrlEncode(АдресСайта) + "/connect/housing_exchange.php?mode=export&type=" +
			UrlEncode(ТипДанных) + "&inn=" + UrlEncode(ИННОрганизации) + "&datebeg=" + UrlEncode(ДопПараметры.НачальнаяДата) + 
			"&dateend=" + UrlEncode(ДопПараметры.КонечнаяДата);
		КонецЕсли;
		
	Иначе
		СведенияОбОшибке = НСтр("ru='Ошибка получения файла с сайта: неизвестный формат обмена.';uk='Помилка отримання файла з сайту: невідомий формат обміну.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СведенияОбОшибке);
		
		Возврат Неопределено;
	КонецЕсли;
	
	мHTTPСоединение.open("GET", ТекстЗапроса, Ложь, Логин, Пароль);
	мHTTPСоединение.setRequestHeader("Host",       АдресСайта);
	мHTTPСоединение.setRequestHeader("User-Agent", "Mozilla/5.0");
	мHTTPСоединение.setRequestHeader("Cookie",     Куки.Имя + "=" + Куки.Cookie);
	мHTTPСоединение.send();
	
	Ответ = мHTTPСоединение.responseText;
	
	Если ЛЕВ(Ответ, 7) = "failure" Тогда
		Ответ = СтрЗаменить(Ответ,"failure", НСтр("ru='Ошибка.';uk='Помилка.'"));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Ответ);
		Возврат Неопределено;
	Иначе
		Возврат Ответ;
	КонецЕсли;
	
КонецФункции // ПолучитьФайлССайта()

