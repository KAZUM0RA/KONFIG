// ПРОЦЕДУРЫ И ФУНКЦИИ ЭКСПОРТА

// Отправляет на сайт запрос на передачу файла.
//
// Параметры:
//  HTTPСоединение - COMОбъект
//  ТипДанных - Строка - идентификатор передаваемых данных
//  АдресСайта - Строка - адрес сайта
//  Логин - Строка - логин доступа к админской части сайта
//  Пароль - Строка - пароль доступа к админской части сайта
//  ФайлВыгрузки - Строка - полный путь к файлу выгрузки
//  РазрешенныйРазмер - Число - максимальный возможный объем данных, который можно передать за 1 раз
//  Куки - Структура - Cookie сайта
//  ТипДанных - Строка - идентификатор передаваемых данных
//  ИННОрганизации - Строка - ИНН организации, на сайт которой передаем файл
//  СведенияОбОшибке - Строка - сведения об ошибке
//
// Возвращаемое значение:
//  Строка, Неопределено
//
Функция ПередатьФайлНаСайт(мHTTPСоединение, АдресСайта, Логин, Пароль, ФайлВыгрузки, РазрешенныйРазмер, 
						   Куки, ТипДанных, ИННОрганизации, СведенияОбОшибке = "", ВидШаблона)
	
	РазмерПереданныхДанных = 0;
	
	ПередаваемыйФайл = Новый Файл(ФайлВыгрузки);
	ИмяФайла         = ПередаваемыйФайл.Имя;
	ТекстФайла       = Новый ЧтениеТекста(ФайлВыгрузки);
	СтрокаПередачи   = ТекстФайла.Прочитать() + Символы.ПС;
	ТекстФайла.Закрыть();
	
	РазмерФайла   = СтрДлина(СтрокаПередачи);
	ТекущийРазмер = ?(РазмерФайла <= РазрешенныйРазмер, РазмерФайла, РазрешенныйРазмер);
	
	// Т.к. на сайте имеется ограничение на объем передаваемых данных, передаем файл частями.
	Пока РазмерПереданныхДанных < РазмерФайла Цикл
		СтрокаТекста = Лев(СтрокаПередачи, ТекущийРазмер);
		Попытка
			Если ВидШаблона = Перечисления.ВариантыСайта.ВДГБ Тогда
				мHTTPСоединение.open("POST", "http://" + UrlEncode(АдресСайта) + "/bitrix/admin/tszh_exchange.php?mode=file&type=" +
				UrlEncode(ТипДанных) + "&filename=" + UrlEncode(ИмяФайла), Ложь, Логин, Пароль);
			Иначе
				
				
				
				Если Найти(СтрокаПередачи, "calculations") <> 0 Тогда
					
					мHTTPСоединение.open("POST", "http://" + UrlEncode(АдресСайта) + "/connect/housing_exchange.php?mode=file&type=" +
					UrlEncode(ТипДанных) + "&filename=" + UrlEncode(ИмяФайла)+"&reg=calc", Ложь, Логин, Пароль);
				Иначе
					мHTTPСоединение.open("POST", "http://" + UrlEncode(АдресСайта) + "/connect/housing_exchange.php?mode=file&type=" +
					
					UrlEncode(ТипДанных) + "&filename=" + UrlEncode(ИмяФайла), Ложь, Логин, Пароль);
				КонецЕсли;
			КонецЕсли;
			мHTTPСоединение.setRequestHeader("Host",           АдресСайта);
			мHTTPСоединение.setRequestHeader("User-Agent",     "Mozilla/5.0");
			мHTTPСоединение.setRequestHeader("Cookie",         Куки.Имя + "=" + Куки.Cookie);
			мHTTPСоединение.setRequestHeader("Content-Type",   "text/plain");
			мHTTPСоединение.setRequestHeader("Content-Length", XMLСтрока(СтрДлина(СтрокаТекста)));
			мHTTPСоединение.send(СтрокаТекста);
		
			Ответ = мHTTPСоединение.responseText;
			
			Если Лев(Ответ, 7) = "success" Тогда
				РазмерПереданныхДанных = РазмерПереданныхДанных + ТекущийРазмер;
				СтрокаПередачи         = Сред(СтрокаПередачи, ТекущийРазмер + 1, РазмерФайла - РазмерПереданныхДанных);
				ТекущийРазмер          = РазмерФайла - РазмерПереданныхДанных;
				Если ТекущийРазмер > РазрешенныйРазмер Тогда
					ТекущийРазмер = РазрешенныйРазмер;
				КонецЕсли;
			Иначе
				СведенияОбОшибке = НСтр("ru='Не удалось загрузить файл на сайт: неверные параметры запроса.';uk='Не вдалося завантажити файл на сайт: невірні параметри запиту.'");
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СведенияОбОшибке);
				Возврат Неопределено;
			КонецЕсли;
		Исключение
			СведенияОбОшибке = НСтр("ru='Не удалось загрузить файл на сайт: неверные параметры запроса.';uk='Не вдалося завантажити файл на сайт: невірні параметри запиту.'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СведенияОбОшибке);
			Возврат Неопределено;
		КонецПопытки;
	КонецЦикла;
		
	Если НЕ Лев(Ответ, 7) = "success" Тогда
		СведенияОбОшибке = НСтр("ru='Не удалось загрузить файл на сайт: неверные параметры запроса.';uk='Не вдалося завантажити файл на сайт: невірні параметри запиту.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СведенияОбОшибке);
		Возврат Неопределено;
	Иначе
		Ответ = ЗапросНаЭкспортФайла(мHTTPСоединение, АдресСайта, Логин, Пароль, ТипДанных, ФайлВыгрузки, Куки,
									 ИННОрганизации, СведенияОбОшибке,,ВидШаблона);
		Если НЕ Лев(Ответ, 7) = "success" Тогда
			Возврат Неопределено;
		Иначе
			Сообщить("Данные загружены.");
			Возврат Ответ;
		КонецЕсли;
	КонецЕсли;
	
КонецФункции // ПередатьФайлНаСайт()

// Передает на сайт файл с данными.
//
// Параметры:
//  ФайлВыгрузки - Строка - полный путь к файлу с данными
//  ТипДанных - Строка - идентификатор передаваемых данных
//  АдресСайта - Строка - адрес сайта
//  Логин - Строка - логин доступа к админской части сайта
//  Пароль - Строка - пароль доступа к админской части сайта
//  ИННОрганизации - Строка - ИНН организации, на сайт которой передаем файл
//
// Возвращаемое значение:
//  Строка, Неопределено
//
Функция ПередатьДанныеНаСайт(ФайлВыгрузки, ТипДанных, АдресСайта, Логин, Пароль, ИННОрганизации, СведенияОбОшибке = "", ВидШаблона = Неопределено)
	
	// Устанавливаем соединение.
	Попытка
		мHTTPСоединение = Новый COMОбъект("MSXML2.XMLHTTP");
	Исключение
		СведенияОбОшибке = НСтр("ru='Не зарегистрирован объект MSXML2.XMLHTTP';uk=""Не зареєстрований об'єкт MSXML2.XMLHTTP""");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СведенияОбОшибке);
		Возврат Неопределено;
	КонецПопытки;
	
	// Получаем Cookie сайта.
	Куки = УстановитьСоединениеССайтом(мHTTPСоединение, АдресСайта, Логин, Пароль, СведенияОбОшибке,ВидШаблона);
	
	Если Куки = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// Определяем максимально возмодный объем данных, который можно передать за 1 раз.
	РазрешенныйРазмер = ПолучитьРазрешенныйРазмерФайлаОбмена(мHTTPСоединение, АдресСайта, Логин, Пароль,
															 Куки, СведенияОбОшибке,ВидШаблона);
	
	Если РазрешенныйРазмер = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// Получаем ответ на запрос передачи файла.
	Возврат ПередатьФайлНаСайт(мHTTPСоединение, АдресСайта, Логин, Пароль, ФайлВыгрузки, РазрешенныйРазмер,
							   Куки, ТипДанных, ИННОрганизации, СведенияОбОшибке, ВидШаблона);
	
КонецФункции // ПередатьНаСайтДанныеДляДоступа

// Экспорт файла на сайт.
//
// Параметры:
//  HTTPСоединение - COMОбъект
//  ТипДанных - Строка - идентификатор передаваемых данных
//  АдресСайта - Строка - адрес сайта
//  Логин - Строка - логин доступа к админской части сайта
//  Пароль - Строка - пароль доступа к админской части сайта
//  ФайлВыгрузки - Строка - полный путь к файлу с данными
//  Куки - Структура - Cookie сайта
//  ТипДанных - Строка - идентификатор передаваемых данных
//  ИННОрганизации - Строка - ИНН организации, на сайт которой передаем файл
//  КоличествоПопыток - Число - количество попыток передачи файла
//
// Возвращаемое значение:
//  Строка, Неопределено
//
Функция ЗапросНаЭкспортФайла(мHTTPСоединение, АдресСайта, Логин, Пароль, ТипДанных, ФайлВыгрузки, Куки, 
							 ИННОрганизации, СведенияОбОшибке, КоличествоПопыток = 3000,ВидШаблона) Экспорт
	
	ПередаваемыйФайл = Новый Файл(ФайлВыгрузки);
	ИмяФайла         = ПередаваемыйФайл.Имя;
	
	ном = 1;
	
	Пока ном <= КоличествоПопыток Цикл
		Попытка
			Если ВидШаблона = Перечисления.ВариантыСайта.ВДГБ Тогда
				мHTTPСоединение.open ("GET", "http://" + UrlEncode(АдресСайта) + "/bitrix/admin/tszh_exchange.php?mode=import&type=" +
						UrlEncode(ТипДанных) + "&filename=" + UrlEncode(ИмяФайла) + "&inn=" + UrlEncode(ИННОрганизации), Ложь, Логин, Пароль);
			Иначе
				мHTTPСоединение.open ("GET", "http://" + UrlEncode(АдресСайта) + "/connect/housing_exchange.php?mode=import&type=" +
						UrlEncode(ТипДанных) + "&filename=" + UrlEncode(ИмяФайла) + "&inn=" + UrlEncode(ИННОрганизации), Ложь, Логин, Пароль);
			КонецЕсли;
			мHTTPСоединение.setRequestHeader("Host",       АдресСайта);
			мHTTPСоединение.setRequestHeader("User-Agent", "Mozilla/5.0");
			мHTTPСоединение.setRequestHeader("Cookie",     Куки.Имя + "=" + Куки.Cookie);
			мHTTPСоединение.send();
		
			Ответ = мHTTPСоединение.responseText;
			Если Лев(Ответ, 7) = "success" Тогда
				Возврат Ответ;
				//ном = КоличествоПопыток + 1;
			ИначеЕсли Лев(Ответ, 8) = "progress" Тогда
				ном = ном + 1;
			Иначе
				СведенияОбОшибке = НСтр("ru='Не удалось загрузить файл на сайт: неверные параметры запроса.';uk='Не вдалося завантажити файл на сайт: невірні параметри запиту.'");
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СведенияОбОшибке);
				Возврат Неопределено;
			КонецЕсли;
		Исключение
			СведенияОбОшибке = НСтр("ru='Не удалось загрузить файл на сайт: неверные параметры запроса.';uk='Не вдалося завантажити файл на сайт: невірні параметри запиту.'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СведенияОбОшибке);
			Возврат Неопределено;
		КонецПопытки;
	КонецЦикла;

	Возврат Ответ;
	
КонецФункции // ЗапросНаЭкспортФайла()

