		НаборЗаписей.Отбор.ДатаВыгрузки.Установить(ДатаВыгрузки);
		
		НаборЗаписей.Прочитать();
			
		Если НаборЗаписей.Количество() = 1 Тогда
			НаборЗаписей[0].Выгружено = Истина;	
			НаборЗаписей.Записать();
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры // ОбменДаннымиХвояСайтЖКХ()

