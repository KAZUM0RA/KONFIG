		МассивЛицевыхСчетов.Добавить(ВыборкаРезультат.ЛицевойСчет);
		ДатаВыгрузки = ВыборкаРезультат.ДатаВыгрузки;	
		
		Если НЕ ПериодВыгрузки = ВыборкаРезультат.ПериодВыгрузки Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	ВременныйКаталог = КаталогВременныхФайлов();
	ИмяФайлаДанных = ВременныйКаталог + "import" + КодПоЕДРПОУ + ".txt";
	
