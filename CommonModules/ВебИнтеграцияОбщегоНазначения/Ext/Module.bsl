// ВСПОМОГАТЕЛЬНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

// Возвращает текущую версия механизма интеграции с сайтом.
//
// Параметры:
//  Нет.
//
// Возвращаемое значение:
//  Строка
//
Функция ПолучитьТекущуюВерсиюМеханизмаИнтеграции()
	
	Возврат "3";
	
КонецФункции // ПолучитьТекущуюВерсиюМеханизмаИнтеграции()

// Формирует текстовый файл и записывает в него строковое представление xml-файла.
//
// Параметры:
//  СтроковоеПредставление - Строка - строковое представление xml-файла.
//
// Возвращаемое значение:
//  Строка
//
Функция СформироватьТекстовыйФайл(СтроковоеПредставление)
	
	ИмяФайла = ПолучитьИмяВременногоФайла();
	
	ТекстовыйФайл = Новый ТекстовыйДокумент;
	ТекстовыйФайл.ДобавитьСтроку(СтроковоеПредставление);
	ТекстовыйФайл.Записать(ИмяФайла);
	
	Возврат ИмяФайла;
	
КонецФункции // СформироватьXMLФайл()

/////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ РЕГЛАМЕНТНЫХ ЗАДАНИЙ

// Процедура - обработчик регламентного задания "Обмен данными с сайтом".
//
// Параметры:
//  КодОбмена - СправочникСсылка.ВариантыОбменаДаннымиССайтом - вариант обмена.
//
Процедура ОбменДаннымиССайтом(КодОбмена) Экспорт
	
	Если КодОбмена = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КлючВозврата = Неопределено;
	
	ВариантОбмена = Справочники.ВариантыОбменаДаннымиССайтом.НайтиПоКоду(КодОбмена);
	
	Если ВариантОбмена = Справочники.ВариантыОбменаДаннымиССайтом.ПустаяСсылка() Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	МИНИМУМ(ДатыЗапретаИзменения.ДатаЗапрета) КАК ДатаЗапрета
		|ИЗ
		|	РегистрСведений.ДатыЗапретаИзменения КАК ДатыЗапретаИзменения";
		
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	Если РезультатЗапроса.Следующий() Тогда
		ДатаОбмена = НачалоМесяца(РезультатЗапроса.ДатаЗапрета);
	Иначе
		Возврат;
	КонецЕсли;
	
	ДатаОбмена = НачалоМесяца(РезультатЗапроса.ДатаЗапрета);
	
	Пока ДатаОбмена < ТекущаяДата() Цикл
		
		Если ДатаОбмена = НачалоМесяца(ТекущаяДата()) Тогда
			КлючВозврата = ВыполнитьОбменДаннымиССайтом(ВариантОбмена, , ТекущаяДата());
		Иначе
			КлючВозврата = ВыполнитьОбменДаннымиССайтом(ВариантОбмена, , КонецМесяца(ДатаОбмена));
		КонецЕсли;
		
		ДатаОбмена = ДобавитьМесяц(ДатаОбмена, 1);
		
	КонецЦикла;
	
	//Возврат КлючВозврата;
	
КонецПроцедуры // ОбменДаннымиССайтом()

// Процедура - обработчик регламентного задания "Обмен данными ХВОЯ: Сайт ЖКХ".
//
//
Процедура ОбменДаннымиХвояСайтЖКХ() Экспорт
	
	ТаблицаНастройки = Константы.НастройкаОбменДаннымиХвояСайтЖКХ.Получить().Получить();
	
	Если НЕ ТипЗнч(ТаблицаНастройки) = Тип("ТаблицаЗначений") Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаТаблицаНастройки Из ТаблицаНастройки Цикл
		
		Если НЕ ЗначениеЗаполнено(СтрокаТаблицаНастройки.ФТПСервер) Тогда
			Продолжить;
		КонецЕсли;
		
		СтруктураНастройки = Новый Структура;
		СтруктураНастройки.Вставить("Пароль", СокрЛП(СтрокаТаблицаНастройки.ФТППароль));
		СтруктураНастройки.Вставить("Логин", СокрЛП(СтрокаТаблицаНастройки.ФТПЛогин));
		СтруктураНастройки.Вставить("Сервер", СокрЛП(СтрокаТаблицаНастройки.ФТПСервер));
		СтруктураНастройки.Вставить("УдаленныйКаталог", СокрЛП(СтрокаТаблицаНастройки.ФТПУдаленныйКаталог));
		СтруктураНастройки.Вставить("ПассивныйРежим", СтрокаТаблицаНастройки.ФТППассивныйРежим);
		СтруктураНастройки.Вставить("АдресСайта", СокрЛП(СтрокаТаблицаНастройки.АдресСайта));
		СтруктураНастройки.Вставить("ДатаНачалаВыгрузкиНаСайт", СтрокаТаблицаНастройки.ДатаНачалаВыгрузкиНаСайт);
		СтруктураНастройки.Вставить("Организация", СтрокаТаблицаНастройки.Организация);
		СтруктураНастройки.Вставить("КоличесвоЛицевыхСчетовВПакете", СтрокаТаблицаНастройки.КоличесвоЛицевыхСчетовВПакете);
		
		ПодготовкаВыгрузкиИстории(СтруктураНастройки);
		ОбменДаннымиХвояСайтЖКХ_Версия2(СтруктураНастройки);
		ОтметкаВыгрузкиИстории(СтруктураНастройки);
		
		
	КонецЦикла;
	
КонецПроцедуры // ОбменДаннымиХвояСайтЖКХ()

/////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ ОБМЕНА ДАННЫМИ ХВОЯ:Сайт ЖКХ

// Формирует массив всех л/с , действующих на выбранную дату.
//
Функция ПолучитьМассивЛицевыхСчетов(Организация, ДатаОбмена, МассивЗданий = Неопределено)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ЛицевыеСчетаСрезПоследних.ЛицевойСчет КАК ЛицевойСчет
		|ИЗ
		|	РегистрСведений.ЛицевыеСчета.СрезПоследних(
		|			&ДатаКон,
		|			ЛицевойСчет.Владелец.Организация = &Организация
		|				И ВЫБОР
		|					КОГДА &Все
		|						ТОГДА ИСТИНА
		|					ИНАЧЕ ЛицевойСчет.Владелец В (&МассивЗданий)
		|				КОНЕЦ) КАК ЛицевыеСчетаСрезПоследних
		|ГДЕ
		|	ЛицевыеСчетаСрезПоследних.Действует
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЛицевыеСчетаСрезПоследних.ЛицевойСчет.ОбъектЛицевогоСчета.Код";
		
	Запрос.УстановитьПараметр("ДатаКон",     КонецДня(ДатаОбмена));
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("МассивЗданий", МассивЗданий);
	Если МассивЗданий = Неопределено Тогда
		Запрос.УстановитьПараметр("Все", Истина);
	Иначе
		Запрос.УстановитьПараметр("Все", Ложь);
	КонецЕсли;
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат.ВыгрузитьКолонку("ЛицевойСчет");
	
КонецФункции // ПолучитьМассивЛицевыхСчетов()

Процедура ОбменДаннымиХвояСайтЖКХ_Версия2(СтруктураНастройки)
	
	ДатаВыгрузкиНаСайт = НачалоДня(ТекущаяДата());
	
	КодПоЕДРПОУ = СокрЛП(СтруктураНастройки.Организация.КодПоЕДРПОУ);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	СостоянияОбменовДаннымиХвояСайтЖКХ.ЛицевойСчет
		|ИЗ
		|	РегистрСведений.СостоянияОбменовДаннымиХвояСайтЖКХ КАК СостоянияОбменовДаннымиХвояСайтЖКХ
		|ГДЕ
		|	СостоянияОбменовДаннымиХвояСайтЖКХ.ДатаВыгрузки = &ДатаВыгрузки
		|	И СостоянияОбменовДаннымиХвояСайтЖКХ.Организация = &Организация";
		
	Запрос.УстановитьПараметр("ДатаВыгрузки", ДатаВыгрузкиНаСайт);
	Запрос.УстановитьПараметр("Организация", СтруктураНастройки.Организация);
	
	ЭтоНачалоВыгрузки = Запрос.Выполнить().Пустой();
	ВыгрузкаЗавершена = Истина;
	
	Попытка
		ПодключениеКФТП = Новый FTPСоединение(СтруктураНастройки.Сервер, , СтруктураНастройки.Логин, СтруктураНастройки.Пароль, , СтруктураНастройки.ПассивныйРежим, 0);
	Исключение
		ЗаписьЖурналаРегистрации(НСтр("ru='Обмен данными ХВОЯ:Сайт ЖКХ';uk='Обмін даними ХВОЯ: Сайт ЖКГ'"), УровеньЖурналаРегистрации.Ошибка,,, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;
	
	МассивФайлов = ПодключениеКФТП.НайтиФайлы("/" +СтруктураНастройки.УдаленныйКаталог + "/export" + КодПоЕДРПОУ + ".txt");

	Если МассивФайлов.Количество() > 0 Тогда
		ФайлЛокальныйПриборыУчета = КаталогВременныхФайлов() + "export" + КодПоЕДРПОУ + ".txt";
		Попытка
			ПодключениеКФТП.Получить(МассивФайлов[0].ПолноеИмя, ФайлЛокальныйПриборыУчета);	
			Если ЗагрузитьДанныеПриборовУчета_Версия2(ФайлЛокальныйПриборыУчета) Тогда
				ПодключениеКФТП.Удалить("/" + СтруктураНастройки.УдаленныйКаталог + "/export" + КодПоЕДРПОУ + ".txt");	
			КонецЕсли;
		Исключение
			ЗаписьЖурналаРегистрации(НСтр("ru='Обмен данными ХВОЯ:Сайт ЖКХ';uk='Обмін даними ХВОЯ: Сайт ЖКГ'"), УровеньЖурналаРегистрации.Ошибка,,, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
		
	КонецЕсли;
	
	МассивФайлов = ПодключениеКФТП.НайтиФайлы("/" + СтруктураНастройки.УдаленныйКаталог + "/","import" + КодПоЕДРПОУ + "*.txt");
	
	Если МассивФайлов.Количество() > 0 И НЕ ЭтоНачалоВыгрузки Тогда
		// не успели. Продолжим в следующем цикле
		Возврат;
		
	ИначеЕсли МассивФайлов.Количество() > 0 И ЭтоНачалоВыгрузки Тогда
		
		// не завершена предыдущая загрузка. Сообщить об ошибках
		
		ВыгрузкаЗавершена = Ложь;
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДатыЗапретаИзменения.ДатаЗапрета КАК Период,
		|	ДатыЗапретаИзменения.Объект КАК Здание
		|ИЗ
		|	РегистрСведений.ДатыЗапретаИзменения КАК ДатыЗапретаИзменения
		|ГДЕ
		|	ДатыЗапретаИзменения.Объект.Организация = &Организация
		|	И ДатыЗапретаИзменения.Раздел = &Раздел
		|	И НЕ ДатыЗапретаИзменения.Объект.ПометкаУдаления";
		
	Запрос.УстановитьПараметр("Организация", СтруктураНастройки.Организация);
	Запрос.УстановитьПараметр("Раздел", ПланыВидовХарактеристик.РазделыДатЗапретаИзменения.Здания);
	
	ТаблицаЗдания = Запрос.Выполнить().Выгрузить();
	
	МассивЗданий_1 = ТаблицаЗдания.Скопировать(Новый Структура("Период",НачалоДня(КонецМесяца(ДобавитьМесяц(НачалоМесяца(ДатаВыгрузкиНаСайт), -1))))).ВыгрузитьКолонку("Здание");
	МассивЗданий_2 = ТаблицаЗдания.Скопировать(Новый Структура("Период",НачалоДня(КонецМесяца(ДобавитьМесяц(НачалоМесяца(ДатаВыгрузкиНаСайт), -2))))).ВыгрузитьКолонку("Здание");

	Если МассивЗданий_1.Количество() = 0 И МассивЗданий_2.Количество() = 0 Тогда
		
		ЗаписьЖурналаРегистрации(НСтр("ru='Обмен данными ХВОЯ:Сайт ЖКХ';uk='Обмін даними ХВОЯ: Сайт ЖКГ'"), УровеньЖурналаРегистрации.Предупреждение,,, НСтр("ru='Нет данных для выгрузки.';uk='Немає даних для вивантаження.'"));
		Возврат;
		
	КонецЕсли;
	
	МассивЗданийИстории = Новый Массив;
	Для Каждого ЭлементМассива Из МассивЗданий_1 Цикл
		МассивЗданийИстории.Добавить(ЭлементМассива);	
	КонецЦикла;
	Для Каждого ЭлементМассива Из МассивЗданий_2 Цикл
		МассивЗданийИстории.Добавить(ЭлементМассива);	
	КонецЦикла;
	
	Если ЭтоНачалоВыгрузки И ВыгрузкаЗавершена Тогда
		НаборЗаписей = РегистрыСведений.СостоянияОбменовДаннымиХвояСайтЖКХ.СоздатьНаборЗаписей();	
		НаборЗаписей.Отбор.Организация.Установить(СтруктураНастройки.Организация);
		НаборЗаписей.Записать();
		ТаблицаЛицевыеСчета = НаборЗаписей.Выгрузить(,);
		
		Если НЕ МассивЗданий_2.Количество() = 0 Тогда
			
			МассивПериоды = Новый Массив;
			МассивПериоды.Добавить(ДобавитьМесяц(НачалоМесяца(ДатаВыгрузкиНаСайт), -2));
			МассивПериоды.Добавить(ДобавитьМесяц(НачалоМесяца(ДатаВыгрузкиНаСайт), -1));
			МассивПериоды.Добавить(НачалоМесяца(ДатаВыгрузкиНаСайт));
			
			Для Каждого Период Из МассивПериоды Цикл
				МассивЛС = ПолучитьМассивЛицевыхСчетов(СтруктураНастройки.Организация, КонецМесяца(Период), МассивЗданий_2);
				Для Каждого ЛС Из МассивЛС Цикл
					НоваяСтрока = ТаблицаЛицевыеСчета.Добавить();
				    НоваяСтрока.Организация = СтруктураНастройки.Организация;
				    НоваяСтрока.ЛицевойСчет = ЛС;
				    НоваяСтрока.ПериодВыгрузки = Период;
				    НоваяСтрока.ДатаВыгрузки = ДатаВыгрузкиНаСайт;
				КонецЦикла;
			КонецЦикла;
		КонецЕсли;
		
		Если НЕ МассивЗданий_1.Количество() = 0 Тогда
			МассивПериоды = Новый Массив;
			МассивПериоды.Добавить(ДобавитьМесяц(НачалоМесяца(ДатаВыгрузкиНаСайт), -1));
			МассивПериоды.Добавить(НачалоМесяца(ДатаВыгрузкиНаСайт));
			
			Для Каждого Период Из МассивПериоды Цикл
				МассивЛС = ПолучитьМассивЛицевыхСчетов(СтруктураНастройки.Организация, КонецМесяца(Период), МассивЗданий_1);
				Для Каждого ЛС Из МассивЛС Цикл
					НоваяСтрока = ТаблицаЛицевыеСчета.Добавить();
				    НоваяСтрока.Организация = СтруктураНастройки.Организация;
				    НоваяСтрока.ЛицевойСчет = ЛС;
				    НоваяСтрока.ПериодВыгрузки = Период;
				    НоваяСтрока.ДатаВыгрузки = ДатаВыгрузкиНаСайт;
				КонецЦикла;
			КонецЦикла;
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	СостояниеВыгрузкиИсторииСайтЖКХ.ПериодВыгрузки
			|ИЗ
			|	РегистрСведений.СостояниеВыгрузкиИсторииСайтЖКХ КАК СостояниеВыгрузкиИсторииСайтЖКХ
			|ГДЕ
			|	СостояниеВыгрузкиИсторииСайтЖКХ.Организация = &Организация
			|	И НЕ СостояниеВыгрузкиИсторииСайтЖКХ.Подтверждено";
			
		Запрос.УстановитьПараметр("Организация", СтруктураНастройки.Организация);
		
		Результат = Запрос.Выполнить().Выбрать();
		
		МассивПериоды = Новый Массив;
		
		Пока Результат.Следующий() Цикл
			МассивПериоды.Добавить(Результат.ПериодВыгрузки);
		КонецЦикла;
		
		Для Каждого Период Из МассивПериоды Цикл
			
			НайденныеСтроки = ТаблицаЛицевыеСчета.НайтиСтроки(Новый Структура("ПериодВыгрузки", Период));
			Если НайденныеСтроки.Количество() > 0 Тогда
				Продолжить;
			КонецЕсли;
			
			МассивЛС = ПолучитьМассивЛицевыхСчетов(СтруктураНастройки.Организация, КонецМесяца(Период), МассивЗданийИстории);
			Для Каждого ЛС Из МассивЛС Цикл
				НоваяСтрока = ТаблицаЛицевыеСчета.Добавить();
			    НоваяСтрока.Организация = СтруктураНастройки.Организация;
			    НоваяСтрока.ЛицевойСчет = ЛС;
			    НоваяСтрока.ПериодВыгрузки = Период;
			    НоваяСтрока.ДатаВыгрузки = ДатаВыгрузкиНаСайт;
			КонецЦикла;
		КонецЦикла;
		
		
