	ВыборкаРезультат = Результат.Выбрать();
	МассивЛицевыхСчетов = Новый Массив;
	ПериодВыгрузки = '00010101';
	ДатаВыгрузки = '00010101';
	
	Пока ВыборкаРезультат.Следующий() Цикл
		Если НЕ ЗначениеЗаполнено(ПериодВыгрузки) Тогда
			ПериодВыгрузки = ВыборкаРезультат.ПериодВыгрузки;	
