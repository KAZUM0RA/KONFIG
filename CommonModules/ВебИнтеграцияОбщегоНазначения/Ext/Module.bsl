		НаборЗаписей.Отбор.ПериодВыгрузки.Установить(Результат.ПериодВыгрузки);
		НаборЗаписей.Отбор.ДатаВыгрузки.Установить(Результат.ДатаВыгрузки);
		
		НаборЗаписей.Прочитать();
			
		Если НаборЗаписей.Количество() = 1 Тогда
			НаборЗаписей[0].Подтверждено = Истина;	
			НаборЗаписей.Записать();
		КонецЕсли;
		
