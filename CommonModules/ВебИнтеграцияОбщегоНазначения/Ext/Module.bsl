Функция ПолучитьПоказанияСчетчиков(ДатаЗакрытияПериода, ПриборУчета)

	Запрос = Новый Запрос;
	Запрос.Текст = 
	 "ВЫБРАТЬ
	 |	ПоказанияПриборовУчетаСрезПоследних.ВидТарифа,
	 |	ПоказанияПриборовУчетаСрезПоследних.Значение КАК ПредыдущиеПоказания,
	 |	ПоказанияПриборовУчетаСрезПоследних.ПриборУчета,
	 |	НЕОПРЕДЕЛЕНО КАК ТаблицаИстории,
	 |	""                               "" КАК ЗаводскойНомер,
	 |	""                                                                  "" КАК id,
	 |	0 КАК ТекущиеПоказания
	 |ИЗ
	 |	РегистрСведений.ПоказанияПриборовУчета.СрезПоследних(&ДатаЗакрытияПериода, ПриборУчета = &ПриборУчета) КАК ПоказанияПриборовУчетаСрезПоследних
	 |;
	 |
	 |////////////////////////////////////////////////////////////////////////////////
	 |ВЫБРАТЬ
	 |	ВложенныйЗапрос.Период КАК Период,
	 |	ВложенныйЗапрос.ПриборУчета,
	 |	ВложенныйЗапрос.ВидТарифа,
	 |	ВложенныйЗапрос.Значение,
	 |	ВложенныйЗапрос.ИсточникПоказаний
	 |ИЗ
	 |	(ВЫБРАТЬ
	 |		ПоказанияПриборовУчетаССайта.Период КАК Период,
	 |		ПоказанияПриборовУчетаССайта.ПриборУчета КАК ПриборУчета,
	 |		ПоказанияПриборовУчетаССайта.ВидТарифа КАК ВидТарифа,
	 |		ПоказанияПриборовУчетаССайта.Значение КАК Значение,
	 |		""сайт"" КАК ИсточникПоказаний
	 |	ИЗ
	 |		РегистрСведений.ПоказанияПриборовУчетаССайта КАК ПоказанияПриборовУчетаССайта
	 |	ГДЕ
	 |		ПоказанияПриборовУчетаССайта.Период > &ДатаЗакрытияПериода
	 |		И ПоказанияПриборовУчетаССайта.ПриборУчета = &ПриборУчета
	 |	
	 |	ОБЪЕДИНИТЬ ВСЕ
	 |	
	 |	ВЫБРАТЬ
	 |		СнятыеПоказанияПриборовУчета.Период,
	 |		СнятыеПоказанияПриборовУчета.ПриборУчета,
	 |		ЗНАЧЕНИЕ(Перечисление.ВидыТарифов.Общий),
	 |		СнятыеПоказанияПриборовУчета.Значение,
	 |		""мобильный_контролер""
	 |	ИЗ
	 |		РегистрСведений.СнятыеПоказанияПриборовУчета КАК СнятыеПоказанияПриборовУчета
	 |	ГДЕ
	 |		СнятыеПоказанияПриборовУчета.Период > &ДатаЗакрытияПериода
	 |		И СнятыеПоказанияПриборовУчета.ПриборУчета = &ПриборУчета
	 |	
	 |	ОБЪЕДИНИТЬ ВСЕ
	 |	
	 |	ВЫБРАТЬ
	 |		ПоказанияПриборовУчетаИзТелеграмм.Период,
	 |		ПоказанияПриборовУчетаИзТелеграмм.ПриборУчета,
	 |		ПоказанияПриборовУчетаИзТелеграмм.ВидТарифа,
	 |		ПоказанияПриборовУчетаИзТелеграмм.Значение,
	 |		""телеграмм""
	 |	ИЗ
	 |		РегистрСведений.ПоказанияПриборовУчетаИзТелеграмм КАК ПоказанияПриборовУчетаИзТелеграмм
	 |	ГДЕ
	 |		ПоказанияПриборовУчетаИзТелеграмм.Период > &ДатаЗакрытияПериода
	 |		И ПоказанияПриборовУчетаИзТелеграмм.ПриборУчета = &ПриборУчета
	 |	
	 |	ОБЪЕДИНИТЬ ВСЕ
	 |	
	 |	ВЫБРАТЬ
	 |		ПоказанияПУИзВнешнихИсточников.Период,
	 |		ПоказанияПУИзВнешнихИсточников.ПриборУчета,
	 |		ПоказанияПУИзВнешнихИсточников.ВидТарифа,
	 |		ПоказанияПУИзВнешнихИсточников.Значение,
	 |		""контролер""
	 |	ИЗ
	 |		РегистрСведений.ПоказанияПУИзВнешнихИсточников КАК ПоказанияПУИзВнешнихИсточников
	 |	ГДЕ
	 |		ПоказанияПУИзВнешнихИсточников.Период > &ДатаЗакрытияПериода
	 |		И ПоказанияПУИзВнешнихИсточников.ПриборУчета = &ПриборУчета) КАК ВложенныйЗапрос
	 |
	 |УПОРЯДОЧИТЬ ПО
	 |	Период";
	
	
	Запрос.УстановитьПараметр("ДатаЗакрытияПериода", ДатаЗакрытияПериода);
	Запрос.УстановитьПараметр("ПриборУчета", ПриборУчета);
	
	Результат = Запрос.ВыполнитьПакет();
	
	
	ТаблицаПоказаний = Результат[0].Выгрузить();
	ТаблицаИстории = Результат[1].Выгрузить();
	
	Для Каждого СтрокаТаблицаПоказаний Из ТаблицаПоказаний Цикл
		
		ТаблицаИсторииОтбор = ТаблицаИстории.Скопировать(Новый Структура("ПриборУчета, ВидТарифа", СтрокаТаблицаПоказаний.ПриборУчета, СтрокаТаблицаПоказаний.ВидТарифа),);	
		СтрокаТаблицаПоказаний.ТаблицаИстории = ТаблицаИсторииОтбор;
		Если ТаблицаИсторииОтбор.Количество() = 0 Тогда
			СтрокаТаблицаПоказаний.ТекущиеПоказания = СтрокаТаблицаПоказаний.ПредыдущиеПоказания; 
		Иначе
			СтрокаТаблицаПоказаний.ТекущиеПоказания = ТаблицаИсторииОтбор[ТаблицаИсторииОтбор.Количество() - 1].Значение; 
		КонецЕсли;
		
		Если СтрокаТаблицаПоказаний.ВидТарифа = Перечисления.ВидыТарифов.Общий Тогда
			СтрокаТаблицаПоказаний.id = СокрЛП(XMLСтрока(СтрокаТаблицаПоказаний.ПриборУчета));
			СтрокаТаблицаПоказаний.ЗаводскойНомер = СокрЛП(СтрокаТаблицаПоказаний.ПриборУчета.ЗаводскойНомер); 
		Иначе
			СтрокаТаблицаПоказаний.id = СокрЛП(XMLСтрока(СтрокаТаблицаПоказаний.ПриборУчета) + Перечисления.ВидыТарифов.Индекс(СтрокаТаблицаПоказаний.ВидТарифа));
			СтрокаТаблицаПоказаний.ЗаводскойНомер = СокрЛП(СтрокаТаблицаПоказаний.ПриборУчета.ЗаводскойНомер + "_" + Строка(СтрокаТаблицаПоказаний.ВидТарифа)); 
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТаблицаПоказаний;
	
КонецФункции

Функция ПолучитьДатуЗакрытияПериода(ЛицевойСчет)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДатыЗапретаИзменения.ДатаЗапрета
		|ИЗ
		|	РегистрСведений.ДатыЗапретаИзменения КАК ДатыЗапретаИзменения
		|ГДЕ
		|	ДатыЗапретаИзменения.Объект = &Здание
		|	И ДатыЗапретаИзменения.Раздел = &Раздел";
		
	Запрос.УстановитьПараметр("Здание", ЛицевойСчет.Владелец);
	Запрос.УстановитьПараметр("Раздел", ПланыВидовХарактеристик.РазделыДатЗапретаИзменения.Здания);
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Следующий() Тогда
		Возврат РезультатЗапроса.ДатаЗапрета;
	Иначе
		Возврат ЛицевойСчет.Владелец.ДатаНачалаУчета;
	КонецЕсли;
	
КонецФункции

Функция НайтиЗначениеАдреса(Адрес, Значение)
	
	ЗначениеАдреса = "";
	Для Счет = 1 По СтрЧислоСтрок(Адрес) Цикл
		Строка = СтрПолучитьСтроку(Адрес, Счет);
		Если СтрЧислоВхождений(Строка, Значение)>0 Тогда
			Позиция = Найти(Строка, "=");
			ЗначениеАдреса = Прав(Строка,СтрДлина(Строка)-Позиция);
		КонецЕсли;
	КонецЦикла;
	
	Возврат ЗначениеАдреса;
	
КонецФункции 

Функция ЗагрузитьДанныеПриборовУчета_Версия2(ФайлПриборовУчета)
	
	ИмяСвойства = "";
	ТаблицаПриборыУчета = Новый ТаблицаЗначений;
	ТаблицаПриборыУчета.Колонки.Добавить("Дата");
	ТаблицаПриборыУчета.Колонки.Добавить("ЛицевойСчет");
	ТаблицаПриборыУчета.Колонки.Добавить("Услуга");
	ТаблицаПриборыУчета.Колонки.Добавить("ПриборУчета");
	ТаблицаПриборыУчета.Колонки.Добавить("ВидТарифа");
	ТаблицаПриборыУчета.Колонки.Добавить("Показание");
	ТаблицаПриборыУчета.Колонки.Добавить("ПоказаниеПредыдущее");
	
	Попытка
	
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.ОткрытьФайл(ФайлПриборовУчета);
	
	Пока ЧтениеJSON.Прочитать() Цикл
		ТипJSON = ЧтениеJSON.ТипТекущегоЗначения;
		Если ТипJSON = ТипЗначенияJSON.Число Или ТипJSON = ТипЗначенияJSON.Строка
			Или ТипJSON = ТипЗначенияJSON.Булево ИЛИ ТипJSON = ТипЗначенияJSON.Null Тогда
			
			Если ИмяСвойства = "date" Тогда
				Значение = ЧтениеJSON.ТекущееЗначение;
				НоваяСтрока = ТаблицаПриборыУчета.Добавить();
				НоваяСтрока.Дата = Дата(СокрЛП(Значение) + " 00:00:00");
			ИначеЕсли ИмяСвойства = "PersAcc_id" Тогда
				Значение = ЧтениеJSON.ТекущееЗначение;
				НоваяСтрока.ЛицевойСчет = Справочники.ЛицевыеСчета.ПолучитьСсылку(Новый УникальныйИдентификатор(Значение));
				
			ИначеЕсли ИмяСвойства = "id" Тогда
				Значение = ЧтениеJSON.ТекущееЗначение;
				Если СтрДлина(СокрЛП(Значение)) = 36 Тогда
					НоваяСтрока.ПриборУчета = Справочники.ПриборыУчета.ПолучитьСсылку(Новый УникальныйИдентификатор(Значение));
					НоваяСтрока.ВидТарифа = Перечисления.ВидыТарифов.Общий;
				Иначе
					
					idПрибораУчета = Сред(Значение, 1, 36);
					НоваяСтрока.ПриборУчета = Справочники.ПриборыУчета.ПолучитьСсылку(Новый УникальныйИдентификатор(idПрибораУчета));
					Попытка
						idВидаТарифа =  Число(Сред(Значение, 37, 1));
						НоваяСтрока.ВидТарифа = Перечисления.ВидыТарифов[idВидаТарифа];
					Исключение
						НоваяСтрока.ВидТарифа = Перечисления.ВидыТарифов.Общий;	
					КонецПопытки;
					
				КонецЕсли;
				
			ИначеЕсли ИмяСвойства = "item_id" Тогда
				Значение = ЧтениеJSON.ТекущееЗначение;
				НоваяСтрока.Услуга = Справочники.Услуги.ПолучитьСсылку(Новый УникальныйИдентификатор(Значение));
				
			ИначеЕсли ИмяСвойства = "indicbef1" Тогда
				Значение = ЧтениеJSON.ТекущееЗначение;
				НоваяСтрока.ПоказаниеПредыдущее = Число(СтрЗаменить(Значение,",","."));
			ИначеЕсли ИмяСвойства = "indiccur1" Тогда
				Значение = ЧтениеJSON.ТекущееЗначение;
				НоваяСтрока.Показание = Число(СтрЗаменить(Значение,",","."));
			Иначе
				Значение = ЧтениеJSON.ТекущееЗначение;
			КонецЕсли;
			
		ИначеЕсли ТипJSON = ТипЗначенияJSON.Комментарий Тогда
			
			Комментарий = ЧтениеJSON.ТекущееЗначение;
			
		ИначеЕсли ТипJSON = ТипЗначенияJSON.ИмяСвойства Тогда
			
			ИмяСвойства = ЧтениеJSON.ТекущееЗначение;
			
		ИначеЕсли ТипJSON = ТипЗначенияJSON.НачалоОбъекта Или ТипJSON = ТипЗначенияJSON.КонецОбъекта
			Или ТипJSON = ТипЗначенияJSON.НачалоМассива ИЛИ ТипJSON = ТипЗначенияJSON.КонецМассива ИЛИ ТипJSON = ТипЗначенияJSON.Ничего Тогда
			
		
		КонецЕсли;
	КонецЦикла;
	
	ЧтениеJSON.Закрыть();
	
	Исключение
		ЗаписьЖурналаРегистрации(НСтр("ru='Обмен данными ХВОЯ:Сайт ЖКХ';uk='Обмін даними ХВОЯ: Сайт ЖКГ'"), УровеньЖурналаРегистрации.Ошибка,,, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Ложь;
	
	КонецПопытки;
	
	НаборССайта = РегистрыСведений.ПоказанияПриборовУчетаССайта.СоздатьНаборЗаписей();
	
	Для Каждого СтрокаПриборыУчета Из ТаблицаПриборыУчета Цикл
		
		НаборССайта.Отбор.ПриборУчета.Установить(СтрокаПриборыУчета.ПриборУчета);
		НаборССайта.Отбор.ЛицевойСчет.Установить(СтрокаПриборыУчета.ЛицевойСчет);
		НаборССайта.Отбор.Период.Установить(СтрокаПриборыУчета.Дата);
		
		НаборССайта.Прочитать();
			
		Если НаборССайта.Количество() > 0 Тогда
			НоваяСтрока = НаборССайта[0];
		Иначе
			НоваяСтрока = НаборССайта.Добавить();
		КонецЕсли;
		
		НоваяСтрока.ЛицевойСчет = СтрокаПриборыУчета.ЛицевойСчет;
		НоваяСтрока.ПриборУчета = СтрокаПриборыУчета.ПриборУчета;
		НоваяСтрока.ВидТарифа = СтрокаПриборыУчета.ВидТарифа;
		НоваяСтрока.Значение = СтрокаПриборыУчета.Показание;
		НоваяСтрока.Период = СтрокаПриборыУчета.Дата;
							
		НаборССайта.Записать();
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Процедура ПодготовкаВыгрузкиИстории(СтруктураНастройки)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	СостояниеВыгрузкиИсторииСайтЖКХ.ПериодВыгрузки
		|ИЗ
		|	РегистрСведений.СостояниеВыгрузкиИсторииСайтЖКХ КАК СостояниеВыгрузкиИсторииСайтЖКХ
		|ГДЕ
		|	СостояниеВыгрузкиИсторииСайтЖКХ.Организация = &Организация
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СостояниеВыгрузкиИсторииСайтЖКХ.ПериодВыгрузки
		|ИЗ
		|	РегистрСведений.СостояниеВыгрузкиИсторииСайтЖКХ КАК СостояниеВыгрузкиИсторииСайтЖКХ
		|ГДЕ
		|	СостояниеВыгрузкиИсторииСайтЖКХ.Организация = &Организация
		|	И НЕ СостояниеВыгрузкиИсторииСайтЖКХ.Подтверждено";
		
	Запрос.УстановитьПараметр("Организация", СтруктураНастройки.Организация);
	
	МассивРезультатов = Запрос.ВыполнитьПакет();
	
	ЭтоНачалоВыгрузкиИстории = МассивРезультатов[0].Пустой();
	ЭтоОкончаниеВыгрузкиИстории = МассивРезультатов[1].Пустой();
	
	Если ЗначениеЗаполнено(СтруктураНастройки.ДатаНачалаВыгрузкиНаСайт) Тогда
		
		Если ЭтоНачалоВыгрузкиИстории Тогда
			
			НаборЗаписей = РегистрыСведений.СостояниеВыгрузкиИсторииСайтЖКХ.СоздатьНаборЗаписей();	
			НаборЗаписей.Прочитать();
			ТаблицаВыгрузкиИстории = НаборЗаписей.Выгрузить();
			
			МесяцТекущейДаты = НачалоМесяца(ТекущаяДата());
			ПериодВыгрузки = НачалоМесяца(СтруктураНастройки.ДатаНачалаВыгрузкиНаСайт);
			
			Пока ПериодВыгрузки < МесяцТекущейДаты Цикл
				
				НоваяСтрока = ТаблицаВыгрузкиИстории.Добавить();
				НоваяСтрока.Организация = СтруктураНастройки.Организация;
				НоваяСтрока.ПериодВыгрузки = ПериодВыгрузки;
				
				ПериодВыгрузки = ДобавитьМесяц(ПериодВыгрузки, 1);
			КонецЦикла;
			
			НаборЗаписей.Загрузить(ТаблицаВыгрузкиИстории);
			НаборЗаписей.Записать();
		
		ИначеЕсли ЭтоОкончаниеВыгрузкиИстории Тогда
			
			НаборЗаписей = РегистрыСведений.СостояниеВыгрузкиИсторииСайтЖКХ.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Организация.Установить(СтруктураНастройки.Организация);
			НаборЗаписей.Записать();
			
			ТаблицаНастройки = Константы.НастройкаОбменДаннымиХвояСайтЖКХ.Получить().Получить();
			
			НайденныеСтроки = ТаблицаНастройки.НайтиСтроки(Новый Структура("Организация", СтруктураНастройки.Организация));
			Если НайденныеСтроки.Количество() > 0 Тогда
				НайденныеСтроки[0].ДатаНачалаВыгрузкиНаСайт = '00010101';
				Константы.НастройкаОбменДаннымиХвояСайтЖКХ.Установить(Новый ХранилищеЗначения(ТаблицаНастройки));
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;	
		
КонецПроцедуры

Процедура ОтметкаВыгрузкиИстории(СтруктураНастройки)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СостоянияОбменовДаннымиХвояСайтЖКХ.ПериодВыгрузки КАК ПериодВыгрузки
		|ИЗ
		|	РегистрСведений.СостоянияОбменовДаннымиХвояСайтЖКХ КАК СостоянияОбменовДаннымиХвояСайтЖКХ
		|ГДЕ
		|	НЕ СостоянияОбменовДаннымиХвояСайтЖКХ.Подтверждено
		|	И СостоянияОбменовДаннымиХвояСайтЖКХ.ЛицевойСчет.Владелец.Организация = &Организация
		|
		|СГРУППИРОВАТЬ ПО
		|	СостоянияОбменовДаннымиХвояСайтЖКХ.ПериодВыгрузки
		|
		|УПОРЯДОЧИТЬ ПО
		|	ПериодВыгрузки";
		
	Запрос.УстановитьПараметр("Организация", СтруктураНастройки.Организация);		
	ТаблицаНеОбработанныхПериодов = Запрос.Выполнить().Выгрузить();	
	
	
	НаборЗаписей = РегистрыСведений.СостояниеВыгрузкиИсторииСайтЖКХ.СоздатьНаборЗаписей();	
	
	НаборЗаписей.Отбор.Организация.Установить(СтруктураНастройки.Организация);
	НаборЗаписей.Прочитать();
			
	Для Каждого СтрокаНабораЗаписей Из НаборЗаписей Цикл 
		НайденныеСтроки = ТаблицаНеОбработанныхПериодов.НайтиСтроки(Новый Структура("ПериодВыгрузки", СтрокаНабораЗаписей.ПериодВыгрузки));
		Если НайденныеСтроки.Количество() = 0 Тогда
			СтрокаНабораЗаписей.Подтверждено = Истина;	
		Иначе
			СтрокаНабораЗаписей.Подтверждено = Ложь;	
		КонецЕсли;
	КонецЦикла;
		
	НаборЗаписей.Записать();

КонецПроцедуры


/////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ ОБМЕНА ДАННЫМИ

// Анализирует вариант обмена данными и выполнять соответствующие ему виды обмена.
//
// Параметры:
//  ВариантОбмена - СправочникСсылка.ВариантыОбменаДаннымиССайтом - вариант обмена.
//
Функция ВыполнитьОбменДаннымиССайтом(ВариантОбмена, Пароль = Неопределено, ДатаОбмена) Экспорт
	
	КлючВозврата = Неопределено;
	
	Если Пароль = Неопределено Тогда
		Пароль = ВариантОбмена.НастройкаДоступа.Пароль;
	КонецЕсли;
	
	Если ВариантОбмена.ВыгрузкаДанныхПоЛС Тогда
		КлючВозврата = ВыполнитьВыгрузкуДанныхПоЛС(ВариантОбмена, Пароль, ДатаОбмена);
	КонецЕсли;
	
	Если ВариантОбмена.ЗагрузкаПоказанийПУ Тогда
		ВыполнитьЗагрузкуПоказанийПоПУ(ВариантОбмена, Пароль);
	КонецЕсли;
	
	Если ВариантОбмена.ЗагрузкаРеестраПлатежей Тогда
		ВыполнитьЗагрузкуРеестраПлатежей(ВариантОбмена, Пароль);
	КонецЕсли;
	
	Если ВариантОбмена.ЗагрузкаСведенийОбАккаунтах Тогда
		ВыполнитьЗагрузкуСведенияОбАккаунтах(ВариантОбмена.НастройкаДоступа, Пароль, ВариантОбмена);
	КонецЕсли;
	
	Возврат КлючВозврата;
	
КонецФункции // ВыполнитьОбменДаннымиССайтом()

// Выполняет выгрузку на сайт параметров доступа по л/с.
//
// Параметры:
//  НастройкаДоступа - СправочникСсылка.НастройкиДоступаКСайту - настройка доступа
//  ТаблицаЛС - ТаблицаЗначений - таблица с параметрами доступа
//  ВсеПараметрыПереданы - Булево - признак того, что все параметры переданы на сайт
//  ВариантОбмена - СправочникСсылка.ВариантыОбменаДаннымиССайтом - вариант обмена
//
Функция ВыполнитьВыгрузкуПараметровДоступаПоЛС(НастройкаДоступа, ТаблицаЛС, ВсеПараметрыПереданы, 
												 ВариантОбмена = Неопределено, Пароль = Неопределено,
												 ОбновлятьПараметрыДоступа = Ложь) Экспорт
	
	СведенияОбОшибке = "";
	КлючВозврата = Неопределено;
	// Подготавливаем данные для формирования файла обмена.
	СтруктураПараметров = ПолучитьДанныеДляВыгрузки("access", НастройкаДоступа, ТаблицаЛС,,НастройкаДоступа.ВидШаблонаСайта);
	
	Если СтруктураПараметров = Неопределено Тогда
		СведенияОбОшибке = "Неизвестный формат файла обмена";
		ОбщегоНазначенияКлиентСервер.СообщитьОшибкиПользователю(СведенияОбОшибке);
		
		Возврат Неопределено;
	КонецЕсли;
	
	ФайлВыгрузки = СформироватьФайлXML(СтруктураПараметров, ОбновлятьПараметрыДоступа, НастройкаДоступа.ВидШаблонаСайта);
	
	Если НастройкаДоступа.ТипОбмена = Перечисления.ТипыОбменаССайтом.Напрямую Тогда
		Ответ = ПередатьДанныеНаСайт(ФайлВыгрузки,
									  "accounts",
									  НастройкаДоступа.АдресСайта,
									  НастройкаДоступа.Логин,
									  ?(Пароль = Неопределено, НастройкаДоступа.Пароль, Пароль),
									  НастройкаДоступа.Организация.ИНН,
									  СведенияОбОшибке,
									  НастройкаДоступа.ВидШаблонаСайта);
		
		ВсеПараметрыПереданы = ?(Ответ = Неопределено, Ложь, Истина);
	Иначе
		
		//КопироватьФайл(ФайлВыгрузки, НастройкаДоступа.ФайловыйРесурс+"\ПараметровДоступаПоЛС.xml");
		//ПолноеИмяФайла = КаталогВременныхФайлов() + ФайлВыгрузки;
		КлючВозврата = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ФайлВыгрузки));
		ВсеПараметрыПереданы = Истина;
	КонецЕсли;
	
	СоздатьЗаписьЖурналаРегистрации(НастройкаДоступа,
								  СведенияОбОшибке,
								  Перечисления.ВидыОбменаССайтом.ВыгрузкаДанныхЛС,
								  ВариантОбмена);
	Возврат КлючВозврата;								  
	
КонецФункции // ВыполнитьВыгрузкуПараметровДоступаПоЛС()

// Выполняет выгрузку на сайт основных учетных данных (начисления, показания по ПУ и пр.).
//
// Параметры:
//  ВариантОбмена - СправочникСсылка.ВариантыОбменаДаннымиССайтом - вариант обмена
//
Функция  ВыполнитьВыгрузкуДанныхПоЛС(ВариантОбмена, Пароль, ДатаОбмена)
	
	НастройкаДоступа  = ВариантОбмена.НастройкаДоступа;
	СведенияОбОшибке = "";
	КлючВозврата = Неопределено;
	
	СтруктураПараметров = ПолучитьДанныеДляВыгрузки("calculations", НастройкаДоступа, , ДатаОбмена);
	
	Если СтруктураПараметров = Неопределено Тогда
		СведенияОбОшибке = НСтр("ru='Не удалось сформировать файл обмена: неизвестный формат обмена.';uk='Не вдалося сформувати файл обміну: невідомий формат обміну.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СведенияОбОшибке);
		
		Возврат Неопределено;
	КонецЕсли;
	
	ФайлВыгрузки = СформироватьФайлXML(СтруктураПараметров);
	Если ФайлВыгрузки = Неопределено Тогда
		СведенияОбОшибке = НСтр("ru='Не удалось сформировать файл обмена: неизвестный формат обмена.';uk='Не вдалося сформувати файл обміну: невідомий формат обміну.'");
		
		Возврат Неопределено;
	КонецЕсли;
	
	Если НастройкаДоступа.ТипОбмена = Перечисления.ТипыОбменаССайтом.Напрямую Тогда
		Ответ = ПередатьДанныеНаСайт(ФайлВыгрузки,
								  "accounts",
								  НастройкаДоступа.АдресСайта,
								  НастройкаДоступа.Логин,
								  Пароль,
								  НастройкаДоступа.Организация.ИНН,
								  СведенияОбОшибке,
								  НастройкаДоступа.ВидШаблонаСайта);
																			  
	Иначе
		
		//КопироватьФайл(ФайлВыгрузки, НастройкаДоступа.ФайловыйРесурс+"\ВыгрузкуДанныхПоЛС.xml");
		КлючВозврата = ПоместитьВоВременноеХранилище(ФайлВыгрузки);
	КонецЕсли;
	
	СоздатьЗаписьЖурналаРегистрации(ВариантОбмена.НастройкаДоступа,
								  СведенияОбОшибке,
								  Перечисления.ВидыОбменаССайтом.ВыгрузкаДанныхЛС,
								  ВариантОбмена);
								  
	Возврат КлючВозврата;							  
	
КонецФункции // ВыполнитьВыгрузкуДанныхПоЛС()

// Выполняет загрузку с сайта показания по ИПУ.
//
// Параметры:
//  ВариантОбмена - СправочникСсылка.ВариантыОбменаДаннымиССайтом - вариант обмена
//
Процедура ВыполнитьЗагрузкуПоказанийПоПУ(ВариантОбмена, Пароль)
	
	НастройкаДоступа = ВариантОбмена.НастройкаДоступа;
	СведенияОбОшибке = "";
	
	Если ВариантОбмена.НастройкаДоступа.ТипОбмена = Перечисления.ТипыОбменаССайтом.Напрямую Тогда
		ФайлЗагрузки = ЗагрузитьДанныеССайта("meters",
									   		  НастройкаДоступа.АдресСайта,
									   		  НастройкаДоступа.Логин,
									   		  Пароль,
									   		  НастройкаДоступа.Организация.ИНН,
									   		  СведенияОбОшибке,,
											  НастройкаДоступа.ВидШаблонаСайта);
																					  
		
	Иначе
		// Временная заглушка.
		Возврат;
		
	КонецЕсли;
	
	Если НЕ ФайлЗагрузки = Неопределено Тогда
		СтруктураДанных = ПолучитьДанныеИзXML(ФайлЗагрузки, НастройкаДоступа, СведенияОбОшибке);
		
		ЗагрузитьДанныеВБазу(СтруктураДанных, НастройкаДоступа, СведенияОбОшибке);
	КонецЕсли;
	
	СоздатьЗаписьЖурналаРегистрации(ВариантОбмена.НастройкаДоступа,
								  СведенияОбОшибке,
								  Перечисления.ВидыОбменаССайтом.ЗагрузкаПоказанийПУ,
								  ВариантОбмена);
	
КонецПроцедуры // ВыполнитьЗагрузкуПоказанийПоПУ

// Выполняет загрузку с сайта реестра платежей.
//
// Параметры:
//  ВариантОбмена - СправочникСсылка.ВариантыОбменаДаннымиССайтом - вариант обмена
//
Процедура ВыполнитьЗагрузкуРеестраПлатежей(ВариантОбмена, Пароль)
	
	НастройкаДоступа = ВариантОбмена.НастройкаДоступа;
	СведенияОбОшибке = "";
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("НачальнаяДата", ПолучитьДатуПоследнейЗагрузкиРестраПлатежей(НастройкаДоступа));
	ДопПараметры.Вставить("КонечнаяДата",  ТекущаяДата());
	
	Если ВариантОбмена.НастройкаДоступа.ТипОбмена = Перечисления.ТипыОбменаССайтом.Напрямую Тогда
		ФайлЗагрузки = ЗагрузитьДанныеССайта("monetapayments",
									   		  НастройкаДоступа.АдресСайта,
									   		  НастройкаДоступа.Логин,
									   		  Пароль,
									   		  НастройкаДоступа.Организация.ИНН,
									   		  СведенияОбОшибке,
											  ДопПараметры,
											  НастройкаДоступа.ВидШаблонаСайта);
																					  
																					  
	Иначе
		// Временная заглушка.
		Возврат;
	КонецЕсли;
	
	Если НЕ ФайлЗагрузки = Неопределено Тогда
		СтруктураДанных = ПолучитьДанныеИзXML(ФайлЗагрузки, НастройкаДоступа, СведенияОбОшибке);
		
		ЗагрузитьДанныеВБазу(СтруктураДанных, НастройкаДоступа, СведенияОбОшибке);
		
		ДатаОбмена = СтруктураДанных.filedate;
	Иначе
		ДатаОбмена = ТекущаяДата();
	КонецЕсли;
	
	СоздатьЗаписьЖурналаРегистрации(ВариантОбмена.НастройкаДоступа,
								  СведенияОбОшибке,
								  Перечисления.ВидыОбменаССайтом.ЗагрузкаРеестраПлатежей,
								  ВариантОбмена,
								  ДатаОбмена);
	
КонецПроцедуры // ВыполнитьЗагрузкуРеестраПлатежей

// Выполнить загрузку с сайта сведений об аккаунтах.
//
// Параметры:
//  НастройкаДоступа - СправочникСсылка.НастройкиДоступаКСайту - настройка доступа
//  ВариантОбмена - СправочникСсылка.ВариантыОбменаДаннымиССайтом - вариант обмена
//  ФайлОбмена - Строка - путь к файлу обмена, выбранному пользователем
//
Процедура ВыполнитьЗагрузкуСведенияОбАккаунтах(НастройкаДоступа, Пароль, ВариантОбмена = Неопределено) Экспорт
	
	СведенияОбОшибке = "";
	
	ФайлОбмена = ЗагрузитьДанныеССайта("accexistence",
										НастройкаДоступа.АдресСайта,
										НастройкаДоступа.Логин,
										Пароль,
										НастройкаДоступа.Организация.ИНН,
										СведенияОбОшибке,
										НастройкаДоступа.ВидШаблонаСайта);
	
	Если НЕ ФайлОбмена = Неопределено Тогда
		СтруктураСведений = ПолучитьДанныеИзXML(ФайлОбмена, НастройкаДоступа, СведенияОбОшибке,НастройкаДоступа.ВидШаблонаСайта);
		
		ЗагрузитьДанныеВБазу(СтруктураСведений, НастройкаДоступа, СведенияОбОшибке);
	КонецЕсли;
	
	СоздатьЗаписьЖурналаРегистрации(НастройкаДоступа,
								  СведенияОбОшибке,
								  Перечисления.ВидыОбменаССайтом.ЗагрузкаСведенийОбАккаунтах,
								  ВариантОбмена);
КонецПроцедуры // ВыполнитьЗагрузкуСведенияОбАккаунтах()

// Данный общий модуль предназначен для хранения изменяемых механизмов, которые отвечают за сбор и запись
// данных в БД.
// Детальное описание форматов сбора/записи можно найти в комментариях к процедурам и функциям.


///////////////////////////////////////////////////////////////////////////////
// ЖУРНАЛ РЕГИСТРАЦИИ

// Создает запись в журнале регистрации.
//
// Параметры:
//  ВариантОбмена - СправочникСсылка.ВариантыОбменаДаннымиССайтом - вариант обмена данными
//  СведенияОбОшибке - Строка - сведения об ошибке (если такова имеется)
//  ВидОбмена - ПеречислениеСсылка.ВидыОбменаССайтом - вид обмена данными
//  ДатаОбмена - Дата - дата совершения обмена
//
Процедура СоздатьЗаписьЖурналаРегистрации(НастройкаДоступа, СведенияОбОшибке, ВидОбмена, ВариантОбмена = Неопределено, ДатаОбмена = Неопределено)
	
	НаборЗаписей = РегистрыСведений.ЖурналОбменаССайтом.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.НастройкаДоступа.Установить(НастройкаДоступа);
	НаборЗаписей.Прочитать();
	
	НоваяЗапись = НаборЗаписей.Добавить();
	НоваяЗапись.НастройкаДоступа = НастройкаДоступа;
	НоваяЗапись.ВариантОбмена    = ?(ВариантОбмена = Неопределено, Справочники.ВариантыОбменаДаннымиССайтом.ПустаяСсылка(), ВариантОбмена);
	НоваяЗапись.ВидОбмена        = ВидОбмена;
	НоваяЗапись.Дата             = ?(ДатаОбмена = Неопределено, ТекущаяДата(), ДатаОбмена);
	НоваяЗапись.Статус           = ?(ПустаяСтрока(СведенияОбОшибке), Истина, Ложь);
	НоваяЗапись.Ошибка           = СведенияОбОшибке;
	
	НаборЗаписей.Записать();
	
КонецПроцедуры // СоздатьЗаписьЖурналаРегистрации()

///////////////////////////////////////////////////////////////////////////////
// ФУНКЦИИ СБОРА ДАННЫХ ДЛЯ ВЫГРУЗКИ

// Формирует структуру, содержащую сведения для выгрузки в XML.
// 
// Параметры:
//  ВариантВыгрузки - строка, содержащая наименование варианта выгрузки.
//                    Может принимать следующие значения:
//                     "Access"  - выгрузка параметров доступа л/с. Формируется
//                                  на основании аргумента <МассивЛС>.
//                     "Calculations" - выгрузка полной информации об организация,
//                                  начислениях на л/с, счетчиках, поставщиках услуг.
//                                  Аргумент <МассивЛС> не используется. Выгрузка
//                                  логинов л/с не осуществляется.
//                     "Accounts" - аналогично с вариантом "Расчеты", но с выгрузкой
//                                  логинов л/с.
//  НастройкаДоступа - ссылка на элемент справочника "Настройки доступа к сайту".
//  ТаблицаЛС - таблица с параметрам доступа по л/с. Используется только при варианте выгрузки "Access".
// 
// Возвращаемое значение:
//  Структура - содержит данные для выгрузки в XML.
//  Неопределено - в случае некорректных значений аргументов <ВариантВыгрузки> или <НастройкиОбмена>.
//
// Примечание:
// Выгрузка может производиться в соответствии со следующими вариантами:
// - "access" - выгружаются параметры доступа л/с.
// - "calculations" - выгружаются сведения о взаиморасчетах по л/с.
// - "accounts" - выгружаются сведения о взаиморасчетах по л/с, а также логины л/с для доступа на сайт.
//
// Данные для выгрузки представлены в виде структуры, все поля которой, содержат значения строкового типа, за исключением полей, хранящих таблицы значений и массивы (значения полей таблиц значений и массивов так же должны быть строковыми).
// Незаполненному значению поля соответствует пустая строка ("").
// Данная структура содержит следующие поля:
//
// 1) Для выгрузки параметров доступа л/с (Вариант выгрузки "Access"):
//
// filedate // Дата начала месяца выгрузки в формате "дд.ММ.гггг".
// name     // Наименование организации.
// inn      // ИНН.
// filetype // Тип файла ("Access").
// version  // версия механизма обмена ("3").
// \PersAcc     // Таблица л/с (таблица значений, заполняется на основании аргумента "ТаблицаЛС"), содержащая колонки:
//     kod_ls   // Идентификатор л/с.
//     login    // Логин л/с.
//     password // Пароль л/с.
//
// 2) Для выгрузки сведений о расчетах (Варианты выгрузки "Calculations" и "Accounts"):
//
// filedate // Дата формирования выгрузки.
// name     // Наименование организации.
// inn      // ИНН.
// filetype // Тип файла (Соответсвует наименованию варианта выгрузки: "Calculations" или "Accounts").
// version  // версия механизма обмена ("3").
// kpp      // КПП.
// bank     // Полное наименование банка.
// rs       // рассчетный счет.
// ks       // коррсчет.
// bik      // БИК.
// \contractors  // Таблица поставщиков (таблица значений), содержащая колонки:
//     id        // Код поставщика.
//     name      // Наименование поставщика.
//     executor  // Исполнитель ("1" для выбранной организации, для других поставщиков услуг не заполняется).
//     address   // Адрес, заполняется только для выбранной организации.
//     phone     // Телефон/факс, заполняется только для выбранной организации.
//     services  // Услуги, предоставляемые поставщиком. Если поставщик предоставляет несколько услуг, для каждой будет создана отдельная строка. Не заполняется для выбранной организации.
//     textValue // Текстовое содержимое, содержит платежные реквизиты поставщика услуг.
// \hmeters        // Таблица ОПУ (таблица значений), содержащая колонки:
//     value_count // Количество видов тарифов счетчика.
//     indiccur1   // Последнее учтенное дневное показание счетчика.
//     indiccur2   // Последнее учтенное ночное показание счетчика.
//     indiccur3   // Последнее учтенное пиковое показание счетчика.
//     kod         // Код счетчика.
//     name        // Наименование счетчика.
//     service     // Услуга, на которую установлен счетчик.
// \PersAcc              // Таблица л/с(таблица значений), содержащая колонки:
//     kod_ls            // Идентификатор л/с.
//     login             // Логин л/с. Заполняется только при варианте выгрузки "Accounts".
//     password          // Не заполняется.
//     AddressCity       // Адрес, город.
//     AddressDistrict   // Адрес, район города.
//     AddressFlat       // Адрес, квартира.
//     FlatAbbr          // Краткое обозначение типа помещения (кв., пом., каб. и т. п.) Если не указано, используется обозначение "кв.".
//     AddressHouse      // Адрес, дом.
//     AddressRegion     // Адрес, регион.
//     AddressSettlement // Адрес, населенный пункт.
//     AddressStreet     // Адрес, улица.
//     Barcode           // Штрихкод (для вывода в квитанциях).
//     commonarea        // Общая площадь помещения.
//     habarea           // Жилая площадь помещения.
//     debtbeg           // Задолженность на начало расчетного периода (период с начала месяца, на который происходит выгрузка, по окончание текущего дня).
//     debtend           // Задолженность на конец расчетного периода.
//     debtprev          // Задолженность за предыдущие периоды.
//     prepayment        // Аванс на начало расчетного периода.
//     sumtopay          // Итоговая сумма к оплате за расчетный период.
//     lastPaymentDate   // Дата последнего платежа.
//     email             // E-mail пользователя на сайте.
//     name              // ФИО владельца л/с.
//     name_ls           // Номер лицевого счета (Наименование).
//     people            // Количество проживающих.
//     num_of_reg        // Количество зарегистрированных.
//     \item            // Таблица начислений по услугам за расчетный период (таблица значений), содержащая колонки:
//         ammount      // объем потребления услуги (индивидуальный + общедомовой).
//         correction   // Сумма перерасчетов за расчетный период.
//         edizm        // Единица измерения.
//         kod          // Код услуги.
//         name         // Наименование услуги.
//         norm         // Норма потребления (полностью).
//         peni         // Пени, начисленные за расчетный период.
//         sum          // Сумма начисления (полностью).
//         sumpayed     // Сумма оплат, внесенных за расчетный период.
//         compensation // Сумма начисленных льгот.
//         sumtopay     // Сумма к оплате.
//         debtbeg      // Задолженность на начало расчетного период.
//         debtend      // Задолженность на конец отчетного периода.
//         hmeter       // Массив, содержащий коды ОПУ, установленных на услугу текущей строки таблицы.
//         hammount     // Объем потребления услуги (общедомовой).
//         hnorm        // Норма потребления (общедомовая).
//         hsum         // Сумма начисления (общедомовая).
//         hsumtopay    // Сумма к оплате (общедомовая).
//         volumeh      // Общий объем ОДН для здания.
//         tarif1       // Дневной тариф.
//         tarif2       // Ночной тариф. Заполняется только если услуга имеет 2 и более тарифов.
//         tarif3       // Пиковый тариф. Заполняется только если услуга имеет 2 и более тарифов.
//     \meter            // Таблица показаний ИПУ (таблица значений), содержащая колонки:
//         value_count   // Количество тарифов.
//         indicbef1     // Последнее учтенное показание на начало расчетного периода (Дневное). Не заполняется при совпадении date_indicbef и date_indiccur.
//         indicbef2     // Последнее учтенное показание на начало расчетного периода (Ночное). Не заполняется при совпадении date_indicbef и date_indiccur.
//         indicbef3     // Последнее учтенное показание на начало расчетного периода (Пиковое). Не заполняется при совпадении date_indicbef и date_indiccur.
//         date_indicbef // Дата последнего учтенного показания на начало расчетного периода. Не заполняется при совпадении date_indicbef и date_indiccur.
//         indiccur1     // Последнее учтенное показание на конец отчетного период (Дневное).
//         indiccur2     // Последнее учтенное показание на конец отчетного период (Ночное).
//         indiccur3     // Последнее учтенное показание на конец отчетного период (Пиковое).
//         date_indiccur // Дата последнего учтенного показания на начало расчетного периода.
//         kod           // Код счетчика.
//         name          // Наименование счетчика.
//         service       // Наименование услуги.
//     \contractor // Таблица поставщиков услуг, назначенных на л/с (таблица значений), содержащая колонки:
//         id      // Код поставщика.        
//         summ    // Итоговая сумма к оплате поставщику.
//
Функция ПолучитьДанныеДляВыгрузки(ВариантВыгрузки, НастройкаДоступа, ТаблицаЛС = Неопределено, ДатаОбмена = Неопределено,Шаблон = Неопределено)
	
	Если ДатаОбмена = Неопределено Тогда
		ДатаОбмена = ТекущаяДата();
	КонецЕсли;
	
	// Проверка настроек обмена.
	Если НЕ ЗначениеЗаполнено(НастройкаДоступа)
	 ИЛИ НЕ ЗначениеЗаполнено(НастройкаДоступа.Организация) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	
	// Начальные значения переменных.
	ТипФайла           = "";
	ВыгружатьВсеДанные = Ложь; // Выгружать все сведения об организации, начислениях и л/с.
	ВыгружатьЛогины    = Ложь; // Выгружать логины (для вариантов "Calculations" и "Accounts").
	Организация        = НастройкаДоступа.Организация;
	ПрефиксЛС          = ПолучитьПрефикс(Организация); // Префикс, добавляемый к коду л/с.
	ВариантВыгрузки    = НРег(ВариантВыгрузки);
	
	// Определение переменных.
	Если ВариантВыгрузки = "access" Тогда
		ТипФайла           = "access";
	ИначеЕсли ВариантВыгрузки = "calculations" Тогда
		ТипФайла           = "calculations";
		ВыгружатьВсеДанные = Истина;
		МассивЛС           = ПолучитьМассивЛицевыхСчетовОрганизации(Организация, ДатаОбмена);
	ИначеЕсли ВариантВыгрузки = "accounts" Тогда
		ТипФайла           = "accounts";
		ВыгружатьВсеДанные = Истина;
		ВыгружатьЛогины    = Истина;
		МассивЛС           = ПолучитьМассивЛицевыхСчетовОрганизации(Организация, ДатаОбмена);
	Иначе
		// Если неверный вариант выгрузки.
		Возврат Неопределено;
	КонецЕсли;
	
	//////// Сбор данных ////////
	
	// Сведения об организации.
	СведенияОбОрганизации = ПолучитьСведенияОбОрганизации(Организация, ТипФайла, ВыгружатьВсеДанные, ДатаОбмена);
	
	// Сбор сведений для полной выгрузки.
	Если ВыгружатьВсеДанные Тогда
		ТаблицаНачисленийОбщая         = ПолучитьТаблицуНачислений(Организация, МассивЛС, ДатаОбмена);
		ТаблицаИПУОбщая                = ПолучитьСведенияОбИПУ(МассивЛС, ДатаОбмена);
		ТаблицаЛицевыхСчетовОбщая      = ПолучитьСведенияОЛицевыхСчетах(МассивЛС, ТаблицаНачисленийОбщая, ВыгружатьЛогины, ДатаОбмена);
	КонецЕсли;
	
	//////// Формирование структуры выгрузки ////////
	
	СтруктураВыгрузки = Новый Структура;
	
	// Общие данные организации
	СтруктураВыгрузки.Вставить("filedate", Формат(НачалоМесяца(СведенияОбОрганизации.filedate),"ДЛФ=Д"));
	СтруктураВыгрузки.Вставить("name",     СведенияОбОрганизации.name);
	СтруктураВыгрузки.Вставить("inn",      СведенияОбОрганизации.inn);
	СтруктураВыгрузки.Вставить("filetype", СведенияОбОрганизации.filetype);
	СтруктураВыгрузки.Вставить("version",  СведенияОбОрганизации.version);
	
	// Дополнительные данные организации
	Если ВыгружатьВсеДанные Тогда
		
		// Реквизиты организации
		СтруктураВыгрузки.Вставить("kpp",  СведенияОбОрганизации.kpp);
		СтруктураВыгрузки.Вставить("bank", СведенияОбОрганизации.bank);
		СтруктураВыгрузки.Вставить("rs",   СведенияОбОрганизации.rs);
		СтруктураВыгрузки.Вставить("ks",   СведенияОбОрганизации.ks);
		СтруктураВыгрузки.Вставить("bik",  СведенияОбОрганизации.bik);
		
	КонецЕсли;
	
	//////// ЛИЦЕВЫЕ СЧЕТА ////////
	
	// Общие данные
	СтруктураВыгрузки.Вставить("PersAcc", Новый ТаблицаЗначений);
	СтруктураВыгрузки.PersAcc.Колонки.Добавить("kod_ls");
	СтруктураВыгрузки.PersAcc.Колонки.Добавить("login");
	СтруктураВыгрузки.PersAcc.Колонки.Добавить("password");
	СтруктураВыгрузки.PersAcc.Колонки.Добавить("email");
	
	Если ВыгружатьВсеДанные Тогда
		
		// Структуры отборов.
		ОтборПоЛС     = Новый Структура("ЛицевойСчет");
		ОтборПоЗданию = Новый Структура("Здание");
		ОтборПоУслуге = Новый Структура("Услуга");
		
		// Создаем таблицу л/с
		СтруктураВыгрузки.PersAcc.Колонки.Добавить("AddressCity");
		СтруктураВыгрузки.PersAcc.Колонки.Добавить("AddressDistrict");
		СтруктураВыгрузки.PersAcc.Колонки.Добавить("AddressFlat");
		СтруктураВыгрузки.PersAcc.Колонки.Добавить("FlatAbbr");
		СтруктураВыгрузки.PersAcc.Колонки.Добавить("AddressHouse");
		СтруктураВыгрузки.PersAcc.Колонки.Добавить("AddressRegion");
		СтруктураВыгрузки.PersAcc.Колонки.Добавить("AddressSettlement");
		СтруктураВыгрузки.PersAcc.Колонки.Добавить("AddressStreet");
		СтруктураВыгрузки.PersAcc.Колонки.Добавить("Barcode");
		СтруктураВыгрузки.PersAcc.Колонки.Добавить("commonarea");
		СтруктураВыгрузки.PersAcc.Колонки.Добавить("debtbeg");
		СтруктураВыгрузки.PersAcc.Колонки.Добавить("debtend");
		СтруктураВыгрузки.PersAcc.Колонки.Добавить("debtprev");
		СтруктураВыгрузки.PersAcc.Колонки.Добавить("prepayment");
		СтруктураВыгрузки.PersAcc.Колонки.Добавить("sumtopay");
		СтруктураВыгрузки.PersAcc.Колонки.Добавить("lastPaymentDate");
		СтруктураВыгрузки.PersAcc.Колонки.Добавить("habarea");
		СтруктураВыгрузки.PersAcc.Колонки.Добавить("name");
		СтруктураВыгрузки.PersAcc.Колонки.Добавить("name_ls");
		СтруктураВыгрузки.PersAcc.Колонки.Добавить("people");
		СтруктураВыгрузки.PersAcc.Колонки.Добавить("num_of_reg");
		СтруктураВыгрузки.PersAcc.Колонки.Добавить("item");
		СтруктураВыгрузки.PersAcc.Колонки.Добавить("meter");
		СтруктураВыгрузки.PersAcc.Колонки.Добавить("contractor");
		
		// Заполняем таблицу л/с
		Для каждого ТекЛС из ТаблицаЛицевыхСчетовОбщая Цикл

			НоваяСтрока = СтруктураВыгрузки.PersAcc.Добавить();
			
			НоваяСтрока.AddressCity       = СокрЛП(ТекЛС.AddressCity);
			НоваяСтрока.AddressDistrict   = СокрЛП(ТекЛС.AddressDistrict);
			НоваяСтрока.AddressFlat       = Строка(ТекЛС.AddressFlat);
			НоваяСтрока.FlatAbbr 		  = ?(ЗначениеЗаполнено(ТекЛС.FlatAbbr), Строка(ТекЛС.FlatAbbr) + " " + Строка(ТекЛС.AddressFlat) , "");
			НоваяСтрока.AddressHouse      = Строка(ТекЛС.AddressHouse) + ?(ЗначениеЗаполнено(ТекЛС.Корпус), "/" + Строка(ТекЛС.Корпус), "");
			НоваяСтрока.AddressRegion     = СокрЛП(ТекЛС.AddressRegion);
			НоваяСтрока.AddressSettlement = СокрЛП(ТекЛС.AddressSettlement);
			НоваяСтрока.AddressStreet     = СокрЛП(ТекЛС.AddressStreet);
			НоваяСтрока.Barcode           = ПолучитьШтрихКод(ТекЛС.ЛицевойСчет, НастройкаДоступа.Организация, ТекЛС.sumtopay);
			НоваяСтрока.commonarea        = Строка(ТекЛС.commonarea);
			НоваяСтрока.debtbeg           = Строка(ТекЛС.debtbeg);
			НоваяСтрока.debtend           = Строка(ТекЛС.debtend);
			НоваяСтрока.debtprev          = Строка(ТекЛС.debtprev);
			НоваяСтрока.prepayment        = Строка(ТекЛС.prepayment);
			НоваяСтрока.sumtopay          = Строка(ТекЛС.sumtopay);
			НоваяСтрока.lastPaymentDate   = Строка(Формат(ТекЛС.lastPaymentDate, "ДФ=дд.ММ.гггг"));
			НоваяСтрока.email             = СокрЛП(ТекЛС.email);
			НоваяСтрока.habarea           = Строка(ТекЛС.habarea);
			Если Шаблон = Перечисления.ВариантыСайта.СИНГРИ Тогда
				НоваяСтрока.kod_ls            = СокрЛП(ТекЛС.login);
			Иначе
				НоваяСтрока.kod_ls            = ПрефиксЛС + СокрЛП(ТекЛС.kod_ls);
			КонецЕсли;
			НоваяСтрока.name              = Строка(ТекЛС.name1);
			НоваяСтрока.name_ls           = Строка(ТекЛС.name_ls);
			НоваяСтрока.people            = Строка(ТекЛС.people);
			НоваяСтрока.num_of_reg        = Строка(ТекЛС.num_of_reg);
			НоваяСтрока.login             = ?(ВыгружатьЛогины, СокрЛП(ТекЛС.login), "");
			НоваяСтрока.password          = "";
			
			// Отборы для таблиц услуг, пу, поставщиков.
			ОтборПоЛС.ЛицевойСчет = ТекЛС.ЛицевойСчет;
			ОтборПоЗданию.Здание  = ТекЛС.Здание;
			
			// Отбор нужных улсуг, счетчиков и поставщиков
			СтрокиНачислений  = ТаблицаНачисленийОбщая.НайтиСтроки(ОтборПоЛС);
			СтрокиИПУ         = ТаблицаИПУОбщая.НайтиСтроки(ОтборПоЛС);
			
			// НАЧИСЛЕНИЯ
			Если НЕ СтрокиНачислений.Количество() = 0 Тогда
				
				НоваяСтрока.item = Новый ТаблицаЗначений;
				НоваяСтрока.item.Колонки.Добавить("ammount");
				НоваяСтрока.item.Колонки.Добавить("correction");
				НоваяСтрока.item.Колонки.Добавить("edizm");
				НоваяСтрока.item.Колонки.Добавить("kod");
				НоваяСтрока.item.Колонки.Добавить("name");
				НоваяСтрока.item.Колонки.Добавить("norm");
				НоваяСтрока.item.Колонки.Добавить("peni");
				НоваяСтрока.item.Колонки.Добавить("sum");
				НоваяСтрока.item.Колонки.Добавить("sumpayed");
				НоваяСтрока.item.Колонки.Добавить("compensation");
				НоваяСтрока.item.Колонки.Добавить("sumtopay");
				НоваяСтрока.item.Колонки.Добавить("debtbeg");
				НоваяСтрока.item.Колонки.Добавить("debtend");
				НоваяСтрока.item.Колонки.Добавить("hmeter");
				НоваяСтрока.item.Колонки.Добавить("hammount");
				НоваяСтрока.item.Колонки.Добавить("hnorm");
				НоваяСтрока.item.Колонки.Добавить("hsum");
				НоваяСтрока.item.Колонки.Добавить("hsumtopay");
				НоваяСтрока.item.Колонки.Добавить("volumeh");
				НоваяСтрока.item.Колонки.Добавить("tarif1");
				НоваяСтрока.item.Колонки.Добавить("tarif2");
				НоваяСтрока.item.Колонки.Добавить("tarif3");
				
				Для каждого ТекНачисление из СтрокиНачислений Цикл
					
					// Создание новой строки начислений.
					СтрокаУслуга = НоваяСтрока.item.Добавить();
					
					СтрокаУслуга.ammount      = Строка(ТекНачисление.ammount);
					СтрокаУслуга.correction   = Строка(ТекНачисление.correction);
					СтрокаУслуга.edizm        = Строка(ТекНачисление.edizm);
					СтрокаУслуга.kod          = Строка(ТекНачисление.kod);
					СтрокаУслуга.name         = Строка(ТекНачисление.Name);
					СтрокаУслуга.norm         = Строка(ТекНачисление.norm);
					СтрокаУслуга.peni         = Строка(ТекНачисление.peni);
					СтрокаУслуга.sum          = Строка(ТекНачисление.sum);
					СтрокаУслуга.sumpayed     = Строка(ТекНачисление.sumpayed);
					СтрокаУслуга.compensation = Строка(-ТекНачисление.compensation);
					
					Если ТекНачисление.ЭтоАванс Тогда
						СтрокаУслуга.sumtopay     = Строка(-ТекНачисление.sumpayed);
						
					Иначе
						СтрокаУслуга.sumtopay     = Строка(ТекНачисление.sum);
					КонецЕсли;
					
					СтрокаУслуга.debtbeg      = Строка(ТекНачисление.debtbeg);
					СтрокаУслуга.debtend      = Строка(ТекНачисление.debtend);
					
					// Тарифы.
					СтрокаУслуга.tarif1 = Строка(ТекНачисление.tarif1);
					Если ТекНачисление.Многотарифная Тогда
						СтрокаУслуга.tarif2 = Строка(ТекНачисление.tarif2);
						СтрокаУслуга.tarif3 = Строка(ТекНачисление.tarif3);
					Иначе
						СтрокаУслуга.tarif2 = "";
						СтрокаУслуга.tarif3 = "";
					КонецЕсли;
					
				КонецЦикла;
			КонецЕсли;
			
			// ИПУ
			Если НЕ СтрокиИПУ.Количество() = 0 Тогда
				
				НоваяСтрока.meter = Новый ТаблицаЗначений;
				НоваяСтрока.meter.Колонки.Добавить("value_count");
				НоваяСтрока.meter.Колонки.Добавить("indicbef1");
				НоваяСтрока.meter.Колонки.Добавить("indicbef2");
				НоваяСтрока.meter.Колонки.Добавить("indicbef3");
				НоваяСтрока.meter.Колонки.Добавить("date_indicbef");
				НоваяСтрока.meter.Колонки.Добавить("indiccur1");
				НоваяСтрока.meter.Колонки.Добавить("indiccur2");
				НоваяСтрока.meter.Колонки.Добавить("indiccur3");
				НоваяСтрока.meter.Колонки.Добавить("date_indiccur");
				НоваяСтрока.meter.Колонки.Добавить("kod");
				НоваяСтрока.meter.Колонки.Добавить("name");
				НоваяСтрока.meter.Колонки.Добавить("service");
				
				// Записываем и заполняем элементы "meter" для текущего элемента "PersAcc".
				Для Каждого ТекСчетчик Из СтрокиИПУ Цикл
					
					//meter - данные по индивидуальным счетчикам.
					СтрокаСчетчик = НоваяСтрока.meter.Добавить();
					
					СтрокаСчетчик.value_count   = Строка(ТекСчетчик.value_count);
					СтрокаСчетчик.kod           = Строка(ТекСчетчик.kod);
					СтрокаСчетчик.name          = Строка(ТекСчетчик.MName);
					СтрокаСчетчик.service       = Строка(ТекСчетчик.service);
					СтрокаСчетчик.indiccur1     = Строка(ТекСчетчик.indiccur1);
					СтрокаСчетчик.indiccur2     = Строка(ТекСчетчик.indiccur2);
					СтрокаСчетчик.indiccur3     = Строка(ТекСчетчик.indiccur3);
					СтрокаСчетчик.date_indiccur = Строка(ТекСчетчик.date_indiccur);
					
					// Даты показаний.
					Если ЗначениеЗаполнено(ТекСчетчик.date_indicbef) И НЕ ТекСчетчик.date_indicbef = ТекСчетчик.date_indiccur Тогда
						СтрокаСчетчик.indicbef1     = Строка(ТекСчетчик.indicbef1);
						СтрокаСчетчик.indicbef2     = Строка(ТекСчетчик.indicbef2);
						СтрокаСчетчик.indicbef3     = Строка(ТекСчетчик.indicbef3);
						СтрокаСчетчик.date_indicbef = Строка(ТекСчетчик.date_indicbef);
					Иначе
						СтрокаСчетчик.indicbef1     = "";
						СтрокаСчетчик.indicbef2     = "";
						СтрокаСчетчик.indicbef3     = "";
						СтрокаСчетчик.date_indicbef = "";
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
		КонецЦикла;
	Иначе
		// Параметры доступа
		Для каждого СтрокаЛС из ТаблицаЛС Цикл
			
			Если СтрокаЛС = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = СтруктураВыгрузки.PersAcc.Добавить();
			НоваяСтрока.kod_ls   = ПрефиксЛС + СокрЛП(СтрокаЛС.ЛицевойСчет.Идентификатор);
			НоваяСтрока.login    = Строка(СтрокаЛС.Логин);
			НоваяСтрока.password = Строка(СтрокаЛС.Пароль);
			НоваяСтрока.email   = СокрЛП(СтрокаЛС.ЛицевойСчет.ЭлПочта);
			
		КонецЦикла;
	КонецЕсли;
	
	Возврат СтруктураВыгрузки;
	
КонецФункции

// Формирует массив всех л/с выбранной организации, действующих на текущую дату.
// 
// Параметры:
//  Организация - выбранная организация
// 
// Возвращаемое значение:
//  Массив - массив л/с
//
// Примечание:
//  Функция должна возвращать массив со всеми лицевыми счетами, сведения о которых планируется передать
//  на сайт в ходе обмена основными учетными данными (начисления, показания по ПУ и т. д.).
//
Функция ПолучитьМассивЛицевыхСчетовОрганизации(Организация, ДатаОбмена, МассивЗданий = Неопределено)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	СведенияОНаличииПараметровДоступа.ЛицевойСчет
		|ПОМЕСТИТЬ втЛССПараметрами
		|ИЗ
		|	РегистрСведений.СведенияОНаличииПараметровДоступа КАК СведенияОНаличииПараметровДоступа
		|ГДЕ
		|	СведенияОНаличииПараметровДоступа.НаличиеПараметров
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЛицевыеСчетаСрезПоследних.ЛицевойСчет КАК ЛицевойСчет
		|ИЗ
		|	РегистрСведений.ЛицевыеСчета.СрезПоследних(
		|			&ДатаКон,
		|			ЛицевойСчет.Владелец.Организация = &Организация
		|				И ВЫБОР
		|					КОГДА &МассивЗданий = НЕОПРЕДЕЛЕНО
		|						ТОГДА ИСТИНА
		|					ИНАЧЕ ЛицевойСчет.Владелец В (&МассивЗданий)
		|				КОНЕЦ) КАК ЛицевыеСчетаСрезПоследних
		|ГДЕ
		|	ЛицевыеСчетаСрезПоследних.Действует
		|	И ЛицевыеСчетаСрезПоследних.ЛицевойСчет В
		|				(ВЫБРАТЬ
		|					втЛССПараметрами.ЛицевойСчет
		|				ИЗ
		|					втЛССПараметрами КАК втЛССПараметрами)";
		
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ДатаКон",     КонецДня(ДатаОбмена));
	Запрос.УстановитьПараметр("МассивЗданий", МассивЗданий);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат.ВыгрузитьКолонку("ЛицевойСчет");
	
КонецФункции // ПолучитьМассивЛицевыхСчетовОрганизации()

// Формирует структуру, содержащую сведения об организации.
// 
// Параметры:
//  Организация - выбранная организация
//  ТипФайла    - строка, определяет значение поля "filetype" выходной структуры.
//  ВыгружатьВсеДанные - булево, определяет, добавить ли в выходную структуру
//    сведения о банковском счете организации.
// 
// Возвращаемое значение:
//  Структура - содержит сведения о выбранной организации.
//
// Примечание:
//  Данная структура будет использоваться для формирования файла обмена.
//  Поэтому наличие и наименования ключей структуры должно быть неизменно.
//
Функция ПолучитьСведенияОбОрганизации(Организация, ТипФайла, ВыгружатьВсеДанные = Ложь, ДатаОбмена)
	
	СтруктураОрганизации = Новый Структура("name, inn, filedate, filetype, version",
								Организация.Наименование, // name
								Организация.ИНН,          // inn
								ДатаОбмена,            // filedate
								ТипФайла,                 // filetype
								ПолучитьТекущуюВерсиюМеханизмаИнтеграции()); // version
	
	Если ВыгружатьВсеДанные Тогда
		СтруктураОрганизации.Вставить("kpp",  Организация.ИНН); // КПП
		СтруктураОрганизации.Вставить("bank", Организация.БанковскийСчетПоУмолчанию.Банк.Наименование); // банк
		СтруктураОрганизации.Вставить("bik",  Организация.БанковскийСчетПоУмолчанию.Банк.Код); // БИК
		СтруктураОрганизации.Вставить("ks",   Организация.БанковскийСчетПоУмолчанию.Банк.КоррСчет); // Коррсчет
		СтруктураОрганизации.Вставить("rs",   Организация.БанковскийСчетПоУмолчанию.НомерСчета); // Расчетный счет
	КонецЕсли;
	
	Возврат СтруктураОрганизации;
	
КонецФункции // ПолучитьСведенияОбОрганизации()

// Формирует таблицу начислений.
// 
// Параметры:
//  Организация - выбранная организация
//  МассивЛС    - массив л/с
// 
// Возвращаемое значение:
//  ТаблицаЗначений - таблица начислений
//
// Примечание:
//  Данные текущей таблицы значений будут использоваться для формирования файл обмена.
//  Поэтому наличие и наименование колонок таблицы должно быть неизменно.
//  
//  Колонки:
//   ЛицевойСчет - ссылка на лицевой счет
//   Услуга - ссылка на услугу
//   SName - наименование услуги
//   VidName - наименование вида услуги
//   kod - код услуги
//   edizm - единица измерения услуги
//   tarif1 - размер дневного вида тарифа по услуге
//   tarif2 - размер ночного вида тарифа по услуге
//   tarif3 - размер пикового вида тарифа по услуге
//   Многотарифная - факт того, что услуга является многотарифной
//   ammount - суммарный объем потребления услуги лицевым счетом
//   hammount - общедомовой объем потребления услуги лицевым счетом
//   sum - сумма начисления на лицевой счет по услуге без учета перерасчетов, пеней и льгот
//   hsum - ОДН на лицевой счет по услуге
//   sumpayed - сумма оплат, внесенных лицевым счетом по услуге
//   ДатаПоследнейОплаты - дата последней поступившей оплаты от лицевого счета по услуге
//   correction - сумма перерасчетов по услуге
//   peni - сумма пеней, начисленных на лицевой счет по услуге
//   compensation - сумма льгот, начисленных на лицевой счет по услуге
//   msumtopay - сумма начисления на лицевой счет по услуге с учетом перерасчетов, пеней и льгот
//   hsumtopay - ОДН на лицевой счет по услуге с учетом перерасчетов, пеней и льгот
//   debtbeg - начальное сальдо по лицевому счету - услуге
//   debtend - конечное сальдо по лицевому счету - услуге
//   norm - размер нормы, установленной на лицевой счет по услуге
//   hnorm - размер нормы, установленной на здание по услуге
//   РасходИПУОбщ - суммарный объем индивидуальный потребления услуги всеми лицевыми счетами здания
//   volumeh - суммарный объем потребления услуги всеми лицевыми счетами здания, пошедший на ОДН
//   CONId - код поставщика услуги
//   summ - итоговая сумма начисления на лицевой счет по всем услугам текущего поставщика услуг
//   DebtPrev - сумма задолженности лицевого счета за предыдущие периоды по услуге: [Начальное сальдо] - [Внесенные оплаты]
//   SumToPay - итоговая сумма к оплате по лицевому счету - услуге
//
Функция ПолучитьТаблицуНачислений(Организация, МассивЛС, ДатаОбмена)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	РасчетыПоЛицевымСчетамОбороты.ЛицевойСчет,
		|	РасчетыПоЛицевымСчетамОбороты.Услуга,
		|	СУММА(РасчетыПоЛицевымСчетамОбороты.СуммаПриход) КАК sum,
		|	СУММА(РасчетыПоЛицевымСчетамОбороты.СуммаРасход) КАК sumpayed,
		|	РасчетыПоЛицевымСчетамОбороты.Услуга.Наименование КАК name,
		|	РасчетыПоЛицевымСчетамОбороты.Услуга.Идентификатор КАК kod,
		|	РасчетыПоЛицевымСчетамОбороты.Услуга.ЕдиницаИзмерения КАК edizm,
		|	РасчетыПоЛицевымСчетамОбороты.ЛицевойСчет.Владелец КАК Здание,
		|	РасчетыПоЛицевымСчетамОбороты.Услуга.ПолеСортировки,
		|	ВЫБОР
		|		КОГДА РасчетыПоЛицевымСчетамОбороты.МесяцНачисления = &ПустаяДата
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ЭтоАванс
		|ПОМЕСТИТЬ втОборотыЛС
		|ИЗ
		|	РегистрНакопления.РасчетыПоЛицевымСчетам.Обороты(
		|			&ДатаНач,
		|			&ДатаКон,
		|			Месяц,
		|			ЛицевойСчет В (&МассивЛС)
		|				И Организация = &Организация) КАК РасчетыПоЛицевымСчетамОбороты
		|
		|СГРУППИРОВАТЬ ПО
		|	РасчетыПоЛицевымСчетамОбороты.ЛицевойСчет,
		|	РасчетыПоЛицевымСчетамОбороты.Услуга,
		|	РасчетыПоЛицевымСчетамОбороты.Услуга.Наименование,
		|	РасчетыПоЛицевымСчетамОбороты.Услуга.Идентификатор,
		|	РасчетыПоЛицевымСчетамОбороты.Услуга.ЕдиницаИзмерения,
		|	РасчетыПоЛицевымСчетамОбороты.ЛицевойСчет.Владелец,
		|	РасчетыПоЛицевымСчетамОбороты.Услуга.ПолеСортировки,
		|	ВЫБОР
		|		КОГДА РасчетыПоЛицевымСчетамОбороты.МесяцНачисления = &ПустаяДата
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТарифыСрезПоследних.Услуга,
		|	ВЫБОР
		|		КОГДА ТарифыСрезПоследних.ВидТарифа = ЗНАЧЕНИЕ(Перечисление.ВидыТарифов.Общий)
		|				ИЛИ ТарифыСрезПоследних.ВидТарифа = ЗНАЧЕНИЕ(Перечисление.ВидыТарифов.Дневной)
		|			ТОГДА ТарифыСрезПоследних.ЗначениеТарифа
		|	КОНЕЦ КАК tarif1,
		|	ТарифыСрезПоследних.НормаПотребления,
		|	ТарифыСрезПоследних.ЗначениеТарифаПоНорме,
		|	ТарифыСрезПоследних.Здание,
		|	ВЫБОР
		|		КОГДА ТарифыСрезПоследних.ВидТарифа = ЗНАЧЕНИЕ(Перечисление.ВидыТарифов.Ночной)
		|			ТОГДА ТарифыСрезПоследних.ЗначениеТарифа
		|	КОНЕЦ КАК tarif2,
		|	ВЫБОР
		|		КОГДА ТарифыСрезПоследних.ВидТарифа = ЗНАЧЕНИЕ(Перечисление.ВидыТарифов.Пиковый)
		|			ТОГДА ТарифыСрезПоследних.ЗначениеТарифа
		|	КОНЕЦ КАК tarif3
		|ПОМЕСТИТЬ втТарифы
		|ИЗ
		|	РегистрСведений.Тарифы.СрезПоследних(&ДатаКон, Организация = &Организация) КАК ТарифыСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	РасчетыПоЛицевымСчетам.ЛицевойСчет,
		|	РасчетыПоЛицевымСчетам.Услуга,
		|	СУММА(ВЫБОР
		|			КОГДА РасчетыПоЛицевымСчетам.ВидНачисления = ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Пени)
		|				ТОГДА РасчетыПоЛицевымСчетам.Сумма
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК peni,
		|	СУММА(ВЫБОР
		|			КОГДА РасчетыПоЛицевымСчетам.ВидНачисления = ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Льгота)
		|					ИЛИ РасчетыПоЛицевымСчетам.ВидНачисления = ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Субсидия)
		|				ТОГДА РасчетыПоЛицевымСчетам.Сумма
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК compensation,
		|	СУММА(ВЫБОР
		|			КОГДА РасчетыПоЛицевымСчетам.ВидНачисления = ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Перерасчет)
		|				ТОГДА РасчетыПоЛицевымСчетам.Сумма
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК correction,
		|	0 КАК norm,
		|	0 КАК ammount,
		|	ВЫБОР
		|		КОГДА РасчетыПоЛицевымСчетам.МесяцНачисления = &ПустаяДата
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ЭтоАванс
		|ПОМЕСТИТЬ втЛьготы
		|ИЗ
		|	РегистрНакопления.РасчетыПоЛицевымСчетам КАК РасчетыПоЛицевымСчетам
		|ГДЕ
		|	РасчетыПоЛицевымСчетам.Период >= &ДатаНач
		|	И РасчетыПоЛицевымСчетам.Период <= &ДатаКон
		|	И РасчетыПоЛицевымСчетам.Организация = &Организация
		|	И РасчетыПоЛицевымСчетам.ЛицевойСчет В(&МассивЛС)
		|
		|СГРУППИРОВАТЬ ПО
		|	РасчетыПоЛицевымСчетам.ЛицевойСчет,
		|	РасчетыПоЛицевымСчетам.Услуга,
		|	ВЫБОР
		|		КОГДА РасчетыПоЛицевымСчетам.МесяцНачисления = &ПустаяДата
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	втОборотыЛС.ЛицевойСчет КАК ЛицевойСчет,
		|	втОборотыЛС.Услуга,
		|	МАКСИМУМ(втОборотыЛС.sum) КАК sum,
		|	МАКСИМУМ(втОборотыЛС.sumpayed) КАК sumpayed,
		|	втОборотыЛС.name,
		|	втОборотыЛС.kod,
		|	втОборотыЛС.edizm,
		|	МАКСИМУМ(втЛьготы.peni) КАК peni,
		|	МАКСИМУМ(втЛьготы.compensation) КАК compensation,
		|	МАКСИМУМ(ЕСТЬNULL(втТарифы.tarif1, 0)) КАК tarif1,
		|	МАКСИМУМ(втЛьготы.correction) КАК correction,
		|	ЛОЖЬ КАК Многотарифная,
		|	МАКСИМУМ(ЕСТЬNULL(втТарифы.tarif2, 0)) КАК tarif2,
		|	МАКСИМУМ(ЕСТЬNULL(втТарифы.tarif3, 0)) КАК tarif3,
		|	СУММА(0) КАК hammount,
		|	СУММА(0) КАК hsum,
		|	СУММА(0) КАК msumtopay,
		|	СУММА(0) КАК hsumtopay,
		|	СУММА(0) КАК debtbeg,
		|	СУММА(0) КАК debtend,
		|	СУММА(0) КАК hnorm,
		|	МАКСИМУМ(втЛьготы.norm) КАК norm,
		|	МАКСИМУМ(втЛьготы.ammount) КАК ammount,
		|	втЛьготы.ЭтоАванс
		|ИЗ
		|	втОборотыЛС КАК втОборотыЛС
		|		ЛЕВОЕ СОЕДИНЕНИЕ втТарифы КАК втТарифы
		|		ПО втОборотыЛС.Услуга = втТарифы.Услуга
		|			И втОборотыЛС.Здание = втТарифы.Здание
		|		ЛЕВОЕ СОЕДИНЕНИЕ втЛьготы КАК втЛьготы
		|		ПО втОборотыЛС.ЛицевойСчет = втЛьготы.ЛицевойСчет
		|			И втОборотыЛС.Услуга = втЛьготы.Услуга
		|			И втОборотыЛС.ЭтоАванс = втЛьготы.ЭтоАванс
		|
		|СГРУППИРОВАТЬ ПО
		|	втЛьготы.ЭтоАванс,
		|	втОборотыЛС.ЛицевойСчет,
		|	втОборотыЛС.Услуга,
		|	втОборотыЛС.edizm,
		|	втОборотыЛС.kod,
		|	втОборотыЛС.name
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЛицевойСчет,
		|	втОборотыЛС.Услуга.ВидУслуги.ПолеСортировки";	
		
		
	Запрос.УстановитьПараметр("ДатаНач",     НачалоМесяца(ДатаОбмена));
	Запрос.УстановитьПараметр("ДатаКон",     КонецДня(ДатаОбмена));
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("МассивЛС",    МассивЛС);
	Запрос.УстановитьПараметр("ПустаяДата",  '00010101');
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции // ПолучитьТаблицуНачислений()

// Формирует таблицу сведений о ИПУ.
// 
// Параметры:
//  МассивЛС - массив л/с
// 
// Возвращаемое значение:
//  ТаблицаЗначений - таблица сведений о ИПУ
//
// Примечание:
//  Данные текущей таблицы значений будут использоваться для формирования файл обмена.
//  Поэтому наличие и наименования колонок таблицы должно быть неизменно.
//  
//  Колонки:
//   ЛицевойСчет - ссылка на лицевой счет
//   service - наименование услуги
//   SName - наименование вида услуги
//   MName - наименование счетчика
//   kod - код счетчика
//   value_count - тарифность счетчика (число)
//   indicbef1 - предыдущие показания счетчика по дневному тарифу
//   indicbef2 - предыдущие показания счетчика по ночному тарифу
//   indicbef3 - предыдущие показания счетчика по пиковому тарифу
//   indiccur1 - текущие показания счетчика по дневному тарифу
//   indiccur2 - текущие показания счетчика по ночному тарифу
//   indiccur3 - текущие показания счетчика по пиковому тарифу
//   date_indicbef - дата предыдущих показаний счетчика
//   date_indiccur - дата текущих показаний счетчика
//
Функция ПолучитьСведенияОбИПУ(МассивЛС, ДатаОбмена)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ЛицевыеСчета.Ссылка КАК ЛицевойСчет
		|ПОМЕСТИТЬ втЛицевыеСчета
		|ИЗ
		|	Справочник.ЛицевыеСчета КАК ЛицевыеСчета
		|ГДЕ
		|	ЛицевыеСчета.Ссылка В(&МассивЛС)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	втЛицевыеСчета.ЛицевойСчет,
		|	УстановленныеПриборыУчетаСрезПоследних.ПриборУчета.Услуга КАК Услуга,
		|	УстановленныеПриборыУчетаСрезПоследних.ПриборУчета КАК Счетчик
		|ПОМЕСТИТЬ втСчетчики
		|ИЗ
		|	втЛицевыеСчета КАК втЛицевыеСчета
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УстановленныеПриборыУчета.СрезПоследних(&ДатаНач, ) КАК УстановленныеПриборыУчетаСрезПоследних
		|		ПО втЛицевыеСчета.ЛицевойСчет = УстановленныеПриборыУчетаСрезПоследних.ОбъектУстановки
		|ГДЕ
		|	УстановленныеПриборыУчетаСрезПоследних.Действует
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	втЛицевыеСчета.ЛицевойСчет,
		|	УстановленныеПриборыУчета.ПриборУчета.Услуга,
		|	УстановленныеПриборыУчета.ПриборУчета
		|ИЗ
		|	втЛицевыеСчета КАК втЛицевыеСчета
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УстановленныеПриборыУчета КАК УстановленныеПриборыУчета
		|		ПО втЛицевыеСчета.ЛицевойСчет = УстановленныеПриборыУчета.ОбъектУстановки
		|ГДЕ
		|	УстановленныеПриборыУчета.Действует
		|	И УстановленныеПриборыУчета.Период МЕЖДУ &ДатаНач И &ДатаКон
		|	И УстановленныеПриборыУчета.ОбъектУстановки = втЛицевыеСчета.ЛицевойСчет
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	втСчетчики.ЛицевойСчет,
		|	втСчетчики.Услуга,
		|	втСчетчики.Счетчик,
		|	ВЫБОР
		|		КОГДА ПоказанияСчетчиков.ВидТарифа = ЗНАЧЕНИЕ(Перечисление.ВидыТарифов.Общий)
		|				ИЛИ ПоказанияСчетчиков.ВидТарифа = ЗНАЧЕНИЕ(Перечисление.ВидыТарифов.Дневной)
		|			ТОГДА ЕСТЬNULL(ПоказанияСчетчиков.Значение, 0)
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ДневноеПоказание,
		|	ПоказанияСчетчиков.Период,
		|	ВЫБОР
		|		КОГДА ПоказанияСчетчиков.ВидТарифа = ЗНАЧЕНИЕ(Перечисление.ВидыТарифов.Ночной)
		|			ТОГДА ЕСТЬNULL(ПоказанияСчетчиков.Значение, 0)
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК НочноеПоказание,
		|	ВЫБОР
		|		КОГДА ПоказанияСчетчиков.ВидТарифа = ЗНАЧЕНИЕ(Перечисление.ВидыТарифов.Пиковый)
		|			ТОГДА ЕСТЬNULL(ПоказанияСчетчиков.Значение, 0)
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ПиковоеПоказание
		|ПОМЕСТИТЬ втВсеПоказания
		|ИЗ
		|	втСчетчики КАК втСчетчики
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПоказанияПриборовУчета КАК ПоказанияСчетчиков
		|		ПО втСчетчики.Счетчик = ПоказанияСчетчиков.ПриборУчета
		|ГДЕ
		|	ПоказанияСчетчиков.Период МЕЖДУ &ДатаНач И &ДатаКон
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	втВсеПоказания.ЛицевойСчет,
		|	втВсеПоказания.Услуга,
		|	втВсеПоказания.Счетчик,
		|	МАКСИМУМ(втВсеПоказания.Период) КАК Период
		|ПОМЕСТИТЬ втПериодыПоследнихПоказаний
		|ИЗ
		|	втВсеПоказания КАК втВсеПоказания
		|
		|СГРУППИРОВАТЬ ПО
		|	втВсеПоказания.ЛицевойСчет,
		|	втВсеПоказания.Услуга,
		|	втВсеПоказания.Счетчик
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	втПериодыПоследнихПоказаний.ЛицевойСчет,
		|	втПериодыПоследнихПоказаний.Услуга,
		|	втПериодыПоследнихПоказаний.Счетчик,
		|	втВсеПоказания.ДневноеПоказание,
		|	втПериодыПоследнихПоказаний.Период,
		|	втВсеПоказания.НочноеПоказание,
		|	втВсеПоказания.ПиковоеПоказание
		|ПОМЕСТИТЬ втТекущиеПоказания
		|ИЗ
		|	втПериодыПоследнихПоказаний КАК втПериодыПоследнихПоказаний
		|		ЛЕВОЕ СОЕДИНЕНИЕ втВсеПоказания КАК втВсеПоказания
		|		ПО втПериодыПоследнихПоказаний.ЛицевойСчет = втВсеПоказания.ЛицевойСчет
		|			И втПериодыПоследнихПоказаний.Услуга = втВсеПоказания.Услуга
		|			И втПериодыПоследнихПоказаний.Счетчик = втВсеПоказания.Счетчик
		|			И втПериодыПоследнихПоказаний.Период = втВсеПоказания.Период
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	втСчетчики.ЛицевойСчет,
		|	втСчетчики.Услуга,
		|	втСчетчики.Счетчик,
		|	ВЫБОР
		|		КОГДА ПоказанияСчетчиков.ВидТарифа = ЗНАЧЕНИЕ(Перечисление.ВидыТарифов.Общий)
		|				ИЛИ ПоказанияСчетчиков.ВидТарифа = ЗНАЧЕНИЕ(Перечисление.ВидыТарифов.Дневной)
		|			ТОГДА ЕСТЬNULL(ПоказанияСчетчиков.Значение, 0)
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ДневноеПоказание,
		|	ПоказанияСчетчиков.Период,
		|	ВЫБОР
		|		КОГДА ПоказанияСчетчиков.ВидТарифа = ЗНАЧЕНИЕ(Перечисление.ВидыТарифов.Ночной)
		|			ТОГДА ЕСТЬNULL(ПоказанияСчетчиков.Значение, 0)
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК НочноеПоказание,
		|	ВЫБОР
		|		КОГДА ПоказанияСчетчиков.ВидТарифа = ЗНАЧЕНИЕ(Перечисление.ВидыТарифов.Пиковый)
		|			ТОГДА ЕСТЬNULL(ПоказанияСчетчиков.Значение, 0)
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ПиковоеПоказание
		|ПОМЕСТИТЬ втПредПоказания
		|ИЗ
		|	втСчетчики КАК втСчетчики
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПоказанияПриборовУчета.СрезПоследних(&ДатаНач, ) КАК ПоказанияСчетчиков
		|		ПО втСчетчики.Счетчик = ПоказанияСчетчиков.ПриборУчета
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	втСчетчики.ЛицевойСчет КАК ЛицевойСчет,
		|	втСчетчики.Услуга.Наименование КАК service,
		|	втСчетчики.Счетчик.Наименование КАК MName,
		|	ВЫБОР
		|		КОГДА втСчетчики.Счетчик.Тарифность = ЗНАЧЕНИЕ(Перечисление.ТарифностьСчетчиков.Однотарифный)
		|			ТОГДА 1
		|		КОГДА втСчетчики.Счетчик.Тарифность = ЗНАЧЕНИЕ(Перечисление.ТарифностьСчетчиков.Двухтарифный)
		|			ТОГДА 2
		|		ИНАЧЕ 3
		|	КОНЕЦ КАК value_count,
		|	СУММА(ЕСТЬNULL(втПредПоказания.ДневноеПоказание, 0)) КАК indicbef1,
		|	СУММА(ЕСТЬNULL(втПредПоказания.НочноеПоказание, 0)) КАК indicbef2,
		|	СУММА(ЕСТЬNULL(втПредПоказания.ПиковоеПоказание, 0)) КАК indicbef3,
		|	СУММА(ЕСТЬNULL(втТекущиеПоказания.ДневноеПоказание, ЕСТЬNULL(втПредПоказания.ДневноеПоказание, 0))) КАК indiccur1,
		|	СУММА(ЕСТЬNULL(втТекущиеПоказания.НочноеПоказание, ЕСТЬNULL(втПредПоказания.НочноеПоказание, 0))) КАК indiccur2,
		|	СУММА(ЕСТЬNULL(втТекущиеПоказания.ПиковоеПоказание, ЕСТЬNULL(втПредПоказания.ПиковоеПоказание, 0))) КАК indiccur3,
		|	ЕСТЬNULL(втПредПоказания.Период, &ПустаяДата) КАК date_indicbef,
		|	ЕСТЬNULL(втТекущиеПоказания.Период, втПредПоказания.Период) КАК date_indiccur,
		|	втСчетчики.Счетчик.Код КАК kod
		|ИЗ
		|	втСчетчики КАК втСчетчики
		|		ЛЕВОЕ СОЕДИНЕНИЕ втПредПоказания КАК втПредПоказания
		|		ПО втСчетчики.ЛицевойСчет = втПредПоказания.ЛицевойСчет
		|			И втСчетчики.Услуга = втПредПоказания.Услуга
		|			И втСчетчики.Счетчик = втПредПоказания.Счетчик
		|		ЛЕВОЕ СОЕДИНЕНИЕ втТекущиеПоказания КАК втТекущиеПоказания
		|		ПО втСчетчики.ЛицевойСчет = втТекущиеПоказания.ЛицевойСчет
		|			И втСчетчики.Услуга = втТекущиеПоказания.Услуга
		|			И втСчетчики.Счетчик = втТекущиеПоказания.Счетчик
		|
		|СГРУППИРОВАТЬ ПО
		|	втСчетчики.Услуга.Наименование,
		|	втСчетчики.ЛицевойСчет,
		|	втСчетчики.Счетчик.Наименование,
		|	ЕСТЬNULL(втПредПоказания.Период, &ПустаяДата),
		|	втСчетчики.Счетчик.Код,
		|	ЕСТЬNULL(втТекущиеПоказания.Период, втПредПоказания.Период),
		|	ВЫБОР
		|		КОГДА втСчетчики.Счетчик.Тарифность = ЗНАЧЕНИЕ(Перечисление.ТарифностьСчетчиков.Однотарифный)
		|			ТОГДА 1
		|		КОГДА втСчетчики.Счетчик.Тарифность = ЗНАЧЕНИЕ(Перечисление.ТарифностьСчетчиков.Двухтарифный)
		|			ТОГДА 2
		|		ИНАЧЕ 3
		|	КОНЕЦ
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЛицевойСчет";
		
	Запрос.УстановитьПараметр("ДатаНач",  НачалоМесяца(ДатаОбмена));
	Запрос.УстановитьПараметр("ДатаКон",  КонецДня(ДатаОбмена));
	Запрос.УстановитьПараметр("МассивЛС", МассивЛС);
	Запрос.УстановитьПараметр("ПустаяДата", '00010101');
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции // ПолучитьСведенияОбИПУ()

// Формирует таблицу сведений о лицевых счетах.
// 
// Параметры:
//  МассивЛС - массив л/с
//  ТаблицаНачислений - таблица значений с данными о начислениях
//  ВыгружатьЛогины - булево, указывает, нужно ли выгружать логины л/с
// 
// Возвращаемое значение:
//  ТаблицаЗначений - таблица лицевых счетов
//
// Примечание:
//  Данные текущей таблицы значений будут использоваться для формирования файл обмена.
//  Поэтому наличие и наименования колонок таблицы должно быть неизменно.
//  
//  Колонки:
//   ЛицевойСчет - ссылка на лицевой счет
//   Здание - ссылка на здание
//   AddressCity - город, к которому относится лицевой счет
//   AddressDistrict - район, к которому относится лицевой счет
//   AddressFlat - номер помещения лицевого счета
//   FlatAbbr - представление помещения лицевого счета (напр, "кв.1", "оф.2")
//   AddressHouse - номер здания лицевого счета
//   AddressRegion - регион, к которому относится лицевой счет
//   AddressSettlement - населенный пункт, к которому относится лицевой счет
//   AddressStreet - улица лицевого счета
//   commonarea - размер общей площади помещения лицевого счета
//   debtbeg - начальное сальдо по лицевому счету
//   debtend - конечное сальдо по лицевому счету
//   debtprev - задолженность (положительное сальдо) лицевого счета на начало месяца
//   prepayment - аванс (абсолютное значение отрицательного сальдо) лицевого счета на начало месяца
//   sumtopay - итоговая сумма к оплате по лицевому счету
//   lastPaymentDate - дата последней оплаты, поступившей от лицевого счета
//   email - электронный адрес лицевого счета
//   habarea - размер жилой площади помещения лицевого счета
//   kod_ls - идентификатор лицевого счета
//   name1 - ФИО ответственного собственника, нанимателя по лицевоум счету
//   name_ls - наименование лицевого счета
//   people - количество проживающих по лицевому счету
//   num_of_reg - количество зарегистрированных по лицевому счету
//   Корпус - корпус здания лицевого счета
//
Функция ПолучитьСведенияОЛицевыхСчетах(МассивЛС, ТаблицаНачислений = Неопределено, ВыгружатьЛогины = Ложь, ДатаОбмена)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ЛицевыеСчета.Владелец КАК Здание
		|ИЗ
		|	Справочник.ЛицевыеСчета КАК ЛицевыеСчета
		|ГДЕ
		|	ЛицевыеСчета.Ссылка В(&МассивЛС)
		|
		|СГРУППИРОВАТЬ ПО
		|	ЛицевыеСчета.Владелец";	
		
	Запрос.УстановитьПараметр("МассивЛС",          МассивЛС);
	ТаблицаЗданий = Запрос.Выполнить().Выгрузить();	
	ТаблицаЗданий.Колонки.Добавить("AddressCity", Новый ОписаниеТипов("Строка"));
	ТаблицаЗданий.Колонки.Добавить("AddressDistrict", Новый ОписаниеТипов("Строка"));
	ТаблицаЗданий.Колонки.Добавить("AddressHouse", Новый ОписаниеТипов("Строка"));
	ТаблицаЗданий.Колонки.Добавить("AddressRegion", Новый ОписаниеТипов("Строка"));
	ТаблицаЗданий.Колонки.Добавить("AddressStreet", Новый ОписаниеТипов("Строка"));
	ТаблицаЗданий.Колонки.Добавить("Корпус", Новый ОписаниеТипов("Строка"));
	
	
	Для Каждого СтрокаЗдания Из ТаблицаЗданий Цикл
		
		КонтактнаяИнформация = СтрокаЗдания.Здание.КонтактнаяИнформация.Выгрузить(Новый Структура("Тип", Перечисления.ТипыКонтактнойИнформации.Адрес));
		
		Если КонтактнаяИнформация.Количество() > 0 Тогда
			СписокПолей = УправлениеКонтактнойИнформацией.ПреобразоватьСтрокуВСписокПолей(КонтактнаяИнформация[0].ЗначенияПолей);
			
			Для а=0 По СписокПолей.Количество() - 1 Цикл
				Если СписокПолей[а].Представление = "Город" Тогда
					СтрокаЗдания.AddressCity = СписокПолей[а].Значение;	
				ИначеЕсли СписокПолей[а].Представление = "Район" Тогда
					СтрокаЗдания.AddressDistrict = СписокПолей[а].Значение;	
				ИначеЕсли СписокПолей[а].Представление = "Улица" Тогда
					СтрокаЗдания.AddressStreet = СписокПолей[а].Значение;	
				ИначеЕсли СписокПолей[а].Представление = "Дом" Тогда
					СтрокаЗдания.AddressHouse = СписокПолей[а].Значение;	
				ИначеЕсли СписокПолей[а].Представление = "Корпус" Тогда
					СтрокаЗдания.Корпус = СписокПолей[а].Значение;	
				ИначеЕсли СписокПолей[а].Представление = "Регион" Тогда
					СтрокаЗдания.AddressRegion = СписокПолей[а].Значение;	
				КонецЕсли;
			КонецЦикла;
			
		Иначе
			Продолжить;
		КонецЕсли;
		
	КонецЦикла;
	
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ЛицевыеСчетаСрезПоследних.КоличествоПрописанных,
		|	ЛицевыеСчетаСрезПоследних.КоличествоПроживающих,
		|	ЛицевыеСчетаСрезПоследних.ЛицевойСчет.ОбъектЛицевогоСчета КАК Помещение,
		|	ЛицевыеСчетаСрезПоследних.ЛицевойСчет.Идентификатор КАК ИдентификаторЛС,
		|	ЛицевыеСчетаСрезПоследних.ЛицевойСчет.ЛогинДоступа,
		|	ЛицевыеСчетаСрезПоследних.ЛицевойСчет.ЭлПочта,
		|	ЛицевыеСчетаСрезПоследних.ЛицевойСчет.Владелец КАК Здание,
		|	ЛицевыеСчетаСрезПоследних.ЛицевойСчет,
		|	ЛицевыеСчетаСрезПоследних.ЛицевойСчет.Наименование
		|ПОМЕСТИТЬ втЛицевойСчетБазовая
		|ИЗ
		|	РегистрСведений.ЛицевыеСчета.СрезПоследних(&ДатаКон, ЛицевойСчет В (&МассивЛС)) КАК ЛицевыеСчетаСрезПоследних
		|ГДЕ
		|	ЛицевыеСчетаСрезПоследних.Действует
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТаблицаЗданий.Здание,
		|	ТаблицаЗданий.AddressCity,
		|	ТаблицаЗданий.AddressDistrict,
		|	ТаблицаЗданий.AddressHouse,
		|	ТаблицаЗданий.AddressRegion,
		|	ТаблицаЗданий.AddressStreet,
		|	ТаблицаЗданий.Корпус
		|ПОМЕСТИТЬ втТаблицаЗданий
		|ИЗ
		|	&ТаблицаЗданий КАК ТаблицаЗданий
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПлощадьОбъектовЛицевыхСчетовСрезПоследних.Помещение,
		|	СУММА(ВЫБОР
		|			КОГДА ПлощадьОбъектовЛицевыхСчетовСрезПоследних.ВидПлощади = ЗНАЧЕНИЕ(Справочник.ВидыПлощадей.ОбщаяПлощадь)
		|				ТОГДА ПлощадьОбъектовЛицевыхСчетовСрезПоследних.Площадь
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК ОбщаяПлощадь,
		|	СУММА(ВЫБОР
		|			КОГДА ПлощадьОбъектовЛицевыхСчетовСрезПоследних.ВидПлощади = ЗНАЧЕНИЕ(Справочник.ВидыПлощадей.ЖилаяПолощадь)
		|				ТОГДА ПлощадьОбъектовЛицевыхСчетовСрезПоследних.Площадь
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК ЖилаяПлощадь,
		|	ПлощадьОбъектовЛицевыхСчетовСрезПоследних.Помещение.Код КАК НомерКвартиры,
		|	ПлощадьОбъектовЛицевыхСчетовСрезПоследних.Помещение.Суффикс КАК Суффикс,
		|	ВЫБОР
		|		КОГДА ПлощадьОбъектовЛицевыхСчетовСрезПоследних.Помещение.ЖилойФонд = ЗНАЧЕНИЕ(Перечисление.ЖилойНеЖилойФонд.Жилой)
		|			ТОГДА """"
		|		ИНАЧЕ ""оф.""
		|	КОНЕЦ КАК FlatAbbr
		|ПОМЕСТИТЬ втПлощадиПомещений
		|ИЗ
		|	РегистрСведений.ПлощадьОбъектовЛицевыхСчетов.СрезПоследних(&ДатаКон, ) КАК ПлощадьОбъектовЛицевыхСчетовСрезПоследних
		|
		|СГРУППИРОВАТЬ ПО
		|	ПлощадьОбъектовЛицевыхСчетовСрезПоследних.Помещение,
		|	ПлощадьОбъектовЛицевыхСчетовСрезПоследних.Помещение.Код,
		|	ПлощадьОбъектовЛицевыхСчетовСрезПоследних.Помещение.Суффикс,
		|	ВЫБОР
		|		КОГДА ПлощадьОбъектовЛицевыхСчетовСрезПоследних.Помещение.ЖилойФонд = ЗНАЧЕНИЕ(Перечисление.ЖилойНеЖилойФонд.Жилой)
		|			ТОГДА """"
		|		ИНАЧЕ ""оф.""
		|	КОНЕЦ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	РасчетыПоЛицевымСчетамОстаткиИОбороты.ЛицевойСчет,
		|	СУММА(РасчетыПоЛицевымСчетамОстаткиИОбороты.СуммаНачальныйОстаток) КАК СуммаНачальныйОстаток,
		|	СУММА(РасчетыПоЛицевымСчетамОстаткиИОбороты.СуммаКонечныйОстаток) КАК СуммаКонечныйОстаток,
		|	СУММА(РасчетыПоЛицевымСчетамОстаткиИОбороты.СуммаПриход) КАК СуммаПриход
		|ПОМЕСТИТЬ втОстаткиЛС
		|ИЗ
		|	РегистрНакопления.РасчетыПоЛицевымСчетам.ОстаткиИОбороты(&ДатаНач, &ДатаКон, Месяц, , ЛицевойСчет В (&МассивЛС)) КАК РасчетыПоЛицевымСчетамОстаткиИОбороты
		|
		|СГРУППИРОВАТЬ ПО
		|	РасчетыПоЛицевымСчетамОстаткиИОбороты.ЛицевойСчет
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ЛицевойСчет,
		|	ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ОтветственныйВладелец.Наименование
		|ПОМЕСТИТЬ втОтветственныйВладелец
		|ИЗ
		|	РегистрСведений.ОтветственныйВладелецЛицевогоСчета.СрезПоследних(&ДатаКон, ЛицевойСчет В (&МассивЛС)) КАК ОтветственныйВладелецЛицевогоСчетаСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	МАКСИМУМ(РасчетыПоЛицевымСчетам.Период) КАК ДатаПоследенейОплаты,
		|	РасчетыПоЛицевымСчетам.ЛицевойСчет
		|ПОМЕСТИТЬ втДатаПоследнейОплаты
		|ИЗ
		|	РегистрНакопления.РасчетыПоЛицевымСчетам КАК РасчетыПоЛицевымСчетам
		|ГДЕ
		|	РасчетыПоЛицевымСчетам.Период >= &ДатаНач
		|	И РасчетыПоЛицевымСчетам.Период <= &ДатаКон
		|	И РасчетыПоЛицевымСчетам.ЛицевойСчет В(&МассивЛС)
		|	И РасчетыПоЛицевымСчетам.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		|
		|СГРУППИРОВАТЬ ПО
		|	РасчетыПоЛицевымСчетам.ЛицевойСчет
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	втЛицевойСчетБазовая.ЛицевойСчет,
		|	втЛицевойСчетБазовая.Здание,
		|	втТаблицаЗданий.AddressCity,
		|	втТаблицаЗданий.AddressDistrict,
		|	втПлощадиПомещений.НомерКвартиры КАК AddressFlat,
		|	втПлощадиПомещений.Суффикс КАК СуффиксКвартиры,
		|	втПлощадиПомещений.FlatAbbr,
		|	втТаблицаЗданий.AddressHouse,
		|	втТаблицаЗданий.AddressRegion,
		|	втТаблицаЗданий.AddressStreet,
		|	втЛицевойСчетБазовая.КоличествоПрописанных КАК people,
		|	втЛицевойСчетБазовая.КоличествоПроживающих КАК num_of_reg,
		|	втЛицевойСчетБазовая.ИдентификаторЛС КАК kod_ls,
		|	втЛицевойСчетБазовая.ЛицевойСчетНаименование КАК name_ls,
		|	втЛицевойСчетБазовая.ЛицевойСчетЛогинДоступа КАК login,
		|	втЛицевойСчетБазовая.ЛицевойСчетЭлПочта КАК email,
		|	втОстаткиЛС.СуммаНачальныйОстаток КАК debtbeg,
		|	втОстаткиЛС.СуммаКонечныйОстаток КАК debtend,
		|	втОтветственныйВладелец.ОтветственныйВладелецНаименование КАК name1,
		|	втПлощадиПомещений.ОбщаяПлощадь КАК commonarea,
		|	втПлощадиПомещений.ЖилаяПлощадь КАК habarea,
		|	втТаблицаЗданий.Корпус,
		|	0 КАК debtprev,
		|	0 КАК prepayment,
		|	"""" КАК AddressSettlement,
		|	втДатаПоследнейОплаты.ДатаПоследенейОплаты КАК lastPaymentDate,
		|	втОстаткиЛС.СуммаПриход КАК sumtopay
		|ИЗ
		|	втЛицевойСчетБазовая КАК втЛицевойСчетБазовая
		|		ЛЕВОЕ СОЕДИНЕНИЕ втТаблицаЗданий КАК втТаблицаЗданий
		|		ПО втЛицевойСчетБазовая.Здание = втТаблицаЗданий.Здание
		|		ЛЕВОЕ СОЕДИНЕНИЕ втПлощадиПомещений КАК втПлощадиПомещений
		|		ПО втЛицевойСчетБазовая.Помещение = втПлощадиПомещений.Помещение
		|		ЛЕВОЕ СОЕДИНЕНИЕ втОстаткиЛС КАК втОстаткиЛС
		|		ПО втЛицевойСчетБазовая.ЛицевойСчет = втОстаткиЛС.ЛицевойСчет
		|		ЛЕВОЕ СОЕДИНЕНИЕ втОтветственныйВладелец КАК втОтветственныйВладелец
		|		ПО втЛицевойСчетБазовая.ЛицевойСчет = втОтветственныйВладелец.ЛицевойСчет
		|		ЛЕВОЕ СОЕДИНЕНИЕ втДатаПоследнейОплаты КАК втДатаПоследнейОплаты
		|		ПО втЛицевойСчетБазовая.ЛицевойСчет = втДатаПоследнейОплаты.ЛицевойСчет";	
		
		
	Запрос.УстановитьПараметр("ДатаНач",           НачалоМесяца(ДатаОбмена));
	Запрос.УстановитьПараметр("ДатаКон",           КонецМесяца(ДатаОбмена));
	Запрос.УстановитьПараметр("МассивЛС",          МассивЛС);
	Запрос.УстановитьПараметр("ВыгружатьЛогины",   ВыгружатьЛогины);
	Запрос.УстановитьПараметр("ТаблицаЗданий",   ТаблицаЗданий);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции // ПолучитьСведенияОЛицевыхСчетах()

// Формирует текст штрих-кода для вывода в квитанцию.
//
// Параметры
//  Объект       – текущий лицевой счет
//  Организация - выбранная организация
//  СуммаОплаты – сумма к оплате
//
// Возвращаемое значение:
//  Строка – текст штрих-кода
//
Функция ПолучитьШтрихКод(Объект, Организация, СуммаОплаты)
	
	ТекстКода = "";
	
	Возврат ТекстКода;
	
КонецФункции // ПолучитьШтрихКод()

// Формирует таблицу со сведениями по лицевым счетам.
//
// Параметры:
//  МассивЛС - Массив - массив с лицевыми счетами
//
// Возвращаемое значение:
//  ТаблицаЗначений
//
// Примечание:
//  Данные текущей таблицы значений будут использоваться для формирования файл обмена.
//  Поэтому наличие и наименования колонок таблицы должно быть неизменно.
//  
//  Колонки:
//   ЛицевойСчет - ссылка на лицевой счет
//   Владелец - ссылка на  ответственного собственника, нанимателя по лицевому счету
//   Район - район, к которому относится лицевой счет
//   Улица - улица лицевого счета
//   Дом - номер здания лицевого счета
//   Корпус - корпус здания лицевого счета
//   Помещение - наименование помещения лицевого счета (напр., "кв.1", "оф.1")
//   Логин - логин доступа лицевого счета к аккаунту на сайте
//   Пароль - пустая строка
//   Карточка распечата - Ложь
//
Функция ПолучитьДанныеПоЛС(МассивЛС, ДатаОбмена = Неопределено) Экспорт
	
	Если ДатаОбмена = Неопределено Тогда
		ДатаОбмена = ТекущаяДата();	
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ЛицевойСчет КАК ЛицевойСчет,
		|	ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ОтветственныйВладелец КАК Владелец,
		|	ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ЛицевойСчет.Владелец.Наименование КАК Адрес,
		|	ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ЛицевойСчет.ЛогинДоступа КАК Логин,
		|	ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ЛицевойСчет.ОбъектЛицевогоСчета.Наименование КАК Квартира,
		|	ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ЛицевойСчет.Владелец КАК Здание
		|ИЗ
		|	РегистрСведений.ОтветственныйВладелецЛицевогоСчета.СрезПоследних(&Дата, ЛицевойСчет В (&МассивЛС)) КАК ОтветственныйВладелецЛицевогоСчетаСрезПоследних
		|
		|УПОРЯДОЧИТЬ ПО
		|	Здание,
		|	Квартира";
		
	Запрос.УстановитьПараметр("МассивЛС", МассивЛС);
	Запрос.УстановитьПараметр("Дата",     ДатаОбмена);
	
	Таблица = Запрос.Выполнить().Выгрузить();
	
	Для Каждого Строка ИЗ Таблица Цикл
		
		Строка.Адрес = Строка.Адрес + " " + Строка.Квартира;
			
	КонецЦикла;
	
	Возврат Таблица;
	
КонецФункции // ПолучитьДанныеПоЛС()

// Ищет в БД лицевые счета, которые не имеют параметры доступа на сайт.
// (факты наличия параметров доступа фиксируются в РС "Сведения о наличии параметров доступа")
//
// Возвращаемое значение:
//  ТаблицаЗначений
//
// Примечание:
//  Данные текущей таблицы будут загружены в табличну часть формы "Работа с лицевыми счетами".
//  Поэтому наличие и наименования колонок таблицы должно быть неизменно.
//
//  Колонки:
//   ЛицевойСчет - ссылка на лицевой счет
//   Владелец - ссылка на ответственного собственника, нанимателя по лицевому счету
//   Адрес - представление адреса лицевого счета
//   Логин - логин доступа лицевого счета к аккаунту на сайте
//   Пароль - пустая строка
//   Карточка распечата - Ложь
//
Функция ПолучитьЛСНеИмеющиеПараметровДоступа() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СведенияОНаличииПараметровДоступа.ЛицевойСчет
	|ПОМЕСТИТЬ втЛССПараметрами
	|ИЗ
	|	РегистрСведений.СведенияОНаличииПараметровДоступа КАК СведенияОНаличииПараметровДоступа
	|ГДЕ
	|	СведенияОНаличииПараметровДоступа.НаличиеПараметров
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЛицевыеСчетаСрезПоследних.ЛицевойСчет КАК ЛицевойСчет
	|ИЗ
	|	РегистрСведений.ЛицевыеСчета.СрезПоследних() КАК ЛицевыеСчетаСрезПоследних
	|ГДЕ
	|	ЛицевыеСчетаСрезПоследних.Действует
	|	И НЕ ЛицевыеСчетаСрезПоследних.ЛицевойСчет В
	|				(ВЫБРАТЬ
	|					втЛССПараметрами.ЛицевойСчет
	|				ИЗ
	|					втЛССПараметрами КАК втЛССПараметрами)";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		МассивЛС = Новый Массив;
	Иначе
		МассивЛС = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("ЛицевойСчет");
	КонецЕсли;
	
	Возврат ПолучитьДанныеПоЛС(МассивЛС);
	
КонецФункции // ПолучитьЛСНеИмеющиеПараметровДоступа()

// Определяет, когда была совершена последняя удачная загрузка реестра платежей.
//
// Параметры:
//  НастройкаДоступа - СправочникСсылка.НастройкиДоступаКСайту - настройка доступа
//
// Вовзращаемое значение:
//  Дата
//
Функция ПолучитьДатуПоследнейЗагрузкиРестраПлатежей(НастройкаДоступа)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	МАКСИМУМ(ЖурналОбменаССайтом.Дата) КАК Дата
	|ИЗ
	|	РегистрСведений.ЖурналОбменаССайтом КАК ЖурналОбменаССайтом
	|ГДЕ
	|	ЖурналОбменаССайтом.НастройкаДоступа = &НастройкаДоступа
	|	И ЖурналОбменаССайтом.ВидОбмена = ЗНАЧЕНИЕ(Перечисление.ВидыОбменаССайтом.ЗагрузкаРеестраПлатежей)";
	Запрос.УстановитьПараметр("НастройкаДоступа", НастройкаДоступа);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Дата;
	КонецЕсли;
	
	Возврат Дата('00010101');
	
КонецФункции // ПолучитьДатуПоследнейЗагрузкиРестраПлатежей()

////////////////////////////////////////////////////////////////////////////////
// ЗАГРУЗКА ДАННЫХ ИЗ XML

// Загружает данные из XML-файла в структуру.
//
// Параметры
//  ИмяФайлаXML – наименование загружаемого файла.
//  НастройкиОбмена - ссылка на элемент справочника "Настройки обмена данными с сайтом".
//  СведенияОбОшибке - Строка - описание проблем при обмене
//
// Возвращаемое значение:
//  Структура – структура, содержащая загруженные из файла данные.
//
//
// Детальное описание функции:
//
// При загрузке данных из XML файла формируется структура, содержащая выгружаемые из файла данные.
// В зависимости от варианта загрузки (значения атрибута "filetype" узла "ORG") могут быть
// сформированы структуры, содержащие следующие поля:
//
// 1) Для варианта "access" (параметры доступа):
//
// filetype // "access"
// inn      // ИНН организации.
// \PersAcc   // Таблица значений. Хранит соответствие л/с и логинов.
//     kod_ls // Код л/с (Идентификатор).
//     login  // Новый логин л/с.
//     email  // Электронный ящик л/с. Необязательный атрибут.
//
// 2) Для варианта "meters" (реестр показаний ИПУ):
//
// filetype // "meters"
// name     // Наименование организации.
// inn      // ИНН организации.
// filedate // Дата формирования файла.
// \meters       // Таблица значений. Хранит показания ИПУ в разрезе л/с.
//     kod_ls    // Код л/с (Идентификатор).
//     indicbef1 // Предыдущее дневное показание.
//     indicbef2 // Предыдущее ночное показание.
//     indiccur1 // Текущее дневное показание.
//     indiccur2 // Текущее ночное показание.
//     kod       // Код ПУ.
//     name      // Наименование ПУ.
//     date      // Дата текущих показаний.
//
// 3) Для варианта "monetapayments" (реестр платежей):
//
// filetype // "monetapayments"
// inn      // ИНН организации.
// filedate // Дата формирования файла.
// \payments     // Таблица значений. Хранит оплаты в разрезе л/с.
//     kod_ls    // Код л/с (Идентификатор).
//     date      // Дата оплаты.
//     summ      // Сумма оплаты.
//
Функция ПолучитьДанныеИзXML(ИмяФайлаXML, НастройкаДоступа, СведенияОбОшибке,ВидШаблона = Неопределено)
	
	// Структура для выгрузки
	СтруктураДанных = Новый Структура;
	
	Попытка
		// Открытие и считывание данных из файла
		Файл = Новый ЧтениеXML;
		Файл.ОткрытьФайл(ИмяФайлаXML);
		
		Построитель = Новый ПостроительDOM;
		ДокDOM = Построитель.Прочитать(Файл);
		
		Файл.Закрыть();
	Исключение
		// Ошибка при открытии.
		СведенияОбОшибке = ОписаниеОшибки();
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СведенияОбОшибке);
		
		Возврат Неопределено;
	КонецПопытки;
	
	Попытка
		
		// Префикс, добавляемый к л/с.
		ПрефиксЛС           = ПолучитьПрефикс(НастройкаДоступа.Организация);
		ДлинаПрефикса       = СтрДлина(ПрефиксЛС);
		ИспользуетсяПрефикс = НЕ ДлинаПрефикса = 0;
		
		// Узел ORG
		УзелОрганизация = ДокDOM.ПервыйДочерний;
		
		Если ВидШаблона = Перечисления.ВариантыСайта.ВДГБ Тогда
			ВерсияСайт = УзелОрганизация.Атрибуты.ПолучитьИменованныйЭлемент("version").Значение;
			ВерсияПП   = ПолучитьТекущуюВерсиюМеханизмаИнтеграции();
		
			Если ВерсияСайт <> ВерсияПП Тогда
				СообщенияОбОшибке = НСтр("ru='Версия механизма обмена в учетной программе устарела. Необходимо обновиться.';uk='Версія механізму обміну в обліковій програмі застаріла. Необхідно оновитися.'");
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СообщенияОбОшибке);
				Возврат Неопределено;
				
			КонецЕсли;
		КонецЕсли;
		// Тип файла
		ТипФайла = НРег(УзелОрганизация.Атрибуты.ПолучитьИменованныйЭлемент("filetype").Значение);
		
		// Формирование структуры данных
		Если ТипФайла = "meters" Тогда
			
			СтруктураДанных.Вставить("name",     УзелОрганизация.Атрибуты.ПолучитьИменованныйЭлемент("name").Значение);
			СтруктураДанных.Вставить("inn",      УзелОрганизация.Атрибуты.ПолучитьИменованныйЭлемент("inn").Значение);
			СтруктураДанных.Вставить("filedate", УзелОрганизация.Атрибуты.ПолучитьИменованныйЭлемент("filedate").Значение);
			СтруктураДанных.Вставить("filetype", ТипФайла);
			
			// Таблица л/с
			СтруктураДанных.Вставить("meters", Новый ТаблицаЗначений);
			СтруктураДанных.meters.Колонки.Добавить("kod_ls",    Новый ОписаниеТипов("Строка"));
			СтруктураДанных.meters.Колонки.Добавить("indicbef1", Новый ОписаниеТипов("Число"));
			СтруктураДанных.meters.Колонки.Добавить("indicbef2", Новый ОписаниеТипов("Число"));
			СтруктураДанных.meters.Колонки.Добавить("indiccur1", Новый ОписаниеТипов("Число"));
			СтруктураДанных.meters.Колонки.Добавить("indiccur2", Новый ОписаниеТипов("Число"));
			СтруктураДанных.meters.Колонки.Добавить("kod",       Новый ОписаниеТипов("Строка"));
			СтруктураДанных.meters.Колонки.Добавить("name",      Новый ОписаниеТипов("Строка"));
			СтруктураДанных.meters.Колонки.Добавить("date",      Новый ОписаниеТипов("Дата"));
			
			// Дочерними являются только узлы "PersAssoc", проходим по ним всем в цикле.
			Для Каждого ТекУзел ИЗ УзелОрганизация.ДочерниеУзлы Цикл
				
				// Формируем код л/с.
				КодЛС = ТекУзел.Атрибуты.ПолучитьИменованныйЭлемент("kod_ls").Значение;
				
				Если ИспользуетсяПрефикс И Лев(КодЛС, ДлинаПрефикса) = ПрефиксЛС Тогда
					КодЛС = Прав(КодЛС, СтрДлина(КодЛС) - ДлинаПрефикса);
				КонецЕсли;
				
				// Заполняем ПУ л/с
				Для Каждого ТекПУ ИЗ ТекУзел.ДочерниеУзлы Цикл
					СтрокаПУ = СтруктураДанных.meters.Добавить();
					
					// л/с
					СтрокаПУ.kod_ls = КодЛС;
				
					// ПУ
					СтрокаПУ.indicbef1 = ТекПУ.Атрибуты.ПолучитьИменованныйЭлемент("indicbef1").Значение;
					СтрокаПУ.indicbef2 = ТекПУ.Атрибуты.ПолучитьИменованныйЭлемент("indicbef2").Значение;
					СтрокаПУ.indiccur1 = ТекПУ.Атрибуты.ПолучитьИменованныйЭлемент("indiccur1").Значение;
					СтрокаПУ.indiccur2 = ТекПУ.Атрибуты.ПолучитьИменованныйЭлемент("indiccur2").Значение;
					СтрокаПУ.kod       = ТекПУ.Атрибуты.ПолучитьИменованныйЭлемент("kod").Значение;
					СтрокаПУ.name      = ТекПУ.Атрибуты.ПолучитьИменованныйЭлемент("name").Значение;
					СтрокаПУ.date      = ТекПУ.Атрибуты.ПолучитьИменованныйЭлемент("date").Значение;
				КонецЦикла;
			КонецЦикла;
			
		ИначеЕсли ТипФайла = "accexistence" Тогда
			
			СтруктураДанных.Вставить("inn",      УзелОрганизация.Атрибуты.ПолучитьИменованныйЭлемент("inn").Значение);
			СтруктураДанных.Вставить("filetype", ТипФайла);
			
			// Таблица л/с
			СтруктураДанных.Вставить("PersAcc", Новый ТаблицаЗначений);
			СтруктураДанных.PersAcc.Колонки.Добавить("kod_ls", Новый ОписаниеТипов("Строка"));
			СтруктураДанных.PersAcc.Колонки.Добавить("login",  Новый ОписаниеТипов("Строка"));
			СтруктураДанных.PersAcc.Колонки.Добавить("email",  Новый ОписаниеТипов("Строка"));
			
			// Дочерними являются только узлы "PersAcc", проходим по ним всем в цикле.
			Для Каждого ТекУзел ИЗ УзелОрганизация.ДочерниеУзлы Цикл
				СтрокаЛС = СтруктураДанных.PersAcc.Добавить();
				
				// Формируем код л/с.
				КодЛС = ТекУзел.Атрибуты.ПолучитьИменованныйЭлемент("kod_ls").Значение;
				
				Если ИспользуетсяПрефикс И Лев(КодЛС, ДлинаПрефикса) = ПрефиксЛС Тогда
					КодЛС = Прав(КодЛС, СтрДлина(КодЛС) - ДлинаПрефикса);
				КонецЕсли;
				
				// Заполняем данные л/с
				СтрокаЛС.kod_ls = КодЛС;
				СтрокаЛС.login  = ТекУзел.Атрибуты.ПолучитьИменованныйЭлемент("login").Значение;
				
				Если ТекУзел.ЕстьАтрибут("email") Тогда
					СтрокаЛС.email = ТекУзел.Атрибуты.ПолучитьИменованныйЭлемент("email").Значение;
				КонецЕсли;
			КонецЦикла;
			
		ИначеЕсли ТипФайла = "monetapayments" Тогда
			
			СтруктураДанных.Вставить("inn",      УзелОрганизация.Атрибуты.ПолучитьИменованныйЭлемент("inn").Значение);
			СтруктураДанных.Вставить("filedate", УзелОрганизация.Атрибуты.ПолучитьИменованныйЭлемент("filedate").Значение);
			СтруктураДанных.Вставить("filetype", ТипФайла);
			
			СтруктураДанных.Вставить("payments", Новый ТаблицаЗначений);
			СтруктураДанных.payments.Колонки.Добавить("kod_ls", Новый ОписаниеТипов("Строка"));
			СтруктураДанных.payments.Колонки.Добавить("date",   Новый ОписаниеТипов("Дата"));
			СтруктураДанных.payments.Колонки.Добавить("summ",   Новый ОписаниеТипов("Число"));
			СтруктураДанных.payments.Колонки.Добавить("fee",    Новый ОписаниеТипов("Число"));
			
			Для Каждого ТекУзел ИЗ УзелОрганизация.ДочерниеУзлы Цикл
				СтрокаОплаты = СтруктураДанных.payments.Добавить();
				
				КодЛС = ТекУзел.Атрибуты.ПолучитьИменованныйЭлемент("kod_ls").Значение;
				Если ИспользуетсяПрефикс И Лев(КодЛС, ДлинаПрефикса) = ПрефиксЛС Тогда
					КодЛС = Прав(КодЛС, СтрДлина(КодЛС) - ДлинаПрефикса);
				КонецЕсли;
				
				СтрокаОплаты.kod_ls = КодЛС;
				СтрокаОплаты.date   = ТекУзел.Атрибуты.ПолучитьИменованныйЭлемент("date").Значение;
				СтрокаОплаты.summ   = ТекУзел.Атрибуты.ПолучитьИменованныйЭлемент("summ").Значение;
				СтрокаОплаты.fee    = ТекУзел.Атрибуты.ПолучитьИменованныйЭлемент("fee").Значение;
			КонецЦикла;
		Иначе
			Возврат Неопределено;
		КонецЕсли;
	Исключение
		// Ошибка при чтении
		СообщенияОбОшибке = НСтр("ru='Неверный формат файла.';uk='Невірний формат файлу.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СообщенияОбОшибке);
		Возврат Неопределено;
	КонецПопытки;
	
	Возврат СтруктураДанных;
	
КонецФункции // ПолучитьДанныеИзXML()

////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ ЗАГРУЗКИ ДАННЫХ В БАЗУ

// Загружает данные из сформированной ранее структуры данных.
//
// Параметры
//  СтруктураДанных – структура, хранящая данные для загрузки.
//  НастройкиОбмена - элемент справочника "Настройки обмена данными с сайтом".
//  СведенияОбОшибке - Строка - описание проблем при обмене
//
//  Примечание:
//   accexistence - данные о наличии аккаунтов на сайте
//   meters - показания по счетчикам
//   monetapayments - платежи, проведенные через Монета.ру
//
Процедура ЗагрузитьДанныеВБазу(СтруктураДанных, НастройкиОбмена, СведенияОбОшибке)
	
	ТипЗагрузки = НРег(СтруктураДанных.filetype);
	
	Если ТипЗагрузки = "accexistence" Тогда
		// Параметры доступа
		ЗагрузитьПараметрыДоступа(СтруктураДанных, НастройкиОбмена);
		
	ИначеЕсли ТипЗагрузки = "meters" Тогда
		// Счетчики
		ЗагрузитьПоказанияСчетчиковВБазу(СтруктураДанных);
		
	Иначе
		СведенияОбОшибке = НСтр("ru='Неизвестный формат файла.';uk='Невідомий формат файлу.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СведенияОбОшибке);
	КонецЕсли;
	
КонецПроцедуры // ЗагрузитьДанныеВБазу()

// Загружает параметры доступа.
//
// Параметры
//  СтруктураДанных – структура, хранящая данные о параметрах доступа.
//  НастройкиОбмена - элемент справочника "Настройки обмена данными с сайтом".
//
// Примечание:
//  Описание структуры загрузки см. в функции ПолучитьДанныеИзXML().
//
Процедура ЗагрузитьПараметрыДоступа(СтруктураДанных, НастройкиОбмена)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ТаблицаЛС.kod_ls КАК СТРОКА(100)) КАК ИдентификаторЛС,
	|	ТаблицаЛС.login КАК НовыйЛогин,
	|	ТаблицаЛС.email
	|ПОМЕСТИТЬ втТаблицаЛС
	|ИЗ
	|	&ТаблицаЛС КАК ТаблицаЛС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЛицевыеСчета.Ссылка КАК ЛицевойСчет,
	|	втТаблицаЛС.НовыйЛогин,
	|	втТаблицаЛС.email КАК ЭлЯщик
	|ИЗ
	|	втТаблицаЛС КАК втТаблицаЛС
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ЛицевыеСчета КАК ЛицевыеСчета
	|		ПО втТаблицаЛС.ИдентификаторЛС = ЛицевыеСчета.Идентификатор";
	
	Запрос.УстановитьПараметр("ТаблицаЛС", СтруктураДанных.PersAcc);
	
	ТаблицаЛС = Запрос.Выполнить().Выгрузить();
	
	МенеджерЗаписи = РегистрыСведений.СведенияОНаличииПараметровДоступа.СоздатьМенеджерЗаписи();
	
	Для каждого ТекСтрока из ТаблицаЛС Цикл
		
		// Элемент справочника "Лицевые счета".
		ОбъектЛС = ТекСтрока.ЛицевойСчет.ПолучитьОбъект();
		ОбъектЛС.ЛогинДоступа    = ТекСтрока.НовыйЛогин;
		Если ЗначениеЗаполнено(ТекСтрока.ЭлЯщик) Тогда
			ОбъектЛС.ЭлПочта = ТекСтрока.ЭлЯщик;
		КонецЕсли;
		// Поиск записи в регистре.
		МенеджерЗаписи.ЛицевойСчет      = ТекСтрока.ЛицевойСчет;
		МенеджерЗаписи.НастройкаДоступа = НастройкиОбмена;
		МенеджерЗаписи.Прочитать();
		
		Попытка
			// Запись л/с
			ОбъектЛС.Записать();
			
			// Запись регистра
			Если МенеджерЗаписи.Выбран() Тогда
				Если НЕ МенеджерЗаписи.НаличиеПараметров Тогда
					МенеджерЗаписи.НаличиеПараметров = Истина;
					МенеджерЗаписи.Записать();
				КонецЕсли;
			Иначе
				МенеджерЗаписи.ЛицевойСчет       = ОбъектЛС.Ссылка;
				МенеджерЗаписи.НастройкаДоступа  = НастройкиОбмена;
				МенеджерЗаписи.НаличиеПараметров = Истина;
				
				МенеджерЗаписи.Записать();
			КонецЕсли;
		Исключение
			Сообщить("Не удалось записать параметры доступа для лицевого счета:" + ОбъектЛС.Наименование);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры // ЗагрузитьПараметрыДоступа()

// Загружает показания счетчиков (ИПУ).
//
// Параметры
//  СтруктураДанных – структура, хранящая сведения о показаниях ИПУ.
//  НастройкиОбмена - элемент справочника "Настройки обмена данными с сайтом".
//
// Примечание:
//  Описание структуры загрузки см. в функции ПолучитьДанныеИзXML().
//
Процедура ЗагрузитьПоказанияСчетчиковВБазу(СтруктураДанных)
	
	
	НаборССайта = РегистрыСведений.ПоказанияПриборовУчетаССайта.СоздатьНаборЗаписей();
	
	ТаблицаТарифовСчетчиков = ПолучитьТаблицуТарифовПУ(СтруктураДанных.meters.ВыгрузитьКолонку("kod"));
	
	Для Каждого СтрокаСчетчиков Из СтруктураДанных.meters Цикл
		
		ТекСчетчик = Справочники.ПриборыУчета.НайтиПоКоду(СтрокаСчетчиков.kod);
		ТекЛС = Справочники.ЛицевыеСчета.НайтиПоРеквизиту("Идентификатор", СтрокаСчетчиков.kod_ls);
		
		Если ЗначениеЗаполнено(ТекСчетчик) тогда
			
			НаборССайта.Отбор.ПриборУчета.Установить(ТекСчетчик);
			НаборССайта.Отбор.ЛицевойСчет.Установить(ТекЛС);
			НаборССайта.Отбор.Период.Установить(СтрокаСчетчиков.date);
			
			НаборССайта.Прочитать();
			
			
			Если ТекСчетчик.Тарифность <> Перечисления.ТарифностьСчетчиков.Однотарифный Тогда
				ТарифностьЧисло = ?(ТекСчетчик.Тарифность = Перечисления.ТарифностьСчетчиков.Двухтарифный,2,3);
				НайденыеСтроки = ТаблицаТарифовСчетчиков.НайтиСтроки(Новый Структура("ПриборУчета", ТекСчетчик));
			
				Если ТарифностьЧисло > НайденыеСтроки.Количество() Тогда
					НайденыеСтроки = ТекСчетчик.Услуга.ВидыТарифов.Выгрузить();
				КонецЕсли;	
				Сч = 1;
				Пока Сч <= ТарифностьЧисло  Цикл
					Если НаборССайта.Количество() >= Сч Тогда
						НоваяСтрока = НаборССайта[Сч-1];
					Иначе	
						НоваяСтрока = НаборССайта.Добавить();
					КонецЕсли;
					НоваяСтрока.ЛицевойСчет = ТекЛС;
					НоваяСтрока.ПриборУчета = ТекСчетчик;
					Попытка
						НоваяСтрока.ВидТарифа = НайденыеСтроки[Сч-1].ВидТарифа;
					Исключение
						А= 1;
					КонецПопытки;	
					НоваяСтрока.Значение = СтрокаСчетчиков["indiccur"+Строка(Сч)];
					НоваяСтрока.Период = СтрокаСчетчиков.date;
					Сч = Сч +1;
				КонецЦикла; 	
					
			Иначе		
				Если НаборССайта.Количество() > 0 Тогда
					НоваяСтрока = НаборССайта[0];
				Иначе
					НоваяСтрока = НаборССайта.Добавить();
				КонецЕсли;
				
				НоваяСтрока.ЛицевойСчет = ТекЛС;
				НоваяСтрока.ПриборУчета = ТекСчетчик;
				НоваяСтрока.ВидТарифа = Перечисления.ВидыТарифов.Общий;
				НоваяСтрока.Значение = СтрокаСчетчиков.indiccur1;
				НоваяСтрока.Период = СтрокаСчетчиков.date;
							
				
			КонецЕсли;
			
			НаборССайта.Записать();
		КонецЕсли;
		
	КонецЦикла;
		
КонецПроцедуры // ЗагрузитьПоказанияСчетчиковВБазу()

// Записывает параметры доступа в справочник "Лицевые счета" и
// регистр сведений "Сведения о наличии параметров доступа".
//
// Параметры:
//  ТаблицаЛС - таблица с параметрами доступа
//  ОбновлятьПД - признак того, что надо заменять старые параметры доступа
//  НастройкаДоступа - текущая настройка доступа
//
// Возвращаемое значение:
//  Булево - удалось записать все параметры
//
Функция ЗаписатьПараметрыДоступаНаСервере(ТаблицаЛС, ОбновлятьПД, НастройкаДоступа) Экспорт
	
	КоличествоЗаписанныхПД = 0;
	
	Для Каждого СтрокаТЧ Из ТаблицаЛС Цикл
		// Производим запись только при условии изменения данных в строке.
		Если СтрокаТЧ.ПДИзменены = Истина Тогда
			
			ОбъектЛС               = СтрокаТЧ.ЛицевойСчет.ПолучитьОбъект();
			ОбъектЛС.ЛогинДоступа  = СтрокаТЧ.Логин;
			
			Если ЗаписатьОбъект(ОбъектЛС) Тогда
				КоличествоЗаписанныхПД = КоличествоЗаписанныхПД + 1;
			Иначе
				Продолжить;
			КонецЕсли;
			
			ПараметрыДоступа                   = РегистрыСведений.СведенияОНаличииПараметровДоступа.СоздатьМенеджерЗаписи();
			ПараметрыДоступа.ЛицевойСчет       = СтрокаТЧ.ЛицевойСчет;
			ПараметрыДоступа.НаличиеПараметров = Истина;
			ПараметрыДоступа.НастройкаДоступа  = НастройкаДоступа;
			
			ПараметрыДоступа.Записать();
			
			СтрокаТЧ.ДанныеЗаписаны = Истина;
			СтрокаТЧ.ПДИзменены     = Ложь;
		Иначе
			
			// Если данные не были изменены, то записывать их не нужно. Прибавляем счетчик записанных и ставим флаг.
			КоличествоЗаписанныхПД = КоличествоЗаписанныхПД + 1;
			СтрокаТЧ.ДанныеЗаписаны = Истина;
			
		КонецЕсли;
	КонецЦикла;
		
	Если КоличествоЗаписанныхПД = ТаблицаЛС.Количество() Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции // ЗаписатьПараметрыДоступаНаСервере()

