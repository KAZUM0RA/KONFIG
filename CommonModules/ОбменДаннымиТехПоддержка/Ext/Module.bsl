	СтруктураЗаполения.Вставить("Email",Email);
	СтруктураЗаполения.Вставить("РегистрационныйНомер",РегистрационныйНомер);
	СтруктураЗаполения.Вставить("НомерТелефона",НомерТелефона);
	
	УчетКоммунальныхУслуг.ЗаписатьНастрокиСлужбыПоддержки(СтруктураЗаполения);
	
	Попытка
		Ответ = УчетКоммунальныхУслуг.ПолучитьПрокси().Registration(Организация,ФИО,Должность,Город,Email,РегистрационныйНомер);
		Возврат Ответ;
	Исключение
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru = 'Произошла ошибка соединения с сервером технической поддержки. Возможно из-за неполадок с подключением к сети ""Интернет""'; uk = 'Сталася помилка з''єднання з сервером технічної підтримки. Можливо із-за неполадок з підключенням до мережі ""Інтернет""'")
		+Символы.ПС+ОписаниеОшибки();
		Сообщение.Сообщить();
		Возврат Ложь;
	КонецПопытки;	
	
КонецФункции

