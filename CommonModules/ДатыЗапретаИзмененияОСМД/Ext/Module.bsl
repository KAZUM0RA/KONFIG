	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "Документ.НачислениеПениПоЛС",						"ПериодНачисления",	"Здания",	"Здание");
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "Документ.РазовоеНачислениеУслуг",					"ПериодНачисления",	"Здания",	"Здание");
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "Документ.ВводПоказанийПриборовУчета",				"ПериодНачисления",	"Здания",	"Здание");
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "Документ.ЗаменаПриборовУчета",					"Дата",				"Здания",	"Здание");
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "Документ.ЗакрытиеМесяца",							"Дата",				"Здания",	"Здание");
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "Документ.РаспределениеОбщедомовыхПриборовУчета",	"ПериодНачисления",	"Здания",	"Здание");
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "Документ.КорректировкаНачислений",				"Дата",				"Здания",	"Здание");
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "Документ.УДАЛИТЬКорректировкаОплат",				"Дата",				"Здания",	"Здание");
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "Документ.ПоступлениеВКассу",						"Дата",				"Здания",	"ЛицевойСчет.Владелец");
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "Документ.ПоступлениеНаСчет",						"Дата",				"Здания",	"ЛицевойСчет.Владелец");
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "Документ.КорректировкаПоказанийПриборовУчета",	"Дата",				"Здания",	"Здание");
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "Документ.РаспределениеДополнительныхНачислений",	"ПериодНачисления",	"Здания",	"Здание");
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "Документ.КорректировкаДолга",						"Дата",				"Здания",	"ЛицевойСчетДебитор.Владелец");
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "Документ.КорректировкаДолга",						"Дата",				"Здания",	"ЛицевойСчетКредитор.Владелец");
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "Документ.ПланированиеАвансов",					"Дата",				"Здания",	"Здание");
