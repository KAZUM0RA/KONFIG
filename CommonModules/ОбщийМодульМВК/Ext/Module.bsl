	    |	ГДЕ
	    |		РасчетыПоЛицевымСчетам.ЛицевойСчет.ПометкаУдаления = ЛОЖЬ
	    |		И РасчетыПоЛицевымСчетам.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
	    |		И РасчетыПоЛицевымСчетам.Услуга.КодУслугиПФУ = &КодУслугиПФУ
	    |	
	    |	СГРУППИРОВАТЬ ПО
	    |		РасчетыПоЛицевымСчетам.ЛицевойСчет,
	    |		ВЫБОР
	    |			КОГДА РасчетыПоЛицевымСчетам.ВидНачисления = ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Субсидия)
	    |				ТОГДА РасчетыПоЛицевымСчетам.Сумма
	    |			ИНАЧЕ 0
	    |		КОНЕЦ,
	    |		РасчетыПоЛицевымСчетам.Услуга.ВидУслуги) КАК ВложенныйЗапрос
	    |ГДЕ
	    |	ВложенныйЗапрос.ЛицевойСчет = &ЛицевойСчет
	    |
	    |СГРУППИРОВАТЬ ПО
	    |	ВложенныйЗапрос.ЛицевойСчет";
	Запрос.УстановитьПараметр("ДатаНачала", '20221001');
	Запрос.УстановитьПараметр("ДатаОкончания", КонецМесяца(НаДату));
	Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
	Запрос.УстановитьПараметр("КодУслугиПФУ", Услуга);
	Результат = Запрос.Выполнить();
	Если НЕ Результат.Пустой() Тогда
	    Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл
			Сумма = Выборка.СуммаНачисления - Выборка.СуммаОплаты;
		КонецЦикла;
		Если Сумма < 0 Тогда
			Сумма = 0;
		КонецЕсли;
	КонецЕсли;
	Возврат Сумма;
КонецФункции


Функция ОстаткиПоЛицевомуСчету(НаДату, ЛицевойСчет, Услуга) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
	    "ВЫБРАТЬ
	    |	РасчетыПоЛицевымСчетамОстатки.СуммаОстаток
	    |ИЗ
	    |	РегистрНакопления.РасчетыПоЛицевымСчетам.Остатки(
	    |			&Период,
	    |			Услуга = &Услуга
	    |				И ЛицевойСчет = &ЛицевойСчет) КАК РасчетыПоЛицевымСчетамОстатки";
	Запрос.УстановитьПараметр("Период", НаДату);
	Запрос.УстановитьПараметр("Услуга", Услуга);
	Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.СуммаОстаток >= 0 Тогда
		    Остаток = Выборка.СуммаОстаток;
		Иначе
			Остаток = 0;
		КонецЕсли;
	КонецЦикла;
	Возврат Остаток;
КонецФункции

