Функция ВыборкаПлощадейИндОтопления(Здание, Подъезд = "") Экспорт
    ЗапросЛС = Новый Запрос;
	Условие = "";
	Если Подъезд <> "" Тогда
		Условие = " И ПлощадьОбъектовЛицевыхСчетовСрезПоследних.Помещение.Подъезд = &Подъезд";
		ЗапросЛС.УстановитьПараметр("Подъезд", Подъезд);
	КонецЕсли;
	ЗапросЛС.Текст =
	   "ВЫБРАТЬ
	   |	ЛицевыеСчетаСрезПоследних.ЛицевойСчет,
	   |	ПлощадьОбъектовЛицевыхСчетовСрезПоследних.Площадь
	   |ИЗ
	   |	РегистрСведений.ЛицевыеСчета.СрезПоследних(&НаДату, ) КАК ЛицевыеСчетаСрезПоследних
	   |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПлощадьОбъектовЛицевыхСчетов.СрезПоследних(&НаДату, ) КАК ПлощадьОбъектовЛицевыхСчетовСрезПоследних
	   |		ПО ЛицевыеСчетаСрезПоследних.ЛицевойСчет.ОбъектЛицевогоСчета = ПлощадьОбъектовЛицевыхСчетовСрезПоследних.Помещение
	   |ГДЕ
	   |	ЛицевыеСчетаСрезПоследних.ЛицевойСчет.Владелец = &Владелец " + Условие + " 
	   |	И ПлощадьОбъектовЛицевыхСчетовСрезПоследних.ВидПлощади = &ВидПлощади
	   |	И ЛицевыеСчетаСрезПоследних.ЛицевойСчет.ИндОтопление = ИСТИНА"; 
	ЗапросЛС.УстановитьПараметр("Владелец", Здание);
	ЗапросЛС.УстановитьПараметр("НаДату", ТекущаяДата());
	ЗапросЛС.УстановитьПараметр("ВидПлощади", Справочники.ВидыПлощадей.ОтапливаемаяПлощадь);
	Результат = ЗапросЛС.Выполнить().Выгрузить();

	Возврат Результат.Итог("Площадь");
КонецФункции

