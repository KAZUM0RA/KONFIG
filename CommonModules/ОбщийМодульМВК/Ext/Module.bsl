	               |	УстановленныеПриборыУчетаСрезПоследних.ОбъектУстановки,
	               |	УстановленныеПриборыУчетаСрезПоследних.ПриборУчета,
	               |	СУММА(ЕСТЬNULL(ПУ.ТекущиеПоказания, 0)) КАК ТекущиеПоказания,
	               |	СУММА(ЕСТЬNULL(ПУ.ПредыдущиеПоказания, 0)) КАК ПредыдущиеПоказания,
	               |	ПУ.ПриборУчета.Коэффициент,
	               |	КОЛИЧЕСТВО(УстановленныеПриборыУчетаСрезПоследних.ПриборУчета) КАК КоличествоПиборовНаУслуге,
	               |	ПУ.ПриборУчета.Услуга КАК Услуга,
	               |	ПУ.ПриборУчета.ЕдиницаИзмерения КАК ЕдиницаИзмерения
	               |ИЗ
	               |	РегистрСведений.УстановленныеПриборыУчета.СрезПоследних(КОНЕЦПЕРИОДА(&ДатаОкончания, МЕСЯЦ), ОбъектУстановки В (&ЛицевыеСчета)) КАК УстановленныеПриборыУчетаСрезПоследних
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ПУ КАК ПУ
	               |		ПО УстановленныеПриборыУчетаСрезПоследних.ПриборУчета = ПУ.ПриборУчета
	               |ГДЕ
	               |	УстановленныеПриборыУчетаСрезПоследних.Действует = ИСТИНА
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	УстановленныеПриборыУчетаСрезПоследних.ОбъектУстановки,
	               |	УстановленныеПриборыУчетаСрезПоследних.ПриборУчета,
	               |	ПУ.ПриборУчета.Коэффициент,
	               |	ПУ.ПриборУчета.Услуга,
	               |	ПУ.ПриборУчета.ЕдиницаИзмерения
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ЗаменыПриборовУчета.ОбъектУстановки,
	               |	ЗаменыПриборовУчета.ПриборУчета,
	               |	ЗаменыПриборовУчета.Показание,
	               |	ЗаменыПриборовУчета.ПоказаниеПредыдущее,
	               |	ЗаменыПриборовУчета.ПриборУчета.Коэффициент,
	               |	0,
	               |	ЗаменыПриборовУчета.Услуга,
	               |	ЗаменыПриборовУчета.ПриборУчета.ЕдиницаИзмерения
	               |ИЗ
	               |	РегистрНакопления.ЗаменыПриборовУчета КАК ЗаменыПриборовУчета
	               |ГДЕ
	               |	ЗаменыПриборовУчета.Период МЕЖДУ НАЧАЛОПЕРИОДА(&ДатаОкончания, МЕСЯЦ) И КОНЕЦПЕРИОДА(&ДатаОкончания, МЕСЯЦ)
	               |	И ЗаменыПриборовУчета.ОбъектУстановки В(&ЛицевыеСчета)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Услуга УБЫВ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЛицевыеСчетаСрезПоследних.КоличествоПрописанных,
	               |	ЛицевыеСчетаСрезПоследних.КоличествоПроживающих,
	               |	ЛицевыеСчетаСрезПоследних.ЛицевойСчет
	               |ИЗ
	               |	РегистрСведений.ЛицевыеСчета.СрезПоследних(&ДатаОкончания, ЛицевойСчет В (&ЛицевыеСчета)) КАК ЛицевыеСчетаСрезПоследних
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	РасчетыПоЛицевымСчетамОбороты.ЛицевойСчет,
	               |	РасчетыПоЛицевымСчетамОбороты.Период,
	               |	РасчетыПоЛицевымСчетамОбороты.СуммаРасход
	               |ИЗ
	               |	РегистрНакопления.РасчетыПоЛицевымСчетам.Обороты(&ДатаНачала, &ДатаОкончания, Регистратор, ЛицевойСчет В (&ЛицевыеСчета)) КАК РасчетыПоЛицевымСчетамОбороты
	               |ГДЕ
	               |	ТИПЗНАЧЕНИЯ(РасчетыПоЛицевымСчетамОбороты.Регистратор) <> ТИП(Документ.ДоговорРеструктуризацииДолга)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	РасчетыПоЛицевымСчетамОбороты.ЛицевойСчет,
	               |	РасчетыПоЛицевымСчетамОбороты.Период,
	               |	РасчетыПоЛицевымСчетамОбороты.СуммаРасход
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЗаявкаНаПроведениеРемонта.ЛицевойСчет,
	               |	ЗаявкаНаПроведениеРемонта.Ссылка,
	               |	ЗаявкаНаПроведениеРемонта.Номер,
	               |	ЗаявкаНаПроведениеРемонта.Дата,
	               |	ЗаявкаНаПроведениеРемонта.ВидЗаявки,
	               |	ЗаявкаНаПроведениеРемонта.СтатусЗаявки,
	               |	ЗаявкаНаПроведениеРемонта.ТекстЗаявки,
	               |	ЗаявкаНаПроведениеРемонта.Телефон,
	               |	ЗаявкаНаПроведениеРемонта.ВремяУдобноеДляЗаказчика,
	               |	ЗаявкаНаПроведениеРемонта.ВремяФактическогоВыполнения,
	               |	ЗаявкаНаПроведениеРемонта.Работы.(
	               |		Ссылка,
	               |		ВидРабот,
	               |		Цена,
	               |		КоличествоФакт,
	               |		СуммаФакт,
	               |		ВидРабот.БазоваяЕдиницаИзмерения КАК ЕдиницаИзмерения
	               |	),
	               |	ЗаявкаНаПроведениеРемонта.Запасы.(
	               |		Ссылка,
	               |		Номенклатура,
	               |		Цена,
	               |		КоличествоФакт,
	               |		СуммаФакт,
	               |		Номенклатура.БазоваяЕдиницаИзмерения КАК ЕдиницаИзмерения
	               |	),
	               |	ЗаявкаНаПроведениеРемонта.ОценкаПроведенияРемонта,
	               |	ЗаявкаНаПроведениеРемонта.КомментарийПоВыполнениюЗаявки
	               |ИЗ
	               |	Документ.ЗаявкаНаПроведениеРемонта КАК ЗаявкаНаПроведениеРемонта
	               |ГДЕ
	               |	ЗаявкаНаПроведениеРемонта.Дата >= &ДатаНачала
	               |	И ЗаявкаНаПроведениеРемонта.Дата <= &ДатаОкончания
	               |	И ЗаявкаНаПроведениеРемонта.Проведен
	               |	И ЗаявкаНаПроведениеРемонта.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЗаявокНаПроведениеРемонта.ПроведениеРаботПоЛицевомуСчету)
	               |	И ЗаявкаНаПроведениеРемонта.ЛицевойСчет В(&ЛицевыеСчета)";

	                           
	Запрос.УстановитьПараметр("ДатаНачала", НачалоМесяца(ПериодВыгрузки));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецМесяца(ПериодВыгрузки));
	Запрос.УстановитьПараметр("ЛицевыеСчета", СписокЛицевыхСчетов);
	
	Результат = Запрос.ВыполнитьПакет();
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьОстатки(НаДату, ЛицевойСчет, Услуга) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
	    "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	    |	ВложенныйЗапрос.ЛицевойСчет,
	    |	СУММА(ВложенныйЗапрос.СуммаНачальныйОстаток) КАК СуммаНачальныйОстаток,
	    |	СУММА(ВложенныйЗапрос.СуммаНачисления) КАК СуммаНачисления,
	    |	СУММА(ВложенныйЗапрос.СуммаОплаты) КАК СуммаОплаты,
	    |	СУММА(ВложенныйЗапрос.Льготы) КАК Льготы,
	    |	СУММА(ВложенныйЗапрос.Субсидия) КАК Субсидия,
	    |	СУММА(ВложенныйЗапрос.Перерасчет) КАК Перерасчет
	    |ИЗ
	    |	(ВЫБРАТЬ
	    |		РасчетыПоЛицевымСчетамОстаткиИОбороты.ЛицевойСчет КАК ЛицевойСчет,
	    |		РасчетыПоЛицевымСчетамОстаткиИОбороты.СуммаНачальныйОстаток КАК СуммаНачальныйОстаток,
	    |		РасчетыПоЛицевымСчетамОстаткиИОбороты.СуммаПриход КАК СуммаНачисления,
	    |		РасчетыПоЛицевымСчетамОстаткиИОбороты.СуммаРасход КАК СуммаОплаты,
	    |		0 КАК Льготы,
	    |		0 КАК Субсидия,
	    |		0 КАК Перерасчет,
	    |		РасчетыПоЛицевымСчетамОстаткиИОбороты.Услуга.ВидУслуги КАК УслугаВидУслуги
	    |	ИЗ
	    |		РегистрНакопления.РасчетыПоЛицевымСчетам.ОстаткиИОбороты(&ДатаНачала, &ДатаОкончания, Авто, , ЛицевойСчет.ПометкаУдаления = ЛОЖЬ) КАК РасчетыПоЛицевымСчетамОстаткиИОбороты
	    |	ГДЕ
	    |		РасчетыПоЛицевымСчетамОстаткиИОбороты.Услуга.ВидУслуги = &ВидУслуги
	    |	
	    |	СГРУППИРОВАТЬ ПО
	    |		РасчетыПоЛицевымСчетамОстаткиИОбороты.ПериодГод,
	    |		РасчетыПоЛицевымСчетамОстаткиИОбороты.ЛицевойСчет,
	    |		РасчетыПоЛицевымСчетамОстаткиИОбороты.СуммаНачальныйОстаток,
	    |		РасчетыПоЛицевымСчетамОстаткиИОбороты.СуммаПриход,
	    |		РасчетыПоЛицевымСчетамОстаткиИОбороты.СуммаРасход,
	    |		РасчетыПоЛицевымСчетамОстаткиИОбороты.Услуга.ВидУслуги
	    |	
	    |	ОБЪЕДИНИТЬ ВСЕ
	    |	
	    |	ВЫБРАТЬ
	    |		РасчетыПоЛицевымСчетам.ЛицевойСчет,
	    |		0,
	    |		0,
	    |		0,
	    |		СУММА(ВЫБОР
	    |				КОГДА РасчетыПоЛицевымСчетам.ВидНачисления = ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Льгота)
	    |					ТОГДА РасчетыПоЛицевымСчетам.Сумма
	    |				ИНАЧЕ 0
	    |			КОНЕЦ),
	    |		ВЫБОР
	    |			КОГДА РасчетыПоЛицевымСчетам.ВидНачисления = ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Субсидия)
	    |				ТОГДА РасчетыПоЛицевымСчетам.Сумма
	    |			ИНАЧЕ 0
	    |		КОНЕЦ,
	    |		СУММА(ВЫБОР
	    |				КОГДА РасчетыПоЛицевымСчетам.ВидНачисления = ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Перерасчет)
	    |						ИЛИ РасчетыПоЛицевымСчетам.ВидНачисления = ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Корректировка)
	    |					ТОГДА РасчетыПоЛицевымСчетам.Сумма
	    |				ИНАЧЕ 0
	    |			КОНЕЦ),
	    |		РасчетыПоЛицевымСчетам.Услуга.ВидУслуги
	    |	ИЗ
	    |		РегистрНакопления.РасчетыПоЛицевымСчетам КАК РасчетыПоЛицевымСчетам
	    |	ГДЕ
	    |		РасчетыПоЛицевымСчетам.ЛицевойСчет.ПометкаУдаления = ЛОЖЬ
	    |		И РасчетыПоЛицевымСчетам.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
	    |		И РасчетыПоЛицевымСчетам.Услуга.ВидУслуги = &ВидУслуги
	    |	
	    |	СГРУППИРОВАТЬ ПО
	    |		РасчетыПоЛицевымСчетам.ЛицевойСчет,
	    |		ВЫБОР
	    |			КОГДА РасчетыПоЛицевымСчетам.ВидНачисления = ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Субсидия)
	    |				ТОГДА РасчетыПоЛицевымСчетам.Сумма
	    |			ИНАЧЕ 0
	    |		КОНЕЦ,
	    |		РасчетыПоЛицевымСчетам.Услуга.ВидУслуги) КАК ВложенныйЗапрос
	    |ГДЕ
	    |	ВложенныйЗапрос.ЛицевойСчет = &ЛицевойСчет
	    |
	    |СГРУППИРОВАТЬ ПО
	    |	ВложенныйЗапрос.ЛицевойСчет";
	Запрос.УстановитьПараметр("ДатаНачала", '20200401');
	Запрос.УстановитьПараметр("ДатаОкончания", НаДату);
	Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
	Запрос.УстановитьПараметр("ВидУслуги", Услуга);
	Результат = Запрос.Выполнить();
	Если НЕ Результат.Пустой() Тогда
	    Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл
			Сумма = Выборка.СуммаНачисления - Выборка.СуммаОплаты;
		КонецЦикла;
		Если Сумма < 0 Тогда
			Сумма = 0;
		КонецЕсли;
	КонецЕсли;
	Возврат Сумма;
КонецФункции

