Функция ПолучтьПоказанияПриборовОтопление(ЛицевойСчет, Период_) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
	    "ВЫБРАТЬ
	    |	ПоказанияПриборовУчетаСрезПоследних.ПриборУчета,
	    |	ПоказанияПриборовУчетаСрезПоследних.ВидТарифа,
	    |	ПоказанияПриборовУчетаСрезПоследних.Значение,
	    |	ПоказанияПриборовУчетаСрезПоследних.Отключен,
	    |	ПоказанияПриборовУчетаСрезПоследних.Источник,
	    |	ПоказанияПриборовУчетаСрезПоследних.Период
	    |ИЗ
	    |	РегистрСведений.УстановленныеПриборыУчета.СрезПоследних(&Период, ОбъектУстановки = &ЛицевойСчет) КАК УстановленныеПриборыУчетаСрезПоследних
	    |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПоказанияПриборовУчета.СрезПоследних(&Период, ПриборУчета.Услуга.ВидУслуги = &ВидУслуги) КАК ПоказанияПриборовУчетаСрезПоследних
	    |		ПО УстановленныеПриборыУчетаСрезПоследних.ПриборУчета = ПоказанияПриборовУчетаСрезПоследних.ПриборУчета";
	Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
	Запрос.УстановитьПараметр("Период", Период_);
	Запрос.УстановитьПараметр("ВидУслуги", Справочники.ВидыУслуг.Отопление);
	Результат = Запрос.Выполнить();
	Если НЕ Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл
			Значение = Выборка.Значение;
		КонецЦикла;
		Возврат Значение;
	Иначе
		Значение = 0;
		Возврат Значение;
	КонецЕсли;
КонецФункции

