&НаСервере
Функция ПолучитьЛС(ЛицевойСчет) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛицевыеСчета.Ссылка
		|ИЗ
		|	Справочник.ЛицевыеСчета КАК ЛицевыеСчета
		|ГДЕ
		|	ЛицевыеСчета.Наименование = &Наименование";
	
	Запрос.УстановитьПараметр("Наименование", ЛицевойСчет);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		ЛС = Выборка.Ссылка;
	КонецЦикла;
	Возврат ЛС;
КонецФункции

&НаСервере
Функция ПолучитьУслуги(ЛицевойСчет, Период) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	НазначенныеУслугиСрезПоследних.Услуга,
		|	НазначенныеУслугиСрезПоследних.Услуга.Наименование,
		|	НазначенныеУслугиСрезПоследних.Услуга.ВидУслуги,
		|	НазначенныеУслугиСрезПоследних.Услуга.КодУслугиПФУ
		|ИЗ
		|	РегистрСведений.НазначенныеУслуги.СрезПоследних(&Период, ЛицевойСчет = &ЛицевойСчет) КАК НазначенныеУслугиСрезПоследних
		|ГДЕ
		|	НазначенныеУслугиСрезПоследних.Активность = ИСТИНА
		|	И НазначенныеУслугиСрезПоследних.Действует = ИСТИНА";
	
	Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
	Запрос.УстановитьПараметр("Период", Новый Граница(ТекущаяДата(), ВидГраницы.Включая));
	Услуги = Запрос.Выполнить().Выгрузить();
	
    Возврат Услуги;
КонецФункции

&НаСервере
Функция ПолучитьПотребителя(ЛицевойСчет) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ОтветственныйВладелец
		|ИЗ
		|	РегистрСведений.ОтветственныйВладелецЛицевогоСчета.СрезПоследних(&НаДату, ЛицевойСчет = &ЛицевойСчет) КАК ОтветственныйВладелецЛицевогоСчетаСрезПоследних";
	Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
	Запрос.УстановитьПараметр("НаДату", ТекущаяДата());
	РезультатЗапроса = Запрос.Выполнить();
	Выборка          = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Потребитель = Выборка.ОтветственныйВладелец;
	КонецЦикла;
	Возврат Потребитель;
КонецФункции

&НаСервере
Функция ПолучитьЛицевойСчет(Потребитель) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ЛицевойСчет КАК ЛицевойСчет
		|ИЗ
		|	РегистрСведений.ОтветственныйВладелецЛицевогоСчета.СрезПоследних(&НаДату, ОтветственныйВладелец = &ОтветственныйВладелец) КАК ОтветственныйВладелецЛицевогоСчетаСрезПоследних";
	
	Запрос.УстановитьПараметр("ОтветственныйВладелец", Потребитель);
	Запрос.УстановитьПараметр("НаДату", Новый Граница(ТекущаяДата(), ВидГраницы.Включая));
	РезультатЗапроса = Запрос.Выполнить();
	Выборка          = РезультатЗапроса.Выбрать();	
	Пока Выборка.Следующий() Цикл
		ЛицевойСчет = Выборка.ЛицевойСчет;
	КонецЦикла;
	Возврат ЛицевойСчет;
КонецФункции

&НаСервере
Функция ПолучитьТарифПоУслуге(Услуга) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТарифыСрезПоследних.ЗначениеТарифа,
		|	ТарифыСрезПоследних.НормаПотребления,
		|	ТарифыСрезПоследних.ЗначениеТарифаПоНорме
		|ИЗ
		|	РегистрСведений.Тарифы.СрезПоследних(&Период, Услуга = &Услуга)  КАК ТарифыСрезПоследних";
	
	Запрос.УстановитьПараметр("Период", Новый Граница(ТекущаяДата(), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Услуга", Услуга);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Тарифы = Новый Структура;
	
	Пока Выборка.Следующий() Цикл
		Тарифы.Вставить("ЗначениеТарифа", Выборка.ЗначениеТарифа);
		Тарифы.Вставить("НормаПотребления", Выборка.НормаПотребления);
		Тарифы.Вставить("ЗначениеТарифаПоНорме", Выборка.ЗначениеТарифаПоНорме);
	КонецЦикла;
    Возврат Тарифы;
КонецФункции

Функция ПолучитьТарифПоУслугеДляПФУ(Услуга, Здание) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТарифыСрезПоследних.ЗначениеТарифа,
		|	ТарифыСрезПоследних.НормаПотребления,
		|	ТарифыСрезПоследних.ЗначениеТарифаПоНорме
		|ИЗ
		|	РегистрСведений.Тарифы.СрезПоследних(
		|			&Период,
		|			Услуга.КодУслугиПФУ В (&КодУслугиПФУ)
		|				И Здание = &Здание) КАК ТарифыСрезПоследних";
	
	Запрос.УстановитьПараметр("Период", Новый Граница(ТекущаяДата(), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("КодУслугиПФУ", Услуга);
	Запрос.УстановитьПараметр("Здание", Здание);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Тарифы = Новый Структура;
	
	Пока Выборка.Следующий() Цикл
		Тарифы.Вставить("ЗначениеТарифа", Выборка.ЗначениеТарифа);
		Тарифы.Вставить("НормаПотребления", Выборка.НормаПотребления);
		Тарифы.Вставить("ЗначениеТарифаПоНорме", Выборка.ЗначениеТарифаПоНорме);
	КонецЦикла;
    Возврат Тарифы;
КонецФункции

&НаСервере
Функция ПолучитьПриборУчета(ЗаводскойНомер)
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПриборыУчета.Ссылка,
		|	ПриборыУчета.Услуга,
		|	ПриборыУчета.Наименование
		|ИЗ
		|	Справочник.ПриборыУчета КАК ПриборыУчета
		|ГДЕ
		|	ПриборыУчета.ЗаводскойНомер = &ЗаводскойНомер";
	
	Запрос.УстановитьПараметр("ЗаводскойНомер", ЗаводскойНомер);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	ПриборУчета = Новый Структура;
	Пока Выборка.Следующий() Цикл
		ПриборУчета.Вставить("Ссылка", Выборка.Ссылка);
		ПриборУчета.Вставить("Наименование", Выборка.Наименование);
		ПриборУчета.Вставить("Услуга", Выборка.Услуга);
	КонецЦикла;
    Возврат ПриборУчета;
КонецФункции

Функция ОпределитьКоличествоПрописанных(ЛицевойСчет) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЕСТЬNULL(ЛицевыеСчетаСрезПоследних.КоличествоПрописанных, 0) КАК КоличествоПрописанных,
		|	ЕСТЬNULL(ЛицевыеСчетаСрезПоследних.КоличествоПроживающих, 0) КАК КоличествоПроживающих,
		|	ЕСТЬNULL(ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ОтветственныйВладелец, ЗНАЧЕНИЕ(Справочник.ПотребителиУслуг.ПустаяСсылка)) КАК ОтветственныйВладелец
		|ИЗ
		|	РегистрСведений.ЛицевыеСчета.СрезПоследних(, ЛицевойСчет = &ЛицевойСчет) КАК ЛицевыеСчетаСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОтветственныйВладелецЛицевогоСчета.СрезПоследних(, ЛицевойСчет = &ЛицевойСчет) КАК ОтветственныйВладелецЛицевогоСчетаСрезПоследних
		|		ПО ЛицевыеСчетаСрезПоследних.ЛицевойСчет = ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ЛицевойСчет
		|ГДЕ
		|	ЛицевыеСчетаСрезПоследних.Действует = ИСТИНА";
		
	Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	СтруктураДанные = Новый Структура;
	Если РезультатЗапроса.Следующий() Тогда
		СтруктураДанные.Вставить("ОтветственныйВладелец",	РезультатЗапроса.ОтветственныйВладелец);
		СтруктураДанные.Вставить("КоличествоПрописанных",	РезультатЗапроса.КоличествоПрописанных);
		СтруктураДанные.Вставить("КоличествоПроживающих",	РезультатЗапроса.КоличествоПроживающих);
		
	Иначе
		СтруктураДанные.Вставить("ОтветственныйВладелец",	Справочники.ПотребителиУслуг.ПустаяСсылка());
		СтруктураДанные.Вставить("КоличествоПрописанных",	0);
		СтруктураДанные.Вставить("КоличествоПроживающих",	0);
		
	КонецЕсли;
	
	Возврат СтруктураДанные;
	
КонецФункции

&НаСервере
// Функция выделяет первое слово в предложении
Функция ВыделитьСлово(ИсходнаяСтрока) Экспорт
	
	Буфер = СокрЛ(ИсходнаяСтрока);
	ПозицияПослПробела = Найти(Буфер, " ");

	Если ПозицияПослПробела = 0 Тогда
		ИсходнаяСтрока = "";
		Возврат Буфер;
	КонецЕсли;
	
	ВыделенноеСлово = СокрЛП(Лев(Буфер, ПозицияПослПробела));
	ИсходнаяСтрока  = Сред(ИсходнаяСтрока, ПозицияПослПробела + 1);
	
	Возврат ВыделенноеСлово;
	
КонецФункции

&НаСервере
// Функция определяет пол физлица по его отчеству
//
Функция ПолучитьПол(ОтчествоРаботника) Экспорт
	
	Если Прав(ОтчествоРаботника, 2) = "ич" Тогда
		Возврат Перечисления.ПолФизическогоЛица.Мужской;
	
	ИначеЕсли Прав(ОтчествоРаботника, 2) = "на" Тогда
		Возврат Перечисления.ПолФизическогоЛица.Женский;
	
	КонецЕсли;
	
	Возврат Перечисления.ПолФизическогоЛица.ПустаяСсылка();
	
КонецФункции // ПолучитьПол()

Функция СформироватьфайлПоЛицевымСчетам(СписокЛицевыхСчетов, ПериодВыгрузки) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	РасчетПоказанийПриборовУчетаОстаткиИОбороты.ПриборУчета КАК ПриборУчета
	               |ПОМЕСТИТЬ ОПУ
	               |ИЗ
	               |	РегистрНакопления.РасчетПоказанийПриборовУчета.ОстаткиИОбороты(, , Авто, , ОбъектУстановки В (&ЛицевыеСчета)) КАК РасчетПоказанийПриборовУчетаОстаткиИОбороты
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	УстановленныеПриборыУчетаСрезПоследних.ПриборУчета
	               |ИЗ
	               |	РегистрСведений.УстановленныеПриборыУчета.СрезПоследних(&ДатаОкончания, ОбъектУстановки В (&ЛицевыеСчета)) КАК УстановленныеПриборыУчетаСрезПоследних
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	ПриборУчета
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ПоказанияПриборовУчетаСрезПоследних.ПриборУчета КАК ПриборУчета,
	               |	СУММА(ПоказанияПриборовУчетаСрезПоследних.Значение) КАК ТекущиеПоказания,
	               |	СУММА(0) КАК ПредыдущиеПоказания,
	               |	ПоказанияПриборовУчетаСрезПоследних.ВидТарифа КАК ВидТарифа
	               |ПОМЕСТИТЬ ПУ
	               |ИЗ
	               |	РегистрСведений.ПоказанияПриборовУчета.СрезПоследних(
	               |			&ДатаОкончания,
	               |			ПриборУчета В
	               |				(ВЫБРАТЬ
	               |					ОПУ.ПриборУчета
	               |				ИЗ
	               |					ОПУ КАК ОПУ)) КАК ПоказанияПриборовУчетаСрезПоследних
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ПоказанияПриборовУчетаСрезПоследних.ПриборУчета,
	               |	ПоказанияПриборовУчетаСрезПоследних.ВидТарифа
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ПоказанияПриборовУчетаСрезПоследних.ПриборУчета,
	               |	СУММА(0),
	               |	СУММА(ПоказанияПриборовУчетаСрезПоследних.Значение),
	               |	ПоказанияПриборовУчетаСрезПоследних.ВидТарифа
	               |ИЗ
	               |	РегистрСведений.ПоказанияПриборовУчета.СрезПоследних(
	               |			ДОБАВИТЬКДАТЕ(КОНЕЦПЕРИОДА(&ДатаОкончания, МЕСЯЦ), ДЕНЬ, -1),
	               |			ПриборУчета В
	               |				(ВЫБРАТЬ
	               |					ОПУ.ПриборУчета
	               |				ИЗ
	               |					ОПУ КАК ОПУ)) КАК ПоказанияПриборовУчетаСрезПоследних
	               |ГДЕ
	               |	ПоказанияПриборовУчетаСрезПоследних.Период < КОНЕЦПЕРИОДА(&ДатаОкончания, МЕСЯЦ)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ПоказанияПриборовУчетаСрезПоследних.ПриборУчета,
	               |	ПоказанияПриборовУчетаСрезПоследних.ВидТарифа
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	ПриборУчета
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	РасчетыПоЛицевымСчетам.ЛицевойСчет КАК ЛицевойСчет,
	               |	РасчетыПоЛицевымСчетам.Услуга КАК Услуга,
	               |	СУММА(ВЫБОР
	               |			КОГДА РасчетыПоЛицевымСчетам.ВидНачисления = ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Начисление)
	               |					ИЛИ РасчетыПоЛицевымСчетам.ВидНачисления = ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.РазовоеНачисление)
	               |				ТОГДА РасчетыПоЛицевымСчетам.Сумма
	               |			ИНАЧЕ 0
	               |		КОНЕЦ) КАК Начисление,
	               |	СУММА(ВЫБОР
	               |			КОГДА РасчетыПоЛицевымСчетам.ВидНачисления = ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Пени)
	               |				ТОГДА РасчетыПоЛицевымСчетам.Сумма
	               |			ИНАЧЕ 0
	               |		КОНЕЦ) КАК Пени,
	               |	СУММА(ВЫБОР
	               |			КОГДА РасчетыПоЛицевымСчетам.ВидНачисления = ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Субсидия)
	               |				ТОГДА РасчетыПоЛицевымСчетам.Сумма
	               |			ИНАЧЕ 0
	               |		КОНЕЦ) КАК Субсидия,
	               |	СУММА(ВЫБОР
	               |			КОГДА РасчетыПоЛицевымСчетам.ВидНачисления = ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Льгота)
	               |				ТОГДА РасчетыПоЛицевымСчетам.Сумма
	               |			ИНАЧЕ 0
	               |		КОНЕЦ) КАК Льгота,
	               |	СУММА(ВЫБОР
	               |			КОГДА РасчетыПоЛицевымСчетам.ВидНачисления = ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Перерасчет)
	               |				ТОГДА РасчетыПоЛицевымСчетам.Сумма
	               |			ИНАЧЕ 0
	               |		КОНЕЦ) КАК Перерасчет,
	               |	СУММА(ВЫБОР
	               |			КОГДА РасчетыПоЛицевымСчетам.ВидНачисления = ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Корректировка)
	               |				ТОГДА РасчетыПоЛицевымСчетам.Сумма
	               |			ИНАЧЕ 0
	               |		КОНЕЦ) КАК Корректировка,
