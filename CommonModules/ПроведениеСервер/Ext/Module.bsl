// Выполняет движения регистра сведений  
Процедура ОтразитьОперацииУведомления(ЛицевыеСчета,МесяцНачисления,Операция) Экспорт
	
	Индекс = 0;
	
	Если Операция = "Квитанция" тогда
		ОперацияЗапись = Перечисления.ВидыОперацийУведомления.Квитанция;
	ИначеЕсли Операция = "ЭлектронноеПисьмо" Тогда
		ОперацияЗапись = Перечисления.ВидыОперацийУведомления.ЭлекторрноеПисьмо; 
	ИначеЕсли Операция = "СообщениеСМС" Тогда
		ОперацияЗапись = Перечисления.ВидыОперацийУведомления.СообщениеСМС;
	КонецЕсли;
	
	
	НаборЗаписей = РегистрыСведений.РегистрУведомлений.СоздатьНаборЗаписей();
	НаборЗаписей.Прочитать();
	
	
	Пока Индекс <= ЛицевыеСчета.ВГраница() Цикл
		Запись = НаборЗаписей.Добавить();
		Запись.Период = ТекущаяДата();
		Если не ОперацияЗапись = Перечисления.ВидыОперацийУведомления.СообщениеСМС Тогда
			Запись.ЛицевойСчет = ЛицевыеСчета[Индекс].Ссылка;
		Иначе
			Запись.ЛицевойСчет = ЛицевыеСчета[Индекс].ЛицевойСчет.Ссылка;
			Запись.МесяцНачисления = МесяцНачисления;
		КонецЕсли;
		Запись.Операция = ОперацияЗапись;
		Если ОперацияЗапись = Перечисления.ВидыОперацийУведомления.СообщениеСМС Тогда
			Запись.ИдентификаторСообщения = СокрЛП(ЛицевыеСчета[Индекс].ИдентификаторСообщения);
			Запись.СтатусСМС = ЛицевыеСчета[Индекс].СтатусСМС;
		Иначе
			Запись.ИдентификаторСообщения = "";
			Запись.СтатусСМС = "";
		КонецЕсли;
		
		Запись.Количество = 1;
		Индекс = Индекс+1;
	КонецЦикла;
	НаборЗаписей.Записывать = Истина;
	НаборЗаписей.Записать();
	
КонецПроцедуры

