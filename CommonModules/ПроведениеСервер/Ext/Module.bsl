// Выполняет движения регистра сведений НазначенныеУслуги.
//
Процедура ОтразитьНазначенныеУслуги(ДополнительныеСвойства, Движения, Отказ) Экспорт
	
	ТаблицаНазначенныеУслуги = ДополнительныеСвойства.ТаблицыДляДвижений.ТаблицаНазначенныеУслуги;
	
	Если Отказ
	 ИЛИ ТаблицаНазначенныеУслуги.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ДвиженияНазначенныеУслуги = Движения.НазначенныеУслуги;
	ДвиженияНазначенныеУслуги.Записывать = Истина;
	ДвиженияНазначенныеУслуги.Загрузить(ТаблицаНазначенныеУслуги);
	
КонецПроцедуры


