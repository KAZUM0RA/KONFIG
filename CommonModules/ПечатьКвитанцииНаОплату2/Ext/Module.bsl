						ИЛИ ОбластьСтрокаУслуг.Параметры.Долг <> 0 
						ИЛИ Начислено <> 0
						ИЛИ ОбластьСтрокаУслуг.Параметры.Оплаты <> 0 Тогда
						
						ТабличныйДокумент.Вывести(ОбластьСтрокаУслуг);
					КонецЕсли;
					
					Долгпериода = Неопределено;
					
				КонецЦикла;
				
				УслугаСчетчика = "";
				Для каждого Строка Из Таблица Цикл
					ОбластьСтрокаУслуг = Макет.ПолучитьОбласть("СтрокаУслуг");
					Если Строка.ТекущиеПоказания <> 0 Тогда // если нет текущих показаний тогда и выводить нечего	
						//Если ПервыйСчетчик Тогда
						//	ОбластьШапкаСчетчика = Макет.ПолучитьОбласть("ШапкаОбщиеПоказателиСчетчика");
						//	
						//	ТабличныйДокумент.Вывести(ОбластьШапкаСчетчика);
						//	ПервыйСчетчик = Ложь;
						//КонецЕсли;
						
						//ОбластьПриборы = Макет.ПолучитьОбласть("СтрокаСчетчиков");
						ОбластьСтрокаУслуг.Параметры.НаименованиеУслуг = Строка.Услуга;
						ОбластьСтрокаУслуг.Параметры.Счетчик = Строка.Счетчик;
						//ОбластьПриборы.Параметры.Коэффициент = Строка.Коэффициент;
						ОбластьСтрокаУслуг.Параметры.ЕдИзмер = Строка.ЕдИзм;
						ОбластьСтрокаУслуг.Параметры.Тариф = Строка.Тариф;
						ОбластьСтрокаУслуг.Параметры.Поточные = Строка.ТекущиеПоказания;
						ОбластьСтрокаУслуг.Параметры.Предыдущие = Строка.ПредыдущиеПоказания;
						ОбластьСтрокаУслуг.Параметры.Разница = Строка.ТекущиеПоказания - Строка.ПредыдущиеПоказания;	
						
						Если УслугаСчетчика  = "" Тогда
							УслугаСчетчика = Строка.Услуга;
							ОбластьСтрокаУслуг.Параметры.НачисленоГрн = Строка.Начисление;
							ОбластьСтрокаУслуг.Параметры.Долг = Строка.Долг;
							ОбластьСтрокаУслуг.Параметры.Оплаты = Строка.Оплаты;
							ОбластьСтрокаУслуг.Параметры.Пересчет = Строка.Корректировка;
							КОплатеПоПрибору = ОбластьСтрокаУслуг.Параметры.НачисленоГрн + Строка.Долг - Строка.Оплаты + Строка.Корректировка;
							ОбластьСтрокаУслуг.Параметры.НачисленоКОплате =  ?(КОплатеПоПрибору<0,0,КОплатеПоПрибору);
							НоваяСтрока = ТаблицаДляРасчетаИтогов.Добавить();
							НоваяСтрока.КОплате = ?(КОплатеПоПрибору<0,0,КОплатеПоПрибору);
						ИначеЕсли УслугаСчетчика <> Строка.Услуга Тогда 
							УслугаСчетчика = Строка.Услуга;
							ОбластьСтрокаУслуг.Параметры.НачисленоГрн = Строка.Начисление;
							ОбластьСтрокаУслуг.Параметры.Долг = Строка.Долг;
							ОбластьСтрокаУслуг.Параметры.Оплаты = Строка.Оплаты;
							ОбластьСтрокаУслуг.Параметры.Пересчет = Строка.Корректировка;
							КОплатеПоПрибору = ОбластьСтрокаУслуг.Параметры.НачисленоГрн + Строка.Долг - Строка.Оплаты+Строка.Корректировка;
							ОбластьСтрокаУслуг.Параметры.НачисленоГрн =  ?(КОплатеПоПрибору<0,0,КОплатеПоПрибору);
							НоваяСтрока = ТаблицаДляРасчетаИтогов.Добавить();
							НоваяСтрока.КОплате = ?(КОплатеПоПрибору<0,0,КОплатеПоПрибору);
						КонецЕсли;
						
						//ТабличныйДокумент.Вывести(ОбластьПриборы);
						ТабличныйДокумент.Вывести(ОбластьСтрокаУслуг);
					КонецЕсли;	
					
				КонецЦикла;
				
				
				Если ЕстьРеструктуризация Тогда
					//РЕструкткризацияДолга
					ОбластьРеструкткризации = Макет.ПолучитьОбласть("ОбластьРеструктуризации");
					СтруктураПоиска = Новый Структура("ЛицевойСчет");
					СтруктураПоиска.ЛицевойСчет  = ВыборкаЛицевойСчет.ЛицевойСчет;
					
					Пока ВыборкаПоРеструктуризацииДолга.НайтиСледующий(СтруктураПоиска) Цикл
						
						
						СуммаОстатокПоРеструктуризации = ВыборкаПоРеструктуризацииДолга.ОстатокРеструктуризации;
						
						Если СуммаОстатокПоРеструктуризации <> 0 Тогда
							
							ОплаченоПлан = ПолучитьПредполагаемыеОплатыПоРеструктуризации(ТекущийДокумент, МесяцНачислений);
							ОплаченоФакт = ВыборкаПоРеструктуризацииДолга.Оплаты;
							
							ЗадолженностьПоРеструктуризации = ОплаченоПлан - ОплаченоФакт;
							ЗначениеРеструктуризацииДолга = ВыборкаПоРеструктуризацииДолга.СуммаПлатежа;
							
							Если ЗадолженностьПоРеструктуризации < 0 Тогда
								ЗадолженностьПоРеструктуризации = 0;
							КонецЕсли;	
							ОстатокПоРеструктуризации =  СуммаОстатокПоРеструктуризации - ЗадолженностьПоРеструктуризации;
							
							Если ОстатокПоРеструктуризации >= ЗначениеРеструктуризацииДолга Тогда
								МесячнаяПлатаПоРеструктуризации = ЗначениеРеструктуризацииДолга;
							иначе
								МесячнаяПлатаПоРеструктуризации = ОстатокПоРеструктуризации;
							КонецЕсли;  
							
							ОбластьРеструкткризации.Параметры.СуммаРеструктуризации = МесячнаяПлатаПоРеструктуризации;
							ОбластьРеструкткризации.Параметры.ОстатокРеструктуризации = ?(ОстатокПоРеструктуризации = 0,ВыборкаПоРеструктуризацииДолга.ОбщаяСумма,ОстатокПоРеструктуризации) ;
							
							ТабличныйДокумент.Вывести(ОбластьРеструкткризации);
							
							Если ЗадолженностьПоРеструктуризации <> 0 Тогда
								ОбластьЗадолженностиПореструктуризации = Макет.ПолучитьОбласть("ДолгПоРесруктуризации");
								ОбластьЗадолженностиПореструктуризации.Параметры.Задолженность = ЗадолженностьПоРеструктуризации;
								
								ТабличныйДокумент.Вывести(ОбластьЗадолженностиПореструктуризации);	
							КонецЕсли;	
							Прервать;
						КонецЕсли;
					КонецЦикла;
				Иначе
					МесячнаяПлатаПоРеструктуризации = 0;
					ЗадолженностьПоРеструктуризации = 0;
				КонецЕсли;
				
				
				Если ИспользуютсяАвансовыеПлатежи Тогда
					
					ОбластьАвансовыхПлатежейШапка = Макет.ПолучитьОбласть("ШапкаТаблицыАвансов");
					ТабличныйДокумент.Вывести(ОбластьАвансовыхПлатежейШапка);
					Пока ВыборкаАвансовыхПлатежей.Следующий() Цикл
						ОбластьАвансовыхПлатежей = Макет.ПолучитьОбласть("АвансовыйПлатеж");
						ОбластьАвансовыхПлатежей.Параметры.РесурснаяУслуга = ВыборкаАвансовыхПлатежей.Услуга;
						ОбластьАвансовыхПлатежей.Параметры.СуммаАвансовогоПлатежа = ВыборкаАвансовыхПлатежей.СуммаАванса;
						АвансовыйПлатежВсего = АвансовыйПлатежВсего + ВыборкаАвансовыхПлатежей.СуммаАванса;
						Если ВыборкаАвансовыхПлатежей.СуммаАванса <> 0 Тогда
							ТабличныйДокумент.Вывести(ОбластьАвансовыхПлатежей);
						КонецЕсли;
						
					КонецЦикла;
					
				КонецЕсли;	
				
				
				Долг =?(НЕ ПризнакАванса,Остаток,0);
				Аванс =?(НЕ ПризнакАванса,0,Остаток); 
				
				Если ИспользуютсяАвансовыеПлатежи Тогда
					ОбластьПодвалОсновной = Макет.ПолучитьОбласть("ПодвалОсновнойЧастиАвансовый");
					//ОбластьПодвалОсновной.Параметры.АвансовыйПлатежВсего = АвансовыйПлатежВсего;
					//ОбластьПодвалОсновной.Параметры.Долг = Долг; 
					//ОбластьПодвалОсновной.Параметры.Аванс =Аванс;
					//ОбластьПодвалОсновной.Параметры.Начислено = НачисленоВсего;
					//ОбластьПодвалОсновной.Параметры.АвансовыйПлатежВсего = АвансовыйПлатежВсего;
					//ОбластьПодвалОсновной.Параметры.Долг = Долг; 
					//ОбластьПодвалОсновной.Параметры.Аванс =Аванс;
					//ОбластьПодвалОсновной.Параметры.Начислено = НачисленоВсего;

				Иначе	
					ОбластьПодвалОсновной = Макет.ПолучитьОбласть("ПодвалОсновнойЧасти");
					//ОбластьПодвалОсновной.Параметры.Долг = Остаток; 
					//ОбластьПодвалОсновной.Параметры.НачисленоГрнВсего =НачисленоГрнВсего;
					//ОбластьПодвалОсновной.Параметры.ЛьготаВсего = Льгота;
					//ОбластьПодвалОсновной.Параметры.СубсидияВсего = Субсидия;
					//ОбластьПодвалОсновной.Параметры.Перерасчеты = Корректировка+Перерасчет;
					//ОбластьПодвалОсновной.Параметры.Начислено = НачисленоВсего;

					//ОбластьПодвалОсновной.Параметры.Долг = Остаток; 
					//ОбластьПодвалОсновной.Параметры.НачисленоГрнВсего =НачисленоГрнВсего;
					//ОбластьПодвалОсновной.Параметры.ЛьготаВсего = Льгота;
					//ОбластьПодвалОсновной.Параметры.СубсидияВсего = Субсидия;
					//ОбластьПодвалОсновной.Параметры.Перерасчеты = Корректировка+Перерасчет;
					//ОбластьПодвалОсновной.Параметры.Начислено = НачисленоВсего;
				КонецЕсли;
				ОбластьПодвалОсновной.Параметры.НазанчениеПлатежа = НазначениеПлатежа;
				ОбластьПодвалОсновной.Параметры.ЛицевойСчет = ТекущийДокумент;;
				Попытка
					
					ОбластьПодвалОсновной.Параметры.Плательщик = РегистрыСведений.ОтветственныйВладелецЛицевогоСчета.СрезПоследних(ТекущаяДата(),Новый Структура("ЛицевойСчет",ТекущийДокумент))[0].ОтветственныйВладелец.Наименование;
				Исключение
				КонецПопытки;
				ОбластьПодвалОсновной.Параметры.Оплата = Оплаты;
				ОбластьПодвалОсновной.Параметры.Всего = Всего + МесячнаяПлатаПоРеструктуризации + ЗадолженностьПоРеструктуризации;				
				ТабличныйДокумент.Вывести(ОбластьПодвалОсновной);
			КонецЦикла;
		КонецЦикла;
		
		ПечататьСообщение = Константы.ПечататьОпевещениеВКвитанции.Получить();
		
		Если ПечататьСообщение Тогда
			
			//Подвал1
			ОбластьПодвал1 = Макет.ПолучитьОбласть("Подвал1");
			ОбластьПодвал1.Параметры.ЄДРПОУ = ТекущийДокумент.Владелец.Организация.КодПоЕДРПОУ;
			ОбластьПодвал1.Параметры.Получатель = ТекущийДокумент.Владелец.Организация.НаименованиеПолное;
			ОбластьПодвал1.Параметры.МесяцНачисления = Формат(МесяцНачислений,?(КодЯзыкаПечать="uk","Л=uk_UA; ДФ='MMMM yyyy р.'","ДФ='MMMM yyyy"" г.""'"));
			ТабличныйДокумент.Вывести(ОбластьПодвал1);
			
			//Банковский Счет Подвал
			Для каждого Строка Из БанковскиеСчетаОрганизации Цикл
				
				Если Строка.Печать  Тогда
					ОбластьБанковскийСчет = Макет.ПолучитьОбласть("БанковскийСчетПодвал");
					ОбластьБанковскийСчет.Параметры.Рр = ПолучитьПредставлениеБанковскогоСчета(Строка.БанковскийСчет);
					ОбластьБанковскийСчет.Параметры.Банк = Строка.БанковскийСчет.Банк.Наименование;
					ОбластьБанковскийСчет.Параметры.МФО = Строка.БанковскийСчет.Банк.Код;
					
					ТабличныйДокумент.Вывести(ОбластьБанковскийСчет);
				КонецЕсли;
				
			КонецЦикла; 
			
			//ПОДВАЛ
			Если НЕ ИспользуютсяАвансовыеПлатежи Тогда
				
				ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
				ОбластьПодвал.Параметры.МесяцНачисления = Формат((МесяцНачислений),?(КодЯзыкаПечать="uk","Л=uk_UA; ДФ='MMMM yyyy р.'","ДФ='ММММ гггг"" г.""'"));	
				ОбластьПодвал.Параметры.Начислено = НачисленоВсего;
				ОбластьПодвал.Параметры.Долг = Долг;
				ОбластьПодвал.Параметры.Оплата = Оплаты;
				ОбластьПодвал.Параметры.Всего = Всего+МесячнаяПлатаПоРеструктуризации+ЗадолженностьПоРеструктуризации;
				ОбластьПодвал.Параметры.ЛицевойСчет = ТекущийДокумент;
				ОбластьПодвал.Параметры.МесяцНачисленияСлед = Формат((МесяцНачислений+500000),?(КодЯзыкаПечать="uk","Л=uk_UA; ДФ='MM.yyyy р.'","ДФ='ММ.гг"" г.""'"));
				ОбластьПодвал.Параметры.Адрес = ПолучитьПредставлениеАдреса(АдресМасс, Квартира, КодЯзыкаПечать);
				ОбластьПодвал.Параметры.НазанчениеПлатежа = НазначениеПлатежа;

				Попытка
					ОбластьПодвал.Параметры.Плательщик = РегистрыСведений.ОтветственныйВладелецЛицевогоСчета.СрезПоследних(ТекущаяДата(),Новый Структура("ЛицевойСчет",ТекущийДокумент))[0].ОтветственныйВладелец.Наименование;
				Исключение
				КонецПопытки;
				
				Для Каждого Строка Из ВыборкаПлощади Цикл
					Если Строка.ВидПлощади = Справочники.ВидыПлощадей.ОтапливаемаяПлощадь Тогда
						ОбластьПодвал.Параметры.ПлощадьОтоп = Строка.Площадь;
					ИначеЕсли Строка.ВидПлощади = Справочники.ВидыПлощадей.ОбщаяПлощадь Тогда
						ОбластьПодвал.Параметры.ПлощадьВся = Строка.Площадь;
					КонецЕсли;
				КонецЦикла;
				
				ОбластьПодвал.Параметры.КолЧеловек = ВыборкаКолПроживающих.КоличествоПроживающих;
				ОбластьПодвал.Параметры.КоличествоМестПаркинг = ВыборкаМашиномест.КоличествоМашиноМест;
				
				ТабличныйДокумент.Вывести(ОбластьПодвал);
			Иначе
				ОбластьПодвал = Макет.ПолучитьОбласть("Подвал2");
				ОбластьПодвал.Параметры.МесяцНачисления = Формат((МесяцНачислений),?(КодЯзыкаПечать="uk","Л=uk_UA; ДФ='MMMM yyyy р.'","ДФ='ММММ гггг"" г.""'"));	
				ОбластьПодвал.Параметры.Начислено = НачисленоВсего;
				
				
				ОбластьПодвал.Параметры.Долг = Долг;
//{{MRG[ <-> ]
//{{MRG[ <-> ]
				//ОбластьПодвал.Параметры.Аванс = Аванс;
				//ОбластьПодвал.Параметры.АвансовыйПлатеж = АвансовыйПлатежВсего;  
//}}MRG[ <-> ]
