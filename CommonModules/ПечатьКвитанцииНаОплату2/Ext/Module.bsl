	               |	И РасчетыПоСубсидиям.ЛицевойСчет В(&ЛицевыеСчета)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	РасчетыПоСубсидиям.ЛицевойСчет,
	               |	РасчетыПоСубсидиям.Услуга,
	               |	РасчетыПоСубсидиям.МесяцНачисления";
	
	Запрос.УстановитьПараметр("ЛицевыеСчета", ЛицевыеСчета);
	Запрос.УстановитьПараметр("МесяцНачисления", МесяцНачисления);
	
	Результат = Запрос.ВыполнитьПакет();
	
	Возврат Результат;
	
КонецФункции


Функция ПечатьКвитанцииНаОплатуИСХОДНАЯ(ТекущийДокумент, ТабличныйДокумент, МесяцНачислений, БанковскиеСчетаОрганизации) Экспорт 
	
	ГлобальнаяВыборка = ПолучитьОбщуюСтруктуруКвитанции(ТекущийДокумент, МесяцНачислений);
	// Заполнение таблицы
	ЕстьРеструктуризация = НЕ ГлобальнаяВыборка[9].Пустой();
	ВыборкаОрганизация = ГлобальнаяВыборка[5].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВыборкаПриборыУчета = ГлобальнаяВыборка[4].Выбрать();
	Если ЕстьРеструктуризация Тогда;
		ВыборкаОбщийОстаток = ГлобальнаяВыборка[3].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Иначе
		ВыборкаОбщийОстаток = ГлобальнаяВыборка[8].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	КонецЕсли;
	
	ВыборкаАвансовыхПлатежей = ГлобальнаяВыборка[6].Выбрать();
	ВыборкаПоРеструктуризацииДолга = ГлобальнаяВыборка[7].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВыборкаОстатокПоУслугам = ГлобальнаяВыборка[8].Выгрузить();
	ВыборкаГраницаСубсидии = ГлобальнаяВыборка[10].Выбрать();

	
	Макет =  ПолучитьОбщийМакет("МакетКвитанцииНаОплату");
	
	ЕСЛИ НЕ ГлобальнаяВыборка[5].Пустой() Тогда
		Пока ВыборкаОрганизация.Следующий() Цикл
			
			
			
			ИспользуютсяАвансовыеПлатежи = ПолучитьФункциональнуюОпцию("ИспользоватьАвансовыеПлатежи");
			АвансовыйПлатежВсего = 0;
			ВыборкаПриборыУчета.Сбросить();
			ТаблицаДляРасчетаИтогов = Новый ТаблицаЗначений;
			ТаблицаДляРасчетаИтогов.Колонки.Добавить("КОплате");
			ТаблицаДляРасчетаИтогов.Очистить();
			
			
			ЗначениеРеструктуризацииДолга = 0;
			ЗадолженностьПоРеструктуризации = 0;
			МесячнаяПлатаПоРеструктуризации = 0;
			
			//Получаем настройки печати квитанции
			КодЯзыкаПечать = Локализация.ПолучитьЯзыкФормированияПечатныхФорм();	
			Макет.КодЯзыкаМакета = КодЯзыкаПечать;
			
			//Для удобства накапливаем переменные
			Квартира = ТекущийДокумент.ОбъектЛицевогоСчета;
			
			
			//Создадим адрес в необходимои формате
			АдресМасс = РазложитьСтрокуВМассивПодстрок(ТекущийДокумент.Владелец.Наименование);
			
			
			//ШАПКА
			ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
			ОбластьШапка.Параметры.МесяцНачисления = Формат(МесяцНачислений,?(КодЯзыкаПечать="uk","Л=uk_UA; ДФ='MMMM yyyy р.'","ДФ='MMMM yyyy"" г.""'"));
			ОбластьШапка.Параметры.Получатель =ВыборкаОрганизация.Организация.НаименованиеПолное;
			ОбластьШапка.Параметры.ЄДРПОУ = ВыборкаОрганизация.Организация.КодПоЕДРПОУ;
			
			ТабличныйДокумент.Вывести(ОбластьШапка);
			
			//БанковскийСчет
			Для каждого Строка Из БанковскиеСчетаОрганизации Цикл
				Если Строка.Печать Тогда
					Если ВыборкаОрганизация.Организация = Строка.БанковскийСчет.Владелец Тогда
						ОбластьБанковскийСчет = Макет.ПолучитьОбласть("БанковскийСчет");
						ОбластьБанковскийСчет.Параметры.Рр = ПолучитьПредставлениеБанковскогоСчета(Строка.БанковскийСчет);
						ОбластьБанковскийСчет.Параметры.Банк = Строка.БанковскийСчет.Банк.Наименование;
//{{MRG[ <-> ]
						//ОбластьБанковскийСчет.Параметры.МФО = Строка.БанковскийСчет.Банк.Код;
//}}MRG[ <-> ]
//{{MRG[ <-> ]
//						ОбластьБанковскийСчет.Параметры.МФО = Строка.БанковскийСчет.Банк.Код;
//}}MRG[ <-> ]
						
						ТабличныйДокумент.Вывести(ОбластьБанковскийСчет);
					КонецЕсли;
					
				КонецЕсли;
			КонецЦикла; 
			
			//ШапкаОсновнойЧасти 
			ВыборкаПлощади = РегистрыСведений.ПлощадьОбъектовЛицевыхСчетов.СрезПоследних(НачалоМесяца(МесяцНачислений),Новый Структура("Помещение", Квартира));
			
			ОбластьШапкаОсновнойЧасти = Макет.ПолучитьОбласть("ШапкаОсновнойЧасти");
			Для Каждого Строка Из ВыборкаПлощади Цикл
				Если Строка.ВидПлощади = Справочники.ВидыПлощадей.ОтапливаемаяПлощадь Тогда
					ОбластьШапкаОсновнойЧасти.Параметры.ПлощадьОтоп = Строка.Площадь;
				ИначеЕсли Строка.ВидПлощади = Справочники.ВидыПлощадей.ОбщаяПлощадь Тогда
					ОбластьШапкаОсновнойЧасти.Параметры.ПлощадьВся = Строка.Площадь;
				КонецЕсли;
			КонецЦикла;
			
			ВыборкаКолПроживающих = РегистрыСведений.ЛицевыеСчета.ПолучитьПоследнее(НачалоМесяца(МесяцНачислений),Новый Структура("ЛицевойСчет",ТекущийДокумент));
			ВыборкаМашиномест = РегистрыСведений.МашиноМеста.ПолучитьПоследнее(НачалоМесяца(МесяцНачислений),Новый Структура("ЛицевойСчет",ТекущийДокумент));
			Попытка
				Если Константы.ВыводитьВКвитанцияхФИО.Получить() = Истина Тогда
					Плательщик = РегистрыСведений.ОтветственныйВладелецЛицевогоСчета.СрезПоследних(ТекущаяДата(),Новый Структура("ЛицевойСчет",ТекущийДокумент))[0].ОтветственныйВладелец.Наименование; 
				Иначе
					Плательщик = "";
				КонецЕсли;
				ОбластьШапкаОсновнойЧасти.Параметры.Плательщик = Плательщик;
			Исключение
			КонецПопытки;
			
			НазначениеПлатежа = ТекущийДокумент.Владелец.ТекстНазначенияПлатежа;
			ОбластьШапкаОсновнойЧасти.Параметры.КолЧеловек = ВыборкаКолПроживающих.КоличествоПроживающих;
			
//{{MRG[ <-> ]
			//ОбластьШапкаОсновнойЧасти.Параметры.КоличествоМестПаркинг = ВыборкаМашиномест.КоличествоМашиноМест;
//}}MRG[ <-> ]
//{{MRG[ <-> ]
//			ОбластьШапкаОсновнойЧасти.Параметры.КоличествоМестПаркинг = ВыборкаМашиномест.КоличествоМашиноМест;
//}}MRG[ <-> ]
			ОбластьШапкаОсновнойЧасти.Параметры.ЛицевойСчет = ТекущийДокумент;
			
			Если Константы.ВыводитьАдресВКвитанциях.Получить() = Истина Тогда
				ОбластьШапкаОсновнойЧасти.Параметры.Адрес = ПолучитьПредставлениеАдреса(АдресМасс, Квартира,КодЯзыкаПечать);
			Иначе
				ОбластьШапкаОсновнойЧасти.Параметры.Адрес = ТекущийДокумент;
			КонецЕсли;
			
			
			ТабличныйДокумент.Вывести(ОбластьШапкаОсновнойЧасти);
			
			//ШапкаТаблицыУслуг
			ОбластьШапкаТаблицыУслуг = Макет.ПолучитьОбласть("ШапкаТаблицыУслуг");
//{{MRG[ <-> ]
			//ОбластьШапкаТаблицыУслуг.Параметры.Оплата = ?(КодЯзыкаПечать="ru","Сплачено у ","Сплачено у ")+ Формат(МесяцНачислений,?(КодЯзыкаПечать="uk","Л=uk_UA; ДФ='MMMM yyyy р.'","ДФ='MMMM yyyy"" г.""'"));
//}}MRG[ <-> ]
//{{MRG[ <-> ]
//			ОбластьШапкаТаблицыУслуг.Параметры.Оплата = ?(КодЯзыкаПечать="ru","Зачислено в ","Зараховано в ")+ Формат(МесяцНачислений,?(КодЯзыкаПечать="uk","Л=uk_UA; ДФ='MMMM yyyy р.'","ДФ='MMMM yyyy"" г.""'"));
//}}MRG[ <-> ]
			//ОбластьШапкаТаблицыУслуг.Параметры.ДатаДолга = Формат(ДобавитьМесяц(НачалоМесяца(ТекущаяДата()), -1), ?(КодЯзыкаПечать="uk","Л=uk_UA; ДФ='MMMM yyyy р.'","ДФ='MMMM yyyy"" р.""'"));
			//
			//ТабличныйДокумент.Вывести(ОбластьШапкаТаблицыУслуг);
			
//{{MRG[ <-> ]
//			ТабличныйДокумент.Вывести(ОбластьШапкаТаблицыУслуг);
//}}MRG[ <-> ]
			ВыборкаЛицевойСчет = ВыборкаОрганизация.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
 			Пока ВыборкаЛицевойСчет.Следующий() Цикл
				
				ВыборкаУслуга = ВыборкаЛицевойСчет.выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				
				Корректировка =  ВыборкаЛицевойСчет.Корректировка;
				Перерасчет = ВыборкаЛицевойСчет.Перерасчет;
				Субсидия = ВыборкаЛицевойСчет.Субсидия;
				Льгота = ВыборкаЛицевойСчет.Льгота;
				НачисленоГрнВсего = ВыборкаЛицевойСчет.Начисление;
				
				НачисленоВсего =  ВыборкаЛицевойСчет.Начисление + ВыборкаЛицевойСчет.Корректировка + ВыборкаЛицевойСчет.Перерасчет;
				СтруктураПоискаОбщегоОстатка = Новый Структура("ЛицевойСчет");
				СтруктураПоискаОбщегоОстатка.ЛицевойСчет  = ВыборкаЛицевойСчет.ЛицевойСчет;
				
				ПервыйСчетчик = истина;
				ОстатокНаКонецМесяца = Неопределено;
				Пока ВыборкаОбщийОстаток.НайтиСледующий(СтруктураПоискаОбщегоОстатка) Цикл
					ВыборкаОстатковОрганизация = ВыборкаОбщийОстаток.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
					Пока ВыборкаОстатковОрганизация.следующий() Цикл
						ОрганизацияОтбор = Неопределено;
						Если ВыборкаОстатковОрганизация.Организация = Справочники.Организации.ПустаяСсылка() Тогда
							ОрганизацияОтбор = ВыборкаЛицевойСчет.ЛицевойСчет.Владелец.Организация;
						Иначе
							ОрганизацияОтбор = ВыборкаОстатковОрганизация.Организация;
						КонецЕсли;	
						Если  ОрганизацияОтбор = ВыборкаЛицевойСчет.Организация  Тогда
							ОстатокНаКонецМесяца = ВыборкаОстатковОрганизация.СуммаОстаток;
							Прервать;
						КонецЕсли;
					КонецЦикла;
				КонецЦикла;
				ВыборкаОбщийОстаток.Сбросить();
				
				
				
				Если ОстатокНаКонецМесяца = Неопределено Тогда
					ОстатокНаКонецМесяца = 0;
				КонецЕсли;
				
				
				Оплаты = ВыборкаЛицевойСчет.Оплата;
				Если ЕстьРеструктуризация Тогда
					Остаток =  ОстатокНаКонецМесяца  - Корректировка - Перерасчет - ?(Субсидия<0,0,Субсидия) - ?(Льгота<0,0,Льгота);
					Всего = НачисленоВсего+Остаток;
					//ОбластьШапкаТаблицыУслуг.Параметры.Оплата = ?(КодЯзыкаПечать="ru","Сплачено у ","Сплачено у ")+ Формат(МесяцНачислений,?(КодЯзыкаПечать="uk","Л=uk_UA; ДФ='MMMM yyyy р.'","ДФ='MMMM yyyy"" г.""'"));
					ОбластьШапкаТаблицыУслуг.Параметры.ДатаДолга = ОбластьШапка.Параметры.МесяцНачисления;//Формат(ДобавитьМесяц(НачалоМесяца(ТекущаяДата()), -1), ?(КодЯзыкаПечать="uk","Л=uk_UA; ДФ='MMMM yyyy р.'","ДФ='MMMM yyyy"" р.""'"));
					ОбластьШапкаТаблицыУслуг.Параметры.Долг = Остаток;
					ТабличныйДокумент.Вывести(ОбластьШапкаТаблицыУслуг);
				ИНаче
					Остаток = ОстатокНаКонецМесяца;
					Всего = НачисленоВсего+Льгота+Субсидия + Остаток - Оплаты;
					//ОбластьШапкаТаблицыУслуг.Параметры.Оплата = ?(КодЯзыкаПечать="ru","Сплачено у ","Сплачено у ")+ Формат(МесяцНачислений,?(КодЯзыкаПечать="uk","Л=uk_UA; ДФ='MMMM yyyy р.'","ДФ='MMMM yyyy"" г.""'"));
					ОбластьШапкаТаблицыУслуг.Параметры.ДатаДолга = ОбластьШапка.Параметры.МесяцНачисления;//Формат(ДобавитьМесяц(НачалоМесяца(ТекущаяДата()), -1), ?(КодЯзыкаПечать="uk","Л=uk_UA; ДФ='MMMM yyyy р.'","ДФ='MMMM yyyy"" р.""'"));
					ОбластьШапкаТаблицыУслуг.Параметры.Долг = Остаток;
					ТабличныйДокумент.Вывести(ОбластьШапкаТаблицыУслуг);
				КонецЕсли;
				
				Если Остаток > 0 тогда
					ПризнакАванса = Ложь;
					
				Иначе
					ПризнакАванса = ИСТИНА;
					остаток = остаток;
				КонецЕсли;
				
				
				
				Таблица = Новый ТаблицаЗначений;
				Таблица.Колонки.Добавить("Услуга",,"Услуга");
				Таблица.Колонки.Добавить("Счетчик",,"Счетчик");
				Таблица.Колонки.Добавить("Коэффициент",,"Коэффициент");
				Таблица.Колонки.Добавить("ЕдИзм",,"ЕдИзм");
				Таблица.Колонки.Добавить("Тариф",,"Тариф");
				Таблица.Колонки.Добавить("Норма",,"Норма");
				Таблица.Колонки.Добавить("Оплаты",,"Оплаты");
				Таблица.Колонки.Добавить("Долг",,"Долг");
				Таблица.Колонки.Добавить("ТекущиеПоказания",,"ТекущиеПоказания");
				Таблица.Колонки.Добавить("ПредыдущиеПоказания",,"ПредыдущиеПоказания");
				Таблица.Колонки.Добавить("Начисление",,"Начисление");
				Таблица.Колонки.Добавить("Льгота",,"Льгота");
				Таблица.Колонки.Добавить("Субсидия",,"Субсидия");
				Таблица.Колонки.Добавить("КоличествоЕдиниц",,"КоличествоЕдиниц");
				Таблица.Колонки.Добавить("Корректировка",,"Корректировка");
				Таблица.Колонки.Добавить("ГраницаСубсидии",,"ГраницаСубсидии");
				Таблица.Колонки.Добавить("Неустойка",, "Неустойка");
				Таблица.Колонки.Добавить("Пеня",, "Пеня");
				
				
				Пока ВыборкаУслуга.Следующий() Цикл
					
					СтруктураПоискаПриборов = Новый Структура("ОбъектУстановки, Услуга");
					СтруктураПоискаПриборов.ОбъектУстановки = ВыборкаУслуга.ЛицевойСчет;
					СтруктураПоискаПриборов.Услуга = ВыборкаУслуга.Услуга;
					Марк = Истина;
					НоваяУслуга = "";
					СтараяУслуга = "";
					ПОКА ВыборкаПриборыУчета.НайтиСледующий(СтруктураПоискаПриборов) Цикл
						
						КорректировкаПоПрибору = 0;
						ПерерасчетПоприбору = 0;
						
						
						НоваяУслуга = ВыборкаУслуга.Услуга;
						Строка = Таблица.Добавить();
//{{MRG[ <-> ]
						Строка.Услуга = ВыборкаУслуга.Услуга.ПолноеНаименование;
//}}MRG[ <-> ]
//{{MRG[ <-> ]
//						Строка.Услуга = ВыборкаУслуга.Услуга;
//}}MRG[ <-> ]
						Строка.Счетчик = ВыборкаПриборыУчета.ЗаводскойНомер+"/"+ВыборкаПриборыУчета.ВидУслуги;
						Строка.Коэффициент = ВыборкаПриборыУчета.ПриборУчетаКоэффициент;
						Строка.ЕдИзм = ВыборкаУслуга.ЕдиницаИзмерения;
						
						ВыборкаТариф = ВыборкаУслуга.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
						Тариф = "";
						КоличествоЕдиниц = 0;
						Пока ВыборкаТариф.Следующий() Цикл
							Если Тариф = "" Тогда
