					СтруктураПоискаДолгаПоУслуге = Новый Структура("ЛицевойСчет, Услуга");
					СтруктураПоискаДолгаПоУслуге.ЛицевойСчет = ВыборкаУслуга.ЛицевойСчет;
					СтруктураПоискаДолгаПоУслуге.Услуга = ВыборкаУслуга.Услуга;
					
					НайденныеСтроки = ВыборкаОстатокПоУслугам.НайтиСтроки(СтруктураПоискаДолгаПоУслуге);
					Если НайденныеСтроки.Количество() >  0  Тогда
						Долгпериода = НайденныеСтроки[0].СуммаОстаток;
					Иначе
						Долгпериода = 0;
					КонецЕсли;
					
					Долг = Долгпериода-ВыборкаУслуга.Оплата;      //Метка
					
					ОбластьСтрокаУслуг.Параметры.Долг = Долгпериода;
					ОбластьСтрокаУслуг.Параметры.НачисленоКОплате = Начислено + Долг;
					НоваяСтрока = ТаблицаДляРасчетаИтогов.Добавить();
					НоваяСтрока.КОплате = ?((Начислено + Долг)<0,0,(Начислено + Долг));
					Если ОбластьСтрокаУслуг.Параметры.Начислено <> 0
						ИЛИ ОбластьСтрокаУслуг.Параметры.Долг <> 0 
						ИЛИ Начислено <> 0
						Тогда
						
						ТабличныйДокумент.Вывести(ОбластьСтрокаУслуг);
					КонецЕсли;
					
					Долгпериода = Неопределено;					
				КонецЦикла;
				
				УслугаСчетчика = "";
				Для каждого Строка Из Таблица Цикл
					ОбластьСтрокаУслуг = Макет.ПолучитьОбласть("СтрокаТаблицыСчетчики");
					Если Строка.ТекущиеПоказания <> 0 Тогда // если нет текущих показаний тогда и выводить нечего	
						ОбластьСтрокаУслуг.Параметры.Счетчик = Строка.Счетчик;
						ОбластьСтрокаУслуг.Параметры.ЕдИзмер = Строка.ЕдИзм;
						ОбластьСтрокаУслуг.Параметры.Тариф = Строка.Тариф;
						ОбластьСтрокаУслуг.Параметры.Поточные = Строка.ТекущиеПоказания;
						ОбластьСтрокаУслуг.Параметры.Предыдущие = Строка.ПредыдущиеПоказания;
						ОбластьСтрокаУслуг.Параметры.Разница = Строка.ТекущиеПоказания - Строка.ПредыдущиеПоказания;	
						
						Если УслугаСчетчика  = "" Тогда
							УслугаСчетчика = Строка.Услуга;
							ОбластьСтрокаУслуг.Параметры.Начислено = Строка.Начисление;
							//ОбластьСтрокаУслуг.Параметры.Долг = Строка.Долг;
							//ОбластьСтрокаУслуг.Параметры.Оплата = Строка.Оплаты;
							//ОбластьСтрокаУслуг.Параметры.Пересчет = Строка.Корректировка;
							КОплатеПоПрибору = ОбластьСтрокаУслуг.Параметры.Начислено + Строка.Долг - Строка.Оплаты + Строка.Корректировка;
							ОбластьСтрокаУслуг.Параметры.Начислено =  ?(КОплатеПоПрибору<0,0,КОплатеПоПрибору);
							НоваяСтрока = ТаблицаДляРасчетаИтогов.Добавить();
							НоваяСтрока.КОплате = ?(КОплатеПоПрибору<0,0,КОплатеПоПрибору);
						ИначеЕсли УслугаСчетчика <> Строка.Услуга Тогда 
							УслугаСчетчика = Строка.Услуга;
							ОбластьСтрокаУслуг.Параметры.Начислено = Строка.Начисление;
							//ОбластьСтрокаУслуг.Параметры.Долг = Строка.Долг;
							//ОбластьСтрокаУслуг.Параметры.Оплата = Строка.Оплаты;
							//ОбластьСтрокаУслуг.Параметры.Пересчет = Строка.Корректировка;
							КОплатеПоПрибору = ОбластьСтрокаУслуг.Параметры.Начислено + Строка.Долг - Строка.Оплаты+Строка.Корректировка;
							ОбластьСтрокаУслуг.Параметры.Начислено =  ?(КОплатеПоПрибору<0,0,КОплатеПоПрибору);
							НоваяСтрока = ТаблицаДляРасчетаИтогов.Добавить();
							НоваяСтрока.КОплате = ?(КОплатеПоПрибору<0,0,КОплатеПоПрибору);
						КонецЕсли;
						
						//ТабличныйДокумент.Вывести(ОбластьПриборы);
						ТабличныйДокумент.Вывести(ОбластьСтрокаУслуг);
					КонецЕсли;	
					
				КонецЦикла;
				
				ОбластьПодвалОсновной = Макет.ПолучитьОбласть("ПодвалОсновнойЧастиАвансовый");
				ОбластьПодвалОсновной.Параметры.НазанчениеПлатежа = НазначениеПлатежа;
				ОбластьПодвалОсновной.Параметры.ЛицевойСчет = ТекущийДокумент;;
				Попытка
					
					ОбластьПодвалОсновной.Параметры.Плательщик = РегистрыСведений.ОтветственныйВладелецЛицевогоСчета.СрезПоследних(ТекущаяДата(),Новый Структура("ЛицевойСчет",ТекущийДокумент))[0].ОтветственныйВладелец.Наименование;
				Исключение
				КонецПопытки;
				ОбластьПодвалОсновной.Параметры.Всего = Всего + МесячнаяПлатаПоРеструктуризации + ЗадолженностьПоРеструктуризации;
				ОбластьПодвалОсновной.Параметры.Оплата = Оплаты;
				ТабличныйДокумент.Вывести(ОбластьПодвалОсновной);
			КонецЦикла;
		КонецЦикла;
		
		
		
	ИНАЧЕ
		
		Всего = 0;
		Аванс = 0;
		Долг = 0;
		Оплаты = 0;
		
		СтруктураПоискаОбщегоОстатка = Новый Структура("ЛицевойСчет");
		СтруктураПоискаОбщегоОстатка.ЛицевойСчет  = ТекущийДокумент;
		
		ЕстьОстаток = Ложь;
		ОстатокНаКонецМесяца = Неопределено;
		ОбщийОстаток = 0;
		Пока ВыборкаОбщийОстаток.НайтиСледующий(СтруктураПоискаОбщегоОстатка) Цикл
			ВыборкаОстатковОрганизация = ВыборкаОбщийОстаток.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			ЕстьОстаток = Истина;
			Пока ВыборкаОстатковОрганизация.следующий() Цикл
				ОрганизацияОтбор = Неопределено;
				Если ВыборкаОстатковОрганизация.Организация = Справочники.Организации.ПустаяСсылка() Тогда
					ОрганизацияОтбор = ВыборкаЛицевойСчет.ЛицевойСчет.Владелец.Организация;
				Иначе
					ОрганизацияОтбор = ВыборкаОстатковОрганизация.Организация;
				КонецЕсли;	
				Если  ОрганизацияОтбор = ВыборкаЛицевойСчет.Организация  Тогда
					ОстатокНаКонецМесяца = ВыборкаОстатковОрганизация.СуммаОстаток;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			ОбщийОстаток = ВыборкаОбщийОстаток.СуммаОстаток;
			Если ОбщийОстаток < 0 тогда
				ОстатокНаименование = "АВАНС";
				Аванс = ОбщийОстаток;
				Долг = 0;
			Иначе
				ОстатокНаименование = НСТР("ru = 'ДОЛГ'; uk = 'БОРГ'");
				Аванс = 0;
				Долг = ОбщийОстаток;
			КонецЕсли;
			
			Всего = ОбщийОстаток;
			
			ОбластьСтрокаУслуг = Макет.ПолучитьОбласть("СтрокаТаблицыУслуги");
			ОбластьСтрокаУслуг.Параметры.НаименованиеУслуг = ОстатокНаименование;
			ОбластьСтрокаУслуг.Параметры.Долг = ОбщийОстаток;
			ОбластьСтрокаУслуг.Параметры.НачисленоКОплате = ОбщийОстаток;
			НоваяСтрока = ТаблицаДляРасчетаИтогов.Добавить();
			НоваяСтрока.КОплате = ОбщийОстаток;
			
			ТабличныйДокумент.Вывести(ОбластьСтрокаУслуг);
			
		КонецЦикла;	
		ВыборкаОбщийОстаток.Сбросить();	
		Если ЕстьОстаток Тогда
			ОбластьПодвалОсновной = Макет.ПолучитьОбласть("ПодвалОсновнойЧастиАвансовый");
			ОбластьПодвалОсновной.Параметры.ПараметрНадписиДляЗдания = ТекущийДокумент.Владелец.СопроводительныйТекстКвитанции;
			ОбластьПодвалОсновной.Параметры.Долг = Долг; 
			ОбластьПодвалОсновной.Параметры.Начислено = 0;
			ОбластьПодвалОсновной.Параметры.Оплата = 0;
			
			ОбластьПодвалОсновной.Параметры.Всего = ОбщийОстаток;
			
			ТабличныйДокумент.Вывести(ОбластьПодвалОсновной);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ТабличныйДокумент;
	
	
КонецФункции


Функция ПолучитьПредполагаемыеОплатыПоРеструктуризации(ЛицевыеСчета,МесяцНачисления)

	ЗАпрос = Новый Запрос;
	Запрос.Текст =  "ВЫБРАТЬ
	                |	ПлатежиПоРеструктуризацииДолга.ЛицевойСчет КАК ЛицевойСчет,
	                |	ПлатежиПоРеструктуризацииДолга.СуммаПлатежа КАК СуммаПлатежа
	                |ИЗ
	                |	РегистрСведений.ПлатежиПоРеструктуризацииДолга КАК ПлатежиПоРеструктуризацииДолга
	                |ГДЕ
	                |	ПлатежиПоРеструктуризацииДолга.Период <= НачалоПериода(&МесяцНачисления, МЕСЯЦ)
	                |	И ПлатежиПоРеструктуризацииДолга.ЛицевойСчет В(&ЛицевыеСчета)
	                |ИТОГИ
	                |	СУММА(СуммаПлатежа)
	                |ПО
	                |	ЛицевойСчет";
	Запрос.УстановитьПараметр("ЛицевыеСчета", ЛицевыеСчета);
	Запрос.УстановитьПараметр("МесяцНачисления", МесяцНачисления);
	
	Результат  = Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() тогда
		
	   Возврат Результат.СуммаПлатежа;
   Иначе
	   Возврат 0;
	КонецЕсли;   
	
	
КонецФункции // ПолучитьПредполагаемыеОплатыПоРеструктуризации()
 
