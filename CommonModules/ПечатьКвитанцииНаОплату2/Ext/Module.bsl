//				ОбластьПодвал.Параметры.Всего = Всего+МесячнаяПлатаПоРеструктуризации+ЗадолженностьПоРеструктуризации+АвансовыйПлатежВсего;
//}}MRG[ <-> ]
				ОбластьПодвал.Параметры.ЛицевойСчет = ТекущийДокумент;
				ОбластьПодвал.Параметры.МесяцНачисленияСлед = Формат((МесяцНачислений+500000),?(КодЯзыкаПечать="uk","Л=uk_UA; ДФ='MM.yyyy р.'","ДФ='ММ.гг"" г.""'"));
				ОбластьПодвал.Параметры.Адрес = ПолучитьПредставлениеАдреса(АдресМасс, Квартира, КодЯзыкаПечать);
				ОбластьПодвал.Параметры.НазанчениеПлатежа = НазначениеПлатежа;
				Попытка
					ОбластьПодвал.Параметры.Плательщик = РегистрыСведений.ОтветственныйВладелецЛицевогоСчета.СрезПоследних(ТекущаяДата(),Новый Структура("ЛицевойСчет",ТекущийДокумент))[0].ОтветственныйВладелец.Наименование;
