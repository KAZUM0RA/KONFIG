Функция ПечатьКвитанцииНаОплатуУпрощенная(ТекущийДокумент, ТабличныйДокумент, МесяцНачислений, БанковскиеСчетаОрганизации)Экспорт
	Макет =  ПолучитьОбщийМакет("МакетКвитанцииНаОплатуУпрощенная");
	
		
	ТаблицаДляРасчетаИтогов = Новый ТаблицаЗначений;
	ТаблицаДляРасчетаИтогов.Колонки.Добавить("КОплате");
	ТаблицаДляРасчетаИтогов.Очистить();
	
	ЗначениеРеструктуризацииДолга = 0;
	ЗадолженностьПоРеструктуризации = 0;
	МесячнаяПлатаПоРеструктуризации = 0;
	АвансовыйПлатежВсего = 0;
	Аванс = 0;
	Льгота = 0;
	
	КодЯзыкаПечать = Локализация.ПолучитьЯзыкФормированияПечатныхФорм();	
	Макет.КодЯзыкаМакета = КодЯзыкаПечать;	
	
	//Создадим адрес в необходимои формате
	АдресМасс = РазложитьСтрокуВМассивПодстрок(ТекущийДокумент.Владелец.Наименование);
	
	МассивВыводимыхОбластей = Новый Массив;
	
	//Получим выборки данных
	ГлобальнаяВыборка = ПолучитьОбщуюСтруктуруКвитанции(ТекущийДокумент, МесяцНачислений);
	
	// Заполнение таблицы
	ЕстьРеструктуризация = НЕ ГлобальнаяВыборка[9].Пустой();
	ВыборкаОрганизация = ГлобальнаяВыборка[5].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВыборкаПриборы = ГлобальнаяВыборка[4].Выбрать();
	Если ЕстьРеструктуризация Тогда;
		ВыборкаОстатков = ГлобальнаяВыборка[3].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Иначе
		ВыборкаОстатков = ГлобальнаяВыборка[8].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	КонецЕсли;
	
	ВыборкаАвансовыхПлатежей = ГлобальнаяВыборка[6].Выбрать();
	ВыборкаРеструктуризация = ГлобальнаяВыборка[7].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВыборкаОстатокПоУслугам = ГлобальнаяВыборка[8].Выгрузить();
	ВыборкаГраницаСубсидии = ГлобальнаяВыборка[10].Выбрать();
	/////////////////////////	
	
	Банки = "";
	Пока ВыборкаОрганизация.Следующий() Цикл
		ВыборкаЛицевойСчет = ВыборкаОрганизация.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаЛицевойСчет.Следующий() Цикл
			//ШАПКА
			ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
			ШтрихкодированиеПечатныхФорм.ВывестиШтрихкодВТабличныйДокумент(ТабличныйДокумент, Макет, ОбластьШапка, ТекущийДокумент.Ссылка);
			ЕДРПОУ = ?(КодЯзыкаПечать="uk"," ЄДРПОУ ","ЕДРПОУ ");
			ОбластьШапка.Параметры.Получатель = "КП ""Тепловодсервіс""  ЕДРПОУ 45136285";//ВыборкаЛицевойСчет.ЛицевойСчет.Владелец.Организация.НаименованиеПолное +ЕДРПОУ+
			//ВыборкаЛицевойСчет.ЛицевойСчет.Владелец.Организация.КодПоЕДРПОУ;
			
			Выборка = Справочники.БанковскиеСчета.Выбрать(,ВыборкаОрганизация.Организация);
			
			Для Каждого Строка Из БанковскиеСчетаОрганизации Цикл
				Если Строка.Печать Тогда
					Если Строка.БанковскийСчет.Владелец = ВыборкаОрганизация.Организация тогда					
						Банки = "UA773077700000026003711158769, АТ ""А-БАНК""";//Банки + "Р/р № " + ПолучитьПредставлениеБанковскогоСчета(Строка.БанковскийСчет) +"; "+ Строка.БанковскийСчет.Банк.Наименование +"; МФО "+ Строка.БанковскийСчет.Банк.Код + Символы.ПС;
					КонецЕсли;	
				КонецЕсли;
			КонецЦикла;
			
			Попытка
				Если Константы.ВыводитьВКвитанцияхФИО.Получить() = Истина Тогда
					Плательщик = РегистрыСведений.ОтветственныйВладелецЛицевогоСчета.СрезПоследних(ТекущаяДата(),Новый Структура("ЛицевойСчет",ТекущийДокумент))[0].ОтветственныйВладелец.Наименование;
				Иначе
					Плательщик = ВыборкаЛицевойСчет.ЛицевойСчет;
				КонецЕсли;
				
			Исключение
			КонецПопытки;
			
			НазначениеПлатежа = ВыборкаЛицевойСчет.ЛицевойСчет.Владелец.ТекстНазначенияПлатежа;
			ОбластьШапка.Параметры.рр = Банки;
			ОбластьШапка.Параметры.ЛицевойСчет = ВыборкаЛицевойСчет.ЛицевойСчет.Наименование;
			
			
			Квартира = ВыборкаЛицевойСчет.ЛицевойСчет.ОбъектЛицевогоСчета;
			Если Константы.ВыводитьАдресВКвитанциях.Получить() = Истина тогда
				Адрес = ПолучитьПредставлениеАдреса(АдресМасс, Квартира, КодЯзыкаПечать);
			Иначе 
				Адрес = "";
			КонецЕсли;
			
			ОбластьШапка.Параметры.ФИОПлатникАдрес = Строка(Плательщик)+Строка(Адрес);
			
			СтруктураПоиска = Новый Структура("ЛицевойСчет");
			СтруктураПоиска.ЛицевойСчет = ВыборкаЛицевойСчет.ЛицевойСчет;
			
			
			Пока ВыборкаОстатков.НайтиСледующий(СтруктураПоиска) Цикл
				ВыборкаОстатковОрганизация = ВыборкаОстатков.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				Пока ВыборкаОстатковОрганизация.следующий() Цикл
					ОрганизацияОтбор = Неопределено;
					Если ВыборкаОстатковОрганизация.Организация = Справочники.Организации.ПустаяСсылка() Тогда
					    ОрганизацияОтбор = ВыборкаЛицевойСчет.ЛицевойСчет.Владелец.Организация;
					Иначе
						ОрганизацияОтбор = ВыборкаОстатковОрганизация.Организация;
					КонецЕсли;	
					Если  ОрганизацияОтбор = ВыборкаЛицевойСчет.Организация  Тогда
						ОстатокНаНачалоМесяца = ВыборкаОстатковОрганизация.СуммаОстаток;
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
			ВыборкаОстатков.Сбросить();
			
			
			//Заполним базовые значения для упрощения дальнейших расчетов
			Начисленно 		= ВыборкаЛицевойСчет.Начисление;
			Льгота 			= ВыборкаЛицевойСчет.Льгота;
			Субсидия 		= ВыборкаЛицевойСчет.Субсидия;
			Перерасчет 		= ВыборкаЛицевойСчет.Перерасчет;
			Оплачено 		= ВыборкаЛицевойСчет.Оплата;
			Корректировка 	= ВыборкаЛицевойСчет.Корректировка;
			
			
			НачисленноВсего = Начисленно+Перерасчет+Корректировка;
			ОбластьШапка.Параметры.Нараховано = НачисленноВсего;
			//ОбластьШапка.Параметры.СубсидииЛьготы = Льгота+Субсидия; 
			Если ОстатокНаНачалоМесяца = Неопределено Тогда
				ОстатокНаНачалоМесяца = 0;
			КонецЕсли;
			
			Если Оплачено < 0 Тогда
				Оплачено = - Оплачено;
			КонецЕсли;	
			
			
			Оплаты = ВыборкаЛицевойСчет.Оплата;
			Если ЕстьРеструктуризация Тогда
				Остаток =  ОстатокНаНачалоМесяца  - Корректировка - Перерасчет - ?(Субсидия<0,0,Субсидия) - ?(Льгота<0,0,Льгота);
			ИНаче
				Остаток = ОстатокНаНачалоМесяца;
				
			КонецЕсли;
			
			Если Остаток < 0 Тогда
				Аванс = Остаток;
				ОбластьШапка.Параметры.ДолгПереплата = "Переплата";
				ОбластьШапка.Параметры.Долг = Аванс;//Аванс-(Аванс+Аванс);
				Долг = 0;
			Иначе
				ОбластьШапка.Параметры.ДолгПереплата = "Борг минулих переодів";
				Долг = Остаток;
				ОбластьШапка.Параметры.Долг = Долг;
				Аванс = 0;
			КонецЕсли;
			
			//ОбластьШапка.Параметры.Долг = Долг;
			//ОбластьШапка.Параметры.Аванс = Аванс;
			ОбластьШапка.Параметры.Оплата = Оплаты;
			ОбластьШапка.Параметры.Период = Формат(МесяцНачислений,?(КодЯзыкаПечать="uk","Л=uk_UA; ДФ='MMMM yyyy р.'","ДФ='MMMM yyyy"" г.""'"));
			МассивВыводимыхОбластей.Добавить(ОбластьШапка);
			ТабличныйДокумент.Вывести(ОбластьШапка);
			
			ВыборкаУслуга = ВыборкаЛицевойСчет.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			Пока ВыборкаУслуга.Следующий() Цикл 
				
				ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
				ОбластьСтрока.Параметры.Услуга = ВыборкаУслуга.Услуга.ПолноеНаименование;

				
				Если ВыборкаУслуга.Начисление = 0 И
					ВыборкаУслуга.Льгота = 0 И
					ВыборкаУслуга.Субсидия = 0 И
					ВыборкаУслуга.Перерасчет = 0 И
					ВыборкаУслуга.Корректировка = 0 Тогда
					Продолжить;
				КонецЕсли;
				
				ОбластьСтрока.Параметры.ЕдИзК = Строка(ВыборкаУслуга.ЕдиницаИзмерения);
				ОбластьСтрока.Параметры.Сумма = ВыборкаУслуга.Начисление;
				//ОбластьСтрока.Параметры.Льготы = ВыборкаУслуга.Льгота + ВыборкаУслуга.Субсидия;
				
				Если ВыборкаУслуга.Субсидия <> 0 Тогда
							
							СтруктараПоискаСубс = Новый Структура;
							СтруктараПоискаСубс.Вставить("ЛицевойСчет",ТекущийДокумент);
							СтруктараПоискаСубс.Вставить("Услуга",ВыборкаУслуга.Услуга);
							СтруктараПоискаСубс.Вставить("МесяцНачисления",НачалоМесяца(МесяцНачислений));
							
							
							Если ВыборкаГраницаСубсидии.НайтиСледующий(СтруктараПоискаСубс)  Тогда
								ОбластьСтрока.Параметры.ОбПлат = ВыборкаГраницаСубсидии.ГраницаСубсидии;
							КонецЕсли;
							ВыборкаГраницаСубсидии.Сбросить();
				КонецЕсли;
				
				ОбластьСтрока.Параметры.Корректировка = ВыборкаУслуга.Корректировка;
				ОбластьСтрока.Параметры.Пересчитано = ВыборкаУслуга.Перерасчет;
				ОбластьСтрока.Параметры.Насчитано = ВыборкаУслуга.Начисление + ВыборкаУслуга.Льгота + ВыборкаУслуга.Субсидия +ВыборкаУслуга.Корректировка+ВыборкаУслуга.Перерасчет;
				
				//В случае изменения тарифа в течение расчетного периода, отразим их все
				ВыборкаТариф = ВыборкаУслуга.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				Тариф = "";
				Маркер = Ложь;
				ОбщееКоличество = 0;
				Пока ВыборкаТариф.Следующий() Цикл
					
					Если Тариф = "" Тогда 
						
						Значение = ?(ВыборкаТариф.Тариф = 0 ,"",Строка(ВыборкаТариф.Тариф)) ;
						
					Иначе
						
						Значение = ?(ВыборкаТариф.Тариф = 0,"","\"+ Строка(ВыборкаТариф.Тариф));
						
					КонецЕсли;
					Тариф = Тариф+Значение;
					ОбластьСтрока.Параметры.Тариф = Тариф;
					
					Если НЕ Тариф ="" Тогда
						ОбластьСтрока.Параметры.ЕдИзТ = "грн./"+Строка(ВыборкаУслуга.ЕдиницаИзмерения);
					КонецЕсли;
					
					Если ВыборкаТариф.Порог  = Перечисления.ПорогиТарифовУслуг.ПустаяСсылка() и ОбщееКоличество = 0 Тогда
						Количество = ВыборкаТариф.КоличествоЕдИзм;
					ИначеЕсли  НЕ ВыборкаТариф.Порог  = Перечисления.ПорогиТарифовУслуг.ПустаяСсылка() Тогда
						ОбщееКоличество = ОбщееКоличество+ВыборкаТариф.КоличествоЕдИзм;
						Количество = ОбщееКоличество;
					КонецЕсли;
					
				КонецЦикла;	
				ОбластьСтрока.Параметры.Количество = ВыборкаУслуга.КоличествоЕдИзм;
				
				МассивВыводимыхОбластей.Добавить(ОбластьСтрока);
				ТабличныйДокумент.Вывести(ОбластьСтрока);
				
				СтруктураПоискаПриборов = Новый Структура("ОбъектУстановки, Услуга");
				СтруктураПоискаПриборов.ОбъектУстановки = ВыборкаУслуга.ЛицевойСчет;
				СтруктураПоискаПриборов.Услуга = ВыборкаУслуга.Услуга;
				
				НужнаПоверка = Ложь;
				
				Пока ВыборкаПриборы.НайтиСледующий(СтруктураПоискаПриборов) И Маркер = Ложь Цикл
					Если ВыборкаПриборы.ВидУслуги = "Холодна вода" Тогда
						Если ВыборкаПриборы.ТекущиеПоказания <> 0 Тогда // Если нет текущих показаний то и выводить нечего
							ОбластьПриборы = Макет.ПолучитьОбласть("Приборы");
							ОбластьПриборы.Параметры.Прибор = ВыборкаПриборы.ЗаводскойНомер+"/"+ВыборкаПриборы.ВидУслуги;
							ОбластьПриборы.Параметры.ПредыдущиеПоказания = ВыборкаПриборы.ПредыдущиеПоказания;
							ОбластьПриборы.Параметры.ТекущиеПоказания = ВыборкаПриборы.ТекущиеПоказания;
							ОбластьПриборы.Параметры.Разница = ВыборкаПриборы.ТекущиеПоказания - ВыборкаПриборы.ПредыдущиеПоказания; 
							МассивВыводимыхОбластей.Добавить(ОбластьПриборы);
							ТабличныйДокумент.Вывести(ОбластьПриборы);
							// Проверим нужна ли поверка прибора учета
							НужнаПоверка = ПроверитьПоверкуПрибораУчета(ВыборкаУслуга.ЛицевойСчет, ВыборкаПриборы.ПриборУчета);
							Если  НужнаПоверка <> Неопределено Тогда
								Если НужнаПоверка Тогда
									ОбластьПроверкаПрибораУчета = Макет.ПолучитьОбласть("ПроверкаПрибораУчета");
									//ДатаДляПроверки = ДобавитьМесяц(МесяцНачислений, 2);
									//ОбластьПроверкаПрибораУчета.Параметры.Дата = Формат(ДатаДляПроверки, "Л=uk_UA; ДФ=MMMM");
									ТабличныйДокумент.Вывести(ОбластьПроверкаПрибораУчета);
									МассивВыводимыхОбластей.Добавить(ОбластьПроверкаПрибораУчета);
								КонецЕсли;
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
				
				Маркер = Истина;
				
			КонецЦикла;
			
			//РЕструкткризацияДолга
			ОбластьРеструкткризации = Макет.ПолучитьОбласть("РеструктуризацияДолга"); 
			Если ВыборкаОрганизация.Организация = ВыборкаЛицевойСчет.ЛицевойСчет.Владелец.Организация Тогда
				Пока ВыборкаРеструктуризация.НайтиСледующий(СтруктураПоиска) Цикл    ///////////////////////////////////
					СуммаОстатокПоРеструктуризации = ВыборкаРеструктуризация.ОстатокРеструктуризации;
					
					Если СуммаОстатокПоРеструктуризации <> 0 тогда
						
						//СтруктураПоиска.Вставить("Услуга",Справочники.Услуги.РеструктуризацияДолга);
						
						ОплаченоПлан = ПолучитьПредполагаемыеОплатыПоРеструктуризации(ТекущийДокумент, МесяцНачислений);
						ОплаченоФакт = ВыборкаРеструктуризация.Оплаты;
						
						ЗадолженностьПоРеструктуризации = ОплаченоПлан - ОплаченоФакт;
						ЗначениеРеструктуризацииДолга = ВыборкаРеструктуризация.СуммаПлатежа;
						Если ЗадолженностьПоРеструктуризации < 0 Тогда
							ЗадолженностьПоРеструктуризации = 0;
						КонецЕсли;
						ОстатокПоРеструктуризации =  СуммаОстатокПоРеструктуризации - ЗадолженностьПоРеструктуризации;
						
						Если ОстатокПоРеструктуризации >= ЗначениеРеструктуризацииДолга Тогда
							МесячнаяПлатаПоРеструктуризации = ЗначениеРеструктуризацииДолга;
						иначе
							МесячнаяПлатаПоРеструктуризации = ОстатокПоРеструктуризации;
						КонецЕсли;  
						
						ОбластьРеструкткризации.Параметры.СуммаРеструктуризации = МесячнаяПлатаПоРеструктуризации;
						ОбластьРеструкткризации.Параметры.ДолгРеструктуризации = ?(ОстатокПоРеструктуризации = 0,ВыборкаРеструктуризация.ОбщаяСумма,ОстатокПоРеструктуризации) ;
						ТабличныйДокумент.Вывести(ОбластьРеструкткризации);
						
						Если ЗадолженностьПоРеструктуризации <> 0 Тогда
							ОбластьЗадолженностиПореструктуризации = Макет.ПолучитьОбласть("ДолгПоРесруктуризации");
							ОбластьЗадолженностиПореструктуризации.Параметры.Задолженность = ЗадолженностьПоРеструктуризации;
							ТабличныйДокумент.Вывести(ОбластьЗадолженностиПореструктуризации);	
						КонецЕсли;
					КонецЕсли;
					Прервать;
				КонецЦикла;	 
			КонецЕсли;
			
			//Авансовые платежи
			АвансовыйПлатежВсего = 0;
			Если ПолучитьФункциональнуюОпцию("ИспользоватьАвансовыеПлатежи") Тогда
				
				Пока ВыборкаАвансовыхПлатежей.Следующий() Цикл
					ОбластьАвансовыхПлатежей = Макет.ПолучитьОбласть("АвансовыйПлатеж");
					ОбластьАвансовыхПлатежей.Параметры.РесурснаяУслуга = ВыборкаАвансовыхПлатежей.Услуга;
					ОбластьАвансовыхПлатежей.Параметры.СуммаАвансовогоПлатежа = ВыборкаАвансовыхПлатежей.СуммаАванса;
					АвансовыйПлатежВсего = АвансовыйПлатежВсего + ВыборкаАвансовыхПлатежей.СуммаАванса;
					Если ВыборкаАвансовыхПлатежей.СуммаАванса <> 0 Тогда
						ТабличныйДокумент.Вывести(ОбластьАвансовыхПлатежей);
					КонецЕсли;
					
				КонецЦикла;
				
				//ИтогиПоАвансам
				ОбластьАвансовыхПлатежейИтог = Макет.ПолучитьОбласть("АвансовыйПлатежИтого");
				ОбластьАвансовыхПлатежейИтог.Параметры.СуммаАвансовыхПлатежейВсего = АвансовыйПлатежВсего;
				Если АвансовыйПлатежВсего <> 0 Тогда
					ТабличныйДокумент.Вывести(ОбластьАвансовыхПлатежейИтог);
				КонецЕсли;	
			КонецЕсли;
			//ИТОГ
			ОбластьИтог = Макет.ПолучитьОбласть("Итог");
			ОбластьИтог.Параметры.СуммаИтого = НачисленноВсего+Долг+Аванс+Льгота+АвансовыйПлатежВсего+МесячнаяПлатаПоРеструктуризации+ЗадолженностьПоРеструктуризации-Оплаты;
			ОбластьИтог.Параметры.ЛицевойСчет 	= ВыборкаЛицевойСчет.ЛицевойСчет.Наименование;
			ОбластьИтог.Параметры.ФИО 			= Плательщик;
			ОбластьИтог.Параметры.НазанчениеПлатежа = НазначениеПлатежа;
			
			ТабличныйДокумент.Вывести(ОбластьИтог);	
			МассивВыводимыхОбластей.Добавить(ОбластьИтог);
			
			//Если НужнаПоверка Тогда
			//	ОбластьПроверкаПрибораУчета = Макет.ПолучитьОбласть("ПроверкаПрибораУчета");
			//	ОбластьПроверкаПрибораУчета.Параметры.Прибор = ОбластьПриборы.Параметры.Прибор;
			//	ТабличныйДокумент.Вывести(ОбластьПроверкаПрибораУчета);
			//	МассивВыводимыхОбластей.Добавить(ОбластьПроверкаПрибораУчета);
			//КонецЕсли;
			
			
			Если Не ТабличныйДокумент.ПроверитьВывод(МассивВыводимыхОбластей) Тогда
				ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат ТабличныйДокумент;

КонецФункции

Функция ПроверитьПоверкуПрибораУчета(ОбъектУстановки, ПриборУчета)
	Запрос = Новый Запрос;
	Запрос.Текст =
	    "ВЫБРАТЬ
	    |	ПоверкиПриборовУчетаСрезПоследних.Период,
	    |	ПоверкиПриборовУчетаСрезПоследних.ПоверкаВыполнена
	    |ИЗ
	    |	РегистрСведений.ПоверкиПриборовУчета.СрезПоследних(
	    |			&НаДату,
	    |			ОбъектУстановки = &ОбъектУстановки
	    |				И ПриборУчета = &ПриборУчета) КАК ПоверкиПриборовУчетаСрезПоследних";
	Запрос.УстановитьПараметр("НаДату", ТекущаяДата());
	Запрос.УстановитьПараметр("ОбъектУстановки", ОбъектУстановки);
	Запрос.УстановитьПараметр("ПриборУчета", ПриборУчета);
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.Период <= ТекущаяДата() И Выборка.ПоверкаВыполнена = Ложь Тогда
			Возврат Истина;
		Иначе
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
КонецФункции

Функция ПолучитьОбщуюСтруктуруКвитанции(ЛицевыеСчета, МесяцНачисления) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	РасчетПоказанийПриборовУчетаОстаткиИОбороты.ПриборУчета КАК ПриборУчета
	               |ПОМЕСТИТЬ ОПУ
	               |ИЗ
	               |	РегистрНакопления.РасчетПоказанийПриборовУчета.ОстаткиИОбороты(, , Авто, , ОбъектУстановки В (&ЛицевыеСчета)) КАК РасчетПоказанийПриборовУчетаОстаткиИОбороты
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	ПриборУчета
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ПоказанияПриборовУчетаСрезПоследних.ПриборУчета КАК ПриборУчета,
	               |	СУММА(ПоказанияПриборовУчетаСрезПоследних.Значение) КАК ТекущиеПоказания,
	               |	СУММА(0) КАК ПредыдущиеПоказания,
	               |	ПоказанияПриборовУчетаСрезПоследних.ВидТарифа КАК ВидТарифа
	               |ПОМЕСТИТЬ ПУ
	               |ИЗ
	               |	РегистрСведений.ПоказанияПриборовУчета.СрезПоследних(
	               |			КОНЕЦПЕРИОДА(&МесяцНачисления, МЕСЯЦ),
	               |			ПриборУчета В
	               |				(ВЫБРАТЬ
	               |					ОПУ.ПриборУчета
	               |				ИЗ
	               |					ОПУ КАК ОПУ)) КАК ПоказанияПриборовУчетаСрезПоследних
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ПоказанияПриборовУчетаСрезПоследних.ПриборУчета,
	               |	ПоказанияПриборовУчетаСрезПоследних.ВидТарифа
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ПоказанияПриборовУчетаСрезПоследних.ПриборУчета,
	               |	СУММА(0),
	               |	СУММА(ПоказанияПриборовУчетаСрезПоследних.Значение),
	               |	ПоказанияПриборовУчетаСрезПоследних.ВидТарифа
	               |ИЗ
	               |	РегистрСведений.ПоказанияПриборовУчета.СрезПоследних(
	               |			ДОБАВИТЬКДАТЕ(КОНЕЦПЕРИОДА(&МесяцНачисления, МЕСЯЦ), ДЕНЬ, -1),
	               |			ПриборУчета В
	               |				(ВЫБРАТЬ
	               |					ОПУ.ПриборУчета
	               |				ИЗ
	               |					ОПУ КАК ОПУ)) КАК ПоказанияПриборовУчетаСрезПоследних
	               |ГДЕ
	               |	ПоказанияПриборовУчетаСрезПоследних.Период < КОНЕЦПЕРИОДА(&МесяцНачисления, МЕСЯЦ)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ПоказанияПриборовУчетаСрезПоследних.ПриборУчета,
	               |	ПоказанияПриборовУчетаСрезПоследних.ВидТарифа
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	ПриборУчета
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ПлатежиПоРеструктуризацииДолга.ЛицевойСчет КАК ЛицевойСчет,
	               |	ПлатежиПоРеструктуризацииДолга.СуммаПлатежа КАК СуммаПлатежа,
	               |	ПлатежиПоРеструктуризацииДолга.ОбщаяСумма КАК ОбщаяСумма,
	               |	ПлатежиПоРеструктуризацииДолга.Регистратор КАК ДокументРеструктуризации
	               |ПОМЕСТИТЬ ПРД
	               |ИЗ
	               |	РегистрСведений.ПлатежиПоРеструктуризацииДолга КАК ПлатежиПоРеструктуризацииДолга
	               |ГДЕ
	               |	ПлатежиПоРеструктуризацииДолга.Период >= КОНЕЦПЕРИОДА(&МесяцНачисления, МЕСЯЦ)
	               |	И ПлатежиПоРеструктуризацииДолга.ЛицевойСчет В(&ЛицевыеСчета)
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	ЛицевойСчет
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	РасчетыПоЛицевымСчетамОстатки.ЛицевойСчет КАК ЛицевойСчет,
	               |	РасчетыПоЛицевымСчетамОстатки.Услуга КАК Услуга,
	               |	РасчетыПоЛицевымСчетамОстатки.СуммаОстаток КАК СуммаОстаток,
	               |	ВЫБОР
	               |		КОГДА РасчетыПоЛицевымСчетамОстатки.Услуга.Организация <> ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	               |			ТОГДА РасчетыПоЛицевымСчетамОстатки.Услуга.Организация
	               |		ИНАЧЕ РасчетыПоЛицевымСчетамОстатки.ЛицевойСчет.Владелец.Организация
	               |	КОНЕЦ КАК Организация
	               |ИЗ
	               |	РегистрНакопления.РасчетыПоЛицевымСчетам.Остатки(КОНЕЦПЕРИОДА(&МесяцНачисления, МЕСЯЦ), ЛицевойСчет В (&ЛицевыеСчета)) КАК РасчетыПоЛицевымСчетамОстатки
	               |ГДЕ
	               |	РасчетыПоЛицевымСчетамОстатки.Услуга <> ЗНАЧЕНИЕ(Справочник.Услуги.РеструктуризацияДолга)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	РасчетыПоЛицевымСчетамОстатки.ЛицевойСчет,
	               |	РасчетыПоЛицевымСчетамОстатки.Услуга,
	               |	РасчетыПоЛицевымСчетамОстатки.СуммаОстаток,
	               |	ВЫБОР
	               |		КОГДА РасчетыПоЛицевымСчетамОстатки.Услуга.Организация <> ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	               |			ТОГДА РасчетыПоЛицевымСчетамОстатки.Услуга.Организация
	               |		ИНАЧЕ РасчетыПоЛицевымСчетамОстатки.ЛицевойСчет.Владелец.Организация
	               |	КОНЕЦ
	               |ИТОГИ
	               |	СУММА(СуммаОстаток)
	               |ПО
	               |	ЛицевойСчет,
	               |	Организация,
	               |	Услуга
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	УстановленныеПриборыУчетаСрезПоследних.ОбъектУстановки,
	               |	УстановленныеПриборыУчетаСрезПоследних.ПриборУчета,
	               |	СУММА(ЕСТЬNULL(ПУ.ТекущиеПоказания, 0)) КАК ТекущиеПоказания,
	               |	СУММА(ЕСТЬNULL(ПУ.ПредыдущиеПоказания, 0)) КАК ПредыдущиеПоказания,
	               |	ПУ.ПриборУчета.Коэффициент,
	               |	КОЛИЧЕСТВО(УстановленныеПриборыУчетаСрезПоследних.ПриборУчета) КАК КоличествоПиборовНаУслуге,
	               |	ПУ.ПриборУчета.Услуга КАК Услуга,
	               |	ПУ.ПриборУчета.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	               |	ПУ.ВидТарифа КАК ВидТарифа,
	               |	ПУ.ПриборУчета.ЗаводскойНомер КАК ЗаводскойНомер,
	               |	ПУ.ПриборУчета.Услуга.ВидУслуги.Наименование КАК ВидУслуги
	               |ИЗ
	               |	РегистрСведений.УстановленныеПриборыУчета.СрезПоследних(КОНЕЦПЕРИОДА(&МесяцНачисления, МЕСЯЦ), ОбъектУстановки В (&ЛицевыеСчета)) КАК УстановленныеПриборыУчетаСрезПоследних
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ПУ КАК ПУ
	               |		ПО УстановленныеПриборыУчетаСрезПоследних.ПриборУчета = ПУ.ПриборУчета
	               |ГДЕ
	               |	УстановленныеПриборыУчетаСрезПоследних.Действует = ИСТИНА
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	УстановленныеПриборыУчетаСрезПоследних.ОбъектУстановки,
	               |	УстановленныеПриборыУчетаСрезПоследних.ПриборУчета,
	               |	ПУ.ПриборУчета.Коэффициент,
	               |	ПУ.ПриборУчета.Услуга,
	               |	ПУ.ПриборУчета.ЕдиницаИзмерения,
	               |	ПУ.ВидТарифа,
	               |	ПУ.ПриборУчета.ЗаводскойНомер,
	               |	ПУ.ПриборУчета.Услуга.ВидУслуги.Наименование
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ЗаменыПриборовУчета.ОбъектУстановки,
	               |	ЗаменыПриборовУчета.ПриборУчета,
	               |	ЗаменыПриборовУчета.Показание,
	               |	ЗаменыПриборовУчета.ПоказаниеПредыдущее,
	               |	ЗаменыПриборовУчета.ПриборУчета.Коэффициент,
	               |	0,
	               |	ЗаменыПриборовУчета.Услуга,
	               |	ЗаменыПриборовУчета.ПриборУчета.ЕдиницаИзмерения,
	               |	ЗаменыПриборовУчета.ВидТарифа,
	               |	ЗаменыПриборовУчета.ПриборУчета.ЗаводскойНомер,
	               |	ЗаменыПриборовУчета.Услуга.ВидУслуги.Наименование
	               |ИЗ
	               |	РегистрНакопления.ЗаменыПриборовУчета КАК ЗаменыПриборовУчета
	               |ГДЕ
