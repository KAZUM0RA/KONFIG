//}}MRG[ <-> ]
				ОбластьПодвал.Параметры.Всего = Всего+МесячнаяПлатаПоРеструктуризации+ЗадолженностьПоРеструктуризации;
//}}MRG[ <-> ]
//{{MRG[ <-> ]
