Функция НомерБанковскогоСчетаСоответствуетСтандартуIBAN(НомерСчета) Экспорт
	
	Результат = Ложь;
	
	ДлинаНомера = СтрДлина(НомерСчета);
	КодСтраны = Лев(НомерСчета, 2);
	
	Если КодСтраны = "UA" И ДлинаНомера = 29 Тогда
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьБанкПоНомеруСчетаIBAN(НомерСчета) Экспорт
	
	БанкПоСчету = Неопределено;
	
	КодБанка = ПолучитьКодБанкаПоНомеруСчетаIBAN(НомерСчета);
	
	Если ЗначениеЗаполнено(КодБанка) Тогда
		
		БанкПоСчету = Справочники.Банки.НайтиПоКоду(КодБанка);
		Если БанкПоСчету.Пустая() или БанкПоСчету.ЭтоГруппа Тогда
			БанкПоСчету = "";			
		КонецЕсли;		
	КонецЕсли;
	
	Возврат БанкПоСчету;
	
КонецФункции

Функция ПолучитьКодБанкаПоНомеруСчетаIBAN(НомерСчета) Экспорт
	
	КодБанка = "";
	
	Если НомерБанковскогоСчетаСоответствуетСтандартуIBAN(НомерСчета) Тогда
		КодБанка = Сред(НомерСчета, 5, 6);
	КонецЕсли;
	
	Возврат КодБанка;
	
КонецФункции

Функция ПолучитьПредставлениеБанковскогоСчета(БанковскийСчет) Экспорт
	
		ДатаПериода = ТекущаяДата();
		
		НачалоПереходногоПериода = ОбщегоНазначенияПовтИсп.ПолучитьДатуНачалаПереходаНаСтандартIBAN();
		КонецПереходногоПериода = ОбщегоНазначенияПовтИсп.ПолучитьДатуОкончанияПереходаНаСтандартIBAN();
		ПервыйНомерСчета = "";
		ВторойНомерСчета = "";
		Если ДатаПериода > КонецПереходногоПериода Тогда
			ПервыйНомерСчета = БанковскийСчет.НомерСчета;
		ИначеЕсли ДатаПериода >= НачалоПереходногоПериода И ДатаПериода <= КонецПереходногоПериода Тогда
			ПервыйНомерСчета = БанковскийСчет.НомерСчета;
			Если ЗначениеЗаполнено(БанковскийСчет.НомерСчетаУстаревший) И БанковскийСчет.НомерСчетаУстаревший <> БанковскийСчет.НомерСчета Тогда
				ВторойНомерСчета = БанковскийСчет.НомерСчетаУстаревший;
			КонецЕсли;
		Иначе
			Если ЗначениеЗаполнено(БанковскийСчет.НомерСчетаУстаревший) Тогда
				ПервыйНомерСчета = БанковскийСчет.НомерСчетаУстаревший;
			Иначе
				ПервыйНомерСчета = БанковскийСчет.НомерСчета;
			КонецЕсли;
		КонецЕсли;
		
		ПредставлениеСчета = "";
		Если ЗначениеЗаполнено(ПервыйНомерСчета) Тогда
			
			ПредставлениеСчета = ПервыйНомерСчета 
				+ ?(ЗначениеЗаполнено(ВторойНомерСчета), 
					" (" + НСтр("ru='устар. ';uk='застар. '") + ВторойНомерСчета + ")", "");
 
		КонецЕсли;
			
		Возврат ПредставлениеСчета;

	КонецФункции


Процедура ПечатьПоВнешнемуИсточнику(Ссылка, МассивОбъектов, ИменаМакетов, ПараметрыПечати,
			КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	КоллекцияПечатныхФорм = УправлениеПечатью.ПодготовитьКоллекциюПечатныхФорм(ИменаМакетов);
	
	ПараметрыВывода = УправлениеПечатью.ПодготовитьСтруктуруПараметровВывода();
	
	ОбъектыПечати = Новый СписокЗначений;
	
	ВнешняяОбработкаОбъект = ДополнительныеОтчетыИОбработки.ПолучитьОбъектВнешнейОбработки(Ссылка);
	
	ВнешняяОбработкаОбъект.Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода);
	
	// Проверим, все ли макеты были сформированы
	Для Каждого Стр Из КоллекцияПечатныхФорм Цикл
		Если Стр.ТабличныйДокумент = Неопределено Тогда
			ТекстСообщенияОбОшибке = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
										НСтр("ru='В обработчике печати не был сформирован табличный документ для: %1';uk='В оброблювачі печатки не був сформований табличний документ для: %1'"),
										Стр.ИмяМакета);
			ВызватьИсключение(ТекстСообщенияОбОшибке);
		КонецЕсли;
		
		Стр.ТабличныйДокумент.КоличествоЭкземпляров = Стр.Экземпляров;
	КонецЦикла;

КонецПроцедуры

Функция ВнешняяПечатьКвитанцииНаОплатуУпрощенная(Ссылка, ТекущийДокумент, ТабличныйДокумент, МесяцНачислений, БанковскиеСчетаОрганизации) Экспорт
	
	ВнешняяОбработкаОбъект = ДополнительныеОтчетыИОбработки.ПолучитьОбъектВнешнейОбработки(Ссылка);
	
	Возврат ВнешняяОбработкаОбъект.ПечатьКвитанцииНаОплатуУпрощенная(ТекущийДокумент, ТабличныйДокумент, МесяцНачислений, БанковскиеСчетаОрганизации);

КонецФункции

Функция ВнешняяПечатьКвитанцииНаОплату(Ссылка, ТекущийДокумент, ТабличныйДокумент, МесяцНачислений, БанковскиеСчетаОрганизации) Экспорт
	
