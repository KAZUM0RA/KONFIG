	ЭлектроннаяПочта.ЗаполнитьНовыеРеквизитыУчетныхЗаписей();
	
	//Обновление коэффициентов для вторичных услуг по ПУ
	
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	УслугиСоставныеУслуги.Ссылка КАК УслугаОсновная
		|ИЗ
		|	Справочник.Услуги.СоставныеУслуги КАК УслугиСоставныеУслуги
		|ГДЕ
		|	УслугиСоставныеУслуги.Ссылка.ПометкаУдаления = ЛОЖЬ";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		УслугаОбъект = ВыборкаДетальныеЗаписи.УслугаОсновная.ПолучитьОбъект();
		Для каждого Строка Из УслугаОбъект.СоставныеУслуги Цикл
			
			Строка.Коэффициент = 1;
			
		КонецЦикла; 
		УслугаОбъект.Записать();
		
	КонецЦикла;
	
