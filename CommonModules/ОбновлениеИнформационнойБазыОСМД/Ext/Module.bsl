Функция ПолучитьСтарыеСуммыНачислений(СтруктураДляРасчета) 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	РасчетыПоЛицевымСчетам.ЛицевойСчет,
	|	РасчетыПоЛицевымСчетам.Услуга,
	|	РасчетыПоЛицевымСчетам.МесяцНачисления,
	|	СУММА(РасчетыПоЛицевымСчетам.Сумма) КАК СуммаНачислено,
	|	РасчетыПоЛицевымСчетам.ВидНачисления,
	|	РасчетыПоЛицевымСчетам.ВидНачисленияПерерасчет
	|ИЗ
	|	РегистрНакопления.РасчетыПоЛицевымСчетам КАК РасчетыПоЛицевымСчетам
	|ГДЕ
	|	РасчетыПоЛицевымСчетам.Период >= &ДатаНач
	|	И РасчетыПоЛицевымСчетам.Период <= &ДатаКон
	|	И РасчетыПоЛицевымСчетам.ЛицевойСчет В(&спЛицевыеСчета)
	|	И (РасчетыПоЛицевымСчетам.Услуга = &Услуга
	|			ИЛИ &Услуга = ЗНАЧЕНИЕ(Справочник.Услуги.ПустаяСсылка))
	|	И РасчетыПоЛицевымСчетам.МесяцНачисления = &ДатаНач
	|	И (РасчетыПоЛицевымСчетам.ВидНачисления = ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Начисление)
	|			ИЛИ РасчетыПоЛицевымСчетам.ВидНачисления = ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Льгота)
	|			ИЛИ РасчетыПоЛицевымСчетам.ВидНачисления = ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Субсидия)
	|			ИЛИ РасчетыПоЛицевымСчетам.ВидНачисления = ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Перерасчет))
	|	И РасчетыПоЛицевымСчетам.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|	И РасчетыПоЛицевымСчетам.Регистратор <> &Ссылка
	|	И РасчетыПоЛицевымСчетам.Сумма <> 0
	|
	|СГРУППИРОВАТЬ ПО
	|	РасчетыПоЛицевымСчетам.ЛицевойСчет,
	|	РасчетыПоЛицевымСчетам.Услуга,
	|	РасчетыПоЛицевымСчетам.МесяцНачисления,
	|	РасчетыПоЛицевымСчетам.ВидНачисления,
	|	РасчетыПоЛицевымСчетам.ВидНачисленияПерерасчет";
	
	
	Запрос.УстановитьПараметр("ДатаНач",		НачалоМесяца(СтруктураДляРасчета.ПериодНачисления));
	Запрос.УстановитьПараметр("ДатаКон",		ТекущаяДата());
	Запрос.УстановитьПараметр("СпЛицевыеСчета", СтруктураДляРасчета.ЛицевыеСчета);
	Запрос.УстановитьПараметр("Услуга",			СтруктураДляРасчета.Услуга);
	Запрос.УстановитьПараметр("МесяцНачисления",СтруктураДляРасчета.ПериодНачисления);
	Запрос.УстановитьПараметр("Ссылка",			СтруктураДляРасчета.Ссылка);
	Запрос.УстановитьПараметр("ВидНачисленияПерерасчет",			Перечисления.ВидыНачислений.Перерасчет);
	
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Выгрузить();
	
КонецФункции


