	ТаблицаПерерасчета.Колонки.Добавить("МесяцНачисления", Новый ОписаниеТипов("Дата"));
	ТаблицаПерерасчета.Колонки.Добавить("Период", Новый ОписаниеТипов("Дата"));
	
	
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	МенеджерВременныхТаблиц = Запрос.МенеджерВременныхТаблиц;
	Запрос.Текст =  "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПерерасчетПоЛС.Ссылка,
	|	ПерерасчетПоЛС.Дата,
	|	ПерерасчетПоЛС.Здание,
	|	ПерерасчетПоЛС.Организация,
	|	ПерерасчетПоЛСПерерасчет.ЛицевойСчет,
	|	ЕСТЬNULL(ПерерасчетПоЛС.Услуга, ЗНАЧЕНИЕ(Справочник.услуги.ПустаяСсылка)) КАК УслугаДокумента,
	|	0 КАК Поле1
	|ПОМЕСТИТЬ ВТПерерасчет
	|ИЗ
	|	Документ.ПерерасчетПоЛС КАК ПерерасчетПоЛС
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПерерасчетПоЛС.Перерасчет КАК ПерерасчетПоЛСПерерасчет
	|		ПО ПерерасчетПоЛС.Ссылка = ПерерасчетПоЛСПерерасчет.Ссылка
	|ГДЕ
	|	ПерерасчетПоЛС.Дата МЕЖДУ &Дата1 И &Дата2
	|
	|СГРУППИРОВАТЬ ПО
	|	ПерерасчетПоЛС.Ссылка,
	|	ПерерасчетПоЛСПерерасчет.ЛицевойСчет,
	|	ПерерасчетПоЛС.Дата,
	|	ПерерасчетПоЛС.Здание,
	|	ПерерасчетПоЛС.Организация,
	|	ЕСТЬNULL(ПерерасчетПоЛС.Услуга, ЗНАЧЕНИЕ(Справочник.услуги.ПустаяСсылка))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТПерерасчет.Ссылка КАК Ссылка,
	|	ВТПерерасчет.Дата КАК Дата,
	|	ВТПерерасчет.Здание,
	|	ВТПерерасчет.Организация,
	|	ВТПерерасчет.ЛицевойСчет КАК ЛицевойСчет,
	|	ЕСТЬNULL(ВТПерерасчет.УслугаДокумента, ЗНАЧЕНИЕ(Справочник.услуги.ПустаяСсылка)) КАК УслугаДокумента
	|ИЗ
	|	ВТПерерасчет КАК ВТПерерасчет
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата
	|ИТОГИ ПО
	|	Ссылка";
	
	Запрос.УстановитьПараметр("Дата1",Дата("20150901"));
	Запрос.УстановитьПараметр("Дата2",Дата("20150930235959"));
	Результат = Запрос.Выполнить();	
	
	
	Если НЕ Результат.Пустой() Тогда
		ВыборкаПерерасчетов = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		
		Пока ВыборкаПерерасчетов.Следующий() Цикл                                                   
			ПериодНачисленияНачало = ВыборкаПерерасчетов.Ссылка.ПериодНачисленияНачало;
			ПериодНачисленияОкончание = ВыборкаПерерасчетов.Ссылка.ПериодНачисленияОкончание;
			УслугаДокумента = ВыборкаПерерасчетов.Ссылка.Услуга;
			Ссылка = ВыборкаПерерасчетов.Ссылка;
			МассивЛицевыхСчетов = Новый Массив;
			ВыборкаЛС = ВыборкаПерерасчетов.Выбрать();
			Пока ВыборкаЛС.Следующий() Цикл
				МассивЛицевыхСчетов.Добавить(ВыборкаЛС.ЛицевойСчет);
			КонецЦикла;	
			СтруктураДляРасчета = Новый Структура;
			
			СтруктураДляРасчета.Вставить("ЛицевыеСчета", МассивЛицевыхСчетов); 
			
			СтруктураДляРасчета.Вставить("ПериодНачисленияНачало", ПериодНачисленияНачало);
			СтруктураДляРасчета.Вставить("ПериодНачисленияОкончание", ПериодНачисленияОкончание);
			
			СтруктураДляРасчета.Вставить("Услуга", УслугаДокумента); 
			СтруктураДляРасчета.Вставить("Ссылка", Ссылка);
			
			ТаблицаПерерасчетаНовая = УчетКоммунальныхУслуг.РассчитатьСуммыПерерасчета(СтруктураДляРасчета);
			Для каждого строка Из ТаблицаПерерасчетаНовая Цикл
				Если строка.СуммаСубсидии <>0 тогда
					СтрокаТаб = ТаблицаПерерасчета.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаТаб,Строка);
					СтрокаТаб.Регистратор = ВыборкаПерерасчетов.Ссылка;
					СтрокаТаб.Период = ВыборкаПерерасчетов.Ссылка.Дата;
					СтрокаТаб.Организация = СтруктураДляРасчета.Ссылка.Организация;
				КонецЕсли; 
			КонецЦикла; 
		КонецЦикла;		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =  "ВЫБРАТЬ
	|	ТаблицаСубсидий.Регистратор,
	|	ТаблицаСубсидий.ЛицевойСчет,
	|	ТаблицаСубсидий.МесяцНачисления,
	|	ТаблицаСубсидий.СуммаСубсидии,
	|	ТаблицаСубсидий.Период,
	|	ТаблицаСубсидий.Услуга,
	|	ТаблицаСубсидий.Организация
	|ПОМЕСТИТЬ ДокВТ
	|ИЗ
	|	&ТаблицаСубсидий КАК ТаблицаСубсидий
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДокВТ.Регистратор КАК Регистратор,
	|	ДокВТ.ЛицевойСчет КАК ЛицевойСчет,
	|	ДокВТ.МесяцНачисления КАК МесяцНачисления,
	|	СУММА(0) КАК Сумма,
	|	ДокВТ.Период,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
	|	ДокВТ.Организация,
	|	ЕСТЬNULL(РасчетыПоСубсидиямОстаткиИОбороты.СуммаПриход, 0) КАК Приход,
	|	ДокВТ.Услуга
	|ИЗ
	|	ДокВТ КАК ДокВТ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.РасчетыПоСубсидиям.ОстаткиИОбороты(, , Регистратор, , ) КАК РасчетыПоСубсидиямОстаткиИОбороты
	|		ПО ДокВТ.Регистратор <> РасчетыПоСубсидиямОстаткиИОбороты.Регистратор
	|			И ДокВТ.ЛицевойСчет = РасчетыПоСубсидиямОстаткиИОбороты.ЛицевойСчет
	|			И ДокВТ.МесяцНачисления = РасчетыПоСубсидиямОстаткиИОбороты.МесяцНачисления
	|			И ДокВТ.Услуга = РасчетыПоСубсидиямОстаткиИОбороты.Услуга
	|
	|СГРУППИРОВАТЬ ПО
	|	ДокВТ.Период,
	|	ДокВТ.Регистратор,
	|	ДокВТ.ЛицевойСчет,
	|	ДокВТ.МесяцНачисления,
	|	ДокВТ.Организация,
	|	ЕСТЬNULL(РасчетыПоСубсидиямОстаткиИОбороты.СуммаПриход, 0),
	|	ДокВТ.Услуга
	|
	|УПОРЯДОЧИТЬ ПО
	|	МесяцНачисления
	|ИТОГИ ПО
	|	Регистратор,
	|	ЛицевойСчет,
	|	МесяцНачисления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДокВТ.Регистратор КАК Регистратор,
	|	ДокВТ.ЛицевойСчет КАК ЛицевойСчет,
	|	ДокВТ.МесяцНачисления,
	|	ДокВТ.СуммаСубсидии - ЕСТЬNULL(РасчетыПоСубсидиямОстаткиИОбороты.СуммаРасход, 0) КАК Сумма,
	|	ДокВТ.Период,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
	|	ДокВТ.Услуга,
	|	ДокВТ.Организация
	|ИЗ
	|	ДокВТ КАК ДокВТ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.РасчетыПоСубсидиям.ОстаткиИОбороты(, , Регистратор, , ) КАК РасчетыПоСубсидиямОстаткиИОбороты
	|		ПО ДокВТ.Регистратор <> РасчетыПоСубсидиямОстаткиИОбороты.Регистратор
	|			И ДокВТ.ЛицевойСчет = РасчетыПоСубсидиямОстаткиИОбороты.ЛицевойСчет
	|			И ДокВТ.Услуга = РасчетыПоСубсидиямОстаткиИОбороты.Услуга
	|			И ДокВТ.МесяцНачисления = РасчетыПоСубсидиямОстаткиИОбороты.МесяцНачисления
	|ИТОГИ ПО
	|	Регистратор";
	
	Запрос.УстановитьПараметр("ТаблицаСубсидий",ТаблицаПерерасчета);
	
	Результат  = Запрос.ВыполнитьПакет();
	
	ВыборкаДляЗаписиВРегистрРегистратор = Результат[1].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаДляЗаписиВРегистрРегистратор.Следующий() Цикл
		Движения = РегистрыНакопления.РасчетыПоСубсидиям.СоздатьНаборЗаписей();
		Движения.Отбор.Регистратор.Установить(ВыборкаДляЗаписиВРегистрРегистратор.Регистратор);
		
		ВыборкаДеталиВерх = ВыборкаДляЗаписиВРегистрРегистратор.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаДеталиВерх.Следующий() Цикл
			
			СтруктураОтбора = Новый Структура;
			СтруктураОтбора.Вставить("ЛицевойСчет",ВыборкаДеталиВерх.ЛицевойСчет);
			
			ВыборкаДетали = ВыборкаДеталиВерх.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			Пока ВыборкаДетали.Следующий() Цикл
				ТаблицаНайденнойСубсидии = РегистрыСведений.НазначенныеСубсидии.СрезПоследних(НАчалоЧаса(КонецМесяца(ВыборкаДетали.МесяцНачисления)),СтруктураОтбора);
				ВыборкаДанныхПоЛС = ВыборкаДетали.Выбрать();
				
				Пока ВыборкаДанныхПоЛС.Следующий() Цикл
					СтруктураПоискаЛС = Новый Структура;
					СтруктураПоискаЛС.Вставить("ЛицевойСчет",ВыборкаДанныхПоЛС.ЛицевойСчет);
					СтруктураПоискаЛС.Вставить("Услуга",ВыборкаДанныхПоЛС.Услуга);
					
					
					НайденныеСтрокиСубсидии = ТаблицаНайденнойСубсидии.НайтиСтроки(СтруктураПоискаЛС);
					Индекс = 0;
					Если НайденныеСтрокиСубсидии.Количество() <> 0 Тогда
						Пока Индекс <= НайденныеСтрокиСубсидии.ВГраница() Цикл
							Если НайденныеСтрокиСубсидии[Индекс].Действует тогда
								Сумма = НайденныеСтрокиСубсидии[Индекс].СуммаСубсидии - ВыборкаДанныхПоЛС.Приход ;
								Если Сумма <> 0 Тогда
									Движение = Движения.Добавить();
									ЗаполнитьЗначенияСвойств(Движение,ВыборкаДанныхПоЛС);
									Движение.Сумма = Сумма;
									Движение.Услуга = НайденныеСтрокиСубсидии[Индекс].Услуга;
								КонецЕсли;
							КонецЕсли;
							НайденныеСтрокиСубсидии.Удалить(Индекс);
							Индекс = Индекс+1;
						КонецЦикла;
					КонецЕсли;		
					
					Сч = 0; 
					Пока Сч <= НайденныеСтрокиСубсидии.ВГраница() Цикл
						
						Если НайденныеСтрокиСубсидии[Сч].Действует Тогда
							Движение = Движения.Добавить();
							ЗаполнитьЗначенияСвойств(Движение,ВыборкаДанныхПоЛС);
							Движение.Сумма = НайденныеСтрокиСубсидии[Сч].СуммаСубсидии;
							Движение.Услуга = НайденныеСтрокиСубсидии[Сч].Услуга;
						КонецЕсли;
						Сч = Сч+1;
					КонецЦикла;
				КонецЦикла;
			КонецЦикла; 
			
		КонецЦикла;
		Попытка
			Движения.Записать();
		Исключение
			
		КонецПопытки;
	КонецЦикла;
	
	ВыборкаРасходРегистратор = Результат[2].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаРасходРегистратор.Следующий() Цикл
		Движения = РегистрыНакопления.РасчетыПоСубсидиям.СоздатьНаборЗаписей();
		Движения.Отбор.Регистратор.Установить(ВыборкаРасходРегистратор.Регистратор);
		Движения.Прочитать();
		
		ВыборкаРасходДетали = ВыборкаРасходРегистратор.Выбрать();
		Пока ВыборкаРасходДетали.Следующий() Цикл
			Если ВыборкаРасходДетали.Сумма <> 0 Тогда
				Движение = Движения.Добавить();
				ЗаполнитьЗначенияСвойств(Движение,ВыборкаРасходДетали);
			КонецЕсли;
		КонецЦикла;
		
		Попытка
			Движения.Записать();
		Исключение
			
		КонецПопытки;
	КонецЦикла; 

КонецПроцедуры

// Процедура обновления резиза 1.0.5.7.
//
Процедура Релиз1_0_5_7() Экспорт
	
	ОбновитьДополнительныеОбработки();
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	УправлениеПриборамиУчета.Ссылка
		|ИЗ
		|	Документ.УправлениеПриборамиУчета КАК УправлениеПриборамиУчета
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЗаменаПриборовУчета.Ссылка
		|ИЗ
		|	Документ.ЗаменаПриборовУчета КАК ЗаменаПриборовУчета";

	Результат = Запрос.ВыполнитьПакет();
	
	ТаблицаУправленияПУ = Результат[0].Выбрать();
	ТаблицаЗаменыПУ = Результат[1].Выбрать();
	
	Пока ТаблицаЗаменыПУ.Следующий() Цикл
		ДокументОбъект =  ТаблицаЗаменыПУ.Ссылка.ПолучитьОбъект();
		Для Каждого Строка Из ДокументОбъект.Основная Цикл
			Строка.ВидТарифаПредыдущий  = Перечисления.ВидыТарифов.Общий;
			
			Строка.ВидТарифаНовый = Перечисления.ВидыТарифов.Общий;
		КонецЦикла;
		Попытка 
			ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
		Исключение
		КонецПопытки;
	КонецЦикла;
	
	Пока ТаблицаУправленияПУ.Следующий() Цикл
		ДокументОбъект =  ТаблицаУправленияПУ.Ссылка.ПолучитьОбъект();
		Для Каждого Строка Из ДокументОбъект.ПриборыУчета Цикл
			Строка.ВидТарифа  = Перечисления.ВидыТарифов.Общий;
			
		КонецЦикла;
		Попытка 
			ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
		Исключение
			
		КонецПопытки;
	КонецЦикла;
	
		

	
	
КонецПроцедуры

