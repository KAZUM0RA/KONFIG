КонецПроцедуры

Процедура ВыполнитьПроводкуПоРегиструСубсидий()
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст =  "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НачислениеПоЛС.Дата КАК Дата,
	|	НачислениеПоЛС.ПериодНачисления КАК ПериодНачисления,
	|	НачислениеПоЛС.Ссылка,
	|	НачислениеПоЛСУслуги.ЛицевойСчет,
	|	НачислениеПоЛСУслуги.Услуга,
	|	НачислениеПоЛСУслуги.СуммаНачислено КАК Сумма,
	|	НачислениеПоЛСУслуги.ВидНачисления,
	|	НачислениеПоЛС.Здание,
	|	НачислениеПоЛС.Организация
	|ПОМЕСТИТЬ ВТ_Начисления
	|ИЗ
	|	Документ.НачислениеПоЛС КАК НачислениеПоЛС
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.НачислениеПоЛС.Услуги КАК НачислениеПоЛСУслуги
	|		ПО НачислениеПоЛС.Ссылка = НачислениеПоЛСУслуги.Ссылка
	|ГДЕ
	|	НачислениеПоЛСУслуги.ВидНачисления = ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Субсидия)
	|	И НачислениеПоЛС.Проведен = ИСТИНА
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РасчетыПоЛицевымСчетамОбороты.МесяцНачисления КАК ПериодНачисления
	|ИЗ
	|	РегистрНакопления.РасчетыПоЛицевымСчетам.Обороты КАК РасчетыПоЛицевымСчетамОбороты
	|
	|СГРУППИРОВАТЬ ПО
	|	РасчетыПоЛицевымСчетамОбороты.МесяцНачисления" ;
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	НазначенныеСубсидии = Новый ТаблицаЗначений;
	НазначенныеСубсидии.Колонки.Добавить("ЛицевойСчет", Новый ОписаниеТипов("СправочникСсылка.ЛицевыеСчета"));
	НазначенныеСубсидии.Колонки.Добавить("Услуга",Новый ОписаниеТипов("СправочникСсылка.Услуги"));
	НазначенныеСубсидии.Колонки.Добавить("СуммаСубсидии",Новый ОписаниеТипов("Число"));
	НазначенныеСубсидии.Колонки.Добавить("ПериодНачисления",Новый ОписаниеТипов("Дата"));
	
	
	
	ВыборкаПериодовСреза = Результат.Выбрать();
	
	Пока ВыборкаПериодовСреза.Следующий() Цикл
		ТаблицаСубсидий = РегистрыСведений.НазначенныеСубсидии.СрезПоследних(НачалоЧаса(КонецМесяца(ВыборкаПериодовСреза.ПериодНачисления)));
		Для Каждого Строка из ТаблицаСубсидий Цикл
			Если Строка.Действует Тогда
				НоваяСтрока = НазначенныеСубсидии.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока,Строка);
				НоваяСтрока.ПериодНачисления = КонецМесяца(ВыборкаПериодовСреза.ПериодНачисления);
			Иначе
				Сообщить(КонецМесяца(ВыборкаПериодовСреза.ПериодНачисления));
			КонецЕсли;
		КонецЦикла; 
	КонецЦикла;
	
	НазначенныеСубсидии.Сортировать("ПериодНачисления Возр");
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст =  "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	                |	ВТ_Начисления.Услуга,
	                |	ВТ_Начисления.ЛицевойСчет,
	                |	ВТ_Начисления.ПериодНачисления,
	                |	ВТ_Начисления.Здание,
	                |	ВТ_Начисления.Организация,
	                |	СУММА(ВТ_Начисления.Сумма) КАК СуммаНачислено,
	                |	ВТ_Начисления.Ссылка
	                |ПОМЕСТИТЬ Начисления
	                |ИЗ
	                |	ВТ_Начисления КАК ВТ_Начисления
	                |
	                |СГРУППИРОВАТЬ ПО
	                |	ВТ_Начисления.ЛицевойСчет,
	                |	ВТ_Начисления.ПериодНачисления,
	                |	ВТ_Начисления.Здание,
	                |	ВТ_Начисления.Услуга,
	                |	ВТ_Начисления.Организация,
	                |	ВТ_Начисления.Ссылка
	                |;
	                |
	                |////////////////////////////////////////////////////////////////////////////////
	                |ВЫБРАТЬ
	                |	Начисления.ЛицевойСчет,
	                |	НАЧАЛОПЕРИОДА(Начисления.ПериодНачисления, МЕСЯЦ) КАК МесяцНачисления,
	                |	Начисления.Здание,
	                |	Начисления.Организация,
	                |	СУММА(0) КАК Сумма,
	                |	НАЧАЛОПЕРИОДА(Начисления.ПериодНачисления, ЧАС) КАК Период,
	                |	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
	                |	Начисления.Ссылка КАК Регистратор
	                |ИЗ
	                |	Начисления КАК Начисления
	                |
	                |СГРУППИРОВАТЬ ПО
	                |	Начисления.Ссылка,
	                |	НАЧАЛОПЕРИОДА(Начисления.ПериодНачисления, ЧАС),
	                |	Начисления.Организация,
	                |	НАЧАЛОПЕРИОДА(Начисления.ПериодНачисления, МЕСЯЦ),
	                |	Начисления.Здание,
	                |	Начисления.ЛицевойСчет
	                |ИТОГИ ПО
	                |	Регистратор
	                |;
	                |
	                |////////////////////////////////////////////////////////////////////////////////
	                |ВЫБРАТЬ
	                |	Начисления.Услуга,
	                |	Начисления.ЛицевойСчет,
	                |	НАЧАЛОПЕРИОДА(Начисления.ПериодНачисления, МЕСЯЦ) КАК МесяцНачисления,
	                |	Начисления.Здание,
	                |	Начисления.Организация,
	                |	-Начисления.СуммаНачислено КАК Сумма,
	                |	Начисления.ПериодНачисления КАК Период,
	                |	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
	                |	Начисления.Ссылка КАК Регистратор
	                |ИЗ
	                |	Начисления КАК Начисления
	                |ИТОГИ ПО
	                |	Регистратор";
	Запрос.УстановитьПараметр("Таблица",НазначенныеСубсидии);
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ВыборкаРегистратор = РезультатЗапроса[1].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаРегистратор.Следующий() Цикл
		Движения = РегистрыНакопления.РасчетыПоСубсидиям.СоздатьНаборЗаписей();
		Движения.Отбор.Регистратор.Установить(ВыборкаРегистратор.Регистратор);
		
		ВыборкаДетали = ВыборкаРегистратор.Выбрать();
		Пока ВыборкаДетали.Следующий() Цикл
			
			СтруктураОтбора = Новый Структура;
			СтруктураОтбора.Вставить("ЛицевойСчет",ВыборкаДетали.ЛицевойСчет);
			СтруктураОтбора.Вставить("ПериодНачисления",КонецМесяца(ВыборкаДетали.МесяцНачисления));
			
			СтрокаНайденнойСубсидии = НазначенныеСубсидии.НайтиСтроки(СтруктураОтбора);
			Попытка
				Для Каждого строка из СтрокаНайденнойСубсидии Цикл
					Движение = Движения.Добавить();
					ЗаполнитьЗначенияСвойств(Движение,ВыборкаДетали);
					Движение.Сумма = Строка.СуммаСубсидии;
					Движение.Услуга = Строка.Услуга;
				КонецЦикла;
			Исключение
				Движения.Удалить(Движение);
			КонецПопытки;
			
		КонецЦикла;
		Движения.Записать();
	КонецЦикла;
	
	
	ВыборкаРасходРегистратор = РезультатЗапроса[2].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаРасходРегистратор.Следующий() Цикл
