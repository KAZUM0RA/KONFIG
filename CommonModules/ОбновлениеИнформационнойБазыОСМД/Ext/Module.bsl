// Процедура обновления резиза 1.0.6.2.
//
Процедура Релиз1_0_6_2() Экспорт
	
	
	ОбновитьДополнительныеОбработки();

	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗданияИСооружения.Ссылка КАК Здание,
		|	ЗданияИСооружения.ДатаВводаВЭксплуатацию,
		|	ЗданияИСооружения.Наименование КАК ЗданиеАдрес
		|ИЗ
		|	Справочник.ЗданияИСооружения КАК ЗданияИСооружения
		|ГДЕ
		|	ЗданияИСооружения.ПометкаУдаления = ЛОЖЬ";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ЗданиеОбъект  = ВыборкаДетальныеЗаписи.Здание.ПолучитьОбъект();
		ЗданиеОбъект.ДатаНачалаУчета = ВыборкаДетальныеЗаписи.ДатаВводаВЭксплуатацию;
		Попытка
		
			ЗданиеОбъект.Записать();
		
		Исключение
			
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = НСтр("ru = 'Не удалось установить дату начала учета для здания "+ВыборкаДетальныеЗаписи.ЗданиеАдрес+"! Установите вручную';
			|uk = 'Не вдалося встановити дату початку обліку для будівлі "+ВыборкаДетальныеЗаписи.ЗданиеАдрес+"! Встановіть вручну'");
			Сообщение.Сообщить(); 
		КонецПопытки;
	КонецЦикла;
	
	
	ТаблицаПерерасчета = Новый ТаблицаЗначений;
	ТаблицаПерерасчета.Колонки.Добавить("ЛицевойСчет", Новый ОписаниеТипов("СправочникСсылка.ЛицевыеСчета"));	
	ТаблицаПерерасчета.Колонки.Добавить("Услуга", Новый ОписаниеТипов("СправочникСсылка.Услуги"));	
	ТаблицаПерерасчета.Колонки.Добавить("СуммаНачислено", Новый ОписаниеТипов("Число"));	
	ТаблицаПерерасчета.Колонки.Добавить("СуммаТекущийРасчет", Новый ОписаниеТипов("Число"));	
	ТаблицаПерерасчета.Колонки.Добавить("СуммаПерерасчета", Новый ОписаниеТипов("Число"));
	ТаблицаПерерасчета.Колонки.Добавить("СуммаСубсидии", Новый ОписаниеТипов("Число"));
	ТаблицаПерерасчета.Колонки.Добавить("СуммаЛьготы", Новый ОписаниеТипов("Число"));
	ТаблицаПерерасчета.Колонки.Добавить("ПредыдущаяСуммаЛьготы", Новый ОписаниеТипов("Число"));
	ТаблицаПерерасчета.Колонки.Добавить("МесяцНачисления", Новый ОписаниеТипов("Дата"));
	ТаблицаПерерасчета.Колонки.Добавить("ВидНачисления", Новый ОписаниеТипов("ПеречислениеСсылка.ВидыНачислений"));
	
	ТаблицаПериодыПерерасчета = Новый ТаблицаЗначений;
	ТаблицаПериодыПерерасчета.Колонки.Добавить("ПериодНачисления", Новый ОписаниеТипов("Дата"));
	
	ПервыйДокумент = Истина;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПерерасчетПоЛСПерерасчет.Ссылка.ПериодНачисленияНачало КАК ПериодНачисленияНачало,
	|	ПерерасчетПоЛСПерерасчет.Ссылка.ПериодНачисленияОкончание КАК ПериодНачисленияОкончание,
	|	ПерерасчетПоЛСПерерасчет.Ссылка КАК Ссылка,
	|	ПерерасчетПоЛСПерерасчет.Услуга,
	|	ПерерасчетПоЛСПерерасчет.ЛицевойСчет,
	|	ПерерасчетПоЛСПерерасчет.СуммаНачислено КАК СуммаНачислено,
	|	ПерерасчетПоЛСПерерасчет.СуммаТекущийРасчет,
	|	ПерерасчетПоЛСПерерасчет.ВидНачисления КАК ВидНачисления,
	|	ПерерасчетПоЛСПерерасчет.СуммаПерерасчета КАК СуммаПерерасчета,
	|	ПерерасчетПоЛСПерерасчет.МесяцНачисления
	|ИЗ
	|	Документ.ПерерасчетПоЛС.Перерасчет КАК ПерерасчетПоЛСПерерасчет
	|ГДЕ
	|	ПерерасчетПоЛСПерерасчет.Ссылка.Проведен = ИСТИНА
	|	И ПерерасчетПоЛСПерерасчет.Ссылка.ВидОперации <> &ВидОперации
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПерерасчетПоЛСПерерасчет.Ссылка.Дата
	|ИТОГИ
	|	МАКСИМУМ(ПериодНачисленияНачало),
	|	МАКСИМУМ(ПериодНачисленияОкончание),
	|	МАКСИМУМ(ВидНачисления),
	|	СУММА(СуммаПерерасчета)
	|ПО
	|	Ссылка";
	
	Запрос.УстановитьПараметр("ВидОперации", Перечисления.ВидыОперацийПерерасчетПоЛС.ИнвентаризацияАвансов);
	//Запрос.УстановитьПараметр("Ссылка", ДокПерерасчет);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаСсылка = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаСсылка.Следующий() Цикл
		
		
		Если ВыборкаСсылка.ВидНачисления = Перечисления.ВидыНачислений.ПустаяСсылка() Тогда
			Продолжить;
		КонецЕсли;
		
		НаборЗаписей = РегистрыНакопления.РасчетыПоЛицевымСчетам.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(ВыборкаСсылка.Ссылка);
		НаборЗаписей.Отбор.Регистратор.Использование = Истина;
		
		ИтогДокумента = ВыборкаСсылка.СуммаПерерасчета; 
		
		НачалоПериода = НачалоМесяца(ВыборкаСсылка.ПериодНачисленияНачало);	
		КонецПериода = КонецМесяца(ВыборкаСсылка.ПериодНачисленияОкончание);	
		ТаблицаПериодыПерерасчета.Очистить();
		ТаблицаПерерасчета.Очистить();
		
		
		ВыборкаДетальныеЗаписи = ВыборкаСсылка.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			 
			Если ВыборкаДетальныеЗаписи.ВидНачисления = Перечисления.ВидыНачислений.Перерасчет и Не ПервыйДокумент Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = ТаблицаПерерасчета.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока,ВыборкаДетальныеЗаписи);
			ПервыйДокумент = Ложь;
		КонецЦикла;
		
		ТаблицаПерерасчета.Сортировать("ЛицевойСчет");
		
		Если НЕ ПервыйДокумент Тогда
			
			ТекДата = НачалоПериода;
			Пока ТекДата < КонецПериода Цикл
				НоваяСтрока = ТаблицаПериодыПерерасчета.Добавить();
				НоваяСтрока.ПериодНачисления = ТекДата;
				ТекДата = ДобавитьМесяц(ТекДата, 1);
			КонецЦикла;
			
			ТаблицаПоЛС = ТаблицаПерерасчета.Скопировать(,"ЛицевойСчет");
			ТаблицаПоЛС.Свернуть("ЛицевойСчет");
			
			МассивЛС = ТаблицаПоЛС.ВыгрузитьКолонку("ЛицевойСчет");
			
			Перерасчеты = 0;
			
			Для каждого СтрокаТаб Из ТаблицаПериодыПерерасчета Цикл
				
				СтруктураДляРасчета = Новый Структура;
				
				СтруктураДляРасчета.Вставить("ЛицевыеСчета", МассивЛС); 
				СтруктураДляРасчета.Вставить("ПериодНачисления", СтрокаТаб.ПериодНачисления);
				СтруктураДляРасчета.Вставить("Услуга", ВыборкаСсылка.ссылка.Услуга); 
				СтруктураДляРасчета.Вставить("Ссылка", ВыборкаСсылка.ссылка); 
				
				ТаблицаНачисленийСтарые = ПолучитьСтарыеСуммыНачислений(СтруктураДляРасчета);
				
				ТаблицаНачисленийСтарые.Свернуть("ЛицевойСчет,Услуга,МесяцНачисления,ВидНачисления,ВидНачисленияПерерасчет","СуммаНачислено");
				Перерасчеты = Перерасчеты + ТаблицаНачисленийСтарые.Итог("СуммаНачислено");
				
				Для Каждого СтрокаТабПерерасчет из ТаблицаНачисленийСтарые Цикл
					Если СтрокаТабПерерасчет.ВидНачисленияПерерасчет <> Перечисления.ВидыНачислений.Перерасчет Тогда
						Продолжить;
					КонецЕсли;
					НоваяСтрока = ТаблицаПерерасчета.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока,СтрокаТабПерерасчет);
					
					НоваяСтрока.СуммаПерерасчета = НоваяСтрока.СуммаТекущийРасчет - НоваяСтрока.СуммаНачислено;
				КонецЦикла; 	
				
				
			КонецЦикла; 
			
		КонецЕсли;	
		
		
		
		Запрос = Новый Запрос;
		МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		Запрос.МенеджерВременныхТаблиц =  МенеджерВременныхТаблиц;
		Запрос.Текст = "ВЫБРАТЬ
		|	ТаблицаПерерасчета.ЛицевойСчет,
		|	ТаблицаПерерасчета.Услуга,
		|	ТаблицаПерерасчета.МесяцНачисления,
		|	&Организация КАК Организация,
		|	ТаблицаПерерасчета.СуммаПерерасчета КАК Сумма,
		|	&Период КАК Период,
		|	ТаблицаПерерасчета.ВидНачисления
		|ПОМЕСТИТЬ ВременнаяТаблицаПерерасчет
		|ИЗ
		|	&ТаблицаПерерасчета КАК ТаблицаПерерасчета";
		Запрос.УстановитьПараметр("ТаблицаПерерасчета",ТаблицаПерерасчета);
		Запрос.УстановитьПараметр("Организация",ВыборкаСсылка.Ссылка.Организация);
		Запрос.УстановитьПараметр("Период", ВыборкаСсылка.Ссылка.МоментВремени().Дата);
		Запрос.Выполнить();	
		
		
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Перерасчет.Организация КАК Организация,
		|	Перерасчет.ЛицевойСчет,
		|	Перерасчет.Услуга,
		|	Перерасчет.МесяцНачисления,
		|	Перерасчет.Сумма КАК Сумма,
		|	РасчетыПоЛицевымСчетамОстатки.СуммаОстаток,
		|	ЕСТЬNULL(РасчетыПоЛицевымСчетамОстатки.СуммаОстаток, 0) + ЕСТЬNULL(Перерасчет.Сумма, 0) КАК СуммаАванс,
		|	&Период КАК Период,
		|	&Регистратор
		|ПОМЕСТИТЬ ВременнаяТаблицаАвансы
		|ИЗ
		|	ВременнаяТаблицаПерерасчет КАК Перерасчет
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.РасчетыПоЛицевымСчетам.Остатки(&Период, ) КАК РасчетыПоЛицевымСчетамОстатки
		|		ПО Перерасчет.Организация = РасчетыПоЛицевымСчетамОстатки.Организация
		|			И Перерасчет.ЛицевойСчет = РасчетыПоЛицевымСчетамОстатки.ЛицевойСчет
		|			И Перерасчет.Услуга = РасчетыПоЛицевымСчетамОстатки.Услуга
		|			И Перерасчет.МесяцНачисления = РасчетыПоЛицевымСчетамОстатки.МесяцНачисления
		|ГДЕ
		|	Перерасчет.Сумма < 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
		|	ВременнаяТаблицаАвансы.Организация КАК Организация,
		|	ВременнаяТаблицаАвансы.ЛицевойСчет КАК ЛицевойСчет,
		|	ВременнаяТаблицаАвансы.Услуга КАК Услуга,
		|	ВременнаяТаблицаАвансы.МесяцНачисления КАК МесяцНачисления,
		|	ВременнаяТаблицаАвансы.СуммаАванс КАК Сумма,
		|	ВременнаяТаблицаАвансы.Период КАК Период,
		|	NULL КАК ВидНачисления,
		|	ВременнаяТаблицаАвансы.Регистратор,
		|	NULL КАК ВидНачисленияПерерасчет
		|ИЗ
		|	ВременнаяТаблицаАвансы КАК ВременнаяТаблицаАвансы
		|ГДЕ
		|	ВременнаяТаблицаАвансы.СуммаАванс < 0
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход),
		|	ВременнаяТаблицаАвансы.Организация,
		|	ВременнаяТаблицаАвансы.ЛицевойСчет,
		|	ВременнаяТаблицаАвансы.Услуга,
		|	NULL,
		|	-ВременнаяТаблицаАвансы.СуммаАванс,
		|	ВременнаяТаблицаАвансы.Период,
		|	NULL,
		|	ВременнаяТаблицаАвансы.Регистратор,
		|	NULL
		|ИЗ
		|	ВременнаяТаблицаАвансы КАК ВременнаяТаблицаАвансы
		|ГДЕ
		|	ВременнаяТаблицаАвансы.СуммаАванс < 0
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход),
		|	ВременнаяТаблицаПерерасчет.Организация,
		|	ВременнаяТаблицаПерерасчет.ЛицевойСчет,
		|	ВременнаяТаблицаПерерасчет.Услуга,
		|	ВременнаяТаблицаПерерасчет.МесяцНачисления,
		|	ВременнаяТаблицаПерерасчет.Сумма,
		|	ВременнаяТаблицаПерерасчет.Период,
		|	ВременнаяТаблицаПерерасчет.ВидНачисления,
		|	&Регистратор,
		|	ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Перерасчет)
		|ИЗ
		|	ВременнаяТаблицаПерерасчет КАК ВременнаяТаблицаПерерасчет
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ ВременнаяТаблицаАвансы";
		
		Запрос.УстановитьПараметр("Период", ВыборкаСсылка.Ссылка.МоментВремени().Дата);
		Запрос.УстановитьПараметр("Регистратор", ВыборкаСсылка.Ссылка);
		
		РезультатЗапроса = Запрос.ВыполнитьПакет();
		
		ДляДвижения = РезультатЗапроса[1].Выгрузить();
		
		Для каждого СтрокаДвижения Из ДляДвижения Цикл
			
			Если  СтрокаДвижения.Сумма = 0 Тогда
				Продолжить;
			КонецЕсли;	
			НоваяЗапись = НаборЗаписей.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяЗапись,СтрокаДвижения);
		
			
		КонецЦикла; 
		
		НаборЗаписей.Записать();
		
	КонецЦикла;
	
	ЗапросТариф = Новый Запрос;
	ЗапросТариф.Текст =  "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	                     |	УправлениеТарифами.Ссылка
	                     |ИЗ
	                     |	Документ.УправлениеТарифами КАК УправлениеТарифами
	                     |ГДЕ
	                     |	УправлениеТарифами.Проведен = ИСТИНА";
	РезультатТариф = ЗапросТариф.Выполнить();
	Если Не РезультатТариф.Пустой() Тогда
		ВыборкаТариф = РезультатТариф.Выбрать();
		Пока ВыборкаТариф.Следующий() Цикл
			НаборЗаписейТариф = РегистрыСведений.Тарифы.СоздатьНаборЗаписей();
			НаборЗаписейТариф.Отбор.Регистратор.Установить(ВыборкаТариф.Ссылка);
			НаборЗаписейТариф.Отбор.Регистратор.Использование = Истина;
			НаборЗаписейТариф.Прочитать();
			
			Для каждого Запись Из НаборЗаписейТариф Цикл
			
				Запись.ЗначениеТарифаЛьгота = Запись.ЗначениеТарифа;
				Запись.ЗначениеТарифаПоНормеЛьгота = Запись.ЗначениеТарифаПоНорме;
			
			КонецЦикла; 
	        НаборЗаписейТариф.Записать();
		КонецЦикла;
	КонецЕсли;

	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Организации.Ссылка КАК Организация
		|ИЗ
		|	Справочник.Организации КАК Организации
		|ГДЕ
		|	Организации.ПометкаУдаления = ЛОЖЬ";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаОрганизации = РезультатЗапроса.Выбрать();
	
	Если ВыборкаОрганизации.Количество() = 1 Тогда
		ВыборкаОрганизации.Следующий();
	
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	Кассы.Ссылка КАК Касса
			|ИЗ
			|	Справочник.Кассы КАК Кассы
			|ГДЕ
			|	Кассы.ПометкаУдаления = ЛОЖЬ";
		
		РезультатЗапроса = Запрос.Выполнить();
		Если НЕ РезультатЗапроса.Пустой() Тогда
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				КАсса = ВыборкаДетальныеЗаписи.Касса.ПолучитьОбъект();
				КАсса.Организация = ВыборкаОрганизации.Организация;
				КАсса.Ответственный = Пользователи.АвторизованныйПользователь();
				КАсса.Записать();
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;


	
КонецПроцедуры

