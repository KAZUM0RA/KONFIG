//
Процедура Релиз1_0_5_8() Экспорт
	
	ОбновитьДополнительныеОбработки();
	
	//Перенесем данные по расчетам льгот и субсидий в справочник организаций
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВидыУслуг.Ссылка КАК ВидУслуги,
	               |	ВидыУслуг.Наименование,
	               |	ВидыУслуг.КонтрагентДляРасчетаПоЛьготам КАК КонтрагентЛьгота,
	               |	ВидыУслуг.ДоговорДляРасчетаПоЛьготам КАК ДоговорЛьгота,
	               |	ВидыУслуг.КонтрагентДляРасчетаПоСубсидиям КАК КонтрагентСубсидия,
	               |	ВидыУслуг.ДоговорДляРасчетаПоСубсидиям КАК ДоговорСубсидия
	               |ИЗ
	               |	Справочник.ВидыУслуг КАК ВидыУслуг";
	Результат = Запрос.Выполнить().выгрузить();	
	
	ВыборкаОрганизации = Справочники.Организации.Выбрать();
	Пока ВыборкаОрганизации.Следующий() Цикл
		ОбъектОрганизация = ВыборкаОрганизации.Ссылка.ПолучитьОбъект();
		ОбъектОрганизация.ТабличнаяКонтрагентовДляСубсидийИЛьгот.Очистить();
		ОбъектОрганизация.ТабличнаяКонтрагентовДляСубсидийИЛьгот.Загрузить(Результат);
		ОбъектОрганизация.Записать();
	КонецЦикла; 	
	
	
		
