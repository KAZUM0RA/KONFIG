// Процедура заполняет пустую ИБ.
//
Процедура ПервыйЗапуск() Экспорт

	Справочники.Валюты.ЗаполнитьВалютыПоУмолчанию();
	Справочники.КлассификаторЕдиницИзмерения.ЗаполнитьЕдиницыИзмеренияПоУмолчанию();
	ЗаполнитьКонстантыПоУмолчанию();
	Справочники.ВидыУслуг.ЗаполнитьПредопределенныеВидыУслуг();
	ВерсионированиеОбъектов.ОбновитьНастройкиВерсионированияОбъектов();
	УстановитьПервуюОрганизацию();
	ОбновитьДополнительныеОбработки();
	
	ОбщегоНазначения.ХранилищеОбщихНастроекСохранить("ОбновлениеИБ", "ПервоначальноеЗаполнениеИБ", Истина);
	
КонецПроцедуры

// Процедура заполняет константы значением по умочанию.
//
Процедура ЗаполнитьКонстантыПоУмолчанию()
	
	Константы.УслугиСДПТПодробно.Установить(Истина);
	Константы.КонтролироватьОстаткиПриПроведении.Установить(Истина);
	
	ВалютаУчета = Справочники.Валюты.НайтиПоКоду("980");
	Константы.ВалютаУчета.Установить(ВалютаУчета);
	
КонецПроцедуры // ЗаполнитьКонстантыПоУмолчанию()

// Формирует код и наименование узла этой ИБ
//
//
// Параметры:
// нет
//  
// Возвращаемое значение:
// Нет
//
Процедура УстановитьКодНаименованиеУзлаЭтойИБ()
	
	УстановитьПривилегированныйРежим(Истина);
	
	ЭтотУзел = ПланыОбмена.ОбменУчетВОСМДБухгалтерия.ЭтотУзел();
	ЭтотУзелОбъект = ЭтотУзел.ПолучитьОбъект();
	
	ЕстьИзменения = Ложь;
	
	Если ПустаяСтрока(ЭтотУзелОбъект.Код) Тогда
		ЭтотУзелОбъект.УстановитьНовыйКод();
		ЕстьИзменения = Истина;
	КонецЕсли;
	
	Если ПустаяСтрока(ЭтотУзелОбъект.Наименование) Тогда
		ЭтотУзелОбъект.Наименование = НСтр("ru='Эта информационная база';uk='Ця інформаційна база'");
		ЕстьИзменения = Истина;
	КонецЕсли;
	
	Если ЕстьИзменения Тогда
		ЭтотУзелОбъект.Записать();
	КонецЕсли;
	
	/////
	ЭтотУзел = ПланыОбмена.ОбменСМобильнымиУстройствами.ЭтотУзел();
	ЭтотУзелОбъект = ЭтотУзел.ПолучитьОбъект();
	
	ЕстьИзменения = Ложь;
	
	Если ПустаяСтрока(ЭтотУзелОбъект.Код) Тогда
		ЭтотУзелОбъект.Код = "001";
		ЕстьИзменения = Истина;
	КонецЕсли;
	
	Если ПустаяСтрока(ЭтотУзелОбъект.Наименование) Тогда
		ЭтотУзелОбъект.Наименование = НСтр("ru='Центральный узел';uk='Центральний вузол'");
		ЕстьИзменения = Истина;
	КонецЕсли;
	
	Если ЕстьИзменения Тогда
		ЭтотУзелОбъект.Записать();
	КонецЕсли;
		
КонецПроцедуры

Процедура УстановитьПервуюОрганизацию()
	
	Запрос = Новый Запрос("
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	Организации.Ссылка КАК Организация
	|ИЗ
	|	Справочник.Организации КАК Организации
	|");
	
	Если Не Запрос.Выполнить().Пустой() тогда
		Возврат;
	КонецЕсли;
	
	ЗаписыватьОбъект = Ложь;
	
	СправочникОбъект = Справочники.Организации.СоздатьЭлемент();
	СправочникОбъект.УстановитьНовыйКод();
	СправочникОбъект.Наименование = "Наша Организация";
	СправочникОбъект.НаименованиеПолное = "Наша Организация";
	СправочникОбъект.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицо;
	СправочникОбъект.ТипОрганизации = Справочники.ТипыОрганизаций.ОСМД;
	
	Попытка
		СправочникОбъект.Записать();
	Исключение
	КонецПопытки;
	
КонецПроцедуры	

// Процедура обновления резиза 1.0.1.3.
//
Процедура Релиз1_0_1_3() Экспорт

	ВыборкаКвартир = Справочники.ОбъектыЛицевыхСчетов.Выбрать();
	Пока ВыборкаКвартир.Следующий() цикл
		Объект = ВыборкаКвартир.ПолучитьОбъект();
		Если Объект.ЖилойФонд = Перечисления.ЖилойНеЖилойФонд.Жилой тогда
			Объект.Наименование = "кв. №" + Прав("    "+Объект.Код,4) + Объект.Суффикс;
		Иначе
			Объект.Наименование = "оф. №" + Прав("    "+Объект.Код,4) + Объект.Суффикс;
		КонецЕсли;
		
		Попытка
			Объект.Записать();
		Исключение
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

// Процедура обновления резиза 1.0.1.5.
//
Процедура Релиз1_0_1_5() Экспорт

	ВыборкаПриборыУчета = Справочники.ПриборыУчета.Выбрать();
	Пока ВыборкаПриборыУчета.Следующий() цикл
		Объект = ВыборкаПриборыУчета.ПолучитьОбъект();
		
		Объект.Наименование = Объект.ЗаводскойНомер + "/" + Объект.Услуга.ВидУслуги;
		
		Попытка
			Объект.Записать();
		Исключение
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

// Процедура обновления резиза 1.0.1.6.
//
Процедура Релиз1_0_1_6() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Услуги.Ссылка КАК Услуга,
		|	Услуги.УДАЛИТЬДополнительнаяУслуга КАК ДополнительнаяУслуга
		|ИЗ
		|	Справочник.Услуги КАК Услуги
		|ГДЕ
		|	НЕ Услуги.ЭтоГруппа
		|	И Услуги.УДАЛИТЬДополнительнаяУслуга <> ЗНАЧЕНИЕ(Справочник.Услуги.ПустаяСсылка)";
		
	РезультатЗапроса = Запрос.Выполнить().Выбрать();		
	
	Пока РезультатЗапроса.Следующий() цикл
		Объект = РезультатЗапроса.Услуга.ПолучитьОбъект();
		
		Объект.СоставныеУслуги.Очистить();
		НоваяСтрока = Объект.СоставныеУслуги.Добавить(); 
		НоваяСтрока.Услуга = РезультатЗапроса.ДополнительнаяУслуга;
		
		Попытка
			Объект.Записать();
		Исключение
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

