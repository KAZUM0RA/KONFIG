		|	Справочник.ВидыУслуг КАК ВидыУслуг
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			Услуги.Ссылка КАК Услуга
		|		ИЗ
		|			Справочник.Услуги КАК Услуги
		|		ГДЕ
		|			НЕ Услуги.ЭтоГруппа) КАК ВложенныйЗапрос
		|		ПО ВидыУслуг.Ссылка = ВложенныйЗапрос.Услуга.ВидУслуги
		|
		|УПОРЯДОЧИТЬ ПО
		|	ВидыУслуг.Код,
		|	ВложенныйЗапрос.Услуга.Код
		|ИТОГИ ПО
		|	ВидУслуги,
		|	Услуга";
		
	ВыборкаВидУслуги = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);		
	
	НомерСортировкиВидУслуги = 0;
	Пока ВыборкаВидУслуги.Следующий() цикл
		НомерСортировкиВидУслуги = НомерСортировкиВидУслуги +1;
		
		Если ЗначениеЗаполнено(ВыборкаВидУслуги.ВидУслуги) Тогда
			ОбъектВидУслуги = ВыборкаВидУслуги.ВидУслуги.ПолучитьОбъект();
			ОбъектВидУслуги.ПолеСортировки = НомерСортировкиВидУслуги;
			Попытка
				ОбъектВидУслуги.Записать();
			Исключение
			КонецПопытки;
		КонецЕсли;
		
		НомерСортировкиУслуги = 0;
		
		ВыборкаУслуга = ВыборкаВидУслуги.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаУслуга.Следующий() Цикл
		
			НомерСортировкиУслуги = НомерСортировкиУслуги +1;
			Если НЕ ЗначениеЗаполнено(ВыборкаУслуга.Услуга) Тогда
				Продолжить;
			КонецЕсли; 
			ОбъектУслуга = ВыборкаУслуга.Услуга.ПолучитьОбъект();
			ОбъектУслуга.ПолеСортировки = НомерСортировкиУслуги;
			Попытка
				ОбъектУслуга.Записать();
			Исключение
			КонецПопытки;
			
		КонецЦикла; 
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбновитьДополнительныеОбработки()
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ТаблицаОбработок.Расширение КАК Расширение,
	|	ТаблицаОбработок.СтароеИмяФайла КАК СтароеИмяФайла,
	|	ТаблицаОбработок.ИмяМакета КАК ИмяМакета
	|ПОМЕСТИТЬ ТаблицаОбработок
	|ИЗ
	|	&ТаблицаОбработок КАК ТаблицаОбработок
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаОбработок.Расширение КАК Расширение,
	|	ТаблицаОбработок.ИмяМакета КАК ИмяМакета,
	|	ЕСТЬNULL(НайденПоИмениОбъекта.Ссылка, НайденПоИмениФайла.Ссылка) КАК Ссылка,
	|	ЕСТЬNULL(НайденПоИмениОбъекта.Версия, НайденПоИмениФайла.Версия) КАК Версия
	|ИЗ
	|	ТаблицаОбработок КАК ТаблицаОбработок
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДополнительныеОтчетыИОбработки КАК НайденПоИмениФайла
	|		ПО ТаблицаОбработок.СтароеИмяФайла = НайденПоИмениФайла.ИмяФайла
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДополнительныеОтчетыИОбработки КАК НайденПоИмениОбъекта
	|		ПО ТаблицаОбработок.ИмяМакета = НайденПоИмениОбъекта.ИмяОбъекта";
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	
	ТаблицаОбработок = Новый ТаблицаЗначений();
	ТаблицаОбработок.Колонки.Добавить("Расширение",     Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(3, ДопустимаяДлина.Переменная)));
	ТаблицаОбработок.Колонки.Добавить("СтароеИмяФайла", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(260, ДопустимаяДлина.Переменная)));
	ТаблицаОбработок.Колонки.Добавить("ИмяМакета",      Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(100, ДопустимаяДлина.Переменная)));
	
	// Текущее имя файла образовыватся от имени макета и расширения
	СтрокаТаблицы = ТаблицаОбработок.Добавить();
	СтрокаТаблицы.ИмяМакета      = "ВыгрузкаЛьготDBF";
	СтрокаТаблицы.СтароеИмяФайла = "ВыгрузкаЛьготDBF.epf";
	СтрокаТаблицы.Расширение     = "epf";
	
	СтрокаТаблицы = ТаблицаОбработок.Добавить();
	СтрокаТаблицы.ИмяМакета      = "ВыгрузкаНаТСО";
	СтрокаТаблицы.СтароеИмяФайла = "ВыгрузкаНаТСО.epf";
	СтрокаТаблицы.Расширение     = "epf";
	
	СтрокаТаблицы = ТаблицаОбработок.Добавить();
	СтрокаТаблицы.ИмяМакета      = "КлиентБанкУниверсальный";
	СтрокаТаблицы.СтароеИмяФайла = "КлиентБанкУниверсальный.epf";
	СтрокаТаблицы.Расширение     = "epf";
	
	СтрокаТаблицы = ТаблицаОбработок.Добавить();
	СтрокаТаблицы.ИмяМакета      = "ЗагрузкаСубсидийИзDBF";
	СтрокаТаблицы.СтароеИмяФайла = "ЗагрузкаСубсидийИзDBF.epf";
	СтрокаТаблицы.Расширение     = "epf";
	
	СтрокаТаблицы = ТаблицаОбработок.Добавить();
	СтрокаТаблицы.ИмяМакета      = "МонетизацияЛьготИСубсидий";
	СтрокаТаблицы.СтароеИмяФайла = "ЛьготыИСубсидии.epf";
	СтрокаТаблицы.Расширение     = "epf";
	
	Запрос.УстановитьПараметр("ТаблицаОбработок", ТаблицаОбработок);
	
	АдминистраторСистемы = Справочники.Пользователи.НайтиПоНаименованию("Администратор");
	Выборка = Запрос.Выполнить().Выбрать();
	Защита = Неопределено;
	Попытка
		Защита = Новый ("ОписаниеЗащитыОтОпасныхДействий");
		Защита.ПредупреждатьОбОпасныхДействиях = Ложь;
	Исключение
	КонецПопытки;
	
	Пока Выборка.Следующий() Цикл
		ДвоичныеДанные    = ПолучитьОбщийМакет(Выборка.ИмяМакета);
		АдресДанных       = ПоместитьВоВременноеХранилище(ДвоичныеДанные);
		Менеджер          = ?(Выборка.Расширение = "erf", ВнешниеОтчеты, ВнешниеОбработки);
		Если Защита = Неопределено Тогда
			ИмяОбъекта        = Менеджер.Подключить(АдресДанных, , Истина);
		Иначе		
			ИмяОбъекта        = Менеджер.Подключить(АдресДанных, , Истина,Защита);
		КонецЕсли;
		ОбработкаОбъект   = Менеджер.Создать(ИмяОбъекта,БезопасныйРежим());
		ОбработкаСведения = ОбработкаОбъект.СведенияОВнешнейОбработке();
		
		Если Выборка.Версия = ОбработкаСведения.Версия Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Выборка.Ссылка) Тогда
			СправочникОбъект = Выборка.Ссылка.ПолучитьОбъект();
		Иначе
			СправочникОбъект = Справочники.ДополнительныеОтчетыИОбработки.СоздатьЭлемент();
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(СправочникОбъект, ОбработкаСведения, "Наименование, БезопасныйРежим, Версия, Информация");
		
		СправочникОбъект.Публикация = Перечисления.ВариантыПубликацииДополнительныхОтчетовИОбработок.Используется;
		СправочникОбъект.Вид        = ДополнительныеОтчетыИОбработки.ПолучитьВидОбработкиПоСтроковомуПредставлениюВида(
			ОбработкаСведения.Вид
		);
		
		СправочникОбъект.ИспользоватьДляФормыОбъекта = Истина;
		СправочникОбъект.ИспользоватьДляФормыСписка  = Истина;
		СправочникОбъект.Ответственный               = АдминистраторСистемы;
		СправочникОбъект.ХранилищеОбработки          = Новый ХранилищеЗначения(ДвоичныеДанные);
		СправочникОбъект.ИмяОбъекта                  = Выборка.ИмяМакета;
		СправочникОбъект.ИмяФайла                    = Выборка.ИмяМакета + "." + Выборка.Расширение;
		
		СправочникОбъект.Команды.Очистить();
		СправочникОбъект.Назначение.Очистить();
		СправочникОбъект.Разделы.Очистить();
		
		Для Каждого ОписаниеКоманды Из ОбработкаСведения.Команды Цикл
			
			НоваяКоманда = СправочникОбъект.Команды.Добавить();
			
			Если ОписаниеКоманды.Использование = "ОткрытиеФормы" Тогда
				НоваяКоманда.ВариантЗапуска = Перечисления.СпособыВызоваДополнительныхОбработок.ОткрытиеФормы;
			ИначеЕсли ОписаниеКоманды.Использование = "ВызовКлиентскогоМетода" Тогда
				НоваяКоманда.ВариантЗапуска = Перечисления.СпособыВызоваДополнительныхОбработок.ВызовКлиентскогоМетода;
			ИначеЕсли ОписаниеКоманды.Использование = "ВызовСерверногоМетода" Тогда
				НоваяКоманда.ВариантЗапуска = Перечисления.СпособыВызоваДополнительныхОбработок.ВызовСерверногоМетода;
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(НоваяКоманда, ОписаниеКоманды, "Идентификатор, Модификатор, ПоказыватьОповещение, Представление");
			
		КонецЦикла;
		
		Если ДополнительныеОтчетыИОбработки.ПроверитьГлобальнаяОбработка(СправочникОбъект.Вид) Тогда
			Разделы = Новый Массив;
			Если СправочникОбъект.Вид = Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительнаяОбработка Тогда
				ДополнительныеОтчетыИОбработкиПереопределяемый.ОпределитьРазделыСДополнительнымиОбработками(Разделы);
			Иначе
				ДополнительныеОтчетыИОбработкиПереопределяемый.ОпределитьРазделыСДополнительнымиОтчетами(Разделы);
			КонецЕсли;
			
			Для Каждого Раздел Из Разделы Цикл
				НовыйРаздел = СправочникОбъект.Разделы.Добавить();
				Если Раздел = ДополнительныеОтчетыИОбработкиКлиентСервер.ИдентификаторРабочегоСтола() Тогда
					НовыйРаздел.Раздел = Справочники.ИдентификаторыОбъектовМетаданных.ПустаяСсылка();
				Иначе
					НовыйРаздел.Раздел = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(Раздел);
				КонецЕсли;
			КонецЦикла;
		Иначе
			Для Каждого ОписаниеНазначения Из ОбработкаСведения.Назначение Цикл
				НовоеНазначение = СправочникОбъект.Назначение.Добавить();
				НовоеНазначение.ПолноеИмяОбъектаМетаданных = ОписаниеНазначения;
			КонецЦикла;
		КонецЕсли;
		
		СправочникОбъект.Записать();
	КонецЦикла;
	
КонецПроцедуры

// Процедура обновления резиза 1.0.2.5.
//
Процедура Релиз1_0_2_5() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ЛицевыеСчета.Ссылка КАК ЛицевойСчет
		|ИЗ
		|	Справочник.ЛицевыеСчета КАК ЛицевыеСчета";
		
	ВыборкаЛицевыеСчета = Запрос.Выполнить().Выбрать();		
	
	ДопЧисло = 0;
	Пока ВыборкаЛицевыеСчета.Следующий() цикл
		
		ДопЧисло = ДопЧисло +1;
		ОбъектЛицевойСчет = ВыборкаЛицевыеСчета.ЛицевойСчет.ПолучитьОбъект();
		ОбъектЛицевойСчет.Идентификатор = ОСМДСервер.СгенерироватьИдентификатор(ДопЧисло);
		Попытка
			ОбъектЛицевойСчет.Записать();
		Исключение
		КонецПопытки;
		
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Услуги.Ссылка КАК Услуга
		|ИЗ
		|	Справочник.Услуги КАК Услуги
		|ГДЕ
		|	НЕ Услуги.ЭтоГруппа";
		
	ВыборкаУслуги = Запрос.Выполнить().Выбрать();		
	
	ДопЧисло = 0;
	Пока ВыборкаУслуги.Следующий() цикл
		
		ДопЧисло = ДопЧисло +1;
		ОбъектУслуга = ВыборкаУслуги.Услуга.ПолучитьОбъект();
		ОбъектУслуга.Идентификатор = ОСМДСервер.СгенерироватьИдентификатор(ДопЧисло);
		Попытка
			ОбъектУслуга.Записать();
		Исключение
		КонецПопытки;
		
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ПриборыУчета.Ссылка КАК ПриборУчета
		|ИЗ
		|	Справочник.ПриборыУчета КАК ПриборыУчета";
		
	ВыборкаПриборыУчета = Запрос.Выполнить().Выбрать();		
	
	ДопЧисло = 0;
	Пока ВыборкаПриборыУчета.Следующий() цикл
		
		ДопЧисло = ДопЧисло +1;
		ОбъектПриборУчета = ВыборкаПриборыУчета.ПриборУчета.ПолучитьОбъект();
		ОбъектПриборУчета.Идентификатор = ОСМДСервер.СгенерироватьИдентификатор(ДопЧисло);
		Попытка
			ОбъектПриборУчета.Записать();
		Исключение
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

// Процедура обновления резиза 1.0.2.6.
//
Процедура Релиз1_0_2_6() Экспорт
	
	ОбновитьДополнительныеОбработки();	
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ЗаменаПриборовУчетаОсновная.ПриборУчета КАК ПриборУчета,
		|	ЗаменаПриборовУчетаОсновная.ОбъектУстановки КАК ОбъектУстановки,
		|	ЗаменаПриборовУчетаОсновная.ПоказаниеПредыдущее,
		|	ЗаменаПриборовУчетаОсновная.Показание,
		|	ЗаменаПриборовУчетаОсновная.ПриборУчета.Услуга КАК Услуга,
		|	ЗаменаПриборовУчетаОсновная.Ссылка КАК Ссылка,
		|	ЗаменаПриборовУчетаОсновная.Ссылка.Дата КАК Период,
		|	ЗаменаПриборовУчетаОсновная.НомерСтроки КАК НомерСтроки
		|ИЗ
		|	Документ.ЗаменаПриборовУчета.Основная КАК ЗаменаПриборовУчетаОсновная
		|ГДЕ
		|	ЗаменаПриборовУчетаОсновная.Ссылка.Проведен
		|
		|УПОРЯДОЧИТЬ ПО
		|	Ссылка,
		|	НомерСтроки
		|ИТОГИ ПО
		|	Ссылка,
		|	ОбъектУстановки,
		|	ПриборУчета";
		
	РезультатЗапроса = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока РезультатЗапроса.Следующий() Цикл
		
		ДокОбъект = РезультатЗапроса.Ссылка.ПолучитьОбъект();
		
		ТаблицаНабораЗаписей = ДокОбъект.Движения.ЗаменыПриборовУчета.ВыгрузитьКолонки();
		
		ВыбокаЛицевойСчет = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыбокаЛицевойСчет.Следующий() Цикл
		
			ВыбокаПриборУчета = ВыбокаЛицевойСчет.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыбокаПриборУчета.Следующий() Цикл
				
				ВыбокаДетальные = ВыбокаПриборУчета.Выбрать();
				Пока ВыбокаДетальные.Следующий() Цикл
					
					НоваяСтрока = ТаблицаНабораЗаписей.Добавить();
					НоваяСтрока.Активность = Истина;
					НоваяСтрока.ОбъектУстановки = ВыбокаДетальные.ОбъектУстановки;
					НоваяСтрока.ПриборУчета = ВыбокаДетальные.ПриборУчета;
					НоваяСтрока.ВидТарифа = Перечисления.ВидыТарифов.Общий;
					
					НоваяСтрока.Период = ВыбокаДетальные.Период;
					НоваяСтрока.Показание = ВыбокаДетальные.Показание;
					НоваяСтрока.ПоказаниеПредыдущее = ВыбокаДетальные.ПоказаниеПредыдущее;
					НоваяСтрока.Услуга = ВыбокаДетальные.Услуга;
				
				КонецЦикла; 
			
			КонецЦикла; 
		
		КонецЦикла; 
		
		ДвиженияЗаменыПриборовУчета = ДокОбъект.Движения.ЗаменыПриборовУчета;
		ДвиженияЗаменыПриборовУчета.Записывать = Истина;
		ДвиженияЗаменыПриборовУчета.Загрузить(ТаблицаНабораЗаписей);
		ДвиженияЗаменыПриборовУчета.Записать();
		
	КонецЦикла; 
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	УправлениеПриборамиУчетаПриборыУчета.Ссылка КАК Ссылка,
		|	УправлениеПриборамиУчетаПриборыУчета.НомерСтроки КАК НомерСтроки,
		|	УправлениеПриборамиУчетаПриборыУчета.ПриборУчета КАК ПриборУчета,
		|	УправлениеПриборамиУчетаПриборыУчета.КонечноеПоказание КАК Показание,
		|	УправлениеПриборамиУчетаПриборыУчета.ДатаОтключения КАК Период,
		|	УправлениеПриборамиУчетаПриборыУчета.ПриборУчета.Услуга КАК Услуга,
		|	УправлениеПриборамиУчетаПриборыУчета.Ссылка.ОбъектУстановки КАК ОбъектУстановки
		|ИЗ
		|	Документ.УправлениеПриборамиУчета.ПриборыУчета КАК УправлениеПриборамиУчетаПриборыУчета
		|ГДЕ
		|	УправлениеПриборамиУчетаПриборыУчета.Ссылка.Проведен
		|	И (УправлениеПриборамиУчетаПриборыУчета.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийУправленияПриборамиУчета.ОтключениеПрибораУчета)
		|			ИЛИ УправлениеПриборамиУчетаПриборыУчета.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийУправленияПриборамиУчета.ОтключениеНаПоверку))
		|
		|УПОРЯДОЧИТЬ ПО
		|	Ссылка,
		|	НомерСтроки
		|ИТОГИ ПО
		|	Ссылка,
		|	ОбъектУстановки,
		|	ПриборУчета";
		
		
	РезультатЗапроса = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока РезультатЗапроса.Следующий() Цикл
		
		ДокОбъект = РезультатЗапроса.Ссылка.ПолучитьОбъект();
		
		ТаблицаНабораЗаписей = ДокОбъект.Движения.ЗаменыПриборовУчета.ВыгрузитьКолонки();
		
		ВыбокаЛицевойСчет = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыбокаЛицевойСчет.Следующий() Цикл
		
			ВыбокаПриборУчета = ВыбокаЛицевойСчет.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыбокаПриборУчета.Следующий() Цикл
				
				ВыбокаДетальные = ВыбокаПриборУчета.Выбрать();
				Пока ВыбокаДетальные.Следующий() Цикл
					
					НоваяСтрока = ТаблицаНабораЗаписей.Добавить();
					НоваяСтрока.Активность = Истина;
					НоваяСтрока.ОбъектУстановки = ВыбокаДетальные.ОбъектУстановки;
					НоваяСтрока.ПриборУчета = ВыбокаДетальные.ПриборУчета;
					НоваяСтрока.ВидТарифа = Перечисления.ВидыТарифов.Общий;
					
					НоваяСтрока.Период = ВыбокаДетальные.Период;
					НоваяСтрока.Показание = ВыбокаДетальные.Показание;
					НоваяСтрока.Услуга = ВыбокаДетальные.Услуга;
					
					ТаблицаПредыдущихПоказаний = РегистрыСведений.ПоказанияПриборовУчета.СрезПоследних(Новый Граница(НоваяСтрока.Период, ВидГраницы.Исключая), Новый Структура("ПриборУчета", НоваяСтрока.ПриборУчета));
					Если ТаблицаПредыдущихПоказаний.Количество() > 0 Тогда
						НоваяСтрока.ПоказаниеПредыдущее = ТаблицаПредыдущихПоказаний[0].Значение;
					КонецЕсли; 
					
				КонецЦикла; 
			
			КонецЦикла; 
		
		КонецЦикла; 
		
		ДвиженияЗаменыПриборовУчета = ДокОбъект.Движения.ЗаменыПриборовУчета;
		ДвиженияЗаменыПриборовУчета.Записывать = Истина;
		ДвиженияЗаменыПриборовУчета.Загрузить(ТаблицаНабораЗаписей);
		ДвиженияЗаменыПриборовУчета.Записать();
		
	КонецЦикла; 
		
КонецПроцедуры

