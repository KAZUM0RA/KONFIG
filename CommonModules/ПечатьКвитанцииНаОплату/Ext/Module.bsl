Функция ПолучитьПредполагаемыеОплатыПоРеструктуризации(ЛицевыеСчета,МесяцНачисления)

	ЗАпрос = Новый Запрос;
	Запрос.Текст =  "ВЫБРАТЬ
	                |	ПлатежиПоРеструктуризацииДолга.ЛицевойСчет КАК ЛицевойСчет,
	                |	ПлатежиПоРеструктуризацииДолга.СуммаПлатежа КАК СуммаПлатежа
	                |ИЗ
	                |	РегистрСведений.ПлатежиПоРеструктуризацииДолга КАК ПлатежиПоРеструктуризацииДолга
	                |ГДЕ
	                |	ПлатежиПоРеструктуризацииДолга.Период <= НачалоПериода(&МесяцНачисления, МЕСЯЦ)
	                |	И ПлатежиПоРеструктуризацииДолга.ЛицевойСчет В(&ЛицевыеСчета)
	                |ИТОГИ
	                |	СУММА(СуммаПлатежа)
	                |ПО
	                |	ЛицевойСчет";
	Запрос.УстановитьПараметр("ЛицевыеСчета", ЛицевыеСчета);
	Запрос.УстановитьПараметр("МесяцНачисления", МесяцНачисления);
	
	Результат  = Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() тогда
		
	   Возврат Результат.СуммаПлатежа;
   Иначе
	   Возврат 0;
	КонецЕсли;   
	
	
КонецФункции // ПолучитьПредполагаемыеОплатыПоРеструктуризации()

Функция НомерБанковскогоСчетаСоответствуетСтандартуIBAN(НомерСчета) Экспорт
	
	Результат = Ложь;
	
	ДлинаНомера = СтрДлина(НомерСчета);
	КодСтраны = Лев(НомерСчета, 2);
	
	Если КодСтраны = "UA" И ДлинаНомера = 29 Тогда
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьБанкПоНомеруСчетаIBAN(НомерСчета) Экспорт
	
	БанкПоСчету = Неопределено;
	
	КодБанка = ПолучитьКодБанкаПоНомеруСчетаIBAN(НомерСчета);
	
	Если ЗначениеЗаполнено(КодБанка) Тогда
		
		БанкПоСчету = Справочники.Банки.НайтиПоКоду(КодБанка);
		Если БанкПоСчету.Пустая() или БанкПоСчету.ЭтоГруппа Тогда
			БанкПоСчету = "";			
		КонецЕсли;		
	КонецЕсли;
	
	Возврат БанкПоСчету;
	
КонецФункции

Функция ПолучитьКодБанкаПоНомеруСчетаIBAN(НомерСчета) Экспорт
	
	КодБанка = "";
	
	Если НомерБанковскогоСчетаСоответствуетСтандартуIBAN(НомерСчета) Тогда
		КодБанка = Сред(НомерСчета, 5, 6);
	КонецЕсли;
	
	Возврат КодБанка;
	
КонецФункции

Функция ПолучитьПредставлениеБанковскогоСчета(БанковскийСчет) Экспорт
	
	ДатаПериода = ТекущаяДата();
	
	НачалоПереходногоПериода = ОбщегоНазначенияПовтИсп.ПолучитьДатуНачалаПереходаНаСтандартIBAN();
	КонецПереходногоПериода = ОбщегоНазначенияПовтИсп.ПолучитьДатуОкончанияПереходаНаСтандартIBAN();
	ПервыйНомерСчета = "";
	ВторойНомерСчета = "";
	Если ДатаПериода > КонецПереходногоПериода Тогда
		ПервыйНомерСчета = БанковскийСчет.НомерСчета;
	ИначеЕсли ДатаПериода >= НачалоПереходногоПериода И ДатаПериода <= КонецПереходногоПериода Тогда
		ПервыйНомерСчета = БанковскийСчет.НомерСчета;
		Если ЗначениеЗаполнено(БанковскийСчет.НомерСчетаУстаревший) И БанковскийСчет.НомерСчетаУстаревший <> БанковскийСчет.НомерСчета Тогда
			ВторойНомерСчета = БанковскийСчет.НомерСчетаУстаревший;
		КонецЕсли;
	Иначе
		Если ЗначениеЗаполнено(БанковскийСчет.НомерСчетаУстаревший) Тогда
			ПервыйНомерСчета = БанковскийСчет.НомерСчетаУстаревший;
		Иначе
			ПервыйНомерСчета = БанковскийСчет.НомерСчета;
		КонецЕсли;
	КонецЕсли;
	
	ПредставлениеСчета = "";
	Если ЗначениеЗаполнено(ПервыйНомерСчета) Тогда
		
		ПредставлениеСчета = ПервыйНомерСчета 
			+ ?(ЗначениеЗаполнено(ВторойНомерСчета), 
				" (" + НСтр("ru='устар. ';uk='застар. '") + ВторойНомерСчета + ")", "");

	КонецЕсли;
		
	Возврат ПредставлениеСчета;

КонецФункции

Функция ПолучитьОбщедомовыеПриборыУчета(Здание, ПериодНачисления)
	тзЗначения = Новый ТаблицаЗначений;
