Функция ПроверитьПоверкуПрибораУчета(ОбъектУстановки, ПриборУчета)
	Запрос = Новый Запрос;
	Запрос.Текст =
	    "ВЫБРАТЬ
	    |	ПоверкиПриборовУчетаСрезПоследних.Период,
	    |	ПоверкиПриборовУчетаСрезПоследних.ПоверкаВыполнена
	    |ИЗ
	    |	РегистрСведений.ПоверкиПриборовУчета.СрезПоследних(
	    |			&НаДату,
	    |			ОбъектУстановки = &ОбъектУстановки
	    |				И ПриборУчета = &ПриборУчета) КАК ПоверкиПриборовУчетаСрезПоследних";
	Запрос.УстановитьПараметр("НаДату", ТекущаяДата());
	Запрос.УстановитьПараметр("ОбъектУстановки", ОбъектУстановки);
	Запрос.УстановитьПараметр("ПриборУчета", ПриборУчета);
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.Период <= ТекущаяДата() И Выборка.ПоверкаВыполнена = Ложь Тогда
			Возврат Истина;
		Иначе
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
КонецФункции