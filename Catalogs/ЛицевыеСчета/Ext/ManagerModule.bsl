Функция ПечатьПамяткаДляДоступаВЛичныйКабинетНаСайте(ТабличныйДокумент, ПараметрыПечати, ТекущийДокумент)
	
	Если ТипЗнч(ТекущийДокумент) <> Тип("Структура") Тогда
		Возврат ТабличныйДокумент;	
	КонецЕсли;
	
	Макет = ПолучитьМакет("ПамяткаДляДоступаВЛичныйКабинетНаСайте");
	
	СтруктураНастроек = ХранилищеОбщихНастроек.Загрузить("Обработка.ИнтеграцияССайтом");
	
	АдресСайта = "";	
	Если ТипЗнч(СтруктураНастроек) = Тип("Структура") Тогда
		АдресСайта = СтруктураНастроек.НастройкаДоступа.АдресСайта;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ЛицевойСчет КАК ЛицевойСчет,
		|	ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ОтветственныйВладелец КАК ФИО,
		|	ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ЛицевойСчет.Владелец.Наименование КАК Адрес,
		|	ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ЛицевойСчет.ОбъектЛицевогоСчета.Наименование КАК Квартира,
		|	ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ЛицевойСчет.Владелец КАК Здание
		|ИЗ
		|	РегистрСведений.ОтветственныйВладелецЛицевогоСчета.СрезПоследних(&Дата, ЛицевойСчет = &ЛицевойСчет) КАК ОтветственныйВладелецЛицевогоСчетаСрезПоследних";
		
	Запрос.УстановитьПараметр("ЛицевойСчет", ТекущийДокумент.ЛицевойСчет);
	Запрос.УстановитьПараметр("Дата",     ТекущаяДата());
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Следующий() Тогда
	
		Область = Макет.ПолучитьОбласть("Блок1");
		Область.Параметры.ЛицевойСчет = РезультатЗапроса.ЛицевойСчет;
		Область.Параметры.ФИО = РезультатЗапроса.ФИО;
		Область.Параметры.Адрес = РезультатЗапроса.Адрес + " " + РезультатЗапроса.Квартира;
		
		ТабличныйДокумент.Вывести(Область);
		
		Область = Макет.ПолучитьОбласть("Блок2");
		Область.Параметры.ФИО = РезультатЗапроса.ФИО;
		ТабличныйДокумент.Вывести(Область);
		
		Область = Макет.ПолучитьОбласть("Блок3");
		ТабличныйДокумент.Вывести(Область);
		
		Область = Макет.ПолучитьОбласть("Блок4");
		Область.Параметры.АдресСайта = АдресСайта;
		Область.Параметры.Логин = ТекущийДокумент.Логин;
		Область.Параметры.Пароль = ТекущийДокумент.Пароль;
		ТабличныйДокумент.Вывести(Область);
		
	КонецЕсли;
	
	Возврат ТабличныйДокумент;	
	 
КонецФункции

Функция ПолучитьОбщуюСтруктуруКвитанции(ЛицевыеСчета, МесяцНачисления) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	РасчетыПоЛицевымСчетамОстатки.ЛицевойСчет КАК ЛицевойСчет,
	               |	РасчетыПоЛицевымСчетамОстатки.Услуга КАК Услуга,
	               |	РасчетыПоЛицевымСчетамОстатки.СуммаОстаток КАК СуммаОстаток
	               |ИЗ
	               |	РегистрНакопления.РасчетыПоЛицевымСчетам.Остатки(КОНЕЦПЕРИОДА(&МесяцНачисления, МЕСЯЦ), ЛицевойСчет В (&ЛицевыеСчета)) КАК РасчетыПоЛицевымСчетамОстатки
	               |ГДЕ
	               |	РасчетыПоЛицевымСчетамОстатки.Услуга <> ЗНАЧЕНИЕ(Справочник.Услуги.РеструктуризацияДолга)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	РасчетыПоЛицевымСчетамОстатки.ЛицевойСчет,
	               |	РасчетыПоЛицевымСчетамОстатки.Услуга,
	               |	РасчетыПоЛицевымСчетамОстатки.СуммаОстаток
	               |ИТОГИ
	               |	СУММА(СуммаОстаток)
	               |ПО
	               |	ЛицевойСчет,
	               |	Услуга
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	УстановленныеПриборыУчетаСрезПоследних.ОбъектУстановки,
	               |	УстановленныеПриборыУчетаСрезПоследних.ПриборУчета,
	               |	СУММА(ЕСТЬNULL(ПоказанияПрибораУчета.ТекущиеПоказания, 0)) КАК ТекущиеПоказания,
	               |	СУММА(ЕСТЬNULL(ПоказанияПрибораУчета.ПредыдущиеПоказания, 0)) КАК ПредыдущиеПоказания,
	               |	ПоказанияПрибораУчета.ПриборУчета.Коэффициент,
	               |	КОЛИЧЕСТВО(УстановленныеПриборыУчетаСрезПоследних.ПриборУчета) КАК КоличествоПиборовНаУслуге,
	               |	ПоказанияПрибораУчета.ПриборУчета.Услуга КАК Услуга,
	               |	ПоказанияПрибораУчета.ПриборУчета.ЕдиницаИзмерения КАК ЕдиницаИзмерения
	               |ИЗ
	               |	РегистрСведений.УстановленныеПриборыУчета.СрезПоследних(КОНЕЦПЕРИОДА(&МесяцНачисления, МЕСЯЦ), ОбъектУстановки В (&ЛицевыеСчета)) КАК УстановленныеПриборыУчетаСрезПоследних
	               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			ПоказанияПриборовУчетаСрезПоследних.ПриборУчета КАК ПриборУчета,
	               |			СУММА(ПоказанияПриборовУчетаСрезПоследних.Значение) КАК ТекущиеПоказания,
	               |			СУММА(0) КАК ПредыдущиеПоказания,
	               |			ПоказанияПриборовУчетаСрезПоследних.ВидТарифа КАК ВидТарифа
	               |		ИЗ
	               |			РегистрСведений.ПоказанияПриборовУчета.СрезПоследних(КОНЕЦПЕРИОДА(&МесяцНачисления, МЕСЯЦ), ) КАК ПоказанияПриборовУчетаСрезПоследних
	               |		
	               |		СГРУППИРОВАТЬ ПО
	               |			ПоказанияПриборовУчетаСрезПоследних.ПриборУчета,
	               |			ПоказанияПриборовУчетаСрезПоследних.ВидТарифа
	               |		
	               |		ОБЪЕДИНИТЬ ВСЕ
	               |		
	               |		ВЫБРАТЬ
	               |			ПоказанияПриборовУчетаСрезПоследних.ПриборУчета,
	               |			СУММА(0),
	               |			СУММА(ПоказанияПриборовУчетаСрезПоследних.Значение),
	               |			ПоказанияПриборовУчетаСрезПоследних.ВидТарифа
	               |		ИЗ
	               |			РегистрСведений.ПоказанияПриборовУчета.СрезПоследних(ДОБАВИТЬКДАТЕ(КОНЕЦПЕРИОДА(&МесяцНачисления, МЕСЯЦ), ДЕНЬ, -1), ) КАК ПоказанияПриборовУчетаСрезПоследних
	               |		ГДЕ
	               |			ПоказанияПриборовУчетаСрезПоследних.Период < КОНЕЦПЕРИОДА(&МесяцНачисления, МЕСЯЦ)
	               |		
	               |		СГРУППИРОВАТЬ ПО
	               |			ПоказанияПриборовУчетаСрезПоследних.ПриборУчета,
	               |			ПоказанияПриборовУчетаСрезПоследних.ВидТарифа) КАК ПоказанияПрибораУчета
	               |		ПО УстановленныеПриборыУчетаСрезПоследних.ПриборУчета = ПоказанияПрибораУчета.ПриборУчета
	               |ГДЕ
	               |	УстановленныеПриборыУчетаСрезПоследних.Действует = ИСТИНА
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	УстановленныеПриборыУчетаСрезПоследних.ОбъектУстановки,
	               |	УстановленныеПриборыУчетаСрезПоследних.ПриборУчета,
	               |	ПоказанияПрибораУчета.ПриборУчета.Коэффициент,
	               |	ПоказанияПрибораУчета.ПриборУчета.Услуга,
	               |	ПоказанияПрибораУчета.ПриборУчета.ЕдиницаИзмерения
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ЗаменыПриборовУчета.ОбъектУстановки,
	               |	ЗаменыПриборовУчета.ПриборУчета,
	               |	ЗаменыПриборовУчета.Показание,
	               |	ЗаменыПриборовУчета.ПоказаниеПредыдущее,
	               |	ЗаменыПриборовУчета.ПриборУчета.Коэффициент,
	               |	0,
	               |	ЗаменыПриборовУчета.Услуга,
	               |	ЗаменыПриборовУчета.ПриборУчета.ЕдиницаИзмерения
	               |ИЗ
	               |	РегистрНакопления.ЗаменыПриборовУчета КАК ЗаменыПриборовУчета
	               |ГДЕ
	               |	ЗаменыПриборовУчета.Период МЕЖДУ НАЧАЛОПЕРИОДА(&МесяцНачисления, МЕСЯЦ) И КОНЕЦПЕРИОДА(&МесяцНачисления, МЕСЯЦ)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Услуга УБЫВ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	РасчетыПоЛицевымСчетам.ЛицевойСчет.Владелец КАК Здание,
	               |	РасчетыПоЛицевымСчетам.ЛицевойСчет КАК ЛицевойСчет,
	               |	РасчетыПоЛицевымСчетам.Услуга КАК Услуга,
	               |	РасчетыПоЛицевымСчетам.Услуга.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	               |	РасчетыПоЛицевымСчетам.Тариф КАК Тариф,
	               |	РасчетыПоЛицевымСчетам.ДнейНачислено КАК ДнейНачислено,
	               |	СУММА(ЕСТЬNULL(ВЫБОР
	               |				КОГДА РасчетыПоЛицевымСчетам.ВидНачисления = ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Начисление)
	               |					ТОГДА РасчетыПоЛицевымСчетам.Количество
	               |			КОНЕЦ, 0)) КАК КоличествоЕдИзм,
	               |	СУММА(ВЫБОР
	               |			КОГДА РасчетыПоЛицевымСчетам.ВидНачисления = ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Начисление)
	               |				ТОГДА РасчетыПоЛицевымСчетам.Сумма
	               |			ИНАЧЕ 0
	               |		КОНЕЦ) КАК Начисление,
	               |	СУММА(ВЫБОР
	               |			КОГДА РасчетыПоЛицевымСчетам.ВидНачисления = ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Субсидия)
	               |				ТОГДА РасчетыПоЛицевымСчетам.Сумма
	               |			ИНАЧЕ 0
	               |		КОНЕЦ) КАК Субсидия,
	               |	СУММА(ВЫБОР
	               |			КОГДА РасчетыПоЛицевымСчетам.ВидНачисления = ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Льгота)
	               |				ТОГДА РасчетыПоЛицевымСчетам.Сумма
	               |			ИНАЧЕ 0
	               |		КОНЕЦ) КАК Льгота,
	               |	СУММА(ВЫБОР
	               |			КОГДА РасчетыПоЛицевымСчетам.ВидНачисления = ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Перерасчет)
	               |				ТОГДА РасчетыПоЛицевымСчетам.Сумма
	               |			ИНАЧЕ 0
	               |		КОНЕЦ) КАК Перерасчет,
	               |	СУММА(ВЫБОР
	               |			КОГДА РасчетыПоЛицевымСчетам.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	               |					И ТИПЗНАЧЕНИЯ(РасчетыПоЛицевымСчетам.Регистратор) <> ТИП(Документ.ДоговорРеструктуризацииДолга)
	               |				ТОГДА РасчетыПоЛицевымСчетам.Сумма
	               |			ИНАЧЕ 0
	               |		КОНЕЦ) КАК Оплата,
	               |	СУММА(ВЫБОР
	               |			КОГДА НЕ РасчетыПоЛицевымСчетам.ВидНачисления = ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Начисление)
	               |					И НЕ РасчетыПоЛицевымСчетам.ВидНачисления = ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Льгота)
	               |					И НЕ РасчетыПоЛицевымСчетам.ВидНачисления = ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Субсидия)
	               |					И НЕ РасчетыПоЛицевымСчетам.ВидНачисления = ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Перерасчет)
	               |					И РасчетыПоЛицевымСчетам.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	               |					И ТИПЗНАЧЕНИЯ(РасчетыПоЛицевымСчетам.Регистратор) <> ТИП(Документ.ДоговорРеструктуризацииДолга)
	               |				ТОГДА РасчетыПоЛицевымСчетам.Сумма
	               |			ИНАЧЕ 0
	               |		КОНЕЦ) КАК Корректировка,
	               |	РасчетыПоЛицевымСчетам.ЛицевойСчет.ОбъектЛицевогоСчета КАК Квартира,
	               |	ЕСТЬNULL(РасчетыПоЛицевымСчетам.Порог, """") КАК Порог
	               |ИЗ
	               |	РегистрНакопления.РасчетыПоЛицевымСчетам КАК РасчетыПоЛицевымСчетам
	               |ГДЕ
	               |	РасчетыПоЛицевымСчетам.ЛицевойСчет В(&ЛицевыеСчета)
	               |	И РасчетыПоЛицевымСчетам.Период МЕЖДУ НАЧАЛОПЕРИОДА(&МесяцНачисления, МЕСЯЦ) И КОНЕЦПЕРИОДА(&МесяцНачисления, МЕСЯЦ)
	               |	И РасчетыПоЛицевымСчетам.Услуга <> ЗНАЧЕНИЕ(Справочник.Услуги.РеструктуризацияДолга)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	РасчетыПоЛицевымСчетам.ЛицевойСчет,
	               |	РасчетыПоЛицевымСчетам.Услуга,
	               |	РасчетыПоЛицевымСчетам.ЛицевойСчет.Владелец,
	               |	РасчетыПоЛицевымСчетам.Услуга.ЕдиницаИзмерения,
	               |	РасчетыПоЛицевымСчетам.Тариф,
	               |	РасчетыПоЛицевымСчетам.ДнейНачислено,
	               |	РасчетыПоЛицевымСчетам.ЛицевойСчет.ОбъектЛицевогоСчета,
	               |	ЕСТЬNULL(РасчетыПоЛицевымСчетам.Порог, """")
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Услуга УБЫВ
	               |ИТОГИ
	               |	СУММА(КоличествоЕдИзм),
	               |	СУММА(Начисление),
	               |	СУММА(Субсидия),
	               |	СУММА(Льгота),
	               |	СУММА(Перерасчет),
	               |	СУММА(Оплата),
	               |	СУММА(Корректировка)
	               |ПО
	               |	ЛицевойСчет,
	               |	Услуга
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ПланированиеАвансовЛицевыеСчета.ЛицевойСчет,
	               |	ПланированиеАвансовЛицевыеСчета.СуммаНачислено КАК СуммаАванса,
	               |	ПланированиеАвансовЛицевыеСчета.Ссылка.Услуга
	               |ИЗ
	               |	Документ.ПланированиеАвансов.ЛицевыеСчета КАК ПланированиеАвансовЛицевыеСчета
	               |ГДЕ
	               |	НАЧАЛОПЕРИОДА(ПланированиеАвансовЛицевыеСчета.Ссылка.Дата, МЕСЯЦ) = НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(&МесяцНачисления, МЕСЯЦ, 1), МЕСЯЦ)
	               |	И ПланированиеАвансовЛицевыеСчета.ЛицевойСчет В(&ЛицевыеСчета)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ПлатежиПоРеструктуризацииДолга.ЛицевойСчет КАК ЛицевойСчет,
	               |	ПлатежиПоРеструктуризацииДолга.СуммаПлатежа КАК СуммаПлатежа,
	               |	ПлатежиПоРеструктуризацииДолга.ОбщаяСумма КАК ОбщаяСумма,
	               |	ПлатежиПоРеструктуризацииДолга.Регистратор КАК ДокументРеструктуризации,
	               |	ЕСТЬNULL(РасчетыПоЛицевымСчетамОстаткиИОбороты.СуммаРасход, 0) КАК Оплаты,
	               |	ПлатежиПоРеструктуризацииДолга.ОбщаяСумма - ЕСТЬNULL(РасчетыПоЛицевымСчетамОстаткиИОбороты.СуммаРасход, 0) КАК ОстатокРеструктуризации
	               |ИЗ
	               |	РегистрСведений.ПлатежиПоРеструктуризацииДолга КАК ПлатежиПоРеструктуризацииДолга
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.РасчетыПоЛицевымСчетам.ОстаткиИОбороты(, КОНЕЦПЕРИОДА(&МесяцНачисления, МЕСЯЦ), , , Услуга = ЗНАЧЕНИЕ(Справочник.Услуги.РеструктуризацияДолга)) КАК РасчетыПоЛицевымСчетамОстаткиИОбороты
	               |		ПО ПлатежиПоРеструктуризацииДолга.ЛицевойСчет = РасчетыПоЛицевымСчетамОстаткиИОбороты.ЛицевойСчет
	               |ГДЕ
	               |	ПлатежиПоРеструктуризацииДолга.Период >= КОНЕЦПЕРИОДА(&МесяцНачисления, МЕСЯЦ)
	               |	И ПлатежиПоРеструктуризацииДолга.ЛицевойСчет В(&ЛицевыеСчета)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	РасчетыПоЛицевымСчетамОстатки.ЛицевойСчет КАК ЛицевойСчет,
	               |	РасчетыПоЛицевымСчетамОстатки.Услуга КАК Услуга,
	               |	РасчетыПоЛицевымСчетамОстатки.СуммаОстаток КАК СуммаОстаток
	               |ИЗ
	               |	РегистрНакопления.РасчетыПоЛицевымСчетам.Остатки(НАЧАЛОПЕРИОДА(&МесяцНачисления, МЕСЯЦ), ЛицевойСчет В (&ЛицевыеСчета)) КАК РасчетыПоЛицевымСчетамОстатки
	               |ГДЕ
	               |	РасчетыПоЛицевымСчетамОстатки.Услуга <> ЗНАЧЕНИЕ(Справочник.Услуги.РеструктуризацияДолга)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	РасчетыПоЛицевымСчетамОстатки.ЛицевойСчет,
	               |	РасчетыПоЛицевымСчетамОстатки.Услуга,
	               |	РасчетыПоЛицевымСчетамОстатки.СуммаОстаток
	               |ИТОГИ
	               |	СУММА(СуммаОстаток)
	               |ПО
	               |	ЛицевойСчет
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ДоговорРеструктуризацииДолга.Ссылка
	               |ИЗ
	               |	Документ.ДоговорРеструктуризацииДолга КАК ДоговорРеструктуризацииДолга
	               |ГДЕ
	               |	ДоговорРеструктуризацииДолга.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&МесяцНачисления, МЕСЯЦ) И КОНЕЦПЕРИОДА(&МесяцНачисления, МЕСЯЦ)
	               |	И ДоговорРеструктуризацииДолга.Проведен = ИСТИНА";
	
	Запрос.УстановитьПараметр("ЛицевыеСчета", ЛицевыеСчета);
	Запрос.УстановитьПараметр("МесяцНачисления", МесяцНачисления);
	
	Результат = Запрос.ВыполнитьПакет();
	
	Возврат Результат;
	
КонецФункции

Функция ПечатьАктСверки(ТабличныйДокумент, ПараметрыПечати, ТекущийДокумент)

	Макет = ПолучитьМакет("ПФ_MXL_МакетАктСверки");

	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НачалоПериода", ПараметрыПечати.ДатаНачала);
	Запрос.УстановитьПараметр("ОкончаниеПериода", Новый Граница(ПараметрыПечати.ДатаОкончания,ВидГраницы.Включая));
	Запрос.УстановитьПараметр("КонецПериода", ПараметрыПечати.ДатаОкончания);

	Запрос.УстановитьПараметр("ЛицевойСчет",ТекущийДокумент);
	
	Запрос.Текст =  "ВЫБРАТЬ
	                |	СУММА(ЕСТЬNULL(РасчетыПоЛицевымСчетамОстатки.СуммаОстаток, 0)) КАК СуммаОстаток,
	                |	РасчетыПоЛицевымСчетамОстатки.ЛицевойСчет КАК ЛицевойСчет
	                |ИЗ
	                |	РегистрНакопления.РасчетыПоЛицевымСчетам.Остатки(НАЧАЛОПЕРИОДА(&НачалоПериода, ДЕНЬ), ЛицевойСчет = &ЛицевойСчет) КАК РасчетыПоЛицевымСчетамОстатки
	                |
	                |СГРУППИРОВАТЬ ПО
	                |	РасчетыПоЛицевымСчетамОстатки.ЛицевойСчет
	                |;
	                |
	                |////////////////////////////////////////////////////////////////////////////////
	                |ВЫБРАТЬ
	                |	СУММА(ВЫБОР
	                |			КОГДА ТИПЗНАЧЕНИЯ(РасчетыПоЛицевымСчетамОбороты.Регистратор) <> ТИП(Документ.КорректировкаНачислений)
	                |				ТОГДА ВЫБОР
	                |						КОГДА ЕСТЬNULL(РасчетыПоЛицевымСчетамОбороты.СуммаПриход, 0) > 0
	                |							ТОГДА ЕСТЬNULL(РасчетыПоЛицевымСчетамОбороты.СуммаПриход, 0)
	                |						КОГДА РасчетыПоЛицевымСчетамОбороты.Услуга = ЗНАЧЕНИЕ(Справочник.Услуги.ПениШтрафы)
	                |							ТОГДА ЕСТЬNULL(РасчетыПоЛицевымСчетамОбороты.СуммаПриход, 0)
	                |						ИНАЧЕ 0
	                |					КОНЕЦ
	                |			ИНАЧЕ ЕСТЬNULL(РасчетыПоЛицевымСчетамОбороты.СуммаПриход, 0)
	                |		КОНЕЦ) КАК СуммаПриход,
	                |	СУММА(ВЫБОР
	                |			КОГДА ТИПЗНАЧЕНИЯ(РасчетыПоЛицевымСчетамОбороты.Регистратор) <> ТИП(Документ.КорректировкаНачислений)
	                |				ТОГДА ВЫБОР
	                |						КОГДА ЕСТЬNULL(РасчетыПоЛицевымСчетамОбороты.СуммаПриход, 0) < 0
	                |								И РасчетыПоЛицевымСчетамОбороты.Услуга <> ЗНАЧЕНИЕ(Справочник.Услуги.ПениШтрафы)
	                |							ТОГДА -ЕСТЬNULL(РасчетыПоЛицевымСчетамОбороты.СуммаПриход, 0)
	                |						ИНАЧЕ ЕСТЬNULL(РасчетыПоЛицевымСчетамОбороты.СуммаРасход, 0)
	                |					КОНЕЦ
	                |			ИНАЧЕ 0
	                |		КОНЕЦ) КАК СуммаРасход,
	                |	РасчетыПоЛицевымСчетамОбороты.ЛицевойСчет КАК ЛицевойСчет,
	                |	ВЫБОР
	                |		КОГДА РасчетыПоЛицевымСчетамОбороты.Услуга = ЗНАЧЕНИЕ(Справочник.Услуги.ПустаяСсылка)
	                |				ИЛИ ТИПЗНАЧЕНИЯ(РасчетыПоЛицевымСчетамОбороты.Регистратор) = ТИП(Документ.ЗакрытиеМесяца)
	                |			ТОГДА ""Аванс""
	                |		ИНАЧЕ РасчетыПоЛицевымСчетамОбороты.Услуга
	                |	КОНЕЦ КАК УслугаИтого
	                |ИЗ
	                |	РегистрНакопления.РасчетыПоЛицевымСчетам.Обороты(&НачалоПериода, &ОкончаниеПериода, Регистратор, ЛицевойСчет = &ЛицевойСчет) КАК РасчетыПоЛицевымСчетамОбороты
	                |ГДЕ
	                |	ТИПЗНАЧЕНИЯ(РасчетыПоЛицевымСчетамОбороты.Регистратор) <> ТИП(Документ.КорректировкаРегистров)
	                |
	                |СГРУППИРОВАТЬ ПО
	                |	РасчетыПоЛицевымСчетамОбороты.ЛицевойСчет,
	                |	ВЫБОР
	                |		КОГДА РасчетыПоЛицевымСчетамОбороты.Услуга = ЗНАЧЕНИЕ(Справочник.Услуги.ПустаяСсылка)
	                |				ИЛИ ТИПЗНАЧЕНИЯ(РасчетыПоЛицевымСчетамОбороты.Регистратор) = ТИП(Документ.ЗакрытиеМесяца)
	                |			ТОГДА ""Аванс""
	                |		ИНАЧЕ РасчетыПоЛицевымСчетамОбороты.Услуга
	                |	КОНЕЦ
	                |ИТОГИ
	                |	СУММА(СуммаПриход),
	                |	СУММА(СуммаРасход)
	                |ПО
	                |	ЛицевойСчет,
	                |	УслугаИтого
	                |;
	                |
	                |////////////////////////////////////////////////////////////////////////////////
	                |ВЫБРАТЬ
	                |	РасчетыПоЛицевымСчетамОстатки.ЛицевойСчет КАК ЛицевойСчет,
	                |	СУММА(РасчетыПоЛицевымСчетамОстатки.СуммаОстаток) КАК СуммаОстаток
	                |ИЗ
	                |	РегистрНакопления.РасчетыПоЛицевымСчетам.Остатки(&ОкончаниеПериода, ЛицевойСчет = &ЛицевойСчет) КАК РасчетыПоЛицевымСчетамОстатки
	                |
	                |СГРУППИРОВАТЬ ПО
	                |	РасчетыПоЛицевымСчетамОстатки.ЛицевойСчет
	                |;
	                |
	                |////////////////////////////////////////////////////////////////////////////////
	                |ВЫБРАТЬ
	                |	ЛицевыеСчета.Наименование КАК ЛицевойСчет,
	                |	ЛицевыеСчета.Владелец КАК Здание,
	                |	ЛицевыеСчета.Владелец.Организация КАК Организация,
	                |	ЕСТЬNULL(ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ОтветственныйВладелец, ""Невизначений"") КАК ОтветСтвенныйВладелец,
	                |	ЛицевыеСчета.ОбъектЛицевогоСчета.Наименование КАК Квартира
	                |ИЗ
	                |	Справочник.ЛицевыеСчета КАК ЛицевыеСчета
	                |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОтветственныйВладелецЛицевогоСчета.СрезПоследних(&ОкончаниеПериода, ЛицевойСчет = &ЛицевойСчет) КАК ОтветственныйВладелецЛицевогоСчетаСрезПоследних
	                |		ПО ЛицевыеСчета.Ссылка = ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ЛицевойСчет
	                |ГДЕ
	                |	ЛицевыеСчета.Ссылка = &ЛицевойСчет
	                |
	                |СГРУППИРОВАТЬ ПО
	                |	ЕСТЬNULL(ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ОтветственныйВладелец, ""Невизначений""),
	                |	ЛицевыеСчета.Наименование,
	                |	ЛицевыеСчета.Владелец,
	                |	ЛицевыеСчета.Владелец.Организация,
	                |	ЛицевыеСчета.ОбъектЛицевогоСчета.Наименование
	                |;
	                |
	                |////////////////////////////////////////////////////////////////////////////////
	                |ВЫБРАТЬ
	                |	ВЫБОР
	                |		КОГДА ТИПЗНАЧЕНИЯ(РасчетыПоЛицевымСчетам.Регистратор) = ТИП(Документ.КорректировкаНачислений)
	                |				И РасчетыПоЛицевымСчетам.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	                |			ТОГДА ЗНАЧЕНИЕ(Справочник.Услуги.ПустаяСсылка)
	                |		КОГДА (ТИПЗНАЧЕНИЯ(РасчетыПоЛицевымСчетам.Регистратор) = ТИП(Документ.ПоступлениеНаСчет)
	                |				ИЛИ РасчетыПоЛицевымСчетам.Услуга = ЗНАЧЕНИЕ(Справочник.Услуги.ПустаяСсылка))
	                |				И ТИПЗНАЧЕНИЯ(РасчетыПоЛицевымСчетам.Регистратор) <> ТИП(Документ.КорректировкаНачислений)
	                |			ТОГДА РасчетыПоЛицевымСчетам.Период
	                |		ИНАЧЕ РасчетыПоЛицевымСчетам.Услуга
	                |	КОНЕЦ КАК Услуга,
	                |	НАЧАЛОПЕРИОДА(РасчетыПоЛицевымСчетам.Период, МЕСЯЦ) КАК МесяцНачисления,
	                |	РасчетыПоЛицевымСчетам.ЛицевойСчет КАК ЛицевойСчет,
	                |	ВЫБОР
	                |		КОГДА ТИПЗНАЧЕНИЯ(РасчетыПоЛицевымСчетам.Регистратор) = ТИП(Документ.КорректировкаНачислений)
	                |				И РасчетыПоЛицевымСчетам.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	                |			ТОГДА ЗНАЧЕНИЕ(Справочник.Услуги.ПустаяСсылка)
	                |		ИНАЧЕ РасчетыПоЛицевымСчетам.Услуга
	                |	КОНЕЦ КАК УслугаИгого,
	                |	СУММА(ВЫБОР
	                |			КОГДА РасчетыПоЛицевымСчетам.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	                |				ТОГДА РасчетыПоЛицевымСчетам.Сумма
	                |			ИНАЧЕ 0
	                |		КОНЕЦ) КАК СуммаПриход,
	                |	СУММА(ВЫБОР
	                |			КОГДА РасчетыПоЛицевымСчетам.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	                |				ТОГДА РасчетыПоЛицевымСчетам.Сумма
	                |			ИНАЧЕ 0
	                |		КОНЕЦ) КАК СуммаРасход,
	                |	ВЫБОР
	                |		КОГДА ТИПЗНАЧЕНИЯ(РасчетыПоЛицевымСчетам.Регистратор) = ТИП(Документ.КорректировкаНачислений)
	                |				И РасчетыПоЛицевымСчетам.ВидНачисления <> ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Льгота)
	                |				И РасчетыПоЛицевымСчетам.ВидНачисления <> ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Субсидия)
	                |			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Корректировка)
	                |		ИНАЧЕ РасчетыПоЛицевымСчетам.ВидНачисления
	                |	КОНЕЦ КАК ВидНачисления,
	                |	РасчетыПоЛицевымСчетам.Количество
	                |ИЗ
	                |	РегистрНакопления.РасчетыПоЛицевымСчетам КАК РасчетыПоЛицевымСчетам
	                |ГДЕ
	                |	РасчетыПоЛицевымСчетам.Период МЕЖДУ &НачалоПериода И &КонецПериода
	                |	И РасчетыПоЛицевымСчетам.ЛицевойСчет = &ЛицевойСчет
	                |	И ТИПЗНАЧЕНИЯ(РасчетыПоЛицевымСчетам.Регистратор) <> ТИП(Документ.ЗакрытиеМесяца)
	                |	И ТИПЗНАЧЕНИЯ(РасчетыПоЛицевымСчетам.Регистратор) <> ТИП(Документ.КорректировкаРегистров)
	                |
	                |СГРУППИРОВАТЬ ПО
	                |	НАЧАЛОПЕРИОДА(РасчетыПоЛицевымСчетам.Период, МЕСЯЦ),
	                |	РасчетыПоЛицевымСчетам.ЛицевойСчет,
	                |	ВЫБОР
	                |		КОГДА ТИПЗНАЧЕНИЯ(РасчетыПоЛицевымСчетам.Регистратор) = ТИП(Документ.КорректировкаНачислений)
	                |				И РасчетыПоЛицевымСчетам.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	                |			ТОГДА ЗНАЧЕНИЕ(Справочник.Услуги.ПустаяСсылка)
	                |		КОГДА (ТИПЗНАЧЕНИЯ(РасчетыПоЛицевымСчетам.Регистратор) = ТИП(Документ.ПоступлениеНаСчет)
	                |				ИЛИ РасчетыПоЛицевымСчетам.Услуга = ЗНАЧЕНИЕ(Справочник.Услуги.ПустаяСсылка))
	                |				И ТИПЗНАЧЕНИЯ(РасчетыПоЛицевымСчетам.Регистратор) <> ТИП(Документ.КорректировкаНачислений)
	                |			ТОГДА РасчетыПоЛицевымСчетам.Период
	                |		ИНАЧЕ РасчетыПоЛицевымСчетам.Услуга
	                |	КОНЕЦ,
	                |	ВЫБОР
	                |		КОГДА ТИПЗНАЧЕНИЯ(РасчетыПоЛицевымСчетам.Регистратор) = ТИП(Документ.КорректировкаНачислений)
	                |				И РасчетыПоЛицевымСчетам.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	                |			ТОГДА ЗНАЧЕНИЕ(Справочник.Услуги.ПустаяСсылка)
	                |		ИНАЧЕ РасчетыПоЛицевымСчетам.Услуга
	                |	КОНЕЦ,
	                |	ВЫБОР
	                |		КОГДА ТИПЗНАЧЕНИЯ(РасчетыПоЛицевымСчетам.Регистратор) = ТИП(Документ.КорректировкаНачислений)
	                |				И РасчетыПоЛицевымСчетам.ВидНачисления <> ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Льгота)
	                |				И РасчетыПоЛицевымСчетам.ВидНачисления <> ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Субсидия)
	                |			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Корректировка)
	                |		ИНАЧЕ РасчетыПоЛицевымСчетам.ВидНачисления
	                |	КОНЕЦ,
	                |	РасчетыПоЛицевымСчетам.Количество
	                |
	                |УПОРЯДОЧИТЬ ПО
	                |	МесяцНачисления,
	                |	ВидНачисления,
	                |	Услуга
	                |ИТОГИ ПО
	                |	МесяцНачисления";
	Результат = Запрос.ВыполнитьПакет();
	
	ДанныеШапки = Результат[3].выбрать();
	ДанныеНачало = Результат[0].выбрать();
	ДанныеОкончание = Результат[2].выбрать();
	ДанныеПериод = Результат[1].выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ДанныеПериодМесяц = Результат[4].выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	//ШАПКА
	Шапка = Макет.ПолучитьОбласть("Шапка");
	
	ПериодНачало =  ФОРМАТ(ПараметрыПечати.ДатаНачала,"Л=uk_UA; ДФ='dd.MM.yyyy'");
	ПериодОкончание =  ФОРМАТ(ПараметрыПечати.ДатаОкончания,"Л=uk_UA; ДФ='dd.MM.yyyy'");
	ПериодОкончание2 =  ФОРМАТ(ПараметрыПечати.ДатаОкончания,"Л=uk_UA; ДФ='dd MMMM yyyy'");

	
	ДанныеШапки.Следующий();
	ДанныеНачало.Следующий();
	Организация = ДанныеШапки.Организация;
	МассивДляФио = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ДанныеШапки.ОтветСтвенныйВладелец," ");
	Если МассивДляФио.количество() = 3 И не ДанныеШапки.ОтветСтвенныйВладелец.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицо Тогда
		Фио = МассивДляФио[0]+" "+Лев(МассивДляФио[1],1)+"."+Лев(МассивДляФио[2],1)+".";
	Иначе	
		ФИО =  Строка(ДанныеШапки.ОтветСтвенныйВладелец);
	КонецЕсли;
	
	ПердставлениеЛС = ФИО +" (" + ДанныеШапки.Квартира +" о\р " +ДанныеШапки.ЛицевойСчет+")";
	
	Шапка.Параметры.Организация = Организация;
	Шапка.Параметры.ФИО = ФИО;

	Шапка.Параметры.ПердставлениеЛС = ПердставлениеЛС;
	Шапка.Параметры.МестоСоставвления = УправлениеКонтактнойИнформацией.ПолучитьКонтактнуюИнформацияОбъекта(Организация,Справочники.ВидыКонтактнойИнформации.ФактАдресОрганизации);
	Шапка.Параметры.ПериодНачало = ПериодНачало;
	Шапка.Параметры.ПериодОкончание = ПериодОкончание;
	Шапка.Параметры.ПериодОкончание2 = ПериодОкончание2;
	Попытка
		Если   ДанныеНачало.СуммаОстаток < 0 Тогда
			Шапка.Параметры.Оплачено =- ДанныеНачало.СуммаОстаток;
		Иначе
			Шапка.Параметры.Начислено = ДанныеНачало.СуммаОстаток;
		КонецЕсли;
	Исключение
	КонецПопытки;
	ТабличныйДокумент.Вывести(Шапка);
	
	
	//Строки
	
	Пока ДанныеПериод.Следующий() Цикл
		ОблатьИтогоПоЛС = Макет.ПолучитьОбласть("СтрокаЛС");
		ОблатьИтогоПоЛС.Параметры.Услуга = "Обсяг за період в т.ч.";
		Попытка
			ОблатьИтогоПоЛС.Параметры.Начислено = ДанныеПериод.СуммаПриход;
		Исключение
			ОблатьИтогоПоЛС.Параметры.Начислено = ДанныеПериод.СуммаПриход;
		КонецПопытки;
		
		ОблатьИтогоПоЛС.Параметры.Оплачено = ДанныеПериод.СуммаРасход;
		
		ДанныеПериодУслугаИтого  =  ДанныеПериод.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		МассивОбластейИтогоУслуга = Новый Массив;
		
		Пока ДанныеПериодУслугаИтого.Следующий() Цикл
		
			ОбластьПериодУслугаИтого = Макет.ПолучитьОбласть("Строка");
			Если ТипЗнч(ДанныеПериодУслугаИтого.УслугаИтого) = Тип("Строка") Тогда
			    ОбластьПериодУслугаИтого.Параметры.Услуга = ДанныеПериодУслугаИтого.УслугаИтого;
			Иначе
				ОбластьПериодУслугаИтого.Параметры.Услуга = ДанныеПериодУслугаИтого.УслугаИтого.ПолноеНаименование;
			КонецЕсли;
			ОбластьПериодУслугаИтого.Параметры.Начислено = ДанныеПериодУслугаИтого.СуммаПриход;
			ОбластьПериодУслугаИтого.Параметры.Оплачено = ДанныеПериодУслугаИтого.СуммаРасход;
			//ОбластьПериодУслугаИтого.Параметры.Кво      = ДанныеПериодУслугаИтого.Количество;
			//Если  ДанныеПериодУслугаИтого.УслугаИтого = "Аванс" Тогда
			//	//Ничего 
			//	Продолжить;
			//Иначе
				Если  ДанныеПериодУслугаИтого.СуммаПриход = 0 и ДанныеПериодУслугаИтого.СуммаРасход = 0 Тогда
					Продолжить;
				Иначе	
					МассивОбластейИтогоУслуга.Добавить(ОбластьПериодУслугаИтого);
				КонецЕсли;
				
			//КонецЕсли;
			
			
		
		КонецЦикла; 
		
		
	КонецЦикла;
	
	Пока ДанныеПериодМесяц.Следующий() Цикл
		
		ОбластьМесяц = Макет.ПолучитьОбласть("СтрокаИтог");
		ОбластьМесяц.Параметры.Услуга = "Всьго за "+Формат(ДанныеПериодМесяц.МесяцНачисления,"Л=uk_UA; ДФ='MMMM yyyy'");
		ОбластьМесяц.Параметры.Начислено = ДанныеПериодМесяц.СуммаПриход;
		ОбластьМесяц.Параметры.Оплачено = ДанныеПериодМесяц.СуммаРасход;
		Детали = ДанныеПериодМесяц.Выбрать();
		Пока Детали.Следующий() Цикл
			Префикс = "";
			ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
			Если ТипЗнч(Детали.Услуга) = Тип("Дата") Тогда
				ОбластьСтрока.Параметры.Услуга = "Оплата "+ Строка(Формат(Детали.Услуга,"Л=uk_UA; ДФ='dd.MM.yyyy'"));
			Иначе
				
				Если Детали.ВидНачисления = Перечисления.ВидыНачислений.Льгота Тогда
					Префикс = " (Пiльга)";
				ИначеЕсли Детали.ВидНачисления = Перечисления.ВидыНачислений.Субсидия ТОгда
					Префикс = " (Субсидiя)";
				ИначеЕсли Детали.ВидНачисления = Перечисления.ВидыНачислений.Корректировка ТОгда
					Префикс = " (Коригування)";	
				КонецЕсли;
				
				ОбластьСтрока.Параметры.Услуга = Строка(Детали.Услуга.ПолноеНаименование)+Префикс;
			КонецЕсли;
			ОбластьСтрока.Параметры.Кво = Детали.Количество;
			ОбластьСтрока.Параметры.Начислено = Детали.СуммаПриход;
			ОбластьСтрока.Параметры.Оплачено = Детали.СуммаРасход;
			Если  Детали.СуммаПриход =0 и Детали.СуммаРасход = 0 Тогда
				Продолжить;
			Иначе
				ТабличныйДокумент.Вывести(ОбластьСтрока);
			КонецЕсли;	
		КонецЦикла;
		ТабличныйДокумент.Вывести(ОбластьМесяц);
	КонецЦикла;
	Попытка
		ТабличныйДокумент.Вывести(ОблатьИтогоПоЛС);
	Исключение
	КонецПопытки;
	
	
	Инд = 0;
	Если МассивОбластейИтогоУслуга <> Неопределено Тогда
		Пока Инд<= МассивОбластейИтогоУслуга.ВГраница() Цикл
			
			ТабличныйДокумент.Вывести(МассивОбластейИтогоУслуга[Инд]);
			Инд = Инд+1;
		КонецЦикла;
	КонецЕсли;	
	
	
	ДанныеОкончание.Следующий();
	ОбластьСальдо = Макет.ПолучитьОбласть("СтрокаИтог");
	ОбластьСальдо.Параметры.Услуга = "Сальдо на "+ ПериодОкончание;
	ОбластьСальдо.Параметры.Услуга2 = "Сальдо на "+ ПериодОкончание;
	Попытка
		Если ДанныеОкончание.СуммаОстаток < 0 Тогда
			
			ОбластьСальдо.Параметры.Оплачено	 = -ДанныеОкончание.СуммаОстаток;	
		Иначе   
			ОбластьСальдо.Параметры.Начислено = ДанныеОкончание.СуммаОстаток;
			
		КонецЕсли;
	Исключение
	КонецПопытки;
	ТабличныйДокумент.Вывести(ОбластьСальдо);
	
	
	Подвал = Макет.ПолучитьОбласть("Подвал");
	Подвал.Параметры.Организация = Организация;
	Подвал.Параметры.ФИО = Фио;
	ТабличныйДокумент.Вывести(Подвал);
	
	Возврат ТабличныйДокумент;
	
	
КонецФункции


Функция ПечатьПеня(ТабличныйДокумент, ПараметрыПечати, ТекущийДокумент)

	Макет = ПолучитьМакет("ПФ_MXL_МакетПеня");

	
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьШапка.Параметры.ЛицевойСчет = ТекущийДокумент;
	ОбластьШапка.Параметры.Адрес = Строка(ТекущийДокумент.Владелец)+", "+ТекущийДокумент.ОбъектЛицевогоСчета.Наименование;
	
	ТабличныйДокумент.Вывести(ОбластьШапка);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НачалоПериода", ПараметрыПечати.ДатаНачала);
	//Запрос.УстановитьПараметр("ОкончаниеПериода", Новый Граница(ПараметрыПечати.ДатаОкончания,ВидГраницы.Включая));
	Запрос.УстановитьПараметр("КонецПериода", ПараметрыПечати.ДатаОкончания);

	Запрос.УстановитьПараметр("ЛицевойСчет",ТекущийДокумент);
	
	
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	НачислениеПениПоЛС.Ссылка КАК Ссылка,
		|	НАЧАЛОПЕРИОДА(НачислениеПениПоЛС.Дата, ДЕНЬ) КАК Дата,
		|	НачислениеПениПоЛС.Здание,
		|	НачислениеПениПоЛС.ЛицевойСчет,
		|	НачислениеПениПоЛС.Организация,
		|	НачислениеПениПоЛС.ПериодНачисления,
		|	НачислениеПениПоЛС.Сумма КАК Сумма,
		|	НачислениеПениПоЛС.Услуга,
		|	НачислениеПениПоЛС.ПериодС,
		|	НачислениеПениПоЛС.ПериодПо,
		|	НачислениеПениПоЛС.КоличествоДней,
		|	НачислениеПениПоЛС.СумаДолга,
		|	НачислениеПениПоЛС.Процент,
		|	НачислениеПениПоЛС.МесяцНачисления КАК Месяц
		|ИЗ
		|	Документ.НачислениеПениПоЛС КАК НачислениеПениПоЛС
		|ГДЕ
		|	НачислениеПениПоЛС.Проведен = ИСТИНА
		|	И НачислениеПениПоЛС.ЛицевойСчет = &ЛицевойСчет
		|	И НачислениеПениПоЛС.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата,
		|	Ссылка УБЫВ,
		|	МесяцНачисления
		|ИТОГИ
		|	СУММА(Сумма)
		|ПО
		|	Дата
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	РасчетыПоЛицевымСчетамОстаткиИОбороты.ЛицевойСчет,
		|	СУММА(РасчетыПоЛицевымСчетамОстаткиИОбороты.СуммаПриход) КАК СуммаПриход,
		|	НАЧАЛОПЕРИОДА(КОНЕЦПЕРИОДА(РасчетыПоЛицевымСчетамОстаткиИОбороты.Период, МЕСЯЦ), ДЕНЬ) КАК МЕСЯЦ
		|ИЗ
		|	РегистрНакопления.РасчетыПоЛицевымСчетам.ОстаткиИОбороты(&НачалоПериода, &КонецПериода, Регистратор, , ЛицевойСчет = &ЛицевойСчет) КАК РасчетыПоЛицевымСчетамОстаткиИОбороты
		|
		|СГРУППИРОВАТЬ ПО
		|	РасчетыПоЛицевымСчетамОстаткиИОбороты.ЛицевойСчет,
		|	НАЧАЛОПЕРИОДА(КОНЕЦПЕРИОДА(РасчетыПоЛицевымСчетамОстаткиИОбороты.Период, МЕСЯЦ), ДЕНЬ)";
	
	
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ТаблицаСверки = РезультатЗапроса[0].Выгрузить().СкопироватьКолонки();
	ТаблицаСортировки = ТаблицаСверки.СкопироватьКолонки();
	
	ВыборкаДата = РезультатЗапроса[0].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВыборкаНачсисление = РезультатЗапроса[1].Выбрать();
	
	Пока ВыборкаДата.Следующий() Цикл
		Если ВыборкаДата.Сумма = 0 Тогда 
			Продолжить;
		КонецЕсли;
		ОбластьОсн = Макет.ПолучитьОбласть("ОСН");
		ОбластьОсн.Параметры.Месяц = Формат(ВыборкаДата.Дата,"Л=uk_UA; ДФ='MMMM'");
		ОбластьОсн.Параметры.Сумма = ВыборкаДата.Сумма;
		
		СтрукПоиск = Новый Структура;
		СтрукПоиск.Вставить("ЛицевойСчет",ТекущийДокумент);
		СтрукПоиск.Вставить("Месяц",ВыборкаДата.Дата);

		Если ВыборкаНачсисление.НайтиСледующий(СтрукПоиск) Тогда
			ОбластьОсн.Параметры.Начисление = ВыборкаНачсисление.СуммаПриход;
			ВыборкаНачсисление.сбросить();
		КонецЕсли;	
		
		ВыборкаДетальныеЗаписи = ВыборкаДата.Выбрать();
	    Первый = Истина;
		ПеняВсего = 0;
		ПеняОбласть = 0;
		Начисление = 0;
		МассивОбластей = Новый Массив;
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			Если  ВыборкаДетальныеЗаписи.Сумма < 0 Тогда
				Прервать;
			КонецЕсли;
			//ОблСтрока = Макет.ПолучитьОбласть("ОСН1");
			//Выводим = ЕстьДолгПоЭтомуМесяцу(ВыборкаДетальныеЗаписи.Месяц,ВыборкаДетальныеЗаписи.Дата,ТекущийДокумент);
			
			Если ТаблицаСверки.Количество() <> 0 Тогда
				СтруктураПоискаДубля =  Новый Структура;
				СтруктураПоискаДубля.Вставить("ПериодС",ВыборкаДетальныеЗаписи.ПериодС);
				СтруктураПоискаДубля.Вставить("ПериодПо",ВыборкаДетальныеЗаписи.ПериодПо);
				СтруктураПоискаДубля.Вставить("КоличествоДней",ВыборкаДетальныеЗаписи.КоличествоДней);
				СтруктураПоискаДубля.Вставить("СумаДолга",ВыборкаДетальныеЗаписи.СумаДолга);
				СтруктураПоискаДубля.Вставить("Месяц",ВыборкаДетальныеЗаписи.Месяц);
				СтруктураПоискаДубля.Вставить("Сумма",ВыборкаДетальныеЗаписи.Сумма);
				СтрокиТаб = ТаблицаСверки.найтиСтроки(СтруктураПоискаДубля);
				Если СтрокиТаб.Количество() <> 0 Тогда
					Продолжить;
				КонецЕсли;
				
			КонецЕсли;	
			
			//ЗаполнитьЗначенияСвойств(ОблСтрока.Параметры,ВыборкаДетальныеЗаписи);
			//ПеняВсего =ПеняВсего+ ВыборкаДетальныеЗаписи.Сумма;
			НоваяСтрока = ТаблицаСверки.Добавить();
			НаваяСтрокаТ = ТаблицаСортировки.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока,ВыборкаДетальныеЗаписи);
			ЗаполнитьЗначенияСвойств(НаваяСтрокаТ,ВыборкаДетальныеЗаписи);
			
			
			//МассивОбластей.Добавить(ОблСтрока);
			//ТабличныйДокумент.вывести(ОблСтрока);
		КонецЦикла;
		
		ТаблицаСортировки.Сортировать("Месяц Возр, ПериодС Возр");
		Для Каждого Строка  Из  ТаблицаСортировки Цикл
			ОблСтрока = Макет.ПолучитьОбласть("ОСН1");
			
			Если Первый Тогда
					
					ОблСтрока.Параметры.Пеня = ОбластьОсн.Параметры.Сумма;
					ОблСтрока.Параметры.Начисление = ОбластьОсн.Параметры.Начисление - ОбластьОсн.Параметры.Сумма;
				    Первый = Ложь;
					ОбластьОсн.Параметры.Сумма =  ТаблицаСортировки.итог("Сумма");
					ТабличныйДокумент.вывести(ОбластьОсн);
				КонецЕсли;
			ЗаполнитьЗначенияСвойств(ОблСтрока.Параметры,Строка);
			Оплаты = ЕстьОплатыПоЭтомуМесяцу(Строка.Месяц,Строка.ПериодПо,ТекущийДокумент,ВыборкаДата.Дата);
			Если ТипЗнч(Оплаты) = Тип("Структура") Тогда
				ОблСтрока.Параметры.Оплата  =  Оплаты.Оплата;
		        ОблСтрока.Параметры.ДатаОплаты = Оплаты.ДатаОплаты;
			КонецЕсли;	
			ТабличныйДокумент.вывести(ОблСтрока);
			 
		КонецЦикла;
		ТаблицаСортировки.Очистить();
		
	КонецЦикла;
	
	

	
	Возврат ТабличныйДокумент;
	
	
КонецФункции

Функция ЕстьОплатыПоЭтомуМесяцу(Месяц,Дата,ЛицевойСчет,ДатаСрез)
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РасчетыПоЛицевымСчетамОбороты.СуммаРасход,
		|	РасчетыПоЛицевымСчетамОбороты.Период
		|ИЗ
		|	РегистрНакопления.РасчетыПоЛицевымСчетам.Обороты(
		|			&МесяцНачало,
		|			&МесяцОкончание,
		|			Регистратор,
		|			ЛицевойСчет = &ЛицевойСчет
		|				И НАЧАЛОПЕРИОДА(МесяцНачисления, МЕСЯЦ) = НАЧАЛОПЕРИОДА(&Месяц, МЕСЯЦ)) КАК РасчетыПоЛицевымСчетамОбороты
		|ГДЕ
		|	ТИПЗНАЧЕНИЯ(РасчетыПоЛицевымСчетамОбороты.Регистратор) = &Регистратор
		|
		|СГРУППИРОВАТЬ ПО
		|	РасчетыПоЛицевымСчетамОбороты.Период,
		|	РасчетыПоЛицевымСчетамОбороты.СуммаРасход";
	
		Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
	Запрос.УстановитьПараметр("МесяцНачало", НачалоМесяца(ДатаСрез));
	Запрос.УстановитьПараметр("МесяцОкончание", КонецМесяца(ДатаСрез));
	Запрос.УстановитьПараметр("Месяц", Месяц);
	Запрос.УстановитьПараметр("Регистратор", Тип("ДокументСсылка.ПоступлениеНаСчет"));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат ЛОЖЬ;
	Иначе
		Выборка  = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			Если КонецДня(Выборка.Период) = КонецДня(Дата) 
				Или  КонецДня(КонецДня(Дата) + 500) = КонецДня(Выборка.Период) Тогда
				СтрукВозвр = Новый Структура;
				СтрукВозвр.Вставить("ДатаОплаты", КонецДня(Выборка.Период));
				СтрукВозвр.Вставить("Оплата", Выборка.СуммаРасход);
				
				Возврат  СтрукВозвр;
			КонецЕсли;
		КонецЦикла;
		
		
		Возврат Ложь;
	КонецЕсли;	
	
КонецФункции

Функция ПолучитьСокращенноеПредставлениеФИО(ТекущийГлавныйБухгалтер)
	
	СтрокаФИО = "";
	МассивСтрок = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ТекущийГлавныйБухгалтер," ");
	Инд = 0;
	Пока Инд<= МассивСтрок.вГраница()  Цикл
		Если Инд <> 0 Тогда
			СтрокаФИО = СтрокаФИО + " "+Лев(МассивСтрок[Инд],1)+".";
		Иначе
			СтрокаФИО = СтрокаФИО +МассивСтрок[Инд];
		КонецЕсли;	
		
		Инд = Инд+1;
	КонецЦикла; 
	
	Возврат СтрокаФИО;
КонецФункции

Функция ПолучитьТаблицуДанныхЗаМесяц(МесяцНачисления,ЛицевойСчет)
	
	 Запрос = Новый Запрос;
	 Запрос.Текст = "ВЫБРАТЬ
	                |	РасчетыПоЛицевымСчетам.ЛицевойСчет.Владелец КАК Здание,
	                |	РасчетыПоЛицевымСчетам.ЛицевойСчет КАК ЛицевойСчет,
	                |	РасчетыПоЛицевымСчетам.Услуга КАК Услуга,
	                |	РасчетыПоЛицевымСчетам.Услуга.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	                |	РасчетыПоЛицевымСчетам.Тариф КАК Тариф,
	                |	РасчетыПоЛицевымСчетам.ДнейНачислено КАК ДнейНачислено,
	                |	СУММА(ЕСТЬNULL(ВЫБОР
	                |				КОГДА РасчетыПоЛицевымСчетам.ВидНачисления = ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Начисление)
	                |					ТОГДА РасчетыПоЛицевымСчетам.Количество
	                |			КОНЕЦ, 0)) КАК КоличествоЕдИзм,
	                |	СУММА(ВЫБОР
	                |			КОГДА РасчетыПоЛицевымСчетам.ВидНачисления = ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Начисление)
	                |				ТОГДА РасчетыПоЛицевымСчетам.Сумма
	                |			ИНАЧЕ 0
	                |		КОНЕЦ) КАК Начисление,
	                |	СУММА(ВЫБОР
	                |			КОГДА РасчетыПоЛицевымСчетам.ВидНачисления = ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Субсидия)
	                |				ТОГДА РасчетыПоЛицевымСчетам.Сумма
	                |			ИНАЧЕ 0
	                |		КОНЕЦ) КАК Субсидия,
	                |	СУММА(ВЫБОР
	                |			КОГДА РасчетыПоЛицевымСчетам.ВидНачисления = ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Льгота)
	                |				ТОГДА РасчетыПоЛицевымСчетам.Сумма
	                |			ИНАЧЕ 0
	                |		КОНЕЦ) КАК Льгота,
	                |	СУММА(ВЫБОР
	                |			КОГДА РасчетыПоЛицевымСчетам.ВидНачисления = ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Перерасчет)
	                |				ТОГДА РасчетыПоЛицевымСчетам.Сумма
	                |			ИНАЧЕ 0
	                |		КОНЕЦ) КАК Перерасчет,
	                |	СУММА(ВЫБОР
	                |			КОГДА РасчетыПоЛицевымСчетам.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	                |					И ТИПЗНАЧЕНИЯ(РасчетыПоЛицевымСчетам.Регистратор) <> ТИП(Документ.ДоговорРеструктуризацииДолга)
	                |				ТОГДА РасчетыПоЛицевымСчетам.Сумма
	                |			ИНАЧЕ 0
	                |		КОНЕЦ) КАК Оплата,
	                |	СУММА(ВЫБОР
	                |			КОГДА НЕ РасчетыПоЛицевымСчетам.ВидНачисления = ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Начисление)
	                |					И НЕ РасчетыПоЛицевымСчетам.ВидНачисления = ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Льгота)
	                |					И НЕ РасчетыПоЛицевымСчетам.ВидНачисления = ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Субсидия)
	                |					И НЕ РасчетыПоЛицевымСчетам.ВидНачисления = ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Перерасчет)
	                |					И РасчетыПоЛицевымСчетам.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	                |					И ТИПЗНАЧЕНИЯ(РасчетыПоЛицевымСчетам.Регистратор) <> ТИП(Документ.ДоговорРеструктуризацииДолга)
	                |				ТОГДА РасчетыПоЛицевымСчетам.Сумма
	                |			ИНАЧЕ 0
	                |		КОНЕЦ) КАК Корректировка,
	                |	РасчетыПоЛицевымСчетам.ЛицевойСчет.ОбъектЛицевогоСчета КАК Квартира,
	                |	ЕСТЬNULL(РасчетыПоЛицевымСчетам.Порог, """") КАК Порог
	                |ИЗ
	                |	РегистрНакопления.РасчетыПоЛицевымСчетам КАК РасчетыПоЛицевымСчетам
	                |ГДЕ
	                |	РасчетыПоЛицевымСчетам.ЛицевойСчет = &ЛицевойСчет
	                |	И РасчетыПоЛицевымСчетам.Период МЕЖДУ НАЧАЛОПЕРИОДА(&МесяцНачисления, МЕСЯЦ) И КОНЕЦПЕРИОДА(&МесяцНачисления, МЕСЯЦ)
	                |	И РасчетыПоЛицевымСчетам.Услуга <> ЗНАЧЕНИЕ(Справочник.Услуги.РеструктуризацияДолга)
	                |
	                |СГРУППИРОВАТЬ ПО
	                |	РасчетыПоЛицевымСчетам.ЛицевойСчет,
	                |	РасчетыПоЛицевымСчетам.Услуга,
	                |	РасчетыПоЛицевымСчетам.ЛицевойСчет.Владелец,
	                |	РасчетыПоЛицевымСчетам.Услуга.ЕдиницаИзмерения,
	                |	РасчетыПоЛицевымСчетам.Тариф,
	                |	РасчетыПоЛицевымСчетам.ДнейНачислено,
	                |	РасчетыПоЛицевымСчетам.ЛицевойСчет.ОбъектЛицевогоСчета,
	                |	ЕСТЬNULL(РасчетыПоЛицевымСчетам.Порог, """")
	                |
	                |УПОРЯДОЧИТЬ ПО
	                |	Услуга УБЫВ
	                |ИТОГИ
	                |	СУММА(КоличествоЕдИзм),
	                |	СУММА(Начисление),
	                |	СУММА(Субсидия),
	                |	СУММА(Льгота),
	                |	СУММА(Перерасчет),
	                |	СУММА(Оплата),
	                |	СУММА(Корректировка)
	                |ПО
	                |	Услуга";
	 
	 Запрос.УстановитьПараметр("МесяцНачисления",МесяцНачисления);
	 Запрос.УстановитьПараметр("ЛицевойСчет",ЛицевойСчет);
	 
	 Результат = ЗАпрос.Выполнить();
	 Если Результат.Пустой() Тогда
		 Возврат Неопределено;
	 ИНаче
		 Возврат Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	 КонецЕсли;	 
	
КонецФункции
