//Процедура печати 
Процедура Печать(МассивОбъектов,
	ПараметрыПечати,
	КоллекцияПечатныхФорм,
	ОбъектыПечати,
	ПараметрыВывода) Экспорт                                                 
	
	ПараметрыВывода.ДоступнаПечатьПоКомплектно = Истина;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "МакетКарточкиПрописки") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "МакетКарточкиПрописки", "ЛицевыеСчета", ПечатнаяФорма(МассивОбъектов, ОбъектыПечати, "МакетКарточкиПрописки", ПараметрыПечати));
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "МакетСправкиПрописанных") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "МакетСправкиПрописанных", "ЛицевыеСчета", ПечатнаяФорма(МассивОбъектов, ОбъектыПечати, "МакетСправкиПрописанных", ПараметрыПечати));
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "МакетКвитанцииНаОплату") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "МакетКвитанцииНаОплату", "ЛицевыеСчета", ПечатнаяФорма(МассивОбъектов, ОбъектыПечати, "МакетКвитанцииНаОплату", ПараметрыПечати));
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "СправкаОПрописке") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "СправкаОПрописке", "ЛицевыеСчета", ПечатнаяФорма(МассивОбъектов, ОбъектыПечати, "СправкаОПрописке", ПараметрыПечати));
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "МакетКвитанцияНаОплатуУпрощенная") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "МакетКвитанцияНаОплатуУпрощенная", "ЛицевыеСчета", ПечатнаяФорма(МассивОбъектов, ОбъектыПечати, "МакетКвитанцияНаОплатуУпрощенная", ПараметрыПечати));
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "СчетНаОплату") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "СчетНаОплату", "ЛицевыеСчета", ПечатнаяФорма(МассивОбъектов, ОбъектыПечати, "СчетНаОплату", ПараметрыПечати));
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "Акт") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "Акт", "ЛицевыеСчета", ПечатнаяФорма(МассивОбъектов, ОбъектыПечати, "Акт", ПараметрыПечати));
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ОтчетПоЛС") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ОтчетПоЛС", "ЛицевыеСчета", ПечатнаяФорма(МассивОбъектов, ОбъектыПечати, "ОтчетПоЛС", ПараметрыПечати));
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПамяткаДляДоступаВЛичныйКабинетНаСайте") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ПамяткаДляДоступаВЛичныйКабинетНаСайте", "ЛицевыеСчета", ПечатнаяФорма(МассивОбъектов, ОбъектыПечати, "ПамяткаДляДоступаВЛичныйКабинетНаСайте", ПараметрыПечати));
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_СправкаОСоставеСемьиИПрописке") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ПФ_MXL_СправкаОСоставеСемьиИПрописке", "ЛицевыеСчета", ПечатнаяФорма(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_СправкаОСоставеСемьиИПрописке", ПараметрыПечати));
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_СправкаОРазмереПлатежей") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ПФ_MXL_СправкаОРазмереПлатежей", "ЛицевыеСчета", ПечатнаяФорма(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_СправкаОРазмереПлатежей", ПараметрыПечати));
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_МакетАктСверки") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ПФ_MXL_МакетАктСверки", "ЛицевыеСчета", ПечатнаяФорма(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_МакетАктСверки", ПараметрыПечати));
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_МакетПеня") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ПФ_MXL_МакетПеня", "ЛицевыеСчета", ПечатнаяФорма(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_МакетПеня", ПараметрыПечати));
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_СчетЗаказ") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ПФ_MXL_СчетЗаказ", "ЛицевыеСчета", ПечатнаяФорма(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_СчетЗаказ", ПараметрыПечати));
	КонецЕсли;

	
КонецПроцедуры

//Формирование печатных форм
Функция ПечатнаяФорма(МассивОбъектов, ОбъектыПечати, ИмяМакета, ПараметрыПечати)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.КлючПараметровПечати = "ПараметрыПечати_ЛицевыеСчета";
	
	ПервыйДокумент = Истина;
	
	Для Каждого ТекущийДокумент Из МассивОбъектов Цикл
		
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		ПервыйДокумент = Ложь;
		
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		Если ИмяМакета = "МакетКарточкиПрописки" Тогда
			
			ТабличныйДокумент = ПечатьКарточкаПрописки(ТабличныйДокумент, ПараметрыПечати, ТекущийДокумент);
			
		ИначеЕсли ИмяМакета = "МакетСправкиПрописанных" Тогда
			
			ТабличныйДокумент = ПечатьСправкаПрописанных(ТабличныйДокумент, ПараметрыПечати, ТекущийДокумент);
			
		ИначеЕсли ИмяМакета = "МакетКвитанцииНаОплату" Тогда
			//Параметры: (Лицевые счета, Табличный документ,Месяц начисления, БанковскиеСчетаОрганизации)
			ПечатьКвитанцииНаОплату.ПечатьКвитанцииНаОплату(ТекущийДокумент, ТабличныйДокумент, ПараметрыПечати.ПериодПечати, ПараметрыПечати.БанковскийСчетНаПечать);	
		ИначеЕсли ИмяМакета = "МакетКвитанцияНаОплатуУпрощенная" Тогда
			//Параметры: (Лицевые счета, Табличный документ,Месяц начисления, БанковскиеСчетаОрганизации)
			ПечатьКвитанцииНаОплату.ПечатьКвитанцииНаОплатуУпрощенная(ТекущийДокумент, ТабличныйДокумент, ПараметрыПечати.ПериодПечати, ПараметрыПечати.БанковскийСчетНаПечать);
		ИначеЕсли ИмяМакета = "СправкаОПрописке" Тогда
			
			ТабличныйДокумент = ПечатьСправкаОПрописке(ТабличныйДокумент, ПараметрыПечати, ТекущийДокумент);
			
		ИначеЕсли ИмяМакета = "Акт" Тогда
			
			ТабличныйДокумент = ПечатьАкт(ТабличныйДокумент, ПараметрыПечати, ТекущийДокумент);
			
		ИначеЕсли ИмяМакета = "СчетНаОплату" Тогда
			
			ТабличныйДокумент = ПечатьСчетНаОплату(ТабличныйДокумент, ПараметрыПечати, ТекущийДокумент);
			
		ИначеЕсли ИмяМакета = "ОтчетПоЛС" Тогда
			
			ТабличныйДокумент = ПечатьОтчетПоЛС(ТабличныйДокумент, ПараметрыПечати, ТекущийДокумент);
			
		ИначеЕсли ИмяМакета = "ПамяткаДляДоступаВЛичныйКабинетНаСайте" Тогда
			
			ТабличныйДокумент = ПечатьПамяткаДляДоступаВЛичныйКабинетНаСайте(ТабличныйДокумент, ПараметрыПечати, ТекущийДокумент);
			
		ИначеЕсли ИмяМакета = "ПФ_MXL_СправкаОСоставеСемьиИПрописке" Тогда
			
			ТабличныйДокумент = ПечатьСправкаОСоставеСемьи(ТабличныйДокумент, ПараметрыПечати, ТекущийДокумент);
			
		ИначеЕсли ИмяМакета = "ПФ_MXL_СправкаОРазмереПлатежей" Тогда
			
			ТабличныйДокумент = ПечатьСправкаОРазмереПлатежей(ТабличныйДокумент, ПараметрыПечати, ТекущийДокумент);	

		ИначеЕсли ИмяМакета = "ПФ_MXL_МакетАктСверки" Тогда
			
			ТабличныйДокумент = ПечатьАктСверки(ТабличныйДокумент, ПараметрыПечати, ТекущийДокумент);
			
		ИначеЕсли ИмяМакета = "ПФ_MXL_МакетПеня" Тогда
			
			ТабличныйДокумент = ПечатьПеня(ТабличныйДокумент, ПараметрыПечати, ТекущийДокумент);
			
		ИначеЕсли ИмяМакета = "ПФ_MXL_СчетЗаказ" Тогда
			
			ТабличныйДокумент = ПечатьСчетЗаказ(ТабличныйДокумент, ПараметрыПечати, ТекущийДокумент);
			
		КонецЕсли;                        

				
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, ТекущийДокумент);
		
	КонецЦикла;
	
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.Защита = Истина;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

Функция НайтиРеквизитыАдреса(Адрес)
	
	СтруктураАдреса = Новый Структура;
	КлючПоследнегоЭлемента = Неопределено;
	
	Для Сч = 1 По СтрЧислоСтрок(Адрес) Цикл
		Стр = СтрПолучитьСтроку(Адрес, Сч);
		Если Лев(Стр, 1) = Символы.Таб Тогда
			Если КлючПоследнегоЭлемента <> Неопределено Тогда
				СтруктураАдреса.Вставить(
				КлючПоследнегоЭлемента,
				СтруктураАдреса[КлючПоследнегоЭлемента] + Символы.ПС + Сред(Стр, 2)
				);
			КонецЕсли;
		Иначе
			Поз = Найти(Стр, "=");
			Если Поз <> 0 Тогда
				КлючПоследнегоЭлемента = Лев(Стр, Поз-1);
				СтруктураАдреса.Вставить(КлючПоследнегоЭлемента, СокрЛП(Сред(Стр, Поз+1)));
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат СтруктураАдреса;
	
КонецФункции // ()

Функция НайтиРеквизитыКвартиры(Квартира, СтрокаРеквизита, Подстрока)
	
	Строка = СтрПолучитьСтроку(Квартира,СтрокаРеквизита);
	Число = Найти(Строка,Подстрока);
	
	Возврат СокрЛП(Прав(Строка,СтрДлина(Строка)-Число)); 
	
КонецФункции // ()

//===================================================  ФУНКЦИИ ФОРМИРОВАНИЯ ПЕЧАТНЫХ ФОРМ ==================================================================
Функция ПечатьСчетЗаказ(ТабличныйДокумент, ПараметрыПечати, ТекущийДокумент)
	Макет = ПолучитьМакет("ПФ_MXL_СчетЗаказ");
	ПечататьРезультат = Ложь;
	РезультатЗапроса = ПолучитьОбщуюСтруктуруКвитанции(ТекущийДокумент,ПараметрыПечати.ПериодПечати);
	//ЗаголовокСчета
	ВладелецЛС = РегистрыСведений.ОтветственныйВладелецЛицевогоСчета.СрезПоследних(ТекущаяДата(),Новый Структура("ЛицевойСчет",ТекущийДокумент))[0].ОтветственныйВладелец;
	ВладелецЛицевогоСчета = ВладелецЛС.Наименование;

	Организация = ТекущийДокумент.Владелец.Организация;
	БанкОрганизации = Организация.БанковскийСчетПоУмолчанию;
	
	Отбор = Новый Структура("Организация",Организация);
	СтавкаНДС = РегистрыСведений.СистемыНалогообложенияОрганизаций.ПолучитьПоследнее(ТекущаяДата(),Отбор).СистемаНалогообложения;
	НДС = 0;
	Если  СтавкаНДС = Перечисления.СистемыНалогооблажения.НалогНаПрибыльИНДС Тогда
		НДС = 1.2;    //Временная мера
	КонецЕсли;
	
	ОбластьЗаголовок = Макет.ПолучитьОбласть("Заголовок");
	//Штрихкод или Номер квитанции
	Штрихкод = ТекущийДокумент.Наименование+"-"+Строка(Формат(НачалоМесяца(ПараметрыПечати.ПериодПечати),"ДФ=ddMMyyyy"))+НСтр("ru = ' від '; uk = ' від '")+Формат(ТекущаяДата(),"ДФ=dd.MM.yyyy")  ;
	ШтрихкодированиеПечатныхФорм.ВывестиШтрихкодВТабличныйДокумент(ТабличныйДокумент, Макет, ОбластьЗаголовок, ТекущийДокумент.Ссылка);
	ОбластьЗаголовок.Параметры.ТекстЗаголовка =НСтр("ru = 'Рахунок на сплату №'; uk = 'Рахунок на сплату №'")+Штрихкод;
	ТабличныйДокумент.Вывести(ОбластьЗаголовок);
	
	//Поставщик
	ВыгрузкаБанки = ПараметрыПечати.БанковскийСчетНаПечать.Выгрузить();
	РеквизитыПоставщикаБанк = "";
	Для Каждого Строка из ВыгрузкаБанки Цикл;
		Если Строка.Печать  Тогда 
			БанкРекв = Строка.БанковскийСчет;
			РеквизитыПостав = НСтр("ru = 'Р/с'; uk = 'П/р'")+БанкРекв.НомерСчета+", "+
			БанкРекв.Банк.Наименование+", "+
			БанкРекв.Банк.Город+", МФО "+
			БанкРекв.Банк.Код+Символы.ПС+
			?(Организация.КонтактнаяИнформация.Найти(Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации,"Вид") = Неопределено,"",Организация.КонтактнаяИнформация.Найти(Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации,"Вид").Представление+", тел.:")+
			?(Организация.КонтактнаяИнформация.Найти(Справочники.ВидыКонтактнойИнформации.ТелефонОрганизации,"Вид") = Неопределено,"",Организация.КонтактнаяИнформация.Найти(Справочники.ВидыКонтактнойИнформации.ТелефонОрганизации,"Вид").Представление)+Символы.ПС+Символы.ПС;
			РеквизитыПоставщикаБанк = РеквизитыПоставщикаБанк + РеквизитыПостав;
		КонецЕсли;
	КонецЦикла;
	РеквизитыПокупателяБанк = "";
	Если ВладелецЛС.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицо Тогда
		РеквизитыПокуп = ВладелецЛС.МобДляСайта;
		РеквизитыПокупателяБанк = РеквизитыПокупателяБанк + РеквизитыПокуп;
	КонецЕсли;
			
	ОбластьПоставщик = Макет.ПолучитьОбласть("Поставщик");
	ОбластьПоставщик.Параметры.ПредставлениеПоставщика = Организация.НаименованиеПолное;	
	ОбластьПоставщик.Параметры.РеквизитыПоставщика = РеквизитыПоставщикаБанк;			
	ТабличныйДокумент.Вывести(ОбластьПоставщик);

	//Покупатель
	ОбластьПокупатель = Макет.ПолучитьОбласть("Покупатель");
	ОбластьПокупатель.Параметры.ПредставлениеПокупателя = РегистрыСведений.ОтветственныйВладелецЛицевогоСчета.СрезПоследних(ТекущаяДата(),Новый Структура("ЛицевойСчет",ТекущийДокумент))[0].ОтветственныйВладелец.Наименование;
	ОбластьПокупатель.Параметры.РеквизитыПокупателя = РеквизитыПокупателяБанк;
	ТабличныйДокумент.Вывести(ОбластьПокупатель);
	
	// Договора
	ОбластьДоговора = Макет.ПолучитьОбласть("Договора");
	ОбластьДоговора.Параметры.Договор       = ВладелецЛС.ЮрЛицо.ДоговорПоУмолчанию.Наименование;
	ОбластьДоговора.Параметры.НомерДоговора = ВладелецЛС.ЮрЛицо.ДоговорПоУмолчанию.НомерДоговора;
	ОбластьДоговора.Параметры.ДатаДоговора  = Формат(ВладелецЛС.ЮрЛицо.ДоговорПоУмолчанию.ДатаДоговора, "Л=uk_UA; ДФ=dd.MM.yyyy"); 
	ТабличныйДокумент.Вывести(ОбластьДоговора);
			
	//ШапкаТаблицы
	ОбластьШапкаТаблицы = Макет.ПолучитьОбласть("ШапкаТаблицы");
	ТабличныйДокумент.Вывести(ОбластьШапкаТаблицы);
	
	Долг =0;
	Аванс = 0;
	ПредыдущаяУслуга = "";
	ДобавитьКАвансу = 0;
	
	ВыборкаОстатокПоУслугам = РезультатЗапроса[5].Выбрать();

	
	РезультатОстаток = РезультатЗапроса[0].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	РезультатОстаток.Следующий();
	Остаток = РезультатОстаток.СуммаОстаток;
	Если Остаток = Неопределено Тогда
		Остаток = 0;
	КонецЕсли;
	
	ВыборкаПоПриборамУчета = РезультатЗапроса[1].Выбрать();
	ВыборкаАвансовыхПлатежей = РезультатЗапроса[3].Выбрать();
	ВыборкаПоУслугам = РезультатЗапроса[2].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	НомерСтроки = 1;
	Пока ВыборкаПоУслугам.Следующий() Цикл
		НачислениеИтог = ВыборкаПоУслугам.Начисление;
		ЛьготаИтог = ВыборкаПоУслугам.Льгота;
		СубсидияИтог = ВыборкаПоУслугам.Субсидия;
		ПерерасчетИтог  = ВыборкаПоУслугам.Перерасчет;
		КорректировкаИтог = ВыборкаПоУслугам.Корректировка;
		ОплатаИтог = ВыборкаПоУслугам.Оплата;
		ИтогоНачислено = НачислениеИтог+ ЛьготаИтог+  СубсидияИтог +ПерерасчетИтог + КорректировкаИтог;
		УслугиДетали = ВыборкаПоУслугам.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока УслугиДетали.Следующий() Цикл
		    ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
			ОбластьСтрока.Параметры.НомерСтроки = НомерСтроки;
			ОбластьСтрока.Параметры.Услуга = УслугиДетали.Услуга.ПолноеНаименование;
			ВыборкаТариф = УслугиДетали.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Тариф = "";
			КоличествоЕдИзм = 0;
			Пока ВыборкаТариф.Следующий() Цикл
				Если Тариф = "" Тогда
				    Значение = ?(ВыборкаТариф.Тариф = 0 ,"",Строка(ВыборкаТариф.Тариф)) ;

				Иначе 
					Значение = "\"+Строка(ВыборкаТариф.Тариф);
				КонецЕсли;
				Тариф = Тариф+Значение;
				КоличествоЕдИзм = КоличествоЕдИзм+ ВыборкаТариф.КоличествоЕдИзм;
			КонецЦикла;

			ОбластьСтрока.Параметры.Тариф = Тариф;
			ОбластьСтрока.Параметры.Единица = УслугиДетали.ЕдиницаИзмерения;
			ОбластьСтрока.Параметры.Количество = КоличествоЕдИзм;
			ОбластьСтрока.Параметры.Насчитано = УслугиДетали.Начисление;
			//ОбластьСтрока.Параметры.Льготы = УслугиДетали.Льгота;
			//ОбластьСтрока.Параметры.Субсидии = УслугиДетали.Субсидия;
			//ОбластьСтрока.Параметры.Корректировка = УслугиДетали.Корректировка;
			//ОбластьСтрока.Параметры.Перерасчет = УслугиДетали.Перерасчет;
			//Сумма = УслугиДетали.Начисление + УслугиДетали.Льгота+ УслугиДетали.Субсидия +УслугиДетали.Корректировка+УслугиДетали.Перерасчет;
			//ОбластьСтрока.Параметры.Сумма = Сумма;
			ТабличныйДокумент.Вывести(ОбластьСтрока);
			
			Если УслугиДетали.Услуга.ВидУслуги = Справочники.ВидыУслуг.ХолоднаяВода Тогда
				СтруктураПоискаПриборов = Новый Структура("ОбъектУстановки, Услуга");
				СтруктураПоискаПриборов.ОбъектУстановки = ТекущийДокумент;
				СтруктураПоискаПриборов.Услуга = УслугиДетали.Услуга;
				Пока ВыборкаПоПриборамУчета.НайтиСледующий(СтруктураПоискаПриборов) Цикл
					ОбластьПриборы = Макет.ПолучитьОбласть("ПриборУчета");
					ОбластьПриборы.Параметры.Прибор = ВыборкаПоПриборамУчета.ПриборУчета;
					ОбластьПриборы.Параметры.ПредыдущиеПоказания = ВыборкаПоПриборамУчета.ПредыдущиеПоказания;
					ОбластьПриборы.Параметры.ТекущиеПоказания = ВыборкаПоПриборамУчета.ТекущиеПоказания;
					ОбластьПриборы.Параметры.Разница = ВыборкаПоПриборамУчета.ТекущиеПоказания - ВыборкаПоПриборамУчета.ПредыдущиеПоказания;
					ТабличныйДокумент.Вывести(ОбластьПриборы);
				КонецЦикла;
			КонецЕсли;
			НомерСтроки = НомерСтроки + 1;
		КонецЦикла;
	КонецЦикла;
	//Итого
	ОбластьИтого = Макет.ПолучитьОбласть("Итого");
	ОбластьИтого.Параметры.Всего = ИтогоНачислено;
	ТабличныйДокумент.Вывести(ОбластьИтого);
	
	
	СуммаНДС = 0;		
	//Итого
	Если НДС <> 0 Тогда
		
		ОбластьИтогоНДС = Макет.ПолучитьОбласть("ИтогоНДС");
		
		ИтогСуммы = ИтогоНачислено;
		//Мера временная
		ОбластьИтогоНДС.Параметры.ВсегоНДС = ИтогоНачислено;
		
		СуммаНДС = Формат(ИтогоНачислено - ИтогоНачислено/НДС, "ЧЦ=10; ЧДЦ=2");
		ОбластьИтогоНДС.Параметры.НДС = "в т.ч. ПДВ:";
		ОбластьИтогоНДС.Параметры.ВсегоНДС = СуммаНДС;
		
		
		ТабличныйДокумент.Вывести(ОбластьИтогоНДС);
		
		Если ПечататьРезультат Тогда
			ОбластьИтого = Макет.ПолучитьОбласть("ИтогоНДСРезультат");
			ИтогСуммы = Долг + Аванс + ИтогоНачислено+ ДобавитьКАвансу;
			ОбластьИтого.Параметры.Всего = ИтогСуммы;
			
			ОбластьИтого.Параметры.Аванс = Аванс+ ДобавитьКАвансу;
			
			ОбластьИтого.Параметры.Долг = Долг;
		КонецЕсли;	
	Иначе
		//ОбластьИтого = Макет.ПолучитьОбласть("Итого");
		//
		//ИтогСуммы = ИтогоНачислено;
		//ОбластьИтого.Параметры.Всего = ИтогоНачислено;

		//ТабличныйДокумент.Вывести(ОбластьИтого);
		//
		//Если ПечататьРезультат Тогда
		//	
		//	ОбластьИтого = Макет.ПолучитьОбласть("ИтогоРезультат");
		//	ИтогСуммы = Долг + Аванс + ИтогоНачислено + ДобавитьКАвансу;
		//	
		//	ОбластьИтого.Параметры.Всего = ИтогСуммы;
		//	
		//	ОбластьИтого.Параметры.Аванс = Аванс+ ДобавитьКАвансу;
		//	
		//	ОбластьИтого.Параметры.Долг = Долг;
		//	
		//	ТабличныйДокумент.Вывести(ОбластьИтого);
		//КонецЕсли;
	КонецЕсли;

	
	//СуммаПрописью
	ОбластьСуммаПрописью = Макет.ПолучитьОбласть("СуммаПрописью");
	ОбластьСуммаПрописью.Параметры.ИтоговаяСтрока = НСтр("ru='Всього надано послуг ';uk='Всього надано послуг '",)+(НомерСтроки-1) + ", "+
	НСтр("ru=' на суму ';uk=' на суму '",) + ИтогСуммы+ " грн.";
	
	КодЛок = ТекущийКодЛокализации();
	ОбластьСуммаПрописью.Параметры.СуммаПрописью = ЧислоПрописью(ИтогСуммы,НСтр("ru = 'Л= ru_RU; ДП=Истина'; uk = 'Л= uk_UA; ДП=Истина'"), НСтр("ru = 'гривня,гривні,гривень,ж,копійка,копійки,копійок,ж,'; uk = 'гривня,гривні,гривень,ж,копійка,копійки,копійок,ж,2'"));

	ТабличныйДокумент.Вывести(ОбластьСуммаПрописью);
	
	//Подписи
	ОбластьПодписи = Макет.ПолучитьОбласть("Подписи");
	ТабличныйДокумент.Вывести(ОбластьПодписи);
	Возврат ТабличныйДокумент;
КонецФункции

Функция ПечатьОтчетПоЛС (ТабличныйДокумент, ПараметрыПечати, ТекущийДокумент)
	
	Макет = ПолучитьМакет("ОтчетВладельцуЛС");
	
	
	Запрос = Новый Запрос;
	Запрос.Текст =  "ВЫБРАТЬ
	                |	УстановленныеПриборыУчетаСрезПоследних.ПриборУчета.ЗаводскойНомер КАК ЗаводскойНомер,
	                |	УстановленныеПриборыУчетаСрезПоследних.ПриборУчета.Услуга КАК Услуга,
	                |	УстановленныеПриборыУчетаСрезПоследних.ПриборУчета.Тарифность КАК Тарифность,
	                |	УстановленныеПриборыУчетаСрезПоследних.ПриборУчета.СпособРегистрацииПоказаний КАК СпособРегистрацииПоказаний,
	                |	УстановленныеПриборыУчетаСрезПоследних.ПриборУчета.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	                |	ЕСТЬNULL(ВЫБОР
	                |			КОГДА ПоверкиПриборовУчетаСрезПоследних.Период < &МесяцНачисления
	                |					И ПоверкиПриборовУчетаСрезПоследних.ПоверкаВыполнена = ИСТИНА
	                |				ТОГДА ПоверкиПриборовУчетаСрезПоследних.Период
	                |		КОНЕЦ, """") КАК ДатаПоследнейПоверки,
	                |	ЕСТЬNULL(ВЫБОР
	                |			КОГДА ПоверкиПриборовУчетаСрезПоследних.Период > &МесяцНачисления
	                |				ТОГДА ПоверкиПриборовУчетаСрезПоследних.Период
	                |		КОНЕЦ, """") КАК ДатаСледуюшейПоверки,
	                |	УстановленныеПриборыУчетаСрезПоследних.ПриборУчета,
	                |	УстановленныеПриборыУчетаСрезПоследних.Период КАК ДатаУстановки,
	                |	ПоказанияПрибораУчета.ТекущиеПоказания
	                |ИЗ
	                |	РегистрСведений.УстановленныеПриборыУчета.СрезПоследних(, ОбъектУстановки В (&ЛицевыеСчета)) КАК УстановленныеПриборыУчетаСрезПоследних
	                |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	                |			ПоказанияПриборовУчетаСрезПоследних.ПриборУчета КАК ПриборУчета,
	                |			СУММА(ПоказанияПриборовУчетаСрезПоследних.Значение) КАК ТекущиеПоказания,
	                |			СУММА(0) КАК ПредыдущиеПоказания
	                |		ИЗ
	                |			РегистрСведений.ПоказанияПриборовУчета.СрезПоследних(КОНЕЦПЕРИОДА(&МесяцНачисления, МЕСЯЦ), ) КАК ПоказанияПриборовУчетаСрезПоследних
	                |		
	                |		СГРУППИРОВАТЬ ПО
	                |			ПоказанияПриборовУчетаСрезПоследних.ПриборУчета
	                |		
	                |		ОБЪЕДИНИТЬ ВСЕ
	                |		
	                |		ВЫБРАТЬ
	                |			ПоказанияПриборовУчетаСрезПоследних.ПриборУчета,
	                |			СУММА(0),
	                |			СУММА(ПоказанияПриборовУчетаСрезПоследних.Значение)
	                |		ИЗ
	                |			РегистрСведений.ПоказанияПриборовУчета.СрезПоследних(ДОБАВИТЬКДАТЕ(КОНЕЦПЕРИОДА(&МесяцНачисления, МЕСЯЦ), ДЕНЬ, -1), ) КАК ПоказанияПриборовУчетаСрезПоследних
	                |		ГДЕ
	                |			ПоказанияПриборовУчетаСрезПоследних.Период < КОНЕЦПЕРИОДА(&МесяцНачисления, МЕСЯЦ)
	                |		
	                |		СГРУППИРОВАТЬ ПО
	                |			ПоказанияПриборовУчетаСрезПоследних.ПриборУчета) КАК ПоказанияПрибораУчета
	                |		ПО УстановленныеПриборыУчетаСрезПоследних.ПриборУчета = ПоказанияПрибораУчета.ПриборУчета
	                |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПоверкиПриборовУчета.СрезПоследних(&МесяцНачисления, ОбъектУстановки В (&ЛицевыеСчета)) КАК ПоверкиПриборовУчетаСрезПоследних
	                |		ПО УстановленныеПриборыУчетаСрезПоследних.ПриборУчета = ПоверкиПриборовУчетаСрезПоследних.ПриборУчета
	                |			И УстановленныеПриборыУчетаСрезПоследних.ОбъектУстановки = ПоверкиПриборовУчетаСрезПоследних.ОбъектУстановки
	                |ГДЕ
	                |	УстановленныеПриборыУчетаСрезПоследних.Действует = ИСТИНА
	                |;
	                |
	                |////////////////////////////////////////////////////////////////////////////////
	                |ВЫБРАТЬ
	                |	РасчетыПоЛицевымСчетам.ЛицевойСчет.Владелец КАК Здание,
	                |	РасчетыПоЛицевымСчетам.ЛицевойСчет КАК ЛицевойСчет,
	                |	РасчетыПоЛицевымСчетам.Услуга КАК Услуга,
	                |	РасчетыПоЛицевымСчетам.Услуга.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	                |	МАКСИМУМ(РасчетыПоЛицевымСчетам.Тариф) КАК Тариф,
	                |	СУММА(РасчетыПоЛицевымСчетам.ДнейНачислено) КАК ДнейНачислено,
	                |	СУММА(ЕСТЬNULL(ВЫБОР
	                |				КОГДА РасчетыПоЛицевымСчетам.ВидНачисления = ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Начисление)
	                |					ТОГДА РасчетыПоЛицевымСчетам.Количество
	                |			КОНЕЦ, 0)) КАК КоличествоЕдИзм,
	                |	СУММА(ВЫБОР
	                |			КОГДА РасчетыПоЛицевымСчетам.ВидНачисления = ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Начисление)
	                |				ТОГДА РасчетыПоЛицевымСчетам.Сумма
	                |			ИНАЧЕ 0
	                |		КОНЕЦ) КАК Начисление,
	                |	СУММА(ВЫБОР
	                |			КОГДА РасчетыПоЛицевымСчетам.ВидНачисления = ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Субсидия)
	                |				ТОГДА РасчетыПоЛицевымСчетам.Сумма
	                |			ИНАЧЕ 0
	                |		КОНЕЦ) КАК Субсидия,
	                |	СУММА(ВЫБОР
	                |			КОГДА РасчетыПоЛицевымСчетам.ВидНачисления = ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Льгота)
	                |				ТОГДА РасчетыПоЛицевымСчетам.Сумма
	                |			ИНАЧЕ 0
	                |		КОНЕЦ) КАК Льгота,
	                |	СУММА(ВЫБОР
	                |			КОГДА РасчетыПоЛицевымСчетам.ВидНачисления = ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Перерасчет)
	                |				ТОГДА РасчетыПоЛицевымСчетам.Сумма
	                |			ИНАЧЕ 0
	                |		КОНЕЦ) КАК Перерасчет,
	                |	СУММА(ВЫБОР
	                |			КОГДА РасчетыПоЛицевымСчетам.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	                |				ТОГДА РасчетыПоЛицевымСчетам.Сумма
	                |			ИНАЧЕ 0
	                |		КОНЕЦ) КАК Оплата,
	                |	СУММА(ВЫБОР
	                |			КОГДА НЕ РасчетыПоЛицевымСчетам.ВидНачисления = ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Начисление)
	                |					И НЕ РасчетыПоЛицевымСчетам.ВидНачисления = ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Льгота)
	                |					И НЕ РасчетыПоЛицевымСчетам.ВидНачисления = ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Субсидия)
	                |					И НЕ РасчетыПоЛицевымСчетам.ВидНачисления = ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Перерасчет)
	                |					И РасчетыПоЛицевымСчетам.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	                |				ТОГДА РасчетыПоЛицевымСчетам.Сумма
	                |			ИНАЧЕ 0
	                |		КОНЕЦ) КАК Корректировка,
	                |	РасчетыПоЛицевымСчетам.ЛицевойСчет.ОбъектЛицевогоСчета КАК Квартира,
	                |	ЕСТЬNULL(РасчетыПоЛицевымСчетам.Порог, """") КАК Порог,
	                |	РасчетыПоЛицевымСчетам.МесяцНачисления КАК МесяцНачисления,
	                |	СУММА(ЕСТЬNULL(ВложенныйЗапрос.СуммаОстаток, 0)) КАК Долг
	                |ИЗ
	                |	РегистрНакопления.РасчетыПоЛицевымСчетам КАК РасчетыПоЛицевымСчетам
	                |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	                |			РасчетыПоЛицевымСчетамОстатки.ЛицевойСчет КАК ЛицевойСчет,
	                |			РасчетыПоЛицевымСчетамОстатки.Услуга КАК Услуга,
	                |			РасчетыПоЛицевымСчетамОстатки.МесяцНачисления КАК МесяцНачисления,
	                |			РасчетыПоЛицевымСчетамОстатки.СуммаОстаток КАК СуммаОстаток
	                |		ИЗ
	                |			РегистрНакопления.РасчетыПоЛицевымСчетам.Остатки(&МесяцНачисления, ЛицевойСчет В (&ЛицевыеСчета)) КАК РасчетыПоЛицевымСчетамОстатки) КАК ВложенныйЗапрос
	                |		ПО РасчетыПоЛицевымСчетам.ЛицевойСчет = ВложенныйЗапрос.ЛицевойСчет
	                |			И РасчетыПоЛицевымСчетам.Услуга = ВложенныйЗапрос.Услуга
	                |			И РасчетыПоЛицевымСчетам.МесяцНачисления = ВложенныйЗапрос.МесяцНачисления
	                |ГДЕ
	                |	РасчетыПоЛицевымСчетам.ЛицевойСчет В(&ЛицевыеСчета)
	                |	И РасчетыПоЛицевымСчетам.Период <= КОНЕЦПЕРИОДА(&МесяцНачисления, МЕСЯЦ)
	                |
	                |СГРУППИРОВАТЬ ПО
	                |	РасчетыПоЛицевымСчетам.ЛицевойСчет,
	                |	РасчетыПоЛицевымСчетам.Услуга,
	                |	РасчетыПоЛицевымСчетам.ЛицевойСчет.Владелец,
	                |	РасчетыПоЛицевымСчетам.Услуга.ЕдиницаИзмерения,
	                |	РасчетыПоЛицевымСчетам.ЛицевойСчет.ОбъектЛицевогоСчета,
	                |	ЕСТЬNULL(РасчетыПоЛицевымСчетам.Порог, """"),
	                |	РасчетыПоЛицевымСчетам.МесяцНачисления
	                |
	                |УПОРЯДОЧИТЬ ПО
	                |	МесяцНачисления,
	                |	Услуга УБЫВ
	                |ИТОГИ
	                |	СУММА(Начисление),
	                |	СУММА(Субсидия),
	                |	СУММА(Льгота),
	                |	СУММА(Перерасчет),
	                |	СУММА(Оплата),
	                |	СУММА(Корректировка),
	                |	СУММА(Долг)
	                |ПО
	                |	МесяцНачисления
	                |;
	                |
	                |////////////////////////////////////////////////////////////////////////////////
	                |ВЫБРАТЬ
	                |	ЛицевыеСчета.Представление КАК ЛицевойСчет,
	                |	ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ОтветственныйВладелец.Представление КАК ОтветственныйВладелец,
	                |	ЛицевыеСчетаСрезПоследних.КоличествоПрописанных,
	                |	ЛицевыеСчетаСрезПоследних.КоличествоПроживающих,
	                |	МашиноМестаСрезПоследних.КоличествоМашиноМест,
	                |	ЛицевыеСчета.ОбъектЛицевогоСчета КАК Квартира,
	                |	ЛицевыеСчета.ОбъектЛицевогоСчета.Владелец КАК Здание,
	                |	ЛицевыеСчета.ОбъектЛицевогоСчета.Владелец.Организация КАК Организация
	                |ИЗ
	                |	Справочник.ЛицевыеСчета КАК ЛицевыеСчета
	                |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОтветственныйВладелецЛицевогоСчета.СрезПоследних КАК ОтветственныйВладелецЛицевогоСчетаСрезПоследних
	                |		ПО ЛицевыеСчета.Ссылка = ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ЛицевойСчет
	                |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЛицевыеСчета.СрезПоследних(&МесяцНачисления, ) КАК ЛицевыеСчетаСрезПоследних
	                |		ПО ЛицевыеСчета.Ссылка = ЛицевыеСчетаСрезПоследних.ЛицевойСчет
	                |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.МашиноМеста.СрезПоследних(&МесяцНачисления, ) КАК МашиноМестаСрезПоследних
	                |		ПО ЛицевыеСчета.Ссылка = МашиноМестаСрезПоследних.ЛицевойСчет
	                |ГДЕ
	                |	ЛицевыеСчета.Ссылка В(&ЛицевыеСчета)";
		Запрос.УстановитьПараметр("ЛицевыеСчета",ТекущийДокумент);
		Запрос.УстановитьПараметр("МесяцНачисления",ТекущаяДата());
		
		Результат = Запрос.ВыполнитьПакет();
		
		ВыборкаОсновная 	= Результат[2].Выбрать();
		ВыборкаПриборы 		= Результат[0].Выбрать();
		ВыборкаУслуги 		= Результат[1].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		//Заполнение шапки отчета
		ВыборкаОсновная.Следующий();
		
		ОбластьШапкаОтчета = Макет.ПолучитьОбласть("ШапкаОтчета");
		ОбластьШапкаОтчета.Параметры.ЛицевойСчет = ВыборкаОсновная.ЛицевойСчет;
		ОбластьШапкаОтчета.Параметры.Организация = ВыборкаОсновная.Организация;
		ОбластьШапкаОтчета.Параметры.ДатаВыдачи  = ТекущаяДата();
		ТабличныйДокумент.Вывести(ОбластьШапкаОтчета);
		
		//Заполнение основных данных о ЛС
		ОбластьОсновныеДанные = Макет.ПолучитьОбласть("ОсновныеДанные");
		ОбластьОсновныеДанные.Параметры.ЛицевойСчет 			= ВыборкаОсновная.ЛицевойСчет;
		ОбластьОсновныеДанные.Параметры.ОтветственныйВладелец	= ВыборкаОсновная.ОтветственныйВладелец;
		ОбластьОсновныеДанные.Параметры.Прописано 				= ВыборкаОсновная.КоличествоПрописанных;
		ОбластьОсновныеДанные.Параметры.Проживает 				= ВыборкаОсновная.КоличествоПроживающих;
		ОбластьОсновныеДанные.Параметры.Адрес 					= Строка(ВыборкаОсновная.Здание)+", "+Строка(ВыборкаОсновная.Квартира);
		ОбластьОсновныеДанные.Параметры.КоличествоМашиномест 	= ВыборкаОсновная.КоличествоМашиномест;
		ТабличныйДокумент.Вывести(ОбластьОсновныеДанные);
		
		//Заполеннение таблицы взаиморасчетов по услугам
		ОбластьШапкаТаблицыВзаиморасчетов = Макет.ПолучитьОбласть("ШапкаУслуги");
		ТабличныйДокумент.Вывести(ОбластьШапкаТаблицыВзаиморасчетов);
		
		Пока ВыборкаУслуги.Следующий() Цикл
			ОбластьМесяцНачисления = Макет.ПолучитьОбласть("МесяцНачисления");
			ОбластьМесяцНачисления.Параметры.МесяцНачисления = Формат(ВыборкаУслуги.МесяцНачисления,"ДФ='MMMM yyyy'");
			ОбластьМесяцНачисления.Параметры.Долг = ВыборкаУслуги.Долг;
			ОбластьМесяцНачисления.Параметры.Начислено = ВыборкаУслуги.Начисление;
			ОбластьМесяцНачисления.Параметры.Льгота  = ВыборкаУслуги.Льгота;
			ОбластьМесяцНачисления.Параметры.Субсидия = ВыборкаУслуги.Субсидия;
			ОбластьМесяцНачисления.Параметры.Корректировка = ВыборкаУслуги.Корректировка;
			ОбластьМесяцНачисления.Параметры.Перерасчет = ВыборкаУслуги.Перерасчет;
			ОбластьМесяцНачисления.Параметры.Оплата = ВыборкаУслуги.Оплата;
			ОбластьМесяцНачисления.Параметры.Итого = ВыборкаУслуги.Долг + ВыборкаУслуги.Начисление + ВыборкаУслуги.Льгота + ВыборкаУслуги.Субсидия+  ВыборкаУслуги.Корректировка + ВыборкаУслуги.Перерасчет - ВыборкаУслуги.Оплата; 
			ТабличныйДокумент.Вывести(ОбластьМесяцНачисления);
			
			ВыборкаУслугиПодробно = ВыборкаУслуги.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаУслугиПодробно.Следующий() Цикл
				
				ОбластьТаблицыУслуга = Макет.ПолучитьОбласть("Услуга");
				ОбластьТаблицыУслуга.Параметры.Услуга = ВыборкаУслугиПодробно.Услуга;
				ТабличныйДокумент.Вывести(ОбластьТаблицыУслуга);
				
				ОбластьТаблицыДанные = Макет.ПолучитьОбласть("ДанныеУслуга");
				ОбластьТаблицыДанные.Параметры.Долг 		= ВыборкаУслугиПодробно.Долг;
				ОбластьТаблицыДанные.Параметры.Тариф 		= ВыборкаУслугиПодробно.Тариф;
				ОбластьТаблицыДанные.Параметры.ЕдИзм 		= ВыборкаУслугиПодробно.ЕдиницаИзмерения;
				ОбластьТаблицыДанные.Параметры.Количество 	= ВыборкаУслугиПодробно.КоличествоЕдИзм;
				ОбластьТаблицыДанные.Параметры.Начислено 	= ВыборкаУслугиПодробно.Начисление;
				ОбластьТаблицыДанные.Параметры.Льгота 		= ВыборкаУслугиПодробно.Льгота;
				ОбластьТаблицыДанные.Параметры.Субсидия 	= ВыборкаУслугиПодробно.Субсидия;
				ОбластьТаблицыДанные.Параметры.Корректировка= ВыборкаУслугиПодробно.Корректировка;
				ОбластьТаблицыДанные.Параметры.Перерасчет 	= ВыборкаУслугиПодробно.Перерасчет;
				ОбластьТаблицыДанные.Параметры.Оплачено 	= ВыборкаУслугиПодробно.Оплата;
				ОбластьТаблицыДанные.Параметры.Итого 		= ВыборкаУслугиПодробно.Долг + ВыборкаУслугиПодробно.Начисление + ВыборкаУслугиПодробно.Льгота 
														+ ВыборкаУслугиПодробно.Субсидия + ВыборкаУслугиПодробно.Корректировка +  ВыборкаУслугиПодробно.Перерасчет - ВыборкаУслугиПодробно.Оплата;
				ТабличныйДокумент.Вывести(ОбластьТаблицыДанные);
			КонецЦикла;
		КонецЦикла;
		
		//Заполнаяем таблицу приборов
		ОбластьШапкаТаблыцыПриборов = Макет.ПолучитьОбласть("ПриборыШапка");
		ТабличныйДокумент.Вывести(ОбластьШапкаТаблыцыПриборов);
		
		Пока ВыборкаПриборы.Следующий() Цикл 
			ОбластьСтрокаПриборы = Макет.ПолучитьОбласть("ТаблицаПриборы");
			ОбластьСтрокаПриборы.Параметры.НомерСчетчика 		= ВыборкаПриборы.ЗаводскойНомер;
			ОбластьСтрокаПриборы.Параметры.Услуга  		 		= ВыборкаПриборы.Услуга;
			ОбластьСтрокаПриборы.Параметры.Тарифность	 		= ВыборкаПриборы.Тарифность;
			ОбластьСтрокаПриборы.Параметры.СпособРегистрации    = ВыборкаПриборы.СпособРегистрацииПоказаний;
			ОбластьСтрокаПриборы.Параметры.ЕдИзм 				= ВыборкаПриборы.ЕдиницаИзмерения;
			ОбластьСтрокаПриборы.Параметры.ДатаУстановки		= ВыборкаПриборы.ДатаУстановки;
			ОбластьСтрокаПриборы.Параметры.ДатаПоследнейПоверки = ВыборкаПриборы.ДатаПоследнейПоверки;
			ОбластьСтрокаПриборы.Параметры.ДатаСледующейПоверки = ВыборкаПриборы.ДатаСледуюшейПоверки;
			ОбластьСтрокаПриборы.Параметры.Показание 			= ВыборкаПриборы.ТекущиеПоказания;
			ТабличныйДокумент.Вывести(ОбластьСтрокаПриборы);
		КонецЦикла;
		
	Возврат ТабличныйДокумент;	
	 
КонецФункции

Функция ПечатьКарточкаПрописки(ТабличныйДокумент, ПараметрыПечати, ТекущийДокумент)

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ФизическиеЛица.Ссылка,
	|	ФизическиеЛица.Ссылка.Пол,
	|	ФизическиеЛица.Ссылка.ДатаРождения,
	|	ФизическиеЛица.Ссылка.МестоРождения,
	|	ФИОФизЛицСрезПоследних.Фамилия,
	|	ФИОФизЛицСрезПоследних.Имя,
	|	ФИОФизЛицСрезПоследних.Отчество,
	|	ДокументыФизическихЛицСрезПоследних.ВидДокумента,
	|	ДокументыФизическихЛицСрезПоследних.Серия,
	|	ДокументыФизическихЛицСрезПоследних.Номер,
	|	ДокументыФизическихЛицСрезПоследних.ДатаВыдачи,
	|	ДокументыФизическихЛицСрезПоследних.КемВыдан,
	|	ДокументыФизическихЛицСрезПоследних.СрокДействия
	|ИЗ
	|	Справочник.ФизическиеЛица КАК ФизическиеЛица
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДокументыФизическихЛиц.СрезПоследних КАК ДокументыФизическихЛицСрезПоследних
	|		ПО ФизическиеЛица.Ссылка.Ссылка = ДокументыФизическихЛицСрезПоследних.Физлицо.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФИОФизЛиц.СрезПоследних КАК ФИОФизЛицСрезПоследних
	|		ПО ФизическиеЛица.Ссылка.Ссылка = ФИОФизЛицСрезПоследних.ФизЛицо.Ссылка
	|ГДЕ
	|	ФизическиеЛица.Ссылка = &ФизЛицо";
	Запрос.УстановитьПараметр("ФизЛицо",ПараметрыПечати.ТекущийЖитель);
	Выборка = Запрос.Выполнить().Выгрузить();
	
	Макет = ПолучитьМакет("МакетКарточкиПрописки");
	
	//ШАПКА
	Для Каждого Строка Из Выборка Цикл
		ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
		ОбластьШапка.Параметры.Фамилия = Строка.Фамилия;
		ОбластьШапка.Параметры.Имя = Строка.Имя;
		ОбластьШапка.Параметры.Отчество = Строка.Отчество;
		ОбластьШапка.Параметры.Национальность = "";
	КонецЦикла;
	ТабличныйДокумент.Вывести(ОбластьШапка);
	
	//РОЖДЕНИЕ
	ОбластьРождение = Макет.ПолучитьОбласть("Рождение");
	Для Каждого Строка Из Выборка Цикл
		ОбластьРождение.Параметры.ЧислоРождения = Строка.СсылкаДатаРождения;
		ОбластьРождение.Параметры.МесяцРождения = Строка.СсылкаДатаРождения;
		ОбластьРождение.Параметры.ГодРождения = Строка.СсылкаДатаРождения;
		ОбластьРождение.Параметры.ОбластьРождения = Строка.СсылкаМестоРождения;
	КонецЦикла;
	ТабличныйДокумент.Вывести(ОбластьРождение);
	
	//ПРИБЫТИЕ
	ОбластьПрибытие = Макет.ПолучитьОбласть("Прибытие");
	ОбластьПрибытие.Параметры.ОбластьПрибытия = "";
	ОбластьПрибытие.Параметры.РайонПрибытия = "";
	ОбластьПрибытие.Параметры.ГородПрибытия = "";
	ОбластьПрибытие.Параметры.ЧислоПрибытия = "";
	ОбластьПрибытие.Параметры.МесяцПрибытия = "";
	ОбластьПрибытие.Параметры.ГодПрибытия = "";
	ОбластьПрибытие.Параметры.УлицаПрибытия = "";
	ОбластьПрибытие.Параметры.ДомПрибытия = "";
	ОбластьПрибытие.Параметры.КорпусПрибытия = "";
	ОбластьПрибытие.Параметры.КвартираПрибытия = "";
	ОбластьПрибытие.Параметры.ЧислоПрибытия = "";
	ОбластьПрибытие.Параметры.ГодПрибытия = "";
	ТабличныйДокумент.Вывести(ОбластьПрибытие);
	
	//ПАСПОРТШАПКА
	ОбластьПаспортШапка = Макет.ПолучитьОбласть("ПаспортШапка");
	ТабличныйДокумент.Вывести(ОбластьПаспортШапка);
	
	//ПАСПОРТТЕЛО
	ОбластьПаспортТело = Макет.ПолучитьОбласть("ПаспортТело");
	Для Каждого Строка Из Выборка Цикл
		Если Строка.ВидДокумента = Справочники.ВидыДокументовФизическихЛиц.Паспорт Тогда
			ОбластьПаспортТело.Параметры.Серия = Строка.Серия;
			ОбластьПаспортТело.Параметры.Номер = Строка.Номер;
			ОбластьПаспортТело.Параметры.КемВыдан = Строка.КемВыдан;
			ОбластьПаспортТело.Параметры.КогдаВыдан = Формат(Строка.ДатаВыдачи,"ДФ=dd.MM.yyyy");
		КонецЕсли;
	КонецЦикла;
	ТабличныйДокумент.Вывести(ОбластьПаспортТело);
	
	//МЕСТОНАХОЖДЕНИЕ
	
	Если ТекущийДокумент.Владелец.КонтактнаяИнформация.Количество() > 0 Тогда
		Для каждого СтрокаАдреса Из ТекущийДокумент.Владелец.КонтактнаяИнформация Цикл
			Если СтрокаАдреса.Вид = Справочники.ВидыКонтактнойИнформации.ПочтовыйАдресЗданияИСооружения Тогда
				Адрес = СтрокаАдреса.ЗначенияПолей;
			КонецЕсли;
		КонецЦикла; 
	Иначе
		Адрес = "";
	КонецЕсли;
	
	СтруктураАдреса = НайтиРеквизитыАдреса(Адрес);
	ОбластьМестонахождения = Макет.ПолучитьОбласть("Местонахождение");
	Попытка
		ОбластьМестонахождения.Параметры.ГородПроживания = СтруктураАдреса.Город;
		ОбластьМестонахождения.Параметры.УлицаПроживания = СтруктураАдреса.Улица;
		ОбластьМестонахождения.Параметры.ДомПроживания = СтруктураАдреса.Дом;
		ОбластьМестонахождения.Параметры.КорпусПроживания = СтруктураАдреса.Корпус;
	Исключение
		Сообщить(НСтр("ru='Не удалось получить адрес здания. Проверьте правильность заполнения адреса.';uk='Не вдалося отримати адресу будівлі. Перевірте правильність заповнення адреси.'"));
	КонецПопытки;
	ОбластьМестонахождения.Параметры.КвартираПроживания = НайтиРеквизитыКвартиры(ТекущийДокумент.ОбъектЛицевогоСчета, 1,"№");
	ТабличныйДокумент.Вывести(ОбластьМестонахождения);
	
	//РАБОТА
	ОбластьРабота = Макет.ПолучитьОбласть("Работа");
	ТабличныйДокумент.Вывести(ОбластьРабота);
	
	//ДЕТИ
	ОбластьДетиПараметры = Макет.ПолучитьОбласть("Дети|ДетиДо16");
	ОбластьДетиЗначение = Макет.ПолучитьОбласть("ДетиЗначение|ДетиДо16Значение");
	ТабличныйДокументДети = Новый ТабличныйДокумент;
	Для Счет = 1 По 4 Цикл
		ОбластьДетиЗначение.Параметры.ФИО = "";
		ОбластьДетиЗначение.Параметры.ГодРождения = "";
		ОбластьДетиЗначение.Параметры.НомерСвидетельстваОРождении = "";
		ОбластьДетиЗначение.Параметры.Город = "";
		ТабличныйДокументДети.Вывести(ОбластьДетиЗначение);
	КонецЦикла; 
	ТабличныйДокумент.Вывести(ОбластьДетиПараметры);
	ТабличныйДокумент.Присоединить(ТабличныйДокументДети);
	
	//АРМИЯ
	ОбластьАрмия = Макет.ПолучитьОбласть("Армия");
	Для Каждого Строка Из Выборка Цикл
		Если Строка.ВидДокумента = Справочники.ВидыДокументовФизическихЛиц.ВоенныйБилет Тогда
			ОбластьАрмия.Параметры.КемПринят = Строка.КемВыдан;
			ОбластьАрмия.Параметры.КогдаПринят = Формат(Строка.ДатаВыдачи,"ДФ=dd.MM.yyyy");
			ОбластьАрмия.Параметры.КемСнят = Строка.КемВыдан;
			ОбластьАрмия.Параметры.КогдаСнят = Формат(Строка.СрокДействия,"ДФ=dd.MM.yyyy");
		КонецЕсли;
	КонецЦикла;
	ТабличныйДокумент.Вывести(ОбластьАрмия);
	
	//ПРОПИСКА
	ОбластьПрописка = Макет.ПолучитьОбласть("Прописка");
	ТабличныйДокумент.Вывести(ОбластьПрописка);
	
	Возврат ТабличныйДокумент;

КонецФункции // ()

Функция ПечатьСправкаПрописанных(ТабличныйДокумент, ПараметрыПечати, ТекущийДокумент)

	ЗапросПоЛицевомуСчету = Новый Запрос;
	ЗапросПоЛицевомуСчету.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	                              |	ЛицевыеСчета.Владелец,
	                              |	ЛицевыеСчета.ОбъектЛицевогоСчета,
	                              |	ЛицевыеСчета.Наименование,
	                              |	МИНИМУМ(ЛицевыеСчета.ОбъектЛицевогоСчета.Этаж) КАК ОбъектЛицевогоСчетаЭтаж,
	                              |	ЛицевыеСчета.ОбъектЛицевогоСчета.Подъезд,
	                              |	МИНИМУМ(ЛицевыеСчета.ОбъектЛицевогоСчета.КоличествоКомнат) КАК ОбъектЛицевогоСчетаКоличествоКомнат,
	                              |	ЛицевыеСчета.ОбъектЛицевогоСчета.ЖилойФонд,
	                              |	МАКСИМУМ(ВЫБОР
	                              |			КОГДА ПлощадьОбъектовЛицевыхСчетовСрезПоследних.ВидПлощади = ЗНАЧЕНИЕ(Справочник.ВидыПлощадей.ОбщаяПлощадь)
	                              |				ТОГДА ПлощадьОбъектовЛицевыхСчетовСрезПоследних.Площадь
	                              |		КОНЕЦ) КАК Площадь,
	                              |	МИНИМУМ(ЛицевыеСчетаСрезПоследних.КоличествоПрописанных) КАК КоличествоПрописанных,
	                              |	МИНИМУМ(ЛицевыеСчетаСрезПоследних.КоличествоПроживающих) КАК КоличествоПроживающих,
	                              |	ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ОтветственныйВладелец,
	                              |	МАКСИМУМ(ВЫБОР
	                              |			КОГДА ПлощадьОбъектовЛицевыхСчетовСрезПоследних.ВидПлощади = ЗНАЧЕНИЕ(Справочник.ВидыПлощадей.ЖилаяПолощадь)
	                              |				ТОГДА ПлощадьОбъектовЛицевыхСчетовСрезПоследних.Площадь
	                              |		КОНЕЦ) КАК ЖилаяПлощадь
	                              |ИЗ
	                              |	Справочник.ЛицевыеСчета КАК ЛицевыеСчета
	                              |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛицевыеСчета.СрезПоследних КАК ЛицевыеСчетаСрезПоследних
	                              |		ПО ЛицевыеСчета.Ссылка = ЛицевыеСчетаСрезПоследних.ЛицевойСчет
	                              |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОтветственныйВладелецЛицевогоСчета.СрезПоследних КАК ОтветственныйВладелецЛицевогоСчетаСрезПоследних
	                              |		ПО ЛицевыеСчета.Ссылка = ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ЛицевойСчет
	                              |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПлощадьОбъектовЛицевыхСчетов.СрезПоследних КАК ПлощадьОбъектовЛицевыхСчетовСрезПоследних
	                              |		ПО ЛицевыеСчета.ОбъектЛицевогоСчета.Ссылка = ПлощадьОбъектовЛицевыхСчетовСрезПоследних.Помещение
	                              |ГДЕ
	                              |	ЛицевыеСчета.Ссылка = &ЛицевойСчет
	                              |
	                              |СГРУППИРОВАТЬ ПО
	                              |	ЛицевыеСчета.ОбъектЛицевогоСчета,
	                              |	ЛицевыеСчета.Наименование,
	                              |	ЛицевыеСчета.Владелец,
	                              |	ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ОтветственныйВладелец,
	                              |	ЛицевыеСчета.ОбъектЛицевогоСчета.ЖилойФонд,
	                              |	ЛицевыеСчета.ОбъектЛицевогоСчета.Подъезд";
	ЗапросПоЛицевомуСчету.УстановитьПараметр("ЛицевойСчет",ТекущийДокумент);
	ВыборкаТаблицаЗначенияПоЛицевомуСчету = ЗапросПоЛицевомуСчету.Выполнить().Выгрузить();

	Макет = ПолучитьМакет("МакетСправкиПрописанных");

	//ШАПКА
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	Для каждого Строка Из ВыборкаТаблицаЗначенияПоЛицевомуСчету Цикл
		
		ОбластьШапка.Параметры.ФИО = ПараметрыПечати.ТекущийЖитель;
		ОбластьШапка.Параметры.Постоянство = "";
		
		Если ТекущийДокумент.Владелец.КонтактнаяИнформация.Количество() > 0 Тогда
			Для каждого СтрокаАдреса Из ТекущийДокумент.Владелец.КонтактнаяИнформация Цикл
				Если СтрокаАдреса.Вид = Справочники.ВидыКонтактнойИнформации.ПочтовыйАдресЗданияИСооружения Тогда
					Адрес = СтрокаАдреса.ЗначенияПолей;
				КонецЕсли;
			КонецЦикла; 
		Иначе
			Адрес = "";
		КонецЕсли;
		
		
		СтруктураАдреса = НайтиРеквизитыАдреса(Адрес);
		Попытка
			ОбластьШапка.Параметры.Улица = СтруктураАдреса.Улица;
			ОбластьШапка.Параметры.НомерДома = СтруктураАдреса.Дом;
			ОбластьШапка.Параметры.Постоянство = СтруктураАдреса.Город;

		Исключение
			Сообщить(НСтр("ru='Не удалось получить адрес здания. Проверьте правильность заполнения адреса.';uk='Не вдалося отримати адресу будівлі. Перевірте правильність заповнення адреси.'"));
		КонецПопытки;
		ОбластьШапка.Параметры.КоличествоКомнат = Строка.ОбъектЛицевогоСчетаКоличествоКомнат;
		ОбластьШапка.Параметры.Квартира = НайтиРеквизитыКвартиры(Строка.ОбъектЛицевогоСчета, 1,"№");
		ОбластьШапка.Параметры.Площадь = НСТР("ru = 'общ. '; uk = 'заг. '" )+ Строка(Строка.Площадь);
		ОбластьШапка.Параметры.ЖилаяПлощадь = Строка(Строка.ЖилаяПлощадь);
		ОбластьШапка.Параметры.Этаж = Строка.ОбъектЛицевогоСчетаЭтаж;
		ОбластьШапка.Параметры.ВсегоЭтажей = Строка.ОбъектЛицевогоСчета.Подъезд.КоличествоЭтажей;               
		ОбластьШапка.Параметры.Домовладелец = Строка.Владелец.Организация;
		ОбластьШапка.Параметры.ВладелецСчета = Строка.ОтветственныйВладелец;
		ОбластьШапка.Параметры.ТехСостояниеДома = "";
		ОбластьШапка.Параметры.ХаратеристикиЖилПлощади = "";
		ОбластьШапка.Параметры.КоличествоПрописанных = Строка.КоличествоПроживающих;
		
	КонецЦикла; 
	ТабличныйДокумент.Вывести(ОбластьШапка);

	//ШАПКАТАБЛИЦЫ
	ОбластьШапкаТаблицы = Макет.ПолучитьОбласть("ШапкаТаблицы");
	ТабличныйДокумент.Вывести(ОбластьШапкаТаблицы);

	ЗапросПроживающиеЖильцы = Новый Запрос;
	ЗапросПроживающиеЖильцы.Текст = "ВЫБРАТЬ
	                                |	ФизическиеЛица.Ссылка КАК ПотребительУслуг,
	                                |	СведенияОПроживающихЖильцахСрезПоследних.Период КАК ДатаПроживания,
	                                |	СведенияОПроживающихЖильцахСрезПоследних.Проживает,
	                                |	СведенияОПрописанныхЖильцахСрезПоследних.Период КАК ДатаПрописки,
	                                |	СведенияОПрописанныхЖильцахСрезПоследних.Прописан,
	                                |	ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ОтветственныйВладелец.ФизЛицо КАК ОтветственныйВладелец,
	                                |	ОтветственныйВладелецЛицевогоСчетаСрезПоследних.Период КАК ДатаВладелец,
	                                |	ВЫБОР
	                                |		КОГДА ЕСТЬNULL(ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ОтветственныйВладелец.ФизЛицо, 0) = 0
	                                |			ТОГДА ЛОЖЬ
	                                |		ИНАЧЕ ИСТИНА
	                                |	КОНЕЦ КАК ВыбранВладелец,
	                                |	ОтветственныйВладелецЛицевогоСчетаСрезПоследних.Регистратор КАК РегистраторВладелец,
	                                |	СведенияОПроживающихЖильцахСрезПоследних.Регистратор КАК РегистраторПроживающих,
	                                |	СведенияОПрописанныхЖильцахСрезПоследних.Регистратор КАК РегистраторПрописанных,
	                                |	СтепеньРодстваФизическихЛицСрезПоследних.СтепеньРодства
	                                |ИЗ
	                                |	Справочник.ФизическиеЛица КАК ФизическиеЛица
	                                |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СведенияОПроживающихЖильцах.СрезПоследних(
	                                |				&Период,
	                                |				Проживает
	                                |					И ЛицевойСчет = &ЛицевойСчет) КАК СведенияОПроживающихЖильцахСрезПоследних
	                                |		ПО ФизическиеЛица.Ссылка = СведенияОПроживающихЖильцахСрезПоследних.Жилец
	                                |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СведенияОПрописанныхЖильцах.СрезПоследних(
	                                |				&Период,
	                                |				Прописан
	                                |					И ЛицевойСчет = &ЛицевойСчет) КАК СведенияОПрописанныхЖильцахСрезПоследних
	                                |		ПО ФизическиеЛица.Ссылка = СведенияОПрописанныхЖильцахСрезПоследних.Жилец
	                                |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОтветственныйВладелецЛицевогоСчета.СрезПоследних(&Период, ЛицевойСчет = &ЛицевойСчет) КАК ОтветственныйВладелецЛицевогоСчетаСрезПоследних
	                                |		ПО ФизическиеЛица.Ссылка = ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ОтветственныйВладелец.ФизЛицо
	                                |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтепеньРодстваФизическихЛиц.СрезПоследних КАК СтепеньРодстваФизическихЛицСрезПоследних
	                                |		ПО ФизическиеЛица.Ссылка = СтепеньРодстваФизическихЛицСрезПоследних.ФизическоеЛицоСвязанное
	                                |ГДЕ
	                                |	(СведенияОПроживающихЖильцахСрезПоследних.Проживает = ИСТИНА
	                                |			ИЛИ ВЫБОР
	                                |				КОГДА ЕСТЬNULL(ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ОтветственныйВладелец.ФизЛицо, 0) = 0
	                                |					ТОГДА ЛОЖЬ
	                                |				ИНАЧЕ ИСТИНА
	                                |			КОНЕЦ)";
	ЗапросПроживающиеЖильцы.УстановитьПараметр("ЛицевойСчет",ТекущийДокумент);
	ЗапросПроживающиеЖильцы.УстановитьПараметр("Период",ТекущаяДата());
	ВыборкаТаблицаЗначенийПоПроживающимЖильцам = ЗапросПроживающиеЖильцы.Выполнить().Выгрузить();

	//ТЕЛОТАБЛИЦЫ
	НомерСтроки = 1;
	ОбластьТелоТаблицы = Макет.ПолучитьОбласть("ТелоТаблицы");
	Для Каждого СтрокаТаблицыЗнач Из ВыборкаТаблицаЗначенийПоПроживающимЖильцам Цикл
		ОбластьТелоТаблицы.Параметры.НомерСтроки = НомерСтроки;
		ОбластьТелоТаблицы.Параметры.ФИО = СтрокаТаблицыЗнач.ПотребительУслуг;
		ОбластьТелоТаблицы.Параметры.РодственныеОтношения = ?(ЗначениеЗаполнено(СтрокаТаблицыЗнач.ОтветственныйВладелец),
																		НСтр("ru = 'Ответственный владелец'; uk = 'Відповідальний власник'"),
																		СтрокаТаблицыЗнач.СтепеньРодства);
		ОбластьТелоТаблицы.Параметры.ГодРождения = СтрокаТаблицыЗнач.ПотребительУслуг.ДатаРождения;
		ОбластьТелоТаблицы.Параметры.ДатаПропискиВДоме = СтрокаТаблицыЗнач.ДатаПрописки;
		ОбластьТелоТаблицы.Параметры.ДатаПропискиВНаселенномПункте = СтрокаТаблицыЗнач.ДатаПрописки;
		ТабличныйДокумент.Вывести(ОбластьТелоТаблицы);
		НомерСтроки = НомерСтроки +1;
	КонецЦикла;
	
	Разница = 9 - НомерСтроки;
	Если Разница > 0 Тогда
		Пока Разница <> 0 Цикл
			ОбластьТелоТаблицы = Макет.ПолучитьОбласть("ТелоТаблицы");
			ТабличныйДокумент.Вывести(ОбластьТелоТаблицы);
			Разница = Разница - 1;
		КонецЦикла;
	КонецЕсли;


	//ШАПКАТАБЛИЦЫ2
	ОбластьШапкаТаблицы2 = Макет.ПолучитьОбласть("ШапкаТаблицы2");
	ТабличныйДокумент.Вывести(ОбластьШапкаТаблицы2);


	//ТЕЛОТАБЛИЦЫ2
	ОбластьТелоТаблицы2 = Макет.ПолучитьОбласть("ТелоТаблицы2");
	Для счет = 1 По 3 Цикл
		ТабличныйДокумент.Вывести(ОбластьТелоТаблицы2);
	КонецЦикла;

	//ПОДВАЛ
	ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
	//ОбластьПодвал.Параметры.Директор = ТекущийДокумент.Владелец.Организация.ТекущийРуководитель;
	//ОбластьПодвал.Параметры.Бухгалтер = ТекущийДокумент.Владелец.Организация.ТекущийГлавныйБухгалтер;
	//ОбластьПодвал.Параметры.Паспортист = ТекущийДокумент.Владелец.Организация.ТекущийПаспортист;
	ТабличныйДокумент.Вывести(ОбластьПодвал);

	Возврат ТабличныйДокумент;
	
КонецФункции // ()
 
Функция ПечатьСправкаОПрописке(ТабличныйДокумент, ПараметрыПечати, ТекущийДокумент)

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	СведенияОПрописанныхЖильцахСрезПоследних.Период КАК ДатаПрописки,
	|	СведенияОПрописанныхЖильцахСрезПоследних.Прописан,
	|	СведенияОПрописанныхЖильцахСрезПоследних.Регистратор КАК РегистраторПрописанных,
	|	СведенияОПрописанныхЖильцахСрезПоследних.Жилец,
	|	ПлощадьОбъектовЛицевыхСчетовСрезПоследних.Площадь,
	|	СведенияОПрописанныхЖильцахСрезПоследних.ЛицевойСчет,
	|	ПлощадьОбъектовЛицевыхСчетовСрезПоследних.Помещение,
	|	СведенияОПрописанныхЖильцахСрезПоследних.ЛицевойСчет.ОбъектЛицевогоСчета,
	|	ЛицевыеСчета.Ссылка
	|ИЗ
	|	Справочник.ЛицевыеСчета КАК ЛицевыеСчета
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПлощадьОбъектовЛицевыхСчетов.СрезПоследних(&Период, ВидПлощади = &ВидПлощади) КАК ПлощадьОбъектовЛицевыхСчетовСрезПоследних
	|		ПО ЛицевыеСчета.ОбъектЛицевогоСчета = ПлощадьОбъектовЛицевыхСчетовСрезПоследних.Помещение
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СведенияОПрописанныхЖильцах.СрезПоследних(&Период, Прописан) КАК СведенияОПрописанныхЖильцахСрезПоследних
	|		ПО ЛицевыеСчета.Ссылка = СведенияОПрописанныхЖильцахСрезПоследних.ЛицевойСчет
	|ГДЕ
	|	ЛицевыеСчета.Ссылка = &ЛицевойСчет";
	Запрос.УстановитьПараметр("ЛицевойСчет",ТекущийДокумент);
	Запрос.УстановитьПараметр("ВидПлощади",Справочники.ВидыПлощадей.ЖилаяПолощадь);
	Запрос.УстановитьПараметр("Период",ТекущаяДата());
	Выборка = Запрос.Выполнить().Выгрузить();			
	Макет = ПолучитьМакет("ПФ_MXL_СправкаОПрописке");
	
	//ШАПКА
	
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьШапка.Параметры.ФИО = ПараметрыПечати.ТекущийЖитель;
	
	Если ТекущийДокумент.Владелец.КонтактнаяИнформация.Количество() > 0 Тогда
		Для каждого СтрокаАдреса Из ТекущийДокумент.Владелец.КонтактнаяИнформация Цикл
			Если СтрокаАдреса.Вид = Справочники.ВидыКонтактнойИнформации.ПочтовыйАдресЗданияИСооружения Тогда
				Адрес = СтрокаАдреса.ЗначенияПолей;
			КонецЕсли;
		КонецЦикла; 
	Иначе
		Адрес = "";
	КонецЕсли;
	
	СтруктураАдреса = НайтиРеквизитыАдреса(Адрес);
	Попытка
		ОбластьШапка.Параметры.Город = СтруктураАдреса.Город;
		ОбластьШапка.Параметры.Улица = СтруктураАдреса.Улица;
		ОбластьШапка.Параметры.Дом = СтруктураАдреса.Дом;
		ОбластьШапка.Параметры.Корпус = СтруктураАдреса.Корпус;
	Исключение
		Сообщить(НСтр("ru='Не удалось получить адрес здания. Проверьте правильность заполнения адреса.';uk='Не вдалося отримати адресу будівлі. Перевірте правильність заповнення адреси.'"));
	КонецПопытки;
	
	ОбластьШапка.Параметры.Квартира = НайтиРеквизитыКвартиры(ТекущийДокумент.ОбъектЛицевогоСчета, 1,"№");
	
	Для Каждого Строка Из Выборка Цикл					
		ОбластьШапка.Параметры.Жилплощадь = Строка.Площадь;				
	КонецЦикла;
	
	ТабличныйДокумент.Вывести(ОбластьШапка);			
	
	//ТАБЛИЦА
	ОбластьШапкаТаблицы = Макет.ПолучитьОбласть("ШапкаТаблицы");
	ТабличныйДокумент.Вывести(ОбластьШапкаТаблицы);
	ОбластьТелоТаблицы = Макет.ПолучитьОбласть("ТелоТаблицы");
	Для Каждого Строка Из Выборка Цикл
		
		ОбластьТелоТаблицы.Параметры.Жилец = Строка.Жилец;
		ТабличныйДокумент.Вывести(ОбластьТелоТаблицы);
		
	КонецЦикла;
	
	//ПОДВАЛ
	ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
	ОбластьПодвал.Параметры.ФИОДиректор = ТекущийДокумент.Владелец.Организация.ТекущийРуководитель;
	ОбластьПодвал.Параметры.ФИОБухгалтер = ТекущийДокумент.Владелец.Организация.ТекущийГлавныйБухгалтер;
	ОбластьПодвал.Параметры.ФИОПаспортист = ТекущийДокумент.Владелец.Организация.ТекущийПаспортист;
	ТабличныйДокумент.Вывести(ОбластьПодвал);
	
	Возврат ТабличныйДокумент;
			
КонецФункции // ()

Функция ПечатьАкт(ТабличныйДокумент, ПараметрыПечати, ТекущийДокумент)

	
	Макет = ПолучитьМакет("Акт");
	ПечататьРезультат = Ложь;
	РеквизитыПокупателяБанк = "";
	РуководительПокупатель = "";
	
	РезультатЗапроса = ПолучитьОбщуюСтруктуруКвитанции(ТекущийДокумент,ПараметрыПечати.ПериодПечати);
	
	
	ВладелецЛС = РегистрыСведений.ОтветственныйВладелецЛицевогоСчета.СрезПоследних(ТекущаяДата(),Новый Структура("ЛицевойСчет",ТекущийДокумент))[0].ОтветственныйВладелец;
	ВладелецЛицевогоСчета = ВладелецЛС.Наименование;
	Организация = ТекущийДокумент.Владелец.Организация;
	БанкОрганизации = Организация.БанковскийСчетПоУмолчанию;
	Отбор = Новый Структура("Организация",Организация);
	СтавкаНДС = РегистрыСведений.СистемыНалогообложенияОрганизаций.ПолучитьПоследнее(ТекущаяДата(),Отбор).СистемаНалогообложения;
	НДС = 0;
	Если  СтавкаНДС = Перечисления.СистемыНалогооблажения.НалогНаПрибыльИНДС Тогда
		НДС = 1.2;    //Временная мера
	КонецЕсли;	

	
	ВыгрузкаБанки = ПараметрыПечати.БанковскийСчетНаПечать.Выгрузить();

	РеквизитыПоставщикаБанк = Организация.НаименованиеПолное + Нстр("ru = ' ЕДРПОУ '; uk = ' ЄДРПОУ '")+Организация.КодПоЕДРПОУ+", тел.:"+?(Организация.КонтактнаяИнформация.Найти(Справочники.ВидыКонтактнойИнформации.ТелефонОрганизации,"Вид") = Неопределено,"",Организация.КонтактнаяИнформация.Найти(Справочники.ВидыКонтактнойИнформации.ТелефонОрганизации,"Вид").Представление);
	Для Каждого Строка из ВыгрузкаБанки Цикл;
		Если Строка.Печать  Тогда			
			БанкРекв = Строка.БанковскийСчет;
			РеквизитыПостав =Символы.ПС+Нстр("ru = ' Р/с '; uk = 'П/р '") +БанкРекв.НомерСчета+", "+
			БанкРекв.Банк.Наименование+" "+
			БанкРекв.Банк.Город+"МФО "+
			БанкРекв.Банк.Код+",";
			РеквизитыПоставщикаБанк = РеквизитыПоставщикаБанк + РеквизитыПостав;
		КонецЕсли;
		
	КонецЦикла;
	РеквизитыПоставщикаБанк = РеквизитыПоставщикаБанк+Символы.ПС+
			?(Организация.КонтактнаяИнформация.Найти(Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации,"Вид") = Неопределено,"",Организация.КонтактнаяИнформация.Найти(Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации,"Вид").Представление);
			
			
	АдресЛС =(ТекущийДокумент.Владелец.Наименование)+", "+ТекущийДокумент.ОбъектЛицевогоСчета.Наименование;
	Должность = "Директор";	
	Если ВладелецЛС.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицо Тогда
		РуководительПокупатель = ВладелецЛС.ЮрЛицо.Руководитель;
		Должность = ?(ЗначениеЗаполнено(ВладелецЛС.ЮрЛицо.ТипДиректора),ВладелецЛС.ЮрЛицо.ТипДиректора+ " директор","Директор");
		Договор = ВладелецЛС.ЮрЛицо.ДоговорПоУмолчанию;
		БанкРекв = ВладелецЛС.ЮрЛицо.БанковскийСчетПоУмолчанию;
		РеквизитыПокуп = ВладелецЛС.ЮрЛицо.Наименование + ?(ЗначениеЗаполнено(ВладелецЛС.ЮрЛицо.КодПоЕДРПОУ),Нстр("ru = ', ЕДРПОУ '; uk = ', ЄДРПОУ '"),"")+ВладелецЛС.ЮрЛицо.КодПоЕДРПОУ+
		?(ЗначениеЗаполнено(ВладелецЛС.ЮрЛицо.ИНН),", ІПН "+ ВладелецЛС.ЮрЛицо.ИНН,"")+
		?(ЗначениеЗаполнено(ВладелецЛС.ЮрЛицо.НомерСвидетельства),", № свід. "+ВладелецЛС.ЮрЛицо.НомерСвидетельства,"")+
		Нстр("ru = ', Р/с '; uk = ', П/р '")+БанкРекв.НомерСчета+", "+
		БанкРекв.Банк.Наименование+
		?(ЗначениеЗаполнено(БанкРекв.Банк.Город),", "+Строка(БанкРекв.Банк.Город),"")+", МФО "+
		БанкРекв.Банк.Код+","+Символы.ПС+
		?(ВладелецЛС.ЮрЛицо.КонтактнаяИнформация.Найти(Справочники.ВидыКонтактнойИнформации.ЮрАдресКонтрагента,"Вид") = Неопределено,"",ВладелецЛС.ЮрЛицо.КонтактнаяИнформация.Найти(Справочники.ВидыКонтактнойИнформации.ЮрАдресКонтрагента,"Вид").Представление+?(ЗначениеЗаполнено(ТекущийДокумент.Телефон),", тел.:",""))+
		//?(ВладелецЛС.ЮрЛицо.КонтактнаяИнформация.Найти(Справочники.ВидыКонтактнойИнформации.ТелефонОрганизации,"Вид") = Неопределено,"",ВладелецЛС.ЮрЛицо.КонтактнаяИнформация.Найти(Справочники.ВидыКонтактнойИнформации.ТелефонОрганизации,"Вид").Представление)+Символы.ПС;
		ТекущийДокумент.Телефон;
		РеквизитыПокупателяБанк = РеквизитыПокупателяБанк + РеквизитыПокуп+ Символы.ПС+Символы.ПС;
		РеквизитыПокуп = СтрЗаменить(РеквизитыПокуп,"дом","буд.");
	КонецЕсли;
		

	
	//ШАПКА
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьШапка.Параметры.ПредставлениеПокупателя = ВладелецЛицевогоСчета;
	ОбластьШапка.Параметры.ПредставлениеПоставщика =  Организация.НаименованиеПолное;
	ОбластьШапка.Параметры.РуководительПоставщика = Организация.ТекущийРуководитель;
	ОбластьШапка.Параметры.ДолжностьРуководителяПоставщика = Организация.ТекущаяДолжностьРуководителя;
	Если РуководительПокупатель <> "" Тогда
		ОбластьШапка.Параметры.ДолжностьРуководителяПокупателя = Должность;
		ОбластьШапка.Параметры.РуководительПокупателя = РуководительПокупатель;
	КонецЕсли;
	
	ТабличныйДокумент.Вывести(ОбластьШапка);
	ТекущийГлавныйБухгалтер =  "гол. бухгалтер " + ПолучитьСокращенноеПредставлениеФИО(Строка(Организация.ТекущийГлавныйБухгалтер));
	//ЗАГОЛОВОК
			//Штрихкод или Номер квитанции
		Штрихкод = ТекущийДокумент.Наименование+"-"+Строка(Формат(НачалоМесяца(ПараметрыПечати.ПериодПечати),"ДФ=ddMMyyyy"));
		ОбластьЗаголовок = Макет.ПолучитьОбласть("Заголовок");
		ШтрихкодированиеПечатныхФорм.ВывестиШтрихкодВТабличныйДокумент(ТабличныйДокумент, Макет, ОбластьЗаголовок, ТекущийДокумент.Ссылка);
		ОбластьЗаголовок.Параметры.ТекстЗаголовка =НСтр("ru = 'Акт оказания услуг №'; uk = 'Акт надання послуг №'")+Штрихкод+ НСтр("ru = ' от '; uk = ' від '")+ Формат(ТекущаяДата(),"ДФ=dd.MM.yyyy");
		ТабличныйДокумент.Вывести(ОбластьЗаголовок);
		                                                                                      
		//ТекстАктаНачало
		ОбластьТекстАктаНачало = Макет.ПолучитьОбласть("ТекстАктаНачало");
		ОбластьТекстАктаНачало.Параметры.ПредставлениеПокупателя = ВладелецЛицевогоСчета;
		ОбластьТекстАктаНачало.Параметры.ПредставлениеПоставщика = Организация.НаименованиеПолное;
		ОбластьТекстАктаНачало.Параметры.ПредставительПоставщика = ТекущийГлавныйБухгалтер;
		ТабличныйДокумент.Вывести(ОбластьТекстАктаНачало);
		
		//ТекстАктаКонец
		ОбластьТекстАктаКонец = Макет.ПолучитьОбласть("ТекстАктаКонец");
		ТабличныйДокумент.Вывести(ОбластьТекстАктаКонец);
		
			
		//ДопИнформация
		ОбластьДопИнформация = Макет.ПолучитьОбласть("ДопИнформация");
		
		//Если ЗначениеЗаполнено(Договор) Тогда
			ОбластьДопИнформация.Параметры.НазваниеПараметра = "Договiр:";
			ОбластьДопИнформация.Параметры.ЗначениеПараметра = ТекущийДокумент.ОбъектЛицевогоСчета.Код;
		//КонецЕсли;
		
		ТабличныйДокумент.Вывести(ОбластьДопИнформация);
		
		//Пробел
		ОбластьПробел = Макет.ПолучитьОбласть("Пробел");
		ТабличныйДокумент.Вывести(ОбластьПробел);
		
		//ШапкаТаблицы
		ОбластьШапкаТаблицы = Макет.ПолучитьОбласть("ШапкаТаблицы");
		ТабличныйДокумент.Вывести(ОбластьШапкаТаблицы);
		
		Долг =0;
		Аванс = 0;
		
		ВыборкаОстатокПоУслугам = РезультатЗапроса[5].Выбрать();
		
		РезультатОстаток = РезультатЗапроса[0].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		РезультатОстаток.Следующий();
		Остаток = РезультатОстаток.СуммаОстаток;
		Если Остаток = Неопределено Тогда
			Остаток = 0;
		КонецЕсли;	
		
		НомерСтроки = 1;
		ДобавитьКАвансу = 0;
		ПредыдущаяУслуга = "";
		РезультатУслуги = РезультатЗапроса[2].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		ИтогоНачислено = 0;
		Пока РезультатУслуги.Следующий() Цикл
			НачислениеИтог = РезультатУслуги.Начисление;
			ЛьготаИтог = РезультатУслуги.Льгота;
			СубсидияИтог = РезультатУслуги.Субсидия;
			ПерерасчетИтог  = РезультатУслуги.Перерасчет;
			КорректировкаИтог = РезультатУслуги.Корректировка;
			ОплатаИтог = РезультатУслуги.Оплата;
			ИтогоНачислено = НачислениеИтог+ ЛьготаИтог+  СубсидияИтог +ПерерасчетИтог + КорректировкаИтог;
			УслугиДетали = РезультатУслуги.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			Если Остаток >= 0 Тогда
				Долг = Остаток;
			Иначе
				Аванс = Остаток;
			КонецЕсли;
			
			Пока УслугиДетали.Следующий() Цикл
				
				ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
				ОбластьСтрока.Параметры.НомерСтроки = НомерСтроки;
				ОбластьСтрока.Параметры.Услуга = УслугиДетали.Услуга.Наименование;
				ВыборкаТариф = УслугиДетали.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				Тариф = "";
				КоличествоЕдИзм = 0;
				Пока ВыборкаТариф.Следующий() Цикл
					Если Тариф = "" Тогда
					    Значение = ?(ВыборкаТариф.Тариф = 0 ,"",Строка(ВыборкаТариф.Тариф)) ;

					Иначе 
						Значение = "\"+Строка(ВыборкаТариф.Тариф);
					КонецЕсли;
					Тариф = Тариф+Значение;
					КоличествоЕдИзм = КоличествоЕдИзм+ ВыборкаТариф.КоличествоЕдИзм;
				КонецЦикла;

				ОбластьСтрока.Параметры.Тариф = Тариф;
				ОбластьСтрока.Параметры.ЕдиницаИзмерения = УслугиДетали.ЕдиницаИзмерения;
				ОбластьСтрока.Параметры.Количество = КоличествоЕдИзм;
				ОбластьСтрока.Параметры.Начислено = УслугиДетали.Начисление;
				ОбластьСтрока.Параметры.Льгота = УслугиДетали.Льгота;
				ОбластьСтрока.Параметры.Субсидии = УслугиДетали.Субсидия;
				ОбластьСтрока.Параметры.Корректировка = УслугиДетали.Корректировка;
				ОбластьСтрока.Параметры.Перерасчет = УслугиДетали.Перерасчет;
				
				Сумма = УслугиДетали.Начисление + УслугиДетали.Льгота+ УслугиДетали.Субсидия +УслугиДетали.Корректировка+УслугиДетали.Перерасчет;
				ОбластьСтрока.Параметры.Сумма = Сумма;
				// Добавление к авансу
				СтруктураПоискаДолгаПоУслуге = Новый Структура("ЛицевойСчет, Услуга");
				СтруктураПоискаДолгаПоУслуге.ЛицевойСчет = УслугиДетали.ЛицевойСчет;
				СтруктураПоискаДолгаПоУслуге.Услуга = УслугиДетали.Услуга;
				
				ВыборкаОстатокПоУслугам.Сбросить();
				Долгпериода = 0;
				Пока ВыборкаОстатокПоУслугам.НайтиСледующий(СтруктураПоискаДолгаПоУслуге) Цикл
					Долгпериода = ВыборкаОстатокПоУслугам.СуммаОстаток;
					Прервать;
				КонецЦикла;
				Если Долгпериода = Неопределено Тогда
					Долгпериода = 0;
				КонецЕсли;
				
				Если Долгпериода < 0  И  ПредыдущаяУслуга <> УслугиДетали.Услуга Тогда
					ПредыдущаяУслуга = УслугиДетали.Услуга;
					Если Сумма >= -Долгпериода  Тогда
						ДобавитьКАвансу = ДобавитьКАвансу + Долгпериода;
					Иначе
						ДобавитьКАвансу = ДобавитьКАвансу - Сумма;
					КонецЕсли;
				КонецЕсли;

				Если Сумма <> 0 Тогда
					ТабличныйДокумент.Вывести(ОбластьСтрока);
				КонецЕсли;	
				НомерСтроки =НомерСтроки+1;
			КонецЦикла;	
		КонецЦикла;
			
		СуммаНДС = 0;		
		//Итого
	Если НДС <> 0 Тогда
			
			ОбластьИтого = Макет.ПолучитьОбласть("ИтогоНДС");
			
			ИтогСуммы = ИтогоНачислено;
			//Мера временная
			ОбластьИтого.Параметры.Начислено = ИтогоНачислено;
			
			СуммаНДС = ИтогоНачислено - ИтогоНачислено/НДС;
			ОбластьИтого.Параметры.СуммаНДС =СуммаНДС;
			
			
			
			ТабличныйДокумент.Вывести(ОбластьИтого);
			
			Если ПечататьРезультат Тогда
				ОбластьИтого = Макет.ПолучитьОбласть("ИтогоНДСРезультат");
				ИтогСуммы = Долг + Аванс + ИтогоНачислено+ ДобавитьКАвансу;
				ОбластьИтого.Параметры.Всего = ИтогСуммы;
				
				ОбластьИтого.Параметры.Аванс = Аванс+ ДобавитьКАвансу;
				
				ОбластьИтого.Параметры.Долг = Долг;
			КонецЕсли;	
		Иначе
			ОбластьИтого = Макет.ПолучитьОбласть("Итого");
			
			ИтогСуммы = ИтогоНачислено;
			ОбластьИтого.Параметры.Начислено = ИтогоНачислено;

			ТабличныйДокумент.Вывести(ОбластьИтого);
			
			Если ПечататьРезультат Тогда
				
				ОбластьИтого = Макет.ПолучитьОбласть("ИтогоРезультат");
				ИтогСуммы = Долг + Аванс + ИтогоНачислено + ДобавитьКАвансу;
				
				ОбластьИтого.Параметры.Всего = ИтогСуммы;
				
				ОбластьИтого.Параметры.Аванс = Аванс+ ДобавитьКАвансу;
				
				ОбластьИтого.Параметры.Долг = Долг;
				
				ТабличныйДокумент.Вывести(ОбластьИтого);
			КонецЕсли;
		КонецЕсли;
		
		
		//СуммаПрописью
		ОбластьСуммаПрописью = Макет.ПолучитьОбласть("СуммаПрописью");
		
		КодЛок = ТекущийКодЛокализации();
		
		ОбластьСуммаПрописью.Параметры.СуммаПрописью = НСтр("ru = 'Всего предоставлено услуг на сумму '; uk = 'Всього надано послуг на суму '")
		+ЧислоПрописью(ИтогоНачислено,НСтр("ru = 'Л= ru_RU; ДП=Истина'; uk = 'Л= uk_UA; ДП=Истина'"), НСтр("ru = 'гривна,гривны,гривен,ж,копейка,копейки,копеек,м,'; uk = 'гривня,гривні,гривень,ж,копійка,копійки,копійок,ж,2'"))
		+","+Символы.ПС+
		?(НДС<>0,Нстр("ru = 'В том числе НДС: '; uk = 'У тому числі ПДВ: '")+ЧислоПрописью(СуммаНДС,НСтр("ru = 'Л= ru_RU; ДП=Истина'; uk = 'Л= uk_UA; ДП=Истина'"), НСтр("ru = 'гривна,гривны,гривен,ж,копейка,копейки,копеек,ж,'; uk = 'гривня,гривні,гривень,ж,копійка,копійки,копійок,ж,2'"))+","+ Символы.ПС,"")+
		Нстр("ru = 'Всего к оплате: '; uk = 'Разом до сплати: '")+ЧислоПрописью(ИтогСуммы,НСтр("ru = 'Л= ru_RU; ДП=Истина'; uk = 'Л= uk_UA; ДП=Истина'"), НСтр("ru = 'гривна,гривны,гривен,ж,копейка,копейки,копеек,ж,'; uk = 'гривня,гривні,гривень,ж,копійка,копійки,копійок,ж,2'"));
			
		ТабличныйДокумент.Вывести(ОбластьСуммаПрописью);

		
		//МестоСоставления
		ОбластьМестоСоставления = Макет.ПолучитьОбласть("МестоСоставления");
		
		Город = "";
		
		Для каждого СтрокаАдреса Из ТекущийДокумент.Владелец.КонтактнаяИнформация Цикл
			Если СтрокаАдреса.Вид = Справочники.ВидыКонтактнойИнформации.ПочтовыйАдресЗданияИСооружения Тогда
				Город = УправлениеКонтактнойИнформацией.ПолучитьЗначениеКонтактнойИнформации(СтрокаАдреса.ЗначенияПолей,"Город");
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		ОбластьМестоСоставления.Параметры.МестоСоставления = Город;
		ТабличныйДокумент.Вывести(ОбластьМестоСоставления);
		
		//Подписи
		ОбластьПодписи = Макет.ПолучитьОбласть("Подписи");
		ОбластьПодписи.Параметры.ПредставительПоставщика = Организация.НаименованиеПолное;
		ОбластьПодписи.Параметры.РеквизитыПоставщика = РеквизитыПоставщикаБанк;
		ОбластьПодписи.Параметры.РеквизитыПокупателя = РеквизитыПокупателяБанк;		
		ОбластьПодписи.Параметры.Дата = ПараметрыПечати.ПериодПечати;
		ОбластьПодписи.Параметры.ПредставительПокупателя = ВладелецЛицевогоСчета;
		ТабличныйДокумент.Вывести(ОбластьПодписи);
	
	
	Возврат ТабличныйДокумент;
			
КонецФункции 
 
Функция ПечатьСчетНаОплату(ТабличныйДокумент, ПараметрыПечати, ТекущийДокумент)

	Макет = ПолучитьМакет("СчетНаОплату");
	ПечататьРезультат = Ложь;
	РезультатЗапроса = ПолучитьОбщуюСтруктуруКвитанции(ТекущийДокумент,ПараметрыПечати.ПериодПечати);
	
	//ЗаголовокСчета
	ВладелецЛС = РегистрыСведений.ОтветственныйВладелецЛицевогоСчета.СрезПоследних(ТекущаяДата(),Новый Структура("ЛицевойСчет",ТекущийДокумент))[0].ОтветственныйВладелец;
	ВладелецЛицевогоСчета = ВладелецЛС.Наименование;

	Организация = ТекущийДокумент.Владелец.Организация;
	БанкОрганизации = Организация.БанковскийСчетПоУмолчанию;
	
	Отбор = Новый Структура("Организация",Организация);
	СтавкаНДС = РегистрыСведений.СистемыНалогообложенияОрганизаций.ПолучитьПоследнее(ТекущаяДата(),Отбор).СистемаНалогообложения;
	НДС = 0;
	Если  СтавкаНДС = Перечисления.СистемыНалогооблажения.НалогНаПрибыльИНДС Тогда
		НДС = 1.2;    //Временная мера
	КонецЕсли;
	
	ОбластьЗаголовокСчета = Макет.ПолучитьОбласть("ЗаголовокСчета");
	ОбластьЗаголовокСчета.Параметры.НазваниеОрганизации = Организация.НаименованиеПолное;
	ОбластьЗаголовокСчета.Параметры.ЕДРПОУОрганизации = Организация.КодПоЕДРПОУ;
	ОбластьЗаголовокСчета.Параметры.БанкОрганизации = ВРег(БанкОрганизации.Банк.Наименование);
	ОбластьЗаголовокСчета.Параметры.МФОБанкаОрганизации = БанкОрганизации.Банк.Код;
	ОбластьЗаголовокСчета.Параметры.НомерРасчетногоСчетаОрганизации = БанкОрганизации.НомерСчета;
	ТабличныйДокумент.Вывести(ОбластьЗаголовокСчета);
		//Штрихкод или Номер квитанции
		Штрихкод = ТекущийДокумент.Наименование+"-"+Строка(Формат(НачалоМесяца(ПараметрыПечати.ПериодПечати),"ДФ=ddMMyyyy"))+НСтр("ru = ' от '; uk = ' від '")+Формат(ТекущаяДата(),"ДФ=dd.MM.yyyy")  ;
		
		//ЗАГОЛОВОК
		ОбластьЗаголовок = Макет.ПолучитьОбласть("Заголовок");
		ШтрихкодированиеПечатныхФорм.ВывестиШтрихкодВТабличныйДокумент(ТабличныйДокумент, Макет, ОбластьЗаголовок, ТекущийДокумент.Ссылка);
		ОбластьЗаголовок.Параметры.ТекстЗаголовка =НСтр("ru = 'Счет на оплату №'; uk = 'Рахунок на сплату №'")+Штрихкод;
		ТабличныйДокумент.Вывести(ОбластьЗаголовок);
		
		//Поставщик

		ВыгрузкаБанки = ПараметрыПечати.БанковскийСчетНаПечать.Выгрузить();

		РеквизитыПоставщикаБанк = "";
		Для Каждого Строка из ВыгрузкаБанки Цикл;
			Если Строка.Печать  Тогда 
				БанкРекв = Строка.БанковскийСчет;
				РеквизитыПостав = НСтр("ru = 'Р/с'; uk = 'П/р'")+БанкРекв.НомерСчета+", "+
				БанкРекв.Банк.Наименование+", "+
				БанкРекв.Банк.Город+", МФО "+
				БанкРекв.Банк.Код+Символы.ПС+
				?(Организация.КонтактнаяИнформация.Найти(Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации,"Вид") = Неопределено,"",Организация.КонтактнаяИнформация.Найти(Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации,"Вид").Представление+", тел.:")+
				?(Организация.КонтактнаяИнформация.Найти(Справочники.ВидыКонтактнойИнформации.ТелефонОрганизации,"Вид") = Неопределено,"",Организация.КонтактнаяИнформация.Найти(Справочники.ВидыКонтактнойИнформации.ТелефонОрганизации,"Вид").Представление)+Символы.ПС+Символы.ПС;
				РеквизитыПоставщикаБанк = РеквизитыПоставщикаБанк + РеквизитыПостав;
			КонецЕсли;
		КонецЦикла;
		
		РеквизитыПокупателяБанк = "";
		Если ВладелецЛС.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицо Тогда
			БанкРекв = ВладелецЛС.ЮрЛицо.БанковскийСчетПоУмолчанию;
			РеквизитыПокуп =  НСтр("ru = 'Р/с'; uk = 'П/р'")+БанкРекв.НомерСчета+", "+
			БанкРекв.Банк.Наименование+", "+
			БанкРекв.Банк.Город+", МФО "+
			БанкРекв.Банк.Код+Символы.ПС+
			?(ВладелецЛС.ЮрЛицо.КонтактнаяИнформация.Найти(Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации,"Вид") = Неопределено,"",ВладелецЛС.ЮрЛицо.КонтактнаяИнформация.Найти(Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации,"Вид").Представление+", тел.:")+
			?(ВладелецЛС.ЮрЛицо.КонтактнаяИнформация.Найти(Справочники.ВидыКонтактнойИнформации.ТелефонОрганизации,"Вид") = Неопределено,"",ВладелецЛС.ЮрЛицо.КонтактнаяИнформация.Найти(Справочники.ВидыКонтактнойИнформации.ТелефонОрганизации,"Вид").Представление)+Символы.ПС+Символы.ПС;
			РеквизитыПокупателяБанк = РеквизитыПокупателяБанк + РеквизитыПокуп;
		КонецЕсли;
				
		ОбластьПоставщик = Макет.ПолучитьОбласть("Поставщик");
		ОбластьПоставщик.Параметры.ПредставлениеПоставщика = Организация.НаименованиеПолное;
		
		ОбластьПоставщик.Параметры.РеквизитыПоставщика = РеквизитыПоставщикаБанк;
				
		ТабличныйДокумент.Вывести(ОбластьПоставщик);
		
		//Покупатель
		ОбластьПокупатель = Макет.ПолучитьОбласть("Покупатель");
		ОбластьПокупатель.Параметры.ПредставлениеПокупателя = РегистрыСведений.ОтветственныйВладелецЛицевогоСчета.СрезПоследних(ТекущаяДата(),Новый Структура("ЛицевойСчет",ТекущийДокумент))[0].ОтветственныйВладелец.Наименование;
		ОбластьПокупатель.Параметры.РеквизитыПокупателя = РеквизитыПокупателяБанк;
		ТабличныйДокумент.Вывести(ОбластьПокупатель);
		
		//ДопИнформация
		ОбластьДопИнформация = Макет.ПолучитьОбласть("ДопИнформация");
		ТабличныйДокумент.Вывести(ОбластьДопИнформация);
				
		//ШапкаТаблицы
		ОбластьШапкаТаблицы = Макет.ПолучитьОбласть("ШапкаТаблицы");
		ТабличныйДокумент.Вывести(ОбластьШапкаТаблицы);
		
		Долг =0;
		Аванс = 0;
		ПредыдущаяУслуга = "";
		ДобавитьКАвансу = 0;
		
		ВыборкаОстатокПоУслугам = РезультатЗапроса[5].Выбрать();

		
		РезультатОстаток = РезультатЗапроса[0].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		РезультатОстаток.Следующий();
		Остаток = РезультатОстаток.СуммаОстаток;
		Если Остаток = Неопределено Тогда
			Остаток = 0;
		КонецЕсли;
			
		
		НомерСтроки = 1;
		РезультатУслуги = РезультатЗапроса[2].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока РезультатУслуги.Следующий() Цикл
			НачислениеИтог = РезультатУслуги.Начисление;
			ЛьготаИтог = РезультатУслуги.Льгота;
			СубсидияИтог = РезультатУслуги.Субсидия;
			ПерерасчетИтог  = РезультатУслуги.Перерасчет;
			КорректировкаИтог = РезультатУслуги.Корректировка;
			ОплатаИтог = РезультатУслуги.Оплата;
			ИтогоНачислено = НачислениеИтог+ ЛьготаИтог+  СубсидияИтог +ПерерасчетИтог + КорректировкаИтог;
			УслугиДетали = РезультатУслуги.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			Если Остаток >= 0 Тогда
				Долг = Остаток;
			Иначе
				Аванс = Остаток;
			КонецЕсли;
			
			Пока УслугиДетали.Следующий() Цикл
				
				ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
				ОбластьСтрока.Параметры.НомерСтроки = НомерСтроки;
				ОбластьСтрока.Параметры.Услуга = УслугиДетали.Услуга;
				ВыборкаТариф = УслугиДетали.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				Тариф = "";
				КоличествоЕдИзм = 0;
				Пока ВыборкаТариф.Следующий() Цикл
					Если Тариф = "" Тогда
					    Значение = ?(ВыборкаТариф.Тариф = 0 ,"",Строка(ВыборкаТариф.Тариф)) ;

					Иначе 
						Значение = "\"+Строка(ВыборкаТариф.Тариф);
					КонецЕсли;
					Тариф = Тариф+Значение;
					КоличествоЕдИзм = КоличествоЕдИзм+ ВыборкаТариф.КоличествоЕдИзм;
				КонецЦикла;

				ОбластьСтрока.Параметры.Тариф = Тариф;
				ОбластьСтрока.Параметры.ЕдиницаИзмерения = УслугиДетали.ЕдиницаИзмерения;
				ОбластьСтрока.Параметры.Количество = КоличествоЕдИзм;
				ОбластьСтрока.Параметры.Начислено = УслугиДетали.Начисление;
				ОбластьСтрока.Параметры.Льготы = УслугиДетали.Льгота;
				ОбластьСтрока.Параметры.Субсидии = УслугиДетали.Субсидия;
				ОбластьСтрока.Параметры.Корректировка = УслугиДетали.Корректировка;
				ОбластьСтрока.Параметры.Перерасчет = УслугиДетали.Перерасчет;
				Сумма = УслугиДетали.Начисление + УслугиДетали.Льгота+ УслугиДетали.Субсидия +УслугиДетали.Корректировка+УслугиДетали.Перерасчет;
				ОбластьСтрока.Параметры.Сумма = Сумма;
				
				// Добавление к авансу
				СтруктураПоискаДолгаПоУслуге = Новый Структура("ЛицевойСчет, Услуга");
				СтруктураПоискаДолгаПоУслуге.ЛицевойСчет = УслугиДетали.ЛицевойСчет;
				СтруктураПоискаДолгаПоУслуге.Услуга = УслугиДетали.Услуга;
				
				ВыборкаОстатокПоУслугам.Сбросить();
				Долгпериода = 0;
				Пока ВыборкаОстатокПоУслугам.НайтиСледующий(СтруктураПоискаДолгаПоУслуге) Цикл
					Долгпериода = ВыборкаОстатокПоУслугам.СуммаОстаток;
					Прервать;
				КонецЦикла;
				Если Долгпериода = Неопределено Тогда
					Долгпериода = 0;
				КонецЕсли;
				
				Если Долгпериода < 0  И  ПредыдущаяУслуга <> УслугиДетали.Услуга Тогда
					ПредыдущаяУслуга = УслугиДетали.Услуга;
					Если Сумма >= -Долгпериода  Тогда
						ДобавитьКАвансу = ДобавитьКАвансу + Долгпериода;
					Иначе
						ДобавитьКАвансу = ДобавитьКАвансу - Сумма;
					КонецЕсли;
				КонецЕсли;
				
				Если Сумма <> 0 Тогда
					ТабличныйДокумент.Вывести(ОбластьСтрока);
				КонецЕсли;	
				НомерСтроки =НомерСтроки+1;
			КонецЦикла;	
		КонецЦикла;
			
			
		
		//Итого
		СуммаНДС = 0;		
		//Итого
		Если НДС <> 0 Тогда
			
			ОбластьИтого = Макет.ПолучитьОбласть("ИтогоНДС");
			
			ИтогСуммы = ИтогоНачислено;
			//Мера временная
			ОбластьИтого.Параметры.Начислено = ИтогоНачислено;
			
			СуммаНДС = ИтогоНачислено - ИтогоНачислено/НДС;
			ОбластьИтого.Параметры.СуммаНДС =СуммаНДС;
			
			
			
			ТабличныйДокумент.Вывести(ОбластьИтого);
			
			Если ПечататьРезультат Тогда
				ОбластьИтого = Макет.ПолучитьОбласть("ИтогоНДСРезультат");
				ИтогСуммы = Долг + Аванс + ИтогоНачислено+ ДобавитьКАвансу;
				ОбластьИтого.Параметры.Всего = ИтогСуммы;
				
				ОбластьИтого.Параметры.Аванс = Аванс+ ДобавитьКАвансу;
				
				ОбластьИтого.Параметры.Долг = Долг;
			КонецЕсли;	
		Иначе
			ОбластьИтого = Макет.ПолучитьОбласть("Итого");
			
			ИтогСуммы = ИтогоНачислено;
			ОбластьИтого.Параметры.Начислено = ИтогоНачислено;

			ТабличныйДокумент.Вывести(ОбластьИтого);
			
			Если ПечататьРезультат Тогда
				
				ОбластьИтого = Макет.ПолучитьОбласть("ИтогоРезультат");
				ИтогСуммы = Долг + Аванс + ИтогоНачислено + ДобавитьКАвансу;
				
				ОбластьИтого.Параметры.Всего = ИтогСуммы;
				
				ОбластьИтого.Параметры.Аванс = Аванс+ ДобавитьКАвансу;
				
				ОбластьИтого.Параметры.Долг = Долг;
				
				ТабличныйДокумент.Вывести(ОбластьИтого);
			КонецЕсли;
		КонецЕсли;

		
		//СуммаПрописью
		ОбластьСуммаПрописью = Макет.ПолучитьОбласть("СуммаПрописью");
		ОбластьСуммаПрописью.Параметры.ИтоговаяСтрока = НСтр("ru='Всего предоставлено услуг ';uk='Всього надано послуг '",)+(НомерСтроки-1) + ", "+
		НСтр("ru=' на сумму ';uk=' на суму '",) + ИтогСуммы+ " грн.";
		
		КодЛок = ТекущийКодЛокализации();
		ОбластьСуммаПрописью.Параметры.СуммаПрописью = ЧислоПрописью(ИтогСуммы,НСтр("ru = 'Л= ru_RU; ДП=Истина'; uk = 'Л= uk_UA; ДП=Истина'"), НСтр("ru = 'гривна,гривны,гривен,ж,копейка,копейки,копеек,ж,'; uk = 'гривня,гривні,гривень,ж,копійка,копійки,копійок,ж,2'"));

		ТабличныйДокумент.Вывести(ОбластьСуммаПрописью);
		
		//Подписи
		ОбластьПодписи = Макет.ПолучитьОбласть("Подписи");
		ТабличныйДокумент.Вывести(ОбластьПодписи);
		
	Возврат ТабличныйДокумент;
			
КонецФункции

Функция ПечатьСправкаОСоставеСемьи(ТабличныйДокумент, ПараметрыПечати, ТекущийДокумент)

	Макет = ПолучитьМакет("ПФ_MXL_СправкаОСоставеСемьиИПрописке");

	//ШАПКА
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ТабличныйДокумент.Вывести(ОбластьШапка);
	
	ОбластьНазначение = Макет.ПолучитьОбласть("Назначение");
	
	ОбластьНазначение.Параметры.ФИО = ПараметрыПечати.ТекущийЖитель;
	
	Если ТекущийДокумент.Владелец.КонтактнаяИнформация.Количество() > 0 Тогда
		Для каждого СтрокаАдреса Из ТекущийДокумент.Владелец.КонтактнаяИнформация Цикл
			Если СтрокаАдреса.Вид = Справочники.ВидыКонтактнойИнформации.ПочтовыйАдресЗданияИСооружения Тогда
				Адрес = СтрокаАдреса.Представление;
			КонецЕсли;
		КонецЦикла; 
	Иначе
		Адрес = "";
	КонецЕсли;
	
	ОбластьНазначение.Параметры.адрес = Адрес;
	
	ТабличныйДокумент.Вывести(ОбластьНазначение);
	
	ОбластьШапкаТаблицы = Макет.ПолучитьОбласть("ШапкаТаблицы");
	ТабличныйДокумент.Вывести(ОбластьШапкаТаблицы);
	
	//ТАБЛИЦА
	ЗапросПроживающиеЖильцы = Новый Запрос;
	ЗапросПроживающиеЖильцы.Текст = "ВЫБРАТЬ
	                                |	ФизическиеЛица.Ссылка КАК ПотребительУслуг,
	                                |	СведенияОПроживающихЖильцахСрезПоследних.Период КАК ДатаПроживания,
	                                |	СведенияОПроживающихЖильцахСрезПоследних.Проживает,
	                                |	СведенияОПрописанныхЖильцахСрезПоследних.Период КАК ДатаПрописки,
	                                |	СведенияОПрописанныхЖильцахСрезПоследних.Прописан,
	                                |	ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ОтветственныйВладелец.ФизЛицо КАК ОтветственныйВладелец,
	                                |	ОтветственныйВладелецЛицевогоСчетаСрезПоследних.Период КАК ДатаВладелец,
	                                |	ВЫБОР
	                                |		КОГДА ЕСТЬNULL(ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ОтветственныйВладелец.ФизЛицо, 0) = 0
	                                |			ТОГДА ЛОЖЬ
	                                |		ИНАЧЕ ИСТИНА
	                                |	КОНЕЦ КАК ВыбранВладелец,
	                                |	ОтветственныйВладелецЛицевогоСчетаСрезПоследних.Регистратор КАК РегистраторВладелец,
	                                |	СведенияОПроживающихЖильцахСрезПоследних.Регистратор КАК РегистраторПроживающих,
	                                |	СведенияОПрописанныхЖильцахСрезПоследних.Регистратор КАК РегистраторПрописанных,
	                                |	СтепеньРодстваФизическихЛицСрезПоследних.СтепеньРодства,
	                                |	ВЫБОР
	                                |		КОГДА ДокументыФизическихЛицСрезПоследних.ВидДокумента = ЗНАЧЕНИЕ(Справочник.ВидыДокументовФизическихЛиц.Паспорт)
	                                |			ТОГДА ДокументыФизическихЛицСрезПоследних.Серия
	                                |	КОНЕЦ КАК СерияПаспорта,
	                                |	ВЫБОР
	                                |		КОГДА ДокументыФизическихЛицСрезПоследних.ВидДокумента = ЗНАЧЕНИЕ(Справочник.ВидыДокументовФизическихЛиц.СвидетельствоОРождении)
	                                |			ТОГДА ДокументыФизическихЛицСрезПоследних.Серия
	                                |	КОНЕЦ КАК СерияСвидетельства,
	                                |	ВЫБОР
	                                |		КОГДА ДокументыФизическихЛицСрезПоследних.ВидДокумента = ЗНАЧЕНИЕ(Справочник.ВидыДокументовФизическихЛиц.Паспорт)
	                                |			ТОГДА ДокументыФизическихЛицСрезПоследних.Номер
	                                |	КОНЕЦ КАК НомерПаспорта,
	                                |	ВЫБОР
	                                |		КОГДА ДокументыФизическихЛицСрезПоследних.ВидДокумента = ЗНАЧЕНИЕ(Справочник.ВидыДокументовФизическихЛиц.СвидетельствоОРождении)
	                                |			ТОГДА ДокументыФизическихЛицСрезПоследних.Номер
	                                |	КОНЕЦ КАК НомерСвидетельства
	                                |ИЗ
	                                |	Справочник.ФизическиеЛица КАК ФизическиеЛица
	                                |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СведенияОПроживающихЖильцах.СрезПоследних(
	                                |				&Период,
	                                |				Проживает
	                                |					И ЛицевойСчет = &ЛицевойСчет) КАК СведенияОПроживающихЖильцахСрезПоследних
	                                |		ПО ФизическиеЛица.Ссылка = СведенияОПроживающихЖильцахСрезПоследних.Жилец
	                                |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СведенияОПрописанныхЖильцах.СрезПоследних(
	                                |				&Период,
	                                |				Прописан
	                                |					И ЛицевойСчет = &ЛицевойСчет) КАК СведенияОПрописанныхЖильцахСрезПоследних
	                                |		ПО ФизическиеЛица.Ссылка = СведенияОПрописанныхЖильцахСрезПоследних.Жилец
	                                |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОтветственныйВладелецЛицевогоСчета.СрезПоследних(&Период, ЛицевойСчет = &ЛицевойСчет) КАК ОтветственныйВладелецЛицевогоСчетаСрезПоследних
	                                |		ПО ФизическиеЛица.Ссылка = ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ОтветственныйВладелец.ФизЛицо
	                                |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтепеньРодстваФизическихЛиц.СрезПоследних КАК СтепеньРодстваФизическихЛицСрезПоследних
	                                |		ПО ФизическиеЛица.Ссылка = СтепеньРодстваФизическихЛицСрезПоследних.ФизическоеЛицоСвязанное
	                                |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДокументыФизическихЛиц.СрезПоследних(&Период, ) КАК ДокументыФизическихЛицСрезПоследних
	                                |		ПО ФизическиеЛица.Ссылка = ДокументыФизическихЛицСрезПоследних.Физлицо
	                                |ГДЕ
	                                |	(СведенияОПроживающихЖильцахСрезПоследних.Проживает = ИСТИНА
	                                |			ИЛИ ВЫБОР
	                                |				КОГДА ЕСТЬNULL(ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ОтветственныйВладелец.ФизЛицо, 0) = 0
	                                |					ТОГДА ЛОЖЬ
	                                |				ИНАЧЕ ИСТИНА
	                                |			КОНЕЦ)
	                                |
	                                |УПОРЯДОЧИТЬ ПО
	                                |	ВыбранВладелец УБЫВ";
	ЗапросПроживающиеЖильцы.УстановитьПараметр("ЛицевойСчет",ТекущийДокумент);
	ЗапросПроживающиеЖильцы.УстановитьПараметр("Период",ТекущаяДата());
	ВыборкаТаблицаЗначенийПоПроживающимЖильцам = ЗапросПроживающиеЖильцы.Выполнить().Выгрузить();
	
	НомерСтроки = 1;
	ОбластьТелоТаблицы = Макет.ПолучитьОбласть("Строка");
	Для Каждого СтрокаТаблицыЗнач Из ВыборкаТаблицаЗначенийПоПроживающимЖильцам Цикл
		ОбластьТелоТаблицы.Параметры.ФИО = СтрокаТаблицыЗнач.ПотребительУслуг;
		ОбластьТелоТаблицы.Параметры.Отношение = ?(СтрокаТаблицыЗнач.ВыбранВладелец,"уповноважений власник (співвласник, наймач)" ,СтрокаТаблицыЗнач.СтепеньРодства);
		ОбластьТелоТаблицы.Параметры.ДатаРождения = СтрокаТаблицыЗнач.ПотребительУслуг.ДатаРождения;
		Если ЗначениеЗаполнено(СтрокаТаблицыЗнач.СерияПаспорта) Тогда
			Документ = СТРОКА(СтрокаТаблицыЗнач.СерияПаспорта)+", "+СТРОКА(СтрокаТаблицыЗнач.НомерПаспорта);
		ИначеЕсли  	ЗначениеЗаполнено(СтрокаТаблицыЗнач.СерияСвидетельства) Тогда
		    Документ = СТРОКА(СтрокаТаблицыЗнач.СерияСвидетельства)+", "+СТРОКА(СтрокаТаблицыЗнач.НомерСвидетельства);
		КонецЕсли;	
		ОбластьТелоТаблицы.Параметры.Документ = Документ;
		
		ТабличныйДокумент.Вывести(ОбластьТелоТаблицы);
		НомерСтроки = НомерСтроки +1;
	КонецЦикла;

		Разница = 11 - НомерСтроки;
	Если Разница > 0 Тогда
		Пока Разница <> 0 Цикл
			ОбластьТелоТаблицы = Макет.ПолучитьОбласть("Строка");
			ТабличныйДокумент.Вывести(ОбластьТелоТаблицы);
			Разница = Разница - 1;
		КонецЦикла;
	КонецЕсли;
	
	//ПОДВАЛ
	ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
	
	ОбластьПодвал.Параметры.ВсегоЖильцов = НомерСтроки-1;
	
	ТекущийРуководитель = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СТРОКА(ТекущийДокумент.Владелец.Организация.ТекущийРуководитель)," ");
	ТекущийПаспортист	= СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СТРОКА(ТекущийДокумент.Владелец.Организация.ТекущийПаспортист)," ");
	
    ОбластьПодвал.Параметры.Начальник = ?(ТекущийРуководитель.Количество() = 3,ТекущийРуководитель[0]+" "+Лев(ТекущийРуководитель[1],1)+". "+Лев(ТекущийРуководитель[2],1)+".",ТекущийДокумент.Владелец.Организация.ТекущийРуководитель);
											
	ОбластьПодвал.Параметры.Паспортист =?(ТекущийПаспортист.Количество() = 3,ТекущийПаспортист[0]+" "+Лев(ТекущийПаспортист[1],1)+". "+Лев(ТекущийПаспортист[2],1)+".",ТекущийДокумент.Владелец.Организация.ТекущийПаспортист);
	
	ОбластьПодвал.Параметры.День = ТекущаяДата();
	ОбластьПодвал.Параметры.Месяц = ТекущаяДата();
	ОбластьПодвал.Параметры.Год = ТекущаяДата();
	
	ТабличныйДокумент.Вывести(ОбластьПодвал);

	
	Возврат ТабличныйДокумент;
	
	
КонецФункции

Функция ПечатьСправкаОРазмереПлатежей(ТабличныйДокумент, ПараметрыПечати, ТекущийДокумент)
	Макет = ПолучитьМакет("ПФ_MXL_СправкаОРазмереПлатежей");
//{{MRG[ <-> ]
//	КодЯзыкаПечать = Локализация.ПолучитьЯзыкФормированияПечатныхФорм();
//	Макет.КодЯзыкаМакета = КодЯзыкаПечать;
//}}MRG[ <-> ]
	МесяцНачало = "";
	Месяцокончание = "";
