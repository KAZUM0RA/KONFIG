// Процедура - обработчик события формы "ПриЗагрузкеДанныхИзНастроекНаСервере".
//
&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	Если Параметры.Отбор.Свойство("Владелец") Тогда
		
		Элементы.ГруппаОтборы.Видимость = Ложь;
		ОСМДСервер.ИзменитьЭлементОтбораСписка(Список, "Здание",	Параметры.Отбор.Владелец,	ЗначениеЗаполнено(Параметры.Отбор.Владелец));
		
	Иначе
	
		ОтборОрганизация	 		        = Настройки.Получить("ОтборОрганизация");
		ОтборЗдание		 			        = Настройки.Получить("ОтборЗдание");
		ОтборЛицевойСчетСпецКомунТранс	    = Настройки.Получить("ОтборЛицевойСчетСпецКомунТранс");
		ОтборОтветственныйВладелец	        = Настройки.Получить("ОтборОтветственныйВладелец");
		ОтборЖилойФонд				        = Настройки.Получить("ОтборЖилойФонд");
		ОтборЛицевыеСчета                   = Настройки.Получить("ОтборЛицевыеСчета");
				
		УстановитьСвязиПараметровВыбора();
		
		ОСМДСервер.ИзменитьЭлементОтбораСписка(Список, "Наименование", ОтборЛицевыеСчета, ЗначениеЗаполнено(ОтборЛицевыеСчета));
		ОСМДСервер.ИзменитьЭлементОтбораСписка(Список, "Здание", ОтборЗдание, ЗначениеЗаполнено(ОтборЗдание));
		ОСМДСервер.ИзменитьЭлементОтбораСписка(Список, "Организация", ОтборОрганизация, ЗначениеЗаполнено(ОтборОрганизация));
		ОСМДСервер.ИзменитьЭлементОтбораСписка(Список, "ЛицевойСчетСпецКомунТранс", ОтборЛицевойСчетСпецКомунТранс, ЗначениеЗаполнено(ОтборЛицевойСчетСпецКомунТранс));
		ОСМДСервер.ИзменитьЭлементОтбораСписка(Список, "ОтветственныйВладелец", ОтборОтветственныйВладелец, ЗначениеЗаполнено(ОтборОтветственныйВладелец));
		ОСМДСервер.ИзменитьЭлементОтбораСписка(Список, "ЖилойФонд", ОтборЖилойФонд, ЗначениеЗаполнено(ОтборЖилойФонд));
		
	КонецЕсли;
	
КонецПроцедуры // ПриЗагрузкеДанныхИзНастроекНаСервере()

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "СозданЛицевойСчет" Тогда
		ОтобразитьИзменениеДанных(Параметр, ВидИзмененияДанных.Добавление);	
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтбор()
	
	ОСМДКлиент.ИзменитьЭлементОтбораСписка(Список, "Организация", ОтборОрганизация, ЗначениеЗаполнено(ОтборОрганизация));
	ОСМДКлиент.ИзменитьЭлементОтбораСписка(Список, "Здание", ОтборЗдание, ЗначениеЗаполнено(ОтборЗдание));
	ОСМДКлиент.ИзменитьЭлементОтбораСписка(Список, "Подъезд", ОтборЛицевойСчетСпецКомунТранс, ЗначениеЗаполнено(ОтборЛицевойСчетСпецКомунТранс));
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборЗданиеПриИзменении(Элемент)
	
	УстановитьСвязиПараметровВыбора();
	УстановитьОтбор();	
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборОрганизацияПриИзменении(Элемент)
	
	УстановитьСвязиПараметровВыбора();
	УстановитьОтбор();	
	
КонецПроцедуры

&НаКлиенте
