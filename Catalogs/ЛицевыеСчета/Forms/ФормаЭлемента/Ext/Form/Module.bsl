	    Элементы.ТаблицаИсторииПоказаний.Обновить();
	Иначе
		ПоказанияПриборовУчетаПриАктивизацииСтрокиНаСервере(Неопределено,Неопределено);
	КонецЕсли;	
КонецПроцедуры

