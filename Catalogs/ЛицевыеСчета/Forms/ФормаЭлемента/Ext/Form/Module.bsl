		//ЛогинДоступа = Прав(Объект.Ссылка.Владелец.Код, 2) + Формат(Объект.Ссылка.Код, "ЧГ=0; ЧЦ=4; ЧВН="); 
		ЛогинДоступа = СокрЛП(Объект.Наименование);
