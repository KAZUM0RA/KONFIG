	СтандартнаяОбработка = Ложь;
	Если Элемент.ТекущиеДанные.Свойство("Регистратор") Тогда
		ОткрытьЗначение(Элемент.ТекущиеДанные.Регистратор);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПаспортныйСтолВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Если Поле.Имя = "ПаспортныйСтолДатаВладелец" Тогда
		
		Если Элемент.ТекущиеДанные.Свойство("РегистраторВладелец") И ЗначениеЗаполнено(Элемент.ТекущиеДанные.РегистраторВладелец) Тогда
			ОткрытьЗначение(Элемент.ТекущиеДанные.РегистраторВладелец);
		КонецЕсли;
		
	ИначеЕсли Поле.Имя = "ПаспортныйСтолДатаНачалаДействия" Тогда
		
		Если Элемент.ТекущиеДанные.Свойство("РегистраторПрописанных") И ЗначениеЗаполнено(Элемент.ТекущиеДанные.РегистраторПрописанных) Тогда
			ОткрытьЗначение(Элемент.ТекущиеДанные.РегистраторПрописанных);
		КонецЕсли;
	ИначеЕсли Поле.Имя = "ПаспортныйСтолДатаОкончанияДействияПрописки" Тогда
		
		Если Элемент.ТекущиеДанные.Свойство("РегистраторПрописанных") И ЗначениеЗаполнено(Элемент.ТекущиеДанные.РегистраторПрописанных) Тогда
			ОткрытьЗначение(Элемент.ТекущиеДанные.РегистраторПрописанных);
		КонецЕсли;
		
	ИначеЕсли Поле.Имя = "ПаспортныйСтолПрописан" Тогда
		
		Если Элемент.ТекущиеДанные.Свойство("РегистраторПрописанных") И ЗначениеЗаполнено(Элемент.ТекущиеДанные.РегистраторПрописанных) Тогда
			ОткрытьЗначение(Элемент.ТекущиеДанные.РегистраторПрописанных);
		КонецЕсли;
		
		
	ИначеЕсли Поле.Имя = "ПаспортныйСтолПроживает" Тогда
		
		Если Элемент.ТекущиеДанные.Свойство("РегистраторПроживающих") И ЗначениеЗаполнено(Элемент.ТекущиеДанные.РегистраторПроживающих) Тогда
			ОткрытьЗначение(Элемент.ТекущиеДанные.РегистраторПроживающих);
		КонецЕсли;
		
	ИначеЕсли Поле.Имя = "ПаспортныйСтолДатаНачалаПроживания" Тогда
		
		Если Элемент.ТекущиеДанные.Свойство("РегистраторПроживающих") И ЗначениеЗаполнено(Элемент.ТекущиеДанные.РегистраторПроживающих) Тогда
			ОткрытьЗначение(Элемент.ТекущиеДанные.РегистраторПроживающих);
		КонецЕсли;
		
	ИначеЕсли Поле.Имя = "ПаспортныйСтолДатаОкончанияПериодаПроживания" Тогда
		
		Если Элемент.ТекущиеДанные.Свойство("РегистраторПроживающих") И ЗначениеЗаполнено(Элемент.ТекущиеДанные.РегистраторПроживающих) Тогда
			ОткрытьЗначение(Элемент.ТекущиеДанные.РегистраторПроживающих);
		КонецЕсли;
		
	ИначеЕсли Поле.Имя = "ПаспортныйСтолДоля" Тогда
		
		Если Элемент.ТекущиеДанные.Свойство("РегистраторСобственников") И ЗначениеЗаполнено(Элемент.ТекущиеДанные.РегистраторСобственников) Тогда
			ОткрытьЗначение(Элемент.ТекущиеДанные.РегистраторСобственников);
		КонецЕсли;
		
	КонецЕсли;
		
КонецПроцедуры

