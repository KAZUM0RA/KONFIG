&НаСервере
Процедура ЗаполнитьРезультатыПроверки()
	РезультатыПроверки.Очистить();
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Возврат;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РП.Период КАК ДатаЗняття,
	|	РП.Фото КАК Фото,
	|	РП.РезультатКонтакта КАК РезультатКонтакта,
	|	РП.Геолокация КАК Геолокация,
	|	РП.Завантажил КАК Завантажил
	|ИЗ
	|	РегистрСведений.РезультатыПроверкиЛицевыхСчетов КАК РП
	|ГДЕ
	|	РП.ЛицевойСчет = &ЛС
	|УПОРЯДОЧИТЬ ПО
	|	ДатаЗняття УБЫВ";
	Запрос.УстановитьПараметр("ЛС", Объект.Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = РезультатыПроверки.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьРезультатыПроверки(Команда)
	ЗаполнитьРезультатыПроверки();
КонецПроцедуры

&НаКлиенте
Процедура ПереглянутиФото(Команда)
	ТекущиеДанные = Элементы.РезультатыПроверки.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Предупреждение(НСтр("ru='Выберите строку.';uk='Виберіть рядок.'"));
		Возврат;
	КонецЕсли;
	Адрес = АдресФотоНаСервере(ТекущиеДанные.ДатаЗняття);
	Если ПустаяСтрока(Адрес) Тогда
		Предупреждение(НСтр("ru='Изображение отсутствует.';uk='Зображення відсутнє.'"));
		Возврат;
	КонецЕсли;
	ИмяФайла = ?(ПустаяСтрока(ТекущиеДанные.Фото), "photo.jpg", ТекущиеДанные.Фото);
	ПолучитьФайл(Адрес, ИмяФайла, Истина);
КонецПроцедуры

&НаСервере
Функция АдресФотоНаСервере(ДатаЗняття)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	РП.Изображение КАК Изображение
	|ИЗ
	|	РегистрСведений.РезультатыПроверкиЛицевыхСчетов КАК РП
	|ГДЕ
	|	РП.ЛицевойСчет = &ЛС
	|	И РП.Период = &П";
	Запрос.УстановитьПараметр("ЛС", Объект.Ссылка);
	Запрос.УстановитьПараметр("П", ДатаЗняття);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Хранилище = Выборка.Изображение;
		Если ТипЗнч(Хранилище) = Тип("ХранилищеЗначения") Тогда
			ДвоичныеДанные = Хранилище.Получить();
			Если ДвоичныеДанные <> Неопределено Тогда
				Возврат ПоместитьВоВременноеХранилище(ДвоичныеДанные, ЭтаФорма.УникальныйИдентификатор);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Возврат "";
КонецФункции
