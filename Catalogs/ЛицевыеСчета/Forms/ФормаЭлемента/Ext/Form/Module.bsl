	НазначенныеДопРеквизиты.Параметры.УстановитьЗначениеПараметра("Период", КонецДня(ТекущаяДата()));
	
	НазначенныеРегиональныеСубсидии.Параметры.УстановитьЗначениеПараметра("ЛицевойСчет", Объект.Ссылка);
	НазначенныеРегиональныеСубсидии.Параметры.УстановитьЗначениеПараметра("Период", ТекущаяДата());
	
