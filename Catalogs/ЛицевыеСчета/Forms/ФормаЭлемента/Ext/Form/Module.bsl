&НаКлиенте
Процедура НазначенныеУслугиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Если Поле.Имя = "НазначенныеУслугиУслуга" или
		Поле.Имя = "НазначенныеУслугиЕдиницаИзмерения" или
		Поле.Имя = "НазначенныеУслугиПериод" Тогда
		
		Если Элемент.ТекущиеДанные.Свойство("Регистратор") Тогда
			ОткрытьЗначение(Элемент.ТекущиеДанные.Регистратор);
		КонецЕсли;
		
	ИначеЕсли Поле.Имя = "НазначенныеУслугиЗначениеТарифа" или
		Поле.Имя = "НазначенныеУслугиНормаПотребления" или
		Поле.Имя = "НазначенныеУслугиЗначениеТарифаПоНорме" или
		Поле.Имя = "НазначенныеУслугиПериодТарифа" Тогда
		
		Если Элемент.ТекущиеДанные.Свойство("РегистраторТарифа") Тогда
			ОткрытьЗначение(Элемент.ТекущиеДанные.РегистраторТарифа);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ИзмененЛицевойСчет" Тогда
		ОтобразитьИзменениеДанных(Параметр, ВидИзмененияДанных.Изменение);	
		Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
			
			СтруктураДанные = Новый Структура();
			СтруктураДанные.Вставить("ЛицевойСчет", Объект.Ссылка);
			
			СтруктураДанные = ОпределитьОтветственногоВладельца(СтруктураДанные);
			
			ОтветственныйВладелец = СтруктураДанные.ОтветственныйВладелец;
			КоличествоПрописанных = СтруктураДанные.КоличествоПрописанных;
			КоличествоПроживающих = СтруктураДанные.КоличествоПроживающих;
			
		КонецЕсли;
		
	КонецЕсли;
	
	// СтандартныеПодсистемы.Свойства
	Если УправлениеСвойствамиКлиент.ОбрабатыватьОповещения(ЭтаФорма, ИмяСобытия, Параметр) Тогда
		ОбновитьЭлементыДополнительныхРеквизитов();
	КонецЕсли;
	// Конец СтандартныеПодсистемы.Свойства
	
КонецПроцедуры

