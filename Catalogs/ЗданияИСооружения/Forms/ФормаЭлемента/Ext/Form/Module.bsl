&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		
		ЗаполнитьПлощадь(Справочники.ЗданияИСооружения.ПустаяСсылка());
		
	Иначе
		
		Элементы.ДатаВводаВЭксплуатацию.Доступность = Ложь;
		Элементы.ДатаНачалаУчета.Доступность = Ложь;
		
		ЗаполнитьПлощадь(Объект.Ссылка);
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.СопроводительныйТекстКвитанции) Тогда
		Объект.СопроводительныйТекстКвитанции = НСтр("ru = 'Прохання сплатити протягом___днів, але не пізніше 20 числа'; uk = 'Просьба оплатить в течение___дней, но не позже 20 числа'");
	КонецЕсли;	
	
	// СтандартныеПодсистемы.КонтактнаяИнформация
	УправлениеКонтактнойИнформацией.ПриСозданииНаСервере(ЭтаФорма, Объект, "ГруппаКонтактнаяИнформация");
	// Конец СтандартныеПодсистемы.КонтактнаяИнформация
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПриСозданииНаСервере(ЭтаФорма, Объект, "СтраницаДополнительныеРеквизиты");
	// Конец СтандартныеПодсистемы.Свойства
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьВариантГород") Тогда
		Элементы.ТипСооружения.СписокВыбора.Добавить(Перечисления.ТипыСооружений.ГруппаЗданий);	
	КонецЕсли;
	
	УстановитьВидимостьИДоступность();
	

	ПриборыУчета.Параметры.УстановитьЗначениеПараметра("ЛицевойСчет", Объект.ЛицевойСчетЗдания);
	ПриборыУчета.Параметры.УстановитьЗначениеПараметра("Период", ТекущаяДата());

КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект)
	
	// СтандартныеПодсистемы.КонтактнаяИнформация
	УправлениеКонтактнойИнформацией.ПередЗаписьюНаСервере(ЭтаФорма, ТекущийОбъект, Отказ);
	// Конец СтандартныеПодсистемы.КонтактнаяИнформация
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПередЗаписьюНаСервере(ЭтаФорма, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
	Локализация.ПередЗаписьюНаСервере(ЭтаФорма, ТекущийОбъект);

КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	НаборВидыПлощадей = РегистрыСведений.ПлощадьЗданий.СоздатьНаборЗаписей();
	
	Для Каждого СтрокаВидыПлощадей Из ВидыПлощадей Цикл
		НаборВидыПлощадей.Отбор.Здание.Установить(ТекущийОбъект.Ссылка);
		НаборВидыПлощадей.Отбор.ВидПлощади.Установить(СтрокаВидыПлощадей.ВидПлощади);
		
		НаборВидыПлощадей.Прочитать();
		
		Если НаборВидыПлощадей.Количество() = 0 Тогда
			
			НоваяПлощадь = НаборВидыПлощадей.Добавить();
			НоваяПлощадь.Здание = ТекущийОбъект.Ссылка;
			НоваяПлощадь.ВидПлощади = СтрокаВидыПлощадей.ВидПлощади;
			
			НоваяПлощадь.Площадь =  СтрокаВидыПлощадей.Площадь;
			НаборВидыПлощадей.Записать();
			
		ИначеЕсли НаборВидыПлощадей.Количество() = 1 Тогда
			НоваяПлощадь = НаборВидыПлощадей[0];	
			Если НоваяПлощадь.Площадь <> СтрокаВидыПлощадей.Площадь Тогда
				НоваяПлощадь.Площадь =  СтрокаВидыПлощадей.Площадь;
				НаборВидыПлощадей.Записать();
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

