&НаКлиенте
Процедура КомандаУказатьНаКарте(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Сообщить("Сначала необходимо сохранить запись");
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура("Партнер, Широта, Долгота, РежимРедактора", Объект.Ссылка, Объект.Широта, Объект.Долгота, "ДляЗаписи"); 
	ОткрытьФорму("ОбщаяФорма.РедакторМеток", ПараметрыФормы, ЭтаФорма, ЭтаФорма.УникальныйИдентификатор);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОпределитьКоординатыПоАдресу(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Сообщить("Сначала необходимо сохранить запись");
		Возврат;
	КонецЕсли;
	
	ТекЗдание = Объект.Ссылка;
	АдресЗдания = РаботаСКартамиСервер.ПолучитьАдресЗдания(ТекЗдание);
	
	Если ПустаяСтрока(АдресЗдания) Тогда
		Сообщить("Для здания не задан адрес в контактной информации, по которому можно определить координаты");
		Возврат;
	КонецЕсли;
	
	Попытка
		СтруктураОтвета = РаботаСКартамиКлиент.ПолучитьКоординатыПоЗапросу(АдресЗдания);
	Исключение
		Сообщить("Невозможно определить координаты для здания " + СокрЛП(ТекЗдание));
	КонецПопытки;
	
	Если Не СтруктураОтвета = Неопределено Тогда 					
		НайденныеКоординаты = СтруктураОтвета.Координаты;
						
		МассивКоординат = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(НайденныеКоординаты, " ");		
			
		Объект.Широта  = МассивКоординат[1]; 
		Объект.Долгота = МассивКоординат[0];
			
		АвтопоискАдрес = СокрЛП(СтруктураОтвета.Область) + ", " + СокрЛП(СтруктураОтвета.НаселенныйПункт) + ", " + СокрЛП(СтруктураОтвета.Улица) + ", " + СокрЛП(СтруктураОтвета.Дом); 
		
		ТекстСообщения = "Адрес по справочнику: " + АдресЗдания + Символы.ПС +
						 "Адрес, для которого определены координаты: " + АвтопоискАдрес;		
		Сообщить(ТекстСообщения);
		
	Иначе
		
		ТекстСообщения = "Координаты по адресу: " + АдресЗдания + Символы.ПС +
						 "не найдены. Возможно ошибка в адресе.";		
		Сообщить(ТекстСообщения);	
		
	КонецЕсли; 	
КонецПроцедуры


&НаКлиенте
Процедура МногоКвартирныйПриИзменении(Элемент)
	Если Объект.МногоКвартирный Тогда
		Элементы.ОСББ.Видимость = Истина;
		Элементы.ЖЕК.Видимость = Истина;
		Элементы.ЧастныйСектор.Видимость = Ложь;
		Объект.ЧастныйСектор = Ложь;
	Иначе
		Элементы.ЧастныйСектор.Видимость = Истина;
		Элементы.ОСББ.Видимость = Ложь;
		Элементы.ЖЕК.Видимость = Ложь;
	КонецЕсли;
КонецПроцедуры


&НаКлиенте
Процедура ЧастныйСекторПриИзменении(Элемент)
	Если Объект.ЧастныйСектор Тогда
		Элементы.МногоКвартирный.Видимость = Ложь;
		Объект.МногоКвартирный = Ложь;
	Иначе
		Элементы.МногоКвартирный.Видимость = Истина;
		Элементы.ОСББ.Видимость = Ложь;
		Элементы.ЖЕК.Видимость = Ложь;
		Объект.ОСББ = Ложь;
		Объект.ЖЕК = Ложь;
	КонецЕсли;
КонецПроцедуры

// РАСЧЕТ ОБЪЕМА ТЕПЛОВОЙ ЕНЕРГИИ

&НаСервере
Функция ПолучитьПлощадьЗдания(Здание)
	Запрос = Новый Запрос;
	Запрос.Текст = 
	    "ВЫБРАТЬ
	    |	ПлощадьЗданий.Площадь
	    |ИЗ
	    |	РегистрСведений.ПлощадьЗданий КАК ПлощадьЗданий
	    |ГДЕ
	    |	ПлощадьЗданий.Здание = &Здание
	    |	И ПлощадьЗданий.ВидПлощади = &ВидПлощади";
	Запрос.УстановитьПараметр("Здание", Здание);
	Запрос.УстановитьПараметр("ВидПлощади", Справочники.ВидыПлощадей.ОтапливаемаяПлощадь);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Площадь = Выборка.Площадь;
	КонецЦикла;
	Возврат Площадь;
КонецФункции

&НаКлиенте
Процедура q0ПриИзменении(Элемент)
	Объект.УдельнаяПотеряТЕ = Объект.q0 * Объект.КубатурныйКоэфиц * Объект.КоєфициентПеречисления; 
КонецПроцедуры

&НаКлиенте
Процедура КубатурныйКоэфицПриИзменении(Элемент)
	Объект.УдельнаяПотеряТЕ = Объект.q0 * Объект.КубатурныйКоэфиц * Объект.КоєфициентПеречисления;
КонецПроцедуры

&НаКлиенте
Процедура КоєфициентПеречисленияПриИзменении(Элемент)
	Объект.УдельнаяПотеряТЕ = Объект.q0 * Объект.КубатурныйКоэфиц * Объект.КоєфициентПеречисления;
КонецПроцедуры

// ЯНВАРЬ
&НаКлиенте
Процедура ТемпСредЯнварьПриИзменении(Элемент)
	ОтапливаемаяПлощадь = ПолучитьПлощадьЗдания(Объект.Ссылка);
	Объект.ТепловаяНагрузкаЯнварь = ((Объект.ВнутренняяТемператураЗдания - Объект.ТемпСредЯнварь) * 24 * ОтапливаемаяПлощадь * Объект.КвоДнейЯнварь * Объект.УдельнаяПотеряТЕ) / 1000000;
КонецПроцедуры

&НаКлиенте
Процедура КвоДнейЯнварьПриИзменении(Элемент)
	ОтапливаемаяПлощадь = ПолучитьПлощадьЗдания(Объект.Ссылка);
	Объект.ТепловаяНагрузкаЯнварь = ((Объект.ВнутренняяТемператураЗдания - Объект.ТемпСредЯнварь) * 24 * ОтапливаемаяПлощадь * Объект.КвоДнейЯнварь * Объект.УдельнаяПотеряТЕ) / 1000000;
КонецПроцедуры

// ФЕВРАЛЬ
&НаКлиенте
Процедура ТемпСредФевральПриИзменении(Элемент)
	ОтапливаемаяПлощадь = ПолучитьПлощадьЗдания(Объект.Ссылка);
	Объект.ТепловаяНагрузкаФевраль = ((Объект.ВнутренняяТемператураЗдания - Объект.ТемпСредФевраль) * 24 * ОтапливаемаяПлощадь * Объект.КвоДнейФевраль * Объект.УдельнаяПотеряТЕ) / 1000000;
КонецПроцедуры

