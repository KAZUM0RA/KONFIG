&НаСервере
Процедура ЗаполнитьПлощадь(Здание)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ВидыПлощадей.Ссылка КАК ВидПлощади,
		|	ПлощадьЗданий.Площадь
		|ИЗ
		|	Справочник.ВидыПлощадей КАК ВидыПлощадей
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПлощадьЗданий КАК ПлощадьЗданий
		|		ПО ВидыПлощадей.Ссылка = ПлощадьЗданий.ВидПлощади
		|			И (ПлощадьЗданий.Здание = &Здание)
		|ГДЕ
		|	ВидыПлощадей.ПометкаУдаления = ЛОЖЬ";
		
	Запрос.УстановитьПараметр("Здание", Здание);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВидыПлощадей.Загрузить(РезультатЗапроса.Выгрузить());
	
КонецПроцедуры	

&НаСервере
Процедура УстановитьВидимостьИДоступность()
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьВариантКоттеджныйПоселок") Тогда 
		
		ЭтаФорма.АвтоЗаголовок = Ложь;
		Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
			ЭтаФорма.Заголовок = НСтр("ru='Коттеджный поселок (создание)';uk='Котеджне селище (створення)'");
		Иначе
			ЭтаФорма.Заголовок = Объект.Наименование + НСтр("ru=' (Коттеджный поселок)';uk=' (Котеджне селище)'");
		КонецЕсли;
		
		Элементы.ТипСооружения.Видимость = Ложь;
		Элементы.КоличествоЛифтов.Видимость = Ложь;
		Элементы.КоличествоПодъездов.Видимость = Ложь;
		Элементы.СтраницаПлощадиЗдания.Видимость = Ложь;
		
	ИначеЕсли ПолучитьФункциональнуюОпцию("ИспользоватьВариантГород") И Объект.ТипСооружения = Перечисления.ТипыСооружений.ГруппаЗданий Тогда
		
		ЭтаФорма.АвтоЗаголовок = Ложь;
		Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
			ЭтаФорма.Заголовок = НСтр("ru='Группа зданий (создание)';uk='Група будівель (створення)'");
		Иначе
			ЭтаФорма.Заголовок = Объект.Наименование + НСтр("ru=' (Группа зданий)';uk=' (Група будівель)'");
		КонецЕсли;
		
		Элементы.ТипСооружения.Видимость = Истина;
		Элементы.КоличествоЛифтов.Видимость = Ложь;
		Элементы.КоличествоПодъездов.Видимость = Ложь;
		Элементы.СтраницаПлощадиЗдания.Видимость = Ложь;
		
	Иначе
		
		ЭтаФорма.АвтоЗаголовок = Истина;
		ЭтаФорма.Заголовок = "";
		
		Элементы.ТипСооружения.Видимость = Истина;
		Элементы.КоличествоЛифтов.Видимость = Истина;
		Элементы.КоличествоПодъездов.Видимость = Истина;
		Элементы.СтраницаПлощадиЗдания.Видимость = Истина;
		
	КонецЕсли;
	
	Если Объект.НаличиеПроектаНаЗБП Тогда
		Элементы.ГруппаДоговорМЗК.Доступность = Истина;
	Иначе
		Элементы.ГруппаДоговорМЗК.Доступность = Ложь;
		Объект.ДлиннаТрубопровода = 0;
		Объект.ПлощадьМЗК         = 0;
	КонецЕсли;
	
КонецПроцедуры // УстановитьВидимостьИДоступность()

