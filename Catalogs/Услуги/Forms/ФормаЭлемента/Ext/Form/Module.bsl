		Элементы.ГруппаРасчтаПоСредней.Видимость = Ложь;
		Элементы.БазаРаспределенияРасчетнойУслуги.Видимость = Ложь;
		Элементы.ПороговыйМетод.Видимость = Ложь;
		Элементы.ВидМашиноМеста.Видимость = Ложь;	
		Элементы.ДополнительныйРеквизит.Видимость = Ложь;
		//Элементы.ПУГарячаяВода.Видимость = Ложь;
		//Элементы.ПУХолоднаяВода.Видимость = Ложь;
		
		Элементы.СоставныеУслуги.Видимость = Ложь;	
		
	ИначеЕсли Объект.СпособНачисления = Перечисления.СпособыНачисленияУслуг.ПоНормамПотребления Тогда
		
		Элементы.ОснованиеНормПотребления.Видимость = Истина;	
		Элементы.ГруппаРасчетаЛьготы.Видимость = Ложь;
		Элементы.ГруппаРасчтаПоСредней.Видимость = Ложь;
		Элементы.БазаРаспределенияРасчетнойУслуги.Видимость = Ложь;
		Элементы.ПороговыйМетод.Видимость = Ложь;
		Элементы.ВидМашиноМеста.Видимость = Ложь;
		//Элементы.ПУГарячаяВода.Видимость = Ложь;
		//Элементы.ПУХолоднаяВода.Видимость = Ложь;
		
		Элементы.СоставныеУслуги.Видимость = Ложь;	
		
		Если Объект.ОснованиеНормПотребления = Перечисления.ОснованияНормПотребления.ОдинЧеловек Тогда
			Элементы.ВидПотребителяУслуг.Видимость = Истина;	
			Элементы.ВидПлощади.Видимость = Ложь;	
			
		ИначеЕсли Объект.ОснованиеНормПотребления = Перечисления.ОснованияНормПотребления.Площадь Тогда
			Элементы.ВидПотребителяУслуг.Видимость = Ложь;	
			Элементы.ВидПлощади.Видимость = Истина;	
			
		ИначеЕсли Объект.ОснованиеНормПотребления = Перечисления.ОснованияНормПотребления.ДополнительныйРеквизит Тогда
			Элементы.ВидПотребителяУслуг.Видимость = Ложь;	
			Элементы.ВидПлощади.Видимость = Ложь;	
			Элементы.ДополнительныйРеквизит.Видимость = Истина;
			
		Иначе
			Элементы.ВидПотребителяУслуг.Видимость = Ложь;	
			Элементы.ВидПлощади.Видимость = Ложь;	
		КонецЕсли;
		
	ИначеЕсли Объект.СпособНачисления = Перечисления.СпособыНачисленияУслуг.ФиксированноеНачисление Тогда
		
		Элементы.ВидПлощади.Видимость = Ложь;	
		Элементы.ВидПотребителяУслуг.Видимость = Ложь;	
		Элементы.ОснованиеНормПотребления.Видимость = Ложь;	
		Элементы.ГруппаРасчетаЛьготы.Видимость = Ложь;
		Элементы.ГруппаРасчтаПоСредней.Видимость = Ложь;
		Элементы.БазаРаспределенияРасчетнойУслуги.Видимость = Ложь;
		Элементы.ПороговыйМетод.Видимость = Ложь;
		Элементы.ВидМашиноМеста.Видимость = Ложь;	
		Элементы.ДополнительныйРеквизит.Видимость = Ложь;
		//Элементы.ПУГарячаяВода.Видимость = Ложь;
		//Элементы.ПУХолоднаяВода.Видимость = Ложь;
		
		Элементы.СоставныеУслуги.Видимость = Ложь;	
		
	ИначеЕсли Объект.СпособНачисления = Перечисления.СпособыНачисленияУслуг.ПоКоличествуМашиноМест Тогда
		
		Элементы.ВидПлощади.Видимость = Ложь;	
		Элементы.ВидПотребителяУслуг.Видимость = Ложь;	
		Элементы.ОснованиеНормПотребления.Видимость = Ложь;	
		Элементы.ГруппаРасчетаЛьготы.Видимость = Ложь;
		Элементы.ГруппаРасчтаПоСредней.Видимость = Ложь;
		Элементы.БазаРаспределенияРасчетнойУслуги.Видимость = Ложь;
		Элементы.ПороговыйМетод.Видимость = Ложь;
		Элементы.ВидМашиноМеста.Видимость = Истина;	
		Элементы.ДополнительныйРеквизит.Видимость = Ложь;
		//Элементы.ПУГарячаяВода.Видимость = Ложь;
		//Элементы.ПУХолоднаяВода.Видимость = Ложь;
		
		Элементы.СоставныеУслуги.Видимость = Ложь;	
		
	ИначеЕсли Объект.СпособНачисления = Перечисления.СпособыНачисленияУслуг.ПоРасчетнымЗначениям Тогда
		
		Элементы.ВидПлощади.Видимость = Ложь;	
		Элементы.ВидПотребителяУслуг.Видимость = Ложь;	
		Элементы.ОснованиеНормПотребления.Видимость = Ложь;	
		Элементы.ГруппаРасчетаЛьготы.Видимость = Истина;
		Элементы.ГруппаРасчтаПоСредней.Видимость = Ложь;
		Элементы.БазаРаспределенияРасчетнойУслуги.Видимость = Истина;
		Элементы.ПороговыйМетод.Видимость = Ложь;
		Элементы.ВидМашиноМеста.Видимость = Ложь;	
		Элементы.ДополнительныйРеквизит.Видимость = Ложь;
		//Элементы.ПУГарячаяВода.Видимость = Ложь;
		//Элементы.ПУХолоднаяВода.Видимость = Ложь;
		
		Элементы.СоставныеУслуги.Видимость = Истина;	
		
	ИначеЕсли Объект.СпособНачисления = Перечисления.СпособыНачисленияУслуг.ПоДополнительнымРеквизитам Тогда
		
		Элементы.ВидПлощади.Видимость = Ложь;	
		Элементы.ВидПотребителяУслуг.Видимость = Ложь;	
		Элементы.ОснованиеНормПотребления.Видимость = Ложь;	
		Элементы.ГруппаРасчетаЛьготы.Видимость = Ложь;
		Элементы.ГруппаРасчтаПоСредней.Видимость = Ложь;
		Элементы.БазаРаспределенияРасчетнойУслуги.Видимость = Ложь;
		Элементы.ПороговыйМетод.Видимость = Ложь;
		Элементы.ВидМашиноМеста.Видимость = Ложь;	
		Элементы.ДополнительныйРеквизит.Видимость = Истина;
		//Элементы.ПУГарячаяВода.Видимость = Ложь;
		//Элементы.ПУХолоднаяВода.Видимость = Ложь;
		
		Элементы.СоставныеУслуги.Видимость = Ложь;	
		
	Иначе
		
		Элементы.ВидПлощади.Видимость = Ложь;	
		Элементы.ВидПотребителяУслуг.Видимость = Ложь;	
		Элементы.ОснованиеНормПотребления.Видимость = Ложь;	
		Элементы.ГруппаРасчетаЛьготы.Видимость = Ложь;	
		Элементы.БазаРаспределенияРасчетнойУслуги.Видимость = Ложь;
		Элементы.ПороговыйМетод.Видимость = Ложь;
		Элементы.ВидМашиноМеста.Видимость = Ложь;	
		Элементы.ДополнительныйРеквизит.Видимость = Ложь;
		//Элементы.ПУГарячаяВода.Видимость = Ложь;
		//Элементы.ПУХолоднаяВода.Видимость = Ложь;
		
		Элементы.СоставныеУслуги.Видимость = Ложь;	
		
	КонецЕсли;
	
	Если Объект.СпособНачисления <> Перечисления.СпособыНачисленияУслуг.ПоПоказаниямПрибораУчета И Объект.ПороговыйМетод Тогда
		
		Объект.ПороговыйМетод = Ложь;
		
	КонецЕсли;
	
	Если Объект.ПороговыйМетод Тогда
		
		Элементы.КоличествоПорогов.Видимость = Истина;
		
	Иначе
		
		Элементы.КоличествоПорогов.Видимость = Ложь;
		
	КонецЕсли;
	
	Если Объект.ВидРасчетаПоСредней = Перечисления.ВидыРасчетаПоСредней.ПоПрошлымМесяцам Тогда
		Элементы.БазаДляРасчетаПоСредней.Видимость = Истина;
		Элементы.ГруппаДатыСезона.Видимость = Ложь;
	ИначеЕсли Объект.ВидРасчетаПоСредней = Перечисления.ВидыРасчетаПоСредней.ЗаПрошлыйСезон Тогда
		Элементы.БазаДляРасчетаПоСредней.Видимость = ложь;
		Элементы.ГруппаДатыСезона.Видимость = Истина;
	Иначе
		Элементы.БазаДляРасчетаПоСредней.Видимость = ложь;
		Элементы.ГруппаДатыСезона.Видимость = ложь;
	КонецЕсли;	
		
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьРасширениеНачисленийЛицевыхСчетов") Тогда
		Элементы.СпособНачисления.СписокВыбора.Добавить(Перечисления.СпособыНачисленияУслуг.ПоДополнительнымРеквизитам);
		Элементы.ОснованиеНормПотребления.СписокВыбора.Добавить(Перечисления.ОснованияНормПотребления.ДополнительныйРеквизит);
	КонецЕсли;
	
	Элементы.Ресурсная.Видимость  = ПолучитьФункциональнуюОпцию("ИспользоватьАвансовыеПлатежи");
	
	Если Объект.ПоВидамТарифа Тогда
		
		Элементы.ВидыТарифов.Видимость = Истина;
		
	Иначе
		
		Элементы.ВидыТарифов.Видимость = Ложь;
		
	КонецЕсли;

	
КонецПроцедуры // УстановитьВидимостьИДоступность()

&НаСервере
Функция КонтрольВыбранногоЗначения(ВыбранноеЗначение)
	
	Если ВыбранноеЗначение = Объект.Ссылка Тогда
	
		Возврат Ложь;	
	
	КонецЕсли; 
	
	ВыборкаСтрок = Объект.СоставныеУслуги.НайтиСтроки(Новый Структура("Услуга", ВыбранноеЗначение));
	
	Если ВыборкаСтрок.Количество() > 0 Тогда
	
		Возврат Ложь;	
	
	КонецЕсли;
	
	Возврат Истина;	
	
КонецФункции

