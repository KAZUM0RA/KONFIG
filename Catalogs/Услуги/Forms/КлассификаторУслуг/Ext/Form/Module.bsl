////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ И ФУНКЦИИ ОБЩЕГО НАЗНАЧЕНИЯ

&НаКлиенте
// Процедура обработки ДеревоКлассификатораВыбранПриИзменении.
//
Процедура ВыбранПриИзменении(ТекущиеДанные)
	
	Если ТекущиеДанные.Выбран = 2 Тогда
		ТекущиеДанные.Выбран = 0;
	КонецЕсли;
	
	ОбходДереваВверх(ТекущиеДанные);
	ОбходДереваВниз(ТекущиеДанные);
	
КонецПроцедуры // ВыбранПриИзменении()

&НаСервере
// Процедура обработки результата подбора.
//
Процедура ОбработатьРезультатыПодбораНаСервере()
	
	МассивВыбранныхСтрок = Новый Массив;
	
	Соответствие = Новый Соответствие;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Услуги.Ссылка,
	|	Услуги.Код
	|ИЗ
	|	Справочник.Услуги КАК Услуги";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Соответствие.Вставить(Выборка.Код, Выборка.Код);
	КонецЦикла;
	
	МассивВыбранныхСтрокУслугаПодробно = Новый Массив;
	
	СоответствиеУслугаПодробно = Новый Соответствие;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УслугиСДПТПодробно.Ссылка,
	|	УслугиСДПТПодробно.Код
	|ИЗ
	|	Справочник.УслугиСДПТПодробно КАК УслугиСДПТПодробно";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СоответствиеУслугаПодробно.Вставить(Выборка.Код, Выборка.Код);
	КонецЦикла;
	
	
	Дерево = РеквизитФормыВЗначение("ДеревоКлассификатораУслуг");
	Для каждого СтрокаУровень1 Из Дерево.Строки Цикл
		Если СтрокаУровень1.Выбран > 0 Тогда
			
			Если Соответствие.Получить(СтрокаУровень1.Код) = Неопределено Тогда
				МассивВыбранныхСтрок.Добавить(СтрокаУровень1);
			КонецЕсли;
			
			Для каждого СтрокаУровень2 Из СтрокаУровень1.Строки Цикл
				Если СтрокаУровень2.Выбран > 0 Тогда
					Если Соответствие.Получить(СтрокаУровень2.Код) = Неопределено Тогда
						МассивВыбранныхСтрок.Добавить(СтрокаУровень2);
					КонецЕсли;
				КонецЕсли;
				
				Для каждого СтрокаУровень3 Из СтрокаУровень2.Строки Цикл
					Если СтрокаУровень3.Выбран > 0 Тогда
						Если СоответствиеУслугаПодробно.Получить(СтрокаУровень3.Код) = Неопределено Тогда
							МассивВыбранныхСтрокУслугаПодробно.Добавить(СтрокаУровень3);
						КонецЕсли;
					КонецЕсли;
				 КонецЦикла;
				
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	НачатьТранзакцию();
	
	Для каждого СтрокаДерева Из МассивВыбранныхСтрок Цикл
		Если СтрокаДерева.ЭтоГруппа Тогда
			
			СправочникОбъект = Справочники.Услуги.СоздатьГруппу();
			
			СправочникОбъект.Код = СтрокаДерева.Код;
			СправочникОбъект.Наименование = СтрокаДерева.Наименование;
			СправочникОбъект.ПолноеНаименование = СтрокаДерева.ПолноеНаименование;
			
		Иначе
			
			СправочникОбъект = Справочники.Услуги.СоздатьЭлемент();
			
			СправочникОбъект.Код = СтрокаДерева.Код;
			СправочникОбъект.Наименование = СтрокаДерева.Наименование;
			СправочникОбъект.ПолноеНаименование = СтрокаДерева.ПолноеНаименование;
						
			СправочникОбъект.ВидПотребителяУслуг = СтрокаДерева.ВидПотребителяУслуг;
			Если ЗначениеЗаполнено(СтрокаДерева.ИмяВидПлощади) Тогда 
				СправочникОбъект.ВидПлощади = Справочники.ВидыПлощадей[СтрокаДерева.ИмяВидПлощади];
			КонецЕсли;
			СправочникОбъект.СпособНачисления = СтрокаДерева.СпособНачисления;	
			СправочникОбъект.ОснованиеНормПотребления = СтрокаДерева.ОснованиеНормПотребления;	
			Если ЗначениеЗаполнено(СтрокаДерева.ИмяВидУслуги) Тогда 
				СправочникОбъект.ВидУслуги = Справочники.ВидыУслуг[СтрокаДерева.ИмяВидУслуги];	
			КонецЕсли;
			Если ЗначениеЗаполнено(СтрокаДерева.ЕдиницаИзмеренияКод) Тогда
				ТекЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду(СокрЛП(СтрокаДерева.ЕдиницаИзмеренияКод));
				Если ТекЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.ПустаяСсылка() Тогда
					ТекЕдиницаИзмеренияОбъект = Справочники.КлассификаторЕдиницИзмерения.СоздатьЭлемент();
					ТекЕдиницаИзмеренияОбъект.Код = СокрЛП(СтрокаДерева.ЕдиницаИзмеренияКод);
					ТекЕдиницаИзмеренияОбъект.Наименование = СокрЛП(СтрокаДерева.ЕдиницаИзмерения);
					ТекЕдиницаИзмеренияОбъект.Записать();
					ТекЕдиницаИзмерения	= ТекЕдиницаИзмеренияОбъект.Ссылка;					
				КонецЕсли; 
				СправочникОбъект.ЕдиницаИзмерения = ТекЕдиницаИзмерения;	
			КонецЕсли;
			Если ЗначениеЗаполнено(СтрокаДерева.РодительКод) Тогда
				ТекРодитель = Справочники.Услуги.НайтиПоКоду(СокрЛП(СтрокаДерева.РодительКод));
				СправочникОбъект.Родитель = ТекРодитель;	
			КонецЕсли;
		КонецЕсли;
		
		СправочникОбъект.Записать();
	
	КонецЦикла;
	
	
	Для каждого СтрокаДерева Из МассивВыбранныхСтрокУслугаПодробно Цикл
		
		Если Справочники.УслугиСДПТПодробно.НайтиПоКоду(СокрЛП(СтрокаДерева.Код)) = Справочники.УслугиСДПТПодробно.ПустаяСсылка() Тогда
			
			СправочникОбъект = Справочники.УслугиСДПТПодробно.СоздатьЭлемент();
			
			СправочникОбъект.Код = СокрЛП(СтрокаДерева.Код);
			СправочникОбъект.Наименование = СтрокаДерева.Наименование;
			СправочникОбъект.ПолноеНаименование = СтрокаДерева.ПолноеНаименование;
			
			СправочникОбъект.Записать();
			
		КонецЕсли;
	КонецЦикла;
	
	ЗафиксироватьТранзакцию();
	
	
КонецПроцедуры // ОбработатьРезультатыПодбораНаСервере()

&НаКлиенте
// Процедура обхода дерева классификатора вверх.
//
Процедура ОбходДереваВверх(ТекущиеДанные)

	Родитель = ТекущиеДанные.ПолучитьРодителя();
	Если Родитель <> Неопределено Тогда // Верхний уровень
		
		ДочерниеСтроки = Родитель.ПолучитьЭлементы();
		КоличествоВыбранных = 0;
		ОбщееКоличество = 0;
		Для каждого Элемент Из ДочерниеСтроки Цикл
			Если Элемент.Выбран = 2 Тогда
				КоличествоВыбранных = КоличествоВыбранных + 0.5;
			ИначеЕсли Элемент.Выбран = 1 Тогда
				КоличествоВыбранных = КоличествоВыбранных + 1;
			КонецЕсли;
			ОбщееКоличество = ОбщееКоличество + 1;
		КонецЦикла;
		
		Если ОбщееКоличество = КоличествоВыбранных Тогда
			Родитель.Выбран = 1;
		ИначеЕсли КоличествоВыбранных = 0 Тогда
			Родитель.Выбран = 0;
		Иначе
			Родитель.Выбран = 2;
		КонецЕсли;
		
		ОбходДереваВверх(Родитель);
		
	КонецЕсли;
	
КонецПроцедуры // ОбходДереваВверх()

&НаКлиенте
// Процедура обхода дерева классификатора вниз.
//
Процедура ОбходДереваВниз(ТекущиеДанные)
	
	ДочерниеСтроки = ТекущиеДанные.ПолучитьЭлементы();
	Для каждого Элемент Из ДочерниеСтроки Цикл
		Элемент.Выбран = ТекущиеДанные.Выбран;
		ОбходДереваВниз(Элемент);
	КонецЦикла;
	
КонецПроцедуры // ОбходДереваВниз()



