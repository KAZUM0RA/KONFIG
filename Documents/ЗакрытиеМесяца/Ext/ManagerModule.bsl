// Формує статуси реструктуризації (Просрочен/Действует) за результатом план-факт на дату закриття.
Процедура СформироватьТаблицуСтатусовРеструктуризации(ДокументСсылка, СтруктураДополнительныеСвойства)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Состояние.ЛицевойСчет КАК ЛицевойСчет,
		|	Состояние.Договор КАК Договор,
		|	Состояние.ДатаНачала КАК ДатаНачала,
		|	Состояние.ДатаОкончания КАК ДатаОкончания,
		|	ЕСТЬNULL(ПланТаб.СуммаПлан, 0) КАК План,
		|	ЕСТЬNULL(ФактТаб.СуммаРасход, 0) КАК Факт
		|ИЗ
		|	РегистрСведений.СостояниеРеструктуризацииДолга.СрезПоследних(
		|			&Дата,
		|			Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыРеструктуризации.Действует)
		|				И ЛицевойСчет.Владелец = &Здание) КАК Состояние
		|		ЛЕВОЕ СОЕДИНЕНИЕ (
		|			ВЫБРАТЬ
		|				Платежи.ЛицевойСчет КАК ЛицевойСчет,
		|				СУММА(Платежи.СуммаПлатежа) КАК СуммаПлан
		|			ИЗ
		|				РегистрСведений.ПлатежиПоРеструктуризацииДолга КАК Платежи
		|			ГДЕ
		|				Платежи.Период <= КОНЕЦПЕРИОДА(&Дата, МЕСЯЦ)
		|			СГРУППИРОВАТЬ ПО
		|				Платежи.ЛицевойСчет) КАК ПланТаб
		|		ПО Состояние.ЛицевойСчет = ПланТаб.ЛицевойСчет
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.РасчетыПоЛицевымСчетам.Обороты(
		|				, КОНЕЦПЕРИОДА(&Дата, МЕСЯЦ), ,
		|				Услуга = ЗНАЧЕНИЕ(Справочник.Услуги.РеструктуризацияДолга)) КАК ФактТаб
		|		ПО Состояние.ЛицевойСчет = ФактТаб.ЛицевойСчет";
	Запрос.УстановитьПараметр("Дата", КонецДня(ДокументСсылка.Дата));
	Запрос.УстановитьПараметр("Здание", ДокументСсылка.Здание);

	Выборка = Запрос.Выполнить().Выгрузить();

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Период");
	Таблица.Колонки.Добавить("ЛицевойСчет");
	Таблица.Колонки.Добавить("Статус");
	Таблица.Колонки.Добавить("Договор");
	Таблица.Колонки.Добавить("ДатаНачала");
	Таблица.Колонки.Добавить("ДатаОкончания");

	Для Каждого Стр Из Выборка Цикл
		НоваяСтрока = Таблица.Добавить();
		НоваяСтрока.Период        = ДокументСсылка.Дата;
		НоваяСтрока.ЛицевойСчет   = Стр.ЛицевойСчет;
		НоваяСтрока.Договор       = Стр.Договор;
		НоваяСтрока.ДатаНачала    = Стр.ДатаНачала;
		НоваяСтрока.ДатаОкончания = Стр.ДатаОкончания;
		НоваяСтрока.Статус        = ?(Стр.Факт + 0.01 < Стр.План,
			Перечисления.СтатусыРеструктуризации.Просрочен,
			Перечисления.СтатусыРеструктуризации.Действует);
	КонецЦикла;

	СтруктураДополнительныеСвойства.ТаблицыДляДвижений.Вставить("ТаблицаСостояниеРеструктуризации", Таблица);

КонецПроцедуры

Процедура СформироватьНачислениеДляБухгалтерии(ДокументСсылкаЗакрытиеЛицевогоСчета) Экспорт
	
	УчетКоммунальныхУслуг.СформироватьНачислениеПодомовойУчет(ДокументСсылкаЗакрытиеЛицевогоСчета);
	
	ДатаДокумента = ДокументСсылкаЗакрытиеЛицевогоСчета.Дата - 10;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ОбменУчетВОСМДБухгалтерия.Ссылка,
	|	ОбменУчетВОСМДБухгалтерия.ДатаНачалаВыгрузкиДокументов
	|ИЗ
	|	ПланОбмена.ОбменУчетВОСМДБухгалтерия КАК ОбменУчетВОСМДБухгалтерия
	|ГДЕ
	|	ОбменУчетВОСМДБухгалтерия.ПометкаУдаления = ЛОЖЬ
	|	И ОбменУчетВОСМДБухгалтерия.ДатаНачалаВыгрузкиДокументов <= &ДатаНач
	|	И ОбменУчетВОСМДБухгалтерия.Ссылка <> &ЭтотУзел
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ОбменУчетВОСМДБухгалтерия20.Ссылка,
	|	ОбменУчетВОСМДБухгалтерия20.ДатаНачалаВыгрузкиДокументов
	|ИЗ
	|	ПланОбмена.ОбменУчетВОСМДБухгалтерия20 КАК ОбменУчетВОСМДБухгалтерия20
	|ГДЕ
	|	ОбменУчетВОСМДБухгалтерия20.ПометкаУдаления = ЛОЖЬ
	|	И ОбменУчетВОСМДБухгалтерия20.ДатаНачалаВыгрузкиДокументов <= &ДатаНач
	|	И ОбменУчетВОСМДБухгалтерия20.Ссылка <> &ЭтотУзел20";
	
	Запрос.УстановитьПараметр("ДатаНач", ДатаДокумента);
	Запрос.УстановитьПараметр("ЭтотУзел", ПланыОбмена.ОбменУчетВОСМДБухгалтерия.ЭтотУзел());
	Запрос.УстановитьПараметр("ЭтотУзел20", ПланыОбмена.ОбменУчетВОСМДБухгалтерия20.ЭтотУзел());
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли; 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РасчетыПоЛицевымСчетам.Организация КАК Организация,
		|	РасчетыПоЛицевымСчетам.ЛицевойСчет КАК ЛицевойСчет,
		|	РасчетыПоЛицевымСчетам.ЛицевойСчет.Владелец КАК Здание,
		|	РасчетыПоЛицевымСчетам.Услуга.ВидУслуги КАК ВидУслуги,
		|	РасчетыПоЛицевымСчетам.Сумма КАК Сумма,
		|	ЕСТЬNULL(ВложенныйЗапрос.Ссылка, ЗНАЧЕНИЕ(Документ.НачислениеДляБухгалтерии.ПустаяСсылка)) КАК Ссылка,
		|	РасчетыПоЛицевымСчетам.ЛицевойСчет.Наименование КАК ЛицевойСчетНаименование,
		|	РасчетыПоЛицевымСчетам.ВидНачисления
		|ИЗ
		|	РегистрНакопления.РасчетыПоЛицевымСчетам КАК РасчетыПоЛицевымСчетам
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			МАКСИМУМ(НачислениеДляБухгалтерии.Ссылка) КАК Ссылка,
		|			НачислениеДляБухгалтерии.Организация КАК Организация,
		|			НачислениеДляБухгалтерии.ЛицевойСчет КАК ЛицевойСчет,
		|			НачислениеДляБухгалтерии.Здание КАК Здание
		|		ИЗ
		|			Документ.НачислениеДляБухгалтерии КАК НачислениеДляБухгалтерии
		|		ГДЕ
		|			НачислениеДляБухгалтерии.Дата >= &ДатаНач
		|			И НачислениеДляБухгалтерии.Дата <= &ДатаКон
		|			И НачислениеДляБухгалтерии.Организация = &Организация
		|			И НачислениеДляБухгалтерии.Здание = &Здание
		|		
		|		СГРУППИРОВАТЬ ПО
		|			НачислениеДляБухгалтерии.Организация,
		|			НачислениеДляБухгалтерии.ЛицевойСчет,
		|			НачислениеДляБухгалтерии.Здание) КАК ВложенныйЗапрос
		|		ПО РасчетыПоЛицевымСчетам.Организация = ВложенныйЗапрос.Организация
		|			И РасчетыПоЛицевымСчетам.ЛицевойСчет.Владелец = ВложенныйЗапрос.Здание
		|			И РасчетыПоЛицевымСчетам.ЛицевойСчет = ВложенныйЗапрос.ЛицевойСчет
		|ГДЕ
		|	(РасчетыПоЛицевымСчетам.ВидНачисления = ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Начисление)
		|			ИЛИ РасчетыПоЛицевымСчетам.ВидНачисления = ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.РазовоеНачисление)
		|			ИЛИ РасчетыПоЛицевымСчетам.ВидНачисления = ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Перерасчет)
		|			ИЛИ РасчетыПоЛицевымСчетам.ВидНачисления = ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Пени))
		|	И РасчетыПоЛицевымСчетам.Организация = &Организация
		|	И РасчетыПоЛицевымСчетам.ЛицевойСчет.Владелец = &Здание
		|	И РасчетыПоЛицевымСчетам.Период >= &ДатаНач
		|	И РасчетыПоЛицевымСчетам.Период <= &ДатаКон
		|
		|УПОРЯДОЧИТЬ ПО
		|	Организация,
		|	Здание,
		|	ЛицевойСчетНаименование,
		|	ВидУслуги
		|ИТОГИ
		|	СУММА(Сумма)
		|ПО
		|	Организация,
		|	Здание,
		|	ЛицевойСчет,
		|	Ссылка,
		|	ВидУслуги";
		
	Запрос.УстановитьПараметр("ДатаНач", НачалоМесяца(ДатаДокумента));
	Запрос.УстановитьПараметр("ДатаКон", КонецМесяца(ДатаДокумента));
	Запрос.УстановитьПараметр("Организация", ДокументСсылкаЗакрытиеЛицевогоСчета.Организация);
	Запрос.УстановитьПараметр("Здание", ДокументСсылкаЗакрытиеЛицевогоСчета.Здание);
	
	ВыборкаОрганизация = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаОрганизация.Следующий() Цикл
    	ВыборкаЗдание = ВыборкаОрганизация.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаЗдание.Следующий() Цикл
	    	ВыборкаЛицевойСчет = ВыборкаЗдание.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаЛицевойСчет.Следующий() Цикл
		    	ВыборкаСсылка = ВыборкаЛицевойСчет.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				Если ВыборкаСсылка.Следующий() Тогда
					Если ВыборкаСсылка.Ссылка = Документы.НачислениеДляБухгалтерии.ПустаяСсылка() Тогда
						ДокументОбъект = Документы.НачислениеДляБухгалтерии.СоздатьДокумент();
