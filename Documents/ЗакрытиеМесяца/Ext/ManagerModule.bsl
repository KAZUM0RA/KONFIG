Процедура УдалитьНачислениеДляБухгалтерии(ДокументСсылкаЗакрытиеЛицевогоСчета) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	НачислениеДляБухгалтерии.Ссылка
		|ИЗ
		|	Документ.НачислениеДляБухгалтерии КАК НачислениеДляБухгалтерии
		|ГДЕ
		|	НачислениеДляБухгалтерии.Дата >= &ДатаНач
		|	И НачислениеДляБухгалтерии.Дата <= &ДатаКон
		|	И НачислениеДляБухгалтерии.Организация = &Организация
		|	И НачислениеДляБухгалтерии.Здание = &Здание";
		
	Запрос.УстановитьПараметр("ДатаНач", НачалоМесяца(ДокументСсылкаЗакрытиеЛицевогоСчета.Дата));
	Запрос.УстановитьПараметр("ДатаКон", КонецМесяца(ДокументСсылкаЗакрытиеЛицевогоСчета.Дата));
	Запрос.УстановитьПараметр("Организация", ДокументСсылкаЗакрытиеЛицевогоСчета.Организация);
	Запрос.УстановитьПараметр("Здание", ДокументСсылкаЗакрытиеЛицевогоСчета.Здание);
	
	ВыборкаДокументов = Запрос.Выполнить().Выбрать();
	
	Пока ВыборкаДокументов.Следующий() Цикл
		ДокументОбъект = ВыборкаДокументов.Ссылка.ПолучитьОбъект();
		ДокументОбъект.УстановитьПометкуУдаления(Истина);
	КонецЦикла;
	
	УчетКоммунальныхУслуг.УдалитьНачислениеПодомовойУчет(ДокументСсылкаЗакрытиеЛицевогоСчета);
	
КонецПроцедуры


Процедура СформироватьЛьготыСубсидииДляБухгалтерии(ДокументСсылкаЗакрытиеЛицевогоСчета) Экспорт
	
	УчетКоммунальныхУслуг.СформироватьЛьготыСубсидииПодомовойУчет(ДокументСсылкаЗакрытиеЛицевогоСчета);
	
	ДатаДокумента = ДокументСсылкаЗакрытиеЛицевогоСчета.Дата - 10;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ОбменУчетВОСМДБухгалтерия.Ссылка,
	|	ОбменУчетВОСМДБухгалтерия.ДатаНачалаВыгрузкиДокументов
	|ИЗ
	|	ПланОбмена.ОбменУчетВОСМДБухгалтерия КАК ОбменУчетВОСМДБухгалтерия
	|ГДЕ
	|	ОбменУчетВОСМДБухгалтерия.ПометкаУдаления = ЛОЖЬ
	|	И ОбменУчетВОСМДБухгалтерия.ДатаНачалаВыгрузкиДокументов <= &ДатаНач
	|	И ОбменУчетВОСМДБухгалтерия.Ссылка <> &ЭтотУзел
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ОбменУчетВОСМДБухгалтерия20.Ссылка,
	|	ОбменУчетВОСМДБухгалтерия20.ДатаНачалаВыгрузкиДокументов
	|ИЗ
	|	ПланОбмена.ОбменУчетВОСМДБухгалтерия20 КАК ОбменУчетВОСМДБухгалтерия20
	|ГДЕ
	|	ОбменУчетВОСМДБухгалтерия20.ПометкаУдаления = ЛОЖЬ
	|	И ОбменУчетВОСМДБухгалтерия20.ДатаНачалаВыгрузкиДокументов <= &ДатаНач
	|	И ОбменУчетВОСМДБухгалтерия20.Ссылка <> &ЭтотУзел20";

	
	Запрос.УстановитьПараметр("ДатаНач", ДатаДокумента);
	Запрос.УстановитьПараметр("ЭтотУзел", ПланыОбмена.ОбменУчетВОСМДБухгалтерия.ЭтотУзел());
	Запрос.УстановитьПараметр("ЭтотУзел20", ПланыОбмена.ОбменУчетВОСМДБухгалтерия20.ЭтотУзел());

	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли; 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РасчетыПоЛицевымСчетам.Организация КАК Организация,
		|	РасчетыПоЛицевымСчетам.ЛицевойСчет КАК ЛицевойСчет,
		|	РасчетыПоЛицевымСчетам.ЛицевойСчет.Владелец КАК Здание,
		|	-РасчетыПоЛицевымСчетам.Сумма КАК Сумма,
		|	ВЫБОР
		|		КОГДА РасчетыПоЛицевымСчетам.ВидНачисления = ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Субсидия)
		|			ТОГДА ОрганизацииТабличнаяКонтрагентовДляСубсидийИЛьгот.КонтрагентСубсидия
		|		КОГДА РасчетыПоЛицевымСчетам.ВидНачисления = ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.РегиональнаяСубсидия)
		|			ТОГДА ОрганизацииТабличнаяКонтрагентовДляСубсидийИЛьгот.КонтрагентРегиональнаяСубсидия
		|		ИНАЧЕ ОрганизацииТабличнаяКонтрагентовДляСубсидийИЛьгот.КонтрагентЛьгота
		|	КОНЕЦ КАК Контрагент,
		|	ВЫБОР
		|		КОГДА РасчетыПоЛицевымСчетам.ВидНачисления = ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Субсидия)
		|			ТОГДА ОрганизацииТабличнаяКонтрагентовДляСубсидийИЛьгот.ДоговорСубсидия
		|		КОГДА РасчетыПоЛицевымСчетам.ВидНачисления = ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.РегиональнаяСубсидия)
		|			ТОГДА ОрганизацииТабличнаяКонтрагентовДляСубсидийИЛьгот.ДоговорРегиональнаяСубсидия
		|		ИНАЧЕ ОрганизацииТабличнаяКонтрагентовДляСубсидийИЛьгот.ДоговорЛьгота
		|	КОНЕЦ КАК ДоговорКонтрагента,
		|	ЕСТЬNULL(ВложенныйЗапрос.Ссылка, ЗНАЧЕНИЕ(Документ.ЛьготыСубсидииДляБухгалтерии.ПустаяСсылка)) КАК Ссылка,
		|	РасчетыПоЛицевымСчетам.ЛицевойСчет.Наименование КАК ЛицевойСчетНаименование
		|ИЗ
		|	РегистрНакопления.РасчетыПоЛицевымСчетам КАК РасчетыПоЛицевымСчетам
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ЛьготыСубсидииДляБухгалтерии.Ссылка КАК Ссылка,
		|			ЛьготыСубсидииДляБухгалтерии.Организация КАК Организация,
		|			ЛьготыСубсидииДляБухгалтерии.Здание КАК Здание,
		|			ЛьготыСубсидииДляБухгалтерии.ЛицевойСчет КАК ЛицевойСчет,
		|			ЛьготыСубсидииДляБухгалтерии.Контрагент КАК Контрагент
		|		ИЗ
		|			Документ.ЛьготыСубсидииДляБухгалтерии КАК ЛьготыСубсидииДляБухгалтерии
		|		ГДЕ
		|			ЛьготыСубсидииДляБухгалтерии.Дата >= &ДатаНач
		|			И ЛьготыСубсидииДляБухгалтерии.Дата <= &ДатаКон
		|			И ЛьготыСубсидииДляБухгалтерии.Организация = &Организация
		|			И ЛьготыСубсидииДляБухгалтерии.Здание = &Здание) КАК ВложенныйЗапрос
		|		ПО РасчетыПоЛицевымСчетам.Организация = ВложенныйЗапрос.Организация
		|			И РасчетыПоЛицевымСчетам.ЛицевойСчет.Владелец = ВложенныйЗапрос.Здание
		|			И РасчетыПоЛицевымСчетам.ЛицевойСчет = ВложенныйЗапрос.ЛицевойСчет
		|			И (ВЫБОР
		|				КОГДА РасчетыПоЛицевымСчетам.ВидНачисления = ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Субсидия)
		|					ТОГДА РасчетыПоЛицевымСчетам.Услуга.ВидУслуги.КонтрагентДляРасчетаПоСубсидиям = ВложенныйЗапрос.Контрагент
		|				ИНАЧЕ РасчетыПоЛицевымСчетам.Услуга.ВидУслуги.КонтрагентДляРасчетаПоЛьготам = ВложенныйЗапрос.Контрагент
		|			КОНЕЦ)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации.ТабличнаяКонтрагентовДляСубсидийИЛьгот КАК ОрганизацииТабличнаяКонтрагентовДляСубсидийИЛьгот
		|		ПО РасчетыПоЛицевымСчетам.Организация = ОрганизацииТабличнаяКонтрагентовДляСубсидийИЛьгот.Ссылка
		|			И РасчетыПоЛицевымСчетам.Услуга.ВидУслуги = ОрганизацииТабличнаяКонтрагентовДляСубсидийИЛьгот.ВидУслуги
		|ГДЕ
		|	(РасчетыПоЛицевымСчетам.ВидНачисления = ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Льгота)
		|			ИЛИ РасчетыПоЛицевымСчетам.ВидНачисления = ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Субсидия)
		|			ИЛИ РасчетыПоЛицевымСчетам.ВидНачисления = ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.РегиональнаяСубсидия))
		|	И РасчетыПоЛицевымСчетам.Организация = &Организация
		|	И РасчетыПоЛицевымСчетам.ЛицевойСчет.Владелец = &Здание
		|	И РасчетыПоЛицевымСчетам.Период >= &ДатаНач
		|	И РасчетыПоЛицевымСчетам.Период <= &ДатаКон
		|
		|УПОРЯДОЧИТЬ ПО
		|	Организация,
		|	Здание,
		|	ЛицевойСчетНаименование
		|ИТОГИ
		|	СУММА(Сумма)
		|ПО
		|	Организация,
		|	Здание,
		|	ЛицевойСчет,
		|	Контрагент,
		|	Ссылка,
		|	ДоговорКонтрагента";
		
	Запрос.УстановитьПараметр("ДатаНач", НачалоМесяца(ДатаДокумента));
	Запрос.УстановитьПараметр("ДатаКон", КонецМесяца(ДатаДокумента));
	Запрос.УстановитьПараметр("Организация", ДокументСсылкаЗакрытиеЛицевогоСчета.Организация);
	Запрос.УстановитьПараметр("Здание", ДокументСсылкаЗакрытиеЛицевогоСчета.Здание);
	
	ВыборкаОрганизация = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаОрганизация.Следующий() Цикл
    	ВыборкаЗдание = ВыборкаОрганизация.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаЗдание.Следующий() Цикл
	    	ВыборкаЛицевойСчет = ВыборкаЗдание.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаЛицевойСчет.Следующий() Цикл
		    	ВыборкаКонтрагент = ВыборкаЛицевойСчет.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				Пока ВыборкаКонтрагент.Следующий() Цикл
			    	ВыборкаСсылка = ВыборкаКонтрагент.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
					Если ВыборкаСсылка.Следующий() Тогда
						Если ВыборкаСсылка.Ссылка = Документы.ЛьготыСубсидииДляБухгалтерии.ПустаяСсылка() Тогда
							ДокументОбъект = Документы.ЛьготыСубсидииДляБухгалтерии.СоздатьДокумент();
						Иначе	
							ДокументОбъект = ВыборкаСсылка.Ссылка.ПолучитьОбъект();
							Если ДокументОбъект.ПометкаУдаления Тогда
								ДокументОбъект.УстановитьПометкуУдаления(Ложь);
							КонецЕсли; 
						КонецЕсли; 
						
						ДокументОбъект.Дата = ДатаДокумента;
						ДокументОбъект.Организация = ВыборкаСсылка.Организация;
						ДокументОбъект.Здание = ВыборкаСсылка.Здание;
						ДокументОбъект.ЛицевойСчет = ВыборкаСсылка.ЛицевойСчет;
						ДокументОбъект.Контрагент = ВыборкаСсылка.Контрагент;
						ДокументОбъект.СуммыДолга.Очистить();
						
				    	ВыборкаДоговор = ВыборкаСсылка.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
						Пока ВыборкаДоговор.Следующий() Цикл
				        	НоваяСтрока = ДокументОбъект.СуммыДолга.Добавить();
					        НоваяСтрока.ДоговорКонтрагента = ВыборкаДоговор.ДоговорКонтрагента;
					        Если  ВыборкаДоговор.Сумма < 0 тогда
								НоваяСтрока.Сумма = -ВыборкаДоговор.Сумма;
								НоваяСтрока.ВидЗадолженности = Перечисления.ВидЗадолженностиДляБухгалтерии.Дебеторская;
								НоваяСтрока.ТипКонтрагента = Перечисления.СтатусыКонтрагентовДляБухгалтерии.Покупатель;
							Иначе
								НоваяСтрока.Сумма = ВыборкаДоговор.Сумма;
								НоваяСтрока.ВидЗадолженности = Перечисления.ВидЗадолженностиДляБухгалтерии.Кредиторская;
								НоваяСтрока.ТипКонтрагента = Перечисления.СтатусыКонтрагентовДляБухгалтерии.Покупатель;
							КонецЕсли;
						КонецЦикла;
						
						ДокументОбъект.Записать();
						
					КонецЕсли;	
				КонецЦикла;
			КонецЦикла;
		КонецЦикла; 
	КонецЦикла;
	
КонецПроцедуры

Процедура УдалитьЛьготыСубсидииДляБухгалтерии(ДокументСсылкаЗакрытиеЛицевогоСчета) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛьготыСубсидииДляБухгалтерии.Ссылка
		|ИЗ
		|	Документ.ЛьготыСубсидииДляБухгалтерии КАК ЛьготыСубсидииДляБухгалтерии
		|ГДЕ
		|	ЛьготыСубсидииДляБухгалтерии.Дата >= &ДатаНач
		|	И ЛьготыСубсидииДляБухгалтерии.Дата <= &ДатаКон
		|	И ЛьготыСубсидииДляБухгалтерии.Организация = &Организация
		|	И ЛьготыСубсидииДляБухгалтерии.Здание = &Здание";
		
	Запрос.УстановитьПараметр("ДатаНач", НачалоМесяца(ДокументСсылкаЗакрытиеЛицевогоСчета.Дата));
	Запрос.УстановитьПараметр("ДатаКон", КонецМесяца(ДокументСсылкаЗакрытиеЛицевогоСчета.Дата));
	Запрос.УстановитьПараметр("Организация", ДокументСсылкаЗакрытиеЛицевогоСчета.Организация);
	Запрос.УстановитьПараметр("Здание", ДокументСсылкаЗакрытиеЛицевогоСчета.Здание);
	
	ВыборкаДокументов = Запрос.Выполнить().Выбрать();
	
	Пока ВыборкаДокументов.Следующий() Цикл
		ДокументОбъект = ВыборкаДокументов.Ссылка.ПолучитьОбъект();
		ДокументОбъект.УстановитьПометкуУдаления(Истина);
	КонецЦикла;
	
	УчетКоммунальныхУслуг.УдалитьЛьготыСубсидииПодомовойУчет(ДокументСсылкаЗакрытиеЛицевогоСчета);
	
КонецПроцедуры

Процедура ПровестиСубсидии(ДокументСсылкаЗакрытиеЛицевогоСчета) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РасчетыПоСубсидиям.Организация,
		|	РасчетыПоСубсидиям.ЛицевойСчет,
		|	РасчетыПоСубсидиям.МесяцНачисления,
		|	РасчетыПоСубсидиям.Услуга,
		|	РасчетыПоСубсидиям.ГраницаСубсидии
		|ПОМЕСТИТЬ НачисленныеСубс
		|ИЗ
		|	РегистрНакопления.РасчетыПоСубсидиям КАК РасчетыПоСубсидиям
		|ГДЕ
		|	РасчетыПоСубсидиям.Период МЕЖДУ НАЧАЛОПЕРИОДА(&Дата, МЕСЯЦ) И КОНЕЦПЕРИОДА(&Дата, МЕСЯЦ)
		|	И РасчетыПоСубсидиям.Организация = &Организация
		|	И РасчетыПоСубсидиям.ЛицевойСчет.Владелец = &Здание
		|
		|СГРУППИРОВАТЬ ПО
		|	РасчетыПоСубсидиям.Организация,
		|	РасчетыПоСубсидиям.ЛицевойСчет,
		|	РасчетыПоСубсидиям.Услуга,
		|	РасчетыПоСубсидиям.МесяцНачисления,
		|	РасчетыПоСубсидиям.ГраницаСубсидии
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	РасчетыПоСубсидиямОстатки.Организация,
		|	РасчетыПоСубсидиямОстатки.ЛицевойСчет,
		|	РасчетыПоСубсидиямОстатки.Услуга,
		|	РасчетыПоСубсидиямОстатки.МесяцНачисления КАК МесяцНачисления,
		|	СУММА(РасчетыПоСубсидиямОстатки.СуммаОстаток) КАК СуммаОстаток,
		|	РасчетыПоСубсидиямОстатки.Услуга.ПолеСортировки КАК УслугаПолеСортировки,
		|	РасчетыПоСубсидиямОстатки.Услуга.ВидУслуги.ПолеСортировки КАК УслугаВидУслугиПолеСортировки,
		|	ЕСТЬNULL(НачисленныеСубс.ГраницаСубсидии, 0) КАК ГраницаСубсидии
		|ИЗ
		|	РегистрНакопления.РасчетыПоСубсидиям.Остатки(
		|			&Период,
		|			Организация = &Организация
		|				И ЛицевойСчет.Владелец = &Здание
		|				И НАЧАЛОПЕРИОДА(МесяцНачисления, ДЕНЬ) < НАЧАЛОПЕРИОДА(&Дата, ДЕНЬ)) КАК РасчетыПоСубсидиямОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ НачисленныеСубс КАК НачисленныеСубс
		|		ПО РасчетыПоСубсидиямОстатки.Организация = НачисленныеСубс.Организация
		|			И РасчетыПоСубсидиямОстатки.ЛицевойСчет = НачисленныеСубс.ЛицевойСчет
		|			И РасчетыПоСубсидиямОстатки.Услуга = НачисленныеСубс.Услуга
		|			И РасчетыПоСубсидиямОстатки.МесяцНачисления = НачисленныеСубс.МесяцНачисления
		|
		|СГРУППИРОВАТЬ ПО
		|	РасчетыПоСубсидиямОстатки.ЛицевойСчет,
		|	РасчетыПоСубсидиямОстатки.МесяцНачисления,
		|	РасчетыПоСубсидиямОстатки.Услуга,
		|	РасчетыПоСубсидиямОстатки.Услуга.ВидУслуги.ПолеСортировки,
		|	РасчетыПоСубсидиямОстатки.Услуга.ПолеСортировки,
		|	РасчетыПоСубсидиямОстатки.Организация,
		|	ЕСТЬNULL(НачисленныеСубс.ГраницаСубсидии, 0)
		|
		|УПОРЯДОЧИТЬ ПО
		|	МесяцНачисления,
		|	УслугаВидУслугиПолеСортировки,
		|	УслугаПолеСортировки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РасчетыПоЛицевымСчетамОстатки.Организация,
		|	РасчетыПоЛицевымСчетамОстатки.ЛицевойСчет,
		|	РасчетыПоЛицевымСчетамОстатки.Услуга,
		|	РасчетыПоЛицевымСчетамОстатки.МесяцНачисления,
		|	СУММА(РасчетыПоЛицевымСчетамОстатки.СуммаОстаток) КАК СуммаОстаток
		|ИЗ
		|	РегистрНакопления.РасчетыПоЛицевымСчетам.Остатки(
		|			&Период,
		|			НАЧАЛОПЕРИОДА(МесяцНачисления, МЕСЯЦ) = НАЧАЛОПЕРИОДА(&ДАТА, МЕСЯЦ)
		|				И Организация = &Организация
		|				И ЛицевойСчет.Владелец = &Здание) КАК РасчетыПоЛицевымСчетамОстатки
		|
		|СГРУППИРОВАТЬ ПО
		|	РасчетыПоЛицевымСчетамОстатки.МесяцНачисления,
		|	РасчетыПоЛицевымСчетамОстатки.Организация,
		|	РасчетыПоЛицевымСчетамОстатки.Услуга,
		|	РасчетыПоЛицевымСчетамОстатки.ЛицевойСчет";
		
		
	Запрос.УстановитьПараметр("Период", Новый Граница(ДокументСсылкаЗакрытиеЛицевогоСчета.Дата, ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Организация", ДокументСсылкаЗакрытиеЛицевогоСчета.Организация);
	Запрос.УстановитьПараметр("Здание", ДокументСсылкаЗакрытиеЛицевогоСчета.Здание);
	Запрос.УстановитьПараметр("Дата", ДокументСсылкаЗакрытиеЛицевогоСчета.Дата);

	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ТаблицаСубсидии =  РезультатЗапроса[1].Выгрузить();
	ТаблицаДолгов =  РезультатЗапроса[2].Выгрузить();
	
	
	ТаблицаРасчетыПоЛицевымСчетам = Новый ТаблицаЗначений;
	ТаблицаРасчетыПоЛицевымСчетам.Колонки.Добавить("ВидДвижения");
	ТаблицаРасчетыПоЛицевымСчетам.Колонки.Добавить("Период");
	ТаблицаРасчетыПоЛицевымСчетам.Колонки.Добавить("Организация");
	ТаблицаРасчетыПоЛицевымСчетам.Колонки.Добавить("ЛицевойСчет");
	ТаблицаРасчетыПоЛицевымСчетам.Колонки.Добавить("Услуга");
	ТаблицаРасчетыПоЛицевымСчетам.Колонки.Добавить("МесяцНачисления");
	//ТаблицаРасчетыПоЛицевымСчетам.Колонки.Добавить("ВидНачсиления");
	ТаблицаРасчетыПоЛицевымСчетам.Колонки.Добавить("Сумма");
	
	
	ТаблицаРасчетыПоСубсидиям = Новый ТаблицаЗначений;
	ТаблицаРасчетыПоСубсидиям.Колонки.Добавить("ВидДвижения");
	ТаблицаРасчетыПоСубсидиям.Колонки.Добавить("Период");
	ТаблицаРасчетыПоСубсидиям.Колонки.Добавить("Организация");
	ТаблицаРасчетыПоСубсидиям.Колонки.Добавить("ЛицевойСчет");
	ТаблицаРасчетыПоСубсидиям.Колонки.Добавить("Услуга");
	ТаблицаРасчетыПоСубсидиям.Колонки.Добавить("МесяцНачисления");
	ТаблицаРасчетыПоСубсидиям.Колонки.Добавить("Сумма");
	
	
	Для Каждого СтрокаТаблицаСубсидииУслуги Из ТаблицаСубсидии Цикл	
		СуммаОсталосьРаспределить = СтрокаТаблицаСубсидииУслуги.СуммаОстаток;
		
		ВыборкаДолги = ТаблицаДолгов.НайтиСтроки(Новый Структура("ЛицевойСчет, Услуга, МесяцНачисления", СтрокаТаблицаСубсидииУслуги.ЛицевойСчет, СтрокаТаблицаСубсидииУслуги.Услуга,НАЧАЛОМЕСЯЦА(ДокументСсылкаЗакрытиеЛицевогоСчета.Дата)));
		
		Для каждого СтрокаВыборки Из ВыборкаДолги Цикл
			
			СуммаНачсиления = СтрокаВыборки.СуммаОстаток - СтрокаТаблицаСубсидииУслуги.ГраницаСубсидии;
			
			Если СуммаНачсиления <= 0 тогда
				Продолжить;
			КонецЕсли;
			
			
			
			Если СуммаНачсиления <= СтрокаТаблицаСубсидииУслуги.ГраницаСубсидии Тогда
				Продолжить;
			КонецЕсли;
			
			
			Если СуммаНачсиления <= СуммаОсталосьРаспределить  Тогда // сумма остатка меньше или равна чем осталось распределить
				
				Сумма = СуммаНачсиления;
				СуммаОсталосьРаспределить = СуммаОсталосьРаспределить - СуммаНачсиления;
				
			Иначе // сумма остатка больше чем нужно распределить
				
				Сумма =	СуммаОсталосьРаспределить;
				СуммаОсталосьРаспределить = 0;
				
			КонецЕсли;
			
			НоваяСтрока = ТаблицаРасчетыПоЛицевымСчетам.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаВыборки); 
			НоваяСтрока.ВидДвижения = ВидДвиженияНакопления.Расход;
			НоваяСтрока.Период = ДокументСсылкаЗакрытиеЛицевогоСчета.Дата;
			НоваяСтрока.Сумма = Сумма;
			
			НоваяСтрока = ТаблицаРасчетыПоСубсидиям.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаВыборки); 
			НоваяСтрока.ВидДвижения = ВидДвиженияНакопления.Расход;
			НоваяСтрока.МесяцНачисления = СтрокаТаблицаСубсидииУслуги.МесяцНачисления;
			НоваяСтрока.Период = ДокументСсылкаЗакрытиеЛицевогоСчета.Дата;
			НоваяСтрока.Сумма = Сумма;
			
			СтрокаВыборки.СуммаОстаток = СтрокаВыборки.СуммаОстаток - Сумма;
			
			Если СуммаОсталосьРаспределить = 0 Тогда
				Прервать; 
			КонецЕсли; 
		
		КонецЦикла; 
		
	КонецЦикла;	
	
	//Движения
	
	Если ТаблицаРасчетыПоЛицевымСчетам.Количество() > 0 Тогда
		
		НаборРасчеты = РегистрыНакопления.РасчетыПоЛицевымСчетам.СоздатьНаборЗаписей();
		НаборРасчеты.Отбор.Регистратор.Установить(ДокументСсылкаЗакрытиеЛицевогоСчета);
		НаборРасчеты.Прочитать();
		
		Для каждого Строка Из ТаблицаРасчетыПоЛицевымСчетам Цикл
			
			НоваяЗапись = НаборРасчеты.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяЗапись,Строка);
			
			
		КонецЦикла; 
		
		
		НаборСубсидии = РегистрыНакопления.РасчетыПоСубсидиям.СоздатьНаборЗаписей();
		НаборСубсидии.Отбор.Регистратор.Установить(ДокументСсылкаЗакрытиеЛицевогоСчета);
		НаборСубсидии.Прочитать();
		
		Для каждого Строка Из ТаблицаРасчетыПоСубсидиям Цикл
			
			НоваяЗапись = НаборСубсидии.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяЗапись,Строка);
			
			
		КонецЦикла;
		
		НаборРасчеты.Записать();
		НаборСубсидии.Записать();
	КонецЕсли;

	
	
КонецПроцедуры