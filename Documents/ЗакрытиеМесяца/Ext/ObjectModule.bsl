// ПРОЦЕДУРЫ И ФУНКЦИИ ОБЩЕГО НАЗНАЧЕНИЯ

// Процедура - отключает даты запрета изменения объекта.
//
Процедура ОтключитьДатыЗапретаИзменения(Отказ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДатыЗапретаИзменения.ДатаЗапрета
		|ИЗ
		|	РегистрСведений.ДатыЗапретаИзменения КАК ДатыЗапретаИзменения
		|ГДЕ
		|	ДатыЗапретаИзменения.Объект = &Здание
		|	И ДатыЗапретаИзменения.Раздел = &Раздел";
		
	Запрос.УстановитьПараметр("Здание", Здание);
	Запрос.УстановитьПараметр("Раздел", ПланыВидовХарактеристик.РазделыДатЗапретаИзменения.Здания);
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Следующий() Тогда
	
		Если РезультатЗапроса.ДатаЗапрета > КонецМесяца(Дата) Тогда
			Отказ = Истина;
			НСтрока = НСтр("ru='Открытие месяца запрещено';uk='Відкриття мiсяця заборонене'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтрока,, ,, Отказ);
		Иначе
			
			НаборЗаписей = РегистрыСведений.ДатыЗапретаИзменения.СоздатьНаборЗаписей();
			
			НаборЗаписей.Отбор.Пользователь.Установить(Перечисления.ВидыНазначенияДатЗапрета.ДляВсехПользователей);
			НаборЗаписей.Отбор.Раздел.Установить(ПланыВидовХарактеристик.РазделыДатЗапретаИзменения.Здания);
			НаборЗаписей.Отбор.Объект.Установить(Здание);
			
			НаборЗаписей.Прочитать();
			Если НаборЗаписей.Количество() = 0 Тогда
				НоваяСтрока = НаборЗаписей.Добавить();
				НоваяСтрока.Пользователь = Перечисления.ВидыНазначенияДатЗапрета.ДляВсехПользователей;
				НоваяСтрока.Раздел = ПланыВидовХарактеристик.РазделыДатЗапретаИзменения.Здания;
				НоваяСтрока.Объект = Здание;
				НоваяСтрока.ДатаЗапрета = ДобавитьМесяц(Дата, -1);
				НоваяСтрока.Комментарий = "";
			Иначе
				НоваяСтрока = НаборЗаписей[0];
				НоваяСтрока.ДатаЗапрета = ДобавитьМесяц(Дата, -1);
				НоваяСтрока.Комментарий = "";
			КонецЕсли;
			
			НаборЗаписей.Записать(Истина);
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры	

// Процедура - включает даты запрета изменения объекта.
//
Процедура ВключитьДатыЗапретаИзменения(Отказ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДатыЗапретаИзменения.ДатаЗапрета
		|ИЗ
		|	РегистрСведений.ДатыЗапретаИзменения КАК ДатыЗапретаИзменения
		|ГДЕ
		|	ДатыЗапретаИзменения.Объект = &Здание
		|	И ДатыЗапретаИзменения.Раздел = &Раздел";
		
	Запрос.УстановитьПараметр("Здание", Здание);
	Запрос.УстановитьПараметр("Раздел", ПланыВидовХарактеристик.РазделыДатЗапретаИзменения.Здания);
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Следующий() Тогда
	
		Если ДобавитьМесяц(РезультатЗапроса.ДатаЗапрета, 2) < КонецМесяца(Дата) Тогда
			Отказ = Истина;
			НСтрока = НСтр("ru='Закрытие месяца запрещено. Существуют ранее не закрытые периоды.';uk='Відкриття мiсяця заборонене. iснують ранiше не закритi перiоди'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтрока,, ,, Отказ);
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	НаборЗаписей = РегистрыСведений.ДатыЗапретаИзменения.СоздатьНаборЗаписей();
	
	НаборЗаписей.Отбор.Пользователь.Установить(Перечисления.ВидыНазначенияДатЗапрета.ДляВсехПользователей);
	НаборЗаписей.Отбор.Раздел.Установить(ПланыВидовХарактеристик.РазделыДатЗапретаИзменения.Здания);
	НаборЗаписей.Отбор.Объект.Установить(Здание);
	
	НаборЗаписей.Прочитать();
	Если НаборЗаписей.Количество() = 0 Тогда
		НоваяСтрока = НаборЗаписей.Добавить();
		НоваяСтрока.Пользователь = Перечисления.ВидыНазначенияДатЗапрета.ДляВсехПользователей;
		НоваяСтрока.Раздел = ПланыВидовХарактеристик.РазделыДатЗапретаИзменения.Здания;
		НоваяСтрока.Объект = Здание;
		НоваяСтрока.ДатаЗапрета = Дата;
		НоваяСтрока.Комментарий = "";
	Иначе
		НоваяСтрока = НаборЗаписей[0];
		НоваяСтрока.ДатаЗапрета = Дата;
		НоваяСтрока.Комментарий = "";
	КонецЕсли;
	
	НаборЗаписей.Записать(Истина);
	
КонецПроцедуры	

