
////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ И ФУНКЦИИ ОБЩЕГО НАЗНАЧЕНИЯ

&НаСервере
Функция ПолучитьПоказания(ПриборУчета, ПериодНачисления)
	Запрос = Новый Запрос;
	Запрос.Текст =
	    "ВЫБРАТЬ
	    |	АктСнятияПоказанийХолоднойВодыСрезПоследних.РазницаПоказания,
	    |	АктСнятияПоказанийХолоднойВодыСрезПоследних.Период
	    |ИЗ
	    |	РегистрСведений.АктСнятияПоказанийХолоднойВоды.СрезПоследних(
	    |			&НаДату,
	    |			ПриборУчета = &ПриборУчета
	    |				И ПериодНачисления = &ПериодНачисления) КАК АктСнятияПоказанийХолоднойВодыСрезПоследних";
	Запрос.УстановитьПараметр("НаДату", Новый Граница(ТекущаяДата(), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("ПриборУчета", ПриборУчета);
	Запрос.УстановитьПараметр("ПериодНачисления", НачалоМесяца(ПериодНачисления));
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	ДанныеВыборки = Новый Структура;
	Пока Выборка.Следующий() Цикл
		ДанныеВыборки.Вставить("КвоКубов", Выборка.РазницаПоказания);
		ДанныеВыборки.Вставить("ДатаСнятия", Выборка.Период);
	КонецЦикла;
	Возврат ДанныеВыборки;
КонецФункции

&НаСервере
Функция ПолучитьДоначислениеПрошлогоМесяца(ПриборУчета)
	Запрос = Новый Запрос;
	Запрос.Текст = 
	    "ВЫБРАТЬ
	    |	РаспределениеХолоднойВодыСрезПоследних.ДосчитаноДоКонцаМесяца
	    |ИЗ
	    |	РегистрСведений.РаспределениеХолоднойВоды.СрезПоследних КАК РаспределениеХолоднойВодыСрезПоследних
	    |ГДЕ
	    |	РаспределениеХолоднойВодыСрезПоследних.Период МЕЖДУ &НачПериода И &КонПериода
	    |	И РаспределениеХолоднойВодыСрезПоследних.ОбщедомовойПриборУчета = &ОбщедомовойПриборУчета
	    |	И РаспределениеХолоднойВодыСрезПоследних.Активность = ИСТИНА";
	Запрос.УстановитьПараметр("ОбщедомовойПриборУчета", ПриборУчета);
	Запрос.УстановитьПараметр("НачПериода", ДобавитьМесяц(НачалоМесяца(Объект.Дата), -1));
	Запрос.УстановитьПараметр("КонПериода", ДобавитьМесяц(КонецМесяца(Объект.Дата), -1));
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Значение = Выборка.ДосчитаноДоКонцаМесяца;
	КонецЦикла;
	Если Значение = Неопределено Тогда
		Значение = 0;
	КонецЕсли;
	Возврат Значение;
КонецФункции

// Процедура ЗаполнитьНаСервере()
//
&НаСервере
Процедура ЗаполнитьНаСервере1()
	
	РасчитыватьЭнергоемкость = Объект.Услуга.РасчитыватьЭнергоемкость;
	
	Если ЗначениеЗаполнено(Объект.УслугаИндивидуальная) Тогда
	
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	РасчетПоказанийПриборовУчетаОбороты.ОбъектУстановки КАК ЛицевойСчет,
			|	СУММА(РасчетПоказанийПриборовУчетаОбороты.ЗначениеПриход) КАК Значение,
			|	ЕСТЬNULL(НазначенныеУслугиСрезПоследних.Период, &ПериодКон) КАК период,
			|	ЕСТЬNULL(НазначенныеУслугиСрезПоследних.Действует, ЛОЖЬ) КАК Действует
			|ИЗ
			|	РегистрНакопления.РасчетПоказанийПриборовУчета.Обороты(&ПериодНач, &ПериодКон, Месяц, Услуга = &Услуга) КАК РасчетПоказанийПриборовУчетаОбороты
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НазначенныеУслуги.СрезПоследних(&ПериодКон, Услуга = &Услуга) КАК НазначенныеУслугиСрезПоследних
			|		ПО РасчетПоказанийПриборовУчетаОбороты.ОбъектУстановки = НазначенныеУслугиСрезПоследних.ЛицевойСчет
			|			И РасчетПоказанийПриборовУчетаОбороты.Услуга = НазначенныеУслугиСрезПоследних.Услуга
			|
			|СГРУППИРОВАТЬ ПО
			|	РасчетПоказанийПриборовУчетаОбороты.ОбъектУстановки,
			|	ЕСТЬNULL(НазначенныеУслугиСрезПоследних.Действует, ЛОЖЬ),
			|	ЕСТЬNULL(НазначенныеУслугиСрезПоследних.Период, &ПериодКон)";
			
		Запрос.УстановитьПараметр("ПериодНач",	НачалоМесяца(Объект.ПериодНачисления));		
		Запрос.УстановитьПараметр("ПериодКон",	КонецМесяца(Объект.ПериодНачисления));		
		Запрос.УстановитьПараметр("Услуга", 	Объект.УслугаИндивидуальная);		
		
		ТаблицаУслугСоСчетчиками = Запрос.Выполнить().Выгрузить();
		
		ТаблицаУслугСоСчетчиками.Колонки.Добавить("Дней", Новый ОписаниеТипов("Число"));
		ЗначениеСоСчетчиками = ТаблицаУслугСоСчетчиками.Итог("Значение");
		МассивЛС = Новый Массив;
		Для каждого Строка  Из ТаблицаУслугСоСчетчиками Цикл
		
			Если НЕ Строка.Действует Тогда 
				
			      Строка.Дней = (НачалоМесяца(Объект.ПериодНачисления) - НачалоДня(Строка.Период))/(60*60*24);
			  Иначе
				  МассивЛС.Добавить(Строка.ЛицевойСчет);
				  Строка.Дней = 0
			
			КонецЕсли; 
		
		КонецЦикла; 
		МассивЛС = ТаблицаУслугСоСчетчиками.ВыгрузитьКолонку("ЛицевойСчет");
	Иначе
		МассивЛС = Новый Массив;
		ЗначениеСоСчетчиками = 0;		
	КонецЕсли; 	
	
	Если ТипЗнч(Объект.Услуга.БазаРаспределенияРасчетнойУслуги) = Тип("ПеречислениеСсылка.ВидыПотребителейУслуг") Тогда
		
		ТекстЗапроса =
			"ВЫБРАТЬ
			|	НазначенныеУслугиСрезПоследних.ЛицевойСчет КАК ЛицевойСчет,
			|	НазначенныеУслугиСрезПоследних.ЛицевойСчет.ОбъектЛицевогоСчета КАК ОбъектЛицевогоСчета,
			|	ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ОтветственныйВладелец КАК ОтветственныйВладелец,
			|	ВЫБОР
			|		КОГДА &ВидБазыРаспределения = ЗНАЧЕНИЕ(Перечисление.ВидыПотребителейУслуг.Прописанные)
			|			ТОГДА ЛицевыеСчетаСрезПоследних.КоличествоПрописанных
			|		ИНАЧЕ ЛицевыеСчетаСрезПоследних.КоличествоПроживающих
			|	КОНЕЦ КАК ЗначениеБазы,
			|	&Период
			|ИЗ
			|	РегистрСведений.НазначенныеУслуги.СрезПоследних(
			|			&Период,
			|			ЛицевойСчет.Владелец = &Здание
			|				И Услуга = &Услуга
			|				И ВЫБОР
			|					КОГДА &Подъезд = ЗНАЧЕНИЕ(Справочник.Подъезды.ПустаяСсылка)
			|						ТОГДА ИСТИНА
			|					ИНАЧЕ ЛицевойСчет.ОбъектЛицевогоСчета.Подъезд = &Подъезд
			|				КОНЕЦ) КАК НазначенныеУслугиСрезПоследних
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОтветственныйВладелецЛицевогоСчета.СрезПоследних(&Период, ) КАК ОтветственныйВладелецЛицевогоСчетаСрезПоследних
			|		ПО НазначенныеУслугиСрезПоследних.ЛицевойСчет = ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ЛицевойСчет
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛицевыеСчета.СрезПоследних(&Период, ) КАК ЛицевыеСчетаСрезПоследних
			|		ПО НазначенныеУслугиСрезПоследних.ЛицевойСчет = ЛицевыеСчетаСрезПоследних.ЛицевойСчет
			|ГДЕ
			|	НазначенныеУслугиСрезПоследних.Действует = ИСТИНА
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	НазначенныеУслугиСрезПоследних.ЛицевойСчет,
			|	НазначенныеУслугиСрезПоследних.ЛицевойСчет.ОбъектЛицевогоСчета,
			|	ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ОтветственныйВладелец,
			|	ВЫБОР
			|		КОГДА &ВидБазыРаспределения = ЗНАЧЕНИЕ(Перечисление.ВидыПотребителейУслуг.Прописанные)
			|			ТОГДА ЛицевыеСчетаСрезПоследних.КоличествоПрописанных
			|		ИНАЧЕ ЛицевыеСчетаСрезПоследних.КоличествоПроживающих
			|	КОНЕЦ,
			|	НазначенныеУслугиСрезПоследних.Период
			|ИЗ
			|	РегистрСведений.НазначенныеУслуги.СрезПоследних(
			|			&Период,
			|			ЛицевойСчет.Владелец = &Здание
			|				И Услуга = &Услуга
			|				И ВЫБОР
			|					КОГДА &Подъезд = ЗНАЧЕНИЕ(Справочник.Подъезды.ПустаяСсылка)
			|						ТОГДА ИСТИНА
			|					ИНАЧЕ ЛицевойСчет.ОбъектЛицевогоСчета.Подъезд = &Подъезд
			|				КОНЕЦ) КАК НазначенныеУслугиСрезПоследних
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОтветственныйВладелецЛицевогоСчета.СрезПоследних(&Период, ) КАК ОтветственныйВладелецЛицевогоСчетаСрезПоследних
			|		ПО НазначенныеУслугиСрезПоследних.ЛицевойСчет = ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ЛицевойСчет
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛицевыеСчета.СрезПоследних(&Период, ) КАК ЛицевыеСчетаСрезПоследних
			|		ПО НазначенныеУслугиСрезПоследних.ЛицевойСчет = ЛицевыеСчетаСрезПоследних.ЛицевойСчет
			|ГДЕ
			|	НазначенныеУслугиСрезПоследних.Действует = ЛОЖЬ
			|	И НазначенныеУслугиСрезПоследних.Период > НАЧАЛОПЕРИОДА(&Период, МЕСЯЦ)";
		
	Иначе
		
		ТекстЗапроса =
			"ВЫБРАТЬ
			|	НазначенныеУслугиСрезПоследних.ЛицевойСчет КАК ЛицевойСчет,
			|	ЕСТЬNULL(ПлощадьОбъектовЛицевыхСчетовСрезПоследних.Площадь, 0) КАК ЗначениеБазы,
			|	НазначенныеУслугиСрезПоследних.ЛицевойСчет.ОбъектЛицевогоСчета КАК ОбъектЛицевогоСчета,
			|	ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ОтветственныйВладелец КАК ОтветственныйВладелец,
			|	&Период КАК Период
			|ИЗ
			|	РегистрСведений.НазначенныеУслуги.СрезПоследних(
			|			&Период,
			|			ЛицевойСчет.Владелец = &Здание
			|				И Услуга = &Услуга
			|				И ВЫБОР
			|					КОГДА &Подъезд = ЗНАЧЕНИЕ(Справочник.Подъезды.ПустаяСсылка)
			|						ТОГДА ИСТИНА
			|					ИНАЧЕ ЛицевойСчет.ОбъектЛицевогоСчета.Подъезд = &Подъезд
			|				КОНЕЦ) КАК НазначенныеУслугиСрезПоследних
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПлощадьОбъектовЛицевыхСчетов.СрезПоследних(&Период, ВидПлощади = &ВидБазыРаспределения) КАК ПлощадьОбъектовЛицевыхСчетовСрезПоследних
			|		ПО НазначенныеУслугиСрезПоследних.ЛицевойСчет.ОбъектЛицевогоСчета = ПлощадьОбъектовЛицевыхСчетовСрезПоследних.Помещение
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОтветственныйВладелецЛицевогоСчета.СрезПоследних(&Период, ) КАК ОтветственныйВладелецЛицевогоСчетаСрезПоследних
			|		ПО НазначенныеУслугиСрезПоследних.ЛицевойСчет = ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ЛицевойСчет
			|ГДЕ
			|	НазначенныеУслугиСрезПоследних.Действует = ИСТИНА
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	НазначенныеУслугиСрезПоследних.ЛицевойСчет,
			|	ЕСТЬNULL(ПлощадьОбъектовЛицевыхСчетовСрезПоследних.Площадь, 0),
			|	НазначенныеУслугиСрезПоследних.ЛицевойСчет.ОбъектЛицевогоСчета,
			|	ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ОтветственныйВладелец,
			|	НазначенныеУслугиСрезПоследних.Период
			|ИЗ
			|	РегистрСведений.НазначенныеУслуги.СрезПоследних(
			|			&Период,
			|			ЛицевойСчет.Владелец = &Здание
			|				И Услуга = &Услуга
			|				И ВЫБОР
			|					КОГДА &Подъезд = ЗНАЧЕНИЕ(Справочник.Подъезды.ПустаяСсылка)
			|						ТОГДА ИСТИНА
			|					ИНАЧЕ ЛицевойСчет.ОбъектЛицевогоСчета.Подъезд = &Подъезд
			|				КОНЕЦ) КАК НазначенныеУслугиСрезПоследних
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПлощадьОбъектовЛицевыхСчетов.СрезПоследних(&Период, ВидПлощади = &ВидБазыРаспределения) КАК ПлощадьОбъектовЛицевыхСчетовСрезПоследних
			|		ПО НазначенныеУслугиСрезПоследних.ЛицевойСчет.ОбъектЛицевогоСчета = ПлощадьОбъектовЛицевыхСчетовСрезПоследних.Помещение
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОтветственныйВладелецЛицевогоСчета.СрезПоследних(&Период, ) КАК ОтветственныйВладелецЛицевогоСчетаСрезПоследних
			|		ПО НазначенныеУслугиСрезПоследних.ЛицевойСчет = ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ЛицевойСчет
			|ГДЕ
			|	НазначенныеУслугиСрезПоследних.Действует = ЛОЖЬ
			|	И НазначенныеУслугиСрезПоследних.Период > НАЧАЛОПЕРИОДА(&Период, МЕСЯЦ)";
			
	КонецЕсли;	
		
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
		
	Запрос.УстановитьПараметр("Период", КонецМесяца(Объект.ПериодНачисления));		
	Запрос.УстановитьПараметр("Услуга", Объект.Услуга);		
	Запрос.УстановитьПараметр("ВидБазыРаспределения", Объект.Услуга.БазаРаспределенияРасчетнойУслуги);		
	Запрос.УстановитьПараметр("Здание", Объект.Здание);
	Запрос.УстановитьПараметр("Подъезд", Объект.Подъезд);
	//Запрос.УстановитьПараметр("СписокЛицевыхСчетов", МассивЛС);
	
	ТаблицаЛицевыхСчетов = Запрос.Выполнить().Выгрузить();
	ТаблицаЛицевыхСчетов.Колонки.Добавить("Показание", Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(15, 4)));
	ТаблицаЛицевыхСчетов.Колонки.Добавить("ЗначениеБазыСКоэффициентом", Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(15, 4)));
	
		
	ЗначениеДляРаспределения = Объект.ЗначениеОбщедомовое - ЗначениеСоСчетчиками;
	КонецПериодаРаспределения = КонецМесяца(Объект.ПериодНачисления);
	
	Для каждого Строка Из ТаблицаЛицевыхСчетов Цикл
		
		КоэффициентПоДням = День(Строка.Период)/День(КонецПериодаРаспределения);
		Строка.ЗначениеБазыСКоэффициентом  = Строка.ЗначениеБазы * КоэффициентПоДням; 
			
	КонецЦикла;
	
	ИтогБазы = ТаблицаЛицевыхСчетов.Итог("ЗначениеБазыСКоэффициентом");
	Если ИтогБазы = 0 Тогда
		Сообщить(НСтр("ru='Итог по площади равен нулю.';uk='Підсумок по площі дорівнює нулю.'"));
		Возврат;
	КонецЕсли;

	
	Для каждого Строка Из ТаблицаЛицевыхСчетов Цикл
		
		НоваяСтрока = Объект.Основная.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		//КоэффициентПоДням = День(Строка.Период)/День(КонецПериодаРаспределения);// определим весь месяц или только часть его оказывалась услуга в %
		НоваяСтрока.ВидТарифа = Перечисления.ВидыТарифов.Общий;
		НоваяСтрока.Показание = ЗначениеДляРаспределения * (Строка.ЗначениеБазыСКоэффициентом / ИтогБазы);
		Если РасчитыватьЭнергоемкость Тогда
			НоваяСтрока.Энергоемкость = НоваяСтрока.Показание/Строка.ЗначениеБазы;
		Иначе
			НоваяСтрока.Энергоемкость = 0;
		КонецЕсли;	
	КонецЦикла; 
	
	Если Объект.Основная.Количество()> 0 Тогда
	    ГСЧ = Новый ГенераторСлучайныхЧисел();
		СЧ = ГСЧ.СлучайноеЧисло(0,  Объект.Основная.Количество() - 1);

		ЗначениеКорректировки = Объект.Основная.Итог("Показание") - ЗначениеДляРаспределения;	
	    Объект.Основная[СЧ].Показание = Объект.Основная[СЧ].Показание - ЗначениеКорректировки;
		
	КонецЕсли; 
	
КонецПроцедуры // ЗаполнитьНаСервере()

&НаСервере
Процедура ЗаполнитьНаСервере2()
	РасчитыватьЭнергоемкость = Объект.Услуга.РасчитыватьЭнергоемкость;
	Если НЕ ЗначениеЗаполнено(Объект.УслугаИндивидуальная) Тогда
		Сообщить("Не заповнена послуга з лічильниками!");
		Возврат;
	Иначе
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	РасчетПоказанийПриборовУчетаОбороты.ОбъектУстановки,
			|	СУММА(РасчетПоказанийПриборовУчетаОбороты.ЗначениеПриход) КАК Значение
			|ИЗ
			|	РегистрНакопления.РасчетПоказанийПриборовУчета.Обороты(
			|			&НачПериода,
			|			&КонПериода,
			|			Месяц,
			|			Услуга = &Услуга
			|				И ОбъектУстановки.Владелец = &Здание) КАК РасчетПоказанийПриборовУчетаОбороты
			|
			|СГРУППИРОВАТЬ ПО
			|	РасчетПоказанийПриборовУчетаОбороты.ОбъектУстановки";
		Запрос.УстановитьПараметр("НачПериода", НачалоМесяца(Объект.ПериодНачисления));
		Запрос.УстановитьПараметр("КонПериода", КонецМесяца(Объект.ПериодНачисления));		
		Запрос.УстановитьПараметр("Услуга", 	Объект.УслугаИндивидуальная);
		Запрос.УстановитьПараметр("Здание",     Объект.Здание);
		
		ТаблицаУслугСоСчетчиками = Запрос.Выполнить().Выгрузить();
		ЗначениеСоСчетчиками     = ТаблицаУслугСоСчетчиками.Итог("Значение");
		
		// Выбор услуг без приборов учета		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		    "ВЫБРАТЬ
		    |	НазначенныеУслугиСрезПоследних.ЛицевойСчет,
		    |	НазначенныеУслугиСрезПоследних.Действует,
		    |	НазначенныеУслугиСрезПоследних.Период
		    |ИЗ
		    |	РегистрСведений.НазначенныеУслуги.СрезПоследних(
		    |			&НаДату,
		    |			ЛицевойСчет.Владелец = &Здание
		    |				И Организация = &Организация
		    |				И Услуга <> &Услуга) КАК НазначенныеУслугиСрезПоследних";
		Запрос.УстановитьПараметр("НаДату",      КонецМесяца(Объект.ПериодНачисления));
		Запрос.УстановитьПараметр("Здание",      Объект.Здание);
		Запрос.УстановитьПараметр("Организация", Объект.Организация);
		Запрос.УстановитьПараметр("Услуга",      Объект.УслугаИндивидуальная);
		
		ТаблицаУслугБезСчетчиков = Запрос.Выполнить().Выгрузить();
		ТаблицаУслугБезСчетчиков.Колонки.Добавить("Показание", Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(15, 4)));
	    ТаблицаУслугБезСчетчиков.Колонки.Добавить("ЗначениеБазыСКоэффициентом", Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(15, 4)));
		
		Если ТаблицаУслугБезСчетчиков.Количество() = 0 Тогда
			
			ЗначениеДляРаспределения  = Объект.ЗначениеОбщедомовое - ЗначениеСоСчетчиками;
			КонецПериодаРаспределения = КонецМесяца(Объект.ПериодНачисления);
			Для Каждого Строка Из ТаблицаУслугБезСчетчиков Цикл	
				КвоПроживающих = ОбщийМодульМВК.ОпределитьКоличествоПрописанных(Строка.ЛицевойСчет);  //КоличествоПроживающих
				КоэффициентПоДням = День(Строка.Период)/День(КонецПериодаРаспределения);
				Строка.ЗначениеБазыСКоэффициентом  = КвоПроживающих.КоличествоПроживающих * КоэффициентПоДням; 	
			КонецЦикла;
			ИтогБазы = ТаблицаУслугБезСчетчиков.Итог("ЗначениеБазыСКоэффициентом");
			Если ИтогБазы = 0 Тогда
				Сообщить(НСтр("ru='Итог по площади равен нулю.';uk='Підсумок по площі дорівнює нулю.'"));
				Возврат;
			КонецЕсли;
			
			Для Каждого стр Из ТаблицаУслугБезСчетчиков Цикл
				НоваяСтрока = Объект.Основная.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, стр);
				//КоэффициентПоДням = День(Строка.Период)/День(КонецПериодаРаспределения);// определим весь месяц или только часть его оказывалась услуга в %
				НоваяСтрока.ВидТарифа = Перечисления.ВидыТарифов.Общий;
				НоваяСтрока.Показание = ЗначениеДляРаспределения * (Строка.ЗначениеБазыСКоэффициентом / ИтогБазы);
				Если РасчитыватьЭнергоемкость Тогда
					НоваяСтрока.Энергоемкость = НоваяСтрока.Показание/Строка.ЗначениеБазы;
				Иначе
					НоваяСтрока.Энергоемкость = 0;
				КонецЕсли;	
			КонецЦикла;
			
			Если Объект.Основная.Количество()> 0 Тогда
			    ГСЧ = Новый ГенераторСлучайныхЧисел();
				СЧ = ГСЧ.СлучайноеЧисло(0,  Объект.Основная.Количество() - 1);

				ЗначениеКорректировки = Объект.Основная.Итог("Показание") - ЗначениеДляРаспределения;	
			    Объект.Основная[СЧ].Показание = Объект.Основная[СЧ].Показание - ЗначениеКорректировки;		
			КонецЕсли;
		Иначе
			ЗначениеДляРаспределения   = Объект.ЗначениеОбщедомовое - ЗначениеСоСчетчиками;
			Если ЗначениеДляРаспределения <= 0 Тогда
				Сообщить("Різниця між показником загальнобудинкового лічильника - " + Объект.ЗначениеОбщедомовое + ", і сумою показників по лічильниках абонентів - " + ЗначениеСоСчетчиками + " менше, або дорівнює 0. Розподіляти нічого!");
				Возврат;
			КонецЕсли;
			Значение = ЗначениеДляРаспределения / ТаблицаУслугСоСчетчиками.Количество();
			Для Каждого стр Из ТаблицаУслугСоСчетчиками Цикл
				НоваяСтр = Объект.Основная.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, стр);
				НоваяСтр.ВидТарифа = Перечисления.ВидыТарифов.Общий;
				НоваяСтрока.Показание = стр.ЗначениеБазыСКоэффициентом * Значение;
			КонецЦикла;
			Если Объект.Основная.Количество()> 0 Тогда
			    ГСЧ = Новый ГенераторСлучайныхЧисел();
				СЧ = ГСЧ.СлучайноеЧисло(0,  Объект.Основная.Количество() - 1);

				ЗначениеКорректировки = Объект.Основная.Итог("Показание") - ЗначениеДляРаспределения;	
			    Объект.Основная[СЧ].Показание = Объект.Основная[СЧ].Показание - ЗначениеКорректировки;		
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНаСервере()
	РасчитыватьЭнергоемкость = Объект.Услуга.РасчитыватьЭнергоемкость;
	Если НЕ ЗначениеЗаполнено(Объект.УслугаИндивидуальная) Тогда
		Сообщить("Не заповнена послуга з лічильниками!");
		Возврат;
	ИначеЕсли НЕ ЗначениеЗаполнено(УслугаБезСчетчиков) Тогда
		Сообщить("Не заповнена послуга без лічильників!");
		Возврат;
	Иначе
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	РасчетПоказанийПриборовУчетаОбороты.ОбъектУстановки КАК ЛицевойСчет,
			|	СУММА(РасчетПоказанийПриборовУчетаОбороты.ЗначениеПриход) КАК Значение,
			|	РасчетПоказанийПриборовУчетаОбороты.Период
			|ИЗ
			|	РегистрНакопления.РасчетПоказанийПриборовУчета.Обороты(
			|			&НачПериода,
			|			&КонПериода,
			|			Месяц,
			|			Услуга = &Услуга
			|				И ОбъектУстановки.Владелец = &Здание) КАК РасчетПоказанийПриборовУчетаОбороты
			|
			|СГРУППИРОВАТЬ ПО
			|	РасчетПоказанийПриборовУчетаОбороты.ОбъектУстановки,
			|	РасчетПоказанийПриборовУчетаОбороты.Период";
		Запрос.УстановитьПараметр("НачПериода", НачалоМесяца(Объект.НачПериода));
		Запрос.УстановитьПараметр("КонПериода", КонецМесяца(Объект.КонПериода));		
		Запрос.УстановитьПараметр("Услуга", 	Объект.УслугаИндивидуальная);
		Запрос.УстановитьПараметр("Здание",     Объект.Здание);
		
		ТаблицаУслугСоСчетчиками = Запрос.Выполнить().Выгрузить();
		ЗначениеСоСчетчиками     = ТаблицаУслугСоСчетчиками.Итог("Значение");
		ТаблицаУслугСоСчетчиками.Колонки.Добавить("Показание", Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(15, 4)));
	    ТаблицаУслугСоСчетчиками.Колонки.Добавить("ЗначениеБазыСКоэффициентом", Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(15, 4)));
		
		
		// Выбор услуг без приборов учета		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			//"ВЫБРАТЬ
			//|	НазначенныеУслугиСрезПоследних.ЛицевойСчет,
			//|	НазначенныеУслугиСрезПоследних.Действует,
			//|	НазначенныеУслугиСрезПоследних.Период,
			//|	НазначенныеУслугиСрезПоследних.Услуга,
			//|	НазначенныеУслугиСрезПоследних.Услуга.КвоКубов
			//|ИЗ
			//|	РегистрСведений.НазначенныеУслуги.СрезПоследних(
			//|			&НаДату,
			//|			ЛицевойСчет.Владелец = &Здание
			//|				И Организация = &Организация
			//|				И Действует = ИСТИНА
			//|				И Услуга В (&Услуга)) КАК НазначенныеУслугиСрезПоследних";
			
			  "ВЫБРАТЬ РАЗЛИЧНЫЕ
			  |	0 КАК ИндексНабора,
			  |	НазначенныеУслугиСрезПоследних.ЛицевойСчет,
			  |	НазначенныеУслугиСрезПоследних.Организация,
			  |	НазначенныеУслугиСрезПоследних.Действует,
			  |	НазначенныеУслугиСрезПоследних.Услуга,
			  |	НазначенныеУслугиСрезПоследних.Услуга.ВидУслуги,
			  |	НазначенныеУслугиСрезПоследних.ЛицевойСчет.Владелец КАК Здание,
			  |	НазначенныеУслугиСрезПоследних.Период КАК ДатаНачалаДействия,
			  |	МАКСИМУМ(НазначенныеУслуги.Период) КАК ДатаОкончанияДействия,
			  |	НазначенныеУслугиСрезПоследних.Регистратор КАК РегистраторДействующих
			  |ИЗ
			  |	РегистрСведений.НазначенныеУслуги.СрезПоследних(
			  |			&Период,
			  |			Действует
			  |				И ЛицевойСчет.Владелец = &Здание
			  |				И Организация = &Организация
			  |				И Услуга В (&Услуга)) КАК НазначенныеУслугиСрезПоследних
			  |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НазначенныеУслуги КАК НазначенныеУслуги
			  |		ПО НазначенныеУслугиСрезПоследних.Организация = НазначенныеУслуги.Организация
			  |			И НазначенныеУслугиСрезПоследних.ЛицевойСчет = НазначенныеУслуги.ЛицевойСчет
			  |			И НазначенныеУслугиСрезПоследних.Услуга = НазначенныеУслуги.Услуга
			  |			И (НазначенныеУслуги.Действует = ЛОЖЬ)
			  |			И (НазначенныеУслуги.Период > &Период)
			  |
			  |СГРУППИРОВАТЬ ПО
			  |	НазначенныеУслугиСрезПоследних.ЛицевойСчет,
			  |	НазначенныеУслугиСрезПоследних.Организация,
			  |	НазначенныеУслугиСрезПоследних.Действует,
			  |	НазначенныеУслугиСрезПоследних.Услуга,
			  |	НазначенныеУслугиСрезПоследних.Услуга.ВидУслуги,
			  |	НазначенныеУслугиСрезПоследних.ЛицевойСчет.Владелец,
			  |	НазначенныеУслугиСрезПоследних.Период,
			  |	НазначенныеУслугиСрезПоследних.Регистратор";
			
			
			
		Запрос.УстановитьПараметр("Период",	     КонецМесяца(Объект.КонПериода));
		//Запрос.УстановитьПараметр("НаДату",      КонецМесяца(Объект.ПериодНачисления));
		Запрос.УстановитьПараметр("Здание",      Объект.Здание);
		Запрос.УстановитьПараметр("Организация", Объект.Организация);
		Запрос.УстановитьПараметр("Услуга",      УслугаБезСчетчиков);
		
		ТаблицаУслугБезСчетчиков = Запрос.Выполнить().Выгрузить();
		ТаблицаУслугБезСчетчиков.Колонки.Добавить("Показание", Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(15, 4)));
		ТаблицаУслугБезСчетчиков.Колонки.Добавить("ЗначениеБазыСКоэффициентом", Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(15, 4)));
		ТаблицаУслугБезСчетчиков.Колонки.Добавить("КвоПроживающих", Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(2, 0)));
		
		Если ТаблицаУслугБезСчетчиков.Количество() <> 0 Тогда
			ЗначениеКубовПоНорме = 0;
			ЗначениеДляРаспределения  = Объект.ЗначениеОбщедомовое - ЗначениеСоСчетчиками;
			КонецПериодаРаспределения = КонецМесяца(Объект.КонПериода);
			НачалоПериодаРаспределения = НачалоМесяца(Объект.НачПериода);
			Для Каждого Строка Из ТаблицаУслугБезСчетчиков Цикл
				ЗначениеНормы  = ОпределениеЗначениеНормы(Строка.Услуга, Строка.ЛицевойСчет.Владелец, Строка.ЛицевойСчет);
				КвоПроживающих = ОбщийМодульМВК.ОпределитьКоличествоПрописанных(Строка.ЛицевойСчет);  //КоличествоПроживающих
				ЗначениеКубовПоНорме = ЗначениеКубовПоНорме + (ЗначениеНормы * КвоПроживающих.КоличествоПроживающих); 
				Строка.КвоПроживающих = КвоПроживающих.КоличествоПроживающих;
				КоэффициентПоДням = День(НачалоПериодаРаспределения)/День(КонецПериодаРаспределения);
				Строка.ЗначениеБазыСКоэффициентом  = КвоПроживающих.КоличествоПроживающих * КоэффициентПоДням; 	
			КонецЦикла;
			ЗначениеДляРаспределения = ЗначениеДляРаспределения - ЗначениеКубовПоНорме;
			//ЗначениеДляРаспределения = ЗначениеДляРаспределения - (ЗначениеНормы * ТаблицаУслугБезСчетчиков.Количество()); 
 			ИтогБазы = ТаблицаУслугБезСчетчиков.Итог("ЗначениеБазыСКоэффициентом");
			Если ИтогБазы = 0 Тогда
				Сообщить(НСтр("ru='Итог по площади равен нулю.';uk='Підсумок по площі дорівнює нулю.'"));
				Возврат;
			КонецЕсли;
			
			Для Каждого стр Из ТаблицаУслугБезСчетчиков Цикл
				НоваяСтрока = Объект.Основная.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, стр);
				НоваяСтрока.ОбъектЛицевогоСчета = стр.ЛицевойСчет.ОбъектЛицевогоСчета;
				НоваяСтрока.ОтветственныйВладелец = ОпределитьответственныйВладелец(стр.ЛицевойСчет);
				//КоэффициентПоДням = День(Строка.Период)/День(КонецПериодаРаспределения);// определим весь месяц или только часть его оказывалась услуга в %
				НоваяСтрока.ВидТарифа = Перечисления.ВидыТарифов.Общий;
				НоваяСтрока.Показание = ЗначениеДляРаспределения * (стр.ЗначениеБазыСКоэффициентом / ИтогБазы);   //ТаблицаУслугБезСчетчиков.Итог("КвоПроживающих")
				Если РасчитыватьЭнергоемкость Тогда
					НоваяСтрока.Энергоемкость = НоваяСтрока.Показание/Строка.ЗначениеБазы;
				Иначе
					НоваяСтрока.Энергоемкость = 0;
				КонецЕсли;	
			КонецЦикла;
			
			Если Объект.Основная.Количество()> 0 Тогда
			    ГСЧ = Новый ГенераторСлучайныхЧисел();
				СЧ = ГСЧ.СлучайноеЧисло(0,  Объект.Основная.Количество() - 1);

				ЗначениеКорректировки = Объект.Основная.Итог("Показание") - ЗначениеДляРаспределения;	
			    Объект.Основная[СЧ].Показание = Объект.Основная[СЧ].Показание - ЗначениеКорректировки;		
			КонецЕсли;
		Иначе
			НачислениеПоСреднему = ОпределитьСредннеНачисление(Объект.Здание);
			НачислениеПоСреднему.Свернуть("Период, ЛицевойСчет", "Разница");
			Если НачислениеПоСреднему.Количество() <> 0 Тогда
				Для Каждого стр Из НачислениеПоСреднему Цикл
					Отбор = Новый Структура;
					Отбор.Вставить("ЛицевойСчет", стр.ЛицевойСчет);
					Отбор.Вставить("Период", НачалоМесяца(стр.Период));
					ЗначениеПоСчетчику = ТаблицаУслугСоСчетчиками.НайтиСтроки(Отбор);
					Для Каждого стрТаб Из ЗначениеПоСчетчику Цикл
						Если стрТаб.Значение <> 0 Тогда
							стрТаб.Значение = 0;
							стрТаб.Значение = стр.Разница * Объект.КоеффициентРаспределения;
						КонецЕсли;
					КонецЦикла;
				КонецЦикла;
			КонецЕсли;
			
			ЗначениеСоСчетчиками = ТаблицаУслугСоСчетчиками.Итог("Значение");
			
			ЗначениеДляРаспределения   = Объект.ЗначениеОбщедомовое - ЗначениеСоСчетчиками;
			Если ЗначениеДляРаспределения <= 0 Тогда
				Сообщить("Різниця між показником загальнобудинкового лічильника - " + Объект.ЗначениеОбщедомовое + ", і сумою показників по лічильниках абонентів - " + ЗначениеСоСчетчиками + " менше, або дорівнює 0. Розподіляти нічого!");
				//Возврат;
			КонецЕсли;
			Значение = ЗначениеДляРаспределения / ЗначениеСоСчетчиками;
			КонецПериодаРаспределения = КонецМесяца(Объект.КонПериода);
			Для Каждого Строка Из ТаблицаУслугСоСчетчиками Цикл
				КвоПроживающих = ОбщийМодульМВК.ОпределитьКоличествоПрописанных(Строка.ЛицевойСчет);  //КоличествоПроживающих
				КоэффициентПоДням = День(Строка.Период)/День(КонецПериодаРаспределения);
				Строка.ЗначениеБазыСКоэффициентом  = КвоПроживающих.КоличествоПроживающих * КоэффициентПоДням; 	
			КонецЦикла;
			
			ТаблицаУслугСоСчетчиками.Свернуть("ЛицевойСчет, Период, Показание, ЗначениеБазыСКоэффициентом", "Значение");
			Для Каждого стр Из ТаблицаУслугСоСчетчиками Цикл
				НоваяСтр = Объект.Основная.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтр, стр);
				НоваяСтр.ОбъектЛицевогоСчета = стр.ЛицевойСчет.ОбъектЛицевогоСчета;
				НоваяСтр.ОтветственныйВладелец = ОпределитьответственныйВладелец(стр.ЛицевойСчет);
				НоваяСтр.ВидТарифа = Перечисления.ВидыТарифов.Общий;
				НоваяСтр.Показание = стр.Значение * Значение;
			КонецЦикла;
			Если Объект.Основная.Количество()> 0 Тогда
			    ГСЧ = Новый ГенераторСлучайныхЧисел();
				СЧ = ГСЧ.СлучайноеЧисло(0,  Объект.Основная.Количество() - 1);

				ЗначениеКорректировки = Объект.Основная.Итог("Показание") - ЗначениеДляРаспределения;	
			    Объект.Основная[СЧ].Показание = Объект.Основная[СЧ].Показание - ЗначениеКорректировки;		
			КонецЕсли;			
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

