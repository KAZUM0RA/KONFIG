&НаСервере
Функция ОпределениеЗначениеНормы(Услуга, Здание, ЛицевойСчет)
	Запрос = Новый Запрос;
	Запрос.Текст =
	    "ВЫБРАТЬ
	    |	ТарифыСрезПоследних.Услуга,
	    |	ТарифыСрезПоследних.ЗначениеТарифа,
	    |	ТарифыСрезПоследних.НормаПотребления,
	    |	ТарифыСрезПоследних.ЗначениеТарифаПоНорме,
	    |	ВЫБОР
	    |		КОГДА ТарифыСрезПоследних.НормаПотребления <> 0
	    |			ТОГДА ""residentsNumber""
	    |		ИНАЧЕ Неопределено
	    |	КОНЕЦ КАК CHARACTERISTIC_TYPE
	    |ИЗ
	    |	РегистрСведений.Тарифы.СрезПоследних(
	    |			&НаДату,
	    |			Услуга = &Услуга
	    |				И Здание = &Здание) КАК ТарифыСрезПоследних";
	Запрос.УстановитьПараметр("Услуга", Услуга);
	Запрос.УстановитьПараметр("НаДату", ТекущаяДата());
	Запрос.УстановитьПараметр("Здание", Здание);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Норма = Выборка.НормаПотребления;
	КонецЦикла;
	Возврат Норма;
КонецФункции

&НаСервере
Функция ОпределитьответственныйВладелец(ЛицевойСчет)
    Запрос = Новый Запрос;
	Запрос.Текст =
	    "ВЫБРАТЬ
	    |	ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ОтветственныйВладелец
	    |ИЗ
	    |	РегистрСведений.ОтветственныйВладелецЛицевогоСчета.СрезПоследних(&НаДату, ЛицевойСчет = &ЛицевойСчет) КАК ОтветственныйВладелецЛицевогоСчетаСрезПоследних";
	Запрос.УстановитьПараметр("НаДату", КонецДня(ТекущаяДата()));
	Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Владелец = Выборка.ОтветственныйВладелец;
	КонецЦикла;
	Возврат Владелец;
КонецФункции

&НаСервере
Функция ОпределитьСредннеНачисление(Здание)
	Запрос = Новый Запрос;
	Запрос.Текст =
	    "ВЫБРАТЬ
	    |	ПоказанияПриборовЗаМесяц.Разница,
	    |	ПоказанияПриборовЗаМесяц.ЛицевойСчет,
	    |	ПоказанияПриборовЗаМесяц.Период
	    |ИЗ
	    |	РегистрСведений.ПоказанияПриборовЗаМесяц КАК ПоказанияПриборовЗаМесяц
	    |ГДЕ
	    |	ПоказанияПриборовЗаМесяц.Период МЕЖДУ &НачПериода И &КонПериода
	    |	И ПоказанияПриборовЗаМесяц.НачислениеПоСреднему = ИСТИНА
	    |	И ПоказанияПриборовЗаМесяц.Здание = &Здание
	    |	И ПоказанияПриборовЗаМесяц.Услуга.ВидУслуги = &ВидУслуги";
	Запрос.УстановитьПараметр("НачПериода", Объект.НачПериода);
	Запрос.УстановитьПараметр("КонПериода", КонецМесяца(Объект.КонПериода));
	Запрос.УстановитьПараметр("Здание", Здание);
	Запрос.УстановитьПараметр("ВидУслуги", Справочники.ВидыУслуг.ХолоднаяВода);
	Результат = Запрос.Выполнить().Выгрузить();
	Для Каждого стр Из Результат Цикл
		Если стр.Разница = 0 Тогда
			Результат.Удалить(стр);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции