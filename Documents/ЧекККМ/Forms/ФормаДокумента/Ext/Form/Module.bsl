&НаКлиенте
Процедура ЛицевойСчетПриИзменении(Элемент)
	ПолучитьЗадолженностьПоЛС();
КонецПроцедуры

Процедура ПолучитьЗадолженностьПоЛС() 
	
	Запрос = Новый Запрос;
	Запрос.Текст =  "ВЫБРАТЬ
	                |	РасчетыПоЛицевымСчетамОстатки.СуммаОстаток
	                |ИЗ
	                |	РегистрНакопления.РасчетыПоЛицевымСчетам.Остатки(&Дата, ЛицевойСчет = &ЛицевойСчет) КАК РасчетыПоЛицевымСчетамОстатки";
	Запрос.УстановитьПараметр("Дата",Объект.Дата);
	Запрос.УстановитьПараметр("ЛицевойСчет",Объект.ЛицевойСчет);
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		ДолгЛС = "0 грн.";
	Иначе 
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		ДолгЛС = Строка(?(Выборка.СуммаОстаток<0,0,Выборка.СуммаОстаток)) + " грн.";
	КонецЕсли;
	
	
КонецПроцедуры


