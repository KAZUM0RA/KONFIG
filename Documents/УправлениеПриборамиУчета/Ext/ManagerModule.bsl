
// Формирует таблицу значений, содержащую данные для проведения по регистру.
// Таблицы значений сохраняет в свойствах структуры "ДополнительныеСвойства".
//
Процедура СформироватьТаблицуУстановленныеПриборыУчета(ДокументСсылкаУправлениеПриборамиУчета, СтруктураДополнительныеСвойства)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = СтруктураДополнительныеСвойства.ДляПроведения.СтруктураВременныеТаблицы.МенеджерВременныхТаблиц;
	
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ТаблицаПриборыУчетаВключение.ПриборУчета КАК ПриборУчета,
		|	ТаблицаПриборыУчетаВключение.ОбъектУстановки КАК ОбъектУстановки,
		|	ТаблицаПриборыУчетаВключение.ДатаВключения КАК Период,
		|	ТаблицаПриборыУчетаВключение.ДатаПоследнейПоверки,
		|	ТаблицаПриборыУчетаВключение.ДатаСледующейПоверки,
		|	ТаблицаПриборыУчетаВключение.ТипПрибора,
		|	ТаблицаПриборыУчетаВключение.МестоРазмещения,
		|	ИСТИНА КАК Действует,
		|	0 КАК СреднемесячноеПоказание
		|ИЗ
		|	ВременнаяТаблицаПриборыУчета КАК ТаблицаПриборыУчетаВключение
		|ГДЕ
		|	ТаблицаПриборыУчетаВключение.ДатаВключения <> &ПустаяДата
		|
		|СГРУППИРОВАТЬ ПО
		|	ТаблицаПриборыУчетаВключение.ПриборУчета,
		|	ТаблицаПриборыУчетаВключение.ДатаВключения,
		|	ТаблицаПриборыУчетаВключение.ОбъектУстановки,
		|	ТаблицаПриборыУчетаВключение.ТипПрибора,
		|	ТаблицаПриборыУчетаВключение.ДатаПоследнейПоверки,
		|	ТаблицаПриборыУчетаВключение.ДатаСледующейПоверки,
		|	ТаблицаПриборыУчетаВключение.МестоРазмещения
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ТаблицаПриборыУчетаОтключение.ПриборУчета,
		|	ТаблицаПриборыУчетаОтключение.ОбъектУстановки,
		|	ТаблицаПриборыУчетаОтключение.ДатаОтключения,
		|	ЕСТЬNULL(NULL, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)),
		|	ЕСТЬNULL(NULL, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)),
		|	ЕСТЬNULL(NULL, """"),
		|	ЕСТЬNULL(NULL, """"),
		|	ЛОЖЬ,
		|	МАКСИМУМ(ТаблицаПриборыУчетаОтключение.СреднемесячноеПоказание)
		|ИЗ
		|	ВременнаяТаблицаПриборыУчета КАК ТаблицаПриборыУчетаОтключение
		|ГДЕ
		|	ТаблицаПриборыУчетаОтключение.ДатаОтключения <> &ПустаяДата
		|
		|СГРУППИРОВАТЬ ПО
		|	ТаблицаПриборыУчетаОтключение.ОбъектУстановки,
		|	ТаблицаПриборыУчетаОтключение.ДатаОтключения,
		|	ТаблицаПриборыУчетаОтключение.ПриборУчета";
	
	Запрос.УстановитьПараметр("ПустаяДата", '00010101');
	
	РезультатЗапроса = Запрос.Выполнить();
	
	СтруктураДополнительныеСвойства.ТаблицыДляДвижений.Вставить("ТаблицаУстановленныеПриборыУчета", РезультатЗапроса.Выгрузить());
	
КонецПроцедуры // СформироватьТаблицуУстановленныеПриборыУчета()

// Формирует таблицу значений, содержащую данные для проведения по регистру.
// Таблицы значений сохраняет в свойствах структуры "ДополнительныеСвойства".
//
Процедура СформироватьТаблицуПоказанияПриборовУчета(ДокументСсылкаУправлениеПриборамиУчета, СтруктураДополнительныеСвойства)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = СтруктураДополнительныеСвойства.ДляПроведения.СтруктураВременныеТаблицы.МенеджерВременныхТаблиц;
	
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ТаблицаПриборыУчетаПоказания.ПриборУчета КАК ПриборУчета,
		|	ТаблицаПриборыУчетаПоказания.ВидТарифа КАК ВидТарифа,
		|	ТаблицаПриборыУчетаПоказания.ДатаВключения,
		|	ТаблицаПриборыУчетаПоказания.ДатаОтключения,
		|	ТаблицаПриборыУчетаПоказания.ВидОперации КАК ВидОперации,
		|	ТаблицаПриборыУчетаПоказания.НачальноеПоказание,
		|	ТаблицаПриборыУчетаПоказания.КонечноеПоказание,
		|	ВЫБОР
		|		КОГДА ТаблицаПриборыУчетаПоказания.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийУправленияПриборамиУчета.ОтключениеНаПоверку)
		|				ИЛИ ТаблицаПриборыУчетаПоказания.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийУправленияПриборамиУчета.ОтключениеПрибораУчета)
		|			ТОГДА ТаблицаПриборыУчетаПоказания.ДатаОтключения
		|		ИНАЧЕ ТаблицаПриборыУчетаПоказания.ДатаВключения
		|	КОНЕЦ КАК Период,
		|	ВЫБОР
		|		КОГДА ТаблицаПриборыУчетаПоказания.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийУправленияПриборамиУчета.ОтключениеНаПоверку)
		|				ИЛИ ТаблицаПриборыУчетаПоказания.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийУправленияПриборамиУчета.ОтключениеПрибораУчета)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК Отключен,
		|	ВЫБОР
		|		КОГДА ТаблицаПриборыУчетаПоказания.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийУправленияПриборамиУчета.ОтключениеНаПоверку)
		|				ИЛИ ТаблицаПриборыУчетаПоказания.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийУправленияПриборамиУчета.ОтключениеПрибораУчета)
		|			ТОГДА ТаблицаПриборыУчетаПоказания.КонечноеПоказание
		|		ИНАЧЕ ТаблицаПриборыУчетаПоказания.НачальноеПоказание
		|	КОНЕЦ КАК Значение
		|ИЗ
		|	ВременнаяТаблицаПриборыУчета КАК ТаблицаПриборыУчетаПоказания
		|ГДЕ
		|	(ТаблицаПриборыУчетаПоказания.ДатаВключения <> &ПустаяДата
		|			ИЛИ ТаблицаПриборыУчетаПоказания.ДатаОтключения <> &ПустаяДата)";
	
	Запрос.УстановитьПараметр("ПустаяДата", '00010101');
	
	РезультатЗапроса = Запрос.Выполнить();
	
	СтруктураДополнительныеСвойства.ТаблицыДляДвижений.Вставить("ТаблицаПоказанияПриборовУчета", РезультатЗапроса.Выгрузить());
	
КонецПроцедуры // СформироватьТаблицуУстановленныеПриборыУчета()

Процедура СформироватьТаблицуПломбыПриборовУчета(ДокументСсылкаУправлениеПриборамиУчета, СтруктураДополнительныеСвойства)
	
