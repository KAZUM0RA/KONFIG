		|	ВременнаяТаблицаПриборыУчета КАК ТаблицаПриборыУчетаОтключение
		|ГДЕ
		|	ТаблицаПриборыУчетаОтключение.ДатаСледующейПоверки <> &ПустаяДата
		|
		|СГРУППИРОВАТЬ ПО
		|	ТаблицаПриборыУчетаОтключение.ПриборУчета,
		|	ТаблицаПриборыУчетаОтключение.ОбъектУстановки,
		|	ТаблицаПриборыУчетаОтключение.ДатаСледующейПоверки";
	
	Запрос.УстановитьПараметр("ПустаяДата", '00010101');
	
	РезультатЗапроса = Запрос.Выполнить();
	
	СтруктураДополнительныеСвойства.ТаблицыДляДвижений.Вставить("ТаблицаПоверкиПриборовУчета", РезультатЗапроса.Выгрузить());
	
КонецПроцедуры // СформироватьТаблицуУстановленныеПриборыУчета()

// Формирует таблицу значений, содержащую данные для проведения по регистру.
// Таблицы значений сохраняет в свойствах структуры "ДополнительныеСвойства".
//
Процедура СформироватьТаблицуЗаменыПриборовУчета(ДокументСсылкаУправлениеПриборамиУчета, СтруктураДополнительныеСвойства)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = СтруктураДополнительныеСвойства.ДляПроведения.СтруктураВременныеТаблицы.МенеджерВременныхТаблиц;
	
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ТаблицаЗаменыПриборовУчета.ДатаОтключения КАК Период,
		|	ТаблицаЗаменыПриборовУчета.ОбъектУстановки КАК ОбъектУстановки,
		|	ТаблицаЗаменыПриборовУчета.ПриборУчета КАК ПриборУчета,
		|	ТаблицаЗаменыПриборовУчета.ВидОперации КАК ВидОперации,
		|	ТаблицаЗаменыПриборовУчета.Услуга КАК Услуга,
		|	ТаблицаЗаменыПриборовУчета.ВидТарифа КАК ВидТарифа,
		|	ТаблицаЗаменыПриборовУчета.КонечноеПоказание КАК Показание,
		|	0 КАК ПоказаниеПредыдущее,
		|	ТаблицаЗаменыПриборовУчета.СреднемесячноеПоказание
		|ИЗ
		|	ВременнаяТаблицаПриборыУчета КАК ТаблицаЗаменыПриборовУчета
		|ГДЕ
		|	(ТаблицаЗаменыПриборовУчета.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийУправленияПриборамиУчета.ОтключениеПрибораУчета)
		|			ИЛИ ТаблицаЗаменыПриборовУчета.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийУправленияПриборамиУчета.ОтключениеНаПоверку))";	
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Для каждого Строка Из РезультатЗапроса Цикл
		ТаблицаПредыдущихПоказаний = РегистрыСведений.ПоказанияПриборовУчета.СрезПоследних(Новый Граница(Строка.Период, ВидГраницы.Исключая), Новый Структура("ПриборУчета", Строка.ПриборУчета));
		Если ТаблицаПредыдущихПоказаний.Количество() > 0 Тогда
			Строка.ПоказаниеПредыдущее = ТаблицаПредыдущихПоказаний[0].Значение;
		КонецЕсли; 
	КонецЦикла; 
	
	СтруктураДополнительныеСвойства.ТаблицыДляДвижений.Вставить("ТаблицаЗаменыПриборовУчета", РезультатЗапроса);
	
КонецПроцедуры // СформироватьТаблицуЗаменыПриборовУчета()

Процедура ИнициализироватьДанныеДокумента(ДокументСсылкаУправлениеПриборамиУчета, СтруктураДополнительныеСвойства) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = СтруктураДополнительныеСвойства.ДляПроведения.СтруктураВременныеТаблицы.МенеджерВременныхТаблиц;
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УправлениеПриборамиУчетаПриборыУчета.ПриборУчета,
	|	УправлениеПриборамиУчетаПриборыУчета.ДатаВключения,
	|	УправлениеПриборамиУчетаПриборыУчета.ДатаОтключения,
	|	УправлениеПриборамиУчетаПриборыУчета.НачальноеПоказание,
	|	УправлениеПриборамиУчетаПриборыУчета.КонечноеПоказание,
	|	УправлениеПриборамиУчетаПриборыУчета.ДатаПоследнейПоверки,
	|	УправлениеПриборамиУчетаПриборыУчета.ДатаСледующейПоверки,
	|	УправлениеПриборамиУчетаПриборыУчета.Ссылка.ВидОперации КАК ВидОперации,
	|	УправлениеПриборамиУчетаПриборыУчета.Ссылка.ОбъектУстановки КАК ОбъектУстановки,
	|	УправлениеПриборамиУчетаПриборыУчета.ПриборУчета.Услуга КАК Услуга,
	|	УправлениеПриборамиУчетаПриборыУчета.СреднемесячноеПоказание,
	|	УправлениеПриборамиУчетаПриборыУчета.ВидТарифа,
	|	УправлениеПриборамиУчетаПриборыУчета.ВидПломбы,
	|	УправлениеПриборамиУчетаПриборыУчета.СерийныйНомерПломбы КАК СерийныйНомер,
	|	УправлениеПриборамиУчетаПриборыУчета.ВидПломбыНовый,
	|	УправлениеПриборамиУчетаПриборыУчета.СерийныйНомерПломбыНовый КАК СерийныйНомерНовый,
	|	УправлениеПриборамиУчетаПриборыУчета.Ссылка.Дата,
	|	УправлениеПриборамиУчетаПриборыУчета.Ссылка.Организация,
	|	УправлениеПриборамиУчетаПриборыУчета.Ссылка.Здание,
	|	УправлениеПриборамиУчетаПриборыУчета.ТипПрибора,
	|	УправлениеПриборамиУчетаПриборыУчета.МестоРазмещения
	|ПОМЕСТИТЬ ВременнаяТаблицаПриборыУчета
	|ИЗ
	|	Документ.УправлениеПриборамиУчета.ПриборыУчета КАК УправлениеПриборамиУчетаПриборыУчета
	|ГДЕ
	|	УправлениеПриборамиУчетаПриборыУчета.Ссылка = &Ссылка"; 
	 
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылкаУправлениеПриборамиУчета);
	РезультатЗапроса = Запрос.Выполнить();
	
	Если ДокументСсылкаУправлениеПриборамиУчета.ВидОперации <>  Перечисления.ВидыОперацийУправленияПриборамиУчета.ЗаменаПломбы Тогда
		СформироватьТаблицуУстановленныеПриборыУчета(ДокументСсылкаУправлениеПриборамиУчета, СтруктураДополнительныеСвойства);
		СформироватьТаблицуПоказанияПриборовУчета(ДокументСсылкаУправлениеПриборамиУчета, СтруктураДополнительныеСвойства);
		СформироватьТаблицуПоверкиПриборовУчета(ДокументСсылкаУправлениеПриборамиУчета, СтруктураДополнительныеСвойства);
		СформироватьТаблицуЗаменыПриборовУчета(ДокументСсылкаУправлениеПриборамиУчета, СтруктураДополнительныеСвойства);
		СформироватьТаблицуПломбыПриборовУчета(ДокументСсылкаУправлениеПриборамиУчета, СтруктураДополнительныеСвойства);
	Иначе	
		СформироватьТаблицуЗаменыПломбыПриборовУчета(ДокументСсылкаУправлениеПриборамиУчета, СтруктураДополнительныеСвойства);
	КонецЕсли;	
КонецПроцедуры
