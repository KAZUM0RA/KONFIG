	Запрос.Текст =
		"ВЫБРАТЬ
		|	ТаблицаПриборыУчетаПоказания.ПриборУчета КАК ПриборУчета,
		|	ВЫБОР
		|		КОГДА ТаблицаПриборыУчетаПоказания.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийУправленияПриборамиУчета.ОтключениеНаПоверку)
		|				ИЛИ ТаблицаПриборыУчетаПоказания.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийУправленияПриборамиУчета.ОтключениеПрибораУчета)
		|			ТОГДА ТаблицаПриборыУчетаПоказания.ДатаОтключения
		|		ИНАЧЕ ТаблицаПриборыУчетаПоказания.ДатаВключения
		|	КОНЕЦ КАК Период,
		|	ВЫБОР
		|		КОГДА ТаблицаПриборыУчетаПоказания.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийУправленияПриборамиУчета.ОтключениеНаПоверку)
		|				ИЛИ ТаблицаПриборыУчетаПоказания.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийУправленияПриборамиУчета.ОтключениеПрибораУчета)
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК Действует,
		|	МАКСИМУМ(ТаблицаПриборыУчетаПоказания.ВидПломбы) КАК ВидПломбы,
		|	МАКСИМУМ(ТаблицаПриборыУчетаПоказания.СерийныйНомер) КАК СерийныйНомер,
		|	ТаблицаПриборыУчетаПоказания.ОбъектУстановки КАК ЛицевойСчет,
		|	ТаблицаПриборыУчетаПоказания.Здание,
		|	ТаблицаПриборыУчетаПоказания.Организация
		|ИЗ
		|	ВременнаяТаблицаПриборыУчета КАК ТаблицаПриборыУчетаПоказания
		|ГДЕ
		|	(ТаблицаПриборыУчетаПоказания.ДатаВключения <> &ПустаяДата
		|			ИЛИ ТаблицаПриборыУчетаПоказания.ДатаОтключения <> &ПустаяДата)
		|	И ТаблицаПриборыУчетаПоказания.ВидПломбы <> &ВидПломбы
		|
		|СГРУППИРОВАТЬ ПО
		|	ТаблицаПриборыУчетаПоказания.ПриборУчета,
		|	ТаблицаПриборыУчетаПоказания.ОбъектУстановки,
		|	ТаблицаПриборыУчетаПоказания.Здание,
		|	ТаблицаПриборыУчетаПоказания.Организация,
		|	ВЫБОР
		|		КОГДА ТаблицаПриборыУчетаПоказания.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийУправленияПриборамиУчета.ОтключениеНаПоверку)
		|				ИЛИ ТаблицаПриборыУчетаПоказания.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийУправленияПриборамиУчета.ОтключениеПрибораУчета)
		|			ТОГДА ТаблицаПриборыУчетаПоказания.ДатаОтключения
		|		ИНАЧЕ ТаблицаПриборыУчетаПоказания.ДатаВключения
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА ТаблицаПриборыУчетаПоказания.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийУправленияПриборамиУчета.ОтключениеНаПоверку)
		|				ИЛИ ТаблицаПриборыУчетаПоказания.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийУправленияПриборамиУчета.ОтключениеПрибораУчета)
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ";
	
	Запрос.УстановитьПараметр("ПустаяДата", '00010101');
	Запрос.УстановитьПараметр("ВидПломбы", Справочники.ВидыПломбПриборовУчета.ПустаяСсылка());

	
	РезультатЗапроса = Запрос.Выполнить();
	
	СтруктураДополнительныеСвойства.ТаблицыДляДвижений.Вставить("ПломбыПриборовУчета", РезультатЗапроса.Выгрузить());
	
КонецПроцедуры // СформироватьТаблицуУстановленныеПриборыУчета()

