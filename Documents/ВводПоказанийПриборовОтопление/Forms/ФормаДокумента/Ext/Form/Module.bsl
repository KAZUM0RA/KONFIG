&НаСервере
Функция ПолучитьСписокПриборов(ЛицевойСчет)
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	УстановленныеПриборыУчетаСрезПоследних.ПриборУчета.ЗаводскойНомер КАК ЗаводскойНомер,
		|	УстановленныеПриборыУчетаСрезПоследних.ПриборУчета,
		|	ПоказанияПриборовУчетаСрезПоследних.Значение,
		|	УстановленныеПриборыУчетаСрезПоследних.ПриборУчета.Услуга КАК Услуга
		|ИЗ
		|	РегистрСведений.ПоказанияПриборовУчета.СрезПоследних(&НаДату, ) КАК ПоказанияПриборовУчетаСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.УстановленныеПриборыУчета.СрезПоследних(&НаДату, ОбъектУстановки = &ОбъектУстановки) КАК УстановленныеПриборыУчетаСрезПоследних
		|		ПО (УстановленныеПриборыУчетаСрезПоследних.ПриборУчета = ПоказанияПриборовУчетаСрезПоследних.ПриборУчета)";
	Запрос.УстановитьПараметр("НаДату", Новый Граница(ТекущаяДата(), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("ОбъектУстановки", ЛицевойСчет);
	Список = Запрос.Выполнить().Выгрузить();

	Возврат Список;
КонецФункции

&НаСервере
Функция ПоказанияПриборовУчета(ПриборУчета, ЛицевойСчет)
	Запрос = Новый Запрос;
	Запрос.Текст =
	    "ВЫБРАТЬ
	    |	МАКСИМУМ(ПоказанияПриборовУчетаСрезПоследних.Значение) КАК Значение
	    |ИЗ
	    |	РегистрСведений.ПоказанияПриборовУчета.СрезПоследних(&НаДату, ПриборУчета = &ПриборУчета) КАК ПоказанияПриборовУчетаСрезПоследних
	    |ГДЕ
	    |	ПоказанияПриборовУчетаСрезПоследних.Отключен = ЛОЖЬ
	    |
	    |СГРУППИРОВАТЬ ПО
	    |	ПоказанияПриборовУчетаСрезПоследних.ПриборУчета";
    Запрос.УстановитьПараметр("НаДату", Новый Граница(ТекущаяДата(), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("ПриборУчета", ПриборУчета);
	//Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		Значение = Выборка.Значение;
	КонецЦикла;
	Возврат Значение;
КонецФункции

&НаСервере
Функция ПолучитьСуммуПредварительногоРассчета(ЛицевойСчет, Услуга, КвоКубов, ВидТарифа)
	Сумма = 0;
	ЗапросТариф = Новый Запрос;
	ЗапросТариф.Текст = 
	    "ВЫБРАТЬ
	    |	ТарифыСрезПоследних.ЗначениеТарифа
	    |ИЗ
	    |	РегистрСведений.Тарифы.СрезПоследних(
	    |			&НаДату,
	    |			Услуга = &Услуга
	    |				И Здание = &Здание
	    |				И ВидТарифа = &ВидТарифа) КАК ТарифыСрезПоследних";
	ЗапросТариф.УстановитьПараметр("НаДату", ТекущаяДата());
	ЗапросТариф.УстановитьПараметр("Услуга", Услуга);
	ЗапросТариф.УстановитьПараметр("Здание", ЛицевойСчет.Владелец);
	ЗапросТариф.УстановитьПараметр("ВидТарифа", Перечисления.ВидыТарифов.Общий);
	Результат = ЗапросТариф.Выполнить();
	Если НЕ Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл
			Тариф = Выборка.ЗначениеТарифа;
		КонецЦикла;
	Иначе
		Сообщить("Тариф не знайдено!");
		Возврат 0;
	КонецЕсли;
	Сумма = Тариф * КвоКубов;
	Возврат Сумма;
КонецФункции