&НаСервере
Процедура ЛицевойСчетПриИзмененииНаСервере()
	//Объект.ПриборыУчета.Очистить();
	////Получим установленные приборы по данному лицевому счету
	//ПриборыУчета = ПолучитьСписокПриборов(Объект.ЛицевойСчет);
	Объект.Здание = Объект.ЛицевойСчет.Владелец;
	Объект.Ответственный = ПараметрыСеанса.ТекущийПользователь;
	Объект.ПериодНачисления = ТекущаяДата();
	//Для Каждого стр Из ПриборыУчета Цикл
	//    НовСтрока = Объект.ПриборыУчета.Добавить();
	//	НовСтрока.ПриборУчета          = стр.ПриборУчета;
	//	ПоказанияПрибора               = ПоказанияПриборовУчета(стр.ПриборУчета, Объект.ЛицевойСчет);
	//	Если ПоказанияПрибора = Неопределено Тогда
	//		НовСтрока.ПредыдущиеПоказания = стр.Значение;
	//	Иначе
	//	    НовСтрока.ПредыдущиеПоказания = стр.Значение;
	//	КонецЕсли;
	//	НовСтрока.Услуга               = стр.Услуга;
	//	НовСтрока.ВидТарифа            = Перечисления.ВидыТарифов.Общий;
	//	НовСтрока.Источник             = Перечисления.ИсточникиПоказаний.РучнаяОперация;
	//КонецЦикла;
	
	Объект.ПриборыУчета.Очистить();
	
	АдресЛицевыхСчетовВХранилище = Неопределено; ИндивидуальныйВвод = Истина;
	
	Запрос = Новый Запрос;
	Если АдресЛицевыхСчетовВХранилище <> Неопределено Тогда
		ТаблицаДляЗагрузки	= ПолучитьИзВременногоХранилища(АдресЛицевыхСчетовВХранилище);
	
		МассивОбъектовУстановки = ТаблицаДляЗагрузки.ВыгрузитьКолонку("ЛицевойСчет");
		
		ТекстЗапросаДоб = "	И УстановленныеПриборыУчетаСрезПоследних.ОбъектУстановки В(&МассивОбъектовУстановки)";
		Запрос.УстановитьПараметр("МассивОбъектовУстановки", МассивОбъектовУстановки);
	ИначеЕсли ИндивидуальныйВвод Тогда
		МассивОбъектовУстановки = Новый Массив;
		МассивОбъектовУстановки.Добавить(Объект.ЛицевойСчет);
		
		ТекстЗапросаДоб = "	И УстановленныеПриборыУчетаСрезПоследних.ОбъектУстановки В(&МассивОбъектовУстановки)";
		Запрос.УстановитьПараметр("МассивОбъектовУстановки", МассивОбъектовУстановки);
	Иначе
		ТекстЗапросаДоб = "";
	КонецЕсли;	

	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	УстановленныеПриборыУчетаСрезПоследних.ОбъектУстановки КАК ЛицевойСчет,
		|	УстановленныеПриборыУчетаСрезПоследних.ПриборУчета,
		|	УстановленныеПриборыУчетаСрезПоследних.ОбъектУстановки.ОбъектЛицевогоСчета КАК Квартира,
		|	УстановленныеПриборыУчетаСрезПоследних.ОбъектУстановки.ОбъектЛицевогоСчета.Владелец КАК Здание,
		|	УстановленныеПриборыУчетаСрезПоследних.ПриборУчета.Коэффициент КАК Коэффициент,
		|	ЕСТЬNULL(УслугиВидыТарифов.ВидТарифа, ЗНАЧЕНИЕ(Перечисление.ВидыТарифов.Общий)) КАК ВидТарифа,
		|	ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ОтветственныйВладелец
		|ИЗ
		|	РегистрСведений.УстановленныеПриборыУчета.СрезПоследних(&ДатаСреза, ПриборУчета.Услуга = &Услуга) КАК УстановленныеПриборыУчетаСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Услуги.ВидыТарифов КАК УслугиВидыТарифов
		|		ПО УстановленныеПриборыУчетаСрезПоследних.ПриборУчета.Услуга = УслугиВидыТарифов.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОтветственныйВладелецЛицевогоСчета.СрезПоследних КАК ОтветственныйВладелецЛицевогоСчетаСрезПоследних
		|		ПО УстановленныеПриборыУчетаСрезПоследних.ОбъектУстановки = ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ЛицевойСчет
		|ГДЕ
		|	УстановленныеПриборыУчетаСрезПоследних.Действует = ИСТИНА"+ТекстЗапросаДоб;
	
	Запрос.УстановитьПараметр("ДатаСреза", НачалоДня(Объект.Дата));
	Если ЗначениеЗаполнено(Объект.Услуга) Тогда
		Запрос.УстановитьПараметр("Услуга", Объект.Услуга);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"ПриборУчета.Услуга = &Услуга","");
	КонецЕсли;	
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ТЗ_Заполнения = РезультатЗапроса.Выгрузить();
	ТЗ_Заполнения.Колонки.Добавить("Услуга");
	ТЗ_Заполнения.Колонки.Добавить("ПредыдущиеПоказания");
	ТЗ_Заполнения.Колонки.Добавить("Источник");
	Для Каждого стрТЗ Из ТЗ_Заполнения Цикл
		стрТЗ.Услуга = стрТЗ.ПриборУчета.Услуга;
		стрТЗ.Источник = Перечисления.ИсточникиПоказаний.РучнаяОперация;
		стрТЗ.ПредыдущиеПоказания = ПоказанияПриборовУчета(стрТЗ.ПриборУчета, Объект.ЛицевойСчет);
	КонецЦикла;
	
	Объект.ПриборыУчета.Загрузить(ТЗ_Заполнения)
КонецПроцедуры

&НаКлиенте
Процедура ЛицевойСчетПриИзменении(Элемент)
	ЛицевойСчетПриИзмененииНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ПриборыУчетаТекущиеПоказателиПриИзменении(Элемент)
	ТекСтрока = Элементы.ПриборыУчета.ТекущиеДанные;
	Если ТекСтрока.ТекущиеПоказания < ТекСтрока.ПредыдущиеПоказания Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru = 'Текущий показатель меньше или равен предыдущему показателю!'; uk = 'Поточний показник меньше, або дорівнює попередньому показнику!'");
		Сообщение.Сообщить();
	Иначе
	    ТекСтрока.КвоКубов = ТекСтрока.ТекущиеПоказания - ТекСтрока.ПредыдущиеПоказания;
		ТекСтрока.ПредварительныйРассчет = ПолучитьСуммуПредварительногоРассчета(Объект.ЛицевойСчет, ТекСтрока.Услуга, ТекСтрока.КвоКубов, ТекСтрока.ВидТарифа);
	КонецЕсли;
КонецПроцедуры



