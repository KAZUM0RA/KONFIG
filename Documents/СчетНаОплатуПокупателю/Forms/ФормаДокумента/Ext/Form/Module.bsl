&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Объект.Организация = Справочники.Организации.НайтиПоКоду("000000001");
	Объект.АвторасчетНДС = Истина;
	Объект.СуммаВключаетНДС = Истина;
