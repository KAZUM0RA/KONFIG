// ПРОЦЕДУРЫ - ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

// Процедура - обработчик события ПриСозданииНаСервере.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОСМДСервер.ЗаполнитьШапкуДокумента(
		Объект,
		,
		Параметры.ЗначениеКопирования,
		Параметры.Основание,
		СостояниеДокумента,
		КартинкаСостоянияДокумента,
		РазрешеноПроведение,
		ПоследнееИзменение,
		Параметры.ЗначенияЗаполнения);
	
 	// ДополнительныеОтчетыИОбработки
	ДополнительныеОтчетыИОбработки.ПриСозданииНаСервере(ЭтаФорма);
	// Конец ДополнительныеОтчетыИОбработки

КонецПроцедуры

// Процедура - обработчик события ПередЗаписью.
//
&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Дубли = ПроверитьДублиСтрок();
	
	Если Дубли Тогда
		
		Сообщить(НСтр("ru='Запись документа отменена! Удалите дублирующиеся строки.';uk='Запис документу скасований! Видаліть рядки, що дублюються.'"));
		Отказ = Истина;
		
	КонецЕсли;
		
КонецПроцедуры

// Процедура - обработчик события ПослеЗаписи.
//
&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	ОСМДКлиент.ОбновитьСостояниеДокумента(Объект, СостояниеДокумента, КартинкаСостоянияДокумента, РазрешеноПроведение, ПоследнееИзменение);
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ - ДЕЙСТВИЯ КОМАНДНЫХ ПАНЕЛЕЙ ТАБЛИЧНЫХ ЧАСТЕЙ ФОРМЫ

// Процедура - обработчик нажатия на кнопку ЗаполнитьПоВсейНоменклатуре.
//
&НаКлиенте
Процедура ЗаполнитьПоВсейНоменклатуре(Команда)
	
	Ответ = Вопрос(НСтр("ru='Табличная часть будет очищена! Продолжить выполнение операции?';uk='Таблична частина буде очищена! Продовжити виконання операції?'"), РежимДиалогаВопрос.ДаНет, 0);
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ТипЦенЗаполнения = Объект.ТипЦен;
	
	Если ЗначениеЗаполнено(ТипЦенЗаполнения) Тогда
		ЗаполнитьЦеныТабличнойЧастиПоВсейНоменклатуре(ТипЦенЗаполнения);
	Иначе
		Предупреждение("Таблица не может быть заполнена! Укажите тип цены.");
	КонецЕсли;

КонецПроцедуры

// Процедура - обработчик нажатия на кнопку ЗаполнитьПоПоступлениюТоваровИУслуг.
//
&НаКлиенте
Процедура ЗаполнитьПоПоступлениюТоваровИУслуг(Команда)
	
	Ответ = Вопрос(НСтр("ru='Табличная часть будет очищена! Продолжить выполнение операции?';uk='Таблична частина буде очищена! Продовжити виконання операції?'"), РежимДиалогаВопрос.ДаНет, 0);
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ПоступлениеЗапасовИУслуг = ОткрытьФормуМодально("Документ.ПоступлениеЗапасовУслуг.Форма.ФормаВыбора");
	
	Если ЗначениеЗаполнено(ПоступлениеЗапасовИУслуг) Тогда
		ЗаполнитьЦеныТабличнойЧастиПоПоступлениюТоваровИУслуг(ПоступлениеЗапасовИУслуг);
	КонецЕсли;

КонецПроцедуры

// Процедура - обработчик нажатия на кнопку ЗаполнитьПоГруппеНоменклатуры.
//
&НаКлиенте
Процедура ЗаполнитьПоГруппеНоменклатуры(Команда)
	
	Ответ = Вопрос(НСтр("ru='Табличная часть будет очищена! Продолжить выполнение операции?';uk='Таблична частина буде очищена! Продовжити виконання операції?'"), РежимДиалогаВопрос.ДаНет, 0);
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ГруппаНоменклатуры = ОткрытьФормуМодально("Справочник.Номенклатура.Форма.ФормаВыбораГруппы");
	ТипЦенЗаполнения = Объект.ТипЦен;
	
	Если ЗначениеЗаполнено(ГруппаНоменклатуры) И ЗначениеЗаполнено(ТипЦенЗаполнения) Тогда
		ЗаполнитьЦеныТабличнойЧастиПоГруппеНоменклатуры(ГруппаНоменклатуры, ТипЦенЗаполнения);
	Иначе
		Предупреждение("Таблица не может быть заполнена! Укажите тип цены.");
	КонецЕсли;

КонецПроцедуры

// Процедура - обработчик нажатия на кнопку Очистить.
//
&НаКлиенте
Процедура ОчиститьТаблицу(Команда)
	
	Объект.Запасы.Очистить();
	
КонецПроцедуры

// Процедура - обработчик нажатия на кнопку СнятьПометки.
//
&НаКлиенте
Процедура СнятьПометки(Команда)
	
	 Для каждого Строка Из Объект.Запасы Цикл
	 
	 	 Строка.Пометка = Ложь;
	 
	 КонецЦикла;
	 
КонецПроцедуры

// Процедура - обработчик нажатия на кнопку ПоставитьПометки.
//
&НаКлиенте
Процедура ПоставитьПометки(Команда)
	
	 Для каждого Строка Из Объект.Запасы Цикл
	 
	 	 Строка.Пометка = Истина;
	 
	 КонецЦикла;

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ - ДЕЙСТВИЯ КОМАНД ДЛЯ ИЗМЕНЕНИЯ ЦЕН

// Процедура - обработчик нажатия на кнопку ИзменитьНаПроцент.
//
&НаКлиенте
Процедура ИзменитьНаПроцент(Команда)
	
	ТекущаяФормула = "ИзменитьНаПроцент";
	Элементы.ФормулаСумма.Видимость = Ложь;
	Элементы.ФормулаПроцент.Видимость = Истина;
	
КонецПроцедуры

// Процедура - обработчик нажатия на кнопку ИзменитьНаСумму.
//
&НаКлиенте
Процедура ИзменитьНаСумму(Команда)
	
	ТекущаяФормула = "ИзменитьНаСумму";
	Элементы.ФормулаСумма.Видимость = Истина;
	Элементы.ФормулаПроцент.Видимость = Ложь;

КонецПроцедуры

// Процедура - обработчик нажатия на кнопку Выполнить.
//
&НаКлиенте
Процедура Изменить(Команда)
	
	Для каждого Строка Из Объект.Запасы Цикл
		
		Если Строка.Пометка Тогда
			
			Если ТекущаяФормула = "ИзменитьНаСумму" И Знак="+" Тогда
				
				Строка.Цена = Строка.Цена + Сумма;
				
			ИначеЕсли ТекущаяФормула = "ИзменитьНаСумму" И Знак="-" Тогда
				
				Строка.Цена = Строка.Цена - Сумма;
				
			ИначеЕсли ТекущаяФормула = "ИзменитьНаПроцент" И Знак="+" Тогда
				
				Строка.Цена = Строка.Цена + (Строка.Цена*Процент/100);
				
			ИначеЕсли ТекущаяФормула = "ИзменитьНаПроцент" И Знак="-" Тогда
				
				Строка.Цена = Строка.Цена - (Строка.Цена*(Процент*0.01));
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры





