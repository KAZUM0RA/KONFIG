
////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ И ФУНКЦИИ ОБЩЕГО НАЗНАЧЕНИЯ

// Процедура заполняет табличную часть "Запасы" по всей номенклатуре.
//
&НаСервере
Процедура ЗаполнитьЦеныТабличнойЧастиПоВсейНоменклатуре(ТипЦены)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	НоменклатураСправочник.Ссылка КАК Номенклатура,
		|	ЦеныНоменклатурыСрезПоследних.Цена КАК Цена
		|ИЗ
		|	Справочник.Номенклатура КАК НоменклатураСправочник
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних КАК ЦеныНоменклатурыСрезПоследних
		|		ПО НоменклатураСправочник.Ссылка = ЦеныНоменклатурыСрезПоследних.Номенклатура.Ссылка
		|			И (ЦеныНоменклатурыСрезПоследних.ТипЦены = &ТипЦены)
		|ГДЕ
		|	НоменклатураСправочник.ЭтоГруппа = ЛОЖЬ";
		
	Запрос.УстановитьПараметр("ТипЦены", ТипЦены);	
		
	Результат = Запрос.Выполнить();

	Выборка = Результат.Выбрать();
    Объект.Запасы.Очистить();

	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока = Объект.Запасы.Добавить();
		НоваяСтрока.Номенклатура = Выборка.Номенклатура;
		НоваяСтрока.Цена = Выборка.Цена;
		НоваяСтрока.Пометка = Истина;

	КонецЦикла;


КонецПроцедуры // ПерезаполнитьЦеныТабличнойЧастиПоВидуЦен()

// Процедура заполняет табличную часть "Запасы" по документу "ПоступлениеЗапасовИУслуг" 
//
&НаСервере
Процедура ЗаполнитьЦеныТабличнойЧастиПоПоступлениюТоваровИУслуг(Документ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПоступлениеЗапасовУслугЗапасы.Номенклатура,
		|	ПоступлениеЗапасовУслугЗапасы.Цена
		|ИЗ
		|	Документ.ПоступлениеЗапасовУслуг.Запасы КАК ПоступлениеЗапасовУслугЗапасы
		|ГДЕ
		|	ПоступлениеЗапасовУслугЗапасы.Ссылка = &Ссылка";

	Запрос.УстановитьПараметр("Ссылка", Документ);

	Результат = Запрос.Выполнить();

	Выборка = Результат.Выбрать();
	Объект.Запасы.Очистить();
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока = Объект.Запасы.Добавить();
		НоваяСтрока.Номенклатура = Выборка.Номенклатура;
		НоваяСтрока.Цена = Выборка.Цена;
		НоваяСтрока.Пометка = Истина;

	КонецЦикла;
	
КонецПроцедуры

// Процедура заполняет табличную часть "Запасы" по группе номенклатуре.
//
&НаСервере
Процедура ЗаполнитьЦеныТабличнойЧастиПоГруппеНоменклатуры(ГруппаНоменклатуры, ТипЦены)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	НоменклатураСправочник.Ссылка КАК Номенклатура,
		|	ЦеныНоменклатурыСрезПоследних.Цена КАК Цена
		|ИЗ
		|	Справочник.Номенклатура КАК НоменклатураСправочник
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних КАК ЦеныНоменклатурыСрезПоследних
		|		ПО НоменклатураСправочник.Ссылка = ЦеныНоменклатурыСрезПоследних.Номенклатура.Ссылка
		|			И (ЦеныНоменклатурыСрезПоследних.ТипЦены = &ТипЦены)
		|ГДЕ
		|	НоменклатураСправочник.Родитель В ИЕРАРХИИ(&Родитель)
		|	И НоменклатураСправочник.ЭтоГруппа = ЛОЖЬ";
		
	Запрос.УстановитьПараметр("ТипЦены", ТипЦены);
	Запрос.УстановитьПараметр("Родитель", ГруппаНоменклатуры);

	Результат = Запрос.Выполнить();

	Выборка = Результат.Выбрать();
    Объект.Запасы.Очистить();

	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока = Объект.Запасы.Добавить();
		НоваяСтрока.Номенклатура = Выборка.Номенклатура;
		НоваяСтрока.Цена = Выборка.Цена;
		НоваяСтрока.Пометка = Истина;

	КонецЦикла;
	
КонецПроцедуры

// Возвращает истину если есть дублирующиеся строки.
//
&НаСервере
Функция ПроверитьДублиСтрок()
	
	Таблица = Объект.Запасы.Выгрузить();
	ТаблицаНоменклатуры = Таблица.Скопировать(,"Номенклатура,Цена");
	Менеджер=Новый МенеджерВременныхТаблиц;
	Запрос=Новый Запрос;
	Запрос.Текст=
	"ВЫБРАТЬ
	|    ТаблицаНоменклатуры.Номенклатура,
	|    ТаблицаНоменклатуры.Цена
	|ПОМЕСТИТЬ ТаблицаНоменклатуры
	|ИЗ
	|    &ТаблицаНоменклатуры КАК ТаблицаНоменклатуры";
	Запрос.УстановитьПараметр("ТаблицаНоменклатуры",ТаблицаНоменклатуры);
	Запрос.МенеджерВременныхТаблиц=Менеджер;
	Результат=Запрос.Выполнить();
	Запрос.Текст=
	"ВЫБРАТЬ
	|	ВложенныйЗапрос.Номенклатура,
	|	ВложенныйЗапрос.Счетчик
	|ИЗ
	|	(ВЫБРАТЬ
	|		ТаблицаНоменклатуры.Номенклатура КАК Номенклатура,
	|		СУММА(1) КАК Счетчик
	|	ИЗ
	|		ТаблицаНоменклатуры КАК ТаблицаНоменклатуры
	|	
	|	СГРУППИРОВАТЬ ПО
	|		ТаблицаНоменклатуры.Номенклатура) КАК ВложенныйЗапрос
	|ГДЕ
	|	ВложенныйЗапрос.Счетчик > 1";
	
	Результат=Запрос.Выполнить();
	
	Выборка = Результат.Выбрать();
	Дубли = Ложь;
	Пока Выборка.Следующий() Цикл
		
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = НСтр("ru='Дублируется строка: %Номенклатура%!';uk='Дублюється рядок: %Номенклатура%!'");
		Сообщение.Текст = СтрЗаменить(Сообщение.Текст, "%Номенклатура%", Выборка.Номенклатура);
		Сообщение.Сообщить();
		Дубли = Истина;
		
	КонецЦикла;
		
	Возврат Дубли;
		
КонецФункции

