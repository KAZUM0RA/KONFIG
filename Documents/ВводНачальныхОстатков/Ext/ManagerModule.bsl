Процедура ИнициализироватьДанныеВзаиморасчетыСКонтрагентами(ДокументСсылкаВводНачальныхОстатков, СтруктураДополнительныеСвойства)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
		|	ВводНачальныхОстатковВзаиморасчетыСКонтрагентами.Ссылка.Дата КАК Период,
		|	ВводНачальныхОстатковВзаиморасчетыСКонтрагентами.Ссылка.Организация,
		|	ВводНачальныхОстатковВзаиморасчетыСКонтрагентами.Контрагент,
		|	СУММА(ВводНачальныхОстатковВзаиморасчетыСКонтрагентами.Сумма) КАК СуммаВзаиморасчетов,
		|	ВводНачальныхОстатковВзаиморасчетыСКонтрагентами.ДоговорКонтрагента,
		|	МИНИМУМ(ВводНачальныхОстатковВзаиморасчетыСКонтрагентами.НомерСтроки) КАК НомерСтроки,
		|	ВводНачальныхОстатковВзаиморасчетыСКонтрагентами.ВидВзаиморасчетов КАК ВидНоменклатуры
		|ИЗ
		|	Документ.ВводНачальныхОстатков.ВзаиморасчетыСКонтрагентами КАК ВводНачальныхОстатковВзаиморасчетыСКонтрагентами
		|ГДЕ
		|	ВводНачальныхОстатковВзаиморасчетыСКонтрагентами.Ссылка = &Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	ВводНачальныхОстатковВзаиморасчетыСКонтрагентами.Ссылка.Организация,
		|	ВводНачальныхОстатковВзаиморасчетыСКонтрагентами.Контрагент,
		|	ВводНачальныхОстатковВзаиморасчетыСКонтрагентами.ДоговорКонтрагента,
		|	ВводНачальныхОстатковВзаиморасчетыСКонтрагентами.Ссылка.Дата,
		|	ВводНачальныхОстатковВзаиморасчетыСКонтрагентами.ВидВзаиморасчетов
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки";	
	
	
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылкаВводНачальныхОстатков);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	СтруктураДополнительныеСвойства.ТаблицыДляДвижений.Вставить("ТаблицаВзаиморасчетыСКонтрагентами", РезультатЗапроса.Выгрузить());
	
КонецПроцедуры

