
// Формирует таблицу значений, содержащую данные для проведения по регистру.
// Таблицы значений сохраняет в свойствах структуры "ДополнительныеСвойства".
//
Процедура ИнициализироватьДанныеЛицевыеСчета(ДокументСсылкаВводНачальныхОстатков, СтруктураДополнительныеСвойства)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА ВводНачальныхОстатковЛицевыеСчета.МесяцНачисления = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
		|			ТОГДА ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		|		ИНАЧЕ ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|	КОНЕЦ КАК ВидДвижения,
		|	ВводНачальныхОстатковЛицевыеСчета.ЛицевойСчет,
		|	ВводНачальныхОстатковЛицевыеСчета.Услуга,
		|	ВводНачальныхОстатковЛицевыеСчета.МесяцНачисления,
		|	СУММА(ВЫБОР
		|			КОГДА ВводНачальныхОстатковЛицевыеСчета.МесяцНачисления = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
		|				ТОГДА ВводНачальныхОстатковЛицевыеСчета.Сумма
		|			ИНАЧЕ ВводНачальныхОстатковЛицевыеСчета.Сумма
		|		КОНЕЦ) КАК Сумма,
		|	ВЫБОР
		|		КОГДА НЕ ВводНачальныхОстатковЛицевыеСчета.Услуга.Организация = ЗНАЧЕНИЕ(Справочник.Организации.Пустаяссылка)
		|			ТОГДА ВводНачальныхОстатковЛицевыеСчета.Услуга.Организация
		|		ИНАЧЕ ВводНачальныхОстатковЛицевыеСчета.ЛицевойСчет.Владелец.Организация
		|	КОНЕЦ КАК Организация,
		|	ВводНачальныхОстатковЛицевыеСчета.Ссылка.Дата КАК Период,
		|	МИНИМУМ(ВводНачальныхОстатковЛицевыеСчета.НомерСтроки) КАК НомерСтроки
		|ИЗ
		|	Документ.ВводНачальныхОстатков.ЛицевыеСчета КАК ВводНачальныхОстатковЛицевыеСчета
		|ГДЕ
		|	ВводНачальныхОстатковЛицевыеСчета.Ссылка = &Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	ВводНачальныхОстатковЛицевыеСчета.ЛицевойСчет,
		|	ВводНачальныхОстатковЛицевыеСчета.Услуга,
		|	ВводНачальныхОстатковЛицевыеСчета.МесяцНачисления,
		|	ВводНачальныхОстатковЛицевыеСчета.Ссылка.Дата,
		|	ВЫБОР
		|		КОГДА НЕ ВводНачальныхОстатковЛицевыеСчета.Услуга.Организация = ЗНАЧЕНИЕ(Справочник.Организации.Пустаяссылка)
		|			ТОГДА ВводНачальныхОстатковЛицевыеСчета.Услуга.Организация
		|		ИНАЧЕ ВводНачальныхОстатковЛицевыеСчета.ЛицевойСчет.Владелец.Организация
		|	КОНЕЦ
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки";
	
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылкаВводНачальныхОстатков);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	СтруктураДополнительныеСвойства.ТаблицыДляДвижений.Вставить("ТаблицаРасчетыПоЛицевымСчетам", РезультатЗапроса.Выгрузить());
	
КонецПроцедуры

// Формирует таблицу значений, содержащую данные для проведения по регистру.
// Таблицы значений сохраняет в свойствах структуры "ДополнительныеСвойства".
//
Процедура ИнициализироватьДанныеЗапасы(ДокументСсылкаВводНачальныхОстатков, СтруктураДополнительныеСвойства)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
		|	ВводНачальныхОстатковЗапасы.Ссылка.Организация,
		|	ВводНачальныхОстатковЗапасы.Ссылка.Дата КАК Период,
		|	ВводНачальныхОстатковЗапасы.Склад,
		|	ВводНачальныхОстатковЗапасы.Номенклатура,
		|	ВводНачальныхОстатковЗапасы.Количество,
		|	МИНИМУМ(ВводНачальныхОстатковЗапасы.НомерСтроки) КАК НомерСтроки
		|ИЗ
		|	Документ.ВводНачальныхОстатков.Запасы КАК ВводНачальныхОстатковЗапасы
		|ГДЕ
		|	ВводНачальныхОстатковЗапасы.Ссылка = &Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	ВводНачальныхОстатковЗапасы.Ссылка.Организация,
		|	ВводНачальныхОстатковЗапасы.Номенклатура,
		|	ВводНачальныхОстатковЗапасы.Склад,
		|	ВводНачальныхОстатковЗапасы.Ссылка.Дата,
		|	ВводНачальныхОстатковЗапасы.Количество
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки";	
	
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылкаВводНачальныхОстатков);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	СтруктураДополнительныеСвойства.ТаблицыДляДвижений.Вставить("ТаблицаЗапасыНаСкладах", РезультатЗапроса.Выгрузить());
	
КонецПроцедуры

