&НаСервере
Функция НайтиЛицевойСчетПоЗданию(Здание)
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ОткрытиеЛицевогоСчета.ЛицевойСчет КАК ЛицевойСчет
		|ИЗ
		|	Документ.ОткрытиеЛицевогоСчета КАК ОткрытиеЛицевогоСчета
		|ГДЕ
		|	ОткрытиеЛицевогоСчета.Здание = &Здание";
	Запрос.УстановитьПараметр("Здание", Здание);
	Результат = Запрос.Выполнить();
	Выборка   = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		ЛС = Выборка.ЛицевойСчет;
	КонецЦикла;
	Возврат ЛС;
КонецФункции

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Объект.Организация = Справочники.Организации.НайтиПоКоду("000000001");
КонецПроцедуры

&НаСервере
Функция ПроверкаРоли()
    Пользователь = ПараметрыСеанса.ТекущийПользователь.Наименование;
	Возврат Пользователь;
КонецФункции

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ЭтаФорма.ТолькоПросмотр = Истина;
	Пользователь = ПроверкаРоли();
	Если Пользователь = "Администратор" Тогда
	    ЭтаФорма.ТолькоПросмотр = Ложь;
	ИначеЕсли  Пользователь = "Шевченко Л.В." Тогда
		ЭтаФорма.ТолькоПросмотр = Ложь;
	ИначеЕсли Пользователь = "Войтенко О.О." Тогда
		ЭтаФорма.ТолькоПросмотр = Ложь;
	КонецЕсли;
КонецПроцедуры
