// Процедура - обработчик события ПередНачаломДобавления списка.
//
&НаКлиенте
Процедура СписокПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
		
		Отказ = Истина;
		
		СтруктураПараметров = Новый Структура();
		СтруктураПараметров.Вставить("ВидЗаявки", ОтборВидЗаявки);
		СтруктураПараметров.Вставить("Организация", ОтборОрганизация);
		СтруктураПараметров.Вставить("ВидОперации", ОтборВидОперации);
		СтруктураПараметров.Вставить("Здание", ОтборЗдание);
		
		ОткрытьФорму("Документ.ЗаявкаНаПроведениеРемонта" + ".ФормаОбъекта", Новый Структура("ЗначенияЗаполнения", СтруктураПараметров));
		
	
КонецПроцедуры

