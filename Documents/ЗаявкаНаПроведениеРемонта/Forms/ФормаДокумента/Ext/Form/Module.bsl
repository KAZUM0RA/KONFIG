//
&НаКлиенте
Процедура ЗапасыПриИзменении(Элемент)
	
    РассчитатьОбщуюСумму();

КонецПроцедуры

// Процедура - обработчик события ПриИзменении поля ввода Номенклатура.
//
&НаКлиенте
Процедура ЗапасыНоменклатураПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Запасы.ТекущиеДанные;
	
	Если НЕ ЗначениеЗаполнено(ТекущиеДанные.Цена) Тогда
	
		ТекущиеДанные.Цена = ПолучитьЦенуНаСервере(ТекущиеДанные.Номенклатура);
        РассчитатьСумму(ТекущиеДанные);
		
	КонецЕсли;
	
КонецПроцедуры

