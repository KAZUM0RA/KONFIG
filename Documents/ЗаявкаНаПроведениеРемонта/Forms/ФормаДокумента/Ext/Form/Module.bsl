// ПРОЦЕДУРЫ И ФУНКЦИИ ОБЩЕГО НАЗНАЧЕНИЯ

// Процедура устанавливает видимость и доступность элементов формы.
//
// Параметры:
//  Нет.
//
&НаСервере
Процедура УстановитьВидимостьИДоступность()
	
	Если Объект.ВидОперации = Перечисления.ВидыОперацийЗаявокНаПроведениеРемонта.ПроведениеРаботПоЛицевомуСчету Тогда
		Элементы.ЛицевойСчет.Видимость = Истина;
		Элементы.Заказчик.Видимость = Истина;
		Элементы.Телефон.Видимость = Истина;
		Элементы.Адрес.Видимость = Истина;
		Элементы.ВремяУдобноеДляЗаказчика.Видимость = Истина;
		Элементы.ВремяУдобноеДляЗаказчика1.Видимость = Истина;
	Иначе
		Элементы.ЛицевойСчет.Видимость = Ложь;
		Элементы.Заказчик.Видимость = Ложь;
		Элементы.Телефон.Видимость = Ложь;
		Элементы.Адрес.Видимость = Ложь;
		Элементы.ВремяУдобноеДляЗаказчика.Видимость = Ложь;
		Элементы.ВремяУдобноеДляЗаказчика1.Видимость = Ложь;
	КонецЕсли;
	
	Статус = ПолучитьСписокСтатусов();
	
	Если Объект.СтатусЗаявки = Статус.Принята Тогда
		
		Элементы.ГруппаВыполнение.Видимость = Истина;
		Элементы.ГруппаНарядЗаказ.Видимость = Истина;
		
	ИначеЕсли Объект.СтатусЗаявки = Статус.Выполнена Тогда

		Элементы.ГруппаВыполнение.Видимость = Истина;
		Элементы.ГруппаНарядЗаказ.Видимость = Истина;
		Элементы.СтатусЗаявки.ТолькоПросмотр = Истина;
		
	ИначеЕсли Объект.СтатусЗаявки = Статус.Отменена Тогда
	
		Элементы.Комментарий.Заголовок = "Текст заявки и причина отмены";
        Элементы.СтатусЗаявки.ТолькоПросмотр = Истина;
		
	ИначеЕсли НЕ Объект.Ссылка.Пустая() Тогда
		
		Элементы.ГруппаВыполнение.Видимость = Ложь;
		Элементы.ГруппаНарядЗаказ.Видимость = Истина;
		
	Иначе
		
		Элементы.ГруппаВыполнение.Видимость = Ложь;
		Элементы.ГруппаНарядЗаказ.Видимость = Ложь;
		
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(Объект.ЛицевойСчет) И ЗначениеЗаполнено(Объект.Заказчик) Тогда
	
		 Элементы.Заказчик.ТолькоПросмотр = Истина;
	
	КонецЕсли;

КонецПроцедуры // УстановитьВидимостьИДоступность()

// Процедура - обработчик события ПриИзменении поля ввода ВидОперации.
//
&НаКлиенте
Процедура ВидОперацииПриИзменении(Элемент)
	
	УстановитьВидимостьИДоступность();

КонецПроцедуры

// Процедура - обработчик события НачалоВыбора поля ввода ЛицевойСчет.
//
&НаКлиенте
Процедура ЛицевойСчетНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыВыбораЗначения = Новый Структура;
	ПараметрыВыбораЗначения.Вставить("ОтборОрганизация",	Объект.Организация);
	ПараметрыВыбораЗначения.Вставить("ОтборЗдание",			Объект.Здание);

	ОткрытьФорму("Справочник.ЛицевыеСчета.Форма.ФормаВыбораСОтбором", ПараметрыВыбораЗначения, Элемент);
	
КонецПроцедуры

// Функция возвращает данные о лицевом счете.
//
&НаСервереБезКонтекста
Функция ПолучитьДанныеЛицевойСчетПриИзменении(ЛицевойСчет)
	
	СтруктураДанные = Новый Структура;
	
	СтруктураДанные.Вставить("Организация", ЛицевойСчет.Владелец.Организация);
	СтруктураДанные.Вставить("Здание", ЛицевойСчет.Владелец);
	СтруктураДанные.Вставить("Адрес", СокрЛП(ЛицевойСчет.Владелец.Наименование) + " " +СокрЛП(ЛицевойСчет.ОбъектЛицевогоСчета.Наименование));
	СтруктураДанные.Вставить("Телефон", ЛицевойСчет.Телефон);

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ОтветственныйВладелец
		|ИЗ
		|	РегистрСведений.ОтветственныйВладелецЛицевогоСчета.СрезПоследних КАК ОтветственныйВладелецЛицевогоСчетаСрезПоследних
		|ГДЕ
		|	ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ЛицевойСчет = &ЛицевойСчет";

	Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);

	Результат = Запрос.Выполнить();

	Выборка = Результат.Выбрать();

	Пока Выборка.Следующий() Цикл
		 СтруктураДанные.Вставить("ВладелецСчета", Выборка.ОтветственныйВладелец);
	КонецЦикла;

	Возврат СтруктураДанные;
	
КонецФункции // ПолучитьДанныеЛицевойСчетПриИзменении()

// Процедура - обработчик события ПриИзменении поля ввода ЛицевойСчет.
//
&НаКлиенте
Процедура ЛицевойСчетПриИзменении(Элемент)	
	
	СтруктураДанные = ПолучитьДанныеЛицевойСчетПриИзменении(Объект.ЛицевойСчет);
	
	Объект.Организация = СтруктураДанные.Организация;
	Объект.Здание = СтруктураДанные.Здание;
	Объект.Адрес = СтруктураДанные.Адрес;
	Объект.Телефон = СтруктураДанные.Телефон;
	Объект.Заказчик = СтруктураДанные.ВладелецСчета;
	
	Если ЗначениеЗаполнено(Объект.ЛицевойСчет) И ЗначениеЗаполнено(Объект.Заказчик) Тогда
	
		 Элементы.Заказчик.ТолькоПросмотр = Истина;
	
	КонецЕсли;
	 
КонецПроцедуры

// Функция возвращает список статусов.
//
&НаСервере
Функция ПолучитьСписокСтатусов()
	
	Статусы = Новый Структура;
	
	Статусы.Вставить("НоваяЗаявка", Перечисления.ВидыСтатусовЗаявкиНаПроведениеРемонта.НоваяЗаявка);
	Статусы.Вставить("Принята", Перечисления.ВидыСтатусовЗаявкиНаПроведениеРемонта.Принята);
	Статусы.Вставить("Выполнена", Перечисления.ВидыСтатусовЗаявкиНаПроведениеРемонта.Выполнена);
	Статусы.Вставить("Отменена", Перечисления.ВидыСтатусовЗаявкиНаПроведениеРемонта.Отменена);
	
	Возврат Статусы;
	
КонецФункции

// Функция цену номенклатуры.
//
&НаСервере
Функция ПолучитьЦенуНаСервере(Номенклатура)
	
	Если Объект.ВидЗаявки = Перечисления.ВидыЗаявокНаПроведенияРемонта.Аварийная Тогда		
		ТипЦены = Перечисления.ТипыЦенНоменклатуры.Аварийная;
	Иначе
		ТипЦены = Перечисления.ТипыЦенНоменклатуры.Отпускная;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЦеныНоменклатурыСрезПоследних.Номенклатура,
		|	ЦеныНоменклатурыСрезПоследних.Цена
		|ИЗ
		|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних КАК ЦеныНоменклатурыСрезПоследних
		|ГДЕ
		|	ЦеныНоменклатурыСрезПоследних.Номенклатура = &Номенклатура
		|	И ЦеныНоменклатурыСрезПоследних.ТипЦены = &ТипЦены";

	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("ТипЦены", ТипЦены);

	Результат = Запрос.Выполнить();

	Выборка = Результат.Выбрать();

	Пока Выборка.Следующий() Цикл
		Возврат Выборка.Цена;
	КонецЦикла;

КонецФункции

// Процедура рассчитывает сумму в строке табличной части.
//
&НаКлиенте
Процедура РассчитатьСумму(СтрокаТабличнойЧасти)
	
	СтрокаТабличнойЧасти.СуммаПлан = СтрокаТабличнойЧасти.Цена * СтрокаТабличнойЧасти.КоличествоПлан;
	СтрокаТабличнойЧасти.СуммаФакт = СтрокаТабличнойЧасти.Цена * СтрокаТабличнойЧасти.КоличествоФакт;
	
	РассчитатьОбщуюСумму();
	
КонецПроцедуры

// Процедура рассчитывает общую сумму.
//
&НаКлиенте
Процедура РассчитатьОбщуюСумму()
	
	Объект.СуммаДокумента = Объект.Работы.Итог("СуммаФакт") + Объект.Запасы.Итог("СуммаФакт");
	
КонецПроцедуры

// Процедура - обработчик события ПриИзменении поля ввода СтатусЗаявки.
//
&НаКлиенте
Процедура СтатусЗаявкиПриИзменении(Элемент)
	
	Статус = ПолучитьСписокСтатусов();
	
	Если Объект.СтатусЗаявки = Статус.Отменена Тогда
	
		Элементы.Комментарий.Заголовок = "Текст заявки и причина отмены";
				
	Иначе
		
		Элементы.Комментарий.Заголовок = "Текст заявки";

	КонецЕсли;
	
		
КонецПроцедуры

