// ПРОЦЕДУРЫ - ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

// Процедура - обработчик события ПриСозданииНаСервере.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОСМДСервер.ЗаполнитьШапкуДокумента(
		Объект,
		,
		Параметры.ЗначениеКопирования,
		Параметры.Основание,
		СостояниеДокумента,
		КартинкаСостоянияДокумента,
		РазрешеноПроведение,
		ПоследнееИзменение,
		Параметры.ЗначенияЗаполнения);
	
    ИнфоПоЛицевомуСчету = "Информация по лицевому счету";
	
	УстановитьВидимостьИДоступность();
	
	// ДополнительныеОтчетыИОбработки
	ДополнительныеОтчетыИОбработки.ПриСозданииНаСервере(ЭтаФорма);
	// Конец ДополнительныеОтчетыИОбработки
	
КонецПроцедуры

// Процедура - обработчик события ПослеЗаписи.
//
&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	ОСМДКлиент.ОбновитьСостояниеДокумента(Объект, СостояниеДокумента, КартинкаСостоянияДокумента, РазрешеноПроведение, ПоследнееИзменение);
	
КонецПроцедуры

// Процедура - обработчик события ПередЗаписью.
//
&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Статус = ПолучитьСписокСтатусов();
	
	Если Объект.СтатусЗаявки = Статус.НоваяЗаявка И Элементы.Работы.ТекущиеДанные <> Неопределено Тогда
		Ответ = Вопрос(НСтр("ru='Хотите присвоить заявке статус ""Принята""?';uk='Прагнете привласнити заявці статус ""Прийнята""?'"), РежимДиалогаВопрос.ДаНет, 0);
		Если Ответ = КодВозвратаДиалога.Да Тогда
			Объект.СтатусЗаявки = Статус.Принята;
		КонецЕсли; 
	КонецЕсли;
	
	Если Объект.СтатусЗаявки = Статус.Принята И (ЗначениеЗаполнено(Объект.ОценкаПроведенияРемонта) ИЛИ ЗначениеЗаполнено(Объект.ВремяФактическогоВыполнения)) Тогда
		Ответ = Вопрос(НСтр("ru='Хотите присвоить заявке статус ""Выполнена""?';uk='Прагнете привласнити заявці статус ""Виконана""?'"), РежимДиалогаВопрос.ДаНет, 0);
		Если Ответ = КодВозвратаДиалога.Да Тогда
			Объект.СтатусЗаявки = Статус.Выполнена;
		КонецЕсли; 
	КонецЕсли;
	
КонецПроцедуры


