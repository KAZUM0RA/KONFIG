&НаСервере
Процедура ЗаполнитьТаблицуСортировкиЛС()

	Дерево = РеквизитФормыВЗначение("ДеревоУслуг");
	
    ТаблицаСортировкаЛС = СортировкаЛС.Выгрузить();
	Ном = 0;
	Для Каждого Строка Из Дерево.Строки Цикл
		Ном = Ном + 1;	
		ОтборСтрокСортировки = ТаблицаСортировкаЛС.НайтиСтроки(Новый Структура("ЛицевойСчет", Строка.ЛицевойСчет));
		Если ОтборСтрокСортировки.Количество() > 0 Тогда
			ОтборСтрокСортировки[0].Порядок = Ном;
			ОтборСтрокСортировки[0].Развернут = Строка.Признак;
		Иначе
			СтрокаСортировки = ТаблицаСортировкаЛС.Добавить();
			СтрокаСортировки.ЛицевойСчет = Строка.ЛицевойСчет;
			СтрокаСортировки.Порядок = Ном;
			СтрокаСортировки.Развернут = Строка.Признак;
		КонецЕсли; 
	КонецЦикла;

	СортировкаЛС.Загрузить(ТаблицаСортировкаЛС);
	
КонецПроцедуры
 
&НаКлиенте
Процедура ПередЗакрытием(Отказ, СтандартнаяОбработка)
	
    ПередЗакрытиемНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ПередЗакрытиемНаСервере()
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		
		ЗаполнитьТаблицуСортировкиЛС();
		
		ОбщегоНазначения.ХранилищеНастроекДанныхФормСохранить(Строка(Объект.Ссылка.УникальныйИдентификатор()), "Сортировка", СортировкаЛС.Выгрузить(), , Пользователи.ТекущийПользователь(), Истина);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РазвернутьСтрокиДерева()
	
	#Если НЕ ВебКлиент Тогда

	ОтборСтрокСортировки = СортировкаЛС.НайтиСтроки(Новый Структура("Развернут", Истина));
	МассивЛС = Новый Массив;
	Для каждого Строка Из ОтборСтрокСортировки Цикл
		МассивЛС.Добавить(Строка.ЛицевойСчет);
	КонецЦикла; 
	
	Если МассивЛС.Количество() = 0 Тогда
		Возврат;	
	КонецЕсли; 
	
	СтрокиДерева = ДеревоУслуг.ПолучитьЭлементы();
	Для Каждого Строка Из СтрокиДерева Цикл
		
		Если НЕ МассивЛС.Найти(Строка.ЛицевойСчет) = Неопределено Тогда
			
			Строка.Признак = Истина;
			ИдентификаторСтроки=Строка.ПолучитьИдентификатор();
			Элементы.ДеревоУслуг.Развернуть(ИдентификаторСтроки, Истина);
		
		КонецЕсли; 
		
	КонецЦикла;
	
	#КонецЕсли	
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	Если Объект.Услуги.Количество() = 0 и ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = Нстр("ru = 'Таблица начисления услуг не заполнена. Докуент не будет проведен!'; uk = 'Таблиця нарахування послуг не заповнена. Докуент не буде проведений!'");
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЕсли;	
		
КонецПроцедуры

