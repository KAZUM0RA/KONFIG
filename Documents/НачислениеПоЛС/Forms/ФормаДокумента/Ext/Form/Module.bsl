 &НаСервере
Функция ПолучитьСтруктуруЛСИзХранилища(АдресЛицевыхСчетовВХранилище)
	
	ТаблицаДляЗагрузки	= ПолучитьИзВременногоХранилища(АдресЛицевыхСчетовВХранилище);
	ТаблицаДляЗагрузки.Свернуть("ЛицевойСчет",);
	Возврат ТаблицаДляЗагрузки.ВыгрузитьКолонку("ЛицевойСчет"); 
	
КонецФункции 

&НаКлиенте
Процедура НайтиЛС(Команда)
	
	ПараметрыЗаполнения = Новый Структура;
	
	ПараметрыЗаполнения.Вставить("ДатаНачала",		НачалоМесяца(Объект.ПериодНачисления));
	ПараметрыЗаполнения.Вставить("ДатаОкончания",	КонецМесяца(Объект.ПериодНачисления));
	ПараметрыЗаполнения.Вставить("ОтборОрганизация",	Объект.Организация);
	ПараметрыЗаполнения.Вставить("ОтборЗдание",			Объект.Здание);
	
	АдресЛицевыхСчетовВХранилище = ОткрытьФормуМодально("ОбщаяФорма.ФормаПодбораЛицевыхСчетов", ПараметрыЗаполнения);
	
	Если ЗначениеЗаполнено(АдресЛицевыхСчетовВХранилище) Тогда
		
		МассивЛС = ПолучитьСтруктуруЛСИзХранилища(АдресЛицевыхСчетовВХранилище);
		
		ПоказатьНачислениеУслуг(МассивЛС);
		
		Элементы.Страницы.ТекущаяСтраница.Заголовок = "Лицевые счета (отбор)";
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОтменитьПоискЛС(Команда)
	
	ПоказатьНачислениеУслуг();

	Элементы.Страницы.ТекущаяСтраница.Заголовок = "Лицевые счета";

КонецПроцедуры

&НаКлиенте
Процедура ДеревоУслугПередНачаломИзменения(Элемент, Отказ)
	
	Отказ = Истина;
	ТекущиеДанные = Элементы.ДеревоУслуг.ТекущиеДанные;
	Если НЕ ТекущиеДанные = Неопределено Тогда
		Если ТекущиеДанные.КартинкаЛС И ЗначениеЗаполнено(ТекущиеДанные.ЛицевойСчет) Тогда
		
			ОткрытьЗначение(ТекущиеДанные.ЛицевойСчет);
		
		КонецЕсли; 
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура Развернуть(Команда)
	
	Если Элементы.ДеревоУслуг.ТекущиеДанные <> Неопределено Тогда
		Если Элементы.ДеревоУслуг.ТекущиеДанные.КартинкаЛС Тогда
			Элементы.ДеревоУслуг.ТекущиеДанные.Признак = Истина;
			Элементы.ДеревоУслуг.Развернуть(Элементы.ДеревоУслуг.ТекущаяСтрока, Истина);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РазвернутьВсе(Команда)
	
	#Если НЕ ВебКлиент Тогда
	
	СтрокиДерева = ДеревоУслуг.ПолучитьЭлементы();
	
	Для Каждого Строка Из СтрокиДерева Цикл
		Строка.Признак = Истина;
		ИдентификаторСтроки=Строка.ПолучитьИдентификатор();
		Элементы.ДеревоУслуг.Развернуть(ИдентификаторСтроки, Истина);
	КонецЦикла;
	
	#КонецЕсли	
	
КонецПроцедуры

&НаКлиенте
Процедура Свернуть(Команда)
	
	Если Элементы.ДеревоУслуг.ТекущиеДанные <> Неопределено Тогда
		Если Элементы.ДеревоУслуг.ТекущиеДанные.КартинкаЛС Тогда
			Если Элементы.ДеревоУслуг.Развернут(Элементы.ДеревоУслуг.ТекущаяСтрока) Тогда
				Элементы.ДеревоУслуг.ТекущиеДанные.Признак = Ложь;
				Элементы.ДеревоУслуг.Свернуть(Элементы.ДеревоУслуг.ТекущаяСтрока);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

