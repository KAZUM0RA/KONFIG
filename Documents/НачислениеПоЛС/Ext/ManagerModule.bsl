
// Формирует таблицу значений, содержащую данные для проведения по регистру.
// Таблицы значений сохраняет в свойствах структуры "ДополнительныеСвойства".
//
Процедура СформироватьТаблицуРасчетыПоЛицевымСчетам(ДокументСсылкаНачислениеПоЛС, СтруктураДополнительныеСвойства)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = СтруктураДополнительныеСвойства.ДляПроведения.СтруктураВременныеТаблицы.МенеджерВременныхТаблиц;
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
	|	ВременнаяТаблицаНачисленияУслуг.Организация КАК Организация,
	|	ВременнаяТаблицаНачисленияУслуг.ЛицевойСчет КАК ЛицевойСчет,
	|	ВременнаяТаблицаНачисленияУслуг.Услуга КАК Услуга,
	|	СУММА(ВременнаяТаблицаНачисленияУслуг.Сумма) КАК Сумма,
	|	ВременнаяТаблицаНачисленияУслуг.ДнейНачислено,
	|	СУММА(ВременнаяТаблицаНачисленияУслуг.Количество) КАК Количество,
	|	ВременнаяТаблицаНачисленияУслуг.Тариф,
	|	ВременнаяТаблицаНачисленияУслуг.Период,
	|	ВременнаяТаблицаНачисленияУслуг.МесяцНачисления,
	|	ВременнаяТаблицаНачисленияУслуг.ВидТарифа,
	|	ВременнаяТаблицаНачисленияУслуг.ВидНачисления,
	|	ВременнаяТаблицаНачисленияУслуг.ДатаОкончанияПериода,
	|	ВременнаяТаблицаНачисленияУслуг.ДатаНачалаПериода,
	|	ВременнаяТаблицаНачисленияУслуг.СтимулирующийТариф,
	|	ВременнаяТаблицаНачисленияУслуг.Порог,
	|	ВременнаяТаблицаНачисленияУслуг.ЗначениеПорога
	|ИЗ
	|	ВременнаяТаблицаНачисленияУслуг КАК ВременнаяТаблицаНачисленияУслуг
	|
	|СГРУППИРОВАТЬ ПО
	|	ВременнаяТаблицаНачисленияУслуг.Организация,
	|	ВременнаяТаблицаНачисленияУслуг.ЛицевойСчет,
	|	ВременнаяТаблицаНачисленияУслуг.Услуга,
	|	ВременнаяТаблицаНачисленияУслуг.ДнейНачислено,
	|	ВременнаяТаблицаНачисленияУслуг.Тариф,
	|	ВременнаяТаблицаНачисленияУслуг.Период,
	|	ВременнаяТаблицаНачисленияУслуг.МесяцНачисления,
	|	ВременнаяТаблицаНачисленияУслуг.ВидТарифа,
	|	ВременнаяТаблицаНачисленияУслуг.ВидНачисления,
	|	ВременнаяТаблицаНачисленияУслуг.ДатаОкончанияПериода,
	|	ВременнаяТаблицаНачисленияУслуг.ДатаНачалаПериода,
	|	ВременнаяТаблицаНачисленияУслуг.СтимулирующийТариф,
	|	ВременнаяТаблицаНачисленияУслуг.Порог,
	|	ВременнаяТаблицаНачисленияУслуг.ЗначениеПорога
	|
	|УПОРЯДОЧИТЬ ПО
	|	Организация,
	|	ЛицевойСчет,
	|	Услуга";	
	
	РезультатЗапроса = Запрос.Выполнить();
	
	СтруктураДополнительныеСвойства.ТаблицыДляДвижений.Вставить("ТаблицаРасчетыПоЛицевымСчетам", РезультатЗапроса.Выгрузить());
	
КонецПроцедуры // СформироватьТаблицуРасчетыПоЛицевымСчетам()

// Формирует таблицу значений, содержащую данные для проведения по регистру.
