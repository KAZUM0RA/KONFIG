&НаСервере
Функция ЗаполнитьССайтаНаСервере()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ПоказанияПриборовУчетаССайта.Значение,
		|	ПоказанияПриборовУчетаССайта.ПриборУчета КАК ПриборУчета,
		|	ПоказанияПриборовУчетаССайта.ВидТарифа
		|ИЗ
		|	РегистрСведений.ПоказанияПриборовУчетаССайта КАК ПоказанияПриборовУчетаССайта
		|ГДЕ
		|	ПоказанияПриборовУчетаССайта.Период >= &ДатаНач
		|	И ПоказанияПриборовУчетаССайта.Период <= &ДатаКон
		|	И ПоказанияПриборовУчетаССайта.ПриборУчета В(&ПриборыУчета)
		|	И ПоказанияПриборовУчетаССайта.ЛицевойСчет В(&ЛицевыеСчета)";
				  
	Запрос.УстановитьПараметр("ДатаНач", НачалоМесяца(Объект.ПериодНачисления));
	Запрос.УстановитьПараметр("ДатаКон", КонецМесяца(Объект.ПериодНачисления));
	Запрос.УстановитьПараметр("ПриборыУчета", Объект.Основная.Выгрузить().ВыгрузитьКолонку("ПриборУчета"));
	Запрос.УстановитьПараметр("ЛицевыеСчета", Объект.Основная.Выгрузить().ВыгрузитьКолонку("ОбъектУстановки"));
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Если Результат.Количество() = 0 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru = 'Результаты сбора показаний приборов учета отсутствуют'; uk = 'Результати збору показань приладів обліку відсутні'");
		Сообщение.Сообщить();
		Возврат Ложь;
	КонецЕсли;
	
	
	Пока Результат.Следующий() Цикл
		СтруктураПоиска = Новый Структура("ПриборУчета,Отключен,ВидТарифа",Результат.ПриборУчета,Ложь,Результат.ВидТарифа);	
		Строка = Объект.Основная.НайтиСтроки(СтруктураПоиска);
		Если Строка.Количество() <> 0 тогда
			ПоказаниеПередРедактированием = Строка[0].Показание;
			Строка[0].Показание  = Результат.Значение;
			
			СтруктураДанные = Новый Структура();
			СтруктураДанные.Вставить("ПриборУчета", Строка[0].ПриборУчета);
			СтруктураДанные.Вставить("ПредыдущееПоказание", Строка[0].ПоказаниеПредыдущее);
			СтруктураДанные.Вставить("ТекущееПоказание", Строка[0].Показание);
			
			СтруктураДанные = ПолучитьДанныеОсновнаяПоказаниеПриИзменении(СтруктураДанные);
			
			Если ЗначениеЗаполнено(СтруктураДанные.ТекстОшибки) Тогда
				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтруктураДанные.ТекстОшибки);
				
				Строка[0].Показание = ПоказаниеПередРедактированием;
				
				Продолжить;
			КонецЕсли;
			
			Строка[0].Разница = СтруктураДанные.РасходПоПриборуУчета;
			Строка[0].ПереходЧерезНоль = СтруктураДанные.ЕстьПереходПоказанийЧерезНоль;
			Строка[0].РасходЗаПериодРасчета = СтруктураДанные.РасходЗаПериодРасчета;
			Строка[0].ГрупповоеЗаполнение = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;	
	
КонецФункции // ЗаполнитьССайтаНаСервее()

