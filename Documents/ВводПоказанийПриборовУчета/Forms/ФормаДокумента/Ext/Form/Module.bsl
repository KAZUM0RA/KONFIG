&НаСервере
Процедура ЗаполнитьПоказанияСчетчиковНаСервере(АдресВременногоХранилища)

	ТаблицаПоказаний  = ПолучитьИзВременногоХранилища(АдресВременногоХранилища);
	
	Для Каждого Строка Из ТаблицаПоказаний Цикл
		
		СтруктураПоиска = Новый Структура("ПриборУчета,Отключен",Справочники.ПриборыУчета.НайтиПоНаименованию(Строка.ПриборУчета),Ложь);	
		Попытка
			СтрокаТаблицыДокумента = Объект.Основная.НайтиСтроки(СтруктураПоиска)[0];
			СтрокаТаблицыДокумента.Показание = Строка.Показание;
			
			СтруктураДанные = Новый Структура();
			СтруктураДанные.Вставить("ПриборУчета", СтрокаТаблицыДокумента.ПриборУчета);
			СтруктураДанные.Вставить("ПредыдущееПоказание", СтрокаТаблицыДокумента.ПоказаниеПредыдущее);
			СтруктураДанные.Вставить("ТекущееПоказание", СтрокаТаблицыДокумента.Показание);
			
			СтруктураДанные = ПолучитьДанныеОсновнаяПоказаниеПриИзменении(СтруктураДанные);
			
			Если ЗначениеЗаполнено(СтруктураДанные.ТекстОшибки) Тогда
				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтруктураДанные.ТекстОшибки);
				
				СтрокаТаблицыДокумента.Показание = ПоказаниеПередРедактированием;
				
				Возврат;
			КонецЕсли;
			
			СтрокаТаблицыДокумента.Разница = СтруктураДанные.РасходПоПриборуУчета;
			СтрокаТаблицыДокумента.ПереходЧерезНоль = СтруктураДанные.ЕстьПереходПоказанийЧерезНоль;
			СтрокаТаблицыДокумента.РасходЗаПериодРасчета = СтруктураДанные.РасходЗаПериодРасчета;
		Исключение
			Сообщить("Прибор "+Строка(Строка.ПриборУчета)+" отсутствует в табличной части документа");
		КонецПопытки;
		
	КонецЦикла;

КонецПроцедуры // ()

