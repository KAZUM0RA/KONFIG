
////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ И ФУНКЦИИ ОБЩЕГО НАЗНАЧЕНИЯ

// Функция получает список лицевых счетов из временного хранилища
//
&НаСервере
Процедура ПолучитьЛицевыеСчетаИзХранилища(АдресЛицевыхСчетовВХранилище)
	
	ТаблицаДляЗагрузки	= ПолучитьИзВременногоХранилища(АдресЛицевыхСчетовВХранилище);
	
	МассивОбъектовУстановки = ТаблицаДляЗагрузки.ВыгрузитьКолонку("ЛицевойСчет");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВложенныйЗапрос.ПриборУчета КАК ПриборУчета,
		|	ВложенныйЗапрос.ОбъектУстановки КАК ОбъектУстановки,
		|	ВложенныйЗапрос.ПоказаниеПредыдущее,
		|	ВложенныйЗапрос.ВидТарифа,
		|	ВложенныйЗапрос.Услуга,
		|	ВложенныйЗапрос.Показание,
		|	ВложенныйЗапрос.Отключен КАК Отключен,
		|	ВложенныйЗапрос.ОбъектЛицевогоСчета,
		|	ВложенныйЗапрос.Коэффициент,
		|	ВложенныйЗапрос.ОтветственныйВладелец,
		|	ВложенныйЗапрос.Период,
		|	ЕСТЬNULL(ВложенныйЗапрос.СреднемесячноеПоказание, 0) КАК СреднемесячноеПоказание
		|ИЗ
		|	(ВЫБРАТЬ
		|		ВложенныйЗапрос.ОбъектУстановки КАК ОбъектУстановки,
		|		ВложенныйЗапрос.ПриборУчета КАК ПриборУчета,
		|		ВложенныйЗапрос.Услуга КАК Услуга,
		|		ВложенныйЗапрос.ВидТарифа КАК ВидТарифа,
		|		ВложенныйЗапрос.ПоказаниеПредыдущееОборот КАК ПоказаниеПредыдущее,
		|		ВложенныйЗапрос.ПоказаниеОборот КАК Показание,
		|		ИСТИНА КАК Отключен,
		|		ВложенныйЗапрос.ОбъектЛицевогоСчета КАК ОбъектЛицевогоСчета,
		|		ВложенныйЗапрос.Коэффициент КАК Коэффициент,
		|		ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ОтветственныйВладелец КАК ОтветственныйВладелец,
		|		ВложенныйЗапрос.СреднемесячноеПоказаниеОборот КАК СреднемесячноеПоказание,
		|		ВложенныйЗапрос.Период КАК Период
		|	ИЗ
		|		(ВЫБРАТЬ
		|			ЗаменыПриборовУчетаОбороты.ОбъектУстановки КАК ОбъектУстановки,
		|			ЗаменыПриборовУчетаОбороты.ПриборУчета КАК ПриборУчета,
		|			ЗаменыПриборовУчетаОбороты.Услуга КАК Услуга,
		|			ЗаменыПриборовУчетаОбороты.ВидТарифа КАК ВидТарифа,
		|			ЗаменыПриборовУчетаОбороты.ПоказаниеПредыдущееОборот КАК ПоказаниеПредыдущееОборот,
		|			ЗаменыПриборовУчетаОбороты.ПоказаниеОборот КАК ПоказаниеОборот,
		|			ЗаменыПриборовУчетаОбороты.СреднемесячноеПоказаниеОборот КАК СреднемесячноеПоказаниеОборот,
		|			ЗаменыПриборовУчетаОбороты.Период КАК Период,
		|			ЗаменыПриборовУчетаОбороты.ОбъектУстановки.ОбъектЛицевогоСчета КАК ОбъектЛицевогоСчета,
		|			ЗаменыПриборовУчетаОбороты.ПриборУчета.Коэффициент КАК Коэффициент
		|		ИЗ
		|			РегистрНакопления.ЗаменыПриборовУчета.Обороты(
		|					&НачПериода,
		|					&КонПериода,
		|					Месяц,
		|					ОбъектУстановки В (&ОбъектыУстановки)
		|						И ПриборУчета.Услуга = &Услуга) КАК ЗаменыПриборовУчетаОбороты) КАК ВложенныйЗапрос
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОтветственныйВладелецЛицевогоСчета.СрезПоследних(&КонПериода, ) КАК ОтветственныйВладелецЛицевогоСчетаСрезПоследних
		|			ПО ВложенныйЗапрос.ОбъектУстановки = ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ЛицевойСчет
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		УстановленныеПриборыУчетаСрезПоследних.ОбъектУстановки,
		|		УстановленныеПриборыУчетаСрезПоследних.ПриборУчета,
		|		ПоказанияПриборовУчетаСрезПоследних.ПриборУчета.Услуга,
		|		ПоказанияПриборовУчетаСрезПоследних.ВидТарифа,
		|		ПоказанияПриборовУчетаСрезПоследних.Значение,
		|		0,
		|		ЛОЖЬ,
		|		УстановленныеПриборыУчетаСрезПоследних.ОбъектУстановки.ОбъектЛицевогоСчета,
		|		УстановленныеПриборыУчетаСрезПоследних.ПриборУчета.Коэффициент,
		|		ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ОтветственныйВладелец,
		|		0,
		|		ПоказанияПриборовУчетаСрезПоследних.Период
		|	ИЗ
		|		РегистрСведений.УстановленныеПриборыУчета.СрезПоследних(
		|				&КонПериода,
		|				ОбъектУстановки В (&ОбъектыУстановки)
		|					И ПриборУчета.Услуга = &Услуга) КАК УстановленныеПриборыУчетаСрезПоследних
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПоказанияПриборовУчета.СрезПоследних(&КонПериода, Регистратор <> &Ссылка) КАК ПоказанияПриборовУчетаСрезПоследних
		|			ПО УстановленныеПриборыУчетаСрезПоследних.ПриборУчета = ПоказанияПриборовУчетаСрезПоследних.ПриборУчета
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОтветственныйВладелецЛицевогоСчета.СрезПоследних(&КонПериода, ) КАК ОтветственныйВладелецЛицевогоСчетаСрезПоследних
		|			ПО УстановленныеПриборыУчетаСрезПоследних.ОбъектУстановки = ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ЛицевойСчет
		|	ГДЕ
		|		УстановленныеПриборыУчетаСрезПоследних.Действует = ИСТИНА) КАК ВложенныйЗапрос
		|
		|УПОРЯДОЧИТЬ ПО
		|	ОбъектУстановки,
		|	Отключен УБЫВ,
		|	ПриборУчета
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЕСТЬNULL(НАПоверке.Период, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)) КАК ДатаОтключения,
		|	ЕСТЬNULL(НАПоверке.СреднемесячноеПоказание, 0) КАК СреднемесячноеПоказание,
		|	УстановленныеПриборыУчетаСрезПоследних.ОбъектУстановки КАК ОбъектУстановки,
		|	УстановленныеПриборыУчетаСрезПоследних.ПриборУчета КАК ПриборУчета,
		|	ЕСТЬNULL(УстановленныеПриборыУчетаСрезПоследних.Период, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)) КАК ДатаВключения,
		|	ЕСТЬNULL(ВЫБОР
		|			КОГДА ЕСТЬNULL(УстановленныеПриборыУчетаСрезПоследних.Период, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)) > ЕСТЬNULL(НАПоверке.Период, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0))
		|					И ЕСТЬNULL(УстановленныеПриборыУчетаСрезПоследних.Период, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)) > НАЧАЛОПЕРИОДА(&КонПериода, МЕСЯЦ)
		|				ТОГДА ВЫБОР
		|						КОГДА ЕСТЬNULL(НАПоверке.Период, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)) > НАЧАЛОПЕРИОДА(&КонПериода, МЕСЯЦ)
		|							ТОГДА РАЗНОСТЬДАТ(ЕСТЬNULL(НАПоверке.Период, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)), ЕСТЬNULL(УстановленныеПриборыУчетаСрезПоследних.Период, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)), ДЕНЬ)
		|						ИНАЧЕ РАЗНОСТЬДАТ(НАЧАЛОПЕРИОДА(&КонПериода, МЕСЯЦ), ЕСТЬNULL(УстановленныеПриборыУчетаСрезПоследних.Период, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)), ДЕНЬ)
		|					КОНЕЦ
		|			ИНАЧЕ ВЫБОР
		|					КОГДА ЕСТЬNULL(НАПоверке.Период, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)) > ЕСТЬNULL(УстановленныеПриборыУчетаСрезПоследних.Период, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0))
		|							И ЕСТЬNULL(НАПоверке.Период, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)) > НАЧАЛОПЕРИОДА(&КонПериода, МЕСЯЦ)
		|						ТОГДА РАЗНОСТЬДАТ(ЕСТЬNULL(НАПоверке.Период, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)), КОНЕЦПЕРИОДА(&КонПериода, МЕСЯЦ), ДЕНЬ)
		|					ИНАЧЕ ВЫБОР
		|							КОГДА ЕСТЬNULL(НАПоверке.Период, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)) > ЕСТЬNULL(УстановленныеПриборыУчетаСрезПоследних.Период, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0))
		|									И ЕСТЬNULL(НАПоверке.Период, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)) < НАЧАЛОПЕРИОДА(&КонПериода, МЕСЯЦ)
		|								ТОГДА РАЗНОСТЬДАТ(НАЧАЛОПЕРИОДА(&КонПериода, МЕСЯЦ), КОНЕЦПЕРИОДА(&КонПериода, МЕСЯЦ), ДЕНЬ)
		|						КОНЕЦ
		|				КОНЕЦ
		|		КОНЕЦ, 0) КАК ДнейПоСредней,
		|	РАЗНОСТЬДАТ(НАЧАЛОПЕРИОДА(НАЧАЛОПЕРИОДА(&КонПериода, МЕСЯЦ), ДЕНЬ), НАЧАЛОПЕРИОДА(КОНЕЦПЕРИОДА(&КонПериода, МЕСЯЦ), ДЕНЬ), ДЕНЬ) КАК ДнейВМесяце,
		|	ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ОтветственныйВладелец
		|ИЗ
		|	РегистрСведений.УстановленныеПриборыУчета.СрезПоследних(
		|			&КонПериода,
		|			Действует = ИСТИНА
		|				И ОбъектУстановки В (&ОбъектыУстановки)
		|				И ПриборУчета.Услуга = &Услуга) КАК УстановленныеПриборыУчетаСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УстановленныеПриборыУчета.СрезПоследних(
		|				&КонПериода,
		|				Действует = ЛОЖЬ
		|					И ЕСТЬNULL(СреднемесячноеПоказание, 0) <> 0
		|					И ОбъектУстановки В (&ОбъектыУстановки)
		|					И ПриборУчета.Услуга = &Услуга) КАК НАПоверке
		|		ПО УстановленныеПриборыУчетаСрезПоследних.ОбъектУстановки = НАПоверке.ОбъектУстановки
		|			И УстановленныеПриборыУчетаСрезПоследних.ПриборУчета = НАПоверке.ПриборУчета
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОтветственныйВладелецЛицевогоСчета.СрезПоследних КАК ОтветственныйВладелецЛицевогоСчетаСрезПоследних
		|		ПО УстановленныеПриборыУчетаСрезПоследних.ОбъектУстановки = ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ЛицевойСчет
		|ГДЕ
		|	НАПоверке.СреднемесячноеПоказание <> 0
		|
		|УПОРЯДОЧИТЬ ПО
		|	ПриборУчета";
		
	Запрос.Параметры.Вставить("НачПериода", НачалоМесяца(Объект.ПериодНачисления));
	Запрос.Параметры.Вставить("КонПериода", КонецМесяца(Объект.ПериодНачисления));
	
	Запрос.Параметры.Вставить("ОбъектыУстановки", МассивОбъектовУстановки);
	Запрос.Параметры.Вставить("Услуга", Объект.Услуга);
	Запрос.Параметры.Вставить("Ссылка", Объект.Ссылка);
	Результат  = Запрос.ВыполнитьПакет();
	
	ВыборкаЛС = Результат[0].Выбрать(); 
	ВыборкаПоверок = Результат[1].Выбрать();
	Разница = 0;
	ПриборУчетаКонтроль = Неопределено;
	Пока ВыборкаЛС.Следующий() Цикл
				
		НоваяСтрока = Объект.Основная.Добавить();
		НоваяСтрока.ОбъектУстановки = ВыборкаЛС.ОбъектУстановки;
		НоваяСтрока.ПриборУчета = ВыборкаЛС.ПриборУчета;
		НоваяСтрока.ПоказаниеПредыдущее = ВыборкаЛС.ПоказаниеПредыдущее;
		НоваяСтрока.Показание = ВыборкаЛС.Показание;
		НоваяСтрока.Коэффициент = ВыборкаЛС.Коэффициент;
		НоваяСтрока.Отключен = ВыборкаЛС.Отключен;
		НоваяСтрока.ВидТарифа = ВыборкаЛС.ВидТарифа;
		НоваяСтрока.Услуга = ВыборкаЛС.Услуга;
		НоваяСтрока.ОбъектЛицевогоСчета = ВыборкаЛС.ОбъектЛицевогоСчета;
		НоваяСтрока.ОтветственныйВладелец = ВыборкаЛС.ОтветственныйВладелец;
		НоваяСтрока.Разница = НоваяСтрока.Показание - НоваяСтрока.ПоказаниеПредыдущее;
				
	КонецЦикла;
	
	Для Индекс = 0 По МассивОбъектовУстановки.ВГраница() Цикл
	
		НайденаПоверка = ВыборкаПоверок.НайтиСледующий(МассивОбъектовУстановки[индекс]);
		Если НайденаПоверка и ВыборкаПоверок.ДнейПоСредней <> 0 Тогда
			
		     
				НоваяСтрока = Объект.Основная.Добавить();
				НоваяСтрока.ОбъектУстановки = ВыборкаПоверок.ОбъектУстановки;
				НоваяСтрока.ПриборУчета = ВыборкаПоверок.ПриборУчета;
				НоваяСтрока.Коэффициент = ВыборкаПоверок.ПриборУчета.Коэффициент;
				НоваяСтрока.Отключен = Истина;
				НоваяСтрока.ВидТарифа = Перечисления.ВидыТарифов.Общий;
				НоваяСтрока.Услуга =  ВыборкаПоверок.ПриборУчета.Услуга;
				НоваяСтрока.ОбъектЛицевогоСчета = ВыборкаПоверок.ОбъектУстановки.ОбъектЛицевогоСчета;
				НоваяСтрока.ОтветственныйВладелец = ВыборкаПоверок.ОтветственныйВладелец;
				Разница = Окр((ВыборкаПоверок.СреднемесячноеПоказание/(ВыборкаПоверок.ДнейВМесяце+1)*(ВыборкаПоверок.ДнейПоСредней+1)),4);
				НоваяСтрока.Разница =  Разница;

		 КонецЕсли;  
	
	КонецЦикла; 
		
	Объект.Основная.Сортировать("ОбъектУстановки, ПриборУчета, Отключен Убыв");   
	
	Для каждого СтрокаОсновная Из Объект.Основная Цикл
		
		Если СтрокаОсновная.Показание = 0 Тогда
			Продолжить;
		КонецЕсли; 
		
		СтруктураДанные = Новый Структура();
		СтруктураДанные.Вставить("ПриборУчета", СтрокаОсновная.ПриборУчета);
		СтруктураДанные.Вставить("ПредыдущееПоказание", СтрокаОсновная.ПоказаниеПредыдущее);
		СтруктураДанные.Вставить("ТекущееПоказание", СтрокаОсновная.Показание);
		
		СтруктураДанные = ПолучитьДанныеОсновнаяПоказаниеПриИзменении(СтруктураДанные);
		
		СтрокаОсновная.Разница = СтруктураДанные.РасходПоПриборуУчета;
		СтрокаОсновная.ПереходЧерезНоль = СтруктураДанные.ЕстьПереходПоказанийЧерезНоль;
		СтрокаОсновная.РасходЗаПериодРасчета = СтруктураДанные.РасходЗаПериодРасчета;
	
	КонецЦикла; 	
	
КонецПроцедуры // ПолучитьЛицевыеСчетаИзХранилища()

&НаСервере
Процедура ЗаполнитьПриборыУчета(ПриборУчета = Неопределено)
	
	Если ПриборУчета = Неопределено Тогда
		ТаблицаПриборыУчета = Объект.Основная.Выгрузить();
		ТаблицаПриборыУчета.Свернуть("ПриборУчета",);
		МассивПриборыУчета = ТаблицаПриборыУчета.ВыгрузитьКолонку("ПриборУчета"); 
		
	Иначе
		МассивПриборыУчета = Новый Массив;
		МассивПриборыУчета.Добавить(ПриборУчета);		
	КонецЕсли;	
	
	ТаблицаПерезаполнить = Объект.Основная.Выгрузить();
	ТаблицаПерезаполнить.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВложенныйЗапрос.ПриборУчета КАК ПриборУчета,
		|	ВложенныйЗапрос.ОбъектУстановки КАК ОбъектУстановки,
		|	ВложенныйЗапрос.ПоказаниеПредыдущее,
		|	ВложенныйЗапрос.ВидТарифа,
		|	ВложенныйЗапрос.Услуга,
		|	ВложенныйЗапрос.Показание,
		|	ВложенныйЗапрос.Отключен КАК Отключен,
		|	ВложенныйЗапрос.ОбъектЛицевогоСчета,
		|	ВложенныйЗапрос.Коэффициент,
		|	ВложенныйЗапрос.ОтветственныйВладелец
		|ИЗ
		|	(ВЫБРАТЬ
		|		ЗаменыПриборовУчетаОбороты.ОбъектУстановки КАК ОбъектУстановки,
		|		ЗаменыПриборовУчетаОбороты.ПриборУчета КАК ПриборУчета,
		|		ЗаменыПриборовУчетаОбороты.Услуга КАК Услуга,
		|		ЗаменыПриборовУчетаОбороты.ВидТарифа КАК ВидТарифа,
		|		ЗаменыПриборовУчетаОбороты.ПоказаниеПредыдущееОборот КАК ПоказаниеПредыдущее,
		|		ЗаменыПриборовУчетаОбороты.ПоказаниеОборот КАК Показание,
		|		ИСТИНА КАК Отключен,
		|		ЗаменыПриборовУчетаОбороты.ОбъектУстановки.ОбъектЛицевогоСчета КАК ОбъектЛицевогоСчета,
		|		ЗаменыПриборовУчетаОбороты.ПриборУчета.Коэффициент КАК Коэффициент,
		|		ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ОтветственныйВладелец КАК ОтветственныйВладелец
		|	ИЗ
		|		РегистрНакопления.ЗаменыПриборовУчета.Обороты(&НачПериода, &КонПериода, Месяц, ПриборУчета В (&ПриборыУчета)) КАК ЗаменыПриборовУчетаОбороты
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОтветственныйВладелецЛицевогоСчета.СрезПоследних(&КонПериода, ) КАК ОтветственныйВладелецЛицевогоСчетаСрезПоследних
		|			ПО ЗаменыПриборовУчетаОбороты.ОбъектУстановки = ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ЛицевойСчет
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		УстановленныеПриборыУчетаСрезПоследних.ОбъектУстановки,
		|		УстановленныеПриборыУчетаСрезПоследних.ПриборУчета,
		|		ПоказанияПриборовУчетаСрезПоследних.ПриборУчета.Услуга,
		|		ПоказанияПриборовУчетаСрезПоследних.ВидТарифа,
		|		ПоказанияПриборовУчетаСрезПоследних.Значение,
		|		0,
		|		ЛОЖЬ,
		|		УстановленныеПриборыУчетаСрезПоследних.ОбъектУстановки.ОбъектЛицевогоСчета,
		|		УстановленныеПриборыУчетаСрезПоследних.ПриборУчета.Коэффициент,
		|		ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ОтветственныйВладелец
		|	ИЗ
		|		РегистрСведений.УстановленныеПриборыУчета.СрезПоследних(&КонПериода, ПриборУчета В (&ПриборыУчета)) КАК УстановленныеПриборыУчетаСрезПоследних
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПоказанияПриборовУчета.СрезПоследних(&КонПериода, Регистратор <> &Ссылка) КАК ПоказанияПриборовУчетаСрезПоследних
		|			ПО УстановленныеПриборыУчетаСрезПоследних.ПриборУчета = ПоказанияПриборовУчетаСрезПоследних.ПриборУчета
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОтветственныйВладелецЛицевогоСчета.СрезПоследних(&КонПериода, ) КАК ОтветственныйВладелецЛицевогоСчетаСрезПоследних
		|			ПО УстановленныеПриборыУчетаСрезПоследних.ОбъектУстановки = ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ЛицевойСчет
		|	ГДЕ
		|		УстановленныеПриборыУчетаСрезПоследних.Действует = ИСТИНА) КАК ВложенныйЗапрос
		|
		|УПОРЯДОЧИТЬ ПО
		|	ОбъектУстановки,
		|	Отключен УБЫВ,
		|	ПриборУчета";
		
		
	Запрос.Параметры.Вставить("НачПериода", НачалоМесяца(Объект.ПериодНачисления));
	Запрос.Параметры.Вставить("КонПериода", КонецМесяца(Объект.ПериодНачисления));
	
	Запрос.Параметры.Вставить("Ссылка", Объект.Ссылка);
	Запрос.Параметры.Вставить("ПриборыУчета", МассивПриборыУчета);
	
	
	ВыборкаЛС = Запрос.Выполнить().Выбрать();
	
	Пока ВыборкаЛС.Следующий() Цикл
		
		НоваяСтрока = ТаблицаПерезаполнить.Добавить();
		НоваяСтрока.ОбъектУстановки = ВыборкаЛС.ОбъектУстановки;
		НоваяСтрока.ПриборУчета = ВыборкаЛС.ПриборУчета;
		НоваяСтрока.ПоказаниеПредыдущее = ВыборкаЛС.ПоказаниеПредыдущее;
		НоваяСтрока.Показание = ВыборкаЛС.Показание;
		НоваяСтрока.Коэффициент = ВыборкаЛС.Коэффициент;
		НоваяСтрока.Отключен = ВыборкаЛС.Отключен;
		НоваяСтрока.ВидТарифа = ВыборкаЛС.ВидТарифа;
		НоваяСтрока.Услуга = ВыборкаЛС.Услуга;
		НоваяСтрока.ОбъектЛицевогоСчета = ВыборкаЛС.ОбъектЛицевогоСчета;
		НоваяСтрока.ОтветственныйВладелец = ВыборкаЛС.ОтветственныйВладелец;
		
	КонецЦикла;
	
	Для Каждого СтрокаТаблицаПерезаполнить Из ТаблицаПерезаполнить Цикл
		
		МассивСтрок = Объект.Основная.НайтиСтроки(Новый Структура("ПриборУчета", СтрокаТаблицаПерезаполнить.ПриборУчета));
		
		Если МассивСтрок.Количество() = 1 Тогда
			ЗаполнитьЗначенияСвойств(МассивСтрок[0], СтрокаТаблицаПерезаполнить, ,"Показание");
			
			СтруктураДанные = Новый Структура();
			СтруктураДанные.Вставить("ПриборУчета", МассивСтрок[0].ПриборУчета);
			СтруктураДанные.Вставить("ПредыдущееПоказание", МассивСтрок[0].ПоказаниеПредыдущее);
			СтруктураДанные.Вставить("ТекущееПоказание", МассивСтрок[0].Показание);
			
			СтруктураДанные = ПолучитьДанныеОсновнаяПоказаниеПриИзменении(СтруктураДанные);
			
			МассивСтрок[0].Разница = СтруктураДанные.РасходПоПриборуУчета;
			МассивСтрок[0].ПереходЧерезНоль = СтруктураДанные.ЕстьПереходПоказанийЧерезНоль;
			МассивСтрок[0].РасходЗаПериодРасчета = СтруктураДанные.РасходЗаПериодРасчета;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Процедура устанавливает видимость и доступность элементов формы.
//
// Параметры:
//  Нет.
//
&НаСервере
Процедура УстановитьВидимостьИДоступность()
	
	
	Если Объект.Основная.Количество() = 0 Тогда
		Элементы.Организация.ТолькоПросмотр = Ложь;	
		Элементы.Здание.ТолькоПросмотр = Ложь;	
		Элементы.Услуга.ТолькоПросмотр = Ложь;
	Иначе
		Элементы.Организация.ТолькоПросмотр = Истина;	
		Элементы.Здание.ТолькоПросмотр = Истина;	
		Элементы.Услуга.ТолькоПросмотр = Истина;	
	КонецЕсли;
	
	ЕстьНезаполненныеПоказания = ЛОжь;
	
	//Кнопки командной панели формы
	ПровестиИЗакрыть = КоманднаяПанель.ПодчиненныеЭлементы.ФормаГруппа1.ПодчиненныеЭлементы.ФормаПровестиИЗакрыть;
	ЗаписатьИЗакрыть = КоманднаяПанель.ПодчиненныеЭлементы.ФормаЗаписатьИЗакрыть;
	
	Если Объект.Основная.Количество() = 0 тогда
		ПровестиИЗакрыть.КнопкаПоУмолчанию = Ложь;
		ПровестиИЗакрыть.Видимость = Ложь;
		
		
		ЗаписатьИЗакрыть.КнопкаПоУмолчанию = Истина;
		ЗаписатьИЗакрыть.Видимость = Истина;
	Иначе
		Для каждого Строка  Из Объект.Основная  Цикл
			
			
			Если Строка.Разница < 0 Тогда
				
				ПровестиИЗакрыть.КнопкаПоУмолчанию = Ложь;
				ПровестиИЗакрыть.Видимость = Ложь;
				
				ЗаписатьИЗакрыть.КнопкаПоУмолчанию = Истина;
				ЗаписатьИЗакрыть.Видимость = Истина;
				
				ЕстьНезаполненныеПоказания = Истина;
				
				Прервать;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если НЕ ЕстьНезаполненныеПоказания Тогда
			ПровестиИЗакрыть.КнопкаПоУмолчанию  = Истина;
			ПровестиИЗакрыть.Видимость = Истина;
			
			ЗаписатьИЗакрыть.КнопкаПоУмолчанию = Ложь;
			ЗаписатьИЗакрыть.Видимость = Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
	
КонецПроцедуры // УстановитьВидимостьИДоступность()


////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ - ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

// Процедура - обработчик события ПриСозданииНаСервере. 
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОСМДСервер.ЗаполнитьШапкуДокумента(
		Объект,
		,
		Параметры.ЗначениеКопирования,
		Параметры.Основание,
		СостояниеДокумента,
		КартинкаСостоянияДокумента,
		РазрешеноПроведение,
		ПоследнееИзменение,
		Параметры.ЗначенияЗаполнения);
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Объект.ПериодНачисления = КонецМесяца(ДобавитьМесяц(ТекущаяДата(),-1));
	КонецЕсли;
	
	ФорматнаяСтрока = "ru = ""Л=ru;ДФ='MMMM yyyy'""; uk = ""Л=uk;ДФ='MMMM yyyy'""";
	ОтображениеПериодаНачисления = Формат(ЭтаФорма.Объект.ПериодНачисления, НСтр(ФорматнаяСтрока));
	
	Если ЗначениеЗаполнено(Параметры.ЗначениеКопирования) Тогда
		Объект.Основная.Очистить();
	КонецЕсли;
	
	// ДополнительныеОтчетыИОбработки
	ДополнительныеОтчетыИОбработки.ПриСозданииНаСервере(ЭтаФорма);
	// Конец ДополнительныеОтчетыИОбработки
	
	Если НЕ ПолучитьФункциональнуюОпцию("ИспользоватьМобильноеПриложение") Тогда
		Элементы.ЗаполнитьПоказанияСМоб.Видимость = Ложь;	
	КонецЕсли;
	
	Локализация.ПриСозданииНаСервере(ЭтаФорма, Объект.Ссылка);
	
	УстановитьВидимостьИДоступность();
    
КонецПроцедуры

// Процедура - обработчик события ПослеЗаписи.
//
&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	ОСМДКлиент.ОбновитьСостояниеДокумента(Объект, СостояниеДокумента, КартинкаСостоянияДокумента, РазрешеноПроведение, ПоследнееИзменение);
	
КонецПроцедуры

// Процедура - обработчик события ПриЧтенииНаСервере.
//
&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект);

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ И ФУНКЦИИ ОБЩЕГО НАЗНАЧЕНИЯ

// Процедура - обработчик команды Заполнить.
//
&НаКлиенте
Процедура Заполнить(Команда)
	
	Если Объект.Основная.Количество() > 0 Тогда
		Ответ = Вопрос(НСтр("ru='Для полной очистки табличной части нажмите ""Да"", 
						|Для добавления строк в табличной части нажмите ""Нет"",
						|иначе ""Отмена""';uk='Для полной очистки табличной части нажмите ""Да"",
						|Для добавления строк в табличной части нажмите ""Нет"",						
						|иначе ""Отмена""'"),
		                      РежимДиалогаВопрос.ДаНетОтмена, , КодВозвратаДиалога.Да);
		Если Ответ = КодВозвратаДиалога.Отмена Тогда
			Возврат;
		ИначеЕсли Ответ = КодВозвратаДиалога.Да Тогда
			Объект.Основная.Очистить();
		КонецЕсли;
	КонецЕсли;
	
	
	ПараметрыЗаполнения = Новый Структура;
	
	ПараметрыЗаполнения.Вставить("ДатаНачала",		НачалоМесяца(Объект.ПериодНачисления));
	ПараметрыЗаполнения.Вставить("ДатаОкончания",	КонецМесяца(Объект.ПериодНачисления));
	ПараметрыЗаполнения.Вставить("ОтборОрганизация",	Объект.Организация);
	ПараметрыЗаполнения.Вставить("ОтборЗдание",			Объект.Здание);
	
	АдресЛицевыхСчетовВХранилище = ОткрытьФормуМодально("ОбщаяФорма.ФормаПодбораЛицевыхСчетов", ПараметрыЗаполнения);
	
	Если ЗначениеЗаполнено(АдресЛицевыхСчетовВХранилище) Тогда
		
		ПолучитьЛицевыеСчетаИзХранилища(АдресЛицевыхСчетовВХранилище);
		
	КонецЕсли;
	
	УстановитьВидимостьИДоступность();
	
КонецПроцедуры

// Процедура - обработчик команды ЗаполнитьАвтоматически.
//
&НаКлиенте
Процедура ЗаполнитьАвтоматически(Команда)
	
	Если НЕ ЗначениеЗаполнено(Объект.Здание) Тогда
	
		ТекстПредупреждения = НСтр("ru='Реквизит ""Здание"" не заполнен.';uk='Реквізит ""Будівля"" не заповнено.'"); 
		Предупреждение(ТекстПредупреждения);
		Возврат;
	КонецЕсли; 
	
	Если Объект.Основная.Количество() > 0 Тогда
		Режим = РежимДиалогаВопрос.ДаНет;
		Ответ = Вопрос(НСтр("ru='Таблица показаний приборов учета будет перезаполнена, продолжить?';uk='Таблиця показань приладів обліку буде перенаповнений, продовжити?'"), Режим, 0);
		Если Ответ = КодВозвратаДиалога.Нет Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Состояние(НСтр("ru='Идет заполнение ..."
"Пожалуйста, подождите.';uk='Йде заповнення ..."
"Будь ласка, зачекайте.'"));
	
	Объект.Основная.Очистить();
	
	ЗаполнитьАвтоматическиНаСервере();

	УстановитьВидимостьИДоступность();

	Состояние(НСтр("ru='Заполнение завершено.';uk='Заповнення завершено.'"));
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьАвтоматическиНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаменыПриборовУчетаОбороты.ОбъектУстановки КАК ОбъектУстановки,
		|	ЗаменыПриборовУчетаОбороты.ПриборУчета КАК ПриборУчета,
		|	ЗаменыПриборовУчетаОбороты.Услуга КАК Услуга,
		|	ЗаменыПриборовУчетаОбороты.ВидТарифа КАК ВидТарифа,
		|	ЗаменыПриборовУчетаОбороты.ПоказаниеПредыдущееОборот КАК ПоказаниеПредыдущееОборот,
		|	ЗаменыПриборовУчетаОбороты.ПоказаниеОборот КАК ПоказаниеОборот,
		|	ЕСТЬNULL(ЗаменыПриборовУчетаОбороты.СреднемесячноеПоказаниеОборот, 0) КАК СреднемесячноеПоказаниеОборот,
		|	ЗаменыПриборовУчетаОбороты.Период КАК Период,
		|	ЗаменыПриборовУчетаОбороты.ОбъектУстановки.ОбъектЛицевогоСчета КАК ОбъектЛицевогоСчета,
		|	ЗаменыПриборовУчетаОбороты.ПриборУчета.Коэффициент КАК Коэффициент
		|ПОМЕСТИТЬ Замена
		|ИЗ
		|	РегистрНакопления.ЗаменыПриборовУчета.Обороты(
		|			&НачПериода,
		|			&КонПериода,
		|			Месяц,
		|			ОбъектУстановки.Владелец = &Здание
		|				И ПриборУчета.Услуга = &Услуга) КАК ЗаменыПриборовУчетаОбороты
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Замена.ОбъектУстановки,
		|	Замена.ПриборУчета,
		|	Замена.Услуга,
		|	Замена.ВидТарифа,
		|	Замена.ПоказаниеПредыдущееОборот КАК ПоказаниеПредыдущее,
		|	Замена.ПоказаниеОборот КАК Показание,
