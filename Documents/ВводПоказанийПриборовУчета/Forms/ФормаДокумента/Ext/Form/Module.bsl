&НаКлиенте
Процедура ЗаполнитьПоказанияСчетчикаМоб(Команда)
	
	Если Объект.Основная.Количество() = 0 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Таблица показаний не заполнена! Перед загрузкой снятых показаний необходимо 
		|заполнить таблицу.";
		Сообщение.Сообщить(); 
		Возврат;
	КонецЕсли;
	
	Выполнено = Ложь;
	ЗаполнитьСМобильногоНаСервере(Выполнено);
	
	Если Выполнено Тогда
		ТекстВопроса = НСтр("ru='Задания успешно записаны';uk='Завдання успішно завантажені'");
		Результат = Вопрос(ТекстВопроса, РежимДиалогаВопрос.ОК);	
		
		ПоказатьОповещениеПользователя(
		"Создание:",
		ПолучитьНавигационнуюСсылку(Объект.Ссылка),
		Строка(Объект.Ссылка),
		БиблиотекаКартинок.Информация32);
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСМобильногоНаСервере(Выполнено)

	Запрос = Новый Запрос;
	Запрос.Текст ="ВЫБРАТЬ
	              |	СнятыеПоказанияПриборовУчетаСрезПоследних.ПриборУчета,
	              |	СнятыеПоказанияПриборовУчетаСрезПоследних.Значение
	              |ИЗ
	              |	РегистрСведений.СнятыеПоказанияПриборовУчета.СрезПоследних(
	              |			&Дата,
	              |			ПриборУчета В (&ПриборыУчета)
	              |				И Период >= НАЧАЛОПЕРИОДА(&МесяцНачисления, МЕСЯЦ)) КАК СнятыеПоказанияПриборовУчетаСрезПоследних
	              |ГДЕ
	              |	СнятыеПоказанияПриборовУчетаСрезПоследних.Исполнитель = &Исполнитель";
	Запрос.УстановитьПараметр("Исполнитель",Объект.Исполнитель);
	Запрос.УстановитьПараметр("МесяцНачисления",Объект.ПериодНачисления);
	Запрос.УстановитьПараметр("Дата",ТекущаяДата());
	Запрос.УстановитьПараметр("ПриборыУчета", Объект.Основная.Выгрузить().ВыгрузитьКолонку("ПриборУчета"));
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Если Результат.Количество() = 0 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru = 'Результаты сбора показаний приборов учета отсутствуют'; uk = 'Результати збору показань приладів обліку відсутні'");
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	
	
	Пока Результат.Следующий() Цикл
		СтруктураПоиска = Новый Структура("ПриборУчета,Отключен",Результат.ПриборУчета,Ложь);	
		Строка = Объект.Основная.НайтиСтроки(СтруктураПоиска);
		ПоказаниеПередРедактированием = Строка[0].Показание;
		Строка[0].Показание  = Результат.Значение;
		
		СтруктураДанные = Новый Структура();
		СтруктураДанные.Вставить("ПриборУчета", Строка[0].ПриборУчета);
		СтруктураДанные.Вставить("ПредыдущееПоказание", Строка[0].ПоказаниеПредыдущее);
		СтруктураДанные.Вставить("ТекущееПоказание", Строка[0].Показание);
		
		СтруктураДанные = ПолучитьДанныеОсновнаяПоказаниеПриИзменении(СтруктураДанные);

			Если ЗначениеЗаполнено(СтруктураДанные.ТекстОшибки) Тогда
			
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтруктураДанные.ТекстОшибки);

				Строка[0].Показание = ПоказаниеПередРедактированием;
			
				Возврат;
			КонецЕсли;
		
		Строка[0].Разница = СтруктураДанные.РасходПоПриборуУчета;
		Строка[0].ПереходЧерезНоль = СтруктураДанные.ЕстьПереходПоказанийЧерезНоль;
		Строка[0].РасходЗаПериодРасчета = СтруктураДанные.РасходЗаПериодРасчета;
		
	КонецЦикла;
	
	Выполнено = Истина;	
	
КонецПроцедуры // ЗаполнитьСМобильногоНаСервее()

