&НаСервере
Процедура ЗаполнитьПоказанияИзВсехИстониковНаСервере()
	
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПоказанияПриборовУчетаССайтаСрезПоследних.ПриборУчета,
		|	ПоказанияПриборовУчетаССайтаСрезПоследних.ВидТарифа,
		|	ПоказанияПриборовУчетаССайтаСрезПоследних.Значение,
		|	ПоказанияПриборовУчетаССайтаСрезПоследних.Период,
		|	ЗНАЧЕНИЕ(Перечисление.ИсточникиПоказаний.СайтЖКХ) КАК Источник
		|ПОМЕСТИТЬ ВТ
		|ИЗ
		|	РегистрСведений.ПоказанияПриборовУчетаССайта.СрезПоследних(
		|			&ДатаКон,
		|			ПриборУчета В (&ПриборыУчета)
		|				И ЛицевойСчет В (&ЛицевыеСчета)) КАК ПоказанияПриборовУчетаССайтаСрезПоследних
		|ГДЕ
		|	ПоказанияПриборовУчетаССайтаСрезПоследних.Период >= &ДатаНач
		|	И ПоказанияПриборовУчетаССайтаСрезПоследних.Период <= &ДатаКон
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СнятыеПоказанияПриборовУчетаСрезПоследних.ПриборУчета,
		|	ЗНАЧЕНИЕ(Перечисление.ВидыТарифов.Общий),
		|	СнятыеПоказанияПриборовУчетаСрезПоследних.Значение,
		|	СнятыеПоказанияПриборовУчетаСрезПоследних.Период,
		|	ЗНАЧЕНИЕ(Перечисление.ИсточникиПоказаний.МобильноеПриложение)
		|ИЗ
		|	РегистрСведений.СнятыеПоказанияПриборовУчета.СрезПоследних(&ДатаКон, ПриборУчета В (&приборыУчета)) КАК СнятыеПоказанияПриборовУчетаСрезПоследних
		|ГДЕ
		|	СнятыеПоказанияПриборовУчетаСрезПоследних.Период >= &ДатаНач
		|	И СнятыеПоказанияПриборовУчетаСрезПоследних.Период <= &ДатаКон
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ПоказанияПУИзВнешнихИсточниковСрезПоследних.ПриборУчета,
		|	ПоказанияПУИзВнешнихИсточниковСрезПоследних.ВидТарифа,
		|	ПоказанияПУИзВнешнихИсточниковСрезПоследних.Значение,
		|	ПоказанияПУИзВнешнихИсточниковСрезПоследних.Период,
		|	ВЫБОР
		|		КОГДА ПоказанияПУИзВнешнихИсточниковСрезПоследних.Источник = ЗНАЧЕНИЕ(Перечисление.ИсточникиПоказаний.ПустаяСсылка)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ИсточникиПоказаний.ТаблицаExcel)
		|		ИНАЧЕ ПоказанияПУИзВнешнихИсточниковСрезПоследних.Источник
		|	КОНЕЦ
		|ИЗ
		|	РегистрСведений.ПоказанияПУИзВнешнихИсточников.СрезПоследних(&ДатаКон, ПриборУчета В (&ПриборыУчета)) КАК ПоказанияПУИзВнешнихИсточниковСрезПоследних
		|ГДЕ
		|	ПоказанияПУИзВнешнихИсточниковСрезПоследних.Период >= &ДатаНач
		|	И ПоказанияПУИзВнешнихИсточниковСрезПоследних.Период <= &ДатаКон
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ПоказанияПриборовУчетаИзТелеграммСрезПоследних.ПриборУчета,
		|	ПоказанияПриборовУчетаИзТелеграммСрезПоследних.ВидТарифа,
		|	ПоказанияПриборовУчетаИзТелеграммСрезПоследних.Значение,
		|	NULL,
		|	ЗНАЧЕНИЕ(Перечисление.ИсточникиПоказаний.Телеграм)
		|ИЗ
		|	РегистрСведений.ПоказанияПриборовУчетаИзТелеграмм.СрезПоследних КАК ПоказанияПриборовУчетаИзТелеграммСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ.ПриборУчета КАК ПриборУчета,
		|	ВТ.ВидТарифа КАК ВидТарифа,
		|	ВТ.Значение,
		|	ВТ.Период КАК Период,
		|	ВТ.Источник
		|ИЗ
		|	ВТ КАК ВТ
		|
		|УПОРЯДОЧИТЬ ПО
		|	ПриборУчета,
		|	ВидТарифа,
		|	Период УБЫВ
		|ИТОГИ ПО
		|	ПриборУчета,
		|	ВидТарифа";
	
	Запрос.УстановитьПараметр("ДатаНач", НачалоМесяца(Объект.ПериодНачисления));
	Запрос.УстановитьПараметр("ДатаКон", КонецМесяца(Объект.ПериодНачисления));
	Запрос.УстановитьПараметр("ПриборыУчета", Объект.Основная.Выгрузить().ВыгрузитьКолонку("ПриборУчета"));
	Запрос.УстановитьПараметр("ЛицевыеСчета", Объект.Основная.Выгрузить().ВыгрузитьКолонку("ОбъектУстановки"));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаПрибор = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока  ВыборкаПрибор.Следующий() Цикл
		ВыборкаТариф = ВыборкаПрибор.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока  ВыборкаТариф.Следующий() Цикл
			СтруктураПоиска = Новый Структура;
			СтруктураПоиска.Вставить("ПриборУчета",ВыборкаТариф.ПриборУчета);
			СтруктураПоиска.Вставить("ВидТарифа",ВыборкаТариф.ВидТарифа);
			ВыборкаДетальныеЗаписи = ВыборкаТариф.Выбрать();
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				
				НайденныеСтроки = Объект.Основная.НайтиСтроки(СтруктураПоиска);
				Для каждого Строка Из НайденныеСтроки Цикл
				
					Если Строка.Отключен Тогда
						Продолжить;
					КонецЕсли;
					Строка.Показание = ВыборкаДетальныеЗаписи.значение;
					СтруктураДанные = Новый Структура();
					СтруктураДанные.Вставить("ПриборУчета", Строка.ПриборУчета);
					СтруктураДанные.Вставить("ПредыдущееПоказание", Строка.ПоказаниеПредыдущее);
					СтруктураДанные.Вставить("ТекущееПоказание", Строка.Показание);
					
					СтруктураДанные = ПолучитьДанныеОсновнаяПоказаниеПриИзменении(СтруктураДанные);
					
					Если ЗначениеЗаполнено(СтруктураДанные.ТекстОшибки) Тогда
						
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтруктураДанные.ТекстОшибки);
						
						Строка.Показание = ПоказаниеПередРедактированием;
						
						Возврат;
					КонецЕсли;
					Строка.Источник = ВыборкаДетальныеЗаписи.Источник;
					Строка.Разница = СтруктураДанные.РасходПоПриборуУчета;
					Строка.ПереходЧерезНоль = СтруктураДанные.ЕстьПереходПоказанийЧерезНоль;
					Строка.РасходЗаПериодРасчета = СтруктураДанные.РасходЗаПериодРасчета;
					Прервать;
				
				КонецЦикла; 
				
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

	//}}КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА

	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоказанияИзВсехИстоников(Команда)
	ЗаполнитьПоказанияИзВсехИстониковНаСервере();
КонецПроцедуры




