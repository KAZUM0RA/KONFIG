		КонецЕсли; 
		
		СтруктураДанные = Новый Структура();
		СтруктураДанные.Вставить("ПриборУчета", СтрокаОсновная.ПриборУчета);
		СтруктураДанные.Вставить("ПредыдущееПоказание", СтрокаОсновная.ПоказаниеПредыдущее);
		СтруктураДанные.Вставить("ТекущееПоказание", СтрокаОсновная.Показание);
		
		СтруктураДанные = ПолучитьДанныеОсновнаяПоказаниеПриИзменении(СтруктураДанные);
		
		СтрокаОсновная.Разница = СтруктураДанные.РасходПоПриборуУчета;
		СтрокаОсновная.ПереходЧерезНоль = СтруктураДанные.ЕстьПереходПоказанийЧерезНоль;
		СтрокаОсновная.РасходЗаПериодРасчета = СтруктураДанные.РасходЗаПериодРасчета;
	
