				НоваяСтрока.ВидТарифа = Перечисления.ВидыТарифов.Общий;
				НоваяСтрока.Услуга =  ВыборкаПоверок.ПриборУчета.Услуга;
				НоваяСтрока.ОбъектЛицевогоСчета = ВыборкаПоверок.ОбъектУстановки.ОбъектЛицевогоСчета;
				НоваяСтрока.ОтветственныйВладелец = ВыборкаПоверок.ОтветственныйВладелец;
				Разница = (ВыборкаПоверок.СреднемесячноеПоказание/(ВыборкаПоверок.ДнейВМесяце+1))*ВыборкаПоверок.ДнейПоСредней;
