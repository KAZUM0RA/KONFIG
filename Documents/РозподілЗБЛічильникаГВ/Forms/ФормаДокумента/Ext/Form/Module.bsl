// ПРОЦЕДУРИ ТА ФУНКЦІЇ ЗАГАЛЬНОГО ПРИЗНАЧЕННЯ

&НаСервере
Процедура ЗаполнитьНаСервере()
	РасчитыватьЭнергоемкость = Объект.Услуга.РасчитыватьЭнергоемкость;
	Если НЕ ЗначениеЗаполнено(Объект.УслугаСоСчетчиками) Тогда
		Сообщить("Не заповнена послуга з лічильниками!");
		Возврат;
	ИначеЕсли НЕ ЗначениеЗаполнено(УслугаБезСчетчиков) Тогда
		Сообщить("Не заповнена послуга без лічильників!");
		Возврат;
	Иначе
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	РасчетПоказанийПриборовУчетаОбороты.ОбъектУстановки КАК ЛицевойСчет,
			|	СУММА(РасчетПоказанийПриборовУчетаОбороты.ЗначениеПриход) КАК Значение,
			|	РасчетПоказанийПриборовУчетаОбороты.Период
			|ИЗ
			|	РегистрНакопления.РасчетПоказанийПриборовУчета.Обороты(
			|			&НачПериода,
			|			&КонПериода,
			|			Месяц,
			|			Услуга = &Услуга
			|				И ОбъектУстановки.Владелец = &Здание) КАК РасчетПоказанийПриборовУчетаОбороты
			|
			|СГРУППИРОВАТЬ ПО
			|	РасчетПоказанийПриборовУчетаОбороты.ОбъектУстановки,
			|	РасчетПоказанийПриборовУчетаОбороты.Период";
		Запрос.УстановитьПараметр("НачПериода", НачалоМесяца(Объект.НачПериода));
		Запрос.УстановитьПараметр("КонПериода", КонецМесяца(Объект.КонПериода));		
		Запрос.УстановитьПараметр("Услуга", 	Объект.УслугаСоСчетчиками);
		Запрос.УстановитьПараметр("Здание",     Объект.Здание);
		
		ТаблицаУслугСоСчетчиками = Запрос.Выполнить().Выгрузить();
		ЗначениеСоСчетчиками     = ТаблицаУслугСоСчетчиками.Итог("Значение");
		ТаблицаУслугСоСчетчиками.Колонки.Добавить("Показание", Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(15, 4)));
	    ТаблицаУслугСоСчетчиками.Колонки.Добавить("ЗначениеБазыСКоэффициентом", Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(15, 4)));
		
		
		// Выбор услуг без приборов учета		
		Запрос = Новый Запрос;
		Запрос.Текст = 			
		//	  "ВЫБРАТЬ РАЗЛИЧНЫЕ
		//	  |	0 КАК ИндексНабора,
		//	  |	НазначенныеУслугиСрезПоследних.ЛицевойСчет,
		//	  |	НазначенныеУслугиСрезПоследних.Организация,
		//	  |	НазначенныеУслугиСрезПоследних.Действует,
		//	  |	НазначенныеУслугиСрезПоследних.Услуга,
		//	  |	НазначенныеУслугиСрезПоследних.Услуга.ВидУслуги,
		//	  |	НазначенныеУслугиСрезПоследних.ЛицевойСчет.Владелец КАК Здание,
		//	  |	НазначенныеУслугиСрезПоследних.Период КАК ДатаНачалаДействия,
		//	  |	МАКСИМУМ(НазначенныеУслуги.Период) КАК ДатаОкончанияДействия,
		//	  |	НазначенныеУслугиСрезПоследних.Регистратор КАК РегистраторДействующих
		//	  |ИЗ
		//	  |	РегистрСведений.НазначенныеУслуги.СрезПоследних(
		//	  |			&Период,
		//	  |			Действует
		//	  |				И ЛицевойСчет.Владелец = &Здание
		//	  |				И Организация = &Организация
		//	  |				И Услуга В (&Услуга)) КАК НазначенныеУслугиСрезПоследних
		//	  |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НазначенныеУслуги КАК НазначенныеУслуги
		//	  |		ПО НазначенныеУслугиСрезПоследних.Организация = НазначенныеУслуги.Организация
		//	  |			И НазначенныеУслугиСрезПоследних.ЛицевойСчет = НазначенныеУслуги.ЛицевойСчет
		//	  |			И НазначенныеУслугиСрезПоследних.Услуга = НазначенныеУслуги.Услуга
		//	  |			И (НазначенныеУслуги.Действует = ЛОЖЬ)
		//	  |			И (НазначенныеУслуги.Период > &Период)
		//	  |
		//	  |СГРУППИРОВАТЬ ПО
		//	  |	НазначенныеУслугиСрезПоследних.ЛицевойСчет,
		//	  |	НазначенныеУслугиСрезПоследних.Организация,
		//	  |	НазначенныеУслугиСрезПоследних.Действует,
		//	  |	НазначенныеУслугиСрезПоследних.Услуга,
		//	  |	НазначенныеУслугиСрезПоследних.Услуга.ВидУслуги,
		//	  |	НазначенныеУслугиСрезПоследних.ЛицевойСчет.Владелец,
		//	  |	НазначенныеУслугиСрезПоследних.Период,
		//	  |	НазначенныеУслугиСрезПоследних.Регистратор";
		//	
		//	

		//Запрос.УстановитьПараметр("Период",	     КонецМесяца(Объект.КонПериода));
		//Запрос.УстановитьПараметр("Здание",      Объект.Здание);
		//Запрос.УстановитьПараметр("Организация", Объект.Организация);
		//Запрос.УстановитьПараметр("Услуга",      УслугаБезСчетчиков);
		
		"ВЫБРАТЬ
		|	НазначенныеУслугиСрезПоследних.ЛицевойСчет,
		|	НазначенныеУслугиСрезПоследних.Действует,
		|	НазначенныеУслугиСрезПоследних.Период,
		|	МАКСИМУМ(НазначенныеУслугиСрезПоследних.Период) КАК ДатаОкончанияДействия,
		|	НазначенныеУслугиСрезПоследних.Услуга
		|ИЗ
		|	РегистрСведений.НазначенныеУслуги.СрезПоследних(
		|			&НаДату,
		|			ЛицевойСчет.Владелец = &Здание
		|				И Организация = &Организация
		|				И Услуга В (&Услуга)) КАК НазначенныеУслугиСрезПоследних
		|
		|СГРУППИРОВАТЬ ПО
		|	НазначенныеУслугиСрезПоследних.ЛицевойСчет,
		|	НазначенныеУслугиСрезПоследних.Организация,
		|	НазначенныеУслугиСрезПоследних.Действует,
		|	НазначенныеУслугиСрезПоследних.Услуга,
		|	НазначенныеУслугиСрезПоследних.Период,
		|	НазначенныеУслугиСрезПоследних.Регистратор";
		
		Запрос.УстановитьПараметр("НаДату",      КонецМесяца(Объект.ПериодНачисления));
		Запрос.УстановитьПараметр("Здание",      Объект.Здание);
		Запрос.УстановитьПараметр("Организация", Объект.Организация);
		Запрос.УстановитьПараметр("Услуга",      УслугаБезСчетчиков);
		
		ТаблицаУслугБезСчетчиков = Запрос.Выполнить().Выгрузить();
		ТаблицаУслугБезСчетчиков.Колонки.Добавить("Показание", Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(15, 4)));
		ТаблицаУслугБезСчетчиков.Колонки.Добавить("ЗначениеБазыСКоэффициентом", Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(15, 4)));
		ТаблицаУслугБезСчетчиков.Колонки.Добавить("КвоПроживающих", Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(2, 0)));
		
		Если ТаблицаУслугБезСчетчиков.Количество() <> 0 Тогда
			ЗначениеКубовПоНорме = 0;
			ЗначениеДляРаспределения  = Объект.ЗначениеОбщедомовое - ЗначениеСоСчетчиками;
			КонецПериодаРаспределения = КонецМесяца(Объект.КонПериода);
			НачалоПериодаРаспределения = НачалоМесяца(Объект.НачПериода);    
			КвоДнейУслуги = День(Объект.КонПериода) - День(Объект.НачПериода) + 1; // Количество дней сколько надавалась услуга 
			КвоДнейВМесяце = День(КонецМесяца(Объект.КонПериода));
			Для Каждого Строка Из ТаблицаУслугБезСчетчиков Цикл
				Если Строка.Действует = Истина Тогда
					ЗначениеНормы  = ОпределениеЗначениеНормы(Строка.Услуга, Строка.ЛицевойСчет.Владелец, Строка.ЛицевойСчет);
					КвоПроживающих = ОбщийМодульМВК.ОпределитьКоличествоПрописанных(Строка.ЛицевойСчет);  //КоличествоПроживающих
					ЗначениеКубовПоНорме = ЗначениеКубовПоНорме + (ЗначениеНормы * КвоПроживающих.КоличествоПроживающих * КвоДнейУслуги / КвоДнейВМесяце); 
					Строка.КвоПроживающих = КвоПроживающих.КоличествоПроживающих;
					КоэффициентПоДням = День(Объект.НачПериода)/День(Объект.КонПериода);
					Строка.ЗначениеБазыСКоэффициентом  = КвоПроживающих.КоличествоПроживающих * КоэффициентПоДням;
				КонецЕсли;
			КонецЦикла;
			ЗначениеДляРаспределения = ЗначениеДляРаспределения - ЗначениеКубовПоНорме; 
 			ИтогБазы = ТаблицаУслугБезСчетчиков.Итог("ЗначениеБазыСКоэффициентом");
			Если ИтогБазы = 0 Тогда
				Сообщить(НСтр("ru='Итог по площади равен нулю.';uk='Підсумок по площі дорівнює нулю.'"));
				Возврат;
			КонецЕсли;
			
			Для Каждого стр Из ТаблицаУслугБезСчетчиков Цикл
				Если стр.Действует = Истина Тогда
					НоваяСтрока = Объект.Основная.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, стр);
					НоваяСтрока.ОбъектЛицевогоСчета = стр.ЛицевойСчет.ОбъектЛицевогоСчета;
					НоваяСтрока.ОтветственныйВладелец = ОпределитьответственныйВладелец(стр.ЛицевойСчет);
					КоэффициентПоДням = День(Объект.НачПериода)/День(Объект.КонПериода);// определим весь месяц или только часть его оказывалась услуга в %
					НоваяСтрока.ВидТарифа = Перечисления.ВидыТарифов.Общий;
					НоваяСтрока.Показание = ЗначениеДляРаспределения * (стр.ЗначениеБазыСКоэффициентом / ИтогБазы);   //ТаблицаУслугБезСчетчиков.Итог("КвоПроживающих")
					Если РасчитыватьЭнергоемкость Тогда
						НоваяСтрока.Энергоемкость = НоваяСтрока.Показание/Строка.ЗначениеБазы;
					Иначе
						НоваяСтрока.Энергоемкость = 0;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			
			Если Объект.Основная.Количество()> 0 Тогда
			    ГСЧ = Новый ГенераторСлучайныхЧисел();
				СЧ = ГСЧ.СлучайноеЧисло(0,  Объект.Основная.Количество() - 1);

				ЗначениеКорректировки = Объект.Основная.Итог("Показание") - ЗначениеДляРаспределения;	
			    Объект.Основная[СЧ].Показание = Объект.Основная[СЧ].Показание - ЗначениеКорректировки;		
			КонецЕсли;
		Иначе
			//НачислениеПоСреднему = ОпределитьСредннеНачисление(Объект.Здание);
			//Если НачислениеПоСреднему.Количество() <> 0 Тогда
			//	Для Каждого стр Из НачислениеПоСреднему Цикл
			//		Отбор = Новый Структура;
			//		Отбор.Вставить("ЛицевойСчет", стр.ЛицевойСчет);
			//		Отбор.Вставить("Период", НачалоМесяца(стр.Период));
			//		ЗначениеПоСчетчику = ТаблицаУслугСоСчетчиками.НайтиСтроки(Отбор);
			//		Для Каждого стрТаб Из ЗначениеПоСчетчику Цикл
			//			стрТаб.Значение = 0;
			//			стрТаб.Значение = стр.Разница * Объект.КоеффициентРаспределения;
			//		КонецЦикла;
			//	КонецЦикла;
			//КонецЕсли;
			
			ЗначениеСоСчетчиками = ТаблицаУслугСоСчетчиками.Итог("Значение");
			
			ЗначениеДляРаспределения   = Объект.ЗначениеОбщедомовое - ЗначениеСоСчетчиками;
			Если ЗначениеДляРаспределения <= 0 Тогда
				Сообщить("Різниця між показником загальнобудинкового лічильника - " + Объект.ЗначениеОбщедомовое + ", і сумою показників по лічильниках абонентів - " + ЗначениеСоСчетчиками + " менше, або дорівнює 0. Розподіляти нічого!");
				Возврат;
			КонецЕсли;
			Значение = ЗначениеДляРаспределения / ЗначениеСоСчетчиками;
			КонецПериодаРаспределения = КонецМесяца(Объект.КонПериода);
			Для Каждого Строка Из ТаблицаУслугСоСчетчиками Цикл
				КвоПроживающих = ОбщийМодульМВК.ОпределитьКоличествоПрописанных(Строка.ЛицевойСчет);  //КоличествоПроживающих
				КоэффициентПоДням = День(Строка.Период)/День(КонецПериодаРаспределения);
				Строка.ЗначениеБазыСКоэффициентом  = КвоПроживающих.КоличествоПроживающих * КоэффициентПоДням; 	
			КонецЦикла;
			
			Для Каждого стр Из ТаблицаУслугСоСчетчиками Цикл
				НоваяСтр = Объект.Основная.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтр, стр);
				НоваяСтр.ОбъектЛицевогоСчета = стр.ЛицевойСчет.ОбъектЛицевогоСчета;
				НоваяСтр.ОтветственныйВладелец = ОпределитьответственныйВладелец(стр.ЛицевойСчет);
				НоваяСтр.ВидТарифа = Перечисления.ВидыТарифов.Общий;
				НоваяСтр.Показание = стр.Значение * Значение;
			КонецЦикла;
			Если Объект.Основная.Количество()> 0 Тогда
			    ГСЧ = Новый ГенераторСлучайныхЧисел();
				СЧ = ГСЧ.СлучайноеЧисло(0,  Объект.Основная.Количество() - 1);

				ЗначениеКорректировки = Объект.Основная.Итог("Показание") - ЗначениеДляРаспределения;	
			    Объект.Основная[СЧ].Показание = Объект.Основная[СЧ].Показание - ЗначениеКорректировки;		
			КонецЕсли;			
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ОпределениеЗначениеНормы(Услуга, Здание, ЛицевойСчет)
	Запрос = Новый Запрос;
	Запрос.Текст =
	    "ВЫБРАТЬ
	    |	ТарифыСрезПоследних.Услуга,
	    |	ТарифыСрезПоследних.ЗначениеТарифа,
	    |	ТарифыСрезПоследних.НормаПотребления,
	    |	ТарифыСрезПоследних.ЗначениеТарифаПоНорме,
	    |	ВЫБОР
	    |		КОГДА ТарифыСрезПоследних.НормаПотребления <> 0
	    |			ТОГДА ""residentsNumber""
	    |		ИНАЧЕ Неопределено
	    |	КОНЕЦ КАК CHARACTERISTIC_TYPE
	    |ИЗ
	    |	РегистрСведений.Тарифы.СрезПоследних(
	    |			&НаДату,
	    |			Услуга = &Услуга
	    |				И Здание = &Здание) КАК ТарифыСрезПоследних";
	Запрос.УстановитьПараметр("Услуга", Услуга);
	Запрос.УстановитьПараметр("НаДату", ТекущаяДата());
	Запрос.УстановитьПараметр("Здание", Здание);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Норма = Выборка.НормаПотребления;
	КонецЦикла;
	Возврат Норма;
КонецФункции

&НаСервере
Функция ОпределитьответственныйВладелец(ЛицевойСчет)
    Запрос = Новый Запрос;
	Запрос.Текст =
	    "ВЫБРАТЬ
	    |	ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ОтветственныйВладелец
	    |ИЗ
	    |	РегистрСведений.ОтветственныйВладелецЛицевогоСчета.СрезПоследних(&НаДату, ЛицевойСчет = &ЛицевойСчет) КАК ОтветственныйВладелецЛицевогоСчетаСрезПоследних";
	Запрос.УстановитьПараметр("НаДату", КонецДня(ТекущаяДата()));
	Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Владелец = Выборка.ОтветственныйВладелец;
	КонецЦикла;
	Возврат Владелец;
КонецФункции


//Процедура – обробник команди Заповнити.
//
&НаКлиенте
Процедура Заполнить(Команда)
	Если Объект.Основная.Количество() > 0 Тогда
		Ответ = Вопрос(НСтр("ru='Перед зміною періоду таблична частина буде очищена. Продовжити?';uk='Перед зміною періоду таблична частина буде очищена. Продовжити?'"),
		                      РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да);
		Если Ответ = КодВозвратаДиалога.Нет Тогда
			Возврат;
		КонецЕсли;
		Объект.Основная.Очистить();
	КонецЕсли;
	ЗаполнитьНаСервере();
КонецПроцедуры

// Процедура - обробник події Під час зміни поля введення "ПеріодНарахування".
//
&НаКлиенте
Процедура ОтображениеПериодаНачисленияПриИзменении(Элемент)
	ЭтаФорма.Объект.ПериодНачисления = КонецМесяца(ЭтаФорма.Объект.ПериодНачисления);
	ФорматнаяСтрока = "uk = ""Л=uk_UA;ДФ='MMMM yyyy'""; uk = ""Л=uk_UA;ДФ='MMMM yyyy'""";
	ЭтаФорма.ОтображениеПериодаНачисления 	= Формат(ЭтаФорма.Объект.ПериодНачисления, НСтр(ФорматнаяСтрока));
КонецПроцедуры

// Процедура - обробник події Початок вибору поля введення "ПеріодНарахування".
//
&НаКлиенте
Процедура ОтображениеПериодаНачисленияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	Если ЭтаФорма.ТолькоПросмотр Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект.Основная.Количество() > 0 Тогда
		Ответ = Вопрос(НСтр("ru='Перед зміною періоду таблична частина буде очищена. Продовжити?';uk='Перед зміною періоду таблична частина буде очищена. Продовжити?'"),
		                      РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да);
		Если Ответ = КодВозвратаДиалога.Нет Тогда
			Возврат;
		КонецЕсли;
		Объект.Основная.Очистить();
	КонецЕсли;
	
	СтруктураПараметров = Новый Структура("ДатаКалендаря", ?(ЭтаФорма.Объект.ПериодНачисления= Дата('00010101'), ТекущаяДата(), ЭтаФорма.Объект.ПериодНачисления));
	ДатаКалендаряНачало = ОткрытьФормуМодально("ОбщаяФорма.ФормаКалендаря", СтруктураПараметров);
	
	ЭтаФорма.Объект.ПериодНачисления = КонецДня(ДатаКалендаряНачало);
	
	ОтображениеПериодаНачисленияПриИзменении(Элемент);
КонецПроцедуры

// Процедура - обробник події Регулювання поля "ПеріодНарахування".
//
&НаКлиенте
Процедура ОтображениеПериодаНачисленияРегулирование(Элемент, Направление, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	Если ЭтаФорма.ТолькоПросмотр Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект.Основная.Количество() > 0 Тогда
		Ответ = Вопрос(НСтр("ru='Перед зміною періоду таблична частина буде очищена. Продовжити?';uk='Перед зміною періоду таблична частина буде очищена. Продовжити?'"),
		                      РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да);
		Если Ответ = КодВозвратаДиалога.Нет Тогда
			Возврат;
		КонецЕсли;
		Объект.Основная.Очистить();
	КонецЕсли;
	

	ЭтаФорма.Объект.ПериодНачисления = ?(ЗначениеЗаполнено(ЭтаФорма.Объект.ПериодНачисления), 
						ДобавитьМесяц(ЭтаФорма.Объект.ПериодНачисления, Направление),
						ДобавитьМесяц(КонецМесяца(ТекущаяДата()), Направление));
						
	ОтображениеПериодаНачисленияПриИзменении(Элемент);
КонецПроцедуры

// Процедура - обробник події зміни поля Особового рахунку
