// ПРОЦЕДУРИ - ОБРОБНИКИ ПОДІЙ ФОРМИ

//Процедура - обробник події При створенні на сервері
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ОСМДСервер.ЗаполнитьШапкуДокумента(
		Объект,
		,
		Параметры.ЗначениеКопирования,
		Параметры.Основание,
		СостояниеДокумента,
		КартинкаСостоянияДокумента,
		РазрешеноПроведение,
		ПоследнееИзменение,
		Параметры.ЗначенияЗаполнения);
		
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Объект.ПериодНачисления = КонецМесяца(ДобавитьМесяц(ТекущаяДата(),-1));
	КонецЕсли;
	
	ФорматнаяСтрока = "uk = ""Л=uk_UA;ДФ='MMMM yyyy'""; uk = ""Л=uk_UA;ДФ='MMMM yyyy'""";
	ОтображениеПериодаНачисления = Формат(ЭтаФорма.Объект.ПериодНачисления, НСтр(ФорматнаяСтрока));
	
	Если ЗначениеЗаполнено(Параметры.ЗначениеКопирования) Тогда
		Объект.Основная.Очистить();
	КонецЕсли;
	
	// Додаткові Звіти І Обробки
	ДополнительныеОтчетыИОбработки.ПриСозданииНаСервере(ЭтаФорма);
	// Кінець Додаткові Звіти І Обробки
	
	Локализация.ПриСозданииНаСервере(ЭтаФорма, Объект.Ссылка);
	
	Если Объект.флДополнительныйПриборУчета = Ложь Тогда
		Элементы.ДопПриборУчета.Видимость = Ложь;
	Иначе
		Элементы.ДопПриборУчета.Видимость = Истина;
	КонецЕсли;
	
КонецПроцедуры

// Процедура – обробник події ПісляЗапису.
//
&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	ОСМДКлиент.ОбновитьСостояниеДокумента(Объект, СостояниеДокумента, КартинкаСостоянияДокумента, РазрешеноПроведение, ПоследнееИзменение);

КонецПроцедуры

// Процедура - обробник події при читанні на сервері.
//
&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	//ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект);
	Если Объект.флДополнительныйПриборУчета = Ложь Тогда
		Элементы.ДопПриборУчета.Видимость = Ложь;
	Иначе
		Элементы.ДопПриборУчета.Видимость = Истина;
	КонецЕсли;
КонецПроцедуры

