КонецПроцедуры

// Процедура - обробник події зміни поля Загально-будинкового лічильника
//
&НаСервере
Процедура ОбщедомовойПриборУчетаПриИзмененииНаСервере()
	ДанныеСчетчика = РасчетУслугПоТЕиГВ.ПолучитьПоказания(Объект.ОбщедомовойПриборУчета, Объект.ПериодНачисления);
	Если Объект.флДополнительныйПриборУчета Тогда
		Если ДанныеСчетчика <> Неопределено Тогда
			ДанныеДопСчетчика         = РасчетУслугПоТЕиГВ.ПолучитьПоказания(Объект.ДопПриборУчета, Объект.ПериодНачисления);
			Объект.ЗначениеОбщедомовое    = ДанныеСчетчика.КвоТЕ - ДанныеДопСчетчика.КвоКубов;
		КонецЕсли;
	Иначе
		Если ДанныеСчетчика <> Неопределено Тогда
		    Объект.ЗначениеОбщедомовое    = ДанныеСчетчика.КвоТЕ;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбщедомовойПриборУчетаПриИзменении(Элемент)
	ОбщедомовойПриборУчетаПриИзмененииНаСервере();
КонецПроцедуры

