&НаСервере
Процедура ПриСозданииЧтенииНаСервере()
	
	
	Если Не Объект.Ссылка.Пустая() Тогда
		Предмет = Взаимодействия.ПолучитьЗначениеПредмета(Объект.Ссылка);
	КонецЕсли;
	//+ HVOYA ДовганьЮ 31.07.2013 14:34:51
	Если ТипЗнч(Предмет) = Тип("ДокументСсылка.Встреча") Тогда 
		ОписаниеЗаявки.Добавить(Предмет.Описание,);
		Объект.Тема = Предмет.Тема;
	ИначеЕсли ТипЗнч(Предмет) = Тип("ДокументСсылка.ТелефонныйЗвонок") Тогда
		ОписаниеЗаявки.Добавить(Предмет.Описание,);
		Объект.Тема = Предмет.Тема;
	ИначеЕсли  ТипЗнч(Предмет) = Тип("ДокументСсылка.ЭлектронноеПисьмоИсходящее")ИЛИ ТипЗнч(Предмет) = Тип("ДокументСсылка.ЭлектронноеПисьмоВходящее")Тогда
		
		ИмяВременногоФайла = ПолучитьИмяВременногоФайла();
		ЗаписьТекста = Новый ЗаписьТекста(ИмяВременногоФайла, );
		ЗаписьТекста.Записать(
		?(Предмет.ТипТекста = Перечисления.ТипыТекстовЭлектронныхПисем.HTML, Предмет.ТекстHTML, Предмет.Текст));
		ЗаписьТекста.Закрыть();
		
		ЧтениеТекста = Новый ЧтениеТекста(ИмяВременногоФайла, );
		Если Предмет.ТипТекста = Перечисления.ТипыТекстовЭлектронныхПисем.HTML Тогда
			Элементы.СтраницыОписаниеДополнительно.ТекущаяСтраница = Элементы.СтраницаОписаниеHTML;
			ОписаниеЗаявкаHTML = Предмет.ТекстHTML;
		Иначе
			ОписаниеЗаявки.Добавить(Предмет.Текст,);
		КонецЕсли;
		
		
		
		//- HVOYA ДовганьЮ 31.07.2013 14:34:57	
		
	КонецЕсли;
	
	ВзаимодействияКлиентСервер.ПроверитьЗаполнениеКонтактов(Объект, ЭтаФорма, "Заявка");
	Элементы.РассмотретьПосле.Доступность = НЕ Объект.Рассмотрено;
	Элементы.СтраницаКомментарий.Картинка = ОбщегоНазначения.ПолучитьКартинкуКомментария(Объект.Комментарий);
	
	ОбработатьПереданныеПараметры(Параметры);
	ЗаполнитьВложения(Параметры);
КонецПроцедуры 


