&НаСервере
Процедура ЛицевойСчетПрибораУчетаПриИзмененииНаСервере()
	Объект.Здание = Объект.ЛицевойСчетПрибораУчета.Владелец;
	Если НЕ ЗначениеЗаполнено(Объект.Подъезд) Тогда
	    Sобщ_дом      = ПолучитьПлощадьЗдания(Объект.Здание);
	Иначе
		Sобщ_дом      = РасчетУслугПоТЕиГВ.ТаблицаЛС(Объект.ПериодНачисления, Объект.Услуга, Объект.Услуга.БазаРаспределенияРасчетнойУслуги, 
		                                             Объект.Здание, Объект.Подъезд);		                                             
	КонецЕсли;
    Если НЕ ЗначениеЗаполнено(Объект.Подъезд) Тогда
	    Sобщ_инд_от   = ОбщийМодульМВК.ВыборкаПлощадейИндОтопления(Объект.Здание);
	Иначе
		Sобщ_инд_от   = ОбщийМодульМВК.ВыборкаПлощадейИндОтопления(Объект.Здание, Объект.Подъезд);
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Объект.Подъезд) Тогда
	    Sобщ_вро      = РасчетУслугПоТЕиГВ.ВыборкаПлощадейСВРО(Объект.Здание).Итог("Площадь");
	    Sобщ_вко      = РасчетУслугПоТЕиГВ.ВыборкаПлощадейСВКО(Объект.Здание).Итог("Площадь");
	Иначе
		Sобщ_вро      = РасчетУслугПоТЕиГВ.ВыборкаПлощадейСВРО(Объект.Здание, Объект.Подъезд).Итог("Площадь");
	    Sобщ_вко      = РасчетУслугПоТЕиГВ.ВыборкаПлощадейСВКО(Объект.Здание, объект.Подъезд).Итог("Площадь");
	КонецЕсли;
	Qmax = Объект.Здание.Qmax;
	t_вн_норм = Объект.Здание.ВнутренняяТемператураЗдания;
	коеф_Z = 1 + (Sобщ_инд_от / Sобщ_дом);
	t_сер_оп_пер = Константы.t_сер_оп_пер.Получить();
	t_min_оп_пер = Константы.t_min_оп_пер.Получить();
	По_ = (Константы.ДатаОкончанияОтопительногоСезона.Получить() - Константы.ДатаНачалаОтопительногоСезона.Получить()) / 86400;
	Пр = Число(Сред(КонецМесяца(Объект.ПериодНачисления), 1, 2));	
	// Нормативне теплове навантаження будівлі/будинку, Гкал/год
	Q_буд_норм = Qmax*((t_вн_норм - t_сер_оп_пер) / (t_вн_норм - t_min_оп_пер));
	
	// Кількість теплової енергії, спожитої будівлею/будинком за опалювальний період 
	Q_буд_за_оп_пер_норм = Q_буд_норм * 24 * По_;
	
	// Фактичний обсяг спожитої у будівлі/будинку теплової енергії у розрахунковому періоді
	Запрос = Новый Запрос;
	Запрос.Текст =
	    "ВЫБРАТЬ
	    |	СреднемесячныеПоказанияТемператур.СреднеМесячнаяТемператураФакт
	    |ИЗ
	    |	РегистрСведений.СреднемесячныеПоказанияТемператур КАК СреднемесячныеПоказанияТемператур
	    |ГДЕ
	    |	СреднемесячныеПоказанияТемператур.Месяц = &Месяц";
	Запрос.УстановитьПараметр("Месяц", Объект.ПериодНачисления);
	Результат = Запрос.Выполнить();
	Если НЕ Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл
			t_факт = Выборка.СреднеМесячнаяТемператураФакт;
		КонецЦикла;
	Иначе
		t_факт = 0;
	КонецЕсли;
	 
	Q_оп_буд = (1 - (Sобщ_инд_от/Sобщ_дом)) * Q_буд_норм * (Пр * 24) * ((t_вн_норм - t_факт) / (t_вн_норм - t_сер_оп_пер));
	
	// Норма споживання (Nбуд) теплової енергії у будівлі/будинку протягом опалювального періоду
	Nбуд = Q_буд_за_оп_пер_норм / Sобщ_дом;
КонецПроцедуры

