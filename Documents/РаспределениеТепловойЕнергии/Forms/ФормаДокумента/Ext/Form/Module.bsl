&НаСервере
Функция МЗК_ПоДоговору(ДанныеСчетчика = 0)
	//Если Месяц(Объект.ПериодНачисления) = Месяц(Константы.ДатаОкончанияОтопительногоСезона.Получить()) Тогда
		//КвоЧасовОтопления = (Константы.ДатаОкончанияОтопительногоСезона.Получить() - НачалоМесяца(Объект.ПериодНачисления)) * 24;
	//КонецЕсли;
	//Если Месяц(Объект.ПериодНачисления) = Месяц(Константы.ДатаНачалаОтопительногоСезона.Получить()) Тогда
		//КвоЧасовОтопления = КонецМесяца(Объект.ПериодНачисления)-Дата(Константы.ДатаНачалаОтопительногоСезона.Получить()) * 24;
		КвоЧасовОтопления = День(КонецМесяца(Объект.ПериодНачисления)) * 24;
	//КонецЕсли;
		
	ЕдИзмСчетчика              = Объект.ОбщедомовойПриборУчета.ЕдиницаИзмерения;
	Если ЕдИзмСчетчика = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду("900") Тогда // Из ГДж
		ВсегоГКал = (ДанныеСчетчика.РазницаПоказания * 0.2388) + Объект.СреднееЗначение;
	ИначеЕсли ЕдИзмСчетчика = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду("901") Тогда // Из МВт
		ВсегоГКал = (ДанныеСчетчика.РазницаПоказания * 0.8598) + Объект.СреднееЗначение;
	ИначеЕсли ЕдИзмСчетчика = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду("214") Тогда // Из кВт
		ВсегоГКал = (ДанныеСчетчика.РазницаПоказания * 0.0008598) + Объект.СреднееЗначение;
	ИначеЕсли ЕдИзмСчетчика = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду("245") Тогда // Из кВт
		ВсегоГКал = (ДанныеСчетчика.РазницаПоказания * 0.0008598) + Объект.СреднееЗначение;
	Иначе
		ВсегоГКал = ДанныеСчетчика.РазницаПоказания;
	КонецЕсли;
	
	Q_опал_функц_вбс = 0.00000086 * 11 * Объект.Здание.ДлиннаТрубопровода * КвоЧасовОтопления;     // (формула 23)
	
	МЗК = (ВсегоГКал * (Объект.Здание.ПлощадьМЗК / Sобщ_дом)) + Q_опал_функц_вбс;
	
	Возврат МЗК;
	
КонецФункции

&НаСервере
Процедура ОбщедомовойПриборУчетаПриИзмененииНаСервере()
    СуммаГКалЗаВРО = 0;
	СуммаГКалДонараховних = 0;
	СуммаГКалЗаВКО = 0;
	
	ДанныеСчетчика             = РасчетУслугПоТЕиГВ.ПолучитьПоказанияПрибораУчетаПоТЕ(Объект.ОбщедомовойПриборУчета, Объект.ПериодНачисления);
	ЕдИзмСчетчика              = Объект.ОбщедомовойПриборУчета.ЕдиницаИзмерения;
	КоличествоДнейТекМес       = Число(Сред(КонецМесяца(Объект.ПериодНачисления), 1, 2));
	Если Объект.Здание.НаличиеПроектаНаЗБП Тогда
		МЗК_рассчет            = МЗК_ПоДоговору(ДанныеСчетчика);
	Иначе
	    МЗК                    = Объект.Здание.МестаОбщПользования;
	КонецЕсли;
	ИТП                        = Объект.Здание.ИТП;
	Теплогенераторна           = Объект.Здание.ТеплоГенераторна;
	

	//	
	Если ЕдИзмСчетчика = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду("900") Тогда // Из ГДж
		Объект.ВсегоГКал = (ДанныеСчетчика.РазницаПоказания * 0.2388) + Объект.СреднееЗначение;
	ИначеЕсли ЕдИзмСчетчика = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду("901") Тогда // Из МВт
		Объект.ВсегоГКал = (ДанныеСчетчика.РазницаПоказания * 0.8598) + Объект.СреднееЗначение;
	ИначеЕсли ЕдИзмСчетчика = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду("214") Тогда // Из кВт
		Объект.ВсегоГКал = (ДанныеСчетчика.РазницаПоказания * 0.0008598) + Объект.СреднееЗначение;
	ИначеЕсли ЕдИзмСчетчика = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду("245") Тогда // Из кВт
		Объект.ВсегоГКал = (ДанныеСчетчика.РазницаПоказания * 0.0008598) + Объект.СреднееЗначение;
	Иначе
		Объект.ВсегоГКал = ДанныеСчетчика.РазницаПоказания;
	КонецЕсли;
	
	Если Объект.ДопПриборУчета Тогда
		ДанныеДопСчетчика             = РасчетУслугПоТЕиГВ.ПолучитьПоказанияПрибораУчетаПоТЕ(Объект.ПриборУчета2, Объект.ПериодНачисления);
		ЕдИзмСчетчика              = Объект.ПриборУчета2.ЕдиницаИзмерения;
		Если ЕдИзмСчетчика = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду("900") Тогда // Из ГДж
			Объект.ВсегоГКал = Объект.ВсегоГКал + ДанныеДопСчетчика.РазницаПоказания * 0.2388;
		ИначеЕсли ЕдИзмСчетчика = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду("901") Тогда // Из МВт
			Объект.ВсегоГКал = Объект.ВсегоГКал + ДанныеДопСчетчика.РазницаПоказания * 0.86;
		ИначеЕсли ЕдИзмСчетчика = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду("214") Тогда // Из кВт
			Объект.ВсегоГКал = Объект.ВсегоГКал + ДанныеДопСчетчика.РазницаПоказания * 0.0008598;
		ИначеЕсли ЕдИзмСчетчика = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду("245") Тогда // Из кВт
			Объект.ВсегоГКал = Объект.ВсегоГКал + ДанныеДопСчетчика.РазницаПоказания * 0.0008598;
		Иначе
			Объект.ВсегоГКал = Объект.ВсегоГКал + ДанныеДопСчетчика.РазницаПоказания;
		КонецЕсли;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.Подъезд) Тогда
	    КвоВРО = КоличествоПриборовВДоме(Перечисления.МетодыУстановкиПриборовУчета.ВРО, Объект.Здание);
	    КвоВКО = КоличествоПриборовВДоме(Перечисления.МетодыУстановкиПриборовУчета.ВКО, Объект.Здание);
	Иначе
        КвоВРО = КоличествоПриборовВДоме(Перечисления.МетодыУстановкиПриборовУчета.ВРО, Объект.Здание, Объект.Подъезд);
	    КвоВКО = КоличествоПриборовВДоме(Перечисления.МетодыУстановкиПриборовУчета.ВКО, Объект.Здание, Объект.Подъезд);
	КонецЕсли;
	
	Если КвоВРО.Количество() <> 0 Тогда
		СуммаГКалЗаВРО = 0;
	    СуммаГКалДонараховних = 0;
	    СуммаГКалЗаВКО = 0;
