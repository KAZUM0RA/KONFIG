
////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ И ФУНКЦИИ ОБЩЕГО НАЗНАЧЕНИЯ

// Процедура ЗаполнитьНаСервере()
//
&НаСервере
Процедура ЗаполнитьНаСервере()
	
	РасчитыватьЭнергоемкость = Объект.Услуга.РасчитыватьЭнергоемкость;
	
	Если ЗначениеЗаполнено(Объект.УслугаИндивидуальная) Тогда
	
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	РасчетПоказанийПриборовУчета.ОбъектУстановки КАК ЛицевойСчет,
			|	СУММА(РасчетПоказанийПриборовУчета.Значение) КАК Значение,
			|	ПлощадьОбъектовЛицевыхСчетовСрезПоследних.Площадь КАК ЗначениеБазы,
			|	ЕСТЬNULL(НазначенныеУслугиСрезПоследних.Период, &ПериодКон) КАК Период,
			|	ЕСТЬNULL(НазначенныеУслугиСрезПоследних.Действует, ЛОЖЬ) КАК Действует
			|ИЗ
			|	РегистрНакопления.РасчетПоказанийПриборовУчета КАК РасчетПоказанийПриборовУчета
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПлощадьОбъектовЛицевыхСчетов.СрезПоследних(&ПериодКон, ВидПлощади = &ВидБазыРаспределения) КАК ПлощадьОбъектовЛицевыхСчетовСрезПоследних
			|		ПО РасчетПоказанийПриборовУчета.ОбъектУстановки.ОбъектЛицевогоСчета = ПлощадьОбъектовЛицевыхСчетовСрезПоследних.Помещение
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НазначенныеУслуги.СрезПоследних(&ПериодКон, Услуга = &Услуга) КАК НазначенныеУслугиСрезПоследних
			|		ПО РасчетПоказанийПриборовУчета.ОбъектУстановки = НазначенныеУслугиСрезПоследних.ЛицевойСчет
			|ГДЕ
			|	РасчетПоказанийПриборовУчета.ОбъектУстановки.Владелец = &Здание
			|	И РасчетПоказанийПриборовУчета.Период МЕЖДУ &ПериодНач И &ПериодКон
			|	И РасчетПоказанийПриборовУчета.ОбъектУстановки.ВРО = ИСТИНА
			|	И РасчетПоказанийПриборовУчета.Услуга = &Услуга
			|
			|СГРУППИРОВАТЬ ПО
			|	РасчетПоказанийПриборовУчета.ОбъектУстановки,
			|	ЕСТЬNULL(НазначенныеУслугиСрезПоследних.Период, &ПериодКон),
			|	ЕСТЬNULL(НазначенныеУслугиСрезПоследних.Действует, ЛОЖЬ),
			|	ПлощадьОбъектовЛицевыхСчетовСрезПоследних.Площадь";
			
		Запрос.УстановитьПараметр("ПериодНач",	НачалоМесяца(Объект.ПериодНачисления));		
		Запрос.УстановитьПараметр("ПериодКон",	КонецМесяца(Объект.ПериодНачисления));		
		Запрос.УстановитьПараметр("Услуга", 	Объект.УслугаИндивидуальная);
		Запрос.УстановитьПараметр("Здание",     Объект.Здание);
		Запрос.УстановитьПараметр("ВидБазыРаспределения", Объект.Услуга.БазаРаспределенияРасчетнойУслуги);
		
		ТаблицаУслугСоСчетчиками = Запрос.Выполнить().Выгрузить();
		
		ТаблицаУслугСоСчетчиками.Колонки.Добавить("Дней", Новый ОписаниеТипов("Число"));
		ЗначениеСоСчетчиками = ТаблицаУслугСоСчетчиками.Итог("Значение");
		МассивЛС = Новый Массив;
		Для каждого Строка  Из ТаблицаУслугСоСчетчиками Цикл
		
			Если НЕ Строка.Действует Тогда 
				
			      Строка.Дней = (НачалоМесяца(Объект.ПериодНачисления) - НачалоДня(Строка.Период))/(60*60*24);
			  Иначе
				  МассивЛС.Добавить(Строка.ЛицевойСчет);
				  Строка.Дней = 0
			
			КонецЕсли; 
		
		КонецЦикла; 
		МассивЛС = ТаблицаУслугСоСчетчиками.ВыгрузитьКолонку("ЛицевойСчет");
	Иначе
		МассивЛС = Новый Массив;
		ЗначениеСоСчетчиками = 0;		
	КонецЕсли; 	
	
	Если ТипЗнч(Объект.Услуга.БазаРаспределенияРасчетнойУслуги) = Тип("ПеречислениеСсылка.ВидыПотребителейУслуг") Тогда
		
		ТекстЗапроса =
			"ВЫБРАТЬ
			|	НазначенныеУслугиСрезПоследних.ЛицевойСчет КАК ЛицевойСчет,
			|	НазначенныеУслугиСрезПоследних.ЛицевойСчет.ОбъектЛицевогоСчета КАК ОбъектЛицевогоСчета,
			|	ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ОтветственныйВладелец КАК ОтветственныйВладелец,
			|	ВЫБОР
			|		КОГДА &ВидБазыРаспределения = ЗНАЧЕНИЕ(Перечисление.ВидыПотребителейУслуг.Прописанные)
			|			ТОГДА ЛицевыеСчетаСрезПоследних.КоличествоПрописанных
			|		ИНАЧЕ ЛицевыеСчетаСрезПоследних.КоличествоПроживающих
			|	КОНЕЦ КАК ЗначениеБазы,
			|	&Период
			|ИЗ
			|	РегистрСведений.НазначенныеУслуги.СрезПоследних(
			|			&Период,
			|			ЛицевойСчет.Владелец = &Здание
			|				И Услуга = &Услуга
			//|				И НЕ ЛицевойСчет В (&СписокЛицевыхСчетов)
			|				И ВЫБОР
			|					КОГДА &Подъезд = ЗНАЧЕНИЕ(Справочник.Подъезды.ПустаяСсылка)
			|						ТОГДА ИСТИНА
			|					ИНАЧЕ ЛицевойСчет.ОбъектЛицевогоСчета.Подъезд = &Подъезд
			|				КОНЕЦ) КАК НазначенныеУслугиСрезПоследних
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОтветственныйВладелецЛицевогоСчета.СрезПоследних(&Период, ) КАК ОтветственныйВладелецЛицевогоСчетаСрезПоследних
			|		ПО НазначенныеУслугиСрезПоследних.ЛицевойСчет = ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ЛицевойСчет
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛицевыеСчета.СрезПоследних(&Период, ) КАК ЛицевыеСчетаСрезПоследних
			|		ПО НазначенныеУслугиСрезПоследних.ЛицевойСчет = ЛицевыеСчетаСрезПоследних.ЛицевойСчет
			|ГДЕ
			|	НазначенныеУслугиСрезПоследних.Действует = ИСТИНА
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	НазначенныеУслугиСрезПоследних.ЛицевойСчет,
			|	НазначенныеУслугиСрезПоследних.ЛицевойСчет.ОбъектЛицевогоСчета,
			|	ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ОтветственныйВладелец,
			|	ВЫБОР
			|		КОГДА &ВидБазыРаспределения = ЗНАЧЕНИЕ(Перечисление.ВидыПотребителейУслуг.Прописанные)
			|			ТОГДА ЛицевыеСчетаСрезПоследних.КоличествоПрописанных
			|		ИНАЧЕ ЛицевыеСчетаСрезПоследних.КоличествоПроживающих
			|	КОНЕЦ,
			|	НазначенныеУслугиСрезПоследних.Период
			|ИЗ
			|	РегистрСведений.НазначенныеУслуги.СрезПоследних(
			|			&Период,
			|			ЛицевойСчет.Владелец = &Здание
			|				И Услуга = &Услуга
			//|				И НЕ ЛицевойСчет В (&СписокЛицевыхСчетов)
			|				И ВЫБОР
			|					КОГДА &Подъезд = ЗНАЧЕНИЕ(Справочник.Подъезды.ПустаяСсылка)
			|						ТОГДА ИСТИНА
			|					ИНАЧЕ ЛицевойСчет.ОбъектЛицевогоСчета.Подъезд = &Подъезд
			|				КОНЕЦ) КАК НазначенныеУслугиСрезПоследних
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОтветственныйВладелецЛицевогоСчета.СрезПоследних(&Период, ) КАК ОтветственныйВладелецЛицевогоСчетаСрезПоследних
			|		ПО НазначенныеУслугиСрезПоследних.ЛицевойСчет = ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ЛицевойСчет
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛицевыеСчета.СрезПоследних(&Период, ) КАК ЛицевыеСчетаСрезПоследних
			|		ПО НазначенныеУслугиСрезПоследних.ЛицевойСчет = ЛицевыеСчетаСрезПоследних.ЛицевойСчет
			|ГДЕ
			|	НазначенныеУслугиСрезПоследних.Действует = ЛОЖЬ
			|	И НазначенныеУслугиСрезПоследних.Период > НАЧАЛОПЕРИОДА(&Период, МЕСЯЦ)";
		
	Иначе
		
		ТекстЗапроса =
			"ВЫБРАТЬ
			|	НазначенныеУслугиСрезПоследних.ЛицевойСчет КАК ЛицевойСчет,
			|	ЕСТЬNULL(ПлощадьОбъектовЛицевыхСчетовСрезПоследних.Площадь, 0) КАК ЗначениеБазы,
			|	НазначенныеУслугиСрезПоследних.ЛицевойСчет.ОбъектЛицевогоСчета КАК ОбъектЛицевогоСчета,
			|	ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ОтветственныйВладелец КАК ОтветственныйВладелец,
			|	&Период КАК Период
			|ИЗ
			|	РегистрСведений.НазначенныеУслуги.СрезПоследних(
			|			&Период,
			|			ЛицевойСчет.Владелец = &Здание
			|				И Услуга = &Услуга
			//|				И НЕ ЛицевойСчет В (&СписокЛицевыхСчетов)
			|				И ВЫБОР
			|					КОГДА &Подъезд = ЗНАЧЕНИЕ(Справочник.Подъезды.ПустаяСсылка)
			|						ТОГДА ИСТИНА
			|					ИНАЧЕ ЛицевойСчет.ОбъектЛицевогоСчета.Подъезд = &Подъезд
			|				КОНЕЦ) КАК НазначенныеУслугиСрезПоследних
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПлощадьОбъектовЛицевыхСчетов.СрезПоследних(&Период, ВидПлощади = &ВидБазыРаспределения) КАК ПлощадьОбъектовЛицевыхСчетовСрезПоследних
			|		ПО НазначенныеУслугиСрезПоследних.ЛицевойСчет.ОбъектЛицевогоСчета = ПлощадьОбъектовЛицевыхСчетовСрезПоследних.Помещение
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОтветственныйВладелецЛицевогоСчета.СрезПоследних(&Период, ) КАК ОтветственныйВладелецЛицевогоСчетаСрезПоследних
			|		ПО НазначенныеУслугиСрезПоследних.ЛицевойСчет = ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ЛицевойСчет
			|ГДЕ
			|	НазначенныеУслугиСрезПоследних.Действует = ИСТИНА
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	НазначенныеУслугиСрезПоследних.ЛицевойСчет,
			|	ЕСТЬNULL(ПлощадьОбъектовЛицевыхСчетовСрезПоследних.Площадь, 0),
			|	НазначенныеУслугиСрезПоследних.ЛицевойСчет.ОбъектЛицевогоСчета,
			|	ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ОтветственныйВладелец,
			|	НазначенныеУслугиСрезПоследних.Период
			|ИЗ
			|	РегистрСведений.НазначенныеУслуги.СрезПоследних(
			|			&Период,
			|			ЛицевойСчет.Владелец = &Здание
			|				И Услуга = &Услуга
			//|				И НЕ ЛицевойСчет В (&СписокЛицевыхСчетов)
			|				И ВЫБОР
			|					КОГДА &Подъезд = ЗНАЧЕНИЕ(Справочник.Подъезды.ПустаяСсылка)
			|						ТОГДА ИСТИНА
			|					ИНАЧЕ ЛицевойСчет.ОбъектЛицевогоСчета.Подъезд = &Подъезд
			|				КОНЕЦ) КАК НазначенныеУслугиСрезПоследних
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПлощадьОбъектовЛицевыхСчетов.СрезПоследних(&Период, ВидПлощади = &ВидБазыРаспределения) КАК ПлощадьОбъектовЛицевыхСчетовСрезПоследних
			|		ПО НазначенныеУслугиСрезПоследних.ЛицевойСчет.ОбъектЛицевогоСчета = ПлощадьОбъектовЛицевыхСчетовСрезПоследних.Помещение
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОтветственныйВладелецЛицевогоСчета.СрезПоследних(&Период, ) КАК ОтветственныйВладелецЛицевогоСчетаСрезПоследних
			|		ПО НазначенныеУслугиСрезПоследних.ЛицевойСчет = ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ЛицевойСчет
			|ГДЕ
			|	НазначенныеУслугиСрезПоследних.Действует = ЛОЖЬ
			|	И НазначенныеУслугиСрезПоследних.Период > НАЧАЛОПЕРИОДА(&Период, МЕСЯЦ)";
			
	КонецЕсли;	
		
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
		
	Запрос.УстановитьПараметр("Период", КонецМесяца(Объект.ПериодНачисления));		
	Запрос.УстановитьПараметр("Услуга", Объект.Услуга);		
	Запрос.УстановитьПараметр("ВидБазыРаспределения", Объект.Услуга.БазаРаспределенияРасчетнойУслуги);		
	Запрос.УстановитьПараметр("Здание", Объект.Здание);
	Запрос.УстановитьПараметр("Подъезд", Объект.Подъезд);
	//Запрос.УстановитьПараметр("СписокЛицевыхСчетов", МассивЛС);
	
	ТаблицаЛицевыхСчетов = Запрос.Выполнить().Выгрузить();
	ТаблицаЛицевыхСчетов.Колонки.Добавить("Показание", Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(15, 6)));
	ТаблицаЛицевыхСчетов.Колонки.Добавить("ПоказаниеВРО", Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(15, 6)));
	ТаблицаЛицевыхСчетов.Колонки.Добавить("ПоказаниеВКО", Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(15, 6)));
	ТаблицаЛицевыхСчетов.Колонки.Добавить("ЗначениеБазыСКоэффициентом", Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(15, 4)));
	
	Если НЕ ТаблицаУслугСоСчетчиками = Неопределено Тогда
		Для Каждого СтрокиВРО Из ТаблицаУслугСоСчетчиками Цикл
			НовСтрока = ТаблицаЛицевыхСчетов.Добавить();
			НовСтрока.ЛицевойСчет           = СтрокиВРО.ЛицевойСчет;
			НовСтрока.ЗначениеБазы          = СтрокиВРО.ЗначениеБазы;
			НовСтрока.ОбъектЛицевогоСчета   = СтрокиВРО.ЛицевойСчет.ОбъектЛицевогоСчета;
			НовСтрока.Период                = КонецМесяца(Объект.ПериодНачисления);                    //СтрокиВРО.Период;
			НовСтрока.ОтветственныйВладелец = ОбщийМодульМВК.ПолучитьПотребителя(СтрокиВРО.ЛицевойСчет);
			НовСтрока.ПоказаниеВРО          = СтрокиВРО.Значение;
		КонецЦикла;
	КонецЕсли;
	
	Для каждого Строка Из ТаблицаЛицевыхСчетов Цикл
		
		КоэффициентПоДням = День(Строка.Период)/День(Объект.ПериодНачисления);
		Строка.ЗначениеБазыСКоэффициентом  = Строка.ЗначениеБазы * КоэффициентПоДням; 
			
	КонецЦикла;
	
	ИтогБазы = ТаблицаЛицевыхСчетов.Итог("ЗначениеБазыСКоэффициентом");
	Если ИтогБазы = 0 Тогда
		Сообщить(НСтр("ru='Итог по площади равен нулю.';uk='Підсумок по площі дорівнює нулю.'"));
		Возврат;
	КонецЕсли;

	ОтапливаемаяПлощадьЗдания = ПолучитьПлощадьЗдания(Объект.Здание);
		
	ЗначениеЗБП            = Объект.ЗначениеМЗК;	
	////ЗначениеТЕБезСчетчиков = Объект.ВсегоГКал - ЗначениеЗБП - СуммаГКалЗаВРО - СуммаГКалДонараховних - СуммаГКалЗаВКО;								 
	////НаСпоживача_м2         = ЗначениеТЕБезСчетчиков / (Sобщ_дом - Sобщ_инд_от - Sобщ_вро);
	
	Для каждого Строка Из ТаблицаЛицевыхСчетов Цикл
		
		Если Строка.ЛицевойСчет.ИндОтопление Тогда
			НоваяСтрока = Объект.Основная.Добавить();
		    ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
			НоваяСтрока.ВидТарифа = Перечисления.ВидыТарифов.Общий;
			НоваяСтрока.ЗБП = тзДанныхДляРаспределения[0].ТЕНаЗБПм2 * Строка.ЗначениеБазы;
			НоваяСтрока.Показание = НоваяСтрока.ЗБП;
			НоваяСтрока.ОтапливаемаПлощадь = Строка.ЗначениеБазы;
		ИначеЕсли Строка.ЛицевойСчет.ВРО Тогда
			НебалансМ2 = 0;
			НоваяСтрока = Объект.Основная.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
			НоваяСтрока.ВидТарифа = Перечисления.ВидыТарифов.Общий;
			НоваяСтрока.ЗБП = тзДанныхДляРаспределения[0].ТЕНаЗБПм2 * Строка.ЗначениеБазы;
			
			Показания  = РасчетУслугПоТЕиГВ.КоличествоПриборовВДоме(Перечисления.МетодыУстановкиПриборовУчета.ВРО, Строка.ЛицевойСчет, Объект.ПериодНачисления)[0].Значение;
			Коэфициент = РасчетУслугПоТЕиГВ.КоличествоПриборовВДоме(Перечисления.МетодыУстановкиПриборовУчета.ВРО, Строка.ЛицевойСчет, Объект.ПериодНачисления)[0].ПриборУчетаКоэффициент;
			Если ЗначениеЗаполнено(Показания) Тогда
			    НоваяСтрока.ВРО = Показания * Коэфициент;//Строка.ПоказаниеВРО;
			Иначе
				НоваяСтрока.ВРО = 0;
			КонецЕсли;
			// Середнє питоме споживання теплової енергії на опалення приміщень 
		    q_оп = (Объект.ВсегоГКал - Объект.ЗначениеМЗК) / (Sобщ_дом - Sобщ_инд_от);
			
			// Мінімальна частка середнього питомого споживання теплової енергії 
			q_min = 0.5 * q_оп;
			Если (НоваяСтрока.ВРО / Строка.ЗначениеБазыСКоэффициентом) < q_min Тогда
			    НоваяСтрока.Qдон = (q_min - (НоваяСтрока.ВРО / Строка.ЗначениеБазыСКоэффициентом)) * Строка.ЗначениеБазыСКоэффициентом;
			КонецЕсли;
			Если Объект.ЗначениеОбщедомовое < 0 Тогда
				//РазницаНебаланс = Объект.ВсегоГКал - Объект.ЗначениеМЗК - Объект.Основная.Итог("ВРО") - Объект.Основная.Итог("Qдон") - Объект.Основная.Итог("ВКО");
				
				Небаланс = Объект.ЗначениеОбщедомовое / Sобщ_дом;
				НоваяСтрока.Небаланс = Небаланс * Строка.ЗначениеБазыСКоэффициентом;
			КонецЕсли;
			НоваяСтрока.Показание = НоваяСтрока.ЗБП + НоваяСтрока.Qдон + НоваяСтрока.ВРО + НоваяСтрока.Небаланс;
			НоваяСтрока.ОтапливаемаПлощадь = Строка.ЗначениеБазы;
		ИначеЕсли Строка.ЛицевойСчет.ВКО Тогда
			НоваяСтрока = Объект.Основная.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
			НоваяСтрока.ВидТарифа = Перечисления.ВидыТарифов.Общий;
			НоваяСтрока.ЗБП       = тзДанныхДляРаспределения[0].ТЕНаЗБПм2 * Строка.ЗначениеБазы;//(ЗначениеЗБП / Sобщ_дом) * Строка.ЗначениеБазы;
			// По лічильнику у квартирі вибираємо обов'язково з цієї функції (різниця у ОР)
			Показания  = РасчетУслугПоТЕиГВ.КоличествоПриборовВДоме(Перечисления.МетодыУстановкиПриборовУчета.ВКО, Строка.ЛицевойСчет, Объект.ПериодНачисления)[0].Значение;
			Коэфициент = РасчетУслугПоТЕиГВ.КоличествоПриборовВДоме(Перечисления.МетодыУстановкиПриборовУчета.ВКО, Строка.ЛицевойСчет, Объект.ПериодНачисления)[0].ПриборУчетаКоэффициент;
			Если ЗначениеЗаполнено(Показания) Тогда
			    НоваяСтрока.ВКО       = Показания * Коэфициент;
			Иначе
				НоваяСтрока.ВКО       = 0;
			КонецЕсли;
			// Середнє питоме споживання теплової енергії на опалення приміщень 
		    q_оп = (Объект.ВсегоГКал - Объект.ЗначениеМЗК) / (Sобщ_дом - Sобщ_инд_от);
			
			// Мінімальна частка середнього питомого споживання теплової енергії 
			q_min = 0.5 * q_оп;
			
			Если (НоваяСтрока.ВКО / Строка.ЗначениеБазыСКоэффициентом) < q_min Тогда
			    НоваяСтрока.Qдон = (q_min - (НоваяСтрока.ВКО / Строка.ЗначениеБазыСКоэффициентом)) * Строка.ЗначениеБазыСКоэффициентом;
			КонецЕсли;
			НоваяСтрока.Показание = НоваяСтрока.ЗБП + НоваяСтрока.Qдон + НоваяСтрока.ВКО;
			НоваяСтрока.ОтапливаемаПлощадь = Строка.ЗначениеБазы;
		Иначе
			НоваяСтрока = Объект.Основная.Добавить();
		    ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
			НоваяСтрока.ВидТарифа = Перечисления.ВидыТарифов.Общий;
			НоваяСтрока.ЗБП       = тзДанныхДляРаспределения[0].ТЕНаЗБПм2 * Строка.ЗначениеБазы;
			НоваяСтрока.ТЕ        = тзДанныхДляРаспределения[0].ТЕНаСпоживачаМ2 * Строка.ЗначениеБазы;
			НоваяСтрока.Показание = НоваяСтрока.ЗБП + НоваяСтрока.ТЕ;
			НоваяСтрока.ОтапливаемаПлощадь = Строка.ЗначениеБазы;
		КонецЕсли;	
	КонецЦикла;
	
	Если Объект.Основная.Итог("Показание") <> Объект.ВсегоГКал И Объект.Основная.Итог("ТЕ") = 0 Тогда
		Небаланс = (Объект.ВсегоГКал - Объект.Основная.Итог("Показание")) / Sобщ_дом;
		Для Каждого стр Из Объект.Основная Цикл
			стр.Показание = стр.Показание + (стр.ОтапливаемаПлощадь * Небаланс);			
		КонецЦикла;
	КонецЕсли;
	
	Если Объект.Основная.Итог("Показание") <> Объект.ВсегоГКал Тогда
		Небаланс = (Объект.ВсегоГКал - Объект.Основная.Итог("Показание")) / Sобщ_дом;
		Для Каждого стр Из Объект.Основная Цикл
			стр.Показание = стр.Показание + (стр.ОтапливаемаПлощадь * Небаланс);			
		КонецЦикла;
	КонецЕсли;
	
	//Если Объект.Основная.Количество()> 0 Тогда
	//    ГСЧ = Новый ГенераторСлучайныхЧисел();
	//	СЧ = ГСЧ.СлучайноеЧисло(0,  Объект.Основная.Количество() - 1);

