&НаСервере
Функция КоличествоПриборовВДоме(МетодУстановкиПрибора, Здание = "", Подъезд = "")
	Запрос = Новый Запрос;
	Условие = "";
	Если Здание <> "" Тогда
		Условие = " И ОбъектУстановки.Владелец = &Здание";
		Запрос.УстановитьПараметр("Здание", Здание);
	КонецЕсли;
	Если Подъезд <> "" Тогда
		Условие = Условие + " И ОбъектУстановки.ОбъектЛицевогоСчета.Подъезд = &Подъезд";
		Запрос.УстановитьПараметр("Подъезд", Подъезд);
	КонецЕсли;
	Если МетодУстановкиПрибора = Перечисления.МетодыУстановкиПриборовУчета.ВКО Тогда
		Условие = Условие + " И ПриборУчета.ВКО = ИСТИНА И ПриборУчета.ОбщедомовойСчетчик = ЛОЖЬ";
	Иначе
		Условие = Условие + " И ПриборУчета.ВРО = ИСТИНА";
	КонецЕсли;
	Запрос.Текст = 
	    "ВЫБРАТЬ
	    |	УстановленныеПриборыУчетаСрезПоследних.ПриборУчета,
	    |	УстановленныеПриборыУчетаСрезПоследних.ОбъектУстановки,
	    |	УстановленныеПриборыУчетаСрезПоследних.ПриборУчета.ВРО,
	    |	УстановленныеПриборыУчетаСрезПоследних.ПриборУчета.ВКО,
	    |	РасчетПоказанийПриборовОтопление.Значение
	    |ИЗ
	    |	РегистрСведений.УстановленныеПриборыУчета.СрезПоследних(
	    |			&НаДату,
	    |			ПриборУчета.Услуга.ВидУслуги = &ВидУслуги
	    |				И Действует = ИСТИНА
		|           " + Условие + ") КАК УстановленныеПриборыУчетаСрезПоследних
	    |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.РасчетПоказанийПриборовОтопление КАК РасчетПоказанийПриборовОтопление
	    |		ПО УстановленныеПриборыУчетаСрезПоследних.ПриборУчета = РасчетПоказанийПриборовОтопление.ПриборУчета
	    |ГДЕ
	    |	РасчетПоказанийПриборовОтопление.Период МЕЖДУ &НачПериода И &КонПериода
	    |
	    |УПОРЯДОЧИТЬ ПО
	    |	РасчетПоказанийПриборовОтопление.Период УБЫВ";
	Запрос.УстановитьПараметр("НаДату", НачалоМесяца(Объект.ПериодНачисления));
	Запрос.УстановитьПараметр("ВидУслуги", Справочники.ВидыУслуг.Отопление);
	Запрос.УстановитьПараметр("НачПериода", НачалоМесяца(Объект.ПериодНачисления));
	Запрос.УстановитьПараметр("КонПериода", КонецМесяца(Объект.ПериодНачисления));
	Результат = Запрос.Выполнить().Выгрузить();
	Возврат Результат;
КонецФункции

