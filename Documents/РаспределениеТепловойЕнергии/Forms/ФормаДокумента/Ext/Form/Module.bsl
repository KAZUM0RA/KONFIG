&НаСервере
Функция ПолучитьПоказания(ПриборУчета, ПериодНачисления)
	Запрос = Новый Запрос;
	Запрос.Текст =
	    "ВЫБРАТЬ
	    |	АктСнятияПоказанийТеплосчетчикаСрезПоследних.РазницаПоказания,
	    |	АктСнятияПоказанийТеплосчетчикаСрезПоследних.Период,
	    |	АктСнятияПоказанийТеплосчетчикаСрезПоследних.ЧасыПростояРазница,
	    |	АктСнятияПоказанийТеплосчетчикаСрезПоследних.РазницаЧасы КАК ЧасыРаботы
	    |ИЗ
	    |	РегистрСведений.АктСнятияПоказанийТеплосчетчика.СрезПоследних(
	    |			&ДатаСреза,
	    |			ПриборУчета = &ПриборУчета
	    |				И ПериодНачисления = &ПериодНачисления) КАК АктСнятияПоказанийТеплосчетчикаСрезПоследних";
	Запрос.УстановитьПараметр("ДатаСреза", Новый Граница(ТекущаяДата(), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("ПриборУчета", ПриборУчета);
	Запрос.УстановитьПараметр("ПериодНачисления", НачалоМесяца(ПериодНачисления));
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	ДанныеВыборки = Новый Структура;
	Пока Выборка.Следующий() Цикл
		ДанныеВыборки.Вставить("КвоТЕ",       Выборка.РазницаПоказания);
		ДанныеВыборки.Вставить("ДатаСнятия",  Выборка.Период);
		ДанныеВыборки.Вставить("ЧасыПростоя", Выборка.ЧасыПростояРазница);
		ДанныеВыборки.Вставить("ЧасыРаботы",  Выборка.ЧасыРаботы);
	КонецЦикла;
	Возврат ДанныеВыборки;
КонецФункции

&НаСервере
Функция ПолучитьКвоДнейПрошлогоМесяца(ПриборУчета)
	Запрос = Новый Запрос;
	Запрос.Текст =
	    "ВЫБРАТЬ
	    |	АктСнятияПоказанийОбщедомовыхСчетчиковСрезПоследних.Период
	    |ИЗ
	    |	РегистрСведений.АктСнятияПоказанийТеплосчетчика.СрезПоследних(, ПриборУчета = &ПриборУчета) КАК АктСнятияПоказанийОбщедомовыхСчетчиковСрезПоследних
	    |ГДЕ
	    |	АктСнятияПоказанийОбщедомовыхСчетчиковСрезПоследних.Период МЕЖДУ &НачПериода И &КонПериода";
	Запрос.УстановитьПараметр("НачПериода", ДобавитьМесяц(НачалоМесяца(Объект.Дата), -2));
	Запрос.УстановитьПараметр("КонПериода", ДобавитьМесяц(КонецМесяца(Объект.Дата), -2));
	Запрос.УстановитьПараметр("ПриборУчета", ПриборУчета);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		ДатаСнятия = Выборка.Период;
	КонецЦикла;
	КоличествоДнейВМес = Число(Сред(КонецМесяца(ДатаСнятия), 1, 2));
	КвоДнейОтопления = Число(Формат(((ДатаСнятия - НачалоМесяца(ДатаСнятия)) / 86400) + 1, "ЧЦ=2"));
	КвоДней = КоличествоДнейВМес - КвоДнейОтопления;
	Возврат КвоДней;
КонецФункции

