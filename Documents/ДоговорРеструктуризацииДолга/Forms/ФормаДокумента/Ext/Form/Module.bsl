&НаСервере
Процедура УстановитьВидимостьИДоступность()

	Если Объект.ВидОперации = Перечисления.ВидыОперацийДоговораРеструктуризацииДолга.РасторжениеДоговора Тогда
		Элементы.Группа3.Видимость = Ложь;
		Элементы.Группа5.Видимость = Ложь;
		Элементы.Комментарий.Видимость = Истина;
	Иначе
		Элементы.Группа3.Видимость = Истина;
		Элементы.Группа5.Видимость = Истина;
		Элементы.Комментарий.Видимость = Ложь;

	КонецЕсли;	

КонецПроцедуры // УстановитьВидимостьИДоступность()



&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Объект.ЛицевойСчет) Тогда
		Объект.СуммаДолга = ПолучитьСуммуРеструктуризации(Объект.Дата,Объект.ЛицевойСчет);
	КонецЕсли;	
	
КонецПроцедуры


&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	
	Если  НЕ ЗначениеЗаполнено(Объект.ВидОперации) Тогда
		Объект.ВидОперации = Перечисления.ВидыОперацийДоговораРеструктуризацииДолга.ЗаключениеДоговора;
	КонецЕсли;
	
	УстановитьВидимостьИДоступность();
КонецПроцедуры

