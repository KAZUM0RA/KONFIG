// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ
// Формирует таблицу значений, содержащую данные для проведения по регистру.
// Таблицы значений сохраняет в свойствах структуры "ДополнительныеСвойства".
//
// Формирует таблицу значений, содержащую данные для проведения по регистру.
// Таблицы значений сохраняет в свойствах структуры "ДополнительныеСвойства".
//
Процедура СформироватьТаблицуНачисленияПоРеструктуризацииДолга(ДокументСсылкаВводПоказанийПриборовУчета, СтруктураДополнительныеСвойства)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = СтруктураДополнительныеСвойства.ДляПроведения.СтруктураВременныеТаблицы.МенеджерВременныхТаблиц;
	
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ВременнаяТаблицаРеструктуризация.Период,
		|	ВременнаяТаблицаРеструктуризация.ЛицевойСчет,
		|	ВременнаяТаблицаРеструктуризация.СуммаПлатежа,
		|	ВременнаяТаблицаРеструктуризация.СуммаДолга КАК ОбщаяСумма
		|ИЗ
		|	ВременнаяТаблицаРеструктуризация КАК ВременнаяТаблицаРеструктуризация";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	СтруктураДополнительныеСвойства.ТаблицыДляДвижений.Вставить("ТаблицаРеструктуризацияДолга", РезультатЗапроса.Выгрузить());
	
КонецПроцедуры // СформироватьТаблицуРасчетПоказанийПриборовУчета()

// Формирует таблицу значений, содержащую данные для проведения по регистру.
// Таблицы значений сохраняет в свойствах структуры "ДополнительныеСвойства".
//
Процедура СформироватьТаблицуСписанияРеструктурированногоДолга(ДокументСсылкаВводПоказанийПриборовУчета, СтруктураДополнительныеСвойства)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = СтруктураДополнительныеСвойства.ДляПроведения.СтруктураВременныеТаблицы.МенеджерВременныхТаблиц;
	
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
		|	НАЧАЛОПЕРИОДА(ВременнаяТаблицаРеструктуризация.ДатаСписания, ДЕНЬ) КАК Период,
		|	ВременнаяТаблицаРеструктуризация.Организация,
		|	ВременнаяТаблицаРеструктуризация.ЛицевойСчет,
		|	МАКСИМУМ(ВременнаяТаблицаРеструктуризация.СуммаДолга) КАК Сумма,
		|	ВЫБОР
		|		КОГДА ВременнаяТаблицаРеструктуризация.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийДоговораРеструктуризацииДолга.ЗаключениеДоговора)
		|			ТОГДА &Услуга
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Услуги.ДолгиПрошлыхПериодов)
		|	КОНЕЦ КАК Услуга
		|ИЗ
		|	ВременнаяТаблицаРеструктуризация КАК ВременнаяТаблицаРеструктуризация
		|
		|СГРУППИРОВАТЬ ПО
		|	ВременнаяТаблицаРеструктуризация.ДатаСписания,
		|	ВременнаяТаблицаРеструктуризация.Организация,
		|	ВременнаяТаблицаРеструктуризация.ЛицевойСчет,
		|	ВЫБОР
		|		КОГДА ВременнаяТаблицаРеструктуризация.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийДоговораРеструктуризацииДолга.ЗаключениеДоговора)
		|			ТОГДА &Услуга
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Услуги.ДолгиПрошлыхПериодов)
		|	КОНЕЦ
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход),
		|	ВременнаяТаблицаРеструктуризация.ДатаСписания,
		|	ВременнаяТаблицаРеструктуризация.Организация,
		|	ВременнаяТаблицаРеструктуризация.ЛицевойСчет,
		|	МАКСИМУМ(ВременнаяТаблицаРеструктуризация.СуммаДолга),
		|	ВЫБОР
		|		КОГДА ВременнаяТаблицаРеструктуризация.ВидОперации <> ЗНАЧЕНИЕ(Перечисление.ВидыОперацийДоговораРеструктуризацииДолга.ЗаключениеДоговора)
		|			ТОГДА &Услуга
		|	КОНЕЦ
		|ИЗ
		|	ВременнаяТаблицаРеструктуризация КАК ВременнаяТаблицаРеструктуризация
		|
		|СГРУППИРОВАТЬ ПО
		|	ВременнаяТаблицаРеструктуризация.ДатаСписания,
		|	ВременнаяТаблицаРеструктуризация.Организация,
		|	ВременнаяТаблицаРеструктуризация.ЛицевойСчет,
		|	ВЫБОР
		|		КОГДА ВременнаяТаблицаРеструктуризация.ВидОперации <> ЗНАЧЕНИЕ(Перечисление.ВидыОперацийДоговораРеструктуризацииДолга.ЗаключениеДоговора)
		|			ТОГДА &Услуга
		|	КОНЕЦ";
		
	Запрос.УстановитьПараметр("Услуга",Справочники.Услуги.РеструктуризацияДолга);
	РезультатЗапроса = Запрос.Выполнить();
	
	СтруктураДополнительныеСвойства.ТаблицыДляДвижений.Вставить("ТаблицаРасчетыПоЛицевымСчетам", РезультатЗапроса.Выгрузить());
	
КонецПроцедуры // СформироватьТаблицуРасчетПоказанийПриборовУчета()

// Формирует таблицу значений, содержащую данные для проведения по регистру.
// Таблицы значений сохраняет в свойствах структуры "ДополнительныеСвойства".
//
Процедура СформироватьТаблицуУстановкиУслугиНаЛицевойСчет(ДокументСсылкаВводПоказанийПриборовУчета, СтруктураДополнительныеСвойства)

	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = СтруктураДополнительныеСвойства.ДляПроведения.СтруктураВременныеТаблицы.МенеджерВременныхТаблиц;
	
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ВременнаяТаблицаРеструктуризация.Организация,
		|	ВременнаяТаблицаРеструктуризация.ЛицевойСчет,
		|	ВременнаяТаблицаРеструктуризация.Услуга,
		|	НАЧАЛОПЕРИОДА(ВременнаяТаблицаРеструктуризация.ДатаНачала, ДЕНЬ) КАК Период,
		|	МАКСИМУМ(ИСТИНА) КАК Действует
		|ИЗ
		|	ВременнаяТаблицаРеструктуризация КАК ВременнаяТаблицаРеструктуризация
		|
		|СГРУППИРОВАТЬ ПО
		|	НАЧАЛОПЕРИОДА(ВременнаяТаблицаРеструктуризация.ДатаНачала, ДЕНЬ),
		|	ВременнаяТаблицаРеструктуризация.Организация,
		|	ВременнаяТаблицаРеструктуризация.ЛицевойСчет,
		|	ВременнаяТаблицаРеструктуризация.Услуга
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВременнаяТаблицаРеструктуризация.Организация,
		|	ВременнаяТаблицаРеструктуризация.ЛицевойСчет,
		|	ВременнаяТаблицаРеструктуризация.Услуга,
		|	НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(КОНЕЦПЕРИОДА(ВременнаяТаблицаРеструктуризация.ДатаОкончания, МЕСЯЦ), ДЕНЬ, 1), ДЕНЬ),
		|	МАКСИМУМ(ЛОЖЬ)
		|ИЗ
		|	ВременнаяТаблицаРеструктуризация КАК ВременнаяТаблицаРеструктуризация
		|
		|СГРУППИРОВАТЬ ПО
		|	ВременнаяТаблицаРеструктуризация.Организация,
		|	ВременнаяТаблицаРеструктуризация.ЛицевойСчет,
		|	ВременнаяТаблицаРеструктуризация.Услуга,
		|	НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(КОНЕЦПЕРИОДА(ВременнаяТаблицаРеструктуризация.ДатаОкончания, МЕСЯЦ), ДЕНЬ, 1), ДЕНЬ)";
	
		
		РезультатЗапроса = Запрос.Выполнить();
	
	СтруктураДополнительныеСвойства.ТаблицыДляДвижений.Вставить("ТаблицаНазначенныеУслуги", РезультатЗапроса.Выгрузить());

КонецПроцедуры


Процедура ИнициализироватьДанныеДокумента(ДокументСсылкаРеструктуризацияДолга, СтруктураДополнительныеСвойства) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = СтруктураДополнительныеСвойства.ДляПроведения.СтруктураВременныеТаблицы.МенеджерВременныхТаблиц;
	Запрос.Текст = 
		 "ВЫБРАТЬ
		 |	КОНЕЦПЕРИОДА(ДоговорРеструктуризацииДолгаСтруктураДолга.МесяцНачисления, МЕСЯЦ) КАК Период,
		 |	ДоговорРеструктуризацииДолгаСтруктураДолга.СуммаПлатежа,
		 |	ЗНАЧЕНИЕ(Справочник.Услуги.РеструктуризацияДолга) КАК Услуга,
		 |	ДоговорРеструктуризацииДолга.ЛицевойСчет КАК ЛицевойСчет,
		 |	ДоговорРеструктуризацииДолга.Дата КАК ДатаСписания,
		 |	ДоговорРеструктуризацииДолга.СуммаДолга КАК СуммаДолга,
		 |	ДоговорРеструктуризацииДолга.Организация КАК Организация,
		 |	ДоговорРеструктуризацииДолга.ДатаНачалаРассрочки КАК ДатаНачала,
		 |	ДоговорРеструктуризацииДолга.ДатаЗавершенияРассрочки КАК ДатаОкончания,
		 |	ДоговорРеструктуризацииДолга.ВидОперации КАК ВидОперации
		 |ПОМЕСТИТЬ ВременнаяТаблицаРеструктуризация
		 |ИЗ
		 |	Документ.ДоговорРеструктуризацииДолга КАК ДоговорРеструктуризацииДолга
		 |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ДоговорРеструктуризацииДолга.СтруктураДолга КАК ДоговорРеструктуризацииДолгаСтруктураДолга
		 |		ПО ДоговорРеструктуризацииДолга.Ссылка = ДоговорРеструктуризацииДолгаСтруктураДолга.Ссылка
		 |ГДЕ
		 |	ДоговорРеструктуризацииДолга.Ссылка = &Ссылка";
	 
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылкаРеструктуризацияДолга);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если ДокументСсылкаРеструктуризацияДолга.ВидОперации = Перечисления.ВидыОперацийДоговораРеструктуризацииДолга.ЗаключениеДоговора Тогда
	СформироватьТаблицуУстановкиУслугиНаЛицевойСчет(ДокументСсылкаРеструктуризацияДолга, СтруктураДополнительныеСвойства);
	СформироватьТаблицуНачисленияПоРеструктуризацииДолга(ДокументСсылкаРеструктуризацияДолга, СтруктураДополнительныеСвойства);
	КонецЕсли; 
	СформироватьТаблицуСписанияРеструктурированногоДолга(ДокументСсылкаРеструктуризацияДолга, СтруктураДополнительныеСвойства);
	СформироватьТаблицуСостоянияРеструктуризации(ДокументСсылкаРеструктуризацияДолга, СтруктураДополнительныеСвойства);

КонецПроцедуры

// Формує таблицю стану реструктуризації для регістру СостояниеРеструктуризацииДолга
Процедура СформироватьТаблицуСостоянияРеструктуризации(ДокументСсылка, СтруктураДополнительныеСвойства)

	Статус = ?(ДокументСсылка.ВидОперации = Перечисления.ВидыОперацийДоговораРеструктуризацииДолга.ЗаключениеДоговора,
		Перечисления.СтатусыРеструктуризации.Действует,
		Перечисления.СтатусыРеструктуризации.Расторгнут);

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Период");
	Таблица.Колонки.Добавить("ЛицевойСчет");
	Таблица.Колонки.Добавить("Статус");
	Таблица.Колонки.Добавить("Договор");
	Таблица.Колонки.Добавить("ДатаНачала");
	Таблица.Колонки.Добавить("ДатаОкончания");

	Стр = Таблица.Добавить();
	Стр.Период        = ДокументСсылка.Дата;
	Стр.ЛицевойСчет   = ДокументСсылка.ЛицевойСчет;
	Стр.Статус        = Статус;
	Стр.Договор       = ДокументСсылка;
	Стр.ДатаНачала    = ДокументСсылка.ДатаНачалаРассрочки;
	Стр.ДатаОкончания = ДокументСсылка.ДатаЗавершенияРассрочки;

	СтруктураДополнительныеСвойства.ТаблицыДляДвижений.Вставить("ТаблицаСостояниеРеструктуризации", Таблица);

КонецПроцедуры


Процедура Печать(МассивОбъектов,
	ПараметрыПечати,
	КоллекцияПечатныхФорм,
	ОбъектыПечати,
	ПараметрыВывода) Экспорт
	
	ПараметрыВывода.ДоступнаПечатьПоКомплектно = Истина;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ДоговорРеструктуризацииДолга") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ДоговорРеструктуризацииДолга", "Договор реструктуризации долга", ПечатьДокумента(МассивОбъектов, ОбъектыПечати, "ДоговорРеструктуризацииДолга"));
	КонецЕсли;	
	
КонецПроцедуры


Функция ПечатьДокумента(ТекущийДокумент, ОбъектыПечати, ИмяМакета)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.КлючПараметровПечати = "ПараметрыПечати_ДоговорРеструктуризацииДолга";
	
	ПервыйДокумент = Истина;
	
	
	Если НЕ ПервыйДокумент Тогда
		ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	КонецЕсли;
	ПервыйДокумент = Ложь;
	
	НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("Ссылка", ТекущийДокумент);
	Запрос.УстановитьПараметр("Период", КонецДня(ТекущийДокумент.Дата));
	Запрос.УстановитьПараметр("ВидОрганизация", Справочники.ВидыКонтактнойИнформации.ПочтовыйАдресОрганизации);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ДоговорРеструктуризацииДолга.Номер КАК НомерДокумента,
	               |	ДоговорРеструктуризацииДолга.Дата КАК ДатаЗадолженности,
	               |	ДоговорРеструктуризацииДолга.Организация,
	               |	ДоговорРеструктуризацииДолга.Здание,
	               |	ДоговорРеструктуризацииДолга.СуммаДолга КАК СуммаДолга,
	               |	ДоговорРеструктуризацииДолга.ДатаНачалаРассрочки,
	               |	ДоговорРеструктуризацииДолга.ДатаЗавершенияРассрочки,
	               |	ДоговорРеструктуризацииДолга.Организация.ТекущийРуководитель,
	               |	ДоговорРеструктуризацииДолга.Организация.НаименованиеПолное,
	               |	ДоговорРеструктуризацииДолга.Организация.КодПоЕДРПОУ КАК ЕДРПОУ,
	               |	ДоговорРеструктуризацииДолга.ЛицевойСчет.Владелец.Код КАК НомерДома,
	               |	ДоговорРеструктуризацииДолга.Организация.БанковскийСчетПоУмолчанию.Банк КАК Банк,
	               |	ДоговорРеструктуризацииДолга.Организация.БанковскийСчетПоУмолчанию.Банк.Код КАК МФО,
	               |	ДоговорРеструктуризацииДолга.Организация.БанковскийСчетПоУмолчанию.НомерСчета КАК НомерСчета,
	               |	ВЫБОР
	               |		КОГДА ОрганизацииКонтактнаяИнформация.Вид = &ВидОрганизация
	               |			ТОГДА ОрганизацииКонтактнаяИнформация.ЗначенияПолей
	               |	КОНЕЦ КАК ЗначенияПолейОрганизация,
	               |	ЗданияИСооруженияКонтактнаяИнформация.ЗначенияПолей КАК ЗначенияПолейЗдание,
	               |	ВложенныйЗапрос.ЗначенияПолей КАК ЗначенияПолейПотребитель,
	               |	ВложенныйЗапрос.ОтветственныйВладелец,
	               |	ДоговорРеструктуризацииДолга.ЛицевойСчет.ОбъектЛицевогоСчета.Код КАК НомерКвартиры,
	               |	ВложенныйЗапрос.ИНН
	               |ИЗ
	               |	Документ.ДоговорРеструктуризацииДолга КАК ДоговорРеструктуризацииДолга
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации.КонтактнаяИнформация КАК ОрганизацииКонтактнаяИнформация
	               |		ПО ДоговорРеструктуризацииДолга.Организация = ОрганизацииКонтактнаяИнформация.Ссылка
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЗданияИСооружения.КонтактнаяИнформация КАК ЗданияИСооруженияКонтактнаяИнформация
	               |		ПО ДоговорРеструктуризацииДолга.Здание = ЗданияИСооруженияКонтактнаяИнформация.Ссылка
	               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			ВложенныйЗапрос.ЛицевойСчет КАК ЛицевойСчет,
	               |			ВложенныйЗапрос.ОтветственныйВладелец КАК ОтветственныйВладелец,
	               |			ВложенныйЗапрос.ЗначенияПолей КАК ЗначенияПолей,
	               |			ВложенныйЗапрос.ИНН КАК ИНН
	               |		ИЗ
	               |			(ВЫБРАТЬ
	               |				ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ЛицевойСчет КАК ЛицевойСчет,
	               |				ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ОтветственныйВладелец КАК ОтветственныйВладелец,
	               |				ВЫБОР
	               |					КОГДА ФизическиеЛицаКонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.АдресДляИнформированияФизЛица)
	               |						ТОГДА ФизическиеЛицаКонтактнаяИнформация.ЗначенияПолей
	               |				КОНЕЦ КАК ЗначенияПолей,
	               |				ФизическиеЛицаКонтактнаяИнформация.Ссылка.ИНН КАК ИНН
	               |			ИЗ
	               |				РегистрСведений.ОтветственныйВладелецЛицевогоСчета.СрезПоследних(&Период, ) КАК ОтветственныйВладелецЛицевогоСчетаСрезПоследних
	               |					ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ФизическиеЛица.КонтактнаяИнформация КАК ФизическиеЛицаКонтактнаяИнформация
	               |					ПО ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ОтветственныйВладелец.ФизЛицо = ФизическиеЛицаКонтактнаяИнформация.Ссылка
	               |			
	               |			ОБЪЕДИНИТЬ ВСЕ
	               |			
	               |			ВЫБРАТЬ
	               |				ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ЛицевойСчет,
	               |				ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ОтветственныйВладелец,
	               |				ВЫБОР
	               |					КОГДА КонтрагентыКонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ПочтовыйАдресКонтрагента)
	               |						ТОГДА КонтрагентыКонтактнаяИнформация.ЗначенияПолей
	               |				КОНЕЦ,
	               |				КонтрагентыКонтактнаяИнформация.Ссылка.ИНН
	               |			ИЗ
	               |				РегистрСведений.ОтветственныйВладелецЛицевогоСчета.СрезПоследних(&Период, ) КАК ОтветственныйВладелецЛицевогоСчетаСрезПоследних
	               |					ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты.КонтактнаяИнформация КАК КонтрагентыКонтактнаяИнформация
	               |					ПО ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ОтветственныйВладелец.ЮрЛицо = КонтрагентыКонтактнаяИнформация.Ссылка) КАК ВложенныйЗапрос) КАК ВложенныйЗапрос
	               |		ПО ДоговорРеструктуризацииДолга.ЛицевойСчет = ВложенныйЗапрос.ЛицевойСчет
	               |ГДЕ
	               |	ДоговорРеструктуризацииДолга.Ссылка = &Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ДоговорРеструктуризацииДолгаСтруктураДолга.МесяцНачисления,
	               |	ДоговорРеструктуризацииДолгаСтруктураДолга.СуммаПлатежа,
	               |	ДоговорРеструктуризацииДолгаСтруктураДолга.НомерСтроки
	               |ИЗ
	               |	Документ.ДоговорРеструктуризацииДолга.СтруктураДолга КАК ДоговорРеструктуризацииДолгаСтруктураДолга
	               |ГДЕ
	               |	ДоговорРеструктуризацииДолгаСтруктураДолга.Ссылка = &Ссылка";
	
	Если ИмяМакета = "ДоговорРеструктуризацииДолга" Тогда
		
		Макет = ПолучитьМакет("ДоговорРеструктуризацииДолга");
		
		Результат = Запрос.ВыполнитьПакет();
		ВыборкаОсновная = Результат[0].Выбрать();
		ВыборкаПоТаблице = Результат[1].Выбрать();
		
		КоличествоСтрокРеструктуризации = ВыборкаПоТаблице.Количество();
		
		ВыборкаОсновная.Следующий();
		
		КИЗдания = ВыборкаОсновная.ЗначенияПолейЗдание;
		КИОрганизации = ВыборкаОсновная.ЗначенияПолейОрганизация;
		КИПотребителя = ВыборкаОсновная.ЗначенияПолейПотребитель;
		
		СписокПолейЗдание = УправлениеКонтактнойИнформацией.ПреобразоватьСтрокуВСписокПолей(КИЗдания);
		СписокПолейОрганизация = УправлениеКонтактнойИнформацией.ПреобразоватьСтрокуВСписокПолей(КИОрганизации);
		СписокПолейПотребитель = УправлениеКонтактнойИнформацией.ПреобразоватьСтрокуВСписокПолей(КИПотребителя);
		
		СтруктураАдресаЗдания = ПолучитьСтруктуруАдреса(СписокПолейЗдание);
		СтруктураАдресаОрганизации = ПолучитьСтруктуруАдреса(СписокПолейОрганизация);
		СтруктураАдресаПотребителя = ПолучитьСтруктуруАдреса(СписокПолейПотребитель);
		
		ОбластьШапкаДокумента = Макет.ПолучитьОбласть("ШапкаДокумента");
		ОбластьШапкаДокумента.Параметры.НомерДоговора = Нстр("ru = 'Договор № '; uk = 'Договір № '") + ВыборкаОсновная.НомерДокумента;
		
		Попытка
			ОбластьШапкаДокумента.Параметры.НасПункт = СтруктураАдресаЗдания.Город;
		Исключение 
			ОбластьШапкаДокумента.Параметры.НасПункт = "";
		КонецПопытки;
		
		ТабличныйДокумент.Вывести(ОбластьШапкаДокумента);
		
		ОбластьОсновныеПоложения = макет.ПолучитьОбласть("ОсновныеПоложения");
		
		ОбластьОсновныеПоложения.Параметры.ПолноеНаименованииеОрганизации = ВыборкаОсновная.ОрганизацияНаименованиеПолное;
		ОбластьОсновныеПоложения.Параметры.Директор = ВыборкаОсновная.ОрганизацияТекущийРуководитель;
		ОбластьОсновныеПоложения.Параметры.потребительУслуг = ВыборкаОсновная.ОтветственныйВладелец;
		Попытка
			ОбластьОсновныеПоложения.Параметры.НомерДома = СтруктураАдресаЗдания.Дом;
		Исключение
		КонецПопытки;
		
		ОбластьОсновныеПоложения.Параметры.НомерКвартиры = ВыборкаОсновная.НомерКвартиры;
		ОбластьОсновныеПоложения.Параметры.Адрес = ВыборкаОсновная.Здание;
		
		ТабличныйДокумент.Вывести(ОбластьОсновныеПоложения);
		
		ОбластьПредТабличнаяНадпись = Макет.ПолучитьОбласть("ПредТабличнаяНадпись");
		ОбластьПредТабличнаяНадпись.Параметры.ДатаЗадолженности = Формат(ТекущийДокумент.Дата,"ДФ=dd.MM.yyyy");;
		ОбластьПредТабличнаяНадпись.Параметры.СуммаЗадолженности = ВыборкаОсновная.СуммаДолга;
		ОбластьПредТабличнаяНадпись.Параметры.КолВоМесяцев = КоличествоСтрокРеструктуризации;
		ОбластьПредТабличнаяНадпись.Параметры.ДатаНачала =   Формат(ВыборкаОсновная.ДатаНачалаРассрочки,"ДФ=dd.MM.yyyy");
		ОбластьПредТабличнаяНадпись.Параметры.ДатаОкончания = Формат(ВыборкаОсновная.ДатаЗавершенияРассрочки,"ДФ=dd.MM.yyyy");
		
		ТабличныйДокумент.Вывести(ОбластьПредТабличнаяНадпись);
		
		ПоловинаОтДеления  =	КоличествоСтрокРеструктуризации/2; 
		ОстатокОтДеления = ПоловинаОтДеления - Цел(ПоловинаОтДеления);
		
		Если ОстатокОтДеления <> 0 тогда
			КоличествоСтрок = ЦЕЛ(ПоловинаОтДеления)+1;
		Иначе
			КоличествоСтрок = ПоловинаОтДеления;
		КонецЕсли;
		
		ТаблицаПлатежей =  Результат[1].Выгрузить();
		
		СчКолонкиДва = КоличествоСтрок+1;
		Сч = 1;
		Пока Сч <= КоличествоСтрок Цикл
			СтрокаДляКолонки1 = ТаблицаПлатежей.найти(Сч,"НомерСтроки");
			СтрокаДляКолонки2 = ТаблицаПлатежей.найти(СчКолонкиДва,"НомерСтроки");
			
			Если СтрокаДляКолонки1 <> Неопределено Тогда
				
				ОбластьСтроки = Макет.ПолучитьОбласть("СтрокаТаблицыМесяцев");
				
				ОбластьСтроки.Параметры.Месяц1 =  Формат(СтрокаДляКолонки1.МесяцНачисления,НСТР("ru = 'Л=ru_RU; ДФ=''MMMM yyyy'''; uk = 'Л=uk_UA; ДФ=''MMMM yyyy'''"));
				ОбластьСтроки.Параметры.Сумма1 = СтрокаДляКолонки1.СуммаПлатежа;
				
				Если СтрокаДляКолонки2 <> Неопределено Тогда
					ОбластьСтроки.Параметры.Месяц2 = Формат(СтрокаДляКолонки2.МесяцНачисления,НСТР("ru = 'Л=ru_RU; ДФ=''MMMM yyyy'''; uk = 'Л=uk_UA; ДФ=''MMMM yyyy'''"));
					ОбластьСтроки.Параметры.Сумма2 = СтрокаДляКолонки2.СуммаПлатежа;
				КонецЕсли;
				
				ТабличныйДокумент.Вывести(ОбластьСтроки);                                      
				СчКолонкиДва = СчКолонкиДва+1;
				Сч = Сч+1;
			КонецЕсли;
		КонецЦикла;

		// Підсумковий рядок графіка («Разом до сплати»).
		СуммаИтогГрафика = ТаблицаПлатежей.Итог("СуммаПлатежа");
		НомерСтрокиИтог = ТабличныйДокумент.ВысотаТаблицы + 1;
		ОбластьИтог = ТабличныйДокумент.Область(НомерСтрокиИтог, 1, НомерСтрокиИтог, 4);
		ОбластьИтог.Объединить();
		ОбластьИтог.Текст = НСтр("uk = 'Разом до сплати: '; ru = 'Итого к оплате: '")
			+ Формат(СуммаИтогГрафика, "ЧДЦ=2") + " " + НСтр("uk = 'грн'; ru = 'грн'");
		ОбластьИтог.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Право;
		ОбластьИтог.Шрифт = Новый Шрифт(, , , Истина);

		ОбластьОснованаяЧасть = Макет.ПолучитьОбласть("ОснованаяЧасть1");
		ТабличныйДокумент.Вывести(ОбластьОснованаяЧасть);
		
		ОбластьОснованаяЧасть = Макет.ПолучитьОбласть("ОснованаяЧасть2");
		ТабличныйДокумент.Вывести(ОбластьОснованаяЧасть);
		
		
		ОбластьОснованаяЧасть = Макет.ПолучитьОбласть("ОснованаяЧасть3");
		ОбластьОснованаяЧасть.Параметры.ДатаОкончания = Формат(ВыборкаОсновная.ДатаЗавершенияРассрочки,
		НСТР("ru = 'Л=ru_RU; ДФ=''MMMM yyyy'''; uk = 'Л=uk_UA; ДФ=''MMMM yyyy'''"));
		ТабличныйДокумент.Вывести(ОбластьОснованаяЧасть);
		
		ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
		Если ВыборкаОсновная.ОтветственныйВладелец.ФизЛицо <> Справочники.ФизическиеЛица.ПустаяСсылка() Тогда
			ФизическоеЛицо = ВыборкаОсновная.ОтветственныйВладелец.ФизЛицо;
			ОбластьПодвал.Параметры.ИНН = ФизическоеЛицо.ИНН;
			ПаспортныеДанные = ПолучитьПаспортныеДанныеФизЛица(ФизическоеЛицо);
			
			//Заполняются паспортные данные физ.лица
			Если ПаспортныеДанные <> Неопределено Тогда
				ОбластьПодвал.Параметры.Серия = ПаспортныеДанные.Серия;
				ОбластьПодвал.Параметры.НомерПаспорта = ПаспортныеДанные.Номер;
				ОбластьПодвал.Параметры.ДатаВыдачиПаспорта = ПаспортныеДанные.ДатаВыдачи;
				МассивПаспортныхДанных = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ПаспортныеДанные.КемВыдано," ");
				Если МассивПаспортныхДанных.Количество() <> 0 Тогда
					Если МассивПаспортныхДанных.Количество() > 3 Тогда
						ОбластьПодвал.Параметры.КемЧасть1 = МассивПаспортныхДанных[0] +" "+ МассивПаспортныхДанных[1] +" "+ МассивПаспортныхДанных[2]+" ";
						СтрокаКемЧасть2 = "";
						Для Индекс = 3 по МассивПаспортныхДанных.ВГраница() Цикл
							
							СтрокаКемЧасть2 = СтрокаКемЧасть2+?(СтрокаКемЧасть2= "",""," ")+ МассивПаспортныхДанных[Индекс];
						КонецЦикла;
						ОбластьПодвал.Параметры.КемЧасть2 = СтрокаКемЧасть2;
					ИначеЕсли МассивПаспортныхДанных.Количество() <= 3 Тогда
						СтрокаКемЧасть1 = "";
						Для Индекс = 0 по МассивПаспортныхДанных.ВГраница() Цикл
							
							СтрокаКемЧасть1 = СтрокаКемЧасть1+ ?(СтрокаКемЧасть1= "",""," ")+МассивПаспортныхДанных[Индекс];
						КонецЦикла;
						ОбластьПодвал.Параметры.КемЧасть1 = СтрокаКемЧасть1;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		Иначе
			ЮридическоеЛицо =  ВыборкаОсновная.ОтветственныйВладелец.ЮрЛицо;
			ОбластьПодвал.Параметры.ИНН = ЮридическоеЛицо.ИНН;
		КонецЕсли;
		ОбластьПодвал.Параметры.Организация = ВыборкаОсновная.организация;
		
		Попытка
			ОбластьПодвал.Параметры.ИндексОРГ 	= СтруктураАдресаОрганизации.Индекс+ ",";
		Исключение
		КонецПопытки;
		Попытка
			ОбластьПодвал.Параметры.СтранаОРГ 	= СтруктураАдресаОрганизации.Страна+ ",";
		Исключение
		КонецПопытки;
		Попытка
			ОбластьПодвал.Параметры.ОбластьОРГ 	= СтруктураАдресаОрганизации.Регион+ ",";
		Исключение
		КонецПопытки;
		Попытка
			ОбластьПодвал.Параметры.РайонОРГ 	= СтруктураАдресаОрганизации.Район+ ",";
		Исключение
		КонецПопытки;
		Попытка
			ОбластьПодвал.Параметры.ГородОРГ 	= СтруктураАдресаОрганизации.Город+ ",";
		Исключение
		КонецПопытки;
		Попытка
			ОбластьПодвал.Параметры.Индекс  	= СтруктураАдресаЗдания.Индекс+ ",";
		Исключение
		КонецПопытки;
		Попытка
			ОбластьПодвал.Параметры.Страна		= СтруктураАдресаЗдания.Страна+ ",";
		Исключение
		КонецПопытки;
		Попытка
			ОбластьПодвал.Параметры.Область		= СтруктураАдресаЗдания.Регион+ ",";
		Исключение
		КонецПопытки;
		Попытка
			ОбластьПодвал.Параметры.Район		= СтруктураАдресаЗдания.Район+ ",";
		Исключение
		КонецПопытки;
		Попытка
			ОбластьПодвал.Параметры.Город       = СтруктураАдресаЗдания.Город+ ",";		
		Исключение
		КонецПопытки;
		
		Попытка
			ОбластьПодвал.Параметры.УлицаОрг = СтруктураАдресаОрганизации.Улица;
		Исключение
		КонецПопытки;
		Попытка
			ОбластьПодвал.Параметры.Улица =  СтруктураАдресаЗдания.Улица;
		Исключение
		КонецПопытки;
		
		Попытка
			ОбластьПодвал.Параметры.НомерДома = СтруктураАдресаЗдания.Дом;
		Исключение;	
		КонецПопытки;
		
		ОбластьПодвал.Параметры.НомерКвартиры = ВыборкаОсновная.НомерКвартиры;
		ОбластьПодвал.Параметры.НомерСчета = ВыборкаОсновная.НомерСчета;
		ОбластьПодвал.Параметры.МФО = ВыборкаОсновная.МФО;
		ОбластьПодвал.Параметры.Банк = ВыборкаОсновная.БАнк;
		
		СтруктураФИОПотребитель = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(Строка(ВыборкаОсновная.ОтветственныйВладелец)," ");
		СтруктураФИОДиректор = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(Строка(ВыборкаОсновная.ОрганизацияТекущийРуководитель)," ");
		
		ИмяОтчество = "";
		Если СтруктураФИОПотребитель.Количество() > 0 Тогда
			Сч = 0;
			ОбластьПодвал.Параметры.Фамилия = СтруктураФИОПотребитель[Сч];
			
			Попытка
				
				ИмяОтчество = ИмяОтчество + СтруктураФИОПотребитель[1]+" ";
				ИмяОтчество = ИмяОтчество + " " + СтруктураФИОПотребитель[2];
				
			Исключение
				
			КонецПопытки;
			
		КонецЕсли;
		
		ОбластьПодвал.Параметры.ИмяОтчество = ИмяОтчество;
		
		Если СтруктураФИОДиректор.Количество() > 0 Тогда
			
			ДиректорПодпись = "";
			
			ДиректорПодпись = ДиректорПодпись+ СтруктураФИОДиректор[0];
			Попытка
				
				ДиректорПодпись = ДиректорПодпись+" "+Лев(СтруктураФИОДиректор[1],1)+".";
				ДиректорПодпись = ДиректорПодпись+" "+Лев(СтруктураФИОДиректор[2],1)+".";
			Исключение
				
			КонецПопытки;
			
		КонецЕсли;
		
		Если СтруктураФИОПотребитель.Количество() > 0 Тогда
			
			ПотребительПодпись = "";
			
			ПотребительПодпись = ПотребительПодпись+ СтруктураФИОПотребитель[0];
			Попытка
				
				ПотребительПодпись = ПотребительПодпись+" " +Лев(СтруктураФИОПотребитель[1],1)+".";
				ПотребительПодпись = ПотребительПодпись+" " +Лев(СтруктураФИОПотребитель[2],1)+".";
			Исключение
				
			КонецПопытки;
			
		КонецЕсли;
		ОбластьПодвал.Параметры.КодЕДРПОУ = ВыборкаОсновная.ЕДРПОУ;
		ОбластьПодвал.Параметры.ИНН = ВыборкаОсновная.ИНН;
		
		ОбластьПодвал.Параметры.ДиректорИО =  ДиректорПодпись;
		ОбластьПодвал.Параметры.ПотребительИО =  ПотребительПодпись;
		ТабличныйДокумент.Вывести(ОбластьПодвал);	
		
		//Обработчик
		
	КонецЕсли;	
	
	ТабличныйДокумент.АвтоМасштаб = Истина;
	
	Возврат ТабличныйДокумент;

КонецФункции

