// Процедура - обработчик события ОбработкаПроведения объекта.
//
Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	// Контроль відповідності графіка сумі боргу (для укладення).
	Если ВидОперации = Перечисления.ВидыОперацийДоговораРеструктуризацииДолга.ЗаключениеДоговора Тогда
		Если СтруктураДолга.Количество() = 0 Тогда
			Сообщить("Не заповнено графік розстрочки (СтруктураДолга).");
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		Если Окр(СтруктураДолга.Итог("СуммаПлатежа") - СуммаДолга, 2) <> 0 Тогда
			Сообщить("Сума графіка не дорівнює сумі боргу. Скористайтеся командою «Распределить».");
			Отказ = Истина;
			Возврат;
		КонецЕсли;
	КонецЕсли;

	// Инициализация дополнительных свойств для проведения документа.
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства);
	
	// Инициализация данных документа.
	Документы.ДоговорРеструктуризацииДолга.ИнициализироватьДанныеДокумента(Ссылка, ДополнительныеСвойства);
	
	// Подготовка наборов записей.
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	// Отражение в разделах учета.
	//ПроведениеСервер.ОтразитьНазначенныеУслуги(ДополнительныеСвойства, Движения, Отказ);
	Если ВидОперации = Перечисления.ВидыОперацийДоговораРеструктуризацииДолга.ЗаключениеДоговора Тогда
		ПроведениеСервер.ОтразитьНачисленияПоРеструктуризацииДолга(ДополнительныеСвойства, Движения, Отказ);
	КонецЕсли;
	ПроведениеСервер.ОтразитьРасчетыПоЛицевымСчетам(ДополнительныеСвойства, Движения, Отказ);
	ПроведениеСервер.ОтразитьСостояниеРеструктуризации(ДополнительныеСвойства, Движения, Отказ);


	// Запись наборов записей.
	ПроведениеСервер.ЗаписатьНаборыЗаписей(ЭтотОбъект);
	
	// Контроль
	
	
	ДополнительныеСвойства.ДляПроведения.СтруктураВременныеТаблицы.МенеджерВременныхТаблиц.Закрыть();
	
КонецПроцедуры

// Процедура - обработчик события ОбработкаУдаленияПроведения объекта.
//
Процедура ОбработкаУдаленияПроведения(Отказ)
	
	// Инициализация дополнительных свойств для проведения документа
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства);
	
	// Подготовка наборов записей
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	// Запись наборов записей
	ПроведениеСервер.ЗаписатьНаборыЗаписей(ЭтотОбъект);
	
КонецПроцедуры

//Процедура - обработчик события ПередЗаписью объекта.
//Прверяется наличие документов реструктуризации в том же периоде что и текщий документ 
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =  "ВЫБРАТЬ ПЕРВЫЕ 1
		                |	ДоговорРеструктуризацииДолга.Ссылка
		                |ИЗ
		                |	Документ.ДоговорРеструктуризацииДолга КАК ДоговорРеструктуризацииДолга
		                |ГДЕ
		                |	ДоговорРеструктуризацииДолга.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		                |	И ДоговорРеструктуризацииДолга.ЛицевойСчет = &ЛицевойСчет
		                |	И ДоговорРеструктуризацииДолга.Проведен = ИСТИНА
		                |	И ДоговорРеструктуризацииДолга.Ссылка <> &Ссылка" ;
		Запрос.УстановитьПараметр("ЛицевойСчет",ЛицевойСчет);
		Запрос.УстановитьПараметр("ДатаНачала",НачалоМесяца(Дата));
		Запрос.УстановитьПараметр("ДатаОкончания",КонецМесяца(Дата));
		Запрос.УстановитьПараметр("Ссылка",Ссылка);
		
		Результат = Запрос.Выполнить();

		Если НЕ Результат.Пустой() Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "По цьому особовому рахунку вже є проведений договір реструктуризації за цей місяць.";
			Сообщение.Поле = "ЛицевойСчет";
			Сообщение.Сообщить();
			Отказ = Истина;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

