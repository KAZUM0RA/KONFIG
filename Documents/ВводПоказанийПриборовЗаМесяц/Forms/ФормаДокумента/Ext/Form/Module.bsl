&НаСервере
Функция ВыбратьСреднийПоказатель(ПриборУчета);
	КонПериода = КонецМесяца(ДобавитьМесяц(КонецМесяца(Объект.ПериодНачисления), -1));
	НачПериода = ДобавитьМесяц(НачалоМесяца(Объект.ПериодНачисления), -12);
	Запрос = Новый Запрос;
	Запрос.Текст = 
	    "ВЫБРАТЬ
	    |	ПоказанияПриборовЗаМесяц.Разница
	    |ИЗ
	    |	РегистрСведений.ПоказанияПриборовЗаМесяц КАК ПоказанияПриборовЗаМесяц
	    |ГДЕ
	    |	ПоказанияПриборовЗаМесяц.Период МЕЖДУ &НачалоПериода И &КонецПериода
	    |	И ПоказанияПриборовЗаМесяц.ПриборУчета = &ПриборУчета";
		//"ВЫБРАТЬ
		//|	РасчетПоказанийПриборовУчета.Значение
		//|ИЗ
		//|	РегистрНакопления.РасчетПоказанийПриборовУчета КАК РасчетПоказанийПриборовУчета
		//|ГДЕ
		//|	РасчетПоказанийПриборовУчета.ПриборУчета = &ПриборУчета
		//|	И РасчетПоказанийПриборовУчета.Период МЕЖДУ &НачПериода И &КонПериода";

	Запрос.УстановитьПараметр("ПриборУчета", ПриборУчета);
	Запрос.УстановитьПараметр("КонецПериода", ДобавитьМесяц(КонецМесяца(ТекущаяДата()), -1));
	Запрос.УстановитьПараметр("НачалоПериода", ДобавитьМесяц(НачалоМесяца(ТекущаяДата()), -12));
	Результат = Запрос.Выполнить().Выгрузить();
	Если Результат.Количество() = 0 Тогда
		//Продолжить;
	Иначе
		Показ = 0;
		Для Каждого стр Из Результат Цикл
			Показ = Показ + стр.Разница;
		КонецЦикла;
		ПоказОбщий = Показ / Результат.Количество();
	КонецЕсли;
	Если ПоказОбщий = Неопределено Тогда
		ПоказОбщий = 0;
	КонецЕсли;
	Возврат ПоказОбщий;
КонецФункции

&НаСервере
Функция ПроверкаРоли()
    Пользователь = ПараметрыСеанса.ТекущийПользователь.Наименование;
	Возврат Пользователь;
КонецФункции
