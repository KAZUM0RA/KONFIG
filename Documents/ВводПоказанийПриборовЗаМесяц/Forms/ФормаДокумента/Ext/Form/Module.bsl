&НаСервере
Процедура СписокНеЗаполненыхНаСервере(ТабДок)
	Макет = Документы.ВводПоказанийПриборовЗаМесяц.ПолучитьМакет("МакетНезаполненных");
	Запрос = Новый Запрос;
	Запрос.Текст =
	    "ВЫБРАТЬ
	    |	ВводПоказанийПриборовЗаМесяцПоказания.ЛицевойСчет КАК ЛицевойСчет,
	    |	ВводПоказанийПриборовЗаМесяцПоказания.ПриборУчета,
	    |	ВводПоказанийПриборовЗаМесяцПоказания.ПоказаниеПредыдущее,
	    |	ВводПоказанийПриборовЗаМесяцПоказания.Показание,
	    |	ВводПоказанийПриборовЗаМесяцПоказания.Бойлер,
	    |	ВводПоказанийПриборовЗаМесяцПоказания.НеЖивут,
	    |	ВводПоказанийПриборовЗаМесяцПоказания.ЛицевойСчет.ОбъектЛицевогоСчета КАК Квартира
	    |ИЗ
	    |	Документ.ВводПоказанийПриборовЗаМесяц.Показания КАК ВводПоказанийПриборовЗаМесяцПоказания
	    |ГДЕ
	    |	ВводПоказанийПриборовЗаМесяцПоказания.Разница < 0
	    |	И ВводПоказанийПриборовЗаМесяцПоказания.Ссылка.Ссылка = &ЭтотДокумент
	    |
	    |УПОРЯДОЧИТЬ ПО
	    |	ЛицевойСчет
	    |АВТОУПОРЯДОЧИВАНИЕ";
	Запрос.УстановитьПараметр("ЭтотДокумент", Объект.Ссылка);
	Результат = Запрос.Выполнить();
	
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьШапкаТаблицы = Макет.ПолучитьОбласть("ШапкаТаблицы");
	ОбластьДанные = Макет.ПолучитьОбласть("Данные");
	
	ТабДок.Очистить();
	ОбластьШапка.Параметры.ПериодНачисления = Объект.ПериодНачисления;
	ТабДок.Вывести(ОбластьШапка);
	ТабДок.Вывести(ОбластьШапкаТаблицы);
	
	ОбластьДанные.Параметры.Номер = 0;
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		ОбластьДанные.Параметры.Номер = ОбластьДанные.Параметры.Номер + 1;
		ОбластьДанные.Параметры.ЛицевойСчет = Выборка.ЛицевойСчет;
		ОбластьДанные.Параметры.Адрес = Строка(Выборка.ЛицевойСчет.Владелец) + " " + Строка(Выборка.Квартира);
		ОбластьДанные.Параметры.ПриборУчета = Выборка.ПриборУчета;
		ОбластьДанные.Параметры.ПоказаниеПредыдущее = Выборка.ПоказаниеПредыдущее;
		ОбластьДанные.Параметры.Показание = Выборка.Показание;
		ОбластьДанные.Параметры.Бойлер = Выборка.Бойлер;
		ОбластьДанные.Параметры.НеЖивут = Выборка.НеЖивут;
		ОбластьДанные.Параметры.Телефон = Выборка.ЛицевойСчет.МобТелефон;
		ТабДок.Вывести(ОбластьДанные);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура СписокНеЗаполненых(Команда)
	ТабДок = Новый ТабличныйДокумент;
	
	СписокНеЗаполненыхНаСервере(ТабДок);
	ТабДок.Показать();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПустыеПоказанияНаСервере()
	тзПоказания = Объект.Показания.Выгрузить();
	Для Каждого Строка Из тзПоказания Цикл
		Если НЕ ЗначениеЗаполнено(Строка.Здание) Тогда
			Продолжить;
		ИначеЕсли НЕ ЗначениеЗаполнено(Строка.Показание) ИЛИ Строка.Показание < Строка.ПоказаниеПредыдущее Тогда
			Если Строка.НеЖивут = Истина И Строка.Бойлер = Истина И Строка.Услуга.ВидУслуги = Справочники.ВидыУслуг.ГорячаяВода Тогда 
			    Строка.Показание = Строка.ПоказаниеПредыдущее;
		        Строка.Разница = 0;
				Строка.НачислениеПоСреднему = Ложь;
			ИначеЕсли Строка.НеЖивут = Истина И Строка.Бойлер = Ложь Тогда
				Строка.Показание = Строка.ПоказаниеПредыдущее;
		        Строка.Разница = 0;
				Строка.НачислениеПоСреднему = Ложь;
			ИначеЕсли Строка.НеЖивут = Ложь И Строка.Бойлер = Истина И Строка.Услуга.ВидУслуги = Справочники.ВидыУслуг.ГорячаяВода Тогда
				Строка.Показание = Строка.ПоказаниеПредыдущее;
		        Строка.Разница = 0;
				Строка.НачислениеПоСреднему = Ложь;
			Иначе
				Среднее = ВыбратьСреднийПоказатель(Строка.ПриборУчета);
				КвоКубовСреднее  = Число(Среднее);
				
				Если КвоКубовСреднее = "" ИЛИ КвоКубовСреднее < 0 Тогда
					КвоКубовСреднее = Число(0);
				КонецЕсли;
				Строка.Показание = Формат(Число(Строка.ПоказаниеПредыдущее) + Число(КвоКубовСреднее), "ЧЦ=12; ЧДЦ=3");
				Строка.Разница   = Формат(КвоКубовСреднее, "ЧЦ=12; ЧДЦ=3");
				Строка.НачислениеПоСреднему = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Объект.Показания.Загрузить(тзПоказания);
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПустыеПоказания(Команда)
	
	ЗаполнитьПустыеПоказанияНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказанияПоказаниеПриИзменении(Элемент)
	ТекСтрока = Элементы.Показания.ТекущиеДанные;
	ТекСтрока.Разница = ТекСтрока.Показание - ТекСтрока.ПоказаниеПредыдущее;
КонецПроцедуры

&НаСервере
Процедура ПриОткрытииНаСервере()
	Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
		Объект.Организация = Справочники.Организации.НайтиПоКоду("000000001");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.Ответственный) Тогда
		Объект.Ответственный = ПараметрыСеанса.ТекущийПользователь;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ПриОткрытииНаСервере();
	Пользователь = ПроверкаРоли();
	Если Объект.Дата < НачалоМесяца(ТекущаяДата()) И НЕ Пользователь = "Администратор" И Объект.Проведен = Истина Тогда
	    ЭтаФорма.ТолькоПросмотр = Истина;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура СписокСНулевымиПоказаниямиНаСервере(ТабДок)
	Макет = Документы.ВводПоказанийПриборовЗаМесяц.ПолучитьМакет("МакетНезаполненных");
	Запрос = Новый Запрос;
	Запрос.Текст =
	    "ВЫБРАТЬ
	    |	ВводПоказанийПриборовЗаМесяцПоказания.ЛицевойСчет КАК ЛицевойСчет,
	    |	ВводПоказанийПриборовЗаМесяцПоказания.ПриборУчета,
	    |	ВводПоказанийПриборовЗаМесяцПоказания.ПоказаниеПредыдущее,
	    |	ВводПоказанийПриборовЗаМесяцПоказания.Показание,
	    |	ВводПоказанийПриборовЗаМесяцПоказания.Бойлер,
	    |	ВводПоказанийПриборовЗаМесяцПоказания.НеЖивут,
	    |	ВводПоказанийПриборовЗаМесяцПоказания.ЛицевойСчет.ОбъектЛицевогоСчета КАК Квартира
	    |ИЗ
	    |	Документ.ВводПоказанийПриборовЗаМесяц.Показания КАК ВводПоказанийПриборовЗаМесяцПоказания
	    |ГДЕ
	    |	ВводПоказанийПриборовЗаМесяцПоказания.Ссылка.Ссылка = &ЭтотДокумент
	    |
	    |УПОРЯДОЧИТЬ ПО
	    |	ЛицевойСчет
	    |АВТОУПОРЯДОЧИВАНИЕ";
	Запрос.УстановитьПараметр("ЭтотДокумент", Объект.Ссылка);
	Результат = Запрос.Выполнить();
	
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьШапкаТаблицы = Макет.ПолучитьОбласть("ШапкаТаблицы");
	ОбластьДанные = Макет.ПолучитьОбласть("Данные");
	
	ТабДок.Очистить();
	ОбластьШапка.Параметры.ПериодНачисления = Объект.ПериодНачисления;
	ТабДок.Вывести(ОбластьШапка);
	ТабДок.Вывести(ОбластьШапкаТаблицы);
	
	ОбластьДанные.Параметры.Номер = 0;
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.ПоказаниеПредыдущее = Выборка.Показание Тогда
			ОбластьДанные.Параметры.Номер = ОбластьДанные.Параметры.Номер + 1;
			ОбластьДанные.Параметры.ЛицевойСчет = Выборка.ЛицевойСчет;
			ОбластьДанные.Параметры.Адрес = Выборка.ЛицевойСчет.Владелец + " " + Выборка.Квартира;
			ОбластьДанные.Параметры.ПриборУчета = Выборка.ПриборУчета;
			ОбластьДанные.Параметры.ПоказаниеПредыдущее = Выборка.ПоказаниеПредыдущее;
			ОбластьДанные.Параметры.Показание = Выборка.Показание;
			ОбластьДанные.Параметры.Бойлер = Выборка.Бойлер;
		    ОбластьДанные.Параметры.НеЖивут = Выборка.НеЖивут;
			ОбластьДанные.Параметры.Телефон = Выборка.ЛицевойСчет.МобТелефон;
			ТабДок.Вывести(ОбластьДанные);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура СписокСНулевымиПоказаниями(Команда)
	ТабДок = Новый ТабличныйДокумент;
	СписокСНулевымиПоказаниямиНаСервере(ТабДок);
	ТабДок.Показать();
КонецПроцедуры

&НаСервере
Процедура СписокСЗанесеннымиПоказаниямиНаСервере(ТабДок)
	Макет = Документы.ВводПоказанийПриборовЗаМесяц.ПолучитьМакет("МакетНезаполненных");
	Запрос = Новый Запрос;
	Запрос.Текст =
	    "ВЫБРАТЬ
	    |	ВводПоказанийПриборовЗаМесяцПоказания.ЛицевойСчет КАК ЛицевойСчет,
	    |	ВводПоказанийПриборовЗаМесяцПоказания.ПриборУчета,
	    |	ВводПоказанийПриборовЗаМесяцПоказания.ПоказаниеПредыдущее,
	    |	ВводПоказанийПриборовЗаМесяцПоказания.Показание,
	    |	СУММА(ВводПоказанийПриборовЗаМесяцПоказания.Показание - ВводПоказанийПриборовЗаМесяцПоказания.ПоказаниеПредыдущее) КАК Разница,
	    |	ВводПоказанийПриборовЗаМесяцПоказания.Бойлер,
	    |	ВводПоказанийПриборовЗаМесяцПоказания.НеЖивут,
	    |	ВводПоказанийПриборовЗаМесяцПоказания.ЛицевойСчет.ОбъектЛицевогоСчета КАК Квартира
	    |ИЗ
	    |	Документ.ВводПоказанийПриборовЗаМесяц.Показания КАК ВводПоказанийПриборовЗаМесяцПоказания
	    |ГДЕ
	    |	ВводПоказанийПриборовЗаМесяцПоказания.Разница > 0
	    |	И ВводПоказанийПриборовЗаМесяцПоказания.Ссылка.Ссылка = &ЭтотДокумент
	    |
	    |СГРУППИРОВАТЬ ПО
	    |	ВводПоказанийПриборовЗаМесяцПоказания.ЛицевойСчет,
	    |	ВводПоказанийПриборовЗаМесяцПоказания.ПриборУчета,
	    |	ВводПоказанийПриборовЗаМесяцПоказания.ПоказаниеПредыдущее,
	    |	ВводПоказанийПриборовЗаМесяцПоказания.Показание,
	    |	ВводПоказанийПриборовЗаМесяцПоказания.Бойлер,
	    |	ВводПоказанийПриборовЗаМесяцПоказания.НеЖивут
	    |
	    |УПОРЯДОЧИТЬ ПО
	    |	Разница УБЫВ
	    |АВТОУПОРЯДОЧИВАНИЕ";
	Запрос.УстановитьПараметр("ЭтотДокумент", Объект.Ссылка);
	Результат = Запрос.Выполнить();
	
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьШапкаТаблицы = Макет.ПолучитьОбласть("ШапкаТаблицы");
	ОбластьДанные = Макет.ПолучитьОбласть("Данные");
	
	ТабДок.Очистить();
	ОбластьШапка.Параметры.ПериодНачисления = Объект.ПериодНачисления;
	ТабДок.Вывести(ОбластьШапка);
	ТабДок.Вывести(ОбластьШапкаТаблицы);
	
	ОбластьДанные.Параметры.Номер = 0;
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		ОбластьДанные.Параметры.Номер = ОбластьДанные.Параметры.Номер + 1;
		ОбластьДанные.Параметры.ЛицевойСчет = Выборка.ЛицевойСчет;
		ОбластьДанные.Параметры.Адрес = Строка(Выборка.ЛицевойСчет.Владелец) + " " + Строка(Выборка.Квартира);
		ОбластьДанные.Параметры.ПриборУчета = Выборка.ПриборУчета;
		ОбластьДанные.Параметры.ПоказаниеПредыдущее = Выборка.ПоказаниеПредыдущее;
		ОбластьДанные.Параметры.Показание = Выборка.Показание;
		ОбластьДанные.Параметры.Разница = Выборка.Показание - Выборка.ПоказаниеПредыдущее;
		ОбластьДанные.Параметры.Бойлер = Выборка.Бойлер;
		ОбластьДанные.Параметры.НеЖивут = Выборка.НеЖивут;
		ОбластьДанные.Параметры.Телефон = Выборка.ЛицевойСчет.МобТелефон;
		ТабДок.Вывести(ОбластьДанные);
	КонецЦикла;
КонецПроцедуры

