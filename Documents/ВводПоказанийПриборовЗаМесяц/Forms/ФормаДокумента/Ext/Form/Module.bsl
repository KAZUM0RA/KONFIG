
&НаСервереБезКонтекста
Функция ПолучитьДанныеОсновнаяПоказаниеПриИзменении(СтруктураДанные)
	
	СтруктураДанные = Справочники.ПриборыУчета.ПолучитьРасход(СтруктураДанные);
	
	Возврат СтруктураДанные;
	
КонецФункции


&НаСервере
Процедура ЗаполнитьСоВсехИсточниковНаСервере()
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПоказанияПриборовУчетаССайтаСрезПоследних.ПриборУчета,
		|	ПоказанияПриборовУчетаССайтаСрезПоследних.ВидТарифа,
		|	ПоказанияПриборовУчетаССайтаСрезПоследних.Значение,
		|	ПоказанияПриборовУчетаССайтаСрезПоследних.Период,
		|	ЗНАЧЕНИЕ(Перечисление.ИсточникиПоказаний.СайтЖКХ) КАК Источник
		|ПОМЕСТИТЬ ВТ
		|ИЗ
		|	РегистрСведений.ПоказанияПриборовУчетаССайта.СрезПоследних(
		|			&ДатаКон,
		|			ПриборУчета В (&ПриборыУчета)
		|				И ЛицевойСчет В (&ЛицевыеСчета)) КАК ПоказанияПриборовУчетаССайтаСрезПоследних
		|ГДЕ
		|	ПоказанияПриборовУчетаССайтаСрезПоследних.Период >= &ДатаНач
		|	И ПоказанияПриборовУчетаССайтаСрезПоследних.Период <= &ДатаКон
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СнятыеПоказанияПриборовУчетаСрезПоследних.ПриборУчета,
		|	ЗНАЧЕНИЕ(Перечисление.ВидыТарифов.Общий),
		|	СнятыеПоказанияПриборовУчетаСрезПоследних.Значение,
		|	СнятыеПоказанияПриборовУчетаСрезПоследних.Период,
		|	ЗНАЧЕНИЕ(Перечисление.ИсточникиПоказаний.МобильноеПриложение)
		|ИЗ
		|	РегистрСведений.СнятыеПоказанияПриборовУчета.СрезПоследних(&ДатаКон, ПриборУчета В (&приборыУчета)) КАК СнятыеПоказанияПриборовУчетаСрезПоследних
		|ГДЕ
		|	СнятыеПоказанияПриборовУчетаСрезПоследних.Период >= &ДатаНач
		|	И СнятыеПоказанияПриборовУчетаСрезПоследних.Период <= &ДатаКон
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ПоказанияПУИзВнешнихИсточниковСрезПоследних.ПриборУчета,
		|	ПоказанияПУИзВнешнихИсточниковСрезПоследних.ВидТарифа,
		|	ПоказанияПУИзВнешнихИсточниковСрезПоследних.Значение,
		|	ПоказанияПУИзВнешнихИсточниковСрезПоследних.Период,
		|	ВЫБОР
		|		КОГДА ПоказанияПУИзВнешнихИсточниковСрезПоследних.Источник = ЗНАЧЕНИЕ(Перечисление.ИсточникиПоказаний.ПустаяСсылка)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ИсточникиПоказаний.ТаблицаExcel)
		|		ИНАЧЕ ПоказанияПУИзВнешнихИсточниковСрезПоследних.Источник
		|	КОНЕЦ
		|ИЗ
		|	РегистрСведений.ПоказанияПУИзВнешнихИсточников.СрезПоследних(&ДатаКон, ПриборУчета В (&ПриборыУчета)) КАК ПоказанияПУИзВнешнихИсточниковСрезПоследних
		|ГДЕ
		|	ПоказанияПУИзВнешнихИсточниковСрезПоследних.Период >= &ДатаНач
		|	И ПоказанияПУИзВнешнихИсточниковСрезПоследних.Период <= &ДатаКон
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ПоказанияПриборовУчетаИзТелеграммСрезПоследних.ПриборУчета,
		|	ПоказанияПриборовУчетаИзТелеграммСрезПоследних.ВидТарифа,
		|	ПоказанияПриборовУчетаИзТелеграммСрезПоследних.Значение,
		|	NULL,
		|	ЗНАЧЕНИЕ(Перечисление.ИсточникиПоказаний.Телеграм)
		|ИЗ
		|	РегистрСведений.ПоказанияПриборовУчетаИзТелеграмм.СрезПоследних КАК ПоказанияПриборовУчетаИзТелеграммСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ.ПриборУчета КАК ПриборУчета,
		|	ВТ.ВидТарифа КАК ВидТарифа,
		|	ВТ.Значение,
		|	ВТ.Период КАК Период,
		|	ВТ.Источник
		|ИЗ
		|	ВТ КАК ВТ
		|
		|УПОРЯДОЧИТЬ ПО
		|	ПриборУчета,
		|	ВидТарифа,
		|	Период УБЫВ
		|ИТОГИ ПО
		|	ПриборУчета,
		|	ВидТарифа";
	
	Запрос.УстановитьПараметр("ДатаНач", НачалоМесяца(Объект.Дата));
	Запрос.УстановитьПараметр("ДатаКон", КонецМесяца(Объект.Дата));
	Запрос.УстановитьПараметр("ПриборыУчета", Объект.Показания.Выгрузить().ВыгрузитьКолонку("ПриборУчета"));
	Запрос.УстановитьПараметр("ЛицевыеСчета", Объект.Показания.Выгрузить().ВыгрузитьКолонку("ЛицевойСчет"));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаПрибор = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока  ВыборкаПрибор.Следующий() Цикл
		ВыборкаТариф = ВыборкаПрибор.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока  ВыборкаТариф.Следующий() Цикл
			СтруктураПоиска = Новый Структура;
			СтруктураПоиска.Вставить("ПриборУчета",ВыборкаТариф.ПриборУчета);
			СтруктураПоиска.Вставить("ВидТарифа",ВыборкаТариф.ВидТарифа);
			ВыборкаДетальныеЗаписи = ВыборкаТариф.Выбрать();
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				
				НайденныеСтроки = Объект.Показания.НайтиСтроки(СтруктураПоиска);
				Для каждого Строка Из НайденныеСтроки Цикл
				
					Если Строка.Отключен Тогда
						Продолжить;
					КонецЕсли;
					Если Строка.Показание <= ВыборкаДетальныеЗаписи.значение Тогда
					    Строка.Показание = ВыборкаДетальныеЗаписи.значение;
					КонецЕсли;
					СтруктураДанные = Новый Структура();
					СтруктураДанные.Вставить("ПриборУчета", Строка.ПриборУчета);
					СтруктураДанные.Вставить("ПредыдущееПоказание", Строка.ПоказаниеПредыдущее);
					СтруктураДанные.Вставить("ТекущееПоказание", Строка.Показание);
					
					СтруктураДанные = ПолучитьДанныеОсновнаяПоказаниеПриИзменении(СтруктураДанные);
					
					Если ЗначениеЗаполнено(СтруктураДанные.ТекстОшибки) Тогда
						
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтруктураДанные.ТекстОшибки);
						
						Строка.Показание = ПоказаниеПередРедактированием;
						
						Возврат;
					КонецЕсли;
					Строка.Источник = ВыборкаДетальныеЗаписи.Источник;
					Строка.Разница = СтруктураДанные.РасходПоПриборуУчета;
					Строка.ПереходЧерезНоль = СтруктураДанные.ЕстьПереходПоказанийЧерезНоль;
					Строка.РасходЗаПериодРасчета = СтруктураДанные.РасходЗаПериодРасчета;
					Прервать;
				
				КонецЦикла; 
				
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСоВсехИсточников(Команда)
	ЗаполнитьСоВсехИсточниковНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьАвтоматическиНаСервере()
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ЗаменыПриборовУчетаОбороты.ОбъектУстановки КАК ОбъектУстановки,
		|	ЗаменыПриборовУчетаОбороты.ПриборУчета КАК ПриборУчета,
		|	ЗаменыПриборовУчетаОбороты.Услуга КАК Услуга,
		|	ЗаменыПриборовУчетаОбороты.ВидТарифа КАК ВидТарифа,
		|	ЗаменыПриборовУчетаОбороты.ПоказаниеПредыдущееОборот КАК ПоказаниеПредыдущееОборот,
		|	ЗаменыПриборовУчетаОбороты.ПоказаниеОборот КАК ПоказаниеОборот,
		|	ЕСТЬNULL(ЗаменыПриборовУчетаОбороты.СреднемесячноеПоказаниеОборот, 0) КАК СреднемесячноеПоказаниеОборот,
		|	ЗаменыПриборовУчетаОбороты.Период КАК Период,
		|	ЗаменыПриборовУчетаОбороты.ОбъектУстановки.ОбъектЛицевогоСчета КАК ОбъектЛицевогоСчета,
		|	ЗаменыПриборовУчетаОбороты.ПриборУчета.Коэффициент КАК Коэффициент,
		|	ЗаменыПриборовУчетаОбороты.ОбъектУстановки.КодКОАТУУ
		|ПОМЕСТИТЬ Замена
		|ИЗ
		|	РегистрНакопления.ЗаменыПриборовУчета.Обороты(&НачПериода, &КонПериода, Месяц, ) КАК ЗаменыПриборовУчетаОбороты
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Замена.ОбъектУстановки,
		|	Замена.ПриборУчета,
		|	Замена.Услуга,
		|	Замена.ВидТарифа,
		|	Замена.ПоказаниеПредыдущееОборот КАК ПоказаниеПредыдущее,
		|	Замена.ПоказаниеОборот КАК Показание,
		|	Замена.СреднемесячноеПоказаниеОборот КАК СреднемесячноеПоказание,
		|	Замена.Период,
		|	Замена.ОбъектЛицевогоСчета,
		|	Замена.Коэффициент,
		|	ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ОтветственныйВладелец,
		|	ИСТИНА КАК Отключен,
		|	ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ЛицевойСчет.Бойлер,
		|	ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ЛицевойСчет.НеЖивут,
		|	ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ЛицевойСчет.КодКОАТУУ
		|ПОМЕСТИТЬ ВТ2
		|ИЗ
		|	Замена КАК Замена
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОтветственныйВладелецЛицевогоСчета.СрезПоследних(
		|				&КонПериода,
		|				ЛицевойСчет В
		|					(ВЫБРАТЬ
		|						Замена.ОбъектУстановки
		|					ИЗ
		|						Замена КАК Замена)) КАК ОтветственныйВладелецЛицевогоСчетаСрезПоследних
		|		ПО Замена.ОбъектУстановки = ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ЛицевойСчет
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	УстановленныеПриборыУчетаСрезПоследних.Период,
		|	УстановленныеПриборыУчетаСрезПоследних.Регистратор,
		|	УстановленныеПриборыУчетаСрезПоследних.НомерСтроки,
		|	УстановленныеПриборыУчетаСрезПоследних.Активность,
		|	УстановленныеПриборыУчетаСрезПоследних.ОбъектУстановки,
		|	УстановленныеПриборыУчетаСрезПоследних.ПриборУчета,
		|	УстановленныеПриборыУчетаСрезПоследних.Действует,
		|	УстановленныеПриборыУчетаСрезПоследних.СреднемесячноеПоказание,
		|	УстановленныеПриборыУчетаСрезПоследних.ОбъектУстановки.Бойлер,
		|	УстановленныеПриборыУчетаСрезПоследних.ОбъектУстановки.НеЖивут,
		|	УстановленныеПриборыУчетаСрезПоследних.ОбъектУстановки.КодКОАТУУ
		|ПОМЕСТИТЬ УстПУ
		|ИЗ
		|	РегистрСведений.УстановленныеПриборыУчета.СрезПоследних(&КонПериода, ) КАК УстановленныеПриборыУчетаСрезПоследних
		|ГДЕ
		|	УстановленныеПриборыУчетаСрезПоследних.Действует = ИСТИНА
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	УстПУ.ОбъектУстановки,
		|	УстПУ.ПриборУчета,
		|	ПоказанияПриборовУчетаСрезПоследних.ПриборУчета.Услуга,
		|	ПоказанияПриборовУчетаСрезПоследних.ВидТарифа,
		|	ПоказанияПриборовУчетаСрезПоследних.Значение,
		|	0 КАК ПоказаниеПредыдущее,
		|	ЛОЖЬ КАК Отключен,
		|	УстПУ.ОбъектУстановки.ОбъектЛицевогоСчета,
		|	УстПУ.ПриборУчета.Коэффициент,
		|	ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ОтветственныйВладелец,
		|	0 КАК СреднемесячноеПоказание,
		|	ПоказанияПриборовУчетаСрезПоследних.Период,
		|	ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ЛицевойСчет.Бойлер,
		|	ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ЛицевойСчет.НеЖивут,
		|	ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ЛицевойСчет.КодКОАТУУ
		|ПОМЕСТИТЬ ВТ_тек
		|ИЗ
		|	УстПУ КАК УстПУ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПоказанияПриборовУчета.СрезПоследних(
		|				&КонПериода,
		|				Регистратор <> &Ссылка
		|					И ПриборУчета В
		|						(ВЫБРАТЬ
		|							УстПУ.ПриборУчета
		|						ИЗ
		|							УстПУ КАК УстПУ)) КАК ПоказанияПриборовУчетаСрезПоследних
		|		ПО УстПУ.ПриборУчета = ПоказанияПриборовУчетаСрезПоследних.ПриборУчета
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОтветственныйВладелецЛицевогоСчета.СрезПоследних(
		|				&КонПериода,
		|				ЛицевойСчет В
		|					(ВЫБРАТЬ
		|						УстПУ.ОбъектУстановки
		|					ИЗ
		|						УстПУ КАК УстПУ)) КАК ОтветственныйВладелецЛицевогоСчетаСрезПоследних
		|		ПО УстПУ.ОбъектУстановки = ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ЛицевойСчет
		|ГДЕ
		|	УстПУ.Действует = ИСТИНА
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ2.ОбъектУстановки,
		|	ВТ2.ПриборУчета,
		|	ВТ2.Услуга,
		|	ВТ2.ВидТарифа,
		|	ВТ2.ПоказаниеПредыдущее,
		|	ВТ2.Показание,
		|	ВТ2.СреднемесячноеПоказание,
		|	ВТ2.Период,
		|	ВТ2.ОбъектЛицевогоСчета,
		|	ВТ2.Коэффициент,
		|	ВТ2.ОтветственныйВладелец,
		|	ВТ2.Отключен,
		|	ВТ2.ОбъектУстановки.Бойлер,
		|	ВТ2.ОбъектУстановки.НеЖивут,
		|	ВТ2.ЛицевойСчетКодКОАТУУ
		|ИЗ
		|	ВТ2 КАК ВТ2
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВТ_тек.ОбъектУстановки,
		|	ВТ_тек.ПриборУчета,
		|	ВТ_тек.ПриборУчетаУслуга,
		|	ВТ_тек.ВидТарифа,
		|	ВТ_тек.Значение,
		|	ВТ_тек.ПоказаниеПредыдущее,
		|	ВТ_тек.СреднемесячноеПоказание,
		|	ВТ_тек.Период,
		|	ВТ_тек.ОбъектУстановкиОбъектЛицевогоСчета,
		|	ВТ_тек.ПриборУчетаКоэффициент,
		|	ВТ_тек.ОтветственныйВладелец,
		|	ВТ_тек.Отключен,
		|	ВТ_тек.ОбъектУстановки.Бойлер,
		|	ВТ_тек.ОбъектУстановки.НеЖивут,
		|	ВТ_тек.ЛицевойСчетКодКОАТУУ
		|ИЗ
		|	ВТ_тек КАК ВТ_тек
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЕСТЬNULL(НАПоверке.Период, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)) КАК ДатаОтключения,
		|	ЕСТЬNULL(НАПоверке.СреднемесячноеПоказание, 0) КАК СреднемесячноеПоказание,
		|	УстановленныеПриборыУчетаСрезПоследних.ОбъектУстановки КАК ОбъектУстановки,
		|	УстановленныеПриборыУчетаСрезПоследних.ПриборУчета КАК ПриборУчета,
		|	ЕСТЬNULL(УстановленныеПриборыУчетаСрезПоследних.Период, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)) КАК ДатаВключения,
		|	ЕСТЬNULL(ВЫБОР
		|			КОГДА ЕСТЬNULL(УстановленныеПриборыУчетаСрезПоследних.Период, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)) > ЕСТЬNULL(НАПоверке.Период, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0))
		|					И ЕСТЬNULL(УстановленныеПриборыУчетаСрезПоследних.Период, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)) > НАЧАЛОПЕРИОДА(&КонПериода, МЕСЯЦ)
		|				ТОГДА ВЫБОР
		|						КОГДА ЕСТЬNULL(НАПоверке.Период, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)) > НАЧАЛОПЕРИОДА(&КонПериода, МЕСЯЦ)
		|							ТОГДА РАЗНОСТЬДАТ(ЕСТЬNULL(НАПоверке.Период, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)), ЕСТЬNULL(УстановленныеПриборыУчетаСрезПоследних.Период, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)), ДЕНЬ)
		|						ИНАЧЕ РАЗНОСТЬДАТ(НАЧАЛОПЕРИОДА(&КонПериода, МЕСЯЦ), ЕСТЬNULL(УстановленныеПриборыУчетаСрезПоследних.Период, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)), ДЕНЬ)
		|					КОНЕЦ
		|			ИНАЧЕ ВЫБОР
		|					КОГДА ЕСТЬNULL(НАПоверке.Период, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)) > ЕСТЬNULL(УстановленныеПриборыУчетаСрезПоследних.Период, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0))
		|							И ЕСТЬNULL(НАПоверке.Период, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)) > НАЧАЛОПЕРИОДА(&КонПериода, МЕСЯЦ)
		|						ТОГДА РАЗНОСТЬДАТ(ЕСТЬNULL(НАПоверке.Период, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)), КОНЕЦПЕРИОДА(&КонПериода, МЕСЯЦ), ДЕНЬ)
		|					ИНАЧЕ ВЫБОР
		|							КОГДА ЕСТЬNULL(НАПоверке.Период, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)) > ЕСТЬNULL(УстановленныеПриборыУчетаСрезПоследних.Период, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0))
		|									И ЕСТЬNULL(НАПоверке.Период, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)) < НАЧАЛОПЕРИОДА(&КонПериода, МЕСЯЦ)
		|								ТОГДА РАЗНОСТЬДАТ(НАЧАЛОПЕРИОДА(&КонПериода, МЕСЯЦ), КОНЕЦПЕРИОДА(&КонПериода, МЕСЯЦ), ДЕНЬ)
		|						КОНЕЦ
		|				КОНЕЦ
		|		КОНЕЦ, 0) КАК ДнейПоСредней,
		|	РАЗНОСТЬДАТ(НАЧАЛОПЕРИОДА(НАЧАЛОПЕРИОДА(&КонПериода, МЕСЯЦ), ДЕНЬ), НАЧАЛОПЕРИОДА(КОНЕЦПЕРИОДА(&КонПериода, МЕСЯЦ), ДЕНЬ), ДЕНЬ) КАК ДнейВМесяце,
		|	ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ОтветственныйВладелец,
		|	ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ЛицевойСчет.Бойлер,
		|	ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ЛицевойСчет.НеЖивут,
		|	ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ЛицевойСчет.КодКОАТУУ
		|ИЗ
		|	РегистрСведений.УстановленныеПриборыУчета.СрезПоследних(&КонПериода, Действует = ИСТИНА) КАК УстановленныеПриборыУчетаСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УстановленныеПриборыУчета.СрезПоследних(
		|				&КонПериода,
		|				Действует = ЛОЖЬ
		|					И ЕСТЬNULL(СреднемесячноеПоказание, 0) <> 0) КАК НАПоверке
		|		ПО УстановленныеПриборыУчетаСрезПоследних.ОбъектУстановки = НАПоверке.ОбъектУстановки
		|			И УстановленныеПриборыУчетаСрезПоследних.ПриборУчета = НАПоверке.ПриборУчета
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОтветственныйВладелецЛицевогоСчета.СрезПоследних КАК ОтветственныйВладелецЛицевогоСчетаСрезПоследних
		|		ПО УстановленныеПриборыУчетаСрезПоследних.ОбъектУстановки = ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ЛицевойСчет
		|ГДЕ
		|	НАПоверке.СреднемесячноеПоказание <> 0
		|
		|УПОРЯДОЧИТЬ ПО
		|	ОбъектУстановки";
		
	Запрос.Параметры.Вставить("НачПериода", НачалоМесяца(Объект.ПериодНачисления));
	Запрос.Параметры.Вставить("КонПериода", КонецМесяца(Объект.ПериодНачисления));

	//Запрос.Параметры.Вставить("Здание", стр.Здание);
	//Запрос.Параметры.Вставить("Услуга", Объект.Услуга);
	Запрос.Параметры.Вставить("Ссылка", Объект.Ссылка);
	
	
	Результат  = Запрос.ВыполнитьПакет();
	
	ВыборкаЛС = Результат[4].Выбрать(); 
	ВыборкаПоверок = Результат[5].Выбрать();
	Разница = 0;
	
	Запрос = Новый Запрос;
	Запрос.Текст =  "ВЫБРАТЬ
	                |	ЛицевыеСчета.Ссылка КАК Ссылка
	                |ИЗ
	                |	Справочник.ЛицевыеСчета КАК ЛицевыеСчета
					//|ГДЕ
					//|	ЛицевыеСчета.Владелец = &Здание
	                |
	                |УПОРЯДОЧИТЬ ПО
	                |	Ссылка";
	//Запрос.УстановитьПараметр("Здание",стр.Здание);				 
	МассивОбъектовУстановки = ЗАпрос.Выполнить().Выгрузить();
	Пока ВыборкаЛС.Следующий() Цикл
		//Если ВыборкаЛС.Услуга.ВидУслуги = Справочники.ВидыУслуг.ХолоднаяВода Тогда			
			НоваяСтрока = Объект.Показания.Добавить();
			НоваяСтрока.Здание = ВыборкаЛС.ОбъектУстановки.Владелец;
			НоваяСтрока.ЛицевойСчет = ВыборкаЛС.ОбъектУстановки;
			НоваяСтрока.ПриборУчета = ВыборкаЛС.ПриборУчета;
			НоваяСтрока.ПоказаниеПредыдущее = ВыборкаЛС.ПоказаниеПредыдущее;
			НоваяСтрока.Показание = ВыборкаЛС.Показание;
			НоваяСтрока.Коэффициент = ВыборкаЛС.Коэффициент;
			НоваяСтрока.Отключен = ВыборкаЛС.Отключен;
			НоваяСтрока.ВидТарифа = ВыборкаЛС.ВидТарифа;
			НоваяСтрока.Услуга = ВыборкаЛС.Услуга;
			НоваяСтрока.ОбъектЛицевогоСчета = ВыборкаЛС.ОбъектЛицевогоСчета;
			НоваяСтрока.ОтветственныйВладелец = ВыборкаЛС.ОтветственныйВладелец;
			НоваяСтрока.Разница = НоваяСтрока.Показание - НоваяСтрока.ПоказаниеПредыдущее;
			НоваяСтрока.Бойлер = ВыборкаЛС.ОбъектУстановки.Бойлер;
			НоваяСтрока.НеЖивут = ВыборкаЛС.ОбъектУстановки.НеЖивут;
			НоваяСтрока.КодКОАТУУ = ВыборкаЛС.ОбъектУстановки.КодКОАТУУ;
		//КонецЕсли;		
	КонецЦикла;
	
	Для Индекс = 0 По (ЧИСЛО(МассивОбъектовУстановки.Количество())-1) Цикл
	
		НайденаПоверка = ВыборкаПоверок.НайтиСледующий(МассивОбъектовУстановки[Индекс].Ссылка);
		Если НайденаПоверка и ВыборкаПоверок.ДнейПоСредней <> 0 Тогда
			
		     
				НоваяСтрока = Объект.Показания.Добавить();
				НоваяСтрока.ЛицевойСчет = ВыборкаПоверок.ОбъектУстановки;
				НоваяСтрока.ПриборУчета = ВыборкаПоверок.ПриборУчета;
				НоваяСтрока.Коэффициент = ВыборкаПоверок.ПриборУчета.Коэффициент;
				НоваяСтрока.Отключен = Истина;
				НоваяСтрока.ВидТарифа = Перечисления.ВидыТарифов.Общий;
				НоваяСтрока.Услуга =  ВыборкаПоверок.ПриборУчета.Услуга;
				НоваяСтрока.ОбъектЛицевогоСчета = ВыборкаПоверок.ОбъектУстановки.ОбъектЛицевогоСчета;
				НоваяСтрока.ОтветственныйВладелец = ВыборкаПоверок.ОтветственныйВладелец;
				Разница = (ВыборкаПоверок.СреднемесячноеПоказание/(ВыборкаПоверок.ДнейВМесяце+1))*ВыборкаПоверок.ДнейПоСредней;
				НоваяСтрока.Разница =  Разница;

		 КонецЕсли;  
	
	КонецЦикла; 
		
	Объект.Показания.Сортировать("ЛицевойСчет, ПриборУчета, Отключен Убыв");   
	
	Для каждого СтрокаОсновная Из Объект.Показания Цикл
		
		Если СтрокаОсновная.Показание = 0 Тогда
			Продолжить;
		КонецЕсли; 
		
		СтруктураДанные = Новый Структура();
		СтруктураДанные.Вставить("ПриборУчета", СтрокаОсновная.ПриборУчета);
		СтруктураДанные.Вставить("ПредыдущееПоказание", СтрокаОсновная.ПоказаниеПредыдущее);
		СтруктураДанные.Вставить("ТекущееПоказание", СтрокаОсновная.Показание);
		
		СтруктураДанные = ПолучитьДанныеОсновнаяПоказаниеПриИзменении(СтруктураДанные);
		
		СтрокаОсновная.Разница = СтруктураДанные.РасходПоПриборуУчета;
		СтрокаОсновная.ПереходЧерезНоль = СтруктураДанные.ЕстьПереходПоказанийЧерезНоль;
		СтрокаОсновная.РасходЗаПериодРасчета = СтруктураДанные.РасходЗаПериодРасчета;
	
	КонецЦикла;
КонецПроцедуры

