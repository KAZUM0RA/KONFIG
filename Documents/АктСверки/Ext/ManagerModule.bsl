	СтруктураДополнительныеСвойства.ТаблицыДляДвижений.Вставить("ТаблицаВзаиморасчетыПоСубсидиям", РезультатЗапроса.Выгрузить());
	
КонецПроцедуры // СформироватьТаблицаВзаиморасчетыПоСубсидиям()

// Формирует таблицу значений, содержащую данные для проведения по регистру.
// Таблицы значений сохраняет в свойствах структуры "ДополнительныеСвойства".
//
Процедура СформироватьТаблицаРасчетыПоСубсидиям(ДокументСсылкаКорректировкаНачислений, СтруктураДополнительныеСвойства)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = СтруктураДополнительныеСвойства.ДляПроведения.СтруктураВременныеТаблицы.МенеджерВременныхТаблиц;
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
	|	ВременнаяТаблицаПерерасчет.Организация КАК Организация,
	|	ВременнаяТаблицаПерерасчет.ВидНачисления,
	|	СУММА(ВременнаяТаблицаПерерасчет.Сумма) КАК Сумма,
	|	ВременнаяТаблицаПерерасчет.ПериодКорректировки КАК МесяцНачисления,
	|	ВременнаяТаблицаПерерасчет.ЛицевойСчет,
	|	ВременнаяТаблицаПерерасчет.Услуга,
	|	ВременнаяТаблицаПерерасчет.Период
	|ИЗ
	|	ВременнаяТаблицаПерерасчет КАК ВременнаяТаблицаПерерасчет
	|ГДЕ
	|	ВременнаяТаблицаПерерасчет.ВидНачисления = ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Субсидия)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВременнаяТаблицаПерерасчет.Организация,
	|	ВременнаяТаблицаПерерасчет.ВидНачисления,
	|	ВременнаяТаблицаПерерасчет.ПериодКорректировки,
	|	ВременнаяТаблицаПерерасчет.Период,
	|	ВременнаяТаблицаПерерасчет.ЛицевойСчет,
	|	ВременнаяТаблицаПерерасчет.Услуга";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	СтруктураДополнительныеСвойства.ТаблицыДляДвижений.Вставить("ТаблицаГарантированныеСубсидии", РезультатЗапроса.Выгрузить());
	
КонецПроцедуры // СформироватьТаблицаВзаиморасчетыПоСубсидиям()

Процедура ИнициализироватьДанныеДокумента(ДокументСсылкаКорректировкаНачислений, СтруктураДополнительныеСвойства) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = СтруктураДополнительныеСвойства.ДляПроведения.СтруктураВременныеТаблицы.МенеджерВременныхТаблиц;
	
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	АктСверкиКорректировки.Услуга,
		|	АктСверкиКорректировки.Ссылка.ЛицевойСчет,
		|	ВЫБОР
		|		КОГДА АктСверкиКорректировки.ВидНачисления = ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Начисление)
		|			ТОГДА АктСверкиКорректировки.СуммаКорректировки
		|		ИНАЧЕ -АктСверкиКорректировки.СуммаКорректировки
		|	КОНЕЦ КАК Сумма,
		|	НАЧАЛОПЕРИОДА(АктСверкиКорректировки.Ссылка.ПериодНачисления, МЕСЯЦ) КАК МесяцНачисления,
		|	АктСверкиКорректировки.Ссылка.Дата КАК ПериодКорректировки,
		|	ВЫБОР
		|		КОГДА НЕ АктСверкиКорректировки.Услуга.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
		|			ТОГДА АктСверкиКорректировки.Услуга.Организация
		|		ИНАЧЕ АктСверкиКорректировки.Ссылка.Организация
		|	КОНЕЦ КАК Организация,
		|	АктСверкиКорректировки.Ссылка.Дата КАК Период,
		|	АктСверкиКорректировки.ВидНачисления КАК ВидНачисления,
		|	АктСверкиКорректировки.Услуга.ВидУслуги КАК ВидУслуги,
		|	АктСверкиКорректировки.Услуга.ВидУслуги.КонтрагентДляРасчетаПоЛьготам КАК КонтрагентДляРасчетаПоЛьготам,
		|	АктСверкиКорректировки.Услуга.ВидУслуги.ДоговорДляРасчетаПоЛьготам КАК ДоговорДляРасчетаПоЛьготам,
		|	АктСверкиКорректировки.Услуга.ВидУслуги.КонтрагентДляРасчетаПоСубсидиям КАК КонтрагентДляРасчетаПоСубсидиям,
		|	АктСверкиКорректировки.Услуга.ВидУслуги.ДоговорДляРасчетаПоСубсидиям КАК ДоговорДляРасчетаПоСубсидиям,
		|	ИСТИНА КАК Корректировка,
		|	АктСверкиКорректировки.Льгота КАК Льгота,
		|	АктСверкиКорректировки.Льготчик КАК Льготчик,
		|	АктСверкиКорректировки.Разница
		|ПОМЕСТИТЬ ВременнаяТаблицаПерерасчет
		|ИЗ
		|	Документ.АктСверки.Корректировки КАК АктСверкиКорректировки
		|ГДЕ
		|	АктСверкиКорректировки.Ссылка = &Ссылка";
	 
