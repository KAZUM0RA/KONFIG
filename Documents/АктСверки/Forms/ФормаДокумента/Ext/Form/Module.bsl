&НаСервере
Функция ВыбратьУслугиЛС(УслугаКН, ЛС)
	сзУслуги = Новый СписокЗначений;
	//сзУслуги.Добавить(УслугаХВ);
	сзУслуги.Добавить(УслугаКН);
	Запрос = Новый Запрос;
	Запрос.Текст = 
	    "ВЫБРАТЬ
	    |	НазначенныеУслугиСрезПоследних.Услуга
	    |ИЗ
	    |	РегистрСведений.НазначенныеУслуги.СрезПоследних(
	    |			&НаДату,
	    |			ЛицевойСчет = &ЛицевойСчет
	    |				И Услуга В (&Услуга)
	    |				И Действует = ИСТИНА) КАК НазначенныеУслугиСрезПоследних";
	Запрос.УстановитьПараметр("НаДату", ТекущаяДата());
	Запрос.УстановитьПараметр("Услуга", сзУслуги);
	Запрос.УстановитьПараметр("ЛицевойСчет", ЛС);
	Услуги = Запрос.Выполнить().Выгрузить();
	Возврат Услуги;
КонецФункции
