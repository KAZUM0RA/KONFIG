	Объект.Потребитель                      = ОтветственныйВладелецИКвоПрописанных.ОтветственныйВладелец;
	Объект.Здание                           = Объект.ЛицевойСчет.Владелец;
    Объект.ОбъектЛицевогоСчета              = Объект.ЛицевойСчет.ОбъектЛицевогоСчета;
	ПриборыУчета                            = ПолучитьСписокПриборов(Объект.ЛицевойСчет);
	УслугиПоЛС = ВыбратьУслугиЛС(Справочники.Услуги.НайтиПоКоду("000000019"), Объект.ЛицевойСчет);
	Объект.Корректировки.Очистить();
	Для Каждого стрПриборы Из ПриборыУчета Цикл
		НовСтрока = Объект.Корректировки.Добавить();
