&НаСервере
Функция КорректировкиПоказаний(ТабЧасть, Тариф)
	ТарифВодоотвод = 20.772;//ОбщийМодульМВК.ПолучитьТарифПоУслуге(Справочники.Услуги.НайтиПоКоду("000000019"));
	УслугиПоЛС = ВыбратьУслугиЛС(Справочники.Услуги.НайтиПоКоду("000000019"), Объект.ЛицевойСчет);
	Если УслугиПоЛС.Количество() <> 0 Тогда
		КвоКубовОбщее = (ТабЧасть.ПоказаниеНовое - ТабЧасть.Показание) * ТабЧасть.Коэффициент;
		ОбщаяСумма = КвоКубовОбщее * (Тариф + ТарифВодоотвод);
		СуммаХВ = КвоКубовОбщее * Тариф;
		СуммаКН = ОбщаяСумма - (КвоКубовОбщее * Тариф);
		ТабЧасть.СуммаКорректировки = СуммаХВ;
		
		НовСтрока = Объект.Корректировки.Добавить();
		НовСтрока.Услуга = Справочники.Услуги.НайтиПоКоду("000000019");
		ТекТарифК = ТарифВодоотвод;    //ОбщийМодульМВК.ПолучитьТарифПоУслуге(НовСтрока.Услуга);
		НовСтрока.ВидТарифа = Перечисления.ВидыТарифов.Общий;
		НовСтрока.ВидНачисления = Перечисления.ВидыНачислений.Корректировка;
		НовСтрока.СуммаКорректировки = СуммаКН;
		НовТабЧасть = Новый Структура;
		НовТабЧасть.Вставить("СуммаКорректировки",СуммаХВ); 
		Возврат НовТабЧасть;
	Иначе
		НовТабЧасть = Новый Структура;
		НовТабЧасть.Вставить("СуммаКорректировки",(ТабЧасть.ПоказаниеНовое - ТабЧасть.Показание) * ТабЧасть.Коэффициент * Тариф);
        Возврат НовТабЧасть;
	КонецЕсли;
КонецФункции

&НаСервере
Функция ПроверитьУслугу(Услуга)
	ВидУслугиХВ = Справочники.Услуги.НайтиПоКоду("Р00000192");
	Возврат ВидУслугиХВ;
КонецФункции

&НаСервере
Функция УслугаКН()
	ВидУслугиКН = Справочники.Услуги.НайтиПоКоду("000000019");
	Возврат ВидУслугиКН;
КонецФункции

&НаКлиенте
Процедура КорректировкиПоказаниеНовоеПриИзменении(Элемент)
	ТекСтрока = Элементы.Корректировки.ТекущиеДанные;
	ВидУслугиХВ = ПроверитьУслугу(ТекСтрока.Услуга);
	Если ТекСтрока.Услуга = ВидУслугиХВ Тогда
		
			тчКоррекция = Новый Структура;
			тчКоррекция.Вставить("Услуга", ВидУслугиХВ);
			тчКоррекция.Вставить("Показание", ТекСтрока.Показание);
			тчКоррекция.Вставить("ПоказаниеНовое", ТекСтрока.ПоказаниеНовое);
			тчКоррекция.Вставить("Коэффициент", ТекСтрока.Коэффициент);
			тчКоррекция.Вставить("СуммаКорректировки", ТекСтрока.СуммаКорректировки);
			ТекТариф = 22.92;   //ОбщийМодульМВК.ПолучитьТарифПоУслуге(ВидУслугиХВ);
			тчВозврат = КорректировкиПоказаний(тчКоррекция, ТекТариф);
			ТекСтрока.СуммаКорректировки = тчВозврат.СуммаКорректировки;
		Иначе
		ВидУслугиКН = УслугаКН();
		ТекТариф = 20.772;   //ОбщийМодульМВК.ПолучитьТарифПоУслуге(ВидУслугиКН);
		ТекСтрока.СуммаКорректировки = (ТекСтрока.ПоказаниеНовое - ТекСтрока.Показание) * ТекТариф * ТекСтрока.Коэффициент;
		
	КонецЕсли;
	ТекСтрока.Разница = ТекСтрока.ПоказаниеНовое - ТекСтрока.Показание;
КонецПроцедуры

