// Процедура - обработчик события ПриИзменении поля ввода ОсновныеУслуги.
//
&НаКлиенте
Процедура ОсновныеУслугиОсновныеУслугиПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ОсновныеУслуги.ТекущиеДанные;
	
	Если НЕ ЗначениеЗаполнено(ТекущиеДанные.Цена) Тогда
	
		ТекущиеДанные.Цена = ПолучитьЦенуНаСервере(ТекущиеДанные.Номенклатура);
		РассчитатьСуммуВСтрокеТабличнойЧасти("ОсновныеУслуги");

	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ТекущиеДанные.СтавкаНДС) Тогда
	
		ТекущиеДанные.СтавкаНДС = ПолучитьСтавкуНДС();
		РассчитатьСуммуВСтрокеТабличнойЧасти("ОсновныеУслуги");

	КонецЕсли;
	
КонецПроцедуры

