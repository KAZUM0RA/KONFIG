// ПРОЦЕДУРЫ - ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

// Процедура - обработчик события ПриСозданииНаСервере.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОСМДСервер.ЗаполнитьШапкуДокумента(
		Объект,
		,
		Параметры.ЗначениеКопирования,
		Параметры.Основание,
		СостояниеДокумента,
		КартинкаСостоянияДокумента,
		РазрешеноПроведение,
		ПоследнееИзменение,
		Параметры.ЗначенияЗаполнения);
	
 	// ДополнительныеОтчетыИОбработки
	ДополнительныеОтчетыИОбработки.ПриСозданииНаСервере(ЭтаФорма);
	// Конец ДополнительныеОтчетыИОбработки

КонецПроцедуры

// Процедура - обработчик события ПриОткрытии.
//
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ПроверитьПлательщикаНДС();
	РегистрироватьЦеныПриИзменении();
КонецПроцедуры

// Процедура - обработчик события ПередЗаписью.
//
&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	
	Если Объект.РегистрироватьЦены = Истина Тогда
		
		Дубли = ПроверитьДублиСтрок();
		
		Если Дубли Тогда
			
			Сообщить(НСтр("ru='Запись документа отменена! Удалите дублирующиеся строки или отмените регистрацию цен.';uk='Запис документу скасований! Видаліть рядки, що дублюються, або відмініть реєстрацію цін.'"));
			Отказ = Истина;
			
		КонецЕсли; 
		
	КонецЕсли;
	
КонецПроцедуры

// Процедура - обработчик события ПослеЗаписи.
//
&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	ОСМДКлиент.ОбновитьСостояниеДокумента(Объект, СостояниеДокумента, КартинкаСостоянияДокумента, РазрешеноПроведение, ПоследнееИзменение);
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ И ФУНКЦИИ ОБЩЕГО НАЗНАЧЕНИЯ

// Процедура рассчитывает общую сумму и сумму НДС.
//
&НаКлиенте
Процедура ОбновитьПодвалФормы()

	 Объект.СуммаДокумента = Объект.Запасы.Итог("Всего")+Объект.ОсновныеУслуги.Итог("Всего")+Объект.ПрочиеУслуги.Итог("Всего");
	 Объект.СуммаДокументаНДС = Объект.Запасы.Итог("СуммаНДС")+Объект.ОсновныеУслуги.Итог("СуммаНДС")+Объект.ПрочиеУслуги.Итог("СуммаНДС");
	 
КонецПроцедуры

// Процедура подставляет основной договор контрагента.
//
&НаКлиенте
Процедура КонтрагентПриИзменении(Элемент)
	
	ПроверитьПлательщикаНДС();
	Объект.ДоговорКонтрагента = ПолучитьОсновнойДоговор(Объект.Контрагент);
	
КонецПроцедуры

// Получает схему налогообложения.
//
&НаСервере
Функция ПолучитьСхемуНалогообложения(Контрагент)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПлательщикНДССрезПоследних.СистемаНалогообложения
		|ИЗ
		|	РегистрСведений.ПлательщикНДС.СрезПоследних КАК ПлательщикНДССрезПоследних
		|ГДЕ
		|	ПлательщикНДССрезПоследних.Контрагент = &Контрагент";

	Запрос.УстановитьПараметр("Контрагент", Контрагент);

	Результат = Запрос.Выполнить();

	Выборка = Результат.Выбрать();

	НеПлательщик = Перечисления.СистемыНалогооблажения.НеПлательщик; 
	
	Пока Выборка.Следующий() Цикл
		Если Выборка.СистемаНалогообложения = НеПлательщик Тогда
			Возврат Истина;
		Иначе
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

КонецФункции 

// Получает цену для новых строк табличной части.
//
&НаСервере
Функция ПолучитьЦенуНаСервере(Номенклатура)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЦеныНоменклатурыСрезПоследних.Номенклатура,
		|	ЦеныНоменклатурыСрезПоследних.Цена
		|ИЗ
		|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних КАК ЦеныНоменклатурыСрезПоследних
		|ГДЕ
		|	ЦеныНоменклатурыСрезПоследних.Номенклатура = &Номенклатура
		|	И ЦеныНоменклатурыСрезПоследних.ТипЦены = &ТипЦены";

	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("ТипЦены", Перечисления.ТипыЦенНоменклатуры.Закупочная);

	Результат = Запрос.Выполнить();

	Выборка = Результат.Выбрать();

	Пока Выборка.Следующий() Цикл
		Возврат Выборка.Цена;
	КонецЦикла;

КонецФункции

// Процедура изменяет видимость элементов формы.
//
&НаКлиенте
Процедура ПроверитьПлательщикаНДС()

	Объект.ВключаетНДС = ПолучитьСхемуНалогообложения(Объект.Контрагент);
	Если Объект.ВключаетНДС Тогда
	
		Элементы.ЗапасыСтавкаНДС.Видимость = Ложь;
		Элементы.ОсновныеУслугиСтавкаНДС.Видимость = Ложь;
        Элементы.ПрочиеУслугиСтавкаНДС.Видимость = Ложь;
        Элементы.ЗапасыСуммаНДС.Видимость = Ложь;
		Элементы.ОсновныеУслугиСуммаНДС.Видимость = Ложь;
        Элементы.ПрочиеУслугиСуммаНДС.Видимость = Ложь;
		Элементы.ЗапасыЦена.Заголовок = "Цена с НДС";
		Элементы.ОсновныеУслуги.Заголовок = "Цена с НДС";
		Элементы.ПрочиеУслуги.Заголовок = "Цена с НДС";
		
	Иначе
		
		Элементы.ЗапасыСтавкаНДС.Видимость = Истина;
		Элементы.ОсновныеУслугиСтавкаНДС.Видимость = Истина;
        Элементы.ПрочиеУслугиСтавкаНДС.Видимость = Истина;
        Элементы.ЗапасыСуммаНДС.Видимость = Истина;
		Элементы.ОсновныеУслугиСуммаНДС.Видимость = Истина;
        Элементы.ПрочиеУслугиСуммаНДС.Видимость = Истина;
		Элементы.ЗапасыЦена.Заголовок = "Цена";
		Элементы.ОсновныеУслуги.Заголовок = "Цена";
		Элементы.ПрочиеУслуги.Заголовок = "Цена";
		
	КонецЕсли; 	

	ОбновитьСтроки(Объект.ВключаетНДС);
	ОбновитьПодвалФормы();
	
КонецПроцедуры 

// Процедура изменяет видимость поля типа цены.
//
&НаКлиенте
Процедура РегистрироватьЦеныПриИзменении()
	
	Если Объект.РегистрироватьЦены Тогда	
		Элементы.ТипЦены.Видимость = Истина;	
	Иначе
		Элементы.ТипЦены.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

// Процедура обновляет строки табличной части при изменении контрагента.
//
&НаКлиенте
Процедура ОбновитьСтроки(ВключаетНДС)
	
	
	Для каждого Строка Из Объект.Запасы Цикл
		
		НетНДС = ПолучитьСтавкуНДСДляСравнения(Объект.ВключаетНДС, Строка.СтавкаНДС);
		
		Если НЕ Объект.ВключаетНДС И НетНДС = Ложь Тогда		 
			ДелительНДС = 5;	 
		Иначе
			ДелительНДС = 6;
		КонецЕсли;

		Если НЕ Объект.ВключаетНДС И НетНДС Тогда
			Строка.СуммаНДС = 0;
		Иначе
			Строка.СуммаНДС = Строка.Сумма/ДелительНДС;
		КонецЕсли;

	 	Строка.Всего = Строка.Сумма + ?(ВключаетНДС, 0, Строка.СуммаНДС);
	 	
	КонецЦикла;
	
	Для каждого Строка Из Объект.ОсновныеУслуги Цикл
		
		НетНДС = ПолучитьСтавкуНДСДляСравнения(Объект.ВключаетНДС, Строка.СтавкаНДС);
		
		Если НЕ Объект.ВключаетНДС И НетНДС = Ложь Тогда		 
			ДелительНДС = 5;	 
		Иначе
			ДелительНДС = 6;
		КонецЕсли;

		Если НЕ Объект.ВключаетНДС И НетНДС Тогда
			Строка.СуммаНДС = 0;
		Иначе
			Строка.СуммаНДС = Строка.Сумма/ДелительНДС;
		КонецЕсли;

	 	Строка.Всего = Строка.Сумма + ?(ВключаетНДС, 0, Строка.СуммаНДС);
	 	
	КонецЦикла;

    Для каждого Строка Из Объект.ПрочиеУслуги Цикл
		
		НетНДС = ПолучитьСтавкуНДСДляСравнения(Объект.ВключаетНДС, Строка.СтавкаНДС);
		
		Если НЕ Объект.ВключаетНДС И НетНДС = Ложь Тогда		 
			ДелительНДС = 5;	 
		Иначе
			ДелительНДС = 6;
		КонецЕсли;

		Если НЕ Объект.ВключаетНДС И НетНДС Тогда
			Строка.СуммаНДС = 0;
		Иначе
			Строка.СуммаНДС = Строка.Сумма/ДелительНДС;
		КонецЕсли;

	 	Строка.Всего = Строка.Сумма + ?(ВключаетНДС, 0, Строка.СуммаНДС);
	 	
	КонецЦикла;

КонецПроцедуры

// Получает договор по умолчания.
//
&НаСервере
Функция ПолучитьОсновнойДоговор(Контрагент)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Контрагенты.ДоговорПоУмолчанию КАК Договор
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.Ссылка = &Ссылка";

	Запрос.УстановитьПараметр("Ссылка", Контрагент);

	Результат = Запрос.Выполнить();

	Выборка = Результат.Выбрать();

	Пока Выборка.Следующий() Цикл
		Возврат Выборка.Договор;
	КонецЦикла;

КонецФункции 

// Функция возвращает истину, если есть дублирующиеся строки.
//
&НаСервере
Функция ПроверитьДублиСтрок()
	
	Таблица = Объект.Запасы.Выгрузить();
	ТаблицаНоменклатуры = Таблица.Скопировать(,"Номенклатура,Цена");
	Менеджер=Новый МенеджерВременныхТаблиц;
	Запрос=Новый Запрос;
	Запрос.Текст=
	"ВЫБРАТЬ
	|    ТаблицаНоменклатуры.Номенклатура,
	|    ТаблицаНоменклатуры.Цена
	|ПОМЕСТИТЬ ТаблицаНоменклатуры
	|ИЗ
	|    &ТаблицаНоменклатуры КАК ТаблицаНоменклатуры";
	Запрос.УстановитьПараметр("ТаблицаНоменклатуры",ТаблицаНоменклатуры);
	Запрос.МенеджерВременныхТаблиц=Менеджер;
	Результат=Запрос.Выполнить();
	Запрос.Текст=
	"ВЫБРАТЬ
	|	ВложенныйЗапрос.Номенклатура,
	|	ВложенныйЗапрос.Счетчик
	|ИЗ
	|	(ВЫБРАТЬ
	|		ТаблицаНоменклатуры.Номенклатура КАК Номенклатура,
	|		СУММА(1) КАК Счетчик
	|	ИЗ
	|		ТаблицаНоменклатуры КАК ТаблицаНоменклатуры
	|	
	|	СГРУППИРОВАТЬ ПО
	|		ТаблицаНоменклатуры.Номенклатура) КАК ВложенныйЗапрос
	|ГДЕ
	|	ВложенныйЗапрос.Счетчик > 1";
	
	Результат=Запрос.Выполнить();
	
	Выборка = Результат.Выбрать();
	Дубли = Ложь;
	Пока Выборка.Следующий() Цикл
		
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = НСтр("ru='Дублируется строка: %Номенклатура%!';uk='Дублюється рядок: %Номенклатура%!'");
		Сообщение.Текст = СтрЗаменить(Сообщение.Текст, "%Номенклатура%", Выборка.Номенклатура);
		Сообщение.Сообщить();
		Дубли = Истина;
		
	КонецЦикла;
		
	Возврат Дубли;
		
КонецФункции

// Процедура рассчитывает сумму в строке табличной части.
//
&НаКлиенте
Процедура РассчитатьСуммуВСтрокеТабличнойЧасти(ИмяТабличнойЧасти, СтрокаТабличнойЧасти = Неопределено)
	
	Если СтрокаТабличнойЧасти = Неопределено Тогда
		СтрокаТабличнойЧасти = Элементы[ИмяТабличнойЧасти].ТекущиеДанные;
	КонецЕсли;
	
	СтрокаТабличнойЧасти.Сумма = СтрокаТабличнойЧасти.Количество * СтрокаТабличнойЧасти.Цена;
	РассчитатьСуммуНДС(СтрокаТабличнойЧасти);
	
КонецПроцедуры // РассчитатьСуммуВСтрокеТабличнойЧасти()

// Рассчитывается сумма НДС в строке табличной части.
//
&НаКлиенте
Процедура РассчитатьСуммуНДС(СтрокаТабличнойЧасти)
	
	НетНДС = ПолучитьСтавкуНДСДляСравнения(Объект.ВключаетНДС, СтрокаТабличнойЧасти.СтавкаНДС);
	
	Если НЕ Объект.ВключаетНДС И НетНДС = Ложь Тогда		 
		ДелительНДС = 5;	 
	Иначе
		ДелительНДС = 6;
	КонецЕсли;
	
	Если НЕ Объект.ВключаетНДС И НетНДС Тогда
		СтрокаТабличнойЧасти.СуммаНДС = 0;
	Иначе
		СтрокаТабличнойЧасти.СуммаНДС = СтрокаТабличнойЧасти.Сумма/ДелительНДС;
	КонецЕсли;
	
	СтрокаТабличнойЧасти.Всего = СтрокаТабличнойЧасти.Сумма + ?(Объект.ВключаетНДС, 0, СтрокаТабличнойЧасти.СуммаНДС);
	
КонецПроцедуры // РассчитатьСуммуНДС()

// Получает ставку НДС.
//
&НаСервере
Функция ПолучитьСтавкуНДС()
	
	Если Объект.ВключаетНДС Тогда
		Возврат Перечисления.СтавкиНДС.НДС0;
	Иначе
		Возврат Перечисления.СтавкиНДС.НДС20;
	КонецЕсли;
	
КонецФункции

// Возвращает ложь, если контрагент является плательщиком НДС 
// и в строке табличной части указана ставка НДС = 20%.
//
&НаСервере
Функция ПолучитьСтавкуНДСДляСравнения(ВключаетНДС, СтавкаНДС)
	
	Если НЕ ВключаетНДС И СтавкаНДС = Перечисления.СтавкиНДС.НДС20 Тогда
		Возврат Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли;
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ - ОБРАБОТЧИКИ СОБЫТИЙ ТАБЛИЧНОЙ ЧАСТИ ЗАПАСЫ

// Процедура - обработчик события ПриИзменении табличной части "Запасы".
//
&НаКлиенте
Процедура ЗапасыПриИзменении(Элемент)
	
	ОбновитьПодвалФормы();

КонецПроцедуры

// Процедура - обработчик события ПриИзменении поля ввода Количество.
//
&НаКлиенте
Процедура ЗапасыКоличествоПриИзменении(Элемент)
	
	РассчитатьСуммуВСтрокеТабличнойЧасти("Запасы");

КонецПроцедуры

// Процедура - обработчик события ПриИзменении поля ввода Цена.
//
&НаКлиенте
Процедура ЗапасыЦенаПриИзменении(Элемент)
	
	РассчитатьСуммуВСтрокеТабличнойЧасти("Запасы");

КонецПроцедуры

// Процедура - обработчик события ПриИзменении поля ввода Сумма.
//
&НаКлиенте
Процедура ЗапасыСуммаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Запасы.ТекущиеДанные;
	ТекущиеДанные.Цена = ТекущиеДанные.Сумма/ТекущиеДанные.Количество;
	РассчитатьСуммуНДС(ТекущиеДанные);
	ОбновитьПодвалФормы();
	
КонецПроцедуры

// Процедура - обработчик события ПриИзменении поля ввода Номенклатура.
//
&НаКлиенте
Процедура ЗапасыНоменклатураПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Запасы.ТекущиеДанные;
	
	Если НЕ ЗначениеЗаполнено(ТекущиеДанные.Цена) Тогда
	
		ТекущиеДанные.Цена = ПолучитьЦенуНаСервере(ТекущиеДанные.Номенклатура);
		РассчитатьСуммуВСтрокеТабличнойЧасти("Запасы");

	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ТекущиеДанные.СтавкаНДС) Тогда
	
		ТекущиеДанные.СтавкаНДС = ПолучитьСтавкуНДС();
		РассчитатьСуммуВСтрокеТабличнойЧасти("Запасы");

	КонецЕсли;
	
КонецПроцедуры

// Процедура - обработчик события ПриИзменении поля ввода СтавкаНДС.
