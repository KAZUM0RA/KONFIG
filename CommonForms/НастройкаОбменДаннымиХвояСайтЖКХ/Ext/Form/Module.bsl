&НаКлиенте
Процедура ОткрытьРасписаниеРегламентногоЗаданияВыполнить(Команда)
	
	СтруктураРегламентногоЗадания = ПолучитьСтруктуруРегламентноеЗаданиеОбменаССайтом();
	Диалог = Новый ДиалогРасписанияРегламентногоЗадания(СтруктураРегламентногоЗадания.Расписание);
	
	Если Диалог.ОткрытьМодально() Тогда
		
		РегламентныеЗаданияКлиент.УстановитьРасписаниеРегламентногоЗадания(
			СтруктураРегламентногоЗадания.Идентификатор,
			Диалог.Расписание);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСтруктуруРегламентноеЗаданиеОбменаССайтом()
	
	СтруктураРегламентногоЗадания = Новый Структура;
	РегламентноеЗадание = РегламентныеЗадания.НайтиПредопределенное(Метаданные.РегламентныеЗадания.ОбменДаннымиХвояСайтЖКХ);
	
	СтруктураРегламентногоЗадания.Вставить("Расписание",РегламентноеЗадание.Расписание);
	СтруктураРегламентногоЗадания.Вставить("Идентификатор",Строка(РегламентноеЗадание.УникальныйИдентификатор));
	
	Возврат СтруктураРегламентногоЗадания;
	
КонецФункции

&НаКлиенте
Процедура ОтображениеПериодаПриИзменении(Элемент)
	
	ФорматнаяСтрока = "ru = ""Л=ru;ДФ='MMMM yyyy'""; uk = ""Л=uk;ДФ='MMMM yyyy'""";
	ОтображениеПериода = Формат(ДатаНачалаВыгрузкиНаСайт, НСтр(ФорматнаяСтрока));
	ЗаписатьЗначенияТаблицаНастройки();	
	
КонецПроцедуры

&НаКлиенте
Процедура ОтображениеПериодаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	СтруктураПараметров = Новый Структура("ДатаКалендаря", ?(ДатаНачалаВыгрузкиНаСайт = Дата('00010101'), ТекущаяДата(), ДатаНачалаВыгрузкиНаСайт));
	ДатаКалендаряНачало = ОткрытьФормуМодально("ОбщаяФорма.ФормаКалендаря", СтруктураПараметров);
	
	ДатаНачалаВыгрузкиНаСайт = НачалоМесяца(ДатаКалендаряНачало);
	
	ОтображениеПериодаПриИзменении(Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтображениеПериодаРегулирование(Элемент, Направление, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ДатаНачалаВыгрузкиНаСайт = ?(ЗначениеЗаполнено(ДатаНачалаВыгрузкиНаСайт), 
						ДобавитьМесяц(ДатаНачалаВыгрузкиНаСайт, Направление),
						ДобавитьМесяц(НачалоМесяца(ТекущаяДата()), Направление));
						
	ОтображениеПериодаПриИзменении(Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтображениеПериодаОчистка(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;

	ДатаНачалаВыгрузкиНаСайт = Неопределено;
	ОтображениеПериодаПриИзменении(Элемент);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьДанныеОрганизации(Организация)
	
	EMail = "";
	Запрос = Новый Запрос;
	Запрос.Текст ="ВЫБРАТЬ
	              |	ОрганизацииКонтактнаяИнформация.Представление
	              |ИЗ
	              |	Справочник.Организации.КонтактнаяИнформация КАК ОрганизацииКонтактнаяИнформация
	              |ГДЕ
	              |	ОрганизацииКонтактнаяИнформация.Ссылка = &Организация
	              |	И ОрганизацииКонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.EmailОрганизации)
	              |;
	              |
	              |////////////////////////////////////////////////////////////////////////////////
	              |ВЫБРАТЬ
	              |	СостояниеВыгрузкиИсторииСайтЖКХ.ПериодВыгрузки
	              |ИЗ
	              |	РегистрСведений.СостояниеВыгрузкиИсторииСайтЖКХ КАК СостояниеВыгрузкиИсторииСайтЖКХ
	              |ГДЕ
	              |	СостояниеВыгрузкиИсторииСайтЖКХ.Организация = &Организация";
				  
	Запрос.УстановитьПараметр("Организация", Организация);
	
	МассивРезультатов = Запрос.ВыполнитьПакет();
	
	ЭтоНачалоВыгрузкиИстории = МассивРезультатов[1].Пустой();
	
	Результат = МассивРезультатов[0].Выбрать();
	Пока Результат.Следующий() Цикл
		Если ЗначениеЗаполнено(EMail) Тогда
			EMail = EMail + " ;";	
		КонецЕсли; 
		EMail = Результат.Представление;	
	КонецЦикла;
	
	ДанныеОрганизации = Новый Структура;
	ДанныеОрганизации.Вставить("Наименование", Организация.НаименованиеПолное);
	ДанныеОрганизации.Вставить("КодПоЕДРПОУ", Организация.КодПоЕДРПОУ);
	ДанныеОрганизации.Вставить("EMail", EMail);
	ДанныеОрганизации.Вставить("БанковскийСчетПоУмолчанию", Организация.БанковскийСчетПоУмолчанию);
	ДанныеОрганизации.Вставить("БанковскийСчетНаименование", Организация.БанковскийСчетПоУмолчанию.Наименование);
	
	ДанныеОрганизации.Вставить("ДоступностьМесяцаИстории", ЭтоНачалоВыгрузкиИстории);
	
	Возврат ДанныеОрганизации;
	
КонецФункции

&НаКлиенте
Процедура ТаблицаОрганизацииПриАктивизацииСтроки(Элемент)
	
	ФорматнаяСтрока = "ru = ""Л=ru;ДФ='MMMM yyyy'""; uk = ""Л=uk;ДФ='MMMM yyyy'""";
	
	Элемент.ТекущиеДанные.Свойство("Организация", Организация);
	
	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		ФТППароль = "";	
		ФТПЛогин = "";	
		ФТПСервер = "";	
		ФТППассивныйРежим = Истина;
		
		ДатаНачалаВыгрузкиНаСайт = '00010101';
		ФТПУдаленныйКаталог = "";	
		АдресСайта = "";	
		Если ЗначениеЗаполнено(ДатаНачалаВыгрузкиНаСайт) Тогда
			ОтображениеПериода = Формат(ДатаНачалаВыгрузкиНаСайт, НСтр(ФорматнаяСтрока));
		Иначе
			ОтображениеПериода = "";
		КонецЕсли;
		
		КоличесвоЛицевыхСчетовВПакете = 2000;	
		
		Возврат;	
	КонецЕсли;
	
	ДанныеОрганизации = ПолучитьДанныеОрганизации(Организация);
	
	Если НЕ ЗначениеЗаполнено(ДанныеОрганизации.БанковскийСчетПоУмолчанию) Тогда
		Элементы.Декорация3.Заголовок = НСтр("ru='Не выбран банковский счет организации. Оплаты не возможны. ';uk='Не встановлено банківський рахунок організації. Оплати неможливі.'");
		Элементы.Декорация3.ЦветТекста = Новый Цвет (255,0,0);
	Иначе
		Элементы.Декорация3.Заголовок = НСтр("ru='Банковский счет: ';uk='Банківський рахунок: '") + ДанныеОрганизации.БанковскийСчетНаименование;
		Элементы.Декорация3.ЦветТекста = Новый Цвет (0,0,0);
	КонецЕсли;
	
	НайденныеСтроки = ТаблицаНастройки.НайтиСтроки(Новый Структура("Организация", Организация));
	Если НайденныеСтроки.Количество() = 0 Тогда
		НоваяСтрока = ТаблицаНастройки.Добавить();
		НоваяСтрока.Организация = Организация;
		НоваяСтрока.ФТППассивныйРежим = Истина;
		ФТППассивныйРежим = Истина;
	Иначе
	
		ФТППароль = НайденныеСтроки[0].ФТППароль;	
		ФТПЛогин = НайденныеСтроки[0].ФТПЛогин;	
		ФТПСервер = НайденныеСтроки[0].ФТПСервер;	
		ФТППассивныйРежим = НайденныеСтроки[0].ФТППассивныйРежим;
		
		ДатаНачалаВыгрузкиНаСайт = НайденныеСтроки[0].ДатаНачалаВыгрузкиНаСайт;
		ФТПУдаленныйКаталог = НайденныеСтроки[0].ФТПУдаленныйКаталог;	
		АдресСайта = НайденныеСтроки[0].АдресСайта;	
		Если ЗначениеЗаполнено(ДатаНачалаВыгрузкиНаСайт) Тогда
			ОтображениеПериода = Формат(ДатаНачалаВыгрузкиНаСайт, НСтр(ФорматнаяСтрока));
		Иначе
			ОтображениеПериода = "";
		КонецЕсли;
		
		КоличесвоЛицевыхСчетовВПакете = НайденныеСтроки[0].КоличесвоЛицевыхСчетовВПакете;	
		
	КонецЕсли;
	
	Если КоличесвоЛицевыхСчетовВПакете = 0 Тогда
		КоличесвоЛицевыхСчетовВПакете = 2000;
	КонецЕсли;
	
	Элементы.ОтображениеПериода.Доступность = ДанныеОрганизации.ДоступностьМесяцаИстории;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьЗначенияТаблицаНастройки()
	
	НайденныеСтроки = ТаблицаНастройки.НайтиСтроки(Новый Структура("Организация", Организация));
	Если НЕ НайденныеСтроки.Количество() = 0 Тогда
		
		НайденныеСтроки[0].ФТППароль = ФТППароль;	
		НайденныеСтроки[0].ФТПЛогин = ФТПЛогин;	
		НайденныеСтроки[0].ФТПСервер = ФТПСервер;	
		НайденныеСтроки[0].ФТППассивныйРежим = ФТППассивныйРежим;
		НайденныеСтроки[0].ДатаНачалаВыгрузкиНаСайт = ДатаНачалаВыгрузкиНаСайт;
		НайденныеСтроки[0].ФТПУдаленныйКаталог = ФТПУдаленныйКаталог;	
		НайденныеСтроки[0].АдресСайта = АдресСайта;	
		НайденныеСтроки[0].КоличесвоЛицевыхСчетовВПакете = КоличесвоЛицевыхСчетовВПакете;	
		
	КонецЕсли;
	
КонецПроцедуры

