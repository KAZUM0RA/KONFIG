

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	 "ВЫБРАТЬ
	 |	ЗданияИСооружения.Организация
	 |ИЗ
	 |	Справочник.ЗданияИСооружения КАК ЗданияИСооружения
	 |ГДЕ
	 |	НЕ ЗданияИСооружения.ПометкаУдаления
	 |
	 |СГРУППИРОВАТЬ ПО
	 |	ЗданияИСооружения.Организация";
	 
	 ТаблицаОрганизации.Загрузить(Запрос.Выполнить().Выгрузить());
	
	СтруктураНастройки = Константы.НастройкаОбменДаннымиХвояСайтЖКХ.Получить().Получить();
	ФорматнаяСтрока = "ru = ""Л=ru;ДФ='MMMM yyyy'""; uk = ""Л=uk;ДФ='MMMM yyyy'""";
	
	Если ТипЗнч(СтруктураНастройки) = Тип("Структура") Тогда
		
		НоваяСтрока = ТаблицаНастройки.Добавить();
		
		НоваяСтрока.ФТППароль = СтруктураНастройки.Пароль;	
		НоваяСтрока.ФТПЛогин = СтруктураНастройки.Логин;	
		НоваяСтрока.ФТПСервер = СтруктураНастройки.Сервер;	
		НоваяСтрока.ФТППассивныйРежим = СтруктураНастройки.ПассивныйРежим;
		НоваяСтрока.ДатаНачалаВыгрузкиНаСайт = СтруктураНастройки.ДатаНачалаВыгрузкиНаСайт;
		НоваяСтрока.Организация = СтруктураНастройки.Организация;
		Попытка
		НоваяСтрока.ФТПУдаленныйКаталог = СтруктураНастройки.УдаленныйКаталог;	
		Исключение
		КонецПопытки;
		Попытка
		НоваяСтрока.АдресСайта = СтруктураНастройки.АдресСайта;	
		Исключение
		КонецПопытки;
		Если ЗначениеЗаполнено(НоваяСтрока.ДатаНачалаВыгрузкиНаСайт) Тогда
			ОтображениеПериода = Формат(НоваяСтрока.ДатаНачалаВыгрузкиНаСайт, НСтр(ФорматнаяСтрока));
		Иначе
			ОтображениеПериода = "";
		КонецЕсли;
		
		Попытка
		НоваяСтрока.КоличесвоЛицевыхСчетовВПакете = СтруктураНастройки.КоличесвоЛицевыхСчетовВПакете;	
		Исключение
		КонецПопытки;
		
	ИначеЕсли ТипЗнч(СтруктураНастройки) = Тип("ТаблицаЗначений") Тогда
		
	 ТаблицаНастройки.Загрузить(СтруктураНастройки);
		
	Иначе	
		ФТППассивныйРежим = Истина;
		ОтображениеПериода = "";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаПроверитьПодключениеФТП(Команда)
	
	Сервер 			= СокрЛП(ФТПСервер);
	Логин 			= СокрЛП(ФТПЛогин);
	Пароль 			= СокрЛП(ФТППароль);
	ПассивныйРежим 	= ФТППассивныйРежим;
	
	Если ПустаяСтрока(Сервер) Или ПустаяСтрока(Логин) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Указаны не все параметры соединения с FTP-сервером!';uk=""Вказані в повному обсязі параметри з'єднання з FTP-сервером!"""));	
		Возврат;
	КонецЕсли;                                            		
	Попытка
		ПодключениеКФТП = Новый FTPСоединение(Сервер, , Логин, Пароль, ,ПассивныйРежим, 60);
	Исключение		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Ошибка подключения. Причина: ';uk='Помилка підключення. Причина:'") + ОписаниеОшибки());	
		Возврат;		
	КонецПопытки; 	
	
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Подключение к FTP-серверу успешно выполнено';uk='Підключення до FTP-сервера успішно виконано'"));
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьЗакрытьНаСервере()
	
	Константы.НастройкаОбменДаннымиХвояСайтЖКХ.Установить(Новый ХранилищеЗначения(ТаблицаНастройки.Выгрузить()));
	
КонецПроцедуры

&НаСервере
Функция ПроверкаИмениФТПСервера()
	ТаблицаТМП = ТаблицаНастройки.Выгрузить();
	ТаблицаТМП.Колонки.Добавить("КвоИмен");
	ТаблицаТМП.ЗаполнитьЗначения(1,"КвоИмен");
	ТаблицаТМП.Свернуть("ФТПСервер", "КвоИмен");
	
	Для Каждого СтрокаТаблицаТМП Из ТаблицаТМП Цикл
		Если СтрокаТаблицаТМП.КвоИмен > 1 И ЗначениеЗаполнено(СтрокаТаблицаТМП.ФТПСервер) Тогда
			ОшибкаИмениСервера = НСтр("ru='Ошибка! Имя сервера ""%1%"" используется для различных организаций.';uk='Помилка! Ім''я сервера ""%1%"" використовується для різних організацій'");
			ОшибкаИмениСервера = СтрЗаменить(ОшибкаИмениСервера, "%1%", СтрокаТаблицаТМП.ФТПСервер);
			Возврат ОшибкаИмениСервера;
		КонецЕсли;
	КонецЦикла;
	
	Возврат "";
КонецФункции

&НаКлиенте
Процедура ЗаписатьЗакрыть(Команда)
	
	Для Каждого СтрокаТаблицаНастройки Из ТаблицаНастройки Цикл
		Если ЗначениеЗаполнено(СтрокаТаблицаНастройки.ДатаНачалаВыгрузкиНаСайт) И СтрокаТаблицаНастройки.ДатаНачалаВыгрузкиНаСайт >= НачалоМесяца(ТекущаяДата()) Тогда
			Предупреждение(НСтр("ru='Ошибка выбора даты выгрузки на сайт. Организация ';uk='Помилка вибору дати вивантаження на сайт. Організація '") + Строка(СтрокаТаблицаНастройки.Организвция));
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
	Ошибка = ПроверкаИмениФТПСервера();
	Если ЗначениеЗаполнено(Ошибка) Тогда
		Предупреждение(Ошибка);
		Возврат;
	КонецЕсли;
	
	ЗаписатьЗакрытьНаСервере();
	Закрыть();
	
КонецПроцедуры

