Процедура ОтправитьЗаявку(Команда)
	Если СокрЛП(Заявка.ПолучитьТекст()) = ""  Тогда
		Текст = НСтр("ru='Заявка без содержания либо картинка без сопровождения текста. Заявка обязательно должна сопровожтаться пояснительным текстом';uk=""Заявка без вмісту або картинка без супроводу тексту. Заявка обов'язково повинна сопровожтаться пояснювальним текстом""");
		Ответ = Вопрос(Текст,РежимДиалогаВопрос.ОК);
	Иначе
		Состояние(НСТР("ru = 'Выполняется отправка заявки в службу поддержки'; uk = 'Виконується відправка заявки в службу підтримки'"));
		СоздатьЗаявку();
		Элементы.ЗаявкаОтправитьЗаявку.Доступность = Ложь;
	КонецЕсли; 
КонецПроцедуры

&НаСервере
Процедура  СоздатьЗаявку()
	
	
	НовыйДокумент = Документы.Заявка.СоздатьДокумент();
	НовыйДокумент.Дата = ТекущаяДата();
	НовыйДокумент.Описание = Новый ХранилищеЗначения(Заявка);
	НовыйДокумент.Тема = "Заявка от "+Строка(Константы.ЗаголовокСистемы.Получить());
	НовыйДокумент.Важность = Перечисления.ВариантыВажностиЗадачи.Высокая;
	НовыйДокумент.СтрокаСостоянияБД = ПолучитьСтрокуСостоянияБД();
	НовыйДокумент.ИдентификаторБД = ПолучитьИдентификаторБД();
	НовыйДокумент.Автор = Пользователи.АвторизованныйПользователь();
	НовыйДокумент.Рассмотрено = Ложь;
	НовыйДокумент.Записать();
	Попытка
		//ОбменДаннымиТехПоддержка.ОбработкаКомандыСервер();
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru='Заявка отправлена';uk='Заявку відправлено'",);
		Сообщение.Поле = "";
		Сообщение.Сообщить();
	Исключение
		НовыйДокумент.Удалить();
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru='Не удалось установить подключение. Заявка не была отпрвлена';uk='Не вдалося встановити підключення. Заявка не була отпрвлена'");
		Сообщение.Сообщить(); 
	КонецПопытки;
	
КонецПроцедуры

