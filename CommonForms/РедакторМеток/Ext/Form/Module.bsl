&НаКлиенте
Процедура ПолеБраузераПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)
	
	ТекЗдание = Элементы.СписокЗданий.ТекущиеДанные.Здание;
	
	Если ТекЗдание = Неопределено Тогда
		Возврат;
	КонецЕсли;  	
		
	Документ = Элементы.ПолеБраузера.Document;
	СтрокаСКоординатами = Документ.parentWindow.name;
	СтрокаСКоординатами = СтрЗаменить(СтрокаСКоординатами, "LabelEditor_", "");
	СтрокаСКоординатами = СтрЗаменить(СтрокаСКоординатами, "_initEnd", ""); //если нажали на кнопку, а на карте отметку не делали
	 		
	МассивКоординат = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СтрокаСКоординатами, ",");
	
	Если МассивКоординат.Количество()<>2 Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.СписокЗданий.ТекущиеДанные.Широта  = МассивКоординат[0]; 
	Элементы.СписокЗданий.ТекущиеДанные.Долгота = МассивКоординат[1];
	Элементы.СписокЗданий.ТекущиеДанные.НовыеКоординатыНеЗаписаны = Истина;
	СформироватьУсловноеОформление();
	
КонецПроцедуры

