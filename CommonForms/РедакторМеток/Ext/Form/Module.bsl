&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	#Если ВебКлиент Тогда
		ТекстСкрипта = РаботаСКартамиСервер.ПолучитьТекстМакета();
	#КонецЕсли
	
	Если ТипЗнч(Параметры) = Тип("ДанныеФормыСтруктура") Тогда
		РежимРедактора = Параметры.РежимРедактора;
		Если РежимРедактора = "ДляЗаписи" Тогда 			
			ТекЗдание = Параметры.Партнер;			
			АдресЗдания = РаботаСКартамиСервер.ПолучитьАдресЗдания(ТекЗдание);
			
			НоваяСтрока 		= СписокЗданий.Добавить();
			НоваяСтрока.Здание = ТекЗдание;		
			НоваяСтрока.Адрес 	= АдресЗдания;
			НоваяСтрока.Широта  = Параметры.Широта;
			НоваяСтрока.Долгота = Параметры.Долгота;
		ИначеЕсли РежимРедактора = "ДляСписка" Тогда			
			ЗаполнитьСписокЗданий();
		КонецЕсли;
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	#Если ВебКлиент Тогда		
		Если Не ОбщегоНазначенияКлиент.РасширениеРаботыСФайламиПодключено("Для работы с редактором необходимо установить расширение работы с файлами") Тогда
			Отказ=Истина;
			Возврат;
		КонецЕсли;
	#КонецЕсли

	ОбновитьТекущийМакет();
КонецПроцедуры 

