КонецПроцедуры

&НаСервере
Процедура ПолучитьВыбранныеЛицевыеСчета(СтруктураОтбора)
	
	Запрос = Новый Запрос;
	
	Если ТипЗнч(СтруктураОтбора.Ключ) = Тип("СправочникСсылка.ЗданияИСооружения") тогда
		ТекстОтбора = "Владелец = &ЗначениеОтбора"; 	
	ИначеЕсли ТипЗнч(СтруктураОтбора.Ключ) = Тип("СправочникСсылка.Подъезды") тогда
		ТекстОтбора = "ОбъектЛицевогоСчета.Подъезд = &ЗначениеОтбора"; 	
	Иначе
		ТекстОтбора = ""; 	
	КонецЕсли;
	
	
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ОтветственныйВладелец,
		|	ВложенныйЗапрос.ЛицевойСчет,
		|	ВложенныйЗапрос.Здание,
		|	ВложенныйЗапрос.ОбъектЛицевогоСчета,
		|	ВложенныйЗапрос.Подъезд
		|ИЗ
		|	(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|		ЛицевыеСчетаСрезПоследних.ЛицевойСчет КАК ЛицевойСчет,
		|		ЛицевыеСчетаСрезПоследних.ЛицевойСчет.Владелец КАК Здание,
		|		ЛицевыеСчетаСрезПоследних.ЛицевойСчет.ОбъектЛицевогоСчета КАК ОбъектЛицевогоСчета,
		|		ЛицевыеСчетаСрезПоследних.ЛицевойСчет.ОбъектЛицевогоСчета.Подъезд КАК Подъезд
		|	ИЗ
		|		РегистрСведений.ЛицевыеСчета.СрезПоследних(
		|				&ДатаНач,
		|				Действует
		|					И ВЫБОР
		|						КОГДА &ЖилойФонд = ЗНАЧЕНИЕ(Перечисление.ЖилойНеЖилойФонд.ПустаяСсылка)
		|							ТОГДА ИСТИНА
		|						ИНАЧЕ ЛицевойСчет.ОбъектЛицевогоСчета.ЖилойФонд = &ЖилойФонд
		|					КОНЕЦ
		|					И ЛицевойСчет." + ТекстОтбора +") КАК ЛицевыеСчетаСрезПоследних
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		ЛицевыеСчета.ЛицевойСчет,
		|		ЛицевыеСчета.ЛицевойСчет.Владелец,
		|		ЛицевыеСчета.ЛицевойСчет.ОбъектЛицевогоСчета,
		|		ЛицевыеСчета.ЛицевойСчет.ОбъектЛицевогоСчета.Подъезд
		|	ИЗ
		|		РегистрСведений.ЛицевыеСчета КАК ЛицевыеСчета
		|	ГДЕ
		|		ЛицевыеСчета.Период >= &ДатаНач
		|		И ЛицевыеСчета.Период <= &ДатаКон
		|		И ЛицевыеСчета.ЛицевойСчет." + ТекстОтбора +"
		|		И ВЫБОР
		|				КОГДА &ЖилойФонд = ЗНАЧЕНИЕ(Перечисление.ЖилойНеЖилойФонд.ПустаяСсылка)
		|					ТОГДА ИСТИНА
		|				ИНАЧЕ ЛицевыеСчета.ЛицевойСчет.ОбъектЛицевогоСчета.ЖилойФонд = &ЖилойФонд
		|			КОНЕЦ) КАК ВложенныйЗапрос
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОтветственныйВладелецЛицевогоСчета.СрезПоследних КАК ОтветственныйВладелецЛицевогоСчетаСрезПоследних
		|		ПО ВложенныйЗапрос.ЛицевойСчет = ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ЛицевойСчет";
	
	
	Запрос.УстановитьПараметр("ДатаНач", ДатаНачала);
	Запрос.УстановитьПараметр("ДатаКон", ДатаОкончания);
	Запрос.УстановитьПараметр("ЗначениеОтбора", СтруктураОтбора.Ключ);
	Запрос.УстановитьПараметр("ЖилойФонд", ОтборЖилойФонд);
	
	ТаблицаЛС = Запрос.Выполнить().Выгрузить();
	Для Каждого СтрокаТаблицаЛС Из ТаблицаЛС цикл
		Если ОтборЭлекстроннаяПочта Тогда
			Если ОтборЭлектроннаяПочтаЗначение ="Заполнено" Тогда
				Если  СокрЛП(СтрокаТаблицаЛС.ЛицевойСчет.ЭлПочта) = "" Тогда
					Продолжить;
				КонецЕсли;
			Иначе
				Если  СокрЛП(СтрокаТаблицаЛС.ЛицевойСчет.ЭлПочта) <> "" Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли ОтборТелефон Тогда
			Если  СокрЛП(СтрокаТаблицаЛС.ЛицевойСчет.МобТелефон) <> "" Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;	
					
		Если ОтборТолькоДействующие и СтрокаТаблицаЛС.ОтветственныйВладелец = Справочники.ПотребителиУслуг.ПустаяСсылка() Тогда
			Продолжить;
		КонецЕсли;
		
		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить("ЛицевойСчет", СтрокаТаблицаЛС.ЛицевойСчет);
		Строки = ОтобранныеЛицевыеСчета.НайтиСтроки(СтруктураОтбора); 
		Если Строки.Количество() > 0 тогда
			ЗаполнитьЗначенияСвойств(Строки[0],СтрокаТаблицаЛС);
		Иначе
			НоваяСтрока = ОтобранныеЛицевыеСчета.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока,СтрокаТаблицаЛС);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьЛицевойСчетВОтобранные(СтрокаСпискаЛицевыхСчетов)
	
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("ЛицевойСчет", СтрокаСпискаЛицевыхСчетов.ЛицевойСчет);
	Строки = ОтобранныеЛицевыеСчета.НайтиСтроки(СтруктураОтбора);
	ОтветственныйВладелец = ПолучитьВладелца(СтрокаСпискаЛицевыхСчетов.ЛицевойСчет);
	
	Если Строки.Количество() > 0 тогда
		ЗаполнитьЗначенияСвойств(Строки[0],СтрокаСпискаЛицевыхСчетов);
		Строки[0].ОтветственныйВладелец = ОтветственныйВладелец;
	Иначе
		НоваяСтрока = ОтобранныеЛицевыеСчета.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,СтрокаСпискаЛицевыхСчетов);
		НоваяСтрока.ОтветственныйВладелец = ОтветственныйВладелец;
	КонецЕсли;
	
КонецПроцедуры


&НаСервереБезКонтекста
Функция ПолучитьВладелца(ЛицевойСчет)

		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ОтветственныйВладелец
		|ИЗ
		|	РегистрСведений.ОтветственныйВладелецЛицевогоСчета.СрезПоследних КАК ОтветственныйВладелецЛицевогоСчетаСрезПоследних
		|ГДЕ
		|	ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ЛицевойСчет = &ЛицевойСчет";
	
	Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Справочники.ПотребителиУслуг.ПустаяСсылка();
	КонецЕсли;	
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	ВыборкаДетальныеЗаписи.Следующий();
	
	Возврат ВыборкаДетальныеЗаписи.ОтветственныйВладелец;
	

КонецФункции // ()


&НаКлиенте
Процедура ЛицевыеСчетаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	СтрокаСпискаЛицевыхСчетов = Элемент.ТекущиеДанные;
	
	Если СтрокаСпискаЛицевыхСчетов.Свойство("ГруппировкаСтроки") тогда
		
		Если ТипЗнч(СтрокаСпискаЛицевыхСчетов.ГруппировкаСтроки) = Тип("СтрокаГруппировкиДинамическогоСписка") тогда
			
			СтруктураОтбора = Новый Структура;
			Если ТипЗнч(СтрокаСпискаЛицевыхСчетов.ГруппировкаСтроки.Ключ) = Тип("Строка") тогда
				СтруктураОтбора.Вставить("Ключ", СтрокаСпискаЛицевыхСчетов.РодительскаяГруппировкаСтроки.Ключ);
			Иначе
				СтруктураОтбора.Вставить("Ключ", СтрокаСпискаЛицевыхСчетов.ГруппировкаСтроки.Ключ);
			КонецЕсли;
			
			ПолучитьВыбранныеЛицевыеСчета(СтруктураОтбора);
			
		Иначе

			ДобавитьЛицевойСчетВОтобранные(СтрокаСпискаЛицевыхСчетов);	
			
		КонецЕсли;
		
	Иначе
		
		ДобавитьЛицевойСчетВОтобранные(СтрокаСпискаЛицевыхСчетов);	
		
	КонецЕсли;
	
КонецПроцедуры

