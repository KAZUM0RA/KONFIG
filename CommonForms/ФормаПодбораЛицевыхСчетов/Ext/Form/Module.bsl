&НаСервере
// Функция помещает результаты подбора в хранилище
Функция ЗаписатьПодборВХранилище() 
	
	Возврат ПоместитьВоВременноеХранилище(ОтобранныеЛицевыеСчета.Выгрузить());
	
КонецФункции

&НаКлиенте
Процедура ОК(Команда)
	
	Закрыть(ЗаписатьПодборВХранилище());
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("ДатаНачала") тогда
		ДатаНачала = Параметры.ДатаНачала;
	КонецЕсли;
	Если Параметры.Свойство("ДатаОкончания") тогда
		ДатаОкончания = Параметры.ДатаОкончания;
	КонецЕсли;
	
	Если Параметры.Свойство("ОтборОрганизация") тогда
		ОтборОрганизация = Параметры.ОтборОрганизация;
		Если ЗначениеЗаполнено(ОтборОрганизация) тогда
			Элементы.ОтборОрганизация.Доступность = Ложь;
		КонецЕсли;
	КонецЕсли;
	Если Параметры.Свойство("ОтборЗдание") тогда
		ОтборЗдание = Параметры.ОтборЗдание;
		Если ЗначениеЗаполнено(ОтборЗдание) тогда
			Элементы.ОтборЗдание.Доступность = Ложь;
		КонецЕсли;
	КонецЕсли;
	Если Параметры.Свойство("ОтборПодъезд") тогда
		ОтборПодъезд = Параметры.ОтборПодъезд;
		Если ЗначениеЗаполнено(ОтборПодъезд) тогда
			Элементы.ОтборПодъезд.Доступность = Ложь;
		КонецЕсли;
	КонецЕсли;
	Если Параметры.Свойство("ОтборЖилойФонд") тогда
		ОтборЖилойФонд = Параметры.ОтборЖилойФонд;
		Если ЗначениеЗаполнено(ОтборЖилойФонд) тогда
			Элементы.ОтборЖилойФонд.Доступность = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВложенныйЗапрос.ЛицевойСчет
	|ПОМЕСТИТЬ втЛС
	|ИЗ
	|	(ВЫБРАТЬ
	|		ЛицевыеСчета.ЛицевойСчет КАК ЛицевойСчет
	|	ИЗ
	|		РегистрСведений.ЛицевыеСчета КАК ЛицевыеСчета
	|	ГДЕ
	|		ЛицевыеСчета.Период >= &ДатаНач
	|		И ЛицевыеСчета.Период <= &ДатаКон
	|	
	|	СГРУППИРОВАТЬ ПО
	|		ЛицевыеСчета.ЛицевойСчет
	|	
	|	ОБЪЕДИНИТЬ
	|	
	|	ВЫБРАТЬ
	|		ЛицевыеСчетаСрезПоследних.ЛицевойСчет
	|	ИЗ
	|		РегистрСведений.ЛицевыеСчета.СрезПоследних(&ДатаНач, ) КАК ЛицевыеСчетаСрезПоследних
	|	ГДЕ
	|		ЛицевыеСчетаСрезПоследних.Действует) КАК ВложенныйЗапрос
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЛицевыеСчета.Ссылка КАК ЛицевойСчет
	|ИЗ
	|	Справочник.ЛицевыеСчета КАК ЛицевыеСчета
	|ГДЕ
	|	НЕ ЛицевыеСчета.Ссылка В
	|				(ВЫБРАТЬ
	|					втЛС.ЛицевойСчет
	|				ИЗ
	|					втЛС КАК втЛС)";
	
	Запрос.УстановитьПараметр("ДатаНач", ДатаНачала);
	Запрос.УстановитьПараметр("ДатаКон", ДатаОкончания);
	
	ТабЛС = Запрос.Выполнить().Выгрузить();
	МассивЛС = ТабЛС.ВыгрузитьКолонку("ЛицевойСчет");
	СпЛС.ЗагрузитьЗначения(МассивЛС);
	
	Локализация.ПриСозданииНаСервере(ЭтаФорма);
	
КонецПроцедуры

