		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	РасчетыПоЛицевымСчетам.Период,
	РасчетыПоЛицевымСчетам.ЛицевойСчет.Владелец.Котельня,
	РасчетыПоЛицевымСчетам.ЛицевойСчет.КодКОАТУУ,
	РасчетыПоЛицевымСчетам.ЛицевойСчет.Бюджет КАК Бюджет,
	РасчетыПоЛицевымСчетам.ЛицевойСчет.Другое КАК ФОП,
	РасчетыПоЛицевымСчетам.Услуга,
	РасчетыПоЛицевымСчетам.Количество КАК Количество,
	0 КАК КоличествоБюджет,
	0 КАК КоличествоФОП,
	0 КАК КоличествоНаселение,
	РасчетыПоЛицевымСчетам.ЛицевойСчет
ИЗ
	РегистрНакопления.РасчетыПоЛицевымСчетам КАК РасчетыПоЛицевымСчетам
ГДЕ
	РасчетыПоЛицевымСчетам.Услуга В ИЕРАРХИИ(&amp;Услуга)
	И РасчетыПоЛицевымСчетам.Период МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
	И РасчетыПоЛицевымСчетам.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)</query>
	</dataSet>
	<totalField>
		<dataPath>КоличествоБюджет</dataPath>
		<expression>СУММА(ВЫБОР КОГДА Бюджет = ИСТИНА ТОГДА  Количество  ИНАЧЕ  0  КОНЕЦ)</expression>
	</totalField>
	<totalField>
		<dataPath>КоличествоФОП</dataPath>
		<expression>СУММА(ВЫБОР КОГДА ФОП = ИСТИНА ТОГДА  Количество  ИНАЧЕ  0  КОНЕЦ)</expression>
	</totalField>
	<totalField>
		<dataPath>КоличествоНаселение</dataPath>
		<expression>СУММА(ВЫБОР КОГДА ФОП = ЛОЖЬ И Бюджет = ЛОЖЬ ТОГДА  Количество  ИНАЧЕ  0  КОНЕЦ)</expression>
	</totalField>
