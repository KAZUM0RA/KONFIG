&НаКлиенте
Процедура СформироватьОтчет(Команда)
	ТабличныйДокумент = Результат;
	СформироватьОтчетНаСервере(ТабличныйДокумент);
	ТабличныйДокумент.Показать();
КонецПроцедуры

&НаСервере
Функция ЛицевыеСчетаПоОплате()
	сзЛицевыеСчета = Новый СписокЗначений;
	Запрос = Новый Запрос;
	Запрос.Текст =
	    "ВЫБРАТЬ
	    |	ДенежныеСредства.Период,
	    |	ДенежныеСредства.Регистратор.ЛицевойСчет КАК ЛицевойСчет,
	    |	ДенежныеСредства.Сумма
	    |ИЗ
	    |	РегистрНакопления.ДенежныеСредства КАК ДенежныеСредства
	    |ГДЕ
	    |	ДенежныеСредства.Период МЕЖДУ &ДатаНачала И &ДатаОкончания";
	Запрос.УстановитьПараметр("ДатаНачала", Отчет.Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", Отчет.Период.ДатаОкончания);
	
	тест = Запрос.Выполнить().Выгрузить();
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		сзЛицевыеСчета.Добавить(Выборка.ЛицевойСчет);
	КонецЦикла;
	Возврат сзЛицевыеСчета;
КонецФункции;