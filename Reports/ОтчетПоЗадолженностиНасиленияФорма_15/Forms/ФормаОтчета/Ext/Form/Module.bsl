	// Виберемо оплати по АП за звітній період по Миргород
	ЗапросОплатаАП = Новый Запрос;
	ЗапросОплатаАП.Текст =
	    "ВЫБРАТЬ
		    |	СУММА(РасчетыПоЛицевымСчетам.Сумма) КАК Сумма,
