		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	РасчетыПоЛицевымСчетам.Услуга,
	МАКСИМУМ(РасчетыПоЛицевымСчетам.Услуга.ЕдиницаИзмерения) КАК ЕдиницаИзмерения,
	СУММА(ЕСТЬNULL(РасчетыПоЛицевымСчетам.Количество, 0)) КАК Количество,
	СУММА(ЕСТЬNULL(РасчетыПоЛицевымСчетам.Сумма, 0)) КАК Начислено,
	СРЕДНЕЕ(РасчетыПоЛицевымСчетам.Тариф) КАК ТарифУтв,
	ЕСТЬNULL(СтатьяЗатрат.СЗСумма, 0) КАК ВсегоЗатрат,
	РасчетыПоЛицевымСчетам.Услуга.КраткоеНаименование
ИЗ
	РегистрНакопления.РасчетыПоЛицевымСчетам КАК РасчетыПоЛицевымСчетам
		ПОЛНОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			СтатьиЗатрат.Здание КАК СЗЗдание,
			СтатьиЗатрат.Услуга КАК СЗУслуга,
			СтатьиЗатрат.СтатьяЗатрат КАК СЗСтатьяЗатрат,
			СУММА(СтатьиЗатрат.Сумма) КАК СЗСумма
		ИЗ
			РегистрНакопления.СтатьиЗатрат КАК СтатьиЗатрат
		ГДЕ
			КОНЕЦПЕРИОДА(СтатьиЗатрат.Период, МЕСЯЦ) = КОНЕЦПЕРИОДА(&amp;НачалоМесяца, МЕСЯЦ)
		
		СГРУППИРОВАТЬ ПО
			СтатьиЗатрат.СтатьяЗатрат,
			СтатьиЗатрат.Услуга,
			СтатьиЗатрат.Здание) КАК СтатьяЗатрат
		ПО РасчетыПоЛицевымСчетам.Услуга = СтатьяЗатрат.СЗУслуга
			И РасчетыПоЛицевымСчетам.ЛицевойСчет.Владелец = СтатьяЗатрат.СЗЗдание
ГДЕ
	(РасчетыПоЛицевымСчетам.ЛицевойСчет.Владелец = &amp;Дом
				И РасчетыПоЛицевымСчетам.ВидНачисления = ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Начисление)
				И НАЧАЛОПЕРИОДА(РасчетыПоЛицевымСчетам.МесяцНачисления, МЕСЯЦ) = НАЧАЛОПЕРИОДА(&amp;НачалоМесяца, МЕСЯЦ)
			ИЛИ РасчетыПоЛицевымСчетам.ВидНачисления = ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.РазовоеНачисление))

СГРУППИРОВАТЬ ПО
	РасчетыПоЛицевымСчетам.Услуга,
	ЕСТЬNULL(СтатьяЗатрат.СЗСумма, 0),
	РасчетыПоЛицевымСчетам.Услуга.КраткоеНаименование</query>
