
&НаКлиенте
Процедура Сформировать(Команда)
	СформироватьНаСервере();
КонецПроцедуры

&НаСервере
Функция СформироватьНаСервере1()
	Макет = Отчеты.ОтчетПоЗадолженностиНаселенияФорма_16.ПолучитьМакет("Макет");
	Результат.Очистить();
	// Получим количество абонентов
	Запрос = Новый Запрос;
	Запрос.Текст =
	    "ВЫБРАТЬ
	    |	ЛицевыеСчетаСрезПоследних.ЛицевойСчет
	    |ИЗ
	    |	РегистрСведений.ЛицевыеСчета.СрезПоследних(&НаДату, Действует = ИСТИНА) КАК ЛицевыеСчетаСрезПоследних";
	Запрос.УстановитьПараметр("НаДату", Новый Граница(ТекущаяДата(), ВидГраницы.Включая));
	КвоАбонентов = Запрос.Выполнить().Выгрузить();  //ОбщееКвоАбонентов = КвоАбонентов.Количество();
	
	// Получим начисления по всем лицевым счетам
	Запрос = Новый Запрос;
	Запрос.Текст = 
	    "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	    |	РасчетыПоЛицевымСчетам.ЛицевойСчет КАК ЛицевойСчет,
	    |	СУММА(РасчетыПоЛицевымСчетам.Сумма) КАК Сумма
	    |ИЗ
	    |	РегистрНакопления.РасчетыПоЛицевымСчетам КАК РасчетыПоЛицевымСчетам
	    |ГДЕ
	    |	РасчетыПоЛицевымСчетам.Активность
	    |	И РасчетыПоЛицевымСчетам.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|	И РасчетыПоЛицевымСчетам.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
		//|{ГДЕ
		//|	(РасчетыПоЛицевымСчетам.Период >= &ДатаНачала
		//|			И РасчетыПоЛицевымСчетам.Период <= &ДатаОкончания) КАК Поле2}
	    |
	    |СГРУППИРОВАТЬ ПО
	    |	РасчетыПоЛицевымСчетам.ЛицевойСчет
	    |
	    |УПОРЯДОЧИТЬ ПО
	    |	ЛицевойСчет
	    |ИТОГИ ПО
	    |	ОБЩИЕ";
	Запрос.УстановитьПараметр("ДатаНачала", Отчет.Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", Отчет.Период.ДатаОкончания);
	СуммаНачислений = Запрос.Выполнить().Выгрузить(); // ОбщийИтог = СуммаНачислений[0].Сумма
	
	//Получим оплату за выбранный период
	Запрос = Новый Запрос;
	Запрос.Текст =
	    "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	    |	СУММА(ДенежныеСредства.Сумма) КАК Сумма,
	    |	ДенежныеСредства.Регистратор.ЛицевойСчет КАК ЛицевойСчет
	    |ИЗ
	    |	РегистрНакопления.ДенежныеСредства КАК ДенежныеСредства
	    |ГДЕ
	    |	ДенежныеСредства.Активность = ИСТИНА
	    |	И ДенежныеСредства.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|	И ДенежныеСредства.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
		//|{ГДЕ
		//|	(ДенежныеСредства.Период >= &ДатаНачала
		//|			И ДенежныеСредства.Период <= &ДатаОкончания) КАК Поле2}
	    |
	    |СГРУППИРОВАТЬ ПО
	    |	ДенежныеСредства.Регистратор.ЛицевойСчет
	    |
	    |УПОРЯДОЧИТЬ ПО
	    |	ЛицевойСчет
	    |ИТОГИ ПО
	    |	ОБЩИЕ";
	Запрос.УстановитьПараметр("ДатаНачала", Отчет.Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", Отчет.Период.ДатаОкончания);
	СуммаОплат = Запрос.Выполнить().Выгрузить(); // ОбщийИтогОплата = СуммаОплат[0].Сумма
	
	// Получим оплату по субсидиям
	Запрос = Новый Запрос;
	Запрос.Текст =
	    "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	    |	СУММА(ДенежныеСредства.Сумма) КАК Сумма,
	    |	ДенежныеСредства.Регистратор.ЛицевойСчет КАК ЛицевойСчет
	    |ИЗ
	    |	РегистрНакопления.ДенежныеСредства КАК ДенежныеСредства
	    |ГДЕ
	    |	ДенежныеСредства.Активность = ИСТИНА
	    |	И ДенежныеСредства.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	    |	И ДенежныеСредства.БанковскийСчетКасса = &БанковскийСчетКасса
		|	И ДенежныеСредства.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
		//|{ГДЕ
		//|	(ДенежныеСредства.Период >= &ДатаНачала
		//|			И ДенежныеСредства.Период <= &ДатаОкончания) КАК Поле2}
	    |
	    |СГРУППИРОВАТЬ ПО
	    |	ДенежныеСредства.Регистратор.ЛицевойСчет
	    |
	    |УПОРЯДОЧИТЬ ПО
	    |	ЛицевойСчет
	    |ИТОГИ ПО
	    |	ОБЩИЕ";
	Запрос.УстановитьПараметр("ДатаНачала", Отчет.Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", Отчет.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("БанковскийСчетКасса", Справочники.БанковскиеСчета.НайтиПоНаименованию("Ощад субсидії"));
	СуммаОплатСубсидии = Запрос.Выполнить().Выгрузить(); // ОбщийИтогОплатаСубсидии = СуммаОплат[0].Сумма
	ЛССубсидии = СуммаОплатСубсидии.ВыгрузитьКолонку("ЛицевойСчет");  // КвоАбонентовСубсидии = ЛС.Количество();
	Если ЛССубсидии.Количество() <> 0 Тогда
	    ЛССубсидии.Удалить(0);
	КонецЕсли;
	// Получим начисления по субсидиям
	СуммаНачисленийСубсидии = 0;
	Для Каждого стр Из ЛССубсидии Цикл
		Запрос = Новый Запрос;
		Запрос.Текст = 
		    "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		    |	РасчетыПоЛицевымСчетам.ЛицевойСчет КАК ЛицевойСчет,
		    |	РасчетыПоЛицевымСчетам.Сумма КАК Сумма
		    |ИЗ
		    |	РегистрНакопления.РасчетыПоЛицевымСчетам КАК РасчетыПоЛицевымСчетам
		    |ГДЕ
		    |	РасчетыПоЛицевымСчетам.Активность
		    |	И РасчетыПоЛицевымСчетам.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		    |	И РасчетыПоЛицевымСчетам.ЛицевойСчет = &ЛицевойСчет
			|	И РасчетыПоЛицевымСчетам.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
			//|{ГДЕ
			//|	(РасчетыПоЛицевымСчетам.Период >= &ДатаНачала
			//|			И РасчетыПоЛицевымСчетам.Период <= &ДатаОкончания) КАК Поле2}
		    |
		    |УПОРЯДОЧИТЬ ПО
		    |	ЛицевойСчет";
		Запрос.УстановитьПараметр("ДатаНачала", Отчет.Период.ДатаНачала);
		Запрос.УстановитьПараметр("ДатаОкончания", Отчет.Период.ДатаОкончания);
		Запрос.УстановитьПараметр("ЛицевойСчет", стр.Ссылка);
		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			СуммаНачисленийСубсидии = СуммаНачисленийСубсидии + Выборка.Сумма;
		КонецЦикла;	
	КонецЦикла;
	
	// Получим оплату по льготам
	Запрос = Новый Запрос;
	Запрос.Текст =
	    "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	    |	СУММА(ДенежныеСредства.Сумма) КАК Сумма,
	    |	ДенежныеСредства.Регистратор.ЛицевойСчет КАК ЛицевойСчет
	    |ИЗ
	    |	РегистрНакопления.ДенежныеСредства КАК ДенежныеСредства
	    |ГДЕ
	    |	ДенежныеСредства.Активность = ИСТИНА
	    |	И ДенежныеСредства.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	    |	И ДенежныеСредства.БанковскийСчетКасса = &БанковскийСчетКасса
		|	И ДенежныеСредства.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
		//|{ГДЕ
		//|	(ДенежныеСредства.Период >= &ДатаНачала
		//|			И ДенежныеСредства.Период <= &ДатаОкончания) КАК Поле2}
	    |
	    |СГРУППИРОВАТЬ ПО
	    |	ДенежныеСредства.Регистратор.ЛицевойСчет	    
		|
	    |УПОРЯДОЧИТЬ ПО
	    |	ЛицевойСчет
	    |ИТОГИ ПО
	    |	ОБЩИЕ";
	Запрос.УстановитьПараметр("ДатаНачала", Отчет.Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", Отчет.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("БанковскийСчетКасса", Справочники.БанковскиеСчета.НайтиПоНаименованию("Ощад пільги"));
	СуммаОплатЛьготы = Запрос.Выполнить().Выгрузить(); // ОбщийИтогОплатаЛьготы = СуммаОплат[0].Сумма
	ЛСЛьготы = СуммаОплатЛьготы.ВыгрузитьКолонку("ЛицевойСчет");  // КвоАбонентовЛьготы = ЛС.Количество();
	ЛСЛьготы.Удалить(0);
	// Получим начисления по льготам
	СуммаНачисленийЛьготы = 0;
	Для Каждого стр Из ЛСЛьготы Цикл
		Запрос = Новый Запрос;
		Запрос.Текст = 
		    "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		    |	РасчетыПоЛицевымСчетам.ЛицевойСчет КАК ЛицевойСчет,
		    |	РасчетыПоЛицевымСчетам.Сумма КАК Сумма
		    |ИЗ
		    |	РегистрНакопления.РасчетыПоЛицевымСчетам КАК РасчетыПоЛицевымСчетам
		    |ГДЕ
		    |	РасчетыПоЛицевымСчетам.Активность
		    |	И РасчетыПоЛицевымСчетам.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		    |	И РасчетыПоЛицевымСчетам.ЛицевойСчет = &ЛицевойСчет
		    |	И РасчетыПоЛицевымСчетам.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
			//|{ГДЕ
			//|	(РасчетыПоЛицевымСчетам.Период >= &ДатаНачала
			//|			И РасчетыПоЛицевымСчетам.Период <= &ДатаОкончания) КАК Поле2}
		    |
		    |УПОРЯДОЧИТЬ ПО
		    |	ЛицевойСчет";
		Запрос.УстановитьПараметр("ДатаНачала", Отчет.Период.ДатаНачала);
		Запрос.УстановитьПараметр("ДатаОкончания", Отчет.Период.ДатаОкончания);
		Запрос.УстановитьПараметр("ЛицевойСчет", стр.Ссылка);
		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			СуммаНачисленийЛьготы = СуммаНачисленийЛьготы + Выборка.Сумма;
		КонецЦикла;	
	КонецЦикла;
	
	// Заполним табличный документ
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьШапка.Параметры.Период = Отчет.Период;
	Результат.Вывести(ОбластьШапка);
	
	ОбластьШапкаТаблицы = Макет.ПолучитьОбласть("ШапкаТаблицы");
	Результат.Вывести(ОбластьШапкаТаблицы);
	
    ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
	ОбластьСтрока.Параметры.ПорядковыйНомер = 1;
	ОбластьСтрока.Параметры.Организация = Отчет.Организация;
	ОбластьСтрока.Параметры.КвоАбонентов = КвоАбонентов.Количество() / 1000;
	ОбластьСтрока.Параметры.НачисленоВсего = СуммаНачислений[0].Сумма / 1000;
	ОбластьСтрока.Параметры.ОплаченоВсего = СуммаОплат[0].Сумма / 1000;
	ОбластьСтрока.Параметры.ПроценОплатыВсего = ((СуммаОплат[0].Сумма / СуммаНачислений[0].Сумма) * 100);
	ОбластьСтрока.Параметры.ЗадолженостьВсего = (СуммаНачислений[0].Сумма - СуммаОплат[0].Сумма) / 1000;
	ОбластьСтрока.Параметры.КвоАбонентовСубсидии = ЛССубсидии.Количество() / 1000;
	Если СуммаОплатСубсидии.Количество() <> 0 Тогда
	    ОбластьСтрока.Параметры.ОплаченоСубсидии = СуммаОплатСубсидии[0].Сумма / 1000;
		ОбластьСтрока.Параметры.НачисленоСубсидии = СуммаНачисленийСубсидии / 1000;
		ОбластьСтрока.Параметры.ПроценОплатыСубсидии = ((СуммаОплатСубсидии[0].Сумма / СуммаНачисленийСубсидии)*100);
		ОбластьСтрока.Параметры.ЗадолженостьСубсидии = (СуммаНачисленийСубсидии - СуммаОплатСубсидии[0].Сумма) / 1000;
	Иначе 
		ОбластьСтрока.Параметры.ОплаченоСубсидии = 0;
	КонецЕсли;
	
	ОбластьСтрока.Параметры.КвоАбонентовЛьготы = ЛСЛьготы.Количество() / 1000;
	ОбластьСтрока.Параметры.НачисленоЛьготы = СуммаНачисленийЛьготы / 1000;
	ОбластьСтрока.Параметры.ОплаченоЛьготы = СуммаОплатЛьготы[0].Сумма / 1000;
	ОбластьСтрока.Параметры.ПроценОплатыЛьготы = ((СуммаОплатЛьготы[0].Сумма / СуммаНачисленийЛьготы) * 100);
	ОбластьСтрока.Параметры.ЗадолженостьЛьготы = (СуммаНачисленийЛьготы - СуммаОплатЛьготы[0].Сумма) / 1000;
	Результат.Вывести(ОбластьСтрока);
	
	ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
	Результат.Вывести(ОбластьПодвал);
КонецФункции

