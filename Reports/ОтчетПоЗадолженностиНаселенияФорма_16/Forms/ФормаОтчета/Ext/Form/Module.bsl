		    |	И РасчетыПоЛицевымСчетам.ЛицевойСчет В (&ЛицевойСчет)
		    |
		    |СГРУППИРОВАТЬ ПО
		    |	РасчетыПоЛицевымСчетам.ЛицевойСчет
		    |
		    |УПОРЯДОЧИТЬ ПО
		    |	РасчетыПоЛицевымСчетам.ЛицевойСчет
		    |АВТОУПОРЯДОЧИВАНИЕ";
	ЗапросОплатаАПБагачка.УстановитьПараметр("НачалоПериода", НачалоМесяца(Отчет.Период.ДатаНачала));
	ЗапросОплатаАПБагачка.УстановитьПараметр("КонецПериода", КонецМесяца(Отчет.Период.ДатаОкончания));
	ЗапросОплатаАПБагачка.УстановитьПараметр("ЛицевойСчет", спАбонентовБагачка);
	ЗапросОплатаАПБагачка.УстановитьПараметр("Услуга", спУслугАП);
	РезультатНачисления = ЗапросОплатаАПБагачка.Выполнить().Выгрузить();
	НовСтрокаБагачка.ОплаченоАПЗаПериод = РезультатНачисления.Итог("Сумма") / 1000;
	
	// Борг по АП на кінець звітного періоду
	НовСтрокаМиргород.ДолгАПНаКонецПериода = НовСтрокаМиргород.ДолгАПНаНачалоПериода - НовСтрокаМиргород.ОплаченоАПЗаПериод;
	НовСтрокаБагачка.ДолгАПНаКонецПериода = НовСтрокаБагачка.ДолгАПНаНачалоПериода - НовСтрокаБагачка.ОплаченоАПЗаПериод;
	
	// Заполним табличный документ
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьШапка.Параметры.Период = Отчет.Период;
	Результат.Вывести(ОбластьШапка);
	
	ОбластьШапкаТаблицы = Макет.ПолучитьОбласть("ШапкаТаблицы");
	Результат.Вывести(ОбластьШапкаТаблицы);
	
	ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
	ОбластьСтрока.Параметры.ПорядковыйНомер = 1;
	ОбластьСтрока.Параметры.Организация                       = Справочники.Организации.НайтиПоКоду("000000001");
	ОбластьСтрока.Параметры.НаселенныйПункт                   = "Миргород";
	ОбластьСтрока.Параметры.ОКПП                              = "45136285";
	ОбластьСтрока.Параметры.КвоАбонентовВода                  = тзМиргород[0].КвоАбонентовХВ;
	ОбластьСтрока.Параметры.КвоАбонентовСтоки                 = тзМиргород[0].КвоАбонентовСтоки;
	ОбластьСтрока.Параметры.КвоАбонентовАбонОслуж             = тзМиргород[0].КвоАбонентовАбонОслуж;
	ОбластьСтрока.Параметры.КвоАбонентовСДолгомБольше3Месяцев = тзМиргород[0].КвоАбонентовДолгБольше3Месяцев;
	ОбластьСтрока.Параметры.ДолгНаНачалоПериода               = тзМиргород[0].ДолгТЕиГВНаНачалоПериода;
	ОбластьСтрока.Параметры.НачисленоТЕиГВЗаПериод            = тзМиргород[0].НачисленоТЕиГВЗаПериод;
	ОбластьСтрока.Параметры.ОплаченоТЕиГВЗаПериод             = тзМиргород[0].ОплаченоТЕиГВЗаПериод;
	ОбластьСтрока.Параметры.ДолгЗаТЕиГВНаКонецПериод          = тзМиргород[0].ДолгЗаТЕиГВНаКонецПериод;
	ОбластьСтрока.Параметры.АбонплатаЗадолженностьНаНачало    = тзМиргород[0].ДолгАПНаНачалоПериода;
	ОбластьСтрока.Параметры.АбонплатаНачислено                = тзМиргород[0].НачисленоАПЗаПериод;
	ОбластьСтрока.Параметры.АбонПлатаОплачено                 = тзМиргород[0].ОплаченоАПЗаПериод;
	ОбластьСтрока.Параметры.АбонплатаЗадолженостьКонец        = тзМиргород[0].ДолгАПНаКонецПериода;
	Результат.Вывести(ОбластьСтрока);
	
	ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
	ОбластьСтрока.Параметры.ПорядковыйНомер = 2;
	ОбластьСтрока.Параметры.Организация                       = Справочники.Организации.НайтиПоКоду("000000001");
	ОбластьСтрока.Параметры.НаселенныйПункт                   = "смт.Велика Багачка";
	ОбластьСтрока.Параметры.ОКПП                              = "45136285";
	ОбластьСтрока.Параметры.КвоАбонентовВода                  = тзБагачка[0].КвоАбонентовХВ;
	ОбластьСтрока.Параметры.КвоАбонентовСтоки                 = тзБагачка[0].КвоАбонентовСтоки;
	ОбластьСтрока.Параметры.КвоАбонентовАбонОслуж             = тзБагачка[0].КвоАбонентовАбонОслуж;
	ОбластьСтрока.Параметры.КвоАбонентовСДолгомБольше3Месяцев = тзБагачка[0].КвоАбонентовДолгБольше3Месяцев;
	ОбластьСтрока.Параметры.ДолгНаНачалоПериода               = тзБагачка[0].ДолгТЕиГВНаНачалоПериода;
	ОбластьСтрока.Параметры.НачисленоТЕиГВЗаПериод            = тзБагачка[0].НачисленоТЕиГВЗаПериод;
	ОбластьСтрока.Параметры.ОплаченоТЕиГВЗаПериод             = тзБагачка[0].ОплаченоТЕиГВЗаПериод;
	ОбластьСтрока.Параметры.ДолгЗаТЕиГВНаКонецПериод          = тзБагачка[0].ДолгЗаТЕиГВНаКонецПериод;
	ОбластьСтрока.Параметры.АбонплатаЗадолженностьНаНачало    = тзБагачка[0].ДолгАПНаНачалоПериода;
	ОбластьСтрока.Параметры.АбонплатаНачислено                = тзБагачка[0].НачисленоАПЗаПериод;
	ОбластьСтрока.Параметры.АбонПлатаОплачено                 = тзБагачка[0].ОплаченоАПЗаПериод;
	ОбластьСтрока.Параметры.АбонплатаЗадолженостьКонец        = тзБагачка[0].ДолгАПНаКонецПериода;
	Результат.Вывести(ОбластьСтрока);
	
	ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
	Результат.Вывести(ОбластьПодвал);
	
КонецПроцедуры

&НаСервере
Функция НачислениеАбонПлаты()
	спУслуга = Новый СписокЗначений;
	спУслуга.Добавить(Справочники.Услуги.НайтиПоКоду("Р00000183"));
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	    "ВЫБРАТЬ
	    |	РасчетыПоЛицевымСчетам.Сумма
	    |ИЗ
	    |	РегистрНакопления.РасчетыПоЛицевымСчетам КАК РасчетыПоЛицевымСчетам
	    |ГДЕ
	    |	РасчетыПоЛицевымСчетам.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	    |	И РасчетыПоЛицевымСчетам.Услуга В(&Услуга)
	    |	И РасчетыПоЛицевымСчетам.Период МЕЖДУ &ДатаНачала И &ДатаОкончания"; 
	Запрос.УстановитьПараметр("Услуга", спУслуга);
	Запрос.УстановитьПараметр("ДатаНачала", Отчет.Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", Отчет.Период.ДатаОкончания);
	Результат = Запрос.Выполнить().Выгрузить();
	Возврат Результат;
КонецФункции