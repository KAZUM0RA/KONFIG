			<dataPath>Недоплата</dataPath>
			<field>Недоплата</field>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	План.ЛицевойСчет КАК ЛицевойСчет,
	План.Период КАК Месяц,
	План.СуммаПлатежа КАК План,
	ЕСТЬNULL(Факт.СуммаРасход, 0) КАК Факт,
	План.СуммаПлатежа - ЕСТЬNULL(Факт.СуммаРасход, 0) КАК Недоплата
ИЗ
	РегистрСведений.ПлатежиПоРеструктуризацииДолга КАК План
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.РасчетыПоЛицевымСчетам.Обороты(&amp;ДатаНачала, &amp;ДатаОкончания, Месяц, Услуга = ЗНАЧЕНИЕ(Справочник.Услуги.РеструктуризацияДолга)) КАК Факт
		ПО План.ЛицевойСчет = Факт.ЛицевойСчет
			И План.Период = КОНЕЦПЕРИОДА(Факт.Период, МЕСЯЦ)
ГДЕ
	План.Период МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания</query>
	</dataSet>
