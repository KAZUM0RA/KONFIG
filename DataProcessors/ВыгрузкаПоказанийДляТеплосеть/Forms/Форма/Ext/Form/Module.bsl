&НаСервере
Процедура ПолучитьПриборыУчета()
	тзДанные = Новый ТаблицаЗначений;
	тзДанные.Колонки.Добавить("ЛицевойСчет",     Новый ОписаниеТипов("СправочникСсылка.ЛицевыеСчета"), "ЛицевойСчет");
	тзДанные.Колонки.Добавить("НомерПрибора",    Новый ОписаниеТипов("Число"), "НомерПрибора");
	тзДанные.Колонки.Добавить("Адрес",           Новый ОписаниеТипов("СправочникСсылка.ЗданияИСооружения"), "Адрес");
	тзДанные.Колонки.Добавить("ТелеФон",         Новый ОписаниеТипов("Строка"), "Телефон");
	тзДанные.Колонки.Добавить("Квартира",        Новый ОписаниеТипов("СправочникСсылка.ОбъектыЛицевыхСчетов"), "Квартира");
	тзДанные.Колонки.Добавить("ФИО",             Новый ОписаниеТипов("СправочникСсылка.ПотребителиУслуг"), "ФИО");
	тзДанные.Колонки.Добавить("Показания",       Новый ОписаниеТипов("Число"), "Показания");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	    "ВЫБРАТЬ
	    |	УстановленныеПриборыУчетаСрезПоследних.ПриборУчета.ЗаводскойНомер КАК НомерПрибора,
	    |	УстановленныеПриборыУчетаСрезПоследних.ОбъектУстановки КАК ЛицевойСчет,
	    |	УстановленныеПриборыУчетаСрезПоследних.ОбъектУстановки.Владелец КАК Адрес,
	    |	УстановленныеПриборыУчетаСрезПоследних.ОбъектУстановки.ОбъектЛицевогоСчета КАК Квартира,
	    |	ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ОтветственныйВладелец КАК ФИО,
	    |	ПоказанияПриборовУчетаСрезПоследних.Значение КАК Показания,
	    |	УстановленныеПриборыУчетаСрезПоследних.ОбъектУстановки.МобТелефон КАК Телефон
	    |ИЗ
	    |	РегистрСведений.УстановленныеПриборыУчета.СрезПоследних(
	    |			&НаДату,
	    |			ПриборУчета.Услуга.ВидУслуги = &ВидУслуги
	    |				И Действует = ИСТИНА) КАК УстановленныеПриборыУчетаСрезПоследних
	    |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПоказанияПриборовУчета.СрезПоследних(&НаДату, ) КАК ПоказанияПриборовУчетаСрезПоследних
	    |		ПО УстановленныеПриборыУчетаСрезПоследних.ПриборУчета = ПоказанияПриборовУчетаСрезПоследних.ПриборУчета
	    |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОтветственныйВладелецЛицевогоСчета.СрезПоследних(&НаДату, ) КАК ОтветственныйВладелецЛицевогоСчетаСрезПоследних
	    |		ПО УстановленныеПриборыУчетаСрезПоследних.ОбъектУстановки = ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ЛицевойСчет";
	Запрос.УстановитьПараметр("НаДату", Объект.ПериодВыгрузки.ДатаНачала);
	Запрос.УстановитьПараметр("ВидУслуги", Справочники.ВидыУслуг.Водоотведение);
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий()Цикл
		НовСтрока = тзДанные.Добавить();
		НовСтрока.ЛицевойСчет = Выборка.ЛицевойСчет;
		НовСтрока.НомерПрибора = (СтрЗаменить(Строка(Выборка.НомерПрибора), Символы.НПП, ""));
		НовСтрока.Адрес = Выборка.Адрес;
		НовСтрока.ТелеФон = Выборка.ТелеФон;
		НовСтрока.Квартира = Выборка.Квартира;
		НовСтрока.ФИО = Выборка.ФИО;
		НовСтрока.Показания = Выборка.Показания;
	КонецЦикла;
	
	тзДанные.Колонки.Добавить("КвоКубов", Новый ОписаниеТипов("Число"), "КвоКубов");
	тзДанные.Колонки.Добавить("ПоказанияНачальные", Новый ОписаниеТипов("Число"), "ПоказанияНачальные");
	
	Для Каждого стр Из тзДанные Цикл
		Запрос = Новый Запрос;
		Запрос.Текст = 
		    "ВЫБРАТЬ
		    |	РасчетПоказанийПриборовУчета.Значение КАК Количество
		    |ИЗ
		    |	РегистрНакопления.РасчетПоказанийПриборовУчета КАК РасчетПоказанийПриборовУчета
		    |ГДЕ
		    |	РасчетПоказанийПриборовУчета.Период МЕЖДУ &НачПериода И &КонПериода
		    |	И РасчетПоказанийПриборовУчета.Услуга = &Услуга
		    |	И РасчетПоказанийПриборовУчета.ВидДвижения = &ВидДвижения
		    |	И РасчетПоказанийПриборовУчета.ОбъектУстановки = &ЛицевойСчет";
		Запрос.УстановитьПараметр("ЛицевойСчет", стр.ЛицевойСчет);
		Запрос.УстановитьПараметр("Услуга", Справочники.Услуги.НайтиПоКоду("000000020"));
		Запрос.УстановитьПараметр("НачПериода", Объект.ПериодВыгрузки.ДатаНачала);
		Запрос.УстановитьПараметр("КонПериода", КонецДня(Объект.ПериодВыгрузки.ДатаОкончания));
		Запрос.УстановитьПараметр("ВидДвижения", ВидДвиженияНакопления.Приход);
		Результат = Запрос.Выполнить().Выгрузить();
		Если Результат.Количество() <> 0 Тогда
			стр.КвоКубов = Результат[0].Количество;
			стр.ПоказанияНачальные = стр.Показания - стр.КвоКубов;
		Иначе
			стр.ПоказанияНачальные = стр.Показания;
		КонецЕсли;
		
		НовСтр = Объект.ТабличнаяЧасть.Добавить();
		НовСтр.NO_OS = Строка(стр.ЛицевойСчет);
		НовСтр.FIO   = Строка(стр.ФИО);
		НовСтр.ADRES = Строка(стр.Адрес) + " " + Строка(стр.Квартира);
		НовСтр.TELEFON = Строка(стр.Телефон);
		НовСтр.NOM_LICH = (СтрЗаменить(Строка(стр.НомерПрибора), Символы.НПП, ""));
		НовСтр.BEGMETRDAT = Объект.ПериодВыгрузки.ДатаНачала;
		НовСтр.ENDMETRDAT = Объект.ПериодВыгрузки.ДатаОкончания;
		НовСтр.BEGINMETR  = стр.ПоказанияНачальные;
		НовСтр.ENDMETR    = стр.Показания;
	КонецЦикла;
КонецПроцедуры