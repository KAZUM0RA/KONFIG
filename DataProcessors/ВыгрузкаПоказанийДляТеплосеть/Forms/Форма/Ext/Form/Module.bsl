&НаКлиенте
Процедура ФайлDBFНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ДиалогВыбораФайла.Фильтр                      = НСтр("ru='Файл XBase (*.dbf)|*.dbf'");
	ДиалогВыбораФайла.Заголовок                   = Заголовок;
	ДиалогВыбораФайла.ПредварительныйПросмотр     = Ложь;
	ДиалогВыбораФайла.Расширение                  = "dbf";
	ДиалогВыбораФайла.ИндексФильтра               = 0;
	ДиалогВыбораФайла.ПроверятьСуществованиеФайла = Ложь;
	
	Если ДиалогВыбораФайла.Выбрать() Тогда
	    Объект.ФайлDBF = ДиалогВыбораФайла.ПолноеИмяФайла;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьВDBF(Команда)
	Файл = Новый XBase;
	Файл.Кодировка = КодировкаXBase.OEM;
	Файл.поля.Добавить("NO_OS","C",7,0);
	Файл.поля.Добавить("FIO","C",30,0);
	Файл.поля.Добавить("ADRES","C",100,0);
	Файл.поля.Добавить("TELEFON","C",20,0);
	Файл.поля.Добавить("NOM_LICH","C",20,0);
	Файл.поля.Добавить("BEGMETRDAT","D",8,0);
	Файл.поля.Добавить("ENDMETRDAT","D",8,0);
	Файл.поля.Добавить("BEGINMETR","N",12,0);
	Файл.поля.Добавить("ENDMETR","N",12,0);
	ПолучитьПриборыУчета();
	
	Если НЕ ЗначениеЗаполнено(Объект.ФайлDBF) Тогда
		Предупреждение("Не вказано файл для зберігання. Вкажіть ім'я файлу.");
		Возврат;
	КонецЕсли;
	Попытка
		Файл.СоздатьФайл(Объект.ФайлDBF);
	Исключение
		Предупреждение("Помилка створення файлу " + Файл);
		Возврат;
	КонецПопытки;

	Для Каждого стр Из Объект.ТабличнаяЧасть Цикл
		Файл.Добавить();
		Файл.NO_OS      = Строка(стр.NO_OS);
		Файл.FIO        = Строка(стр.FIO);
		Файл.ADRES      = Строка(стр.ADRES);
		Файл.TELEFON    = Строка(стр.TELEFON);
		Файл.NOM_LICH   = (СтрЗаменить(Строка(стр.NOM_LICH), Символы.НПП, ""));
		Файл.BEGMETRDAT = Объект.ПериодВыгрузки.ДатаНачала;
		Файл.ENDMETRDAT = Объект.ПериодВыгрузки.ДатаОкончания;
		Файл.BEGINMETR  = Число(стр.BEGINMETR);
		Файл.ENDMETR    = Число(стр.ENDMETR);
		Файл.Записать();
	КонецЦикла;
	Файл.ЗакрытьФайл();
	Предупреждение("Файл " + Файл + " успішно створений.");
КонецПроцедуры



