					Запрос.УстановитьПараметр("КонПериода", КонецМесяца(Объект.Период.ДатаОкончания));
					РезультатПоказания = Запрос.Выполнить().Выбрать();
					Пока РезультатПоказания.Следующий() Цикл
						НоваяСтрока.POKBEG5    = РезультатПоказания.ПоказаниеПредыдущее;
					КонецЦикла;
				КонецЕсли;
			КонецЕсли;	
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

