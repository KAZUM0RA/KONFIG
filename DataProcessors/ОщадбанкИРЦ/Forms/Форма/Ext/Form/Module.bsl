&НаСервере
Функция ЛицевыеСчета()
	Запрос = Новый Запрос;
	Запрос.Текст =
	   "ВЫБРАТЬ
	   |	ЛицевыеСчетаСрезПоследних.ЛицевойСчет КАК ЛС,
	   |	ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ОтветственныйВладелец.ФизЛицо КАК АдресФИО
	   |ИЗ
	   |	РегистрСведений.ЛицевыеСчета.СрезПоследних(
	   |			&НаДату,
	   |			Действует = ИСТИНА
	   |				И Активность = ИСТИНА) КАК ЛицевыеСчетаСрезПоследних
	   |		ПОЛНОЕ СОЕДИНЕНИЕ РегистрСведений.ОтветственныйВладелецЛицевогоСчета.СрезПоследних КАК ОтветственныйВладелецЛицевогоСчетаСрезПоследних
	   |		ПО ЛицевыеСчетаСрезПоследних.ЛицевойСчет = ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ЛицевойСчет";
	Запрос.УстановитьПараметр("НаДату", Объект.Период.ДатаНачала);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	тзЛС = Новый ТаблицаЗначений;
	тзЛС.Колонки.Добавить("ЛС");
	тзЛС.Колонки.Добавить("АдресФИО");
	Пока Выборка.Следующий() Цикл
		новСтр = тзЛС.Добавить();
		новСтр.ЛС = Выборка.ЛС;
		новСтр.АдресФИО = Выборка.АдресФИО;
	КонецЦикла;
	Возврат тзЛС;
КонецФункции

&НаСервере
Функция ПолучтьАдресДляИнформирования(АдресФИО)
	Адрес = УправлениеКонтактнойИнформацией.ПолучитьКонтактнуюИнформацияОбъекта(АдресФИО, Справочники.ВидыКонтактнойИнформации.АдресДляИнформированияФизЛица);
	НаименованиеВида = Справочники.ВидыКонтактнойИнформации.АдресДляИнформированияФизЛица.Наименование;
	спПараметры = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(Адрес, ",");
	_Данные = Новый Структура;
	
	Попытка
		Если спПараметры.Количество() = 7 Тогда
		    _Данные.Вставить("Город", спПараметры[4]);
		Иначе
			_Данные.Вставить("Город", спПараметры[3]);
		КонецЕсли;
		_Данные.Вставить("Улица", спПараметры[2]);
		_Данные.Вставить("Дом",спПараметры[1]);
		_Данные.Вставить("Квартира", спПараметры[0]);
	Исключение
	КонецПопытки;
	Возврат _Данные;
КонецФункции

&НаСервере
Функция ПолучитьПриборыЛС(ЛС)
	Запрос = Новый Запрос;
	Запрос.Текст =
	    "ВЫБРАТЬ
	    |	ПоказанияПриборовЗаМесяцСрезПоследних.ПоказаниеПредыдущее,
	    |	ПоказанияПриборовЗаМесяцСрезПоследних.Показание,
	    |	ПоказанияПриборовЗаМесяцСрезПоследних.ПриборУчета.ЗаводскойНомер КАК ЗаводскойНомер,
	    |	ПоказанияПриборовЗаМесяцСрезПоследних.Период
	    |ИЗ
	    |	РегистрСведений.ПоказанияПриборовЗаМесяц.СрезПоследних(
	    |			&НаДату,
	    |			ЛицевойСчет = &ЛицевойСчет
	    |				И ПриборУчета.Услуга.ВидУслуги = &ВидУслуги) КАК ПоказанияПриборовЗаМесяцСрезПоследних";
	Запрос.УстановитьПараметр("НаДату", ТекущаяДата());
	Запрос.УстановитьПараметр("ВидУслуги", Справочники.ВидыУслуг.ХолоднаяВода);
	Запрос.УстановитьПараметр("ЛицевойСчет", ЛС);
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	Приборы = Новый Структура;
	кол = 1;
	Для Каждого стр Из РезультатЗапроса Цикл
		Если кол = 1 Тогда
			Приборы.Вставить("Прибор1", стр.ЗаводскойНомер);
			Приборы.Вставить("ПоказаниеПредыдущее1", стр.ПоказаниеПредыдущее);
			Приборы.Вставить("ПоказаниеТекущее1", стр.Показание);
			кол = кол + 1;
		ИначеЕсли кол = 2 Тогда
			Приборы.Вставить("Прибор2", стр.ЗаводскойНомер);
			Приборы.Вставить("ПоказаниеПредыдущее2", стр.ПоказаниеПредыдущее);
			Приборы.Вставить("ПоказаниеТекущее2", стр.Показание);
			кол = кол + 1;
		ИначеЕсли кол = 3 Тогда
			Приборы.Вставить("Прибор3", стр.ЗаводскойНомер);
			Приборы.Вставить("ПоказаниеПредыдущее3", стр.ПоказаниеПредыдущее);
			Приборы.Вставить("ПоказаниеТекущее3", стр.Показание);
			кол = кол + 1;
		ИначеЕсли кол = 4 Тогда
			Приборы.Вставить("Прибор4", стр.ЗаводскойНомер);
			Приборы.Вставить("ПоказаниеПредыдущее4", стр.ПоказаниеПредыдущее);
			Приборы.Вставить("ПоказаниеТекущее4", стр.Показание);
			кол = кол + 1;
		ИначеЕсли кол = 5 Тогда
			Приборы.Вставить("Прибор5", стр.ЗаводскойНомер);
			Приборы.Вставить("ПоказаниеПредыдущее5", стр.ПоказаниеПредыдущее);
			Приборы.Вставить("ПоказаниеТекущее5", стр.Показание);
			кол = кол + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Приборы;
КонецФункции;













