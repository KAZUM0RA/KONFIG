
&НаСервере
Процедура ЗаполнитьТаблицуНаСервере()
	Объект.ТабличнаяЧасть.Очистить();
	ЗапросЛС = Новый Запрос;
	ЗапросЛС.Текст = 
	    "ВЫБРАТЬ
	    |	ЛицевыеСчетаСрезПоследних.ЛицевойСчет КАК ЛицевойСчет
	    |ИЗ
	    |	РегистрСведений.ЛицевыеСчета.СрезПоследних(
	    |			&НаДату,
	    |				ЛицевойСчет.ПометкаУдаления = ЛОЖЬ) КАК ЛицевыеСчетаСрезПоследних";
	ЗапросЛС.УстановитьПараметр("НаДату", ТекущаяДата());
	РезультатЛС = ЗапросЛС.Выполнить().Выгрузить();
	
	Для Каждого стрЛС Из РезультатЛС Цикл
		Запрос = Новый Запрос;
		Запрос.Текст =
		   "ВЫБРАТЬ
		   |	ЛицевыеСчетаСрезПоследних.ЛицевойСчет.Наименование КАК ЛицевойСчет,
		   |	ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ОтветственныйВладелец.Наименование КАК ФИО,
		   |	УстановленныеПриборыУчетаСрезПоследних.ПриборУчета.ЗаводскойНомер КАК НомерПрибораУчета,
		   |	ПоказанияПриборовУчетаСрезПоследних.Значение КАК ПоказаниеПрибора,
		   |	УстановленныеПриборыУчетаСрезПоследних.ПриборУчета.Услуга.ВидУслуги КАК Услуга,
		   |	ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ОтветственныйВладелец.ФизЛицо.Ссылка КАК Ссылка,
		   |	РасчетыПоЛицевымСчетамОстаткиИОбороты.СуммаКонечныйОстаток КАК Остаток,
		   |	УстановленныеПриборыУчетаСрезПоследних.МестоРазмещения,
		   |	ЛицевыеСчетаСрезПоследних.ЛицевойСчет.ОбъектЛицевогоСчета КАК Квартира,
		   |	ЛицевыеСчетаСрезПоследних.ЛицевойСчет.Владелец КАК Адрес
		   |ИЗ
		   |	РегистрСведений.ЛицевыеСчета.СрезПоследних(&НаДату, ЛицевойСчет = &ЛицевойСчет) КАК ЛицевыеСчетаСрезПоследних
		   |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОтветственныйВладелецЛицевогоСчета.СрезПоследних(&НаДату, ЛицевойСчет = &ЛицевойСчет) КАК ОтветственныйВладелецЛицевогоСчетаСрезПоследних
		   |		ПО ЛицевыеСчетаСрезПоследних.ЛицевойСчет = ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ЛицевойСчет
		   |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УстановленныеПриборыУчета.СрезПоследних(&НаДату, ОбъектУстановки = &ЛицевойСчет) КАК УстановленныеПриборыУчетаСрезПоследних
		   |			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПоказанияПриборовУчета.СрезПоследних(&НаДату, ) КАК ПоказанияПриборовУчетаСрезПоследних
		   |			ПО УстановленныеПриборыУчетаСрезПоследних.ПриборУчета = ПоказанияПриборовУчетаСрезПоследних.ПриборУчета
		   |		ПО ЛицевыеСчетаСрезПоследних.ЛицевойСчет = УстановленныеПриборыУчетаСрезПоследних.ОбъектУстановки
		   |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.РасчетыПоЛицевымСчетам.ОстаткиИОбороты(, , Авто, , ЛицевойСчет = &ЛицевойСчет) КАК РасчетыПоЛицевымСчетамОстаткиИОбороты
		   |		ПО ЛицевыеСчетаСрезПоследних.ЛицевойСчет = РасчетыПоЛицевымСчетамОстаткиИОбороты.ЛицевойСчет";
		
		Запрос.УстановитьПараметр("НаДату", Новый Граница(ТекущаяДата(), ВидГраницы.Включая));
		Запрос.УстановитьПараметр("ЛицевойСчет", стрЛС.ЛицевойСчет);
		Результат = Запрос.Выполнить().Выгрузить();
		ЛС = "";
		Для Каждого стр Из Результат Цикл
			
			Если ЛС <> стр.ЛицевойСчет Тогда
				Если ЗначениеЗаполнено(стр.Ссылка) Тогда
					НоваяСтрока = Объект.ТабличнаяЧасть.Добавить();
					НоваяСтрока.ЛицевойСчет = стр.ЛицевойСчет;
					НоваяСтрока.ФИО = стр.ФИО;
					//Адрес1 = ПолучитьДанныеКИ(стр.Ссылка, Справочники.ВидыКонтактнойИнформации.АдресДляИнформированияФизЛица);
					 
					//ЗначенияПолей = ПреобразоватьСтрокуВСписокПолей(АдресМасс);
					//Для Каждого стр1 Из ЗначенияПолей Цикл
					//	Попытка
					//	    НоваяСтрока[стр1.Представление] = стр1.Значение;
					//	Исключение
					//	КонецПопытки;
					//КонецЦикла;
					АдресМасс = ПечатьКвитанцииНаОплату2.РазложитьСтрокуВМассивПодстрок(стр.Адрес, ",");
					Адрес = ПечатьКвитанцииНаОплату2.ПолучитьПредставлениеАдреса(АдресМасс, стр.Квартира, Локализация.ПолучитьЯзыкФормированияПечатныхФорм());
					стрАдр = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(Адрес);
					НоваяСтрока.Город = стрАдр[2];
					Если НоваяСтрока.Город = "  м.Миргород" Тогда
						НачалоСтроки = "№ ";
						КвоУдалСтрок = СтрНайти(стрАдр[3], НачалоСтроки) - 1;
						ДлиннаСтроки = СтрДлина(стрАдр[3]) - (КвоУдалСтрок + 2);
						НоваяСтрока.Улица = стрАдр[4];
						НоваяСтрока.Дом = Прав(стрАдр[3], ДлиннаСтроки);
					Иначе
						НоваяСтрока.Улица = стрАдр[5];
						НачалоСтроки = "№ ";
						КвоУдалСтрок = СтрНайти(стрАдр[4], НачалоСтроки) - 1;
						ДлиннаСтроки = СтрДлина(стрАдр[4]) - (КвоУдалСтрок + 2);
						НоваяСтрока.Дом = Прав(стрАдр[4], ДлиннаСтроки);
					КонецЕсли;
					НачалоСтроки = "№ ";
					КвоУдалСтрок = СтрНайти(стр.Квартира, НачалоСтроки) - 1;
					ДлиннаСтроки = СтрДлина(стр.Квартира) - (КвоУдалСтрок + 2);
					НоваяСтрока.Квартира =Прав(стр.Квартира, 4);

					
					Если стр.МестоРазмещения = "Сан.вузол" Тогда
						Размещение = "СВ";
					ИначеЕсли стр.МестоРазмещения = "Кухня" Тогда
					    Размещение = "КУ";
					Иначе
						Размещение = "";
					КонецЕсли;
					Если стр.Услуга = Справочники.ВидыУслуг.ХолоднаяВода Тогда
					    НоваяСтрока.НомерПрибора1 = "-ХВ-" + Размещение + стр.НомерПрибораУчета;
					ИначеЕсли стр.Услуга = Справочники.ВидыУслуг.Водоотведение Тогда
						НоваяСтрока.НомерПрибора1 = "-ГВ-" + Размещение + стр.НомерПрибораУчета;
					КонецЕсли;
					НоваяСтрока.Показания1    = стр.ПоказаниеПрибора;
					
					НоваяСтрока.ДатаНачисления = НачалоМесяца(ТекущаяДата());//стр.МесяцНачисления;
					НоваяСтрока.Сальдо = стр.Остаток;
					НоваяСтрока.ОКПО = "03362560";
					НоваяСтрока.ДатаФормирования = НачалоМесяца(ТекущаяДата());
					НоваяСтрока.КодГород = 1;
					ЛС = стр.ЛицевойСчет;
				КонецЕсли;
				
			Иначе
				//Адрес = УправлениеКонтактнойИнформацией.ПолучитьКонтактнуюИнформацияОбъекта(стр.Ссылка, Справочники.ВидыКонтактнойИнформации.АдресДляИнформированияФизЛица);
				//Представление    = Адрес;//Параметры.Представление;
				//НаименованиеВида = Справочники.ВидыКонтактнойИнформации.АдресДляИнформированияФизЛица.Наименование;//Строка(Параметры.Вид);
				//
				//спПараметры = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(Адрес, ",");
				Если стр.МестоРазмещения = "Сан.вузол" Тогда
					Размещение = "СВ";
				ИначеЕсли стр.МестоРазмещения = "Кухня" Тогда
				    Размещение = "КУ";
				Иначе
					Размещение = "";
				КонецЕсли;

				Если НЕ ЗначениеЗаполнено(НоваяСтрока.НомерПрибора2) Тогда
					Если стр.Услуга = Справочники.ВидыУслуг.ХолоднаяВода Тогда
					    НоваяСтрока.НомерПрибора2 = "-ХВ-" + Размещение + стр.НомерПрибораУчета;
					ИначеЕсли стр.Услуга = Справочники.ВидыУслуг.Водоотведение Тогда
						НоваяСтрока.НомерПрибора2 = "-ГВ-" + Размещение + стр.НомерПрибораУчета;
					КонецЕсли;
					НоваяСтрока.Показания2    = стр.ПоказаниеПрибора;
				ИначеЕсли НЕ ЗначениеЗаполнено(НоваяСтрока.НомерПрибора3) Тогда
					Если стр.Услуга = Справочники.ВидыУслуг.ХолоднаяВода Тогда
					    НоваяСтрока.НомерПрибора3 = "-ХВ-" + Размещение + стр.НомерПрибораУчета;
					ИначеЕсли стр.Услуга = Справочники.ВидыУслуг.Водоотведение Тогда
						НоваяСтрока.НомерПрибора3 = "-ГВ-" + Размещение + стр.НомерПрибораУчета;
					КонецЕсли;
					НоваяСтрока.Показания3    = стр.ПоказаниеПрибора;
				ИначеЕсли НЕ ЗначениеЗаполнено(НоваяСтрока.НомерПрибора4) Тогда
					Если стр.Услуга = Справочники.ВидыУслуг.ХолоднаяВода Тогда
					    НоваяСтрока.НомерПрибора4 = "-ХВ-" + Размещение + стр.НомерПрибораУчета;
					ИначеЕсли стр.Услуга = Справочники.ВидыУслуг.Водоотведение Тогда
						НоваяСтрока.НомерПрибора4 = "-ГВ-" + Размещение + стр.НомерПрибораУчета;
					КонецЕсли;
					НоваяСтрока.Показания4    = стр.ПоказаниеПрибора;
				ИначеЕсли НЕ ЗначениеЗаполнено(НоваяСтрока.НомерПрибора5) Тогда
					Если стр.Услуга = Справочники.ВидыУслуг.ХолоднаяВода Тогда
					    НоваяСтрока.НомерПрибора5 = "-ХВ-" + Размещение + стр.НомерПрибораУчета;
					ИначеЕсли стр.Услуга = Справочники.ВидыУслуг.Водоотведение Тогда
						НоваяСтрока.НомерПрибора5 = "-ГВ-" + Размещение + стр.НомерПрибораУчета;
					КонецЕсли;
					НоваяСтрока.Показания5    = стр.ПоказаниеПрибора;
				КонецЕсли;
			КонецЕсли;	
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуНаСервере1()
	Объект.ТабличнаяЧасть.Очистить();
	тзДляВыгрузки = Объект.ТабличнаяЧасть.Выгрузить();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	    "ВЫБРАТЬ
	    |	ПоказанияПриборовЗаМесяцСрезПоследних.ПриборУчета,
	    |	ПоказанияПриборовЗаМесяцСрезПоследних.ЛицевойСчет,
	    |	ПоказанияПриборовЗаМесяцСрезПоследних.Здание,
	    |	ПоказанияПриборовЗаМесяцСрезПоследних.ОбъектЛицевогоСчета,
	    |	ПоказанияПриборовЗаМесяцСрезПоследних.ОтветственныйВладелец,
	    |	ПоказанияПриборовЗаМесяцСрезПоследних.Показание
	    |ИЗ
	    |	РегистрСведений.ПоказанияПриборовЗаМесяц.СрезПоследних КАК ПоказанияПриборовЗаМесяцСрезПоследних
	    |;
	    |
	    |////////////////////////////////////////////////////////////////////////////////
	    |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	    |	ВложенныйЗапрос.ЛицевойСчет,
	    |	ВложенныйЗапрос.ОКПО,
	    |	СУММА(ВложенныйЗапрос.Сальдо) КАК Сальдо
	    |ИЗ
	    |	(ВЫБРАТЬ
	    |		РасчетыПоЛицевымСчетамОстаткиИОбороты.Организация.КодПоЕДРПОУ КАК ОКПО,
	    |		РасчетыПоЛицевымСчетамОстаткиИОбороты.ЛицевойСчет КАК ЛицевойСчет,
	    |		РасчетыПоЛицевымСчетамОстаткиИОбороты.СуммаНачальныйОстаток КАК Сальдо,
	    |		РасчетыПоЛицевымСчетамОстаткиИОбороты.СуммаПриход КАК CALC_ACCRUAL,
	    |		РасчетыПоЛицевымСчетамОстаткиИОбороты.СуммаРасход КАК CALC_PAYMENT,
	    |		0 КАК CALC_PRIVILEGE,
	    |		0 КАК CALC_SUBSIDY,
	    |		0 КАК CALC_RECALC,
	    |		РасчетыПоЛицевымСчетамОстаткиИОбороты.МесяцНачисления КАК ДатаФормирования
	    |	ИЗ
	    |		РегистрНакопления.РасчетыПоЛицевымСчетам.ОстаткиИОбороты(&ДатаНачала, &ДатаОкончания, Авто, , ЛицевойСчет.ПометкаУдаления = ЛОЖЬ) КАК РасчетыПоЛицевымСчетамОстаткиИОбороты
	    |	
	    |	СГРУППИРОВАТЬ ПО
	    |		РасчетыПоЛицевымСчетамОстаткиИОбороты.ПериодГод,
	    |		РасчетыПоЛицевымСчетамОстаткиИОбороты.Организация.КодПоЕДРПОУ,
	    |		РасчетыПоЛицевымСчетамОстаткиИОбороты.ЛицевойСчет,
	    |		РасчетыПоЛицевымСчетамОстаткиИОбороты.СуммаНачальныйОстаток,
	    |		РасчетыПоЛицевымСчетамОстаткиИОбороты.СуммаПриход,
	    |		РасчетыПоЛицевымСчетамОстаткиИОбороты.СуммаРасход,
	    |		РасчетыПоЛицевымСчетамОстаткиИОбороты.МесяцНачисления
	    |	
	    |	ОБЪЕДИНИТЬ ВСЕ
	    |	
	    |	ВЫБРАТЬ
	    |		РасчетыПоЛицевымСчетам.Организация.КодПоЕДРПОУ,
	    |		РасчетыПоЛицевымСчетам.ЛицевойСчет,
	    |		0,
	    |		0,
	    |		0,
	    |		СУММА(ВЫБОР
	    |				КОГДА РасчетыПоЛицевымСчетам.ВидНачисления = ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Льгота)
	    |					ТОГДА РасчетыПоЛицевымСчетам.Сумма
	    |				ИНАЧЕ 0
	    |			КОНЕЦ),
	    |		ВЫБОР
	    |			КОГДА РасчетыПоЛицевымСчетам.ВидНачисления = ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Субсидия)
	    |				ТОГДА РасчетыПоЛицевымСчетам.Сумма
	    |			ИНАЧЕ 0
	    |		КОНЕЦ,
	    |		СУММА(ВЫБОР
	    |				КОГДА РасчетыПоЛицевымСчетам.ВидНачисления = ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Перерасчет)
	    |						ИЛИ РасчетыПоЛицевымСчетам.ВидНачисления = ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Корректировка)
	    |					ТОГДА РасчетыПоЛицевымСчетам.Сумма
	    |				ИНАЧЕ 0
	    |			КОНЕЦ),
	    |		РасчетыПоЛицевымСчетам.МесяцНачисления
	    |	ИЗ
	    |		РегистрНакопления.РасчетыПоЛицевымСчетам КАК РасчетыПоЛицевымСчетам
	    |	ГДЕ
	    |		РасчетыПоЛицевымСчетам.ЛицевойСчет.ПометкаУдаления = ЛОЖЬ
	    |		И РасчетыПоЛицевымСчетам.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
	    |	
	    |	СГРУППИРОВАТЬ ПО
	    |		РасчетыПоЛицевымСчетам.Организация.КодПоЕДРПОУ,
	    |		РасчетыПоЛицевымСчетам.ЛицевойСчет,
	    |		ВЫБОР
	    |			КОГДА РасчетыПоЛицевымСчетам.ВидНачисления = ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Субсидия)
	    |				ТОГДА РасчетыПоЛицевымСчетам.Сумма
	    |			ИНАЧЕ 0
	    |		КОНЕЦ,
	    |		РасчетыПоЛицевымСчетам.МесяцНачисления) КАК ВложенныйЗапрос
	    |
	    |СГРУППИРОВАТЬ ПО
	    |	ВложенныйЗапрос.ЛицевойСчет,
	    |	ВложенныйЗапрос.ОКПО";
	Запрос.УстановитьПараметр("НаДату", НачалоМесяца(ТекущаяДата()));
	Запрос.УстановитьПараметр("ДатаНачала", '20200501000000');
	Запрос.УстановитьПараметр("ДатаОкончания", НачалоМесяца(ТекущаяДата()));
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	ПриборыПоЛицевымСчетам = РезультатЗапроса[0].Выгрузить();
	СальдоПоЛицевымСчетам  = РезультатЗапроса[1].Выгрузить();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТаблицу(Команда)
	ЗаполнитьТаблицуНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьТаблицу(Команда)
	Файл = Новый XBase;
	Файл.Кодировка = КодировкаXBase.ANSI;
	Файл.поля.Добавить("LS","N",15,0);
	Файл.поля.Добавить("ID","C",7,0);
	Файл.поля.Добавить("FIO","C",50,0);
	Файл.поля.Добавить("TOWN","C",30,0);
	Файл.поля.Добавить("VUL","C",35,0);
	Файл.поля.Добавить("BUD","C",20,0);
	Файл.поля.Добавить("FLAT","C",10,0);
	Файл.поля.Добавить("IDLICH1","C",16,0);
	Файл.поля.Добавить("POKBEG1","N",12,0);
	Файл.поля.Добавить("POKEND1","N",12,0);
	Файл.поля.Добавить("IDLICH2","C",16,0);
	Файл.поля.Добавить("POKBEG2","N",12,0);
	Файл.поля.Добавить("POKEND2","N",12,0);
	Файл.поля.Добавить("IDLICH3","C",16,0);
	Файл.поля.Добавить("POKBEG3","N",12,0);
	Файл.поля.Добавить("POKEND3","N",12,0);
	Файл.поля.Добавить("IDLICH4","C",16,0);
	Файл.поля.Добавить("POKBEG4","N",12,0);
	Файл.поля.Добавить("POKEND4","N",12,0);
	Файл.поля.Добавить("IDLICH5","C",16,0);
	Файл.поля.Добавить("POKBEG5","N",12,0);
	Файл.поля.Добавить("POKEND5","N",12,0);
	Файл.поля.Добавить("D_SALDO","D",8,0);
	Файл.поля.Добавить("SALDO","N",12,2);
	Файл.поля.Добавить("KOD_USLUGA","N",2,0);
	Файл.поля.Добавить("USLUGA","C",35,0);
	Файл.поля.Добавить("INFO","C",150,0);
	Файл.поля.Добавить("OKPO","C",10,0);
	Файл.поля.Добавить("D_FORM","D",8,0);
	Файл.поля.Добавить("KOD_GORODA","N",1,0);
	Попытка
		Файл.СоздатьФайл(Объект.ФайлDBF);
	Исключение
		Предупреждение("Помилка створення файлу " + Файл);
		Возврат;
	КонецПопытки;
	
	Для Каждого стр Из Объект.ТабличнаяЧасть Цикл
		Файл.Добавить();
		Файл.LS      = стр.ЛицевойСчет;
		Файл.FIO     = стр.ФИО;
		Файл.TOWN    = стр.Город;
		Файл.VUL     = стр.Улица;
		Файл.BUD     = стр.Дом;
		Файл.FLAT    = стр.Квартира;
		Файл.IDLICH1 = стр.НомерПрибора1;
		Файл.POKBEG1 = стр.Показания1;
		Файл.POKEND1 = 0;
		Файл.IDLICH2 = стр.НомерПрибора2;
		Файл.POKBEG2 = стр.Показания2;
		Файл.POKEND2 = 0;
		Файл.IDLICH3 = стр.НомерПрибора3;
		Файл.POKBEG3 = стр.Показания3;
		Файл.POKEND3 = 0;
		Файл.IDLICH4 = стр.НомерПрибора4;
		Файл.POKBEG4 = стр.Показания4;
		Файл.POKEND4 = 0;
		Файл.IDLICH5 = стр.НомерПрибора5;
		Файл.POKBEG5 = стр.Показания5;
		Файл.POKEND5 = 0;
		Файл.D_SALDO = стр.ДатаНачисления;
		Файл.SALDO   = стр.Сальдо;
		Файл.OKPO    = стр.ОКПО;
		Файл.D_FORM  = стр.ДатаФормирования;
		Файл.KOD_GORODA = стр.КодГород;
		Файл.Записать();
	КонецЦикла;
	
	Файл.ЗакрытьФайл();
	Предупреждение("Файл " + Файл + " успішно створений.");
КонецПроцедуры

&НаКлиенте
Процедура ФайлDBFНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ДиалогВыбораФайла.Фильтр                      = НСтр("ru='Файл XBase (*.dbf)|*.dbf'");
	ДиалогВыбораФайла.Заголовок                   = Заголовок;
	ДиалогВыбораФайла.ПредварительныйПросмотр     = Ложь;
	ДиалогВыбораФайла.Расширение                  = "dbf";
	ДиалогВыбораФайла.ИндексФильтра               = 0;
	ДиалогВыбораФайла.ПроверятьСуществованиеФайла = Ложь;
	
	Если ДиалогВыбораФайла.Выбрать() Тогда
	    Объект.ФайлDBF = ДиалогВыбораФайла.ПолноеИмяФайла;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ПреобразоватьСтрокуВСписокПолей(СтрокаПолей)
	
	Результат = Новый СписокЗначений;
	ПоследнийЭлемент = Неопределено;
	
	Для Итерация = 1 По СтрЧислоСтрок(СтрокаПолей) Цикл
		ПолученнаяСтрока = СтрПолучитьСтроку(СтрокаПолей, Итерация);
		Если Лев(ПолученнаяСтрока, 1) = Символы.Таб Тогда
			Если ПоследнийЭлемент <> Неопределено Тогда
				ПоследнийЭлемент.Значение = ПоследнийЭлемент.Значение + Символы.ПС + Сред(ПолученнаяСтрока, 2);
			КонецЕсли;
		Иначе
			ПозицияСимвола = Найти(ПолученнаяСтрока, "=");
			Если ПозицияСимвола <> 0 Тогда
				ПоследнийЭлемент = Результат.Добавить(Сред(ПолученнаяСтрока, ПозицияСимвола + 1), Лев(ПолученнаяСтрока, ПозицияСимвола - 1));
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПолучитьДанныеКИ(Ссылка, ВидКонтактнойИнформации)
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КонтактнаяИнформация.ЗначенияПолей
		|ИЗ
		|	Справочник." + Ссылка.Метаданные().Имя + ".КонтактнаяИнформация КАК КонтактнаяИнформация
		|ГДЕ
		|	КонтактнаяИнформация.Ссылка = &Ссылка
		|	И КонтактнаяИнформация.Вид = &Вид";
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("Вид",    ВидКонтактнойИнформации);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ЗначенияПолей;
	Иначе
		Возврат "";
	КонецЕсли;
КонецФункции
