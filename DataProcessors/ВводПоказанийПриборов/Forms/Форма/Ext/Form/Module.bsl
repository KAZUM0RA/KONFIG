
&НаКлиенте
Процедура ЗагрузитьИзФайла(Команда)
	Путь = Объект.ФайлЕксель;
	Если НЕ ЗначениеЗаполнено(Объект.ФайлЕксель) Тогда
		Сообщить(НСтр("ru='Укажите путь к файлу.';uk='Вкажіть шлях до файлу.'"));
		Возврат;
	КонецЕсли;
    Если Объект.ТабличнаяЧасть.Количество() > 0 Тогда
		Ответ = Вопрос(НСтр("ru='Табличная часть будет очищена! Продолжить выполнение операции?';uk='Таблична частина буде очищена! Продовжити виконання операції'"), РежимДиалогаВопрос.ДаНет, 0);
		Если Ответ <> КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли; 
	КонецЕсли;
	Объект.ТабличнаяЧасть.Очистить();
	Попытка
		Excel = Новый COMОбъект("Excel.application");	
	Исключение
		Сообщить(НСтр("ru='Не удалось подключиться';uk='Не вдалося підключитися'") + информацияОбОшибке());
		Возврат;
	КонецПопытки;
	Excel.Workbooks.Open(Путь);
	Sheet = Excel.Sheets(1);
	Sheet = Excel.ActiveWorkbook;
	КоличествоСтрок = Excel.ActiveSheet.UsedRange.Rows.Count();//Excel.Cells.CurrentRegion.Rows.Count;
	Для Счетчик = 2 По КоличествоСтрок Цикл
		НоваяСтрока                           = Объект.ТабличнаяЧасть.Добавить();
		НоваяСтрока.ЛицевойСчет               = Excel.Cells(Счетчик, 1).Value;
		НоваяСтрока.Размещение1               = Excel.Cells(Счетчик, 2).Value;
		НоваяСтрока.НомерПрибора1             = Excel.Cells(Счетчик, 3).Value;
		НоваяСтрока.Поверка1                  = Excel.Cells(Счетчик, 4).Value;
		НоваяСтрока.СледПоверка1              = Excel.Cells(Счетчик, 5).Value;
		НоваяСтрока.НомерПломбы1              = Excel.Cells(Счетчик, 6).Value;
		НоваяСтрока.Показатель1               = Excel.Cells(Счетчик, 7).Value;
		НоваяСтрока.Холодна1                  = Excel.Cells(Счетчик, 8).Value;
		НоваяСтрока.Гаряча1                   = Excel.Cells(Счетчик, 9).Value;
		
		НоваяСтрока.Размещение2               = Excel.Cells(Счетчик, 10).Value;
		НоваяСтрока.НомерПрибора2             = Excel.Cells(Счетчик, 11).Value;
		НоваяСтрока.Поверка2                  = Excel.Cells(Счетчик, 12).Value;
		НоваяСтрока.СледПоверка2              = Excel.Cells(Счетчик, 13).Value;
		НоваяСтрока.НомерПломбы2              = Excel.Cells(Счетчик, 14).Value;
		НоваяСтрока.Показатель2               = Excel.Cells(Счетчик, 15).Value;
		НоваяСтрока.Холодна2                  = Excel.Cells(Счетчик, 16).Value;
		НоваяСтрока.Гаряча2                   = Excel.Cells(Счетчик, 17).Value;
		
		НоваяСтрока.Размещение3               = Excel.Cells(Счетчик, 18).Value;
		НоваяСтрока.НомерПрибора3             = Excel.Cells(Счетчик, 19).Value;
		НоваяСтрока.Поверка3                  = Excel.Cells(Счетчик, 20).Value;
