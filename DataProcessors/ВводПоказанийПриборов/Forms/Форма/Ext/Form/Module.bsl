&НаСервере
Функция ПолучитьЛицевыеСчета(ЛицевойСчет)
    Запрос = Новый Запрос;
	Запрос.Текст = 
	    "ВЫБРАТЬ
	    |	ЛицевыеСчетаСрезПоследних.ЛицевойСчет КАК Ссылка
	    |ИЗ
	    |	РегистрСведений.ЛицевыеСчета.СрезПоследних(
	    |			&НаДату,
	    |			Действует = ИСТИНА
	    |				И ЛицевойСчет.Наименование = &Наименование) КАК ЛицевыеСчетаСрезПоследних";
	Запрос.УстановитьПараметр("НаДату", Новый Граница(ТекущаяДата(), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Наименование", ЛицевойСчет);
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		ЛС = Выборка.Ссылка;
	КонецЦикла;
	Возврат ЛС;
КонецФункции

&НаСервере
Функция НайтиПриборУчета(ЛицевойСчет)
	Запрос = Новый Запрос;
	Запрос.Текст =
	    "ВЫБРАТЬ
	    |	УстановленныеПриборыУчетаСрезПоследних.ПриборУчета КАК ПриборУчета,
	    |	УстановленныеПриборыУчетаСрезПоследних.ПриборУчета.ЗаводскойНомер КАК НомерПрибора
	    |ИЗ
	    |	РегистрСведений.УстановленныеПриборыУчета.СрезПоследних(
	    |			&НаДату,
	    |			Действует = ИСТИНА
	    |				И ОбъектУстановки = &ОбъектУстановки) КАК УстановленныеПриборыУчетаСрезПоследних";
    Запрос.УстановитьПараметр("НаДату", Новый Граница(ТекущаяДата(), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("ОбъектУстановки", ЛицевойСчет);
	ПУ = Новый Структура;
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		ПУ.Вставить("ПриборУчета", Выборка.ПриборУчета);
		ПУ.Вставить("НомерПрибора", Выборка.НомерПрибора);
	КонецЦикла;
	Возврат ПУ;
КонецФункции

&НаСервере
Функция НайтиДокУПУ(ЛицевойСчет, НомерПрибора)
    Запрос = Новый Запрос;
	Запрос.Текст = 
	    "ВЫБРАТЬ
	    |	УправлениеПриборамиУчетаПриборыУчета.Ссылка.Ссылка КАК Ссылка
	    |ИЗ
	    |	Документ.УправлениеПриборамиУчета.ПриборыУчета КАК УправлениеПриборамиУчетаПриборыУчета
	    |ГДЕ
	    |	УправлениеПриборамиУчетаПриборыУчета.ПриборУчета.ЗаводскойНомер = &ЗаводскойНомер
	    |	И УправлениеПриборамиУчетаПриборыУчета.Ссылка.ОбъектУстановки = &ОбъектУстановки
	    |	И УправлениеПриборамиУчетаПриборыУчета.Ссылка.Проведен = ИСТИНА";
	Запрос.УстановитьПараметр("ЗаводскойНомер", НомерПрибора);
	Запрос.УстановитьПараметр("ОбъектУстановки", ЛицевойСчет);
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		Док = Выборка.Ссылка;
	КонецЦикла;
	Возврат Док;
КонецФункции

&НаСервере
Функция ПолучитьПриборыУчета(НомерПрибора, ЛицевойСчет)
	Запрос = Новый Запрос;
	Запрос.Текст = 
	    "ВЫБРАТЬ
	    |	УстановленныеПриборыУчетаСрезПоследних.ПриборУчета КАК ПриборУчета,
	    |	ПоказанияПриборовУчетаСрезПоследних.Значение,
	    |	ПоказанияПриборовУчетаСрезПоследних.Регистратор КАК ДокументУП
	    |ИЗ
	    |	РегистрСведений.УстановленныеПриборыУчета.СрезПоследних(
	    |			&НаДату,
	    |			ПриборУчета.ЗаводскойНомер = &ЗаводскойНомер
	    |				И Действует = ИСТИНА) КАК УстановленныеПриборыУчетаСрезПоследних
	    |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПоказанияПриборовУчета.СрезПоследних(
	    |				&НаДату,
	    |				ПриборУчета.ЗаводскойНомер = &ЗаводскойНомер
	    |					И Отключен = ЛОЖЬ) КАК ПоказанияПриборовУчетаСрезПоследних
	    |		ПО УстановленныеПриборыУчетаСрезПоследних.ПриборУчета = ПоказанияПриборовУчетаСрезПоследних.ПриборУчета
	    |ГДЕ
	    |	УстановленныеПриборыУчетаСрезПоследних.ОбъектУстановки = &ОбъектУстановки
	    |	И УстановленныеПриборыУчетаСрезПоследних.Регистратор.ВидОперации = &ВидОперации";
	Запрос.УстановитьПараметр("НаДату", Новый Граница(ТекущаяДата(), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("ЗаводскойНомер", НомерПрибора);
	Запрос.УстановитьПараметр("ОбъектУстановки", ЛицевойСчет);
	Запрос.УстановитьПараметр("ВидОперации", Перечисления.ВидыОперацийУправленияПриборамиУчета.УстановкаПрибораУчета);
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	//Прибор = Новый Структура();
	Пока Выборка.Следующий() Цикл
		Прибор = Выборка.ДокументУП;
		//Прибор.Вставить("ПриборУчета",Выборка.ПриборУчета);
		//Прибор.Вставить("ПредыдущееЗначение", Выборка.Значение);
	КонецЦикла;
	Возврат Прибор;
КонецФункции