&НаСервере
Процедура ЗаписатьПоказанияНаСервере()
	Для Каждого стр Из Объект.ТабличнаяЧасть Цикл
		ЛицевойСчет = ПолучитьЛицевыеСчета(СтрЗаменить(Строка(стр.ЛицевойСчет), Символы.НПП, ""));
		Если НЕ ЗначениеЗаполнено(ЛицевойСчет) Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = НСтр("ru = 'Не удалось найти ЛС '; uk = 'Не вдалося знайти ОР '") + стр.ЛицевойСчет; 
			Сообщение.Сообщить();
			Продолжить;
		КонецЕсли;
		Если ЗначениеЗаполнено(стр.Размещение1) Тогда
		    ПриборУчета = ПолучитьПриборыУчета(СтрЗаменить(Строка(стр.НомерПрибора1), Символы.НПП, ""), ЛицевойСчет);
			Если ПриборУчета = Неопределено Тогда
				Сообщение = Новый СообщениеПользователю;
			    Сообщение.Текст = НСтр("ru = 'Не удалось найти прибор учета 1 ЛС '; uk = 'Не вдалося знайти прилад обліку 1 ОР '") + стр.ЛицевойСчет; 
			    Сообщение.Сообщить();
				Продолжить;
			КонецЕсли;
			ДокУпрПриборами = ПриборУчета.ПолучитьОбъект();
			Для Каждого стрПриборы Из ДокУпрПриборами.ПриборыУчета Цикл
				стрПриборы.НачальноеПоказание = Число(стр.Показатель1);
			КонецЦикла;
			Попытка
				ДокУпрПриборами.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
			Исключение
				ДокУпрПриборами.Записать();
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = НСтр("ru = 'Не удалось провести докмент '; uk = 'Не вдалося провести документ '") + ДокУпрПриборами.Номер; 
				Сообщение.Сообщить();
			КонецПопытки;
		КонецЕсли;
		
		// Прибор №2
		Если ЗначениеЗаполнено(стр.Размещение2) Тогда
		    ПриборУчета = ПолучитьПриборыУчета(СтрЗаменить(Строка(стр.НомерПрибора2), Символы.НПП, ""), ЛицевойСчет);
			Если ПриборУчета = Неопределено Тогда
				Сообщение = Новый СообщениеПользователю;
			    Сообщение.Текст = НСтр("ru = 'Не удалось найти прибор учета 2 ЛС '; uk = 'Не вдалося знайти прилад обліку 2 ОР '") + стр.ЛицевойСчет; 
			    Сообщение.Сообщить();
				Продолжить;
			КонецЕсли;
			ДокУпрПриборами = ПриборУчета.ПолучитьОбъект();
			Для Каждого стрПриборы Из ДокУпрПриборами.ПриборыУчета Цикл
				стрПриборы.НачальноеПоказание = Число(стр.Показатель2);
