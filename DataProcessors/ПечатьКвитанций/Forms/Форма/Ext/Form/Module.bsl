&НаКлиенте
Процедура ОтправитьПоПочте(ЛС, ТАбДок = Неопределено, ЭлПочта)
	
	НастройкиСохранения = ПолучитьНастройкиСохранения();
	
	Если ТипЗнч(НастройкиСохранения) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	
	СписокВложений = Новый СписокЗначений;
	
	Если ТАбДок <> Неопределено Тогда
		ПоместитьТабличныеДокументыВоВременноеХранилище(СписокВложений, НастройкиСохранения, ТабДок, ЛС);
	КонецЕсли;	
	
	Если  НЕ ЗначениеЗаполнено(ШаблонПисьма) Тогда
		
		ТекстВопроса = НСтр("ru = 'Для текущего пользователя не установлен шаблон темы и текста письма.
		|Выбрать шаблон?'; uk = 'Для поточного користувача не встановлений шаблон теми і тексту листа.
		|Вибрати шаблон?'");
		Ответ = Вопрос(ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		Если Ответ = КодВозвратаДиалога.Да тогда
			ОткрытьФормуМодально("Справочник.ШаблоныТекстовПисем.ФормаВыбора",,ЭтаФорма);
		КонецЕсли;
	КонецЕсли;	
	
	
	
	ТемаПисьма = ПолучитьТекстПисьмаСервер(ЛС,"ТемаПисьма");
	ТекстПисьма = ПолучитьТекстПисьмаСервер(ЛС,"ТекстПисьма");
	
	ПараметрыПисьма = Новый Структура;
	
	ПараметрыПисьма.Вставить("УчетнаяЗапись", Неопределено);
	ПараметрыПисьма.Вставить("Кому", ЭлПочта);
	ПараметрыПисьма.Вставить("Тема", ТемаПисьма);
	ПараметрыПисьма.Вставить("Тело", ТекстПисьма);
	ПараметрыПисьма.Вставить("Вложения", СписокВложений);
	ПараметрыПисьма.Вставить("УдалятьФайлыПослеОтправки", Истина);
	
	Форма = ПолучитьФорму("ОбщаяФорма.ОтправкаСообщения", ПараметрыПисьма);
	Форма.ОтправитьПисьмоВыполнить(Истина);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьТекстПисьмаСервер(ЛицевойСчет,Текст)
	Если Текст = "ТемаПисьма" Тогда
		Параметр = ШаблонПисьма.ТемаПисьма;
	Иначе
		Параметр = ШаблонПисьма.ТекстПисьма;
	КонецЕсли;	
	  МассивЛС = ПолучитьДанныеЛицевыхСчетов(ЛицевойСчет);
	  МассивТекстов = СтроковыеФункцииКлиентСервер.СформироватьТекстSMSСообщения(МассивЛС,Параметр,АдресСайта);
	  Возврат МассивТекстов[0];
КонецФункции

&НаКлиенте
Процедура ПоместитьТабличныеДокументыВоВременноеХранилище(СписокФайлов, НастройкиСохранения, ТабДок, ЛС)
	
	
	ЗаписьZipФайла = Неопределено;
	ИмяАрхива = Неопределено;
	Если НастройкиСохранения.ЗапаковатьZIP Тогда
		ИмяАрхива = ПолучитьИмяВременногоФайла("zip");
		ЗаписьZipФайла = Новый ЗаписьZipФайла(ИмяАрхива);
	КонецЕсли;
	
	СписокТипов = НастройкиСохранения.СписокТипов;
	
	ИмяВременнойПапки = ПолучитьИмяВременногоФайла();
	СоздатьКаталог(ИмяВременнойПапки);
	
	
	НомерПечатнойФормы = ЛС;
	Для Каждого ТипФайла Из СписокТипов Цикл
		
		ИмяФайла = "[ИмяМакета] ([НомерПечатнойФормы]).[Расширение]";
		
		ИмяФайла = СтрЗаменить(ИмяФайла, "[ИмяМакета]",			 ЛС);
		ИмяФайла = СтрЗаменить(ИмяФайла, "[НомерПечатнойФормы]", НомерПечатнойФормы);
		ИмяФайла = СтрЗаменить(ИмяФайла, "[Расширение]",		 ТипФайла.Представление);
		
		ИмяФайла = ОбщегоНазначенияКлиентСервер.ЗаменитьНедопустимыеСимволыВИмениФайла(ИмяФайла);
		
		ИмяВременногоФайла = ИмяВременнойПапки + "\" + ИмяФайла;
		ТабДок.Записать(ИмяВременногоФайла, ТипФайла.Значение);
		
		Если ТипФайла.Значение = ТипФайлаТабличногоДокумента.HTML Тогда
			ВставитьКартинкиВHTML(ИмяВременногоФайла);
		КонецЕсли;			
		
		Если ЗаписьZipФайла <> Неопределено Тогда 
			ЗаписьZipФайла.Добавить(ИмяВременногоФайла);
		Иначе
			ДвоичныеДанные = Новый ДвоичныеДанные(ИмяВременногоФайла);
			ПутьВоВременномХранилище = ПоместитьВоВременноеХранилище(ДвоичныеДанные, ЭтаФорма.УникальныйИдентификатор);
			СписокФайлов.Добавить(ПутьВоВременномХранилище, ИмяФайла);
			УдалитьФайлы(ИмяВременногоФайла);
		КонецЕсли;
	КонецЦикла;
	
	
	Если ЗаписьZipФайла <> Неопределено Тогда 
		ЗаписьZipФайла.Записать();
		ФайлАрхива = Новый Файл(ИмяАрхива);
		ДвоичныеДанные = Новый ДвоичныеДанные(ИмяАрхива);
		ПутьВоВременномХранилище = ПоместитьВоВременноеХранилище(ДвоичныеДанные, ЭтаФорма.УникальныйИдентификатор);
		СписокФайлов.Добавить(ПутьВоВременномХранилище, ФайлАрхива.Имя);
	КонецЕсли;
	
	УдалитьФайлы(ИмяВременнойПапки);
	
КонецПроцедуры

&НаСервере
Процедура ВставитьКартинкиВHTML(ИмяФайлаHTML)
	
	ТекстовыйДокумент = Новый ТекстовыйДокумент();
	ТекстовыйДокумент.Прочитать(ИмяФайлаHTML, КодировкаТекста.UTF8);
	ТекстHTML = ТекстовыйДокумент.ПолучитьТекст();
	
	ФайлHTML = Новый Файл(ИмяФайлаHTML);
	
	ИмяПапкиКартинок = ФайлHTML.ИмяБезРасширения + "_files";
	ПутьКПапкеКартинок = СтрЗаменить(ФайлHTML.ПолноеИмя, ФайлHTML.Имя, ИмяПапкиКартинок);
	
	// ожидается, что в папке будут только картинки
	ФайлыКартинок = НайтиФайлы(ПутьКПапкеКартинок, "*");
	
	Для Каждого ФайлКартинки Из ФайлыКартинок Цикл
		КартинкаТекстом = Base64Строка(Новый ДвоичныеДанные(ФайлКартинки.ПолноеИмя));
		КартинкаТекстом = "data:image/" + Сред(ФайлКартинки.Расширение,2) + ";base64," + Символы.ПС + КартинкаТекстом;
		
		ТекстHTML = СтрЗаменить(ТекстHTML, ИмяПапкиКартинок + "\" + ФайлКартинки.Имя, КартинкаТекстом);
	КонецЦикла;
	
	ТекстовыйДокумент.УстановитьТекст(ТекстHTML);
	ТекстовыйДокумент.Записать(ИмяФайлаHTML, КодировкаТекста.UTF8);
	
КонецПроцедуры


&НаСервере
Функция ПолучитьСписокЛС(ЛС)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЛицевыеСчета.ЭлПочта
	|ИЗ
	|	Справочник.ЛицевыеСчета КАК ЛицевыеСчета
	|ГДЕ
	|	ЛицевыеСчета.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка",ЛС);
	Результат = Запрос.Выполнить().выбрать();
	Результат.Следующий();
	Возврат Результат.ЭлПочта;
	
	
КонецФункции // ПолучитьСписокЛС()


&НаКлиенте
Функция  ПолучитьНастройкиСохранения()
	
	СписокТипов = Новый СписокЗначений;
	Если Объект.ФорматMXL Тогда
		СписокТипов.Добавить(ТипФайлаТабличногоДокумента.MXL, "mxl");
	КонецЕсли;
	
	Если Объект.ФорматHTML Тогда
		СписокТипов.Добавить(ТипФайлаТабличногоДокумента.HTML, "html");
	КонецЕсли;
	
	Если Объект.ФорматXLS Тогда
		СписокТипов.Добавить(ТипФайлаТабличногоДокумента.XLS, "xls");
	КонецЕсли;
	
	Если Объект.ФорматPDF Тогда
		СписокТипов.Добавить(ТипФайлаТабличногоДокумента.PDF, "pdf");
	КонецЕсли;
	
	Если Объект.ФорматODS Тогда
		СписокТипов.Добавить(ТипФайлаТабличногоДокумента.ODS, "ods");
	КонецЕсли;
	
	
	//Если СписокТипов.Количество() = 0 Тогда
	//	Предупреждение(НСтр("ru='Необходимо указать как минимум один из предложенных форматов.';uk=' Необхідно вказати як мінімум один із запропонованих форматів.'"));
	//	Возврат;
	//КонецЕсли;	
	
	Результат = Новый Структура;
	Результат.Вставить("ЗапаковатьZIP", ЗапаковатьВZIP);
	Результат.Вставить("СписокТипов", СписокТипов);
	
	Возврат Результат;
	
КонецФункции // ПолучитьНастройкиСохранения()()

&НаКлиенте
Процедура РазослатьSMS(Команда)
	
	
	Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru='Поле ""Организация"" не заполнено';uk='Полі ""Організація"" не заповнено'");
		Сообщение.Поле = "Объект.Организация";
		Сообщение.Сообщить();
	ИначеЕсли НЕ ЗначениеЗаполнено(Объект.Здание) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru='Поле ""Здание"" не заполнено';uk='Полі ""Будівля"" не заповнена'");
		Сообщение.Поле = "Объект.Здание";
		Сообщение.Сообщить(); 
		
	ИначеЕсли Объект.ЛицевыеСчета.Количество() = 0 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru='Не заполнена таблица лицевых счетов';uk='Не заповнена таблиця особових рахунків'");
		Сообщение.Поле = "Объект.ЛицевыеСчета";
		Сообщение.Сообщить(); 
	КонецЕсли; 
	
	
	РассылкаSMSНаСервере();
	
	
КонецПроцедуры

&НаСервере
Процедура РассылкаSMSНаСервере ()
	
	ЛицевыеСчета = Новый Массив;
	Для Каждого Строка Из Объект.ЛицевыеСчета Цикл
		ЛицевыеСчета.Добавить(Строка.ЛицевойСчет);
	КонецЦикла;
	
	МассивЛС = ПолучитьДанныеЛицевыхСчетов(ЛицевыеСчета);	
	
	Результат = СтроковыеФункцииКлиентСервер.СформироватьТекстSMSСообщения(МассивЛС, Объект.ШаблонСМС.ТекстШаблона);	
	
	РезультатОтправки = ОтправкаSMS.ОтправитьSMSГрупповая(МассивЛС,Результат,,ПеревестиВЛатинскиеСимволы);
	СтатусыДоставки = ОтправкаSMSЧерезАльфаSMS.СтатусДоставкиКомплекс(РезультатОтправки.ОтправленныеСообщения,,);
	Если РезультатОтправки.ОписаниеОшибки = "" Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru = 'Сообщения отправлены'; uk = 'Повідомлення відправлені'");
		Сообщение.Сообщить();
		
		ПроведениеСервер.ОтразитьОперацииУведомления(СтатусыДоставки,Объект.МесяцНачислений,"СообщениеСМС");
	КонецЕсли;
	
	
КонецПроцедуры

&НаСервере
Функция ПолучитьДанныеЛицевыхСчетов(ЛС)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЛицевыеСчета.ОбъектЛицевогоСчета КАК ОбъектЛС,
	|	ЛицевыеСчета.ОбъектЛицевогоСчета.Владелец КАК Здание,
	|	ЛицевыеСчета.Ссылка КАК ЛицевойСчет,
	|	ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ОтветственныйВладелец КАК ОтветственныйВладелец,
	|	РасчетыПоЛицевымСчетамОстатки.СуммаОстаток КАК Долг,
	|	НАЧАЛОПЕРИОДА(&Дата, МЕСЯЦ) КАК Дата,
	|	ЛицевыеСчета.МобТелефон КАК СотовыйТелефон
	|ИЗ
	|	РегистрСведений.ЛицевыеСчета.СрезПоследних(&Дата, ) КАК ЛицевыеСчетаСрезПоследних
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЛицевыеСчета КАК ЛицевыеСчета
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОтветственныйВладелецЛицевогоСчета.СрезПоследних(&Дата, ) КАК ОтветственныйВладелецЛицевогоСчетаСрезПоследних
	|			ПО ЛицевыеСчета.Ссылка = ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ЛицевойСчет
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.РасчетыПоЛицевымСчетам.Остатки(НАЧАЛОПЕРИОДА(&Дата, МЕСЯЦ), ) КАК РасчетыПоЛицевымСчетамОстатки
	|			ПО ЛицевыеСчета.Ссылка = РасчетыПоЛицевымСчетамОстатки.ЛицевойСчет
	|		ПО ЛицевыеСчетаСрезПоследних.ЛицевойСчет = ЛицевыеСчета.Ссылка
	|ГДЕ
	|	ЛицевыеСчета.Ссылка В(&ЛицевойСчет)
	|	И ЛицевыеСчетаСрезПоследних.Действует = ИСТИНА";
	Запрос.УстановитьПараметр("ЛицевойСчет",ЛС);
	Запрос.УстановитьПараметр("Дата", ТекущаяДата());
	
	Результат =  Запрос.Выполнить().Выгрузить();
	
	
	МассивЛС = Новый Массив;
	Для каждого Строка Из Результат Цикл
		
		МассивЛС.Добавить(Строка);
		
		
	КонецЦикла; 
	
	Возврат МассивЛС;

КонецФункции // ПолучитьДанныеЛицевыхСчетов()


&НаКлиенте
Процедура ПрооверитьИОбновитьСатусыСМС(Команда)
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("Организация",Объект.Организация);
	ПараметрыОткрытия.Вставить("Здание",Объект.Здание);
