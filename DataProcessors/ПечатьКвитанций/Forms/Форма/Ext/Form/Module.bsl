&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если УпрощеннаяКвитанция = Истина Тогда
		ТипМакета = "МакетКвитанцииНаОплатуУпрощенная"
	Иначе
		ТипМакета = "МакетКвитанцииНаОплату"
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УпрощеннаяКвитанцияПриИзменении(Элемент)
	
	Если УпрощеннаяКвитанция = Истина Тогда
		ТипМакета = "МакетКвитанцииНаОплатуУпрощенная"
	Иначе
		ТипМакета = "МакетКвитанцииНаОплату"
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	УстановитьСписокСчетов();
	
	АдресСайта = ПолучитьАдресСайтаХвояЖКХ(Объект.Организация);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьСписокСчетов();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	БанковскиеСчета.Ссылка
	|ИЗ
	|	Справочник.БанковскиеСчета КАК БанковскиеСчета
	|ГДЕ
//{{MRG[ <-> ]
	|	БанковскиеСчета.Владелец = &Владелец";
//}}MRG[ <-> ]
//{{MRG[ <-> ]
//	|	БанковскиеСчета.Владелец = &Владелец
//}}MRG[ <-> ]
//{{MRG[ <-> ]
//	|	И БанковскиеСчета.ПометкаУдаления = ЛОЖЬ";
//}}MRG[ <-> ]
	
	Запрос.УстановитьПараметр("Владелец", Объект.Организация);
	
	Результат = Запрос.Выполнить();
	
	Выборка = Результат.Выбрать();
	
	Объект.БанковскиеСчета.Очистить();
	
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока = Объект.БанковскиеСчета.Добавить();
		НоваяСтрока.Печать = Истина;
		НоваяСтрока.БанковскийСчет = Выборка.Ссылка;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура Отправить(Команда)
	
	Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
		Сообщить(НСтр("ru='Поле ""Организация"" не заполнено';uk='Полі ""Організація"" не заповнено'"));
		Возврат;
	ИначеЕсли НЕ ЗначениеЗаполнено(Объект.Здание) Тогда
		Сообщить(НСтр("ru='Поле ""Здание"" не заполнено';uk='Полі ""Будівля"" не заповнена'"));
		Возврат;
	ИначеЕсли НЕ ЗначениеЗаполнено(Объект.МесяцНачислений) Тогда
		Сообщить(НСтр("ru='Поле ""МесяцНачислений"" не заполнено';uk='Полі ""МесяцНачислений"" не заповнено'"));
		Возврат;
	Иначе
		МесяцЗакрыт = ПроверитьЗакрытиеМесяца();
		Если НЕ МесяцЗакрыт Тогда
			Сообщить(НСтр("ru='Месяц не закрыт!';uk='Місяць не закритий!'"));
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если Объект.ЛицевыеСчета.Количество()>КоличествоВГруппеНаПечать Тогда
		КоличествоКПечати = КоличествоВГруппеНаПечать;
	Иначе
		КоличествоКпечати = КонСтрока - НачСтрока + 1;
	КонецЕсли;
	Ответ = Вопрос(НСтр("ru = ""Будет отправлено " + КоличествоКПечати + " квитанций из " + Объект.ЛицевыеСчета.Количество() + ". Продолжить?"";uk=""Буде відправлено " + КоличествоКПечати + " квітанцій з " + Объект.ЛицевыеСчета.Количество() + ". Продовжити?"""), РежимДиалогаВопрос.ДаНет, 0);
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ГрупповаяОтправка();
	
КонецПроцедуры

