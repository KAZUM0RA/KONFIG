// Функция получает список лицевых счетов из временного хранилища
//
&НаСервере
Процедура ПолучитьЛицевыеСчетаИзХранилища(АдресЛицевыхСчетовВХранилище)
	
	ТаблицаДляЗагрузки	= ПолучитьИзВременногоХранилища(АдресЛицевыхСчетовВХранилище);
	
	Для каждого Строка Из ТаблицаДляЗагрузки Цикл
		НоваяСтрока = Объект.ЛицевыеСчета.Добавить();
		НоваяСтрока.ЛицевойСчет = Строка.ЛицевойСчет;
		НоваяСтрока.АдресЭлектроннойПочты = Строка.ЛицевойСчет.ЭлПочта;
		НоваяСтрока.НомерСотовогоТелефона = Строка.ЛицевойСчет.МобТелефон;
	КонецЦикла;
	
	
КонецПроцедуры // ПолучитьЛицевыеСчетаИзХранилища()

//Функция возвращает истину, если месяц закрыт.
//
&НаСервере
Функция ПроверитьЗакрытиеМесяца()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗакрытиеМесяца.Проведен
	|ИЗ
	|	Документ.ЗакрытиеМесяца КАК ЗакрытиеМесяца
	|ГДЕ
	|	ЗакрытиеМесяца.Организация = &Организация
	|	И ЗакрытиеМесяца.Здание = &Здание
	|	И МЕСЯЦ(ЗакрытиеМесяца.Дата) = &Месяц
	|	И ГОД(ЗакрытиеМесяца.Дата) = &Год";
	
	Запрос.УстановитьПараметр("Год", Год(Объект.МесяцНачислений));
	Запрос.УстановитьПараметр("Здание", Объект.Здание);
	Запрос.УстановитьПараметр("Месяц", Месяц(Объект.МесяцНачислений));
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	
	Результат = Запрос.Выполнить();
	
	Выборка = Результат.Выбрать();
	МесяцЗакрыт = Ложь;
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.Проведен Тогда
			МесяцЗакрыт = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат МесяцЗакрыт;
	
КонецФункции

// Процедура - обработчик события ПриИзменении поля ввода "Здание".
//
&НаКлиенте
Процедура ЗданиеПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Объект.Здание) Тогда
		
		Элементы.Заполнить.Доступность = Истина;
		
	Иначе
		
		Элементы.Заполнить.Доступность = Ложь;
		
	КонецЕсли; 
	
КонецПроцедуры

// Процедура - обработчик события ПриИзменении поля ввода "МесяцНачислений".
//
&НаКлиенте
Процедура МесяцНачисленийПриИзменении(Элемент)
	
	ЭтаФорма.Объект.МесяцНачислений 		= КонецМесяца(ЭтаФорма.Объект.МесяцНачислений);
	ЭтаФорма.ОтображениеПериодаНачисления 	= Формат(ЭтаФорма.Объект.МесяцНачислений, "ДФ='MMMM yyyy'");
	
КонецПроцедуры

// Процедура - обработчик события НачалоВыбора поля ввода "МесяцНачислений".
//
&НаКлиенте
Процедура МесяцНачисленийНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	СтруктураПараметров = Новый Структура("ДатаКалендаря", ?(ЭтаФорма.Объект.МесяцНачислений= Дата('00010101'), ТекущаяДата(), ЭтаФорма.Объект.МесяцНачислений));
	ДатаКалендаряНачало = ОткрытьФормуМодально("ОбщаяФорма.ФормаКалендаря", СтруктураПараметров);
	
	ЭтаФорма.Объект.МесяцНачислений = КонецДня(ДатаКалендаряНачало);
	
	МесяцНачисленийПриИзменении(Элемент);
	
КонецПроцедуры

// Процедура - обработчик события Регулирование поля ввода "МесяцНачислений".
//
&НаКлиенте
Процедура МесяцНачисленийРегулирование(Элемент, Направление, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ЭтаФорма.Объект.МесяцНачислений = ?(ЗначениеЗаполнено(ЭтаФорма.Объект.МесяцНачислений), 
	ДобавитьМесяц(ЭтаФорма.Объект.МесяцНачислений, Направление),
	ДобавитьМесяц(КонецМесяца(ТекущаяДата()), Направление));
	
	МесяцНачисленийПриИзменении(Элемент);
	
КонецПроцедуры

// Процедура - обработчик нажатия на кнопку Печать.
//
&НаКлиенте
Процедура Печать(Команда)
	
	Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
		Сообщить(НСтр("ru='Поле ""Организация"" не заполнено';uk='Полі ""Організація"" не заповнено'"));
		Возврат;
	ИначеЕсли НЕ ЗначениеЗаполнено(Объект.Здание) Тогда
		Сообщить(НСтр("ru='Поле ""Здание"" не заполнено';uk='Полі ""Будівля"" не заповнена'"));
		Возврат;
	ИначеЕсли НЕ ЗначениеЗаполнено(Объект.МесяцНачислений) Тогда
		Сообщить(НСтр("ru='Поле ""МесяцНачислений"" не заполнено';uk='Полі ""МесяцНачислений"" не заповнено'"));
		Возврат;
	Иначе
		МесяцЗакрыт = ПроверитьЗакрытиеМесяца();
		Если НЕ МесяцЗакрыт Тогда
			Сообщить(НСтр("ru='Месяц не закрыт!';uk='Місяць не закритий!'"));
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если Объект.ЛицевыеСчета.Количество()>КоличествоВГруппеНаПечать Тогда
		КоличествоКПечати = КоличествоВГруппеНаПечать;
	Иначе
		КоличествоКпечати = КонСтрока - НачСтрока + 1;
	КонецЕсли;
	Ответ = Вопрос(НСтр("ru = ""Будет напечатано " + КоличествоКПечати + " квитанций из " + Объект.ЛицевыеСчета.Количество() + ". Продолжить?"";uk=""Буде надруковано " + КоличествоКПечати + " квітанцій з " + Объект.ЛицевыеСчета.Количество() + ". Продовжити?"""), РежимДиалогаВопрос.ДаНет, 0);
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ГрупповаяПечать();
	
КонецПроцедуры

