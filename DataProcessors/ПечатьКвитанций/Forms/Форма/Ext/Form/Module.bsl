// Процедура - обработчик события ПриСозданииНаСервере.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	
	Если Параметры.Свойство("РассылкаДоступа") тогда
		ШаблонПисьма = Справочники.ШаблоныТекстовПисем.ШаблонРассылкиДоступовНаСайтХВОЯ;
		АдресСайта = ПолучитьАдресСайтаХвояЖКХ(Объект.Организация);
		Элементы.РазослатьSMS.Видимость = Ложь;
		Элементы.ТаблицаБанковскихСчетов.Видимость = Ложь;
		Элементы.МесяцНачислений.Видимость = Ложь;
		Элементы.УпрощеннаяКвитанция.Видимость = Ложь;
		Элементы.ЛицевыеСчетаПечать.Видимость = Ложь;
		Элементы.Отправить.Видимость = Ложь;
		Элементы.ПрооверитьИОбновитьСатусыСМС1.Видимость = Ложь;
		Элементы.РассылкаДоступов.Видимость = Истина;
	КонецЕсли;
	
	Объект.МесяцНачислений = КонецМесяца(ДобавитьМесяц(ТекущаяДата(),-1));
	
	ОтображениеПериодаНачисления = Формат(ЭтаФорма.Объект.МесяцНачислений, "ДФ='MMMM yyyy'");
	
	Элементы.Заполнить.Доступность = Ложь;
	
	
	Попытка
		СодержаниеПисьма = ПолучитьСодержаниеЭлектронногоПисьма();
		
		
		КолСтрок = СодержаниеПисьма.Количество()-1;
		
		Для Индекс = 0 По КолСтрок Цикл
			
			Если  СодержаниеПисьма[Индекс].Настройка = ПланыВидовХарактеристик.НастройкиПользователей.ЗапаковатьВZIP тогда
				Объект.ЗапаковатьZIP = СодержаниеПисьма[Индекс].Значение;
			ИначеЕсли СодержаниеПисьма[Индекс].Настройка = ПланыВидовХарактеристик.НастройкиПользователей.УпрощеннаяКвитанция Тогда
				УпрощеннаяКвитанция = СодержаниеПисьма[Индекс].Значение;
			ИначеЕсли СодержаниеПисьма[Индекс].Настройка = ПланыВидовХарактеристик.НастройкиПользователей.ФорматHTML Тогда
				Объект.ФорматHTML = СодержаниеПисьма[Индекс].Значение;
			ИначеЕсли СодержаниеПисьма[Индекс].Настройка = ПланыВидовХарактеристик.НастройкиПользователей.ФорматMXL Тогда
				Объект.ФорматMXL = СодержаниеПисьма[Индекс].Значение;
			ИначеЕсли СодержаниеПисьма[Индекс].Настройка = ПланыВидовХарактеристик.НастройкиПользователей.ФорматODS Тогда
				Объект.ФорматODS = СодержаниеПисьма[Индекс].Значение;
			ИначеЕсли СодержаниеПисьма[Индекс].Настройка = ПланыВидовХарактеристик.НастройкиПользователей.ФорматPDF Тогда
				Объект.ФорматPDF = СодержаниеПисьма[Индекс].Значение;	
			ИначеЕсли СодержаниеПисьма[Индекс].Настройка = ПланыВидовХарактеристик.НастройкиПользователей.ФорматXLS Тогда
				Объект.ФорматXLS = СодержаниеПисьма[Индекс].Значение;
			ИначеЕсли СодержаниеПисьма[Индекс].Настройка = ПланыВидовХарактеристик.НастройкиПользователей.ШаблонТекстаПисьма Тогда
				ШаблонПисьма = СодержаниеПисьма[Индекс].Значение;
				ТекстПисьма = ШаблонПисьма.ТекстПисьма;
				ТемаПисьма = ШаблонПисьма.ТемаПисьма;
			ИначеЕсли СодержаниеПисьма[Индекс].Настройка = ПланыВидовХарактеристик.НастройкиПользователей.ШаблонСМС Тогда
				Объект.ШаблонСМС = СодержаниеПисьма[Индекс].Значение;	
			ИначеЕсли СодержаниеПисьма[Индекс].Настройка = ПланыВидовХарактеристик.НастройкиПользователей.ПеревестиВЛатиницу Тогда
				ПеревестиВЛатинскиеСимволы = СодержаниеПисьма[Индекс].Значение;
			КонецЕсли;
		КонецЦикла;	
	Исключение	
	КонецПопытки;

	
	Если КоличествоВГруппеНаПечать = 0 Тогда
		
		КоличествоВГруппеНаПечать = 20;
		
	КонецЕсли;
	
//{{MRG[ <-> ]
//	СсылкаДопПечатнойФормы = ПечатьКвитанцииНаОплату.ПолучитьСсылкуДопПечатнойФормы();
//}}MRG[ <-> ]
КонецПроцедуры

