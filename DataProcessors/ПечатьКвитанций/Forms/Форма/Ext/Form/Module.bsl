&НаКлиенте
Процедура РассылкаДоступовНаСервере()
	//МассивТабличныхДокументов = Новый Массив;
	МассивЛС = Новый Массив;
	Счетчик = 0;
	СчетчикСтатус = 0;
	Осталось = КонСтрока - НачСтрока + 1;
	
	Список = Новый СписокЗначений;
	Список.ТипЗначения = Новый ОписаниеТипов("СправочникСсылка.ЛицевыеСчета");
	
	Для каждого Строка из Объект.ЛицевыеСчета Цикл
		ЛС =Строка.ЛицевойСчет;
		ЭлПочта = ПолучитьСписокЛС(ЛС);
		Месяц = Объект.МесяцНачислений;
		Банки = Объект.БанковскиеСчета;
		
		Если Строка.НомерСтроки <= КонСтрока И Строка.НомерСтроки >= НачСтрока Тогда
			
			Если Счетчик < КоличествоВГруппеНаПечать Тогда
				
				Счетчик = Счетчик + 1;
				Осталось = Осталось - 1;
				
				ОтправитьПоПочте(ЛС,Неопределено,ЭлПочта);
				СчетчикСтатус = СчетчикСтатус+1;
				Состояние(Нстр("ru = 'Выполняется отправка электронной почты'; uk = 'Виконується відправка електронної пошти'"),Окр(СчетчикСтатус/КоличествоВГруппеНаПечать*100));
				
			ИначеЕсли Счетчик = КоличествоВГруппеНаПечать Тогда
				
				Счетчик = 0;
				ОтправитьПоПочте(ЛС,Неопределено,ЭлПочта);
				СчетчикСтатус = СчетчикСтатус+1;
				Состояние(Нстр("ru = 'Выполняется отправка электронной почты'; uk = 'Виконується відправка електронної пошти'"),Окр(СчетчикСтатус/КоличествоВГруппеНаПечать*100));
				
				Если Осталось > КоличествоВГруппеНаПечать Тогда
					КоличествоКПечати = КоличествоВГруппеНаПечать;
				Иначе
					КоличествоКпечати = Осталось;
				КонецЕсли;
				
				Ответ = Вопрос(НСтр("ru = ""Будет напечатано " + КоличествоКПечати + " квитанций из оставшихся " + Осталось + ". Продолжить?"""), РежимДиалогаВопрос.ДаНет, 0);
				Если Ответ <> КодВозвратаДиалога.Да Тогда
					Возврат;
				КонецЕсли;
				
				Счетчик = Счетчик + 1;
				Осталось = Осталось - 1;
				
				Если ЗначениеЗаполнено(ЭлПочта) Тогда
					ОтправитьПоПочте(ЛС,Неопределено,ЭлПочта);
					СчетчикСтатус = СчетчикСтатус+1;
					Состояние(Нстр("ru = 'Выполняется отправка электронной почты'; uk = 'Виконується відправка електронної пошти'"),Окр(СчетчикСтатус/КоличествоВГруппеНаПечать*100));
				Иначе
					Сообщить(НСтр("ru = 'Не заполнен адрес электронной почты. Письмо не отправлено.'; uk = 'Не заповнена адреса електронної пошти. Лист не відправлений.'"));
				КонецЕсли;
			ИначеЕсли НЕ Счетчик < Осталось Тогда
				
				
				
				Если ЗначениеЗаполнено(ЭлПочта) Тогда
					ОтправитьПоПочте(ЛС,Неопределено,ЭлПочта);
					СчетчикСтатус = СчетчикСтатус+1;
					Состояние(Нстр("ru = 'Выполняется отправка электронной почты'; uk = 'Виконується відправка електронної пошти'"),Окр(СчетчикСтатус/КоличествоВГруппеНаПечать*100));
				Иначе
					Сообщить(НСтр("ru = 'Не заполнен адрес электронной почты. Письмо не отправлено.'; uk = 'Не заповнена адреса електронної пошти. Лист не відправлений.'"));
				КонецЕсли;
				
				//МассивТабличныхДокументов.Добавить(ТабДок);
				
			КонецЕсли;
		КонецЕсли;
		МассивЛС.Добавить(Строка.ЛицевойСчет);
	КонецЦикла;
	
	//ПроведениеСервер.ОтразитьОперацииУведомления(МассивЛС,Объект.МесяцНачислений,"ЭлектронноеПисьмо");
	
	Ответ = Вопрос(НСтр("ru = 'Отправка писем завершена.'; uk = 'Відправка листів завершена.'"), РежимДиалогаВопрос.ОК); 

КонецПроцедуры


&НаКлиенте
Процедура РассылкаДоступов(Команда)
	
	Если СокрЛП(АдресСайта) = "" Тогда
		
		Сообщить(НСтр("ru = 'Не введен адрес Вашего сайта'; uk = 'Не введена адреса Вашого сайту'"));
				
	КонецЕсли;	
	
	Если Объект.ЛицевыеСчета.Количество() > КоличествоВГруппеНаПечать Тогда
		КоличествоКПечати = КоличествоВГруппеНаПечать;
	Иначе
		КоличествоКпечати = КонСтрока - НачСтрока + 1;
	КонецЕсли;
	Ответ = Вопрос(НСтр("ru = ""Будет отправлено " + КоличествоКПечати + " сообщений из " + Объект.ЛицевыеСчета.Количество() + ". Продолжить?"";uk=""Буде відправлено " + КоличествоКПечати + " повiдомлень з " + Объект.ЛицевыеСчета.Количество() + ". Продовжити?"""), РежимДиалогаВопрос.ДаНет, 0);
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	РассылкаДоступовНаСервере();
КонецПроцедуры


&НаСервереБезКонтекста
Функция ПолучитьАдресСайтаХвояЖКХ(Организация)
	
	ТаблицаНастройки = Константы.НастройкаОбменДаннымиХвояСайтЖКХ.Получить().Получить();
	Если НЕ ТипЗнч(ТаблицаНастройки) = Тип("ТаблицаЗначений") Тогда
		Возврат "";
	КонецЕсли;
	
	НайденныеСтроки = ТаблицаНастройки.НайтиСтроки(Новый Структура("Организация", Организация));
	Если НайденныеСтроки.Количество() = 0 Тогда
		Возврат "";
	Иначе
		Возврат НайденныеСтроки[0].АдресСайта;	
	КонецЕсли;
	
КонецФункции

