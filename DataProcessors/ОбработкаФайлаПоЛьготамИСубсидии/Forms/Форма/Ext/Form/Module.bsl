&НаСервере
Процедура СформироватьНачисленияНаСервере1()
	тзНачисленияЛьготы = Объект.Выгрузка.Выгрузить();
	Организация = Объект.Организация;
	Для Каждого стр Из тзНачисленияЛьготы Цикл
		Если Объект.Багачка = ЛОЖЬ И СтрЗаменить(Строка(стр.НомерУПСЗН), Символы.НПП, "") <> "1605000" Тогда
			ЛицевойСчет = НайтиЛицевойСчет(СтрЗаменить(Строка(стр.ЛицевойСчет), Символы.НПП, ""));
			Если ЛицевойСчет = Неопределено Тогда
				Сообщить("Не здайдено особового рахунка № " + стр.ЛицевойСчет  + ". ФИО: " + стр.ФИО);  
			КонецЕсли;
			Запрос = Новый Запрос;
			Запрос.Текст =
			    "ВЫБРАТЬ
			    |	РасчетыПоЛицевымСчетамОстаткиИОбороты.СуммаПриход КАК Начислено,
			    |	РасчетыПоЛицевымСчетамОстаткиИОбороты.СуммаКонечныйОстаток КАК КонечныйОстаток
			    |ИЗ
			    |	РегистрНакопления.РасчетыПоЛицевымСчетам.ОстаткиИОбороты(
			    |			&НачалоПериода,
			    |			&КонецПериода,
			    |			Авто,
			    |			,
			    |			Организация = &Организация
			    |				И ЛицевойСчет = &ЛицевойСчет
			    |				И Услуга.ВидУслуги = &Услуга) КАК РасчетыПоЛицевымСчетамОстаткиИОбороты";
			Запрос.УстановитьПараметр("НачалоПериода", НачалоМесяца(Объект.ДатаДокумента)); 
			Запрос.УстановитьПараметр("КонецПериода", КонецМесяца(Объект.ДатаДокумента));
			Запрос.УстановитьПараметр("Организация", Организация);
			Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
			Запрос.УстановитьПараметр("Услуга", Объект.Услуга);
 
			Результат = Запрос.Выполнить();
			Выборка = Результат.Выбрать();
			Пока Выборка.Следующий() Цикл
				Начислено = Выборка.Начислено;
				//КонечныйОстаток = Выборка.КонечныйОстаток;
			КонецЦикла;
			КонечныйОстаток = ОбщийМодульМВК.ПолучитьОстатки(Объект.ДатаДокумента, ЛицевойСчет, Объект.Услуга);
			
			стр.СуммаНасчитаная = Начислено;
			Если КонечныйОстаток = Неопределено Тогда
				КонечныйОстаток = 0;
			КонецЕсли;
			Если КонечныйОстаток <= 0 Тогда
				стр.СуммаКОплате = 0;
			Иначе
			    стр.СуммаКОплате = КонечныйОстаток;
			КонецЕсли;	
		ИначеЕсли Объект.Багачка = Истина И СтрЗаменить(Строка(стр.НомерУПСЗН), Символы.НПП, "") = "1605000" Тогда
			ЛицевойСчет = НайтиЛицевойСчет(СтрЗаменить(Строка(стр.ЛицевойСчет), Символы.НПП, ""));
			Если ЛицевойСчет = Неопределено Тогда
				Сообщить("Не здайдено особового рахунка № " + стр.ЛицевойСчет  + ". ФИО: " + стр.ФИО);  
			КонецЕсли;
			Запрос = Новый Запрос;
			Запрос.Текст =
			    "ВЫБРАТЬ
			    |	РасчетыПоЛицевымСчетамОстаткиИОбороты.СуммаПриход КАК Начислено,
			    |	РасчетыПоЛицевымСчетамОстаткиИОбороты.СуммаКонечныйОстаток КАК КонечныйОстаток
			    |ИЗ
			    |	РегистрНакопления.РасчетыПоЛицевымСчетам.ОстаткиИОбороты(
			    |			&НачалоПериода,
			    |			&КонецПериода,
			    |			Авто,
			    |			,
			    |			Организация = &Организация
			    |				И ЛицевойСчет = &ЛицевойСчет
			    |				И Услуга.ВидУслуги = &Услуга) КАК РасчетыПоЛицевымСчетамОстаткиИОбороты";
			Запрос.УстановитьПараметр("НачалоПериода", НачалоМесяца(Объект.ДатаДокумента)); 
			Запрос.УстановитьПараметр("КонецПериода", КонецМесяца(Объект.ДатаДокумента));
			Запрос.УстановитьПараметр("Организация", Организация);
			Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
			Запрос.УстановитьПараметр("Услуга", Объект.Услуга);
 
			Результат = Запрос.Выполнить();
			Выборка = Результат.Выбрать();
			Пока Выборка.Следующий() Цикл
				Начислено = Выборка.Начислено;
				КонечныйОстаток = Выборка.КонечныйОстаток;
			КонецЦикла;
			
			Если КонечныйОстаток = Неопределено Тогда
				КонечныйОстаток = 0;
			КонецЕсли;
			
			стр.СуммаНасчитаная = Начислено;
			Если КонечныйОстаток <= 0 Тогда
				стр.СуммаКОплате = 0;
			Иначе
			    стр.СуммаКОплате = КонечныйОстаток;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Объект.Выгрузка.Загрузить(тзНачисленияЛьготы);
КонецПроцедуры


&НаСервере
Процедура СформироватьНачисленияНаСервере()
	тзНачисленияЛьготы = Объект.Выгрузка.Выгрузить();
	Организация = Объект.Организация; //ОСМДПовтИсп.ПолучитьЗначениеПоУмолчаниюПользователя(Пользователи.ТекущийПользователь(), "ОсновнаяОрганизация");
	Для Каждого стр Из тзНачисленияЛьготы Цикл
		Если Объект.Багачка = ЛОЖЬ И СтрЗаменить(Строка(стр.НомерУПСЗН), Символы.НПП, "") <> "1605000" Тогда
			ЛС = НайтиЛицевойСчет(СтрЗаменить(Строка(стр.ЛицевойСчет), Символы.НПП, ""));
			Если ЛС = Неопределено Тогда
				Сообщить("Не здайдено особового рахунка за кодом ID. " + стр.ЛицевойСчет  + ". ФИО: " + стр.ФИО);  
			КонецЕсли;
			Запрос = Новый Запрос;
			Запрос.Текст = 
			    "ВЫБРАТЬ
			    |	РасчетыПоЛицевымСчетамОбороты.СуммаРасход
			    |ИЗ
			    |	РегистрНакопления.РасчетыПоЛицевымСчетам.Обороты(&НачалоПериода, &КонецПериода, Авто, ЛицевойСчет = &ЛицевойСчет) КАК РасчетыПоЛицевымСчетамОбороты";
			Запрос.УстановитьПараметр("НачалоПериода", ДобавитьМесяц(НачалоМесяца(Объект.ДатаДокумента), -1));
			Запрос.УстановитьПараметр("КонецПериода", ДобавитьМесяц(КонецМесяца(Объект.ДатаДокумента), -1));
			Запрос.УстановитьПараметр("ЛицевойСчет", ЛС);
			РезультатЗапроса = Запрос.Выполнить();
			Выборка = РезультатЗапроса.Выбрать();
			Оплата = 0;
			Пока Выборка.Следующий() Цикл
				Оплата = Оплата + Выборка.СуммаРасход;
			КонецЦикла;
		
			Запрос = Новый Запрос;
			Запрос.Текст =
			    "ВЫБРАТЬ
			    |	РасчетыПоЛицевымСчетамОстатки.СуммаОстаток,
			    |	РасчетыПоЛицевымСчетамОстатки.МесяцНачисления,
			    |	РасчетыПоЛицевымСчетамОстатки.Услуга
			    |ИЗ
			    |	РегистрНакопления.РасчетыПоЛицевымСчетам.Остатки(&НачалоПериода, ЛицевойСчет = &ЛицевойСчет) КАК РасчетыПоЛицевымСчетамОстатки";
			
			
			Запрос.УстановитьПараметр("НачалоПериода", ДобавитьМесяц(НачалоМесяца(Объект.ДатаДокумента), -1));
			Запрос.УстановитьПараметр("ЛицевойСчет", ЛС);
			Результат = Запрос.Выполнить().Выгрузить();
			Долг = Результат.Итог("СуммаОстаток");
			
			Запрос = Новый Запрос;
			Запрос.Текст =
			    "ВЫБРАТЬ
			    |	РасчетыПоЛицевымСчетамОстаткиИОбороты.СуммаПриход КАК Начислено,
			    |	РасчетыПоЛицевымСчетамОстаткиИОбороты.СуммаКонечныйОстаток КАК КонечныйОстаток
			    |ИЗ
			    |	РегистрНакопления.РасчетыПоЛицевымСчетам.ОстаткиИОбороты(
			    |			&НачалоПериода,
			    |			&КонецПериода,
			    |			Авто,
			    |			,
			    |			Организация = &Организация
			    |				И ЛицевойСчет = &ЛицевойСчет
			    |				И Услуга.ВидУслуги = &Услуга) КАК РасчетыПоЛицевымСчетамОстаткиИОбороты";
			Запрос.УстановитьПараметр("НачалоПериода", НачалоМесяца(Объект.ДатаДокумента)); 
			Запрос.УстановитьПараметр("КонецПериода", КонецМесяца(Объект.ДатаДокумента));
			Запрос.УстановитьПараметр("Организация", Организация);
			Запрос.УстановитьПараметр("ЛицевойСчет", ЛС);
			Запрос.УстановитьПараметр("Услуга", Объект.Услуга);
 
			Результат = Запрос.Выполнить();
			Выборка = Результат.Выбрать();
			Пока Выборка.Следующий() Цикл
				Начислено = Выборка.Начислено;
			КонецЦикла;
			
			стр.СуммаНасчитаная = Начислено;
			КолонкаДолг = 0;
			КолонкаДолг = Долг - Оплата;
			Если КолонкаДолг = 0 Тогда
				стр.СуммаКОплате = стр.СуммаНасчитаная;
			КонецЕсли;
			Если КолонкаДолг < 0 Тогда
				стр.СуммаКОплате = стр.СуммаНасчитаная + КолонкаДолг;
				Если стр.СуммаКОплате <= 0 Тогда
					стр.СуммаКОплате = 0;
				КонецЕсли;
			КонецЕсли;
			Если КолонкаДолг > 0 Тогда
				стр.СуммаКОплате = стр.СуммаНасчитаная + КолонкаДолг;
			КонецЕсли;
			
		ИначеЕсли Объект.Багачка = Истина И СтрЗаменить(Строка(стр.НомерУПСЗН), Символы.НПП, "") = "1605000" Тогда
			ЛС = НайтиЛицевойСчет(СтрЗаменить(Строка(стр.ЛицевойСчет), Символы.НПП, ""));
			Если ЛС = Неопределено Тогда
				Сообщить("Не здайдено особового рахунка за кодом ID. " + стр.ЛицевойСчет  + ". ФИО: " + стр.ФИО);  
			КонецЕсли;
			Запрос = Новый Запрос;
			Запрос.Текст = 
			    "ВЫБРАТЬ
			    |	РасчетыПоЛицевымСчетамОбороты.СуммаРасход
			    |ИЗ
			    |	РегистрНакопления.РасчетыПоЛицевымСчетам.Обороты(&НачалоПериода, &КонецПериода, Авто, ЛицевойСчет = &ЛицевойСчет) КАК РасчетыПоЛицевымСчетамОбороты";
			Запрос.УстановитьПараметр("НачалоПериода", ДобавитьМесяц(НачалоМесяца(Объект.ДатаДокумента), -1));
			Запрос.УстановитьПараметр("КонецПериода", ДобавитьМесяц(КонецМесяца(Объект.ДатаДокумента), -1));
			Запрос.УстановитьПараметр("ЛицевойСчет", ЛС);
			РезультатЗапроса = Запрос.Выполнить();
			Выборка = РезультатЗапроса.Выбрать();
			Оплата = 0;
			Пока Выборка.Следующий() Цикл
				Оплата = Оплата + Выборка.СуммаРасход;
			КонецЦикла;
		
			Запрос = Новый Запрос;
			Запрос.Текст =
			    "ВЫБРАТЬ
			    |	РасчетыПоЛицевымСчетамОстатки.СуммаОстаток,
			    |	РасчетыПоЛицевымСчетамОстатки.МесяцНачисления,
			    |	РасчетыПоЛицевымСчетамОстатки.Услуга
			    |ИЗ
			    |	РегистрНакопления.РасчетыПоЛицевымСчетам.Остатки(&НачалоПериода, ЛицевойСчет = &ЛицевойСчет) КАК РасчетыПоЛицевымСчетамОстатки";
			
			
			Запрос.УстановитьПараметр("НачалоПериода", ДобавитьМесяц(НачалоМесяца(Объект.ДатаДокумента), -1));
			Запрос.УстановитьПараметр("ЛицевойСчет", ЛС);
			Результат = Запрос.Выполнить().Выгрузить();
			Долг = Результат.Итог("СуммаОстаток");
			
			спУслуги = Новый СписокЗначений;
			спУслуги.Добавить(Объект.Услуга);
			спУслуги.Добавить(Справочники.Услуги.НайтиПоКоду("Р00000148"));
			спУслуги.Добавить(Справочники.Услуги.НайтиПоКоду("Р00000190"));
			спУслуги.Добавить(Справочники.Услуги.НайтиПоКоду("Р00000191"));
			спУслуги.Добавить(Справочники.Услуги.НайтиПоКоду("Р00000193"));
			спУслуги.Добавить(Справочники.Услуги.НайтиПоКоду("Р00000215"));
			спУслуги.Добавить(Справочники.Услуги.НайтиПоКоду("Р00000216"));
			Запрос = Новый Запрос;
			Запрос.Текст =
			    "ВЫБРАТЬ
			    |	РасчетыПоЛицевымСчетамОстаткиИОбороты.СуммаПриход КАК Начислено,
			    |	РасчетыПоЛицевымСчетамОстаткиИОбороты.СуммаКонечныйОстаток КАК КонечныйОстаток
			    |ИЗ
			    |	РегистрНакопления.РасчетыПоЛицевымСчетам.ОстаткиИОбороты(
			    |			&НачалоПериода,
			    |			&КонецПериода,
			    |			Авто,
			    |			,
			    |			Организация = &Организация
			    |				И ЛицевойСчет = &ЛицевойСчет
			    |				И Услуга.ВидУслуги В (&Услуга)) КАК РасчетыПоЛицевымСчетамОстаткиИОбороты";
			Запрос.УстановитьПараметр("НачалоПериода", НачалоМесяца(Объект.ДатаДокумента)); 
			Запрос.УстановитьПараметр("КонецПериода", КонецМесяца(Объект.ДатаДокумента));
			Запрос.УстановитьПараметр("Организация", Организация);
			Запрос.УстановитьПараметр("ЛицевойСчет", ЛС);
			Запрос.УстановитьПараметр("Услуга", спУслуги);
 
			Результат = Запрос.Выполнить();
			Выборка = Результат.Выбрать();
			Пока Выборка.Следующий() Цикл
				Начислено = Выборка.Начислено;
			КонецЦикла;
			
			стр.СуммаНасчитаная = Начислено;
			КолонкаДолг = 0;
			КолонкаДолг = Долг - Оплата;
			Если КолонкаДолг = 0 Тогда
				стр.СуммаКОплате = стр.СуммаНасчитаная;
			КонецЕсли;
			Если КолонкаДолг < 0 Тогда
				стр.СуммаКОплате = стр.СуммаНасчитаная + КолонкаДолг;
				Если стр.СуммаКОплате <= 0 Тогда
					стр.СуммаКОплате = 0;
				КонецЕсли;
			КонецЕсли;
			Если КолонкаДолг > 0 Тогда
				стр.СуммаКОплате = стр.СуммаНасчитаная + КолонкаДолг;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Объект.Выгрузка.Загрузить(тзНачисленияЛьготы);
КонецПроцедуры

