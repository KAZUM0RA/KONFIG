
&НаКлиенте
Процедура ФайлЕксельНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	Режим = РежимДиалогаВыбораФайла.Открытие;
	ДиалогОткрытияФайла = Новый ДиалогВыбораФайла(Режим);
	ДиалогОткрытияФайла.ПолноеИмяФайла = Объект.ФайлЕксель;
	Фильтр = "Электронная таблица Excel(*.xlsx)|*.xlsx";
	ДиалогОткрытияФайла.Фильтр = Фильтр;
	ДиалогОткрытияФайла.МножественныйВыбор = Ложь;
	ДиалогОткрытияФайла.Заголовок = НСтр("ru='Выберите файл';uk='Виберіть файл'");
	Если ДиалогОткрытияФайла.Выбрать() Тогда
		Объект.ФайлЕксель = ДиалогОткрытияФайла.ПолноеИмяФайла;
	КонецЕсли;
КонецПроцедуры

// Табличная часть "ЗАГРУЗКИ"

&НаКлиенте
Процедура ЗагрузитьИзФайла(Команда)
	Путь = Объект.ФайлЕксель;
	Объект.Выгрузка.Очистить();
	Попытка
		Excel = Новый COMОбъект("Excel.application");	
	Исключение
		Сообщить(НСтр("ru='Не удалось подключиться';uk='Не вдалося підключитися'") + информацияОбОшибке());
		Возврат;
	КонецПопытки;
	Excel.Workbooks.Open(Путь);
	Sheet = Excel.Sheets(1);
	Sheet = Excel.ActiveWorkbook;
	КоличествоСтрок = Excel.ActiveSheet.UsedRange.Rows.Count();//Excel.Cells.CurrentRegion.Rows.Count;
	
	Для Счетчик = 7 По КоличествоСтрок Цикл
		НоваяСтрока                   = Объект.Выгрузка.Добавить();
		НоваяСтрока.НомерУПСЗН        = Excel.Cells(Счетчик, 1).Value;
		НоваяСтрока.IDУчетнойЗаписи   = Excel.Cells(Счетчик, 2).Value;
		НоваяСтрока.ФИО               = Excel.Cells(Счетчик, 3).Value;
		НоваяСтрока.ЛицевойСчет       = Excel.Cells(Счетчик, 4).Value;
		НоваяСтрока.СуммаНасчитаная   = Excel.Cells(Счетчик, 5).Value;
		НоваяСтрока.СуммаКОплате      = Excel.Cells(Счетчик, 6).Value;
		НоваяСтрока.ОплаченнаяСумма   = Excel.Cells(Счетчик, 7).Value;
	КонецЦикла;
	
	Excel.Workbooks.Close();
	Excel.Quit();
КонецПроцедуры

&НаСервере
Процедура СохранитьВыпискуНаСервере()
	Для Каждого Строка Из Объект.Загрузка Цикл
		Если Объект.Багачка = Ложь И СтрЗаменить(Строка(Строка.НомерУПСЗН), Символы.НПП, "") <> "1605000" Тогда
			Если Строка.ОплаченнаяСумма <> 0 Тогда
				Док = Документы.ПоступлениеНаСчет.СоздатьДокумент();
				Док.БанковскийСчет = Объект.БанковскийСчет;
				Док.Организация    = Объект.Организация;
				Док.Дата           = Объект.ДатаДокумента;
				Если Объект.ТипФайла = "Льготы" Тогда
				    Док.ВидНачисления = Перечисления.ВидыНачислений.Льгота;
				ИначеЕсли Объект.ТипФайла = "Субсидии" Тогда
					Док.ВидНачисления = Перечисления.ВидыНачислений.Субсидия;
				КонецЕсли;
				Док.ВидОперации    = Перечисления.ВидыОперацийПоступлениеНаСчет.ОтЛицевогоСчета;
				Док.ДатаВходящегоДокумента = Объект.ДатаДокумента;
				Док.ЛицевойСчет    = НайтиЛицевойСчет(СтрЗаменить(Строка(Строка.ЛицевойСчет), Символы.НПП, ""));
				Если Док.ЛицевойСчет = Неопределено Тогда
					Сообщить("Не здайдено особового рахунка: " + Строка.ЛицевойСчет  + ". ФИО: " + Строка.ФИО + " ID = " + Строка.IDУчетнойЗаписи);
				    Возврат;	
				КонецЕсли;
				Док.СуммаДокумента = Строка.ОплаченнаяСумма;
				Док.Комментарий    = Объект.ТипФайла;
				Док.РасшифровкаПлатежаСписком = Истина;
				НоваяСтрока = Док.РасшифровкаПлатежа.Добавить();
				НоваяСтрока.ПризнакАванса = Истина;
				НоваяСтрока.Сумма = Строка.ОплаченнаяСумма;
				Попытка
					Док.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
				Исключение
					Док.Записать();
					Сообщение = Новый СообщениеПользователю;
					Сообщение.Текст = "Документ не вдалося провести. (Рядок №" + Строка.НомерСтроки + ")";
					Сообщение.Сообщить();
				КонецПопытки;
			КонецЕсли;
		ИначеЕсли Объект.Багачка = Истина И СтрЗаменить(Строка(Строка.НомерУПСЗН), Символы.НПП, "") = "1605000" Тогда
			Если Строка.ОплаченнаяСумма <> 0 Тогда
				Док = Документы.ПоступлениеНаСчет.СоздатьДокумент();
				Док.БанковскийСчет = Объект.БанковскийСчет;
				Док.Организация    = Объект.Организация;
				Док.Дата           = Объект.ДатаДокумента;
				Если Объект.ТипФайла = "Льготы" Тогда
				    Док.ВидНачисления = Перечисления.ВидыНачислений.Льгота;
				ИначеЕсли Объект.ТипФайла = "Субсидии" Тогда
					Док.ВидНачисления = Перечисления.ВидыНачислений.Субсидия;
				КонецЕсли;
				Док.ВидОперации    = Перечисления.ВидыОперацийПоступлениеНаСчет.ОтЛицевогоСчета;
				Док.ДатаВходящегоДокумента = Объект.ДатаДокумента;
				Док.ЛицевойСчет    = НайтиЛицевойСчет(СтрЗаменить(Строка(Строка.ЛицевойСчет), Символы.НПП, ""));
				Если Док.ЛицевойСчет = Неопределено Тогда
					Сообщить("Не здайдено особового рахунка за кодом ID. " + Строка.ЛицевойСчет  + ". ФИО: " + Строка.ФИО + " ID = " + Строка.IDУчетнойЗаписи);
					Возврат;
				КонецЕсли;
				Док.СуммаДокумента = Строка.ОплаченнаяСумма;
				Док.Комментарий    = Объект.ТипФайла;
				Док.РасшифровкаПлатежаСписком = Истина;
				НоваяСтрока = Док.РасшифровкаПлатежа.Добавить();
				НоваяСтрока.ПризнакАванса = Истина;
				НоваяСтрока.Сумма = Строка.ОплаченнаяСумма;
				Попытка
					Док.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
				Исключение
					Док.Записать();
					Сообщение = Новый СообщениеПользователю;
					Сообщение.Текст = "Документ не вдалося провести. (Рядок №" + Строка.НомерСтроки + ")";
					Сообщение.Сообщить();
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура СохранитьВыписку(Команда)
	СохранитьВыпискуНаСервере();
КонецПроцедуры



