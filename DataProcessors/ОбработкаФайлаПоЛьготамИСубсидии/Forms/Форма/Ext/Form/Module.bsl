	СформироватьНачисленияНаСервере();
КонецПроцедуры

&НаСервере
Функция НайтиЛицевойСчет(ЛицевойСчет)
	Запрос = Новый Запрос;
	Запрос.Текст = 
	    "ВЫБРАТЬ
	    |	ЛицевыеСчетаСрезПоследних.ЛицевойСчет КАК ЛицевойСчет
	    |ИЗ
	    |	РегистрСведений.ЛицевыеСчета.СрезПоследних(
	    |			&НаДату,
	    |			ЛицевойСчет.Наименование = &Наименование
	    |				И Действует = ИСТИНА) КАК ЛицевыеСчетаСрезПоследних";
	Запрос.УстановитьПараметр("НаДату", Новый Граница(ТекущаяДата(), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Наименование", ЛицевойСчет);
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		ЛС = Выборка.ЛицевойСчет;
	КонецЦикла;
	Возврат ЛС;
КонецФункции

&НаКлиенте
Процедура СохранитьВФайл(Команда)
	Если Объект.Выгрузка.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Путь = Объект.ФайлЕксель;
	Попытка
		Excel = Новый COMОбъект("Excel.application");	
	Исключение
		Сообщить(НСтр("ru='Не удалось подключиться';uk='Не вдалося підключитися'") + информацияОбОшибке());
		Возврат;
	КонецПопытки;
	Книга = Excel.WorkBooks.Open(Путь);
	////Зададим первому листу имя
	Лист = Книга.WorkSheets(1);
	СчетчикСтрок = 7; //Заполнение ТЧ начинаем с седьмой строки

	Попытка
		Для Каждого ТекСтрока Из Объект.Выгрузка Цикл
			//Excel.Cells(СчетчикСтрок, 1).Value 			= СтрЗаменить(Строка(ТекСтрока.НомерУПСЗН), Символы.НПП, "");
			//Excel.Cells(СчетчикСтрок, 2).Value 			= СтрЗаменить(Строка(ТекСтрока.IDУчетнойЗаписи), Символы.НПП, "");
			//Excel.Cells(СчетчикСтрок, 3).Value 			= Строка(ТекСтрока.ФИО);
			//Excel.Cells(СчетчикСтрок, 4).Value 			= СтрЗаменить(Строка(ТекСтрока.ЛицевойСчет), Символы.НПП, "");
			Excel.Cells(СчетчикСтрок, 5).Value 			= ТекСтрока.СуммаНасчитаная;
			Excel.Cells(СчетчикСтрок, 6).Value 			= ТекСтрока.СуммаКОплате;
			//Excel.Cells(СчетчикСтрок, 7).Value 			= ТекСтрока.ОплаченнаяСумма;
			СчетчикСтрок = СчетчикСтрок + 1;
		КонецЦикла;
		
	Исключение
		Excel.Quit();
		Сообщить(информацияОбОшибке());
		Возврат;
	КонецПопытки;
	
	Попытка
		Книга.SaveAs(Путь);
		Сообщить("Файл " + Путь + " успешно сохранен"); 
	Исключение
		Excel.Quit();
		Сообщить("Файл не сохранен!");
		Возврат;
	КонецПопытки;
	
	Попытка			
		Excel.Quit();
	Исключение			
		Сообщить(информацияОбОшибке());
		Возврат;
	КонецПопытки;
КонецПроцедуры

&НаСервере
Функция НайтиЛСЛьготника(ИД)
	Запрос = Новый Запрос;
	Запрос.Текст = 
	    "ВЫБРАТЬ
	    |	СведенияОПрописанныхЖильцахСрезПоследних.ЛицевойСчет
	    |ИЗ
	    |	РегистрСведений.СведенияОПрописанныхЖильцах.СрезПоследних(
	    |			&НаДату,
	    |			Жилец.ИДЛьготы = &ИДЛьготы
	    |				И Прописан = ИСТИНА) КАК СведенияОПрописанныхЖильцахСрезПоследних";

	Запрос.УстановитьПараметр("НаДату", Новый Граница(ТекущаяДата(), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("ИДЛьготы", ИД);
	тзЛС = Запрос.Выполнить().Выгрузить();
	Если тзЛС.Количество() <> 0 Тогда
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл
			ЛС = Выборка.ЛицевойСчет;
		КонецЦикла;
	    Возврат ЛС;
	Иначе
		Запрос = Новый Запрос;
		Запрос.Текст = 
		    "ВЫБРАТЬ
		    |	ЛицевыеСчетаСрезПоследних.ЛицевойСчет КАК ЛицевойСчет
		    |ИЗ
		    |	РегистрСведений.ЛицевыеСчета.СрезПоследних КАК ЛицевыеСчетаСрезПоследних
		    |ГДЕ
		    |	ЛицевыеСчетаСрезПоследних.Регистратор.ОтветственныйВладелец.ФизЛицо.ИДЛьготы = &ИДЛьготы";
		Запрос.УстановитьПараметр("ИДЛьготы", ИД);
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл
			ЛС = Выборка.ЛицевойСчет;
		КонецЦикла;
	    Возврат ЛС;
	КонецЕсли;	
КонецФункции

