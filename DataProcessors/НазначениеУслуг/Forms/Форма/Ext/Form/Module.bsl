&НаКлиенте
Процедура ФайлПослугиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	Режим = РежимДиалогаВыбораФайла.Открытие;
	ДиалогОткрытияФайла = Новый ДиалогВыбораФайла(Режим);
	ДиалогОткрытияФайла.ПолноеИмяФайла = Объект.ФайлПослуги;
	Фильтр = "Электронная таблица Excel(*.xlsx)|*.xlsx";
	ДиалогОткрытияФайла.Фильтр = Фильтр;
	ДиалогОткрытияФайла.МножественныйВыбор = Ложь;
	ДиалогОткрытияФайла.Заголовок = НСтр("ru='Выберите файл';uk='Виберіть файл'");
	Если ДиалогОткрытияФайла.Выбрать() Тогда
		Объект.ФайлПослуги = ДиалогОткрытияФайла.ПолноеИмяФайла;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьУслуги(Команда)
	Путь = Объект.ФайлПослуги;
	Если НЕ ЗначениеЗаполнено(Объект.ФайлПослуги) Тогда
		Сообщить(НСтр("ru='Укажите путь к файлу.';uk='Вкажіть шлях до файлу.'"));
		Возврат;
	КонецЕсли;
	Если Объект.ТабличнаяЧастьУслуги.Количество() > 0 Тогда
		Ответ = Вопрос(НСтр("ru='Табличная часть будет очищена! Продолжить выполнение операции?';uk='Таблична частина буде очищена! Продовжити виконання операції'"), РежимДиалогаВопрос.ДаНет, 0);
		Если Ответ <> КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли; 
	КонецЕсли;
	Объект.ТабличнаяЧастьУслуги.Очистить();
	Попытка
		Excel = Новый COMОбъект("Excel.application");	
	Исключение
		Сообщить(НСтр("ru='Не удалось подключиться';uk='Не вдалося підключитися'") + информацияОбОшибке());
		Возврат;
	КонецПопытки;
	
	Excel.Workbooks.Open(Путь);
	Sheet = Excel.Sheets(1);
	Sheet = Excel.ActiveWorkbook;
	КоличествоСтрок = Excel.ActiveSheet.UsedRange.Rows.Count();//Excel.Cells.CurrentRegion.Rows.Count;
	
	Для Счетчик = 2 По КоличествоСтрок Цикл
		НоваяСтрока                  = Объект.ТабличнаяЧастьУслуги.Добавить();
		НоваяСтрока.Адрес            = Excel.Cells(Счетчик, 1).Value;
		НоваяСтрока.УслугаСтарая     = Excel.Cells(Счетчик, 2).Value;
		НоваяСтрока.ЛицевойСчет      = Excel.Cells(Счетчик, 3).Value;
		НоваяСтрока.Услуга1          = Excel.Cells(Счетчик, 4).Value;
		НоваяСтрока.Услуга2          = Excel.Cells(Счетчик, 5).Value;
		НоваяСтрока.Услуга3          = Excel.Cells(Счетчик, 6).Value;
		НоваяСтрока.Услуга4          = Excel.Cells(Счетчик, 7).Value;
		НоваяСтрока.Услуга5          = Excel.Cells(Счетчик, 8).Value;
		НоваяСтрока.Услуга6          = Excel.Cells(Счетчик, 9).Value;
		НоваяСтрока.Услуга7          = Excel.Cells(Счетчик, 10).Value;
		НоваяСтрока.Услуга8          = Excel.Cells(Счетчик, 11).Value;
		НоваяСтрока.Услуга9          = Excel.Cells(Счетчик, 12).Value;
		НоваяСтрока.Услуга10         = Excel.Cells(Счетчик, 13).Value;
		НоваяСтрока.Услуга11         = Excel.Cells(Счетчик, 14).Value;
		НоваяСтрока.Услуга12         = Excel.Cells(Счетчик, 15).Value;
	КонецЦикла;
	Excel.Workbooks.Close();
	Excel.Quit();
КонецПроцедуры

