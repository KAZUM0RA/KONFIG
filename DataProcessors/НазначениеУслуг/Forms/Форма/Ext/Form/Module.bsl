&НаСервере
Процедура УстановитьТарифыПоУслугамНаСервере()
	// Создадим тз Зданий из таблицы Услуги
	тзЗдания = Новый ТаблицаЗначений;
	тзЗдания.Колонки.Добавить("Здание",,"Здание");
	тзЗдания.Колонки.Добавить("Число", Новый ОписаниеТипов("Число"), "Число");
	Здание = Справочники.ЗданияИСооружения.ПустаяСсылка();
	Для Каждого стр Из Объект.ТабличнаяЧастьУслуги Цикл
		ЛС = НайтиЛицевойСчет(СтрЗаменить(Строка(стр.ЛицевойСчет), Символы.НПП, ""));
		Если ЛС <> Неопределено Тогда
			Здание_ = ЛС.Владелец;
			Если Здание <> Здание_ Тогда
				НовСтрока = тзЗдания.Добавить();
				НовСтрока.Число = 1;
				НовСтрока.Здание = Здание_;
				Здание = Здание_;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	тзЗдания.Свернуть("Здание", "Число");
	
	Для Каждого стрЗдания Из тзЗдания Цикл
		Запрос = Новый Запрос;
		Запрос.Текст =
		    "ВЫБРАТЬ
		    |	УправлениеТарифами.Ссылка
		    |ИЗ
		    |	Документ.УправлениеТарифами КАК УправлениеТарифами
		    |ГДЕ
		    |	УправлениеТарифами.Дата МЕЖДУ &ДатаНач И &ДатаКон
		    |	И УправлениеТарифами.Проведен = ИСТИНА
		    |	И УправлениеТарифами.Здание = &Здание";
		Запрос.УстановитьПараметр("ДатаНач", НачалоДня(Объект.ДатаНазначенияТарифа));
		Запрос.УстановитьПараметр("ДатаКон", КонецДня(Объект.ДатаНазначенияТарифа));
		Запрос.УстановитьПараметр("Здание",стрЗдания.Здание);
		Результат = Запрос.Выполнить();
		Если НЕ Результат.Пустой() Тогда
			Выборка = Результат.Выбрать();
			Пока Выборка.Следующий()Цикл
				Отбор = Новый Структура;
				Отбор.Вставить("Услуга", Справочники.Услуги.НайтиПоКоду("000000048"));
				Док = Выборка.Ссылка.ПолучитьОбъект();
				ТаблицаТарифы = Док.Тарифы;
				МассивСтрок = ТаблицаТарифы.НайтиСтроки(Отбор);
				Для Каждого стрТариф Из МассивСтрок Цикл
					стрТариф.ЗначениеТарифа = 22.92;
					стрТариф.ЗначениеТарифаЛьгота = 22.92;
				КонецЦикла;
				Попытка
				    Док.Записать(РежимзаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
				Исключение
					Док.Записать();
					Сообщить("Не удалось записать документ " + Док.Ссылка);
				КонецПопытки;
			КонецЦикла;		
		КонецЕсли;
		
		// Отменим закрытие месяца
		ЗапросЗакрМес = Новый Запрос;
		ЗапросЗакрМес.Текст = 
		    "ВЫБРАТЬ
		    |	ЗакрытиеМесяца.Ссылка
		    |ИЗ
		    |	Документ.ЗакрытиеМесяца КАК ЗакрытиеМесяца
		    |ГДЕ
		    |	ЗакрытиеМесяца.Проведен = ИСТИНА
		    |	И ЗакрытиеМесяца.Здание = &Здание
		    |	И ЗакрытиеМесяца.Дата = &Дата";
		ЗапросЗакрМес.УстановитьПараметр("Здание", стрЗдания.Здание);
		ЗапросЗакрМес.УстановитьПараметр("Дата", КонецМесяца(Объект.ДатаНазначенияТарифа));
		Результат = ЗапросЗакрМес.Выполнить();
		Если НЕ Результат.Пустой() Тогда
			Выборка = Результат.Выбрать();
			Пока Выборка.Следующий() Цикл
			    ОбъектЗакрМес = Выборка.Ссылка.ПолучитьОбъект();
				ОбъектЗакрМес.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			КонецЦикла;
		КонецЕсли;
		
		// Проведем переначисление по лицевому счету
		ЗапросНачисления = Новый Запрос;
		ЗапросНачисления.Текст =
		    "ВЫБРАТЬ
		    |	НачислениеПоЛС.Ссылка,
		    |	НачислениеПоЛС.Проведен
		    |ИЗ
		    |	Документ.НачислениеПоЛС КАК НачислениеПоЛС
		    |ГДЕ
		    |	НачислениеПоЛС.ПериодНачисления = &ПериодНачисления
		    |	И НачислениеПоЛС.Проведен = ИСТИНА
		    |	И НачислениеПоЛС.Здание = &Здание";
		ЗапросНачисления.УстановитьПараметр("ПериодНачисления", НачалоМесяца(Объект.ДатаНазначенияТарифа));
		ЗапросНачисления.УстановитьПараметр("Здание", стрЗдания.Здание);
		Результат = ЗапросНачисления.Выполнить();
		Если Не Результат.Пустой() Тогда
			Выборка = Результат.Выбрать();
			Пока Выборка.Следующий() Цикл
				ОбъектНачисления = Выборка.Ссылка.ПолучитьОбъект();
				ОбъектНачисления.Записать(РежимЗаписиДокумента.ОтменаПроведения);
				ОбъектНачисления.ЗаполнитьАвтоматическиНаСервере();
				Попытка
				    ОбъектНачисления.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
				Исключение
					Сообщить("Не вдалося провести документ начисление " + ОбъектНачисления.Ссылка);
				КонецПопытки;	
			КонецЦикла;
		КонецЕсли;
		
		Если ОбъектНачисления.Проведен = Истина Тогда
			Попытка
			    ОбъектЗакрМес.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
			Исключение
				Сообщить("Не вдалося провести документ закрытие меняца " + ОбъектЗакрМес.Ссылка);
			КонецПопытки;
        КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура УстановитьТарифыПоУслугам(Команда)
	Если Объект.ТабличнаяЧастьУслуги.Количество() = 0 Тогда
		Сообщить("Таблиця ""Послуги"" пуста. Заповнення не можливе!");
		Возврат;
	КонецЕсли;
	Если Объект.ТабличнаяЧастьТарифы.Количество() = 0 Тогда
		Сообщить("Таблиця ""Тарифи"" пуста. Заповнення не можливе!");
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.ДатаНазначенияТарифа) Тогда
		Сообщить("Дата призначення тарифа пуста!");
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.ДатаНазначенияУслуги) Тогда
		Сообщить("Дата призначення послуги пуста");
		Возврат;
	КонецЕсли;
	УстановитьТарифыПоУслугамНаСервере();
КонецПроцедуры

&НаСервере
Функция НайтиЛицевойСчет(ЛицевойСчет)
	Запрос = Новый Запрос;
	Запрос.Текст = 
	    "ВЫБРАТЬ
	    |	ЛицевыеСчетаСрезПоследних.ЛицевойСчет КАК ЛицевойСчет
	    |ИЗ
	    |	РегистрСведений.ЛицевыеСчета.СрезПоследних(&НаДату, ЛицевойСчет.Наименование = &ЛицевойСчет И Действует = ИСТИНА) КАК ЛицевыеСчетаСрезПоследних";
	Запрос.УстановитьПараметр("НаДату", Новый Граница(ТекущаяДата(), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		ЛС = Выборка.ЛицевойСчет;
	КонецЦикла;
	Возврат ЛС;
КонецФункции
