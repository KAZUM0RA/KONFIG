&НаСервере
Процедура СторнироватьВсеДокументы(ЛС,Месяц)
	
	//ТабОтбора = Объект.Таблица.Выгрузить(,"ЛицевойСчет");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	НачислениеПениПоЛС.Ссылка,
		|	НачислениеПениПоЛС.Сумма
		|ИЗ
		|	Документ.НачислениеПениПоЛС КАК НачислениеПениПоЛС
		|ГДЕ
		|	НачислениеПениПоЛС.Проведен = ИСТИНА
		|	И НачислениеПениПоЛС.Здание = &Здание
		|	И НачислениеПениПоЛС.ЛицевойСчет = &ЛицевыеСчета
		|	И НачислениеПениПоЛС.МесяцНачисления = &МесяцНачисления";
	
	Запрос.УстановитьПараметр("Здание",Объект.Здание);
	Запрос.УстановитьПараметр("ЛицевыеСчета",ЛС);
	Запрос.УстановитьПараметр("МесяцНачисления",Месяц);
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		НовыйДокумент = ВыборкаДетальныеЗаписи.Ссылка.Скопировать();
		НовыйДокумент.Дата =Объект.ДатаДокументов;
		НовыйДокумент.ПериодНачисления =НачалоМесяца(Объект.ДатаДокументов);
		НовыйДокумент.Сумма = -НовыйДокумент.Сумма;
		НовыйДокумент.Записать(РежимЗаписиДокумента.Проведение);
