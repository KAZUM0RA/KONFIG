&НаСервереБезКонтекста
Функция ПолучитьПлатежь(ЛицевойСчет,Дата,МесяцНачисления)
	

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПоступлениеНаСчетРасшифровкаПлатежа.Ссылка
	               |ИЗ
	               |	Документ.ПоступлениеНаСчет.РасшифровкаПлатежа КАК ПоступлениеНаСчетРасшифровкаПлатежа
	               |ГДЕ
	               |	НАЧАЛОПЕРИОДА(ПоступлениеНаСчетРасшифровкаПлатежа.Ссылка.Дата, ДЕНЬ) = НАЧАЛОПЕРИОДА(&Дата, ДЕНЬ)
	               |	И ПоступлениеНаСчетРасшифровкаПлатежа.Ссылка.Проведен = ИСТИНА
	               |	И ПоступлениеНаСчетРасшифровкаПлатежа.Ссылка.ЛицевойСчет = &ЛицевойСчет
	               |	И НАЧАЛОПЕРИОДА(ПоступлениеНаСчетРасшифровкаПлатежа.МесяцНачисления, МЕСЯЦ) = НАЧАЛОПЕРИОДА(&МесяцНачисления, МЕСЯЦ)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ПоступлениеНаСчетРасшифровкаПлатежа.Ссылка";
	ЗАпрос.УстановитьПараметр("Дата",ДАТА);
	ЗАпрос.УстановитьПараметр("ЛицевойСчет",ЛицевойСчет);
	ЗАпрос.УстановитьПараметр("МесяцНачисления",МесяцНачисления);
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли;	
	

КонецФункции // ПолучитьПлатежь()


