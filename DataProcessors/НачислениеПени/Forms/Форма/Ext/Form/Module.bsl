&НаСервере
Функция ПолучитьСтаруюПеню()
	
	ЗАпрос = Новый Запрос;
	ЗАпрос.Текст = "ВЫБРАТЬ
	               |	РасчетыПоЛицевымСчетамОстаткиИОбороты.ЛицевойСчет,
	               |	СУММА(РасчетыПоЛицевымСчетамОстаткиИОбороты.СуммаПриход) КАК Сумма,
	               |	РасчетыПоЛицевымСчетамОстаткиИОбороты.Регистратор.МесяцНачисления КАК МесяцНачисления
	               |ИЗ
	               |	РегистрНакопления.РасчетыПоЛицевымСчетам.ОстаткиИОбороты(, , Регистратор, , ЛицевойСчет.Владелец = &Владелец) КАК РасчетыПоЛицевымСчетамОстаткиИОбороты
	               |ГДЕ
	               |	РасчетыПоЛицевымСчетамОстаткиИОбороты.Услуга = &Услуга
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	РасчетыПоЛицевымСчетамОстаткиИОбороты.ЛицевойСчет,
	               |	РасчетыПоЛицевымСчетамОстаткиИОбороты.Регистратор.МесяцНачисления";
	
	ЗАпрос.УстановитьПараметр("Услуга",Справочники.Услуги.ПениШтрафы);
	ЗАпрос.УстановитьПараметр("Владелец",Объект.Здание);
	//ЗАпрос.УстановитьПараметр("МесяцНачисления",НачалоМесяца(МесяцНачисления));
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Возврат 0;
	КонецЕсли;	
	
	Выборка = Результат.Выгрузить();
	
	
	
	Возврат Выборка;
	
	
	
КонецФункции

