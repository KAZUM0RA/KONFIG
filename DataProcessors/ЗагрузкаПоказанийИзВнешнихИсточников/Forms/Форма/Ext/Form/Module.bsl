	//	Возврат;
	//КонецЕсли;
	
	ЗаполнитьПриборыНаСервере(,?(ЗначениеЗаполнено(ЛицевойСчет),Истина,ЛОЖЬ));
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПриборыСОтбором(Команда)
	
	Отказ = ПроверитьДатуВвода();
	//Если Отказ Тогда
	//	
	//	Сообщение = Новый СообщениеПользователю;
	//	Сообщение.Текст = НСТР("ru = 'Дата ввода показаний не соответствует выбранному периоду. Укажите дату в пределах периода начисления.'; uk = 'Дата введення показникiв не відповідає вибраному періоду. Вкажіть дату в межах періоду нарахування.'");
	//	Сообщение.Поле = "ДатаВвода";
	//	Сообщение.Сообщить(); 
	//	Возврат;
	//КонецЕсли;
	ПараметрыЗаполнения = Новый Структура;
	
	ПараметрыЗаполнения.Вставить("ДатаНачала",		НачалоМесяца(ПериодНачисления));
	ПараметрыЗаполнения.Вставить("ДатаОкончания",	КонецМесяца(ПериодНачисления));

		
	АдресЛицевыхСчетовВХранилище = ОткрытьФормуМодально("ОбщаяФорма.ФормаПодбораЛицевыхСчетов", ПараметрыЗаполнения);
	
	Если ЗначениеЗаполнено(АдресЛицевыхСчетовВХранилище) Тогда
		
		ЗаполнитьПриборыНаСервере(АдресЛицевыхСчетовВХранилище);
		
	КонецЕсли;
	
	
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьИзФайла(Команда)
	
	Отказ = ПроверитьДатуВвода();
	Если Отказ Тогда
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСТР("ru = 'Дата ввода показаний не соответствует выбранному периоду. Укажите дату в пределах периода начисления.'; uk = 'Дата введення показникiв не відповідає вибраному періоду. Вкажіть дату в межах періоду нарахування.'");
		Сообщение.Поле = "ДатаВвода";
		Сообщение.Сообщить(); 
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ПутьКФайлу) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru = 'Не выбран файл для загрузки.'; uk = 'Не вибраний файл для завантаження.'");
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	ТаблицаПоказаний.Очистить();
	
	
	 Попытка
		Excel = Новый COMОбъект("Excel.application");	
	Исключение
		Сообщить("Не удалось подключиться" + информацияОбОшибке());
		Возврат;
	КонецПопытки;
	
	Excel.Workbooks.Open(ПутьКФайлу);
	
	Excel.Sheets(1).select();
	КоличествоСтрок = Excel.Cells.CurrentRegion.Rows.Count;
	ЕстьНеНайденные = Ложь;
	Для Счетчик=2 По КоличествоСтрок Цикл
		СтруктураПрибора =  ПриборУчетаПоиск(СокрЛП(Excel.Cells(Счетчик, 1).Value),СокрЛП(Excel.Cells(Счетчик, 2).Value));
		Если СтруктураПрибора.ПриборУчета <> Неопределено Тогда
			
			    НоваяСтрока = ТаблицаПоказаний.Добавить();
				НоваяСтрока.ПриборУчета = СтруктураПрибора.ПриборУчета;
				НоваяСтрока.ВидТарифа = СтруктураПрибора.ВидТарифа;	
				НоваяСтрока.ПоказаниеТекущее =   Excel.Cells(Счетчик, 3).Value;
				
		Иначе
			
			    НоваяСтрока = ТаблицаПоказаний.Добавить();
				НоваяСтрока.ПриборУчетаСтрока = СокрЛП(Excel.Cells(Счетчик, 1).Value);	
				НоваяСтрока.ПоказаниеТекущее =   Excel.Cells(Счетчик, 3).Value;
				НоваяСтрока.НеНайден = Истина;
				ЕстьНеНайденные = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Excel.Workbooks.Close();
	
	Если ЕстьНеНайденные Тогда
		Элементы.ТаблицаПоказаний.ОтборСтрок = Новый ФиксированнаяСтруктура("НеНайден",Истина);
		Элементы.ТаблицаПоказанийЗаполнитьПриборы.Видимость = Истина;
		Элементы.ТаблицаПоказанийЗаполнитьПриборыСОтбором.Видимость = Ложь;
		Элементы.ТаблицаПоказанийЗаписатьИндивидуальныеПоказания.Видимость = Ложь;
	КонецЕсли;	
	//ЗаполнитьТаблицуПоказаний();
	Если ТаблицаПоказаний.Количество() <> 0 Тогда
		Элементы.ЗаписатьПоказания.Доступность = Истина;
		Элементы.ЗаписатьПоказания.КнопкаПоУмолчанию = Истина;
		Элементы.ЗаполнитьИзФайла.КнопкаПоУмолчанию = Ложь;
	КонецЕсли;	
		

	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПриборУчетаПоиск(ПУ_Строка,стВидТарифа)

	СтруктураВозврата = Новый Структура;
	
	
	//Поиск по наименованию
	ПриборВозврат  = Неопределено;
	Прибор = Справочники.ПриборыУчета.НайтиПоНаименованию(ПУ_Строка);
	Если Прибор <> Справочники.ПриборыУчета.ПустаяСсылка() тогда
		ПриборВозврат= Прибор;
	Иначе
		//Поиск с удалением пропусков в строке
		ПриборСтрока = СтрЗаменить(ПУ_Строка," ","");
	    Прибор = Справочники.ПриборыУчета.НайтиПоНаименованию(ПриборСтрока);
		Если Прибор <> Справочники.ПриборыУчета.ПустаяСсылка() Тогда
			ПриборВозврат = Прибор;
		Иначе
			ПриборВозврат = Неопределено;
		КонецЕсли;	
	КонецЕсли;	

	ВидТарифа = Перечисления.ВидыТарифов.Общий;
	Если стВидТарифа = "Общий" или стВидТарифа = "Загальний" Тогда
		ВидТарифа = Перечисления.ВидыТарифов.Общий;
	КонецЕсли;
	
	Если стВидТарифа = "Дневной" или стВидТарифа = "Денний" Тогда
		ВидТарифа = Перечисления.ВидыТарифов.Дневной;
	КонецЕсли;
	Если стВидТарифа = "Ночной" или стВидТарифа = "Нічний" Тогда
		ВидТарифа = Перечисления.ВидыТарифов.Ночной;
	КонецЕсли;
	Если стВидТарифа = "Пиковый" или стВидТарифа = "Піковий" Тогда
		ВидТарифа = Перечисления.ВидыТарифов.Пиковый;
	КонецЕсли;
	
	СтруктураВозврата.Вставить("ПриборУчета",ПриборВозврат);
	СтруктураВозврата.Вставить("ВидТарифа",ВидТарифа);
	
	Возврат СтруктураВозврата;
КонецФункции 

