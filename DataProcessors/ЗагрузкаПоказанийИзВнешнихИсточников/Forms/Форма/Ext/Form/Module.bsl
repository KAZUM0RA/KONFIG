	Отказ = ПроверитьДатуВвода();
	//Если Отказ Тогда
	//	
	//	Сообщение = Новый СообщениеПользователю;
	//	Сообщение.Текст = НСТР("ru = 'Дата ввода показаний не соответствует выбранному периоду. Укажите дату в пределах периода начисления.'; uk = 'Дата введення показникiв не відповідає вибраному періоду. Вкажіть дату в межах періоду нарахування.'");
	//	Сообщение.Поле = "ДатаВвода";
