
&НаКлиенте
Процедура ОтражениеПериодаНачисленияПриИзменении(Элемент)
	ЭтаФорма.ПериодНачисления 		= КонецМесяца(ЭтаФорма.ПериодНачисления);
	ФорматнаяСтрока = "ru = ""Л=ru;ДФ='MMMM yyyy'""; uk = ""Л=uk;ДФ='MMMM yyyy'""";
	ЭтаФорма.ОтражениеПериодаНачисления 	= Формат(ЭтаФорма.ПериодНачисления, НСтр(ФорматнаяСтрока));
КонецПроцедуры

&НаКлиенте
Процедура ОтражениеПериодаНачисленияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
		СтандартнаяОбработка = Ложь;
	
	Если ЭтаФорма.ТолькоПросмотр Тогда
		Возврат;
	КонецЕсли;
	
	Если ТаблицаПоказаний.Количество() > 0 Тогда
		Ответ = Вопрос(НСтр("ru='Перед изменением периода табличная часть будет очищена. Продолжить?';uk='Перед зміною періоду таблична частина буде очищена. Продовжити?'"),
		                      РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да);
		Если Ответ = КодВозвратаДиалога.Нет Тогда
			Возврат;
		КонецЕсли;
		ТаблицаПоказаний.Очистить();
	КонецЕсли;
	
	СтруктураПараметров = Новый Структура("ДатаКалендаря", ?(ЭтаФорма.ПериодНачисления= Дата('00010101'), ТекущаяДата(), ЭтаФорма.ПериодНачисления));
	ДатаКалендаряНачало = ОткрытьФормуМодально("ОбщаяФорма.ФормаКалендаря", СтруктураПараметров);
	
	ЭтаФорма.ПериодНачисления = КонецДня(ДатаКалендаряНачало);
	
	ОтражениеПериодаНачисленияПриИзменении(Элемент);
КонецПроцедуры

&НаКлиенте
Процедура ОтражениеПериодаНачисленияРегулирование(Элемент, Направление, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	Если ЭтаФорма.ТолькоПросмотр Тогда
		Возврат;
	КонецЕсли;
	
	Если ТаблицаПоказаний.Количество() > 0 Тогда
		Ответ = Вопрос(НСтр("ru='Перед изменением периода табличная часть будет очищена. Продолжить?';uk='Перед зміною періоду таблична частина буде очищена. Продовжити?'"),
		                      РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да);
		Если Ответ = КодВозвратаДиалога.Нет Тогда
			Возврат;
		КонецЕсли;
		ТаблицаПоказаний.Очистить();
	КонецЕсли;
	

	ЭтаФорма.ПериодНачисления = ?(ЗначениеЗаполнено(ЭтаФорма.ПериодНачисления), 
						ДобавитьМесяц(ЭтаФорма.ПериодНачисления, Направление),
						ДобавитьМесяц(КонецМесяца(ТекущаяДата()), Направление));
						
	ОтражениеПериодаНачисленияПриИзменении(Элемент);
	

КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ПериодНачисления = КонецМесяца(ДобавитьМесяц(ТекущаяДата(),-1));
		
	ФорматнаяСтрока = "ru = ""Л=ru;ДФ='MMMM yyyy'""; uk = ""Л=uk;ДФ='MMMM yyyy'""";
	ОтражениеПериодаНачисления = Формат(ЭтаФорма.ПериодНачисления, НСтр(ФорматнаяСтрока));
	ДатаВвода = ТекущаяДата();
	
	Если Параметры.Свойство("ЗаданиеМобильногоПриложения") Тогда
		
		Элементы.ТаблицаПоказаний.Видимость 						= Истина;
		Элементы.ТаблицаПоказанийПриборУчета.Видимость 				= Истина;
		Элементы.ТаблицаПоказанийЛицевойСчет.Видимость 				= Истина;
		Элементы.ТаблицаПоказанийКвартира.Видимость 				= Истина;
		Элементы.ТаблицаПоказанийОтветственныйВладелец.Видимость 	= Истина;
		Элементы.Исполнитель.Видимость 								= Истина;
		
		Элементы.ТаблицаПоказанийПриборУчетаСтрока.Видимость 		= Ложь;
		Элементы.ЗаписатьПоказания.Видимость 						= Ложь;
		Элементы.ЗаполнитьИзФайла.Видимость 						= Ложь;
		Элементы.ПутьКФайлу.Видимость 								= Ложь;
		Элементы.ОтражениеПериодаНачисления.Видимость 				= Ложь;
		Элементы.ЛицевойСчет.Видимость 								= Ложь;

		
		Элементы.ДатаВвода.Заголовок = Нстр("ru = 'Выполнить до'; uk = 'Виконати до'");
		
	ИначеЕсли Параметры.Свойство("ИндивидуальныйВвод") Тогда
		ЭтаФорма.Заголовок = НСтр("ru = 'Индивидуальный ввод показаний приборов учета'; uk = 'Індивідуальне введення показань приладів обліку'");
		Элементы.ЛицевойСчет.Видимость 								= Истина;		
		Элементы.ТаблицаПоказаний.Видимость 						= Истина;
		Элементы.ТаблицаПоказанийПриборУчета.Видимость 				= Истина;
		Элементы.ТаблицаПоказанийЛицевойСчет.Видимость 				= Истина;
		Элементы.ТаблицаПоказанийКвартира.Видимость 				= Истина;
		Элементы.ТаблицаПоказанийОтветственныйВладелец.Видимость 	= Истина;
		Элементы.ТаблицаПоказанийЗаписатьИндивидуальныеПоказания.Видимость = Истина;
		
		//Элементы.ТаблицаПоказаний.Видимость 						= Ложь;
		Элементы.Исполнитель.Видимость								= Ложь;
	    Элементы.ТаблицаПоказанийПриборУчетаСтрока.Видимость 		= Ложь;
		Элементы.ТаблицаПоказанийЗаполнитьПриборыСОтбором.Видимость = Ложь;
		Элементы.ЗаписатьПоказания.Видимость 						= Ложь;
		Элементы.ЗаполнитьИзФайла.Видимость 						= Ложь;
		Элементы.ПутьКФайлу.Видимость 								= Ложь;
		
	Иначе
		
		Элементы.ОписаниеПолей.Видимость 							= Истина;
		Элементы.ТаблицаПоказанийВывестиСписок.Видимость 			= Истина;
		Элементы.ТаблицаПоказанийЗаполнитьПриборыСОтбором.Видимость = Истина;
		Элементы.ТаблицаПоказаний.Видимость 						= Истина;
		Элементы.ТаблицаПоказанийПриборУчета.Видимость 				= Истина;
		Элементы.ЗаполнитьИзФайла.КнопкаПоУмолчанию 				= Истина;
		
		Элементы.ТаблицаПоказанийПриборУчетаСтрока.Видимость 		= Ложь;
		Элементы.ТаблицаПоказанийЗаполнитьПриборыСОтбором.Видимость = Ложь;
		Элементы.ЗаписатьПоказания.Доступность 						= Ложь;
		Элементы.ЗаписатьПоказания.КнопкаПоУмолчанию 				= Ложь;
		Элементы.Исполнитель.Видимость 								= Ложь;
		Элементы.ЛицевойСчет.Видимость 								= Ложь;
		
	КонецЕсли;
	
КонецПроцедуры                  

&НаСервере
Процедура ЗаполнитьПриборыНаСервере(АдресЛицевыхСчетовВХранилище = Неопределено,ИндивидуальныйВвод = ложь)
	ТаблицаПоказаний.Очистить();
	
	Запрос = Новый Запрос;
	Если АдресЛицевыхСчетовВХранилище <> Неопределено Тогда
		ТаблицаДляЗагрузки	= ПолучитьИзВременногоХранилища(АдресЛицевыхСчетовВХранилище);
	
		МассивОбъектовУстановки = ТаблицаДляЗагрузки.ВыгрузитьКолонку("ЛицевойСчет");
		
		ТекстЗапросаДоб = "	И УстановленныеПриборыУчетаСрезПоследних.ОбъектУстановки В(&МассивОбъектовУстановки)";
		Запрос.УстановитьПараметр("МассивОбъектовУстановки", МассивОбъектовУстановки);
	ИначеЕсли ИндивидуальныйВвод Тогда
		МассивОбъектовУстановки = Новый Массив;
		МассивОбъектовУстановки.Добавить(ЛицевойСчет);
		
		ТекстЗапросаДоб = "	И УстановленныеПриборыУчетаСрезПоследних.ОбъектУстановки В(&МассивОбъектовУстановки)";
		Запрос.УстановитьПараметр("МассивОбъектовУстановки", МассивОбъектовУстановки);
	Иначе
		ТекстЗапросаДоб = "";
	КонецЕсли;	

	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	УстановленныеПриборыУчетаСрезПоследних.ОбъектУстановки КАК ЛицевойСчет,
		|	УстановленныеПриборыУчетаСрезПоследних.ПриборУчета,
		|	УстановленныеПриборыУчетаСрезПоследних.ОбъектУстановки.ОбъектЛицевогоСчета КАК Квартира,
		|	УстановленныеПриборыУчетаСрезПоследних.ОбъектУстановки.ОбъектЛицевогоСчета.Владелец КАК Здание,
		|	УстановленныеПриборыУчетаСрезПоследних.ПриборУчета.Коэффициент КАК Коэффициент,
		|	ЕСТЬNULL(УслугиВидыТарифов.ВидТарифа, ЗНАЧЕНИЕ(Перечисление.ВидыТарифов.Общий)) КАК ВидТарифа,
		|	ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ОтветственныйВладелец
		|ИЗ
		|	РегистрСведений.УстановленныеПриборыУчета.СрезПоследних(&ДатаСреза, ПриборУчета.Услуга = &Услуга) КАК УстановленныеПриборыУчетаСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Услуги.ВидыТарифов КАК УслугиВидыТарифов
		|		ПО УстановленныеПриборыУчетаСрезПоследних.ПриборУчета.Услуга = УслугиВидыТарифов.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОтветственныйВладелецЛицевогоСчета.СрезПоследних КАК ОтветственныйВладелецЛицевогоСчетаСрезПоследних
		|		ПО УстановленныеПриборыУчетаСрезПоследних.ОбъектУстановки = ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ЛицевойСчет
		|ГДЕ
		|	УстановленныеПриборыУчетаСрезПоследних.Действует = ИСТИНА"+ТекстЗапросаДоб;
	
	Запрос.УстановитьПараметр("ДатаСреза", НачалоДня(ДатаВвода));
	Если ЗначениеЗаполнено(Услуга) Тогда
		Запрос.УстановитьПараметр("Услуга", Услуга);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"ПриборУчета.Услуга = &Услуга","");
	КонецЕсли;	
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ТЗ_Заполнения = РезультатЗапроса.Выгрузить();
	
	ТаблицаПоказаний.Загрузить(ТЗ_Заполнения);
	
	
КонецПроцедуры

