// ОБРАБОТЧИКИ КОМАНД

&НаКлиенте
// Процедура - обработчик команды заполнения ТЧ "ТаблицаЛС" вручную.
//
Процедура КомандаЗаполнитьЛСПодбором(Команда)
	
	Если ПроверитьПередачуПараметровНаСайт() Тогда
		Возврат;
	КонецЕсли;
	
	Если ТаблицаЛС.Количество() > 0 Тогда
		ТекстВопроса = НСтр("ru='Табличная часть будет очищена. Продолжить?';uk='Таблична частина буде очищена. Продовжити?'");
		Ответ = Вопрос(ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да,);
		
		Если Ответ <> КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;
		ТаблицаЛС.Очистить();
		
		ВсеПараметрыСгенерированы = Ложь;
	КонецЕсли;
	
	ПараметрыВыбораЗначения = Новый Структура;
	ПараметрыВыбораЗначения.Вставить("МножественныйВыбор",	Истина);

	ФормаПодбора = ПолучитьФорму("Справочник.ЛицевыеСчета.Форма.ФормаВыбораСОтбором", ПараметрыВыбораЗначения, ЭтаФорма);
	
	ФормаПодбора.Открыть();
	
КонецПроцедуры // КомандаЗаполнитьЛСПодбором()

&НаКлиенте
// Процедура - обработчик команды генерации параметров доступа
//.
Процедура СгенерироватьПараметры(Команда)
	
	Если ПроверитьПередачуПараметровНаСайт() Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлятьПД = Ложь;
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Логин", "");
	МассивПустыхЛогинов = ТаблицаЛС.НайтиСтроки(ПараметрыОтбора);
	Если Не МассивПустыхЛогинов.Количество() = ТаблицаЛС.Количество() И Объект.ОбновлятьПараметрыДоступа Тогда
		
		ТекстВопроса = НСтр("ru='Имеющиеся логины и пароли будут заменены новыми. Продолжить?';uk='Наявні логіни і паролі будуть замінені новими. Продовжити?'");
		Ответ = Вопрос(ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да,);
		
		Если Ответ <> КодВозвратаДиалога.Да Тогда
			Объект.ОбновлятьПараметрыДоступа = Ложь;
			Возврат;
		КонецЕсли;
		ОбновлятьПД = Истина;
	КонецЕсли;
	
	ДопЧисло = 0;
	// Перезаполняем все строки ТЧ.
	Для Каждого СтрокаТЧ Из ТаблицаЛС Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаТЧ.Логин) Тогда
			СтруктураПД = СгенерироватьПараметрыНаСервере(СтрокаТЧ.ЛицевойСчет, ДопЧисло);
		ИначеЕсли ОбновлятьПД Тогда
			СтруктураПД = СгенерироватьПараметрыНаСервере(СтрокаТЧ.ЛицевойСчет, ДопЧисло);
		Иначе
			Продолжить;
		КонецЕсли;
		
		СтрокаТЧ.Логин          = СтруктураПД.Логин;
		СтрокаТЧ.Пароль         = ОСМДСервер.СгенерироватьИдентификатор(ДопЧисло, 9, "Цифры");
		СтрокаТЧ.ПДИзменены     = Истина;
		СтрокаТЧ.ДанныеЗаписаны = Ложь;
		
		ДопЧисло = ДопЧисло + 1;
		
	КонецЦикла;
	
	ВсеПараметрыСгенерированы = Истина;
	ВсеПараметрыЗаписаны      = Ложь;
	ВсеПараметрыПереданы      = Ложь;
	ВсеКарточкиРаспечатаны    = Ложь;
	
	УправлениеФормой();
	
КонецПроцедуры // СгенерироватьПараметры()

&НаКлиенте
// Процедура - обработчик команды печати памяток.
//
Процедура КомандаРаспечататьПамяткиДоступа(Команда)
	
	Если ЗначениеЗаполнено(Объект.НастройкаДоступа) Тогда
		ПараметрКоманды = Новый Массив;
		
		Для Каждого СтрокаЛС Из ТаблицаЛС Цикл
			Если НЕ ПустаяСтрока("Логин") И НЕ ПустаяСтрока("Пароль") Тогда
				Структура = Новый Структура;
				Структура.Вставить("ЛицевойСчет", СтрокаЛС.ЛицевойСчет);
				Структура.Вставить("Логин",       СтрокаЛС.Логин);
				Структура.Вставить("Пароль",      СтрокаЛС.Пароль);
				
				ПараметрКоманды.Добавить(Структура);
			КонецЕсли;
		КонецЦикла;
		
		УправлениеПечатьюКлиент.ВыполнитьКомандуПечати("Справочник.ЛицевыеСчета", "ПамяткаДляДоступаВЛичныйКабинетНаСайте",
															 ПараметрКоманды, Неопределено, Неопределено);
		ОбработатьПечатьПамяток();
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Не выбрана настройка обмена данными.';uk='Не вибрана настройка обміну даними.'"));
	КонецЕсли;
	
	УправлениеФормой();
	
КонецПроцедуры // КомандаРаспечататьПамяткиДоступа()

&НаКлиенте
// Процедура - обработчик команды заполнения ТЧ "ТаблицаЛС" всеми счетами,
// для которых не указаны параметры доступа.
//
Процедура КомандаЗаполнитьВсемиЛСБезПараметров(Команда)
	
	Если ПроверитьПередачуПараметровНаСайт() Тогда
		Возврат;
	КонецЕсли;
	
	Если ТаблицаЛС.Количество() > 0 Тогда
		ТекстВопроса = НСтр("ru='Табличная часть будет очищена. Продолжить?';uk='Таблична частина буде очищена. Продовжити?'");
		Ответ = Вопрос(ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да,);
		
		Если Ответ <> КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;
		ТаблицаЛС.Очистить();
		
		ВсеПараметрыСгенерированы = Ложь;
	КонецЕсли;
	
	ЗаполнитьТаблицуЛСБезПараметров();
	
	Если ТаблицаЛС.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Параметры доступа имеются у всех лицевых счетов.';uk='Параметри доступу є у всіх особових рахунків.'"));
	КонецЕсли;
	
	УправлениеФормой();
	
КонецПроцедуры // КомандаЗаполнитьВсемиЛСБезПараметров()

&НаКлиенте
// Процедура - обработчик команды передачи параметров доступа на сайт.
//
Процедура ПередатьПараметры(Команда)
	
	Если Не ВсеПараметрыЗаписаны Тогда
		ТекстВопроса = НСтр("ru='Не все данные были записаны. Хотите сохранить их и передать на сайт?';uk='Не всі дані були записані. Хочете зберегти їх і передати на сайт?'");
		Ответ = Вопрос(ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да,);
		
		Если Ответ <> КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Объект.НастройкаДоступа) Тогда
			ВсеПараметрыЗаписаны = ВебИнтеграцияОбщегоНазначения.ЗаписатьПараметрыДоступаНаСервере(ТаблицаЛС, 
																								   Объект.ОбновлятьПараметрыДоступа, 
																								   Объект.НастройкаДоступа);
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Не выбрана настройка доступа.';uk='Не вибрана настройка доступу.'"));
		КонецЕсли;
		
	КонецЕсли;
	
	// Если все параметры записаны, передаем их на сайт.
	Если ВсеПараметрыЗаписаны Тогда
		Если ПаролиСгенерированы() Тогда
			
			ЗаполнитьПараметрыПодключения();
			
			Если ПараметрыПодключения.ХранитьПароль Тогда
				Пароль = ПараметрыПодключения.Пароль;
			Иначе
				Пароль = ПолучитьПарольДоступа();
			КонецЕсли;
			
			КлючВозврата = ВыполнитьВыгрузкуПараметровДоступаНаСервере(Пароль);
			
			Если КлючВозврата <>  Неопределено Тогда
				ФайлВыгрузки = ПолучитьИзВременногоХранилища(КлючВозврата);
				
				ПолучитьФайл(ФайлВыгрузки,"ПараметровДоступаПоЛС.xml",Истина);
			КонецЕсли;	
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Необходимо указать пароли для всех лицевых счетов.';uk='Необхідно вказати паролі для всіх особових рахунків.'"));
		КонецЕсли;
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Необходимо записать параметры доступа.';uk='Необхідно записати параметри доступу.'"));
	КонецЕсли;
	
	ВсеКарточкиРаспечатаны = Ложь;
	
	УправлениеФормой();
	
КонецПроцедуры // ПередатьПараметры()

&НаКлиенте
// Процедура - обработчик команды записи параметров доступа.
//
Процедура КомандаЗаписатьПараметрыДоступа(Команда)
	
	Если ПроверитьПередачуПараметровНаСайт() Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.НастройкаДоступа) Тогда
		ЗаписатьПараметрыДоступаНаСервере();
		
		ВсеПараметрыПереданы   = Ложь;
		ВсеКарточкиРаспечатаны = Ложь;
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Не выбрана настройка доступа.';uk='Не вибрана настройка доступу.'"));
	КонецЕсли;
	
	УправлениеФормой();
	
КонецПроцедуры // КомандаЗаписатьПараметрыДоступа()

