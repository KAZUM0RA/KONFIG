// Процедура производит генерацию ПД на сервере.
//
Функция СгенерироватьПараметрыНаСервере(ЛицевойСчет, ДопЧисло)
	
	СтруктураПД = Новый Структура;
	
	// Генерируем логин, пароль, меняем доп. число.
	ДопЧисло = ДопЧисло + 1;
	
	ТекЛогин = ОСМДСервер.СгенерироватьИдентификатор(ДопЧисло, 3, "ВР");
	ТекЛогин = ТекЛогин + ОСМДСервер.СгенерироватьИдентификатор(ДопЧисло, 3, "Цифры");
	ТекЛогин = ТекЛогин + ОСМДСервер.СгенерироватьИдентификатор(ДопЧисло +1, 3, "ВР");
	
	СтруктураПД.Вставить("Логин", ТекЛогин);
	
	Возврат СтруктураПД;
	
КонецФункции // СгенерироватьПараметрыНаСервере()

