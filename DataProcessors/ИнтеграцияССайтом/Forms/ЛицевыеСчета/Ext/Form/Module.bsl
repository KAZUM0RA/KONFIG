// При первом открытии предлагает пользователю загрузить в БД данные об аккаунтах
// лицевых счетов на сайте.
//
Процедура ОбработкаПервогоОткрытияФормы()
	
	ТекстВопроса = НСтр("ru='Данные о личных кабинетах жильцов не обнаружены."
"Загрузить их с сайта?';uk='Дані про особисті кабінетах мешканців не виявлені."
"Завантажити їх з сайту?'");
	
	Ответ = Вопрос(ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да,);
	Если НЕ Ответ = КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Если ПараметрыПодключения.ХранитьПароль Тогда
		Пароль = ПараметрыПодключения.Пароль;
	Иначе
		Пароль = ПолучитьПарольДоступа();
	КонецЕсли;
	
	СведенияОбОшибке = "";
	Если ОбщегоНазначения.ПолучитьЗначениеРеквизита(Объект.НастройкаДоступа, "ТипОбмена") = ПредопределенноеЗначение("Перечисление.ТипыОбменаССайтом.Напрямую") Тогда
		ВебИнтеграцияОбщегоНазначения.ВыполнитьЗагрузкуСведенияОбАккаунтах(Объект.НастройкаДоступа, Пароль);
	Иначе
		
		// Временная заглушка.
		Возврат;
		
	КонецЕсли;
	
КонецПроцедуры // ОбработкаПервогоОткрытияФормы()

