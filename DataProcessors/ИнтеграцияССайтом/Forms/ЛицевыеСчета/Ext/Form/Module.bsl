// Функция проверяет, переданы ли параметры на сайт.
//
// Возвращаемое значение:
//  Булево
//
Функция ПроверитьПередачуПараметровНаСайт()
	
	Если ВсеПараметрыПереданы Тогда
		ТекстВопроса = НСтр("ru='Параметры доступа уже переданы на сайт."
"Табличная часть будет очищена."
"Продолжить?';uk='Параметри доступу вже передані на сайт."
"Таблична частина буде очищена."
"Продовжити?'");
		Ответ = Вопрос(ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да,);
		
		Если Ответ <> КодВозвратаДиалога.Нет Тогда
			
			ТаблицаЛС.Очистить();
			ВсеПараметрыЗаписаны      = Ложь;
			ВсеПараметрыПереданы      = Ложь;
			ВсеКарточкиРаспечатаны    = Ложь;
			ВсеПараметрыСгенерированы = Ложь;
			Возврат Ложь;
		Иначе
			Возврат Истина;
		КонецЕсли;
	Иначе
		Возврат Ложь;
	КонецЕсли;
		
КонецФункции // ПроверитьПередачуПараметровНаСайт()

