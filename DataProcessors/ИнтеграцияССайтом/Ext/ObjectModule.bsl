
// Восстанавливает настройки пользователя.
//
Процедура ИнициализацияРеквизитов() Экспорт
	
	СтруктураНастроек = ХранилищеОбщихНастроек.Загрузить("Обработка.ИнтеграцияССайтом");
	
	Если ТипЗнч(СтруктураНастроек) = Тип("Структура") Тогда
		СтруктураНастроек.Свойство("НастройкаДоступа",          НастройкаДоступа);
		СтруктураНастроек.Свойство("ОбновлятьПараметрыДоступа", ОбновлятьПараметрыДоступа);
	КонецЕсли;
	
КонецПроцедуры // ИнициализацияРеквизитов()
