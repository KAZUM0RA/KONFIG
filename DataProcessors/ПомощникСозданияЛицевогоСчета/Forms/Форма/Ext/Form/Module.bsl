// ПРОЦЕДУРЫ И ФУНКЦИИ МАСТЕРА

&НаКлиенте
Процедура УстановитьВидимостьНаКлиенте()
	
	// устанавливаем текущую страницу помощника
	Элементы.СтраницыПомощника.ТекущаяСтраница = мСтраницыПомощника[мТекущийНомерСтраницы];
	
	Для а=0 по 3 Цикл
		Элементы["Надпись"+а].Шрифт = Новый Шрифт(Элементы["Надпись"+а].Шрифт ,,,Ложь);
	КонецЦикла;
	
	Элементы["Надпись"+мТекущийНомерСтраницы].Шрифт = Новый Шрифт(Элементы["Надпись"+мТекущийНомерСтраницы].Шрифт ,,,Истина);
	
	// устанавливаем текущую страницу кнопок помощника
	Элементы.КнопкиПомощника.ТекущаяСтраница = мКнопкиПомощника[мТекущийНомерСтраницы];
	
	Если Элементы.СтраницыПомощника.ТекущаяСтраница  = Элементы.СтраницаГотово Тогда
		
		Если НЕ ЗначениеЗаполнено(СсылкаДокументУправленияУслугами) Тогда
			Элементы.КнопкаДокументУправлениеУслугами.Видимость = Ложь;	
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(СсылкаДокументУправленияУслугамиПодробно) Тогда
			Элементы.КнопкаДокументУправлениеУслугамиПодробно.Видимость = Ложь;	
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(СсылкаДокументУправлениеПриборамиУчета) Тогда
			Элементы.КнопкаДокументУправлениеПриборамиУчета.Видимость = Ложь;	
		КонецЕсли;
		
	ИначеЕсли Элементы.СтраницыПомощника.ТекущаяСтраница  = Элементы.СтраницаДанныхОУслугах Тогда
		
		ЗаполнитьДеревоУслугНаСервере();
		
	ИначеЕсли Элементы.СтраницыПомощника.ТекущаяСтраница  = Элементы.СтраницаДанныхОПриборахУчета Тогда
		
		ЗаполнитьПриборыУчетаНаСервере();
		
	ИначеЕсли Элементы.СтраницыПомощника.ТекущаяСтраница  = Элементы.СтраницаДанныхОПомещении Тогда
		
		Если ЭтоЖилойФонд Тогда
			Элементы.КоличествоПроживающих.Видимость = Истина;
			Элементы.КоличествоПрописанных.Видимость = Истина;
		Иначе
			Элементы.КоличествоПроживающих.Видимость = Ложь;
			Элементы.КоличествоПрописанных.Видимость = Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьНомерСтраницы(Итератор)
	
	Отказ = Ложь;
	
	Если Итератор > 0 Тогда
		ВыполнитьПроверкуЗаполненияСтраницы(Отказ);
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	// изменяем номер текущей страницы
	Инкремент(мТекущийНомерСтраницы, Итератор);
	
	// отображаем новую страницу помощника
	УстановитьВидимостьНаКлиенте();
	
	Если мТекущийНомерСтраницы = 1 И Итератор = 1 Тогда
		
		Совпадение = ИзменениеОбъектаЛицевогоСчета();
	
		Если Совпадение = Ложь Тогда  	
			ТекстВопроса = НСтр("ru='Параметры шаблона лицевого счета не совпадают с параметрами объекта лицевого счета. 
				|                          Очистить шаблон лицевого счета?';uk='Параметри шаблону особового рахунку не співпадають з параметрами об''єкту особового рахунку. 
				|                          Очистити шаблон особового рахунку?'");
			
			Ответ = Вопрос(ТекстВопроса, РежимДиалогаВопрос.ДаНет, ,КодВозвратаДиалога.Да);
			
			Если Ответ = КодВозвратаДиалога.Да Тогда    
				
				Объект.ШаблонЛицевогоСчета = Неопределено;
				
			КонецЕсли;

		КонецЕсли;
	
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура Инкремент(Число, Знач Итератор = 1)
	
	Число = Число + Итератор;
	
КонецПроцедуры

&НаКлиенте
 Процедура ИнициализацияПомощникаНаКлиенте()
	
	мСтраницыПомощника  = Новый Соответствие;
	мКнопкиПомощника    = Новый Соответствие;
	
	// СТРАНИЦЫ ПОМОЩНИКА
	
	мСтраницыПомощника.Вставить(0 ,  Элементы.СтраницаДанныхОПомещении);
	мСтраницыПомощника.Вставить(1 ,  Элементы.СтраницаДанныхОУслугах);
	мСтраницыПомощника.Вставить(2 ,  Элементы.СтраницаДанныхОПриборахУчета);
	мСтраницыПомощника.Вставить(3 ,  Элементы.СтраницаГотово);
	
	
	мКнопкиПомощника.Вставить(0 ,  Элементы.КнопкиНачала);
	мКнопкиПомощника.Вставить(1 ,  Элементы.КнопкиПродолжения);
	мКнопкиПомощника.Вставить(2 ,  Элементы.КнопкиГотово);
	мКнопкиПомощника.Вставить(3 ,  Элементы.КнопкиОкончания);
	
КонецПроцедуры

 &НаКлиенте
Процедура ВыполнитьПроверкуЗаполненияСтраницы(Отказ)
	
	Если Элементы.СтраницыПомощника.ТекущаяСтраница = Элементы.СтраницаДанныхОПомещении Тогда
		
		Если НЕ ЗначениеЗаполнено(Объект.Дата) Тогда
			НСтрока = НСтр("ru='Не заполнено поле Дата';uk='Не заповнене поле Дата'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтрока,, "Объект.Дата",, Отказ);
			Отказ = Истина;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
			НСтрока = НСтр("ru='Не заполнено поле Организация';uk='Не заповнене поле Організація'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтрока,, "Объект.Организация",, Отказ);
			Отказ = Истина;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Объект.Здание) Тогда
			НСтрока = НСтр("ru='Не заполнено поле Здание';uk='Не заповнене поле Будинок'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтрока,, "Объект.Здание",, Отказ);
			Отказ = Истина;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Объект.ОбъектЛицевогоСчета) Тогда
			НСтрока = НСтр("ru='Не заполнено поле Объект лицевого счета';uk=""Не заповнене поле Об'єкт особового рахунку""");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтрока,, "Объект.ОбъектЛицевогоСчета",, Отказ);
			Отказ = Истина;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Объект.ОтветственныйВладелец) Тогда
			НСтрока = НСтр("ru='Не заполнено поле Ответственный владелец';uk='Не заповнене поле Відповідальний власник'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтрока,, "Объект.ОтветственныйВладелец",, Отказ);
			Отказ = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры


