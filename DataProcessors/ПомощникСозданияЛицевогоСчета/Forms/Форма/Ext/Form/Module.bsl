&НаСервере
 Функция ИзменениеОбъектаЛицевогоСчета()
	
	Совпадение = Истина;
	
	Запрос = Новый Запрос();
	
	Запрос.Текст =  "ВЫБРАТЬ
	                |	ПлощадьОбъектовЛицевыхСчетовСрезПоследних.Площадь = ПлощадьОбъектовЛицевыхСчетовСрезПоследних1.Площадь КАК Совпадение
	                |ИЗ
	                |	РегистрСведений.ПлощадьОбъектовЛицевыхСчетов.СрезПоследних КАК ПлощадьОбъектовЛицевыхСчетовСрезПоследних
	                |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ПлощадьОбъектовЛицевыхСчетов.СрезПоследних КАК ПлощадьОбъектовЛицевыхСчетовСрезПоследних1
	                |		ПО ПлощадьОбъектовЛицевыхСчетовСрезПоследних.ВидПлощади = ПлощадьОбъектовЛицевыхСчетовСрезПоследних1.ВидПлощади
	                |ГДЕ
	                |	ПлощадьОбъектовЛицевыхСчетовСрезПоследних.Помещение = &Объект1
	                |	И ПлощадьОбъектовЛицевыхСчетовСрезПоследних1.Помещение = &Объект2
	                |	И ПлощадьОбъектовЛицевыхСчетовСрезПоследних.ВидПлощади = &Общая
	                |	И ПлощадьОбъектовЛицевыхСчетовСрезПоследних1.ВидПлощади = &Общая
	                |
	                |ОБЪЕДИНИТЬ ВСЕ
	                |
	                |ВЫБРАТЬ
	                |	ПлощадьОбъектовЛицевыхСчетовСрезПоследних.Площадь = ПлощадьОбъектовЛицевыхСчетовСрезПоследних1.Площадь
	                |ИЗ
	                |	РегистрСведений.ПлощадьОбъектовЛицевыхСчетов.СрезПоследних КАК ПлощадьОбъектовЛицевыхСчетовСрезПоследних
	                |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ПлощадьОбъектовЛицевыхСчетов.СрезПоследних КАК ПлощадьОбъектовЛицевыхСчетовСрезПоследних1
	                |		ПО ПлощадьОбъектовЛицевыхСчетовСрезПоследних.ВидПлощади = ПлощадьОбъектовЛицевыхСчетовСрезПоследних1.ВидПлощади
	                |ГДЕ
	                |	ПлощадьОбъектовЛицевыхСчетовСрезПоследних.Помещение = &Объект1
	                |	И ПлощадьОбъектовЛицевыхСчетовСрезПоследних1.Помещение = &Объект2
	                |	И ПлощадьОбъектовЛицевыхСчетовСрезПоследних.ВидПлощади = &Отапливаемая
	                |	И ПлощадьОбъектовЛицевыхСчетовСрезПоследних1.ВидПлощади = &Отапливаемая";
	
	Запрос.УстановитьПараметр("Объект1", Объект.ОбъектЛицевогоСчета);
	Запрос.УстановитьПараметр("Объект2", Объект.ШаблонЛицевогоСчета.ОбъектЛицевогоСчета);
	Запрос.УстановитьПараметр("Общая", Справочники.ВидыПлощадей.ОбщаяПлощадь);
	Запрос.УстановитьПараметр("Отапливаемая", Справочники.ВидыПлощадей.ОтапливаемаяПлощадь);
		
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();	
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл

		Если ВыборкаДетальныеЗаписи.Совпадение = Ложь Тогда
			
			Совпадение = Ложь;
			
			Возврат Совпадение;
			
		КонецЕсли
			
	КонецЦикла;
	
	Запрос = Новый Запрос();
	
	Запрос.Текст =  "ВЫБРАТЬ
	                |	ОбъектыЛицевыхСчетов.КоличествоКомнат = ОбъектыЛицевыхСчетов1.КоличествоКомнат КАК Совпадение
	                |ИЗ
	                |	Справочник.ОбъектыЛицевыхСчетов КАК ОбъектыЛицевыхСчетов,
	                |	Справочник.ОбъектыЛицевыхСчетов КАК ОбъектыЛицевыхСчетов1
	                |ГДЕ
	                |	ОбъектыЛицевыхСчетов.Ссылка = &Объект1
	                |	И ОбъектыЛицевыхСчетов1.Ссылка = &Объект2";
	
	Запрос.УстановитьПараметр("Объект1", Объект.ОбъектЛицевогоСчета);
	Запрос.УстановитьПараметр("Объект2", Объект.ШаблонЛицевогоСчета.ОбъектЛицевогоСчета);

	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();	
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл

		Если ВыборкаДетальныеЗаписи.Совпадение = Ложь Тогда
			
			Совпадение = Ложь;
			
			Возврат Совпадение;
			
		КонецЕсли
			
	КонецЦикла;

КонецФункции

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	ТаблицаРазницаДатПоверкиПриборовУчета = Настройки.Получить("РазницаДатПоверкиПриборовУчета");
	Если НЕ ТаблицаРазницаДатПоверкиПриборовУчета = Неопределено Тогда
		РазницаДатПоверкиПриборовУчета.Загрузить(ТаблицаРазницаДатПоверкиПриборовУчета);
	КонецЕсли;
	
КонецПроцедуры

