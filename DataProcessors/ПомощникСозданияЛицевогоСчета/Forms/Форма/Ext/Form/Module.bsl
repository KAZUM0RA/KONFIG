
////////////////////////////////////////////////////////////////////////////////
// МОДАЛЬНЫЕ ПЕРЕМЕННЫЕ МАСТЕРА (Клиент)

&НаКлиенте
Перем мТекущийНомерСтраницы;

&НаКлиенте
Перем мСтраницыПомощника;

&НаКлиенте
Перем мКнопкиПомощника;

&НаКлиенте
// Процедура обработки ДеревоКлассификатораВыбранПриИзменении.
//
Процедура ВыбранПриИзменении(ТекущиеДанные)
	
	Если ТекущиеДанные.Выбран = 2 Тогда
		ТекущиеДанные.Выбран = 0;
	КонецЕсли;
	
	ОбходДереваВверх(ТекущиеДанные);
	ОбходДереваВниз(ТекущиеДанные);
	
КонецПроцедуры // ВыбранПриИзменении()

&НаКлиенте
// Процедура обхода дерева вверх.
//
Процедура ОбходДереваВверх(ТекущиеДанные)

	Родитель = ТекущиеДанные.ПолучитьРодителя();
	Если Родитель <> Неопределено Тогда // Верхний уровень
		
		ДочерниеСтроки = Родитель.ПолучитьЭлементы();
		КоличествоВыбранных = 0;
		ОбщееКоличество = 0;
		Для каждого Элемент Из ДочерниеСтроки Цикл
			Если Элемент.Выбран = 2 Тогда
				КоличествоВыбранных = КоличествоВыбранных + 0.5;
			ИначеЕсли Элемент.Выбран = 1 Тогда
				КоличествоВыбранных = КоличествоВыбранных + 1;
			КонецЕсли;
			ОбщееКоличество = ОбщееКоличество + 1;
		КонецЦикла;
		
		Если ОбщееКоличество = КоличествоВыбранных Тогда
			Родитель.Выбран = 1;
		ИначеЕсли КоличествоВыбранных = 0 Тогда
			Родитель.Выбран = 0;
		Иначе
			Родитель.Выбран = 2;
		КонецЕсли;
		
		ОбходДереваВверх(Родитель);
		
	КонецЕсли;
	
КонецПроцедуры // ОбходДереваВверх()

&НаКлиенте
// Процедура обхода дерева вниз.
//
Процедура ОбходДереваВниз(ТекущиеДанные)
	
	ДочерниеСтроки = ТекущиеДанные.ПолучитьЭлементы();
	Для каждого Элемент Из ДочерниеСтроки Цикл
		Элемент.Выбран = ТекущиеДанные.Выбран;
		ОбходДереваВниз(Элемент);
	КонецЦикла;
	
КонецПроцедуры // ОбходДереваВниз()

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если Параметры.Свойство("ЖилойФонд") Тогда
		Если ЗначениеЗаполнено(Параметры.ЖилойФонд) Тогда
			Объект.ЖилойНеЖилойФонд = Параметры.ЖилойФонд;
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.ЖилойНеЖилойФонд) Тогда
		Объект.ЖилойНеЖилойФонд = Перечисления.ЖилойНеЖилойФонд.Жилой;
	КонецЕсли;	
	
	ЭтоЖилойФонд = Объект.ЖилойНеЖилойФонд = Перечисления.ЖилойНеЖилойФонд.Жилой;
	
	Если Параметры.Свойство("Организация") Тогда
		Если ЗначениеЗаполнено(Параметры.Организация) Тогда
			Объект.Организация = Параметры.Организация;
		КонецЕсли;
	КонецЕсли;
	
	Если Параметры.Свойство("Здание") Тогда
		Если ЗначениеЗаполнено(Параметры.Здание) Тогда
			Объект.Здание = Параметры.Здание;
			Объект.ИмяЛицевогоСчета = СформироватьИмяЛицевогоСчета(Объект.Здание, Объект.ОбъектЛицевогоСчета);	
		КонецЕсли;
	КонецЕсли;
	
	Локализация.ПриСозданииНаСервере(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	
	мТекущийНомерСтраницы = 0;
	
	ИнициализацияПомощникаНаКлиенте();
	
	УстановитьВидимостьНаКлиенте();
	
	Элементы["Надпись0"].Шрифт = Новый Шрифт(Элементы["Надпись0"].Шрифт ,,,Истина);
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ФОРМЫ МАСТЕРА

&НаКлиенте
Процедура КомандаГотово(Команда)
	
	СогласиеНаИсправлениеЗаводскихНомеров = Ложь;
	ЗаводскойНомерНеЗаполнен = Ложь; 
	
	Для каждого СтрокаПриборыУчета Из ПриборыУчета Цикл
		Если ПустаяСтрока(СтрокаПриборыУчета.ЗаводскойНомер) Тогда	
			ЗаводскойНомерНеЗаполнен = Истина;	
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если ЗаводскойНомерНеЗаполнен = Истина и СогласиеНаИсправлениеЗаводскихНомеров = Ложь Тогда
		
		ТекстВопроса = НСтр("ru='Существуют незаполненнве заводские номера.';uk='Існують не заповнені заводскі нормери.'");
		ТекстВопроса = ТекстВопроса + Символы.ПС + НСтр("ru='Заполните заводские номера, либо они будут заполнены автоматически.';uk='Заповніть заводські номери, або вони будуть заповнені автоматично.'");
		ТекстВопроса = ТекстВопроса + Символы.ПС + НСтр("ru='Заполнить автоматически?';uk='Заповнити автоматично?'");
		
		Ответ = Вопрос(ТекстВопроса, РежимДиалогаВопрос.ДаНет, ,КодВозвратаДиалога.Нет);
		
		Если Ответ = КодВозвратаДиалога.Да Тогда    
			
			СогласиеНаИсправлениеЗаводскихНомеров = Истина;
			
		Иначе Возврат;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если СогласиеНаИсправлениеЗаводскихНомеров = Истина Тогда
		
		Для каждого СтрокаПриборыУчета Из ПриборыУчета Цикл
			
			Если ПустаяСтрока(СтрокаПриборыУчета.ЗаводскойНомер) Тогда
				
				КодУ = ПолучитьКодУслуги(СтрокаПриборыУчета.Услуга);
				
				СтрокаПриборыУчета.ЗаводскойНомер = Объект.ИмяЛицевогоСчета + КодУ;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если НЕ ПроверитьТаблицуПриборовУчета() Тогда
		
		ТекстВопроса = НСтр("ru='Существуют не заполненные приборы учета, которые не будут подключены.';uk='Існують не заповнені прилади обліку, які не будуть підключені.'");
		ТекстВопроса = ТекстВопроса + Символы.ПС + НСтр("ru='Подключение можно выполнить позже.';uk='Підключення можна виконати пізніше.'");
		ТекстВопроса = ТекстВопроса + Символы.ПС + НСтр("ru='Продолжить?';uk='Продовжити?'");
		
		Ответ = Вопрос(ТекстВопроса, РежимДиалогаВопрос.ДаНет, ,КодВозвратаДиалога.Нет);
		
		Если Ответ <> КодВозвратаДиалога.Да Тогда    
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	ТекстВопроса = НСтр("ru='Подготовлены данные для создания лицевого счета ';uk='Підготовлені дані для створення особового рахунку '")  + Объект.ИмяЛицевогоСчета;
	ТекстВопроса = ТекстВопроса +Символы.ПС + НСтр("ru='Продолжить?';uk='Продовжити?'");
	
	Ответ = Вопрос(ТекстВопроса, РежимДиалогаВопрос.ДаНет, ,КодВозвратаДиалога.Нет);
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	
	Если СформироватьОбъекты() Тогда
		
		Оповестить("СозданЛицевойСчет", СсылкаСправочникЛицевыеСчета , ЭтаФорма);
		
		ИзменитьНомерСтраницы(+1);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаДалее(Команда)
	
	ИзменитьНомерСтраницы(+1);

КонецПроцедуры

&НаКлиенте
Процедура КомандаНазад(Команда)
	
	ИзменитьНомерСтраницы(-1);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОтмена(Команда)
	
	Закрыть();

КонецПроцедуры

&НаКлиенте
Процедура КомандаВНачало(Команда)
	
	мТекущийНомерСтраницы = 0;
	
	Объект.ОбъектЛицевогоСчета = Неопределено;
	Объект.ОтветственныйВладелец = Неопределено;
	Объект.КоличествоПроживающих = 0;
	Объект.КоличествоПрописанных = 0;
		
	Объект.ИмяЛицевогоСчета = "";
	Объект.ИмяЛицевогоСчета = СформироватьИмяЛицевогоСчета(Объект.Здание, Объект.ОбъектЛицевогоСчета);	
	
	ДеревоУслуг.ПолучитьЭлементы().Очистить();
	ПриборыУчета.Очистить();
	
	СсылкаДокументОткрытиеЛицевогоСчета = Неопределено;
	СсылкаДокументУправлениеПотребителямиУслуг = Неопределено;
	СсылкаДокументУправлениеПриборамиУчета = Неопределено;
	СсылкаДокументУправленияУслугами = Неопределено;
	СсылкаДокументУправленияУслугамиПодробно = Неопределено;
	СсылкаСправочникЛицевыеСчета = Неопределено;
	
	УстановитьВидимостьНаКлиенте();
	
	Элементы["Надпись0"].Шрифт = Новый Шрифт(Элементы["Надпись0"].Шрифт ,,,Истина);
	
	
КонецПроцедуры

&НаСервере
Функция ПроверитьТаблицуПриборовУчета()
	
	ОК = Истина;
	
	Для каждого СтрокаПриборыУчета Из ПриборыУчета Цикл
		Если НЕ СтрокаПриборыУчета.ДанныеЗаполнены Тогда	
			ОК = Ложь;	
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ОК;
	
КонецФункции

&НаСервере
Функция СформироватьОбъекты()
	
	НачатьТранзакцию();
	
	// Справочник лицевые счета
	СправочникЛицевыеСчета = Справочники.ЛицевыеСчета.СоздатьЭлемент();
	СправочникЛицевыеСчета.Владелец = Объект.Здание;
	СправочникЛицевыеСчета.Наименование = Объект.ИмяЛицевогоСчета;
	СправочникЛицевыеСчета.ОбъектЛицевогоСчета = Объект.ОбъектЛицевогоСчета;
	СправочникЛицевыеСчета.Записать();
	
	СсылкаСправочникЛицевыеСчета = СправочникЛицевыеСчета.Ссылка;
	
	// Документ ОткрытиеЛицевогоСчета
	ДокументОткрытиеЛицевогоСчета = Документы.ОткрытиеЛицевогоСчета.СоздатьДокумент();
	ДокументОткрытиеЛицевогоСчета.Автор = Пользователи.ТекущийПользователь();
	ДокументОткрытиеЛицевогоСчета.Дата = Объект.Дата;	
	ДокументОткрытиеЛицевогоСчета.ЛицевойСчет = СсылкаСправочникЛицевыеСчета;
	ДокументОткрытиеЛицевогоСчета.Организация = Объект.Организация;
	ДокументОткрытиеЛицевогоСчета.Здание = Объект.Здание;
	
	ДокументОткрытиеЛицевогоСчета.ОтветственныйВладелец = Объект.ОтветственныйВладелец;
	ДокументОткрытиеЛицевогоСчета.КоличествоПрописанных = Объект.КоличествоПрописанных;
	ДокументОткрытиеЛицевогоСчета.КоличествоПроживающих = Объект.КоличествоПроживающих;
	
	ДокументОткрытиеЛицевогоСчета.Записать(РежимЗаписиДокумента.Проведение);
	
	СсылкаДокументОткрытиеЛицевогоСчета = ДокументОткрытиеЛицевогоСчета.Ссылка;
	
	 //Документ УправлениеУслугами и УправлениеУслугамиПодробно
	Дерево = РеквизитФормыВЗначение("ДеревоУслуг"); 
	ДокументУправлениеУслугами = Документы.УправлениеУслугами.СоздатьДокумент();	
	ДокументУправлениеУслугами.Автор = Пользователи.ТекущийПользователь();
	ДокументУправлениеУслугами.Организация = Объект.Организация;
	ДокументУправлениеУслугами.Дата = Объект.Дата;
	ДокументУправлениеУслугами.ВидОперации = Перечисления.ВидыОперацийУправленияУслугами.НазначениеУслуги;
	ДокументУправлениеУслугами.Здание = Объект.Здание;
	ДокументУправлениеУслугами.ДатаНачала = Объект.Дата;
	
	НоваяСтрока = ДокументУправлениеУслугами.ЛицевыеСчета.Добавить();
	НоваяСтрока.ЛицевойСчет = СсылкаСправочникЛицевыеСчета;
	
	Для каждого СтрокаУровень1 Из Дерево.Строки Цикл
		Для каждого СтрокаУровень2 Из СтрокаУровень1.Строки Цикл
			Если СтрокаУровень2.Выбран >= 1 Тогда	
				НоваяСтрока = ДокументУправлениеУслугами.Услуги.Добавить();	
				НоваяСтрока.Услуга = СтрокаУровень2.Услуга;
				
				Если СтрокаУровень2.Услуга.ВидУслуги = Справочники.ВидыУслуг.СДПТ Тогда
					Если СтрокаУровень2.Строки.Количество() > 0 Тогда
						
						ДокументУправлениеУслугамиПодробно = Документы.УправлениеУслугамиПодробно.СоздатьДокумент();	
						ДокументУправлениеУслугамиПодробно.Автор = Пользователи.ТекущийПользователь();
						ДокументУправлениеУслугамиПодробно.Организация = Объект.Организация;
						ДокументУправлениеУслугамиПодробно.Дата = Объект.Дата;
						ДокументУправлениеУслугамиПодробно.ВидОперации = Перечисления.ВидыОперацийУправленияУслугами.НазначениеУслуги;
						ДокументУправлениеУслугамиПодробно.Здание = Объект.Здание;
						ДокументУправлениеУслугамиПодробно.ДатаНачала = Объект.Дата;
						ДокументУправлениеУслугамиПодробно.Услуга = СтрокаУровень2.Услуга;
						
						НоваяСтрокаПодробно = ДокументУправлениеУслугамиПодробно.ЛицевыеСчета.Добавить();
						НоваяСтрокаПодробно.ЛицевойСчет = СсылкаСправочникЛицевыеСчета;
						
						Для каждого СтрокаУровень3 Из СтрокаУровень2.Строки Цикл
							Если СтрокаУровень3.Выбран >= 1 Тогда	
								НоваяСтрокаПодробно = ДокументУправлениеУслугамиПодробно.УслугиПодробно.Добавить();	
								НоваяСтрокаПодробно.УслугаПодробно = СтрокаУровень3.Услуга;
							КонецЕсли;
						КонецЦикла;
							
						Если ДокументУправлениеУслугамиПодробно.УслугиПодробно.Количество() > 0 Тогда
							ДокументУправлениеУслугамиПодробно.Записать(РежимЗаписиДокумента.Проведение);
						
							СсылкаДокументУправленияУслугамиПодробно = ДокументУправлениеУслугамиПодробно.Ссылка;
						КонецЕсли;
	
					КонецЕсли;
				КонецЕсли;
				
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Если ДокументУправлениеУслугами.Услуги.Количество() > 0 Тогда
		ДокументУправлениеУслугами.Записать(РежимЗаписиДокумента.Проведение);
	
		СсылкаДокументУправленияУслугами = ДокументУправлениеУслугами.Ссылка;
	КонецЕсли;
	
	//Документ Изменение лицевого счета, установка дополнительных реквизитов
	ДокументИзменениеЛицевогоСчета = Документы.ИзменениеЛицевогоСчета.СоздатьДокумент();
	ДокументИзменениеЛицевогоСчета.Автор = Пользователи.ТекущийПользователь();
	ДокументИзменениеЛицевогоСчета.Организация = Объект.Организация;
	ДокументИзменениеЛицевогоСчета.Дата = Объект.Дата;
	ДокументИзменениеЛицевогоСчета.ВидОперации = Перечисления.ВидыОперацийИзменениеЛицевогоСчета.ИзменениеДополнительныхРеквизитов;
	ДокументИзменениеЛицевогоСчета.Здание = Объект.Здание;
	ДокументИзменениеЛицевогоСчета.ЛицевойСчет = СсылкаСправочникЛицевыеСчета;
	
	Для Каждого Строка из ДополнительныеРеквизиты Цикл
		НоваяСтрока = ДокументИзменениеЛицевогоСчета.ДополнительныеРеквизиты.Добавить();
		НоваяСтрока.ДополнительныйРеквизит = Строка.ДополнительныйРеквизит;
		НоваяСтрока.Значение = Строка.Значение;
	КонецЦикла;
	
	Если ДокументИзменениеЛицевогоСчета.ДополнительныеРеквизиты.Количество() > 0 тогда
        
	    ДокументИзменениеЛицевогоСчета.Записать(РежимЗаписиДокумента.Проведение);
		
		СсылкаДокументИзменениеЛицевогоСчета = ДокументИзменениеЛицевогоСчета.Ссылка;

	КонецЕсли;
	


	
	
	Если ПриборыУчета.Количество() > 0 Тогда	
		
		Для Каждого СтрокаПриборыУчета Из ПриборыУчета Цикл
			// Справочник приборы учета
			Если НЕ СтрокаПриборыУчета.ДанныеЗаполнены Тогда
				Продолжить;
			КонецЕсли;
			
			НаименованиеПУ  = СтрокаПриборыУчета.ЗаводскойНомер + "/" + СтрокаПриборыУчета.Услуга.ВидУслуги;
			
			СсылкаНаСуществующийПУ = Справочники.ПриборыУчета.НайтиПоНаименованию(НаименованиеПУ);
			
			Если СсылкаНаСуществующийПУ <> Справочники.ПриборыУчета.ПустаяСсылка() Тогда
				 СтрокаПриборыУчета.ПриборУчета = СсылкаНаСуществующийПУ;
			Иначе
				СправочникПриборыУчета = Справочники.ПриборыУчета.СоздатьЭлемент();
				СправочникПриборыУчета.Наименование = СтрокаПриборыУчета.ЗаводскойНомер + "/" + СтрокаПриборыУчета.Услуга.ВидУслуги;
				СправочникПриборыУчета.Услуга = СтрокаПриборыУчета.Услуга;
				СправочникПриборыУчета.ЗаводскойНомер = СтрокаПриборыУчета.ЗаводскойНомер;
				СправочникПриборыУчета.Тарифность  = СтрокаПриборыУчета.Тарифность;
				СправочникПриборыУчета.СпособРегистрацииПоказаний = СтрокаПриборыУчета.СпособРегистрацииПоказаний;
				СправочникПриборыУчета.Коэффициент = СтрокаПриборыУчета.Коэффициент;
				СправочникПриборыУчета.ЕдиницаИзмерения = СтрокаПриборыУчета.ЕдиницаИзмерения;
				СправочникПриборыУчета.Разрядность = СтрокаПриборыУчета.Разрядность;
				
				СправочникПриборыУчета.Записать();
				СтрокаПриборыУчета.ПриборУчета = СправочникПриборыУчета.Ссылка;
			КонецЕсли;
			
		КонецЦикла;	
			
		// Документ управление приборами учета
		ДокументУправлениеПриборамиУчета = Документы.УправлениеПриборамиУчета.СоздатьДокумент();
		ДокументУправлениеПриборамиУчета.Автор = Пользователи.ТекущийПользователь();
		ДокументУправлениеПриборамиУчета.ВидОперации = Перечисления.ВидыОперацийУправленияПриборамиУчета.УстановкаПрибораУчета;
		ДокументУправлениеПриборамиУчета.ОбъектУстановки = СсылкаСправочникЛицевыеСчета;
		ДокументУправлениеПриборамиУчета.Дата = Объект.Дата;
		ДокументУправлениеПриборамиУчета.Организация = ДокументУправлениеПриборамиУчета.ОбъектУстановки.Владелец.Организация;
		ДокументУправлениеПриборамиУчета.Здание = ДокументУправлениеПриборамиУчета.ОбъектУстановки.Владелец;
		
		ЗаписатьДокументУправлениеПриборамиУчета = Ложь;
			
		Для Каждого СтрокаПриборыУчета Из ПриборыУчета Цикл
			
			Если НЕ СтрокаПриборыУчета.ДанныеЗаполнены Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = ДокументУправлениеПриборамиУчета.ПриборыУчета.Добавить();
			НоваяСтрока.ПриборУчета = СтрокаПриборыУчета.ПриборУчета;
			НоваяСтрока.ДатаВключения = СтрокаПриборыУчета.ДатаУстановки;
			НоваяСтрока.ВидТарифа = СтрокаПриборыУчета.ВидТарифа;
			НоваяСтрока.ДатаПоследнейПоверки = СтрокаПриборыУчета.ДатаПоследнейПоверки;
			НоваяСтрока.ДатаСледующейПоверки = СтрокаПриборыУчета.ДатаСледующейПоверки;
			НоваяСтрока.НачальноеПоказание = СтрокаПриборыУчета.НачальноеПоказание;
			
			ЗаписатьДокументУправлениеПриборамиУчета = Истина;
		КонецЦикла;	
		
		Если ЗаписатьДокументУправлениеПриборамиУчета Тогда
			ДокументУправлениеПриборамиУчета.Записать(РежимЗаписиДокумента.Проведение);
			
			СсылкаДокументУправлениеПриборамиУчета = ДокументУправлениеПриборамиУчета.Ссылка;
		КонецЕсли;
		
	КонецЕсли;
	
	ЗафиксироватьТранзакцию();
	
	Возврат Истина;
	
КонецФункции	

&НаСервереБезКонтекста
Функция ПолучитьКодУслуги(Услуга)
	
	Возврат Услуга.Код;
	
КонецФункции
