&НаСервере
Процедура ЗаполнитьДеревоУслугНаСервере(Перезаполнить = Ложь)
	
    Дерево = РеквизитФормыВЗначение("ДеревоУслуг");
	КвоСтрокУслуг = Дерево.Строки.Количество();
	Если КвоСтрокУслуг > 0 И Не Перезаполнить Тогда
		Возврат;
	КонецЕсли;
	
	ИспользоватьУслугиСДПТПодробно = ПолучитьФункциональнуюОпцию("ИспользоватьУслугиСДПТПодробно");
	
	Если ИспользоватьУслугиСДПТПодробно	Тогда
		ТекстЗапроса = 
		"ВЫБРАТЬ
		|	ТарифыСрезПоследних.Услуга КАК Услуга,
		|	ТарифыСрезПоследних.Услуга.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	ТарифыСрезПоследних.Услуга.Родитель КАК Родитель,
		|	ТарифыУслугПодробноСрезПоследних.УслугаПодробно КАК УслугаПодробно
		|ИЗ
		|	РегистрСведений.Тарифы.СрезПоследних(
		|			,
		|			Организация = &Организация
		|				И Здание = &Здание
		|				И ЗначениеТарифа > 0) КАК ТарифыСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ТарифыУслугПодробно.СрезПоследних(
		|				&Период,
		|				Организация = &Организация
		|					И Здание = &Здание
		|					И ЗначениеТарифа > 0) КАК ТарифыУслугПодробноСрезПоследних
		|		ПО ТарифыСрезПоследних.Услуга = ТарифыУслугПодробноСрезПоследних.Услуга
		|
		|СГРУППИРОВАТЬ ПО
		|	ТарифыСрезПоследних.Услуга.Родитель,
		|	ТарифыСрезПоследних.Услуга,
		|	ТарифыСрезПоследних.Услуга.ЕдиницаИзмерения,
		|	ТарифыУслугПодробноСрезПоследних.УслугаПодробно
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ТарифыПороговыеСрезПоследних.Услуга,
		|	ТарифыПороговыеСрезПоследних.Услуга.ЕдиницаИзмерения,
		|	ТарифыПороговыеСрезПоследних.Услуга.Родитель,
		|	NULL
		|ИЗ
		|	РегистрСведений.ТарифыПороговые.СрезПоследних(
		|			,
		|			Организация = &Организация
		|				И Здание = &Здание
		|				И ЗначениеТарифа > 0) КАК ТарифыПороговыеСрезПоследних
		|ИТОГИ ПО
		|	Родитель,
		|	Услуга,
		|	УслугаПодробно";
		
	Иначе
		ТекстЗапроса = 
		"ВЫБРАТЬ
		|	ТарифыСрезПоследних.Услуга КАК Услуга,
		|	ТарифыСрезПоследних.Услуга.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	ТарифыСрезПоследних.Услуга.Родитель КАК Родитель
		|ИЗ
		|	РегистрСведений.Тарифы.СрезПоследних(
		|			,
		|			Организация = &Организация
		|				И Здание = &Здание
		|				И ЗначениеТарифа > 0) КАК ТарифыСрезПоследних
		|
		|СГРУППИРОВАТЬ ПО
		|	ТарифыСрезПоследних.Услуга.Родитель,
		|	ТарифыСрезПоследних.Услуга,
		|	ТарифыСрезПоследних.Услуга.ЕдиницаИзмерения
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ТарифыПороговыеСрезПоследних.Услуга,
		|	ТарифыПороговыеСрезПоследних.Услуга.ЕдиницаИзмерения,
		|	ТарифыПороговыеСрезПоследних.Услуга.Родитель
		|ИЗ
		|	РегистрСведений.ТарифыПороговые.СрезПоследних(
		|			,
		|			Организация = &Организация
		|				И Здание = &Здание
		|				И ЗначениеТарифа > 0) КАК ТарифыПороговыеСрезПоследних
		|ИТОГИ ПО
		|	Родитель,
		|	Услуга";
		
	КонецЕсли;
		
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
		
	Запрос.УстановитьПараметр("Период", Объект.Дата);
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("Здание", Объект.Здание);
	
	Дерево.Строки.Очистить();
	
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
	Пока Выборка.Следующий() Цикл
		СтрокаУровень1 = Дерево.Строки.Добавить();
		СтрокаУровень1.Услуга = Выборка.Родитель;
		СтрокаУровень1.Выбран = 1;
		ВыборкаУслуга = Выборка.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаУслуга.Следующий() Цикл
			СтрокаУровень2= СтрокаУровень1.Строки.Добавить();
			СтрокаУровень2.Услуга = ВыборкаУслуга.Услуга;
			СтрокаУровень2.Выбран = 1;
			Если ИспользоватьУслугиСДПТПодробно Тогда
				ВыборкаУслугаПодробно = ВыборкаУслуга.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				Пока ВыборкаУслугаПодробно.Следующий() Цикл
					Если ЗначениеЗаполнено(ВыборкаУслугаПодробно.УслугаПодробно) Тогда
						СтрокаУровень3= СтрокаУровень2.Строки.Добавить();
						СтрокаУровень3.Услуга = ВыборкаУслугаПодробно.УслугаПодробно;
						СтрокаУровень3.Выбран = 1;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;	
		КонецЦикла;
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(Дерево, "ДеревоУслуг");

	Если КвоСтрокУслуг = 0 И ЗначениеЗаполнено(Объект.ШаблонЛицевогоСчета) Тогда
	
		ЗаполнитьУслугиПоШаблонуНаСервере();
	
	КонецЕсли; 
	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьПриборыУчетаНаСервере()
	
    УслугиДерево = РеквизитФормыВЗначение("ДеревоУслуг");
	Если УслугиДерево.Строки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Для каждого СтрокаУровень1 Из УслугиДерево.Строки Цикл
		Для каждого СтрокаУровень2 Из СтрокаУровень1.Строки Цикл
			Если СтрокаУровень2.Выбран = 1 И СтрокаУровень2.Услуга.СпособНачисления = Перечисления.СпособыНачисленияУслуг.ПоПоказаниямПрибораУчета И НЕ СтрокаУровень2.Услуга.ВидУслуги = Справочники.ВидыУслуг.Водоотведение Тогда	
				Если ПриборыУчета.НайтиСтроки(Новый Структура("Услуга", СтрокаУровень2.Услуга)).Количество() = 0 Тогда
				    //Выполняем заполнение по видам тарифа
					Если СтрокаУровень2.Услуга.ПоВидамТарифа Тогда
						ТаблицаТарифов  = СтрокаУровень2.Услуга.ВидыТарифов;
						Если ТаблицаТарифов.Количество() <> 0 Тогда
							Если ТаблицаТарифов.Количество() = 1 Тогда
								ТарифностьПрибора = Перечисления.ТарифностьСчетчиков.Однотарифный;
							ИначеЕсли ТаблицаТарифов.Количество() = 2  Тогда 
								ТарифностьПрибора = Перечисления.ТарифностьСчетчиков.Двухтарифный;
							Иначе 	
								ТарифностьПрибора = Перечисления.ТарифностьСчетчиков.Трехтарифный;
							КонецЕсли; 	
							Для Каждого Строка из ТаблицаТарифов Цикл
								НоваяСтрокаПриборыУчета = ПриборыУчета.Добавить(); 
								НоваяСтрокаПриборыУчета.Услуга = СтрокаУровень2.Услуга;
								НоваяСтрокаПриборыУчета.ДатаУстановки = Объект.Дата;
								НоваяСтрокаПриборыУчета.ВидТарифа = Строка.ВидТарифа;
								НоваяСтрокаПриборыУчета.Тарифность = ТарифностьПрибора;
								НоваяСтрокаПриборыУчета.СпособРегистрацииПоказаний = Перечисления.СпособыРегистрацииПоказанийСчетчиков.НарастающимИтогом;
								НоваяСтрокаПриборыУчета.Коэффициент = 1;
								НоваяСтрокаПриборыУчета.ЕдиницаИзмерения = СтрокаУровень2.Услуга.ЕдиницаИзмерения;
								НоваяСтрокаПриборыУчета.Разрядность = 6;
							КонецЦикла;	
						Иначе
							
							НоваяСтрокаПриборыУчета = ПриборыУчета.Добавить(); 
							НоваяСтрокаПриборыУчета.Услуга = СтрокаУровень2.Услуга;
							НоваяСтрокаПриборыУчета.ДатаУстановки = Объект.Дата;
							НоваяСтрокаПриборыУчета.ВидТарифа = Перечисления.ВидыТарифов.Общий;
							НоваяСтрокаПриборыУчета.Тарифность = Перечисления.ТарифностьСчетчиков.Однотарифный;
							НоваяСтрокаПриборыУчета.СпособРегистрацииПоказаний = Перечисления.СпособыРегистрацииПоказанийСчетчиков.НарастающимИтогом;
							НоваяСтрокаПриборыУчета.Коэффициент = 1;
							НоваяСтрокаПриборыУчета.ЕдиницаИзмерения = СтрокаУровень2.Услуга.ЕдиницаИзмерения;
							НоваяСтрокаПриборыУчета.Разрядность = 6;
						КонецЕсли;
					Иначе
						НоваяСтрокаПриборыУчета = ПриборыУчета.Добавить(); 
						НоваяСтрокаПриборыУчета.Услуга = СтрокаУровень2.Услуга;
						НоваяСтрокаПриборыУчета.ДатаУстановки = Объект.Дата;
						НоваяСтрокаПриборыУчета.ВидТарифа = Перечисления.ВидыТарифов.Общий;
						НоваяСтрокаПриборыУчета.Тарифность = Перечисления.ТарифностьСчетчиков.Однотарифный;
						НоваяСтрокаПриборыУчета.СпособРегистрацииПоказаний = Перечисления.СпособыРегистрацииПоказанийСчетчиков.НарастающимИтогом;
						НоваяСтрокаПриборыУчета.Коэффициент = 1;
						НоваяСтрокаПриборыУчета.ЕдиницаИзмерения = СтрокаУровень2.Услуга.ЕдиницаИзмерения;
						НоваяСтрокаПриборыУчета.Разрядность = 6;
					КонецЕсли;
					
				КонецЕсли;	
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры	

&НаСервереБезКонтекста
Функция ОпределитьЭтоЖилойФонд(ЖилойФонд)
	
	Возврат ЖилойФонд = Перечисления.ЖилойНеЖилойФонд.Жилой;

КонецФункции

&НаКлиенте
Процедура ЖилойФондПриИзменении(Элемент)
	
