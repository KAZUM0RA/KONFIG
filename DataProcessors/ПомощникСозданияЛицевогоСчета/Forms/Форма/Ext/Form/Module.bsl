	УстановитьВидимостьНаКлиенте();
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоУслугВыбранПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ДеревоУслуг.ТекущиеДанные;
	ВыбранПриИзменении(ТекущиеДанные);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьУслугиПоШаблонуНаСервере()
	
	Если НЕ ЗначениеЗаполнено(Объект.ШаблонЛицевогоСчета) Тогда
		Возврат;
	КонецЕсли;
	
    Дерево = РеквизитФормыВЗначение("ДеревоУслуг");

	ИспользоватьУслугиСДПТПодробно = ПолучитьФункциональнуюОпцию("ИспользоватьУслугиСДПТПодробно");
	
	Если ИспользоватьУслугиСДПТПодробно	Тогда
	
		ТекстЗапроса = 
		"ВЫБРАТЬ
		|	НазначенныеУслугиСрезПоследних.Услуга,
		|	ВложенныйЗапрос.УслугаПодробно
		|ИЗ
		|	РегистрСведений.НазначенныеУслуги.СрезПоследних(, ЛицевойСчет = &ЛицевойСчет) КАК НазначенныеУслугиСрезПоследних,
		|	(ВЫБРАТЬ
		|		НазначенныеУслугиПодробноСрезПоследних.УслугаПодробно КАК УслугаПодробно
		|	ИЗ
		|		РегистрСведений.НазначенныеУслугиПодробно.СрезПоследних(, ЛицевойСчет = &ЛицевойСчет) КАК НазначенныеУслугиПодробноСрезПоследних
		|	ГДЕ
		|		НазначенныеУслугиПодробноСрезПоследних.Действует = ИСТИНА) КАК ВложенныйЗапрос
		|ГДЕ
		|	НазначенныеУслугиСрезПоследних.Действует = ИСТИНА";
	
	Иначе
		
		ТекстЗапроса = 
		"ВЫБРАТЬ
		|	НазначенныеУслугиСрезПоследних.Услуга
		|ИЗ
		|	РегистрСведений.НазначенныеУслуги.СрезПоследних(, ЛицевойСчет = &ЛицевойСчет) КАК НазначенныеУслугиСрезПоследних
		|ГДЕ
		|	НазначенныеУслугиСрезПоследних.Действует = ИСТИНА";
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.УстановитьПараметр("ЛицевойСчет", Объект.ШаблонЛицевогоСчета);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Для каждого СтрокаУровень1 Из Дерево.Строки Цикл
		Для каждого СтрокаУровень2 Из СтрокаУровень1.Строки Цикл
			Если РезультатЗапроса.Найти(СтрокаУровень2.Услуга,"Услуга") = Неопределено Тогда
				СтрокаУровень2.Выбран = 0;	
			Иначе
				СтрокаУровень2.Выбран = 1;	
			КонецЕсли;
			
			Если ИспользоватьУслугиСДПТПодробно	Тогда
			
				Для каждого СтрокаУровень3 Из СтрокаУровень2.Строки Цикл
					Отбор = Новый Структура("Услуга, УслугаПодробно", СтрокаУровень2.Услуга, СтрокаУровень3.Услуга);
					
					Если РезультатЗапроса.НайтиСтроки(Отбор).Количество() = 0  Тогда
						СтрокаУровень3.Выбран = 0;	
					Иначе
						СтрокаУровень3.Выбран = 1;	
					КонецЕсли;
				КонецЦикла;
				
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(Дерево, "ДеревоУслуг");
	
КонецПроцедуры	

&НаКлиенте
Процедура КомандаЗаполнитьУслугиПоШаблону(Команда)
	
	ЗаполнитьУслугиПоШаблонуНаСервере();
	
	СтрокиДерева = ДеревоУслуг.ПолучитьЭлементы();
	
	Для Каждого Строка Из СтрокиДерева Цикл
		
		ИдентификаторСтроки=Строка.ПолучитьИдентификатор();
		Элементы.ДеревоУслуг.Развернуть(ИдентификаторСтроки, Истина);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ОбъектЛицевогоСчетаЗанят(ОбъектЛицевогоСчета)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛицевыеСчетаСрезПоследних.ЛицевойСчет
		|ИЗ
		|	РегистрСведений.ЛицевыеСчета.СрезПоследних КАК ЛицевыеСчетаСрезПоследних
		|ГДЕ
		|	ЛицевыеСчетаСрезПоследних.Действует = ИСТИНА
		|	И ЛицевыеСчетаСрезПоследних.ЛицевойСчет.ОбъектЛицевогоСчета = &ОбъектЛицевогоСчета";
		
		
	Запрос.УстановитьПараметр("ОбъектЛицевогоСчета", ОбъектЛицевогоСчета);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли;

КонецФункции

&НаКлиенте
Процедура ОбъектЛицевогоСчетаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	Если ОбъектЛицевогоСчетаЗанят(ВыбранноеЗначение) Тогда
		
		НСтрока = НСтр("ru='На объект уже выписан лицевой счет';uk=""На об'єкт уже виписаний особовий рахунок""");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтрока,, "Объект.ОбъектЛицевогоСчета");
		
		СтандартнаяОбработка = Ложь;
		
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗданиеПриИзменении(Элемент)
	
	Если НЕ ЗначениеЗаполнено(Объект.ИмяЛицевогоСчета) Тогда
		Объект.ИмяЛицевогоСчета = СформироватьИмяЛицевогоСчета(Объект.Здание, Объект.ОбъектЛицевогоСчета);	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбъектЛицевогоСчетаПриИзменении(Элемент)
	
	Если НЕ ЗначениеЗаполнено(Объект.ИмяЛицевогоСчета) Тогда
		Объект.ИмяЛицевогоСчета = СформироватьИмяЛицевогоСчета(Объект.Здание, Объект.ОбъектЛицевогоСчета);	
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ПриборыУчетаПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	Если ЗначениеЗаполнено(Элемент.ТекущиеДанные.ДатаУстановки) 
		И ЗначениеЗаполнено(Элемент.ТекущиеДанные.Тарифность) 
		И ЗначениеЗаполнено(Элемент.ТекущиеДанные.СпособРегистрацииПоказаний) 
		И ЗначениеЗаполнено(Элемент.ТекущиеДанные.Коэффициент) 
		И ЗначениеЗаполнено(Элемент.ТекущиеДанные.Разрядность) 
		И ЗначениеЗаполнено(Элемент.ТекущиеДанные.ЕдиницаИзмерения) Тогда
		
			Элемент.ТекущиеДанные.ДанныеЗаполнены = Истина;
		
	Иначе
		Элемент.ТекущиеДанные.ДанныеЗаполнены = Ложь;
		
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ШаблонЛицевогоСчетаПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Объект.ШаблонЛицевогоСчета) Тогда
		ЗаполнитьУслугиПоШаблонуНаСервере();
	Иначе
		ЗаполнитьДеревоУслугНаСервере(Истина);		
	КонецЕсли; 
	
	СтрокиДерева = ДеревоУслуг.ПолучитьЭлементы();
	
	Для Каждого Строка Из СтрокиДерева Цикл
		
		ИдентификаторСтроки=Строка.ПолучитьИдентификатор();
		Элементы.ДеревоУслуг.Развернуть(ИдентификаторСтроки, Истина);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте                        
Процедура ПриборыУчетаДатаПоследнейПоверкиПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ПриборыУчета.ТекущиеДанные;
	Если ЗначениеЗаполнено(ТекущиеДанные.ДатаСледующейПоверки) Тогда
		НайденныеСтроки = РазницаДатПоверкиПриборовУчета.НайтиСтроки(Новый Структура("Услуга", ТекущиеДанные.Услуга));
		Если НайденныеСтроки.Количество() = 0 Тогда
			НоваяСтрока = РазницаДатПоверкиПриборовУчета.Добавить();
			НоваяСтрока.Услуга = ТекущиеДанные.Услуга;
			НоваяСтрока.РазницаДат = ТекущиеДанные.ДатаСледующейПоверки - ТекущиеДанные.ДатаПоследнейПоверки;
		Иначе
			НайденныеСтроки[0].РазницаДат = ТекущиеДанные.ДатаСледующейПоверки - ТекущиеДанные.ДатаПоследнейПоверки;
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ТекущиеДанные.ДатаСледующейПоверки) Тогда
		НайденныеСтроки = РазницаДатПоверкиПриборовУчета.НайтиСтроки(Новый Структура("Услуга", ТекущиеДанные.Услуга));
		Если НайденныеСтроки.Количество() > 0 Тогда
			ТекущиеДанные.ДатаСледующейПоверки = ТекущиеДанные.ДатаПоследнейПоверки + НайденныеСтроки[0].РазницаДат;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

