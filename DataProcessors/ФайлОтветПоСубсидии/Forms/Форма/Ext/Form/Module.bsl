&НаСервере
Функция Начисления(ЛС, ДатаЗапроса)
	Начисления = Новый Структура;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	    "ВЫБРАТЬ
	    |	РасчетыПоЛицевымСчетам.Сумма,
	    |	РасчетыПоЛицевымСчетам.Количество,
	    |	РасчетыПоЛицевымСчетам.Услуга.ВидУслуги КАК ВидУслуги,
	    |	РасчетыПоЛицевымСчетам.Услуга
	    |ИЗ
	    |	РегистрНакопления.РасчетыПоЛицевымСчетам КАК РасчетыПоЛицевымСчетам
	    |ГДЕ
	    |	РасчетыПоЛицевымСчетам.ВидДвижения = &ВидДвижения
	    |	И РасчетыПоЛицевымСчетам.МесяцНачисления = &МесяцНачисления
	    |	И РасчетыПоЛицевымСчетам.ЛицевойСчет = &ЛицевойСчет
	    |	И РасчетыПоЛицевымСчетам.Период = &Период";
	Запрос.УстановитьПараметр("ВидДвижения", ВидДвиженияНакопления.Приход);
	Запрос.УстановитьПараметр("Период", ДобавитьМесяц(КонецМесяца(ДатаЗапроса), -1));
	Запрос.УстановитьПараметр("МесяцНачисления", ДобавитьМесяц(НачалоМесяца(ДатаЗапроса), -1));
	Запрос.УстановитьПараметр("ЛицевойСчет", ЛС);
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Канализация = 0;
	Вода = 0;
	Сумма = 0;
	АбонПлата = 0;
	Пока Выборка.Следующий() Цикл
		Если Выборка.ВидУслуги = Справочники.ВидыУслуг.Водоотведение Тогда
			Канализация = Канализация + Выборка.Количество;
			Сумма = Сумма + Выборка.Сумма;
		ИначеЕсли Выборка.ВидУслуги = Справочники.ВидыУслуг.ХолоднаяВода Тогда
			Вода = Вода + Выборка.Количество;
			Сумма = Сумма + Выборка.Сумма;
		ИначеЕсли Выборка.Услуга.ВидУслуги = Справочники.ВидыУслуг.Дополнительные И Выборка.Услуга.СпособНачисления = Перечисления.СпособыНачисленияУслуг.ПоРасчетнымЗначениям Тогда//Справочники.Услуги.НайтиПоКоду("Р00000182") ИЛИ Выборка.Услуга = Справочники.Услуги.НайтиПоКоду("Р00000184") ИЛИ Выборка.Услуга = Справочники.Услуги.НайтиПоКоду("Р00000185") ИЛИ Выборка.Услуга = Справочники.Услуги.НайтиПоКоду("Р00000186") Тогда
			АбонПлата = АбонПлата + Выборка.Сумма;
			Сумма = Сумма + Выборка.Сумма;
		КонецЕсли;
	КонецЦикла;
	Начисления.Вставить("Канализация", Канализация);
	Начисления.Вставить("Вода", Вода);
	Начисления.Вставить("Сумма", Сумма);
	Начисления.Вставить("АбонПлата", АбонПлата);
	Возврат Начисления;
КонецФункции

&НаСервере
Функция Долг(ЛС, ДатаЗапроса)
	// Запрос по оплате
		Запрос = Новый Запрос;
		Запрос.Текст = 
		    "ВЫБРАТЬ
		    |	РасчетыПоЛицевымСчетамОбороты.СуммаРасход
		    |ИЗ
		    |	РегистрНакопления.РасчетыПоЛицевымСчетам.Обороты(&НачалоПериода, &КонецПериода, Авто, ЛицевойСчет = &ЛицевойСчет) КАК РасчетыПоЛицевымСчетамОбороты";
		Запрос.УстановитьПараметр("НачалоПериода", ДобавитьМесяц(НачалоМесяца(ДатаЗапроса), -1));
		Запрос.УстановитьПараметр("КонецПериода", ДобавитьМесяц(КонецМесяца(ДатаЗапроса), -1));
		Запрос.УстановитьПараметр("ЛицевойСчет", ЛС);
		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		Оплата = 0;
		Пока Выборка.Следующий() Цикл
			Оплата = Оплата + Выборка.СуммаРасход;
		КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	    "ВЫБРАТЬ
	    |	РасчетыПоЛицевымСчетамОстатки.СуммаОстаток,
	    |	РасчетыПоЛицевымСчетамОстатки.МесяцНачисления,
	    |	РасчетыПоЛицевымСчетамОстатки.Услуга
	    |ИЗ
	    |	РегистрНакопления.РасчетыПоЛицевымСчетам.Остатки(&НачалоПериода, ЛицевойСчет = &ЛицевойСчет) КАК РасчетыПоЛицевымСчетамОстатки";
	
	
	Запрос.УстановитьПараметр("НачалоПериода", ДобавитьМесяц(НачалоМесяца(ДатаЗапроса), -1));
	Запрос.УстановитьПараметр("ЛицевойСчет", ЛС);
	Результат = Запрос.Выполнить().Выгрузить();
	Долг = Результат.Итог("СуммаОстаток");
	СуммаДолга = Долг - Оплата;
	Если СуммаДолга < 0 Тогда
		СуммаДолга = 0;
	КонецЕсли;

	Возврат СуммаДолга;
КонецФункции