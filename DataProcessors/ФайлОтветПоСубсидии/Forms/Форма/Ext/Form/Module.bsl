&НаСервере
Процедура ЗаполнитьДаннымиНаСервере()
	тзТабЧасть = Объект.ТабличнаяЧасть.Выгрузить();
	Для Каждого стр Из тзТабЧасть Цикл
		ЛицСчет = Число(стр.OWN_NUM_SR);
		ЛС = ПолучитьЛицевыеСчета(СтрЗаменить(Строка(ЛицСчет), Символы.НПП, ""));
		стр.FROG     = ПолучитьПроцентЛьгот(ЛС);
		//стр.OPP      = ПризнакУслуг(ЛС);
		КубыСумма    = Начисления(ЛС, стр.DAT1);
		стр.FL_PAY   = КубыСумма.Сумма;
		стр.DEBT     = Долг(ЛС, стр.DAT1);
		стр.NORM_F_4 = КубыСумма.Вода;
		стр.NORM_F_8 = КубыСумма.Канализация;
		//стр.OWN_NUM_SR = ЛС;
	КонецЦикла;
	Объект.ТабличнаяЧасть.Загрузить(тзТабЧасть);
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДанными(Команда)
	ЗаполнитьДаннымиНаСервере();
КонецПроцедуры




