&НаКлиенте
Процедура Декорация8Нажатие(Элемент)
	
	Организация = УстановитьОрганизациюНаСервере();
	
	Если Организация <> Неопределено Тогда
		ПараметрыОткрытия = Новый Структура("Ключ",Организация);
		ОткрытьФорму("Справочник.Организации.Форма.ФормаЭлемента" ,ПараметрыОткрытия);
	Иначе
		ОткрытьФорму("Справочник.Организации.ФормаСписка");
	КонецЕсли;

КонецПроцедуры


&НаСервере
Функция  УстановитьОрганизациюНаСервере()

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Организации.Ссылка
	|ИЗ
	|	Справочник.Организации КАК Организации";
	Организации =  Запрос.Выполнить().Выгрузить();			
	
	Если Организации.Количество() = 1 Тогда
		 Возврат Организации[0].Ссылка;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
			  
КонецФункции //

