
&НаКлиенте
Процедура ПередЗакрытием(Отказ, СтандартнаяОбработка)
	
	ВидРС = РС_СменитьСтол.ПолучитьНастройкиСтола();
	Если ЗначениеЗаполнено(ВидРС) = Ложь тогда
		РС_СменитьСтол.СменитьСтол();
	Иначе
		РС_СменитьСтол.СменитьСтол(ВидРС);
	КонецЕсли;
	ОСМДКлиент.ПолучитьПараметрыФункциональныхОпций();

КонецПроцедуры


&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	ОбщегоНазначения.ХранилищеОбщихНастроекСохранить("ОбновлениеИБ", "ПервоначальноеЗаполнениеИБ", Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если НаборКонстант.ИспользоватьВариантКоттеджныйПоселок Тогда
		Элементы.ОпцияПоселок.ТекущаяСтраница = Элементы.ОпцияПоселок.ПодчиненныеЭлементы.ПоселокДА;
	Иначе
		Элементы.ОпцияПоселок.ТекущаяСтраница = Элементы.ОпцияПоселок.ПодчиненныеЭлементы.ПоселокНет;
	КонецЕсли;
	
	Если НаборКонстант.УслугиСДПТПодробно Тогда
		Элементы.ОпцияСДПТФлаг.ТекущаяСтраница = Элементы.ОпцияСДПТФлаг.ПодчиненныеЭлементы.СДПТФлагДА;
	Иначе
		Элементы.ОпцияСДПТФлаг.ТекущаяСтраница = Элементы.ОпцияСДПТФлаг.ПодчиненныеЭлементы.СДПТФлагНет;
	КонецЕсли;
	
	
КонецПроцедуры


&НаКлиенте
Процедура Декорация2Нажатие(Элемент)
	Элементы.ОпцияПоселок.ТекущаяСтраница = Элементы.ОпцияПоселок.ПодчиненныеЭлементы.ПоселокНет;
	НаборКонстант.ИспользоватьВариантКоттеджныйПоселок = Ложь;
	Модифицированность = Истина;
	ОбновитьИнтерфейс();
КонецПроцедуры

&НаКлиенте
Процедура Декорация3Нажатие(Элемент)
	
	Элементы.ОпцияПоселок.ТекущаяСтраница = Элементы.ОпцияПоселок.ПодчиненныеЭлементы.ПоселокДА;
	Элементы.ОпцияГородФлаг.ТекущаяСтраница = Элементы.ОпцияГородФлаг.ПодчиненныеЭлементы.ОпцияГородНЕТ;
	НаборКонстант.ЗадействоватьОпциюГород = Ложь;
	НаборКонстант.ИспользоватьВариантКоттеджныйПоселок = Истина;
	Модифицированность = Истина;
	ОбновитьИнтерфейс();
	
КонецПроцедуры


