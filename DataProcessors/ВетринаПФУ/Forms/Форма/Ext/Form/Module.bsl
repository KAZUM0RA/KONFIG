	ЗаписьXML.ЗаписатьКонецЭлемента();
		
	Для Каждого стр Из ДанныеДляВыгрузки Цикл
		ЗаписьXML.ЗаписатьНачалоЭлемента("row");            // Початок рядку
		    ЗаписьXML.ЗаписатьНачалоЭлемента("services");   // Початок послуг
			
			    ЗаписьXML.ЗаписатьНачалоЭлемента("cod");
				ЗаписьXML.ЗаписатьТекст(стр.COD);
				ЗаписьXML.ЗаписатьКонецЭлемента();
				ЗаписьXML.ЗаписатьНачалоЭлемента("cdpr_sub");
				ЗаписьXML.ЗаписатьТекст(стр.CDPR_Sub);
				ЗаписьXML.ЗаписатьКонецЭлемента();
				ЗаписьXML.ЗаписатьНачалоЭлемента("service_point");
				ЗаписьXML.ЗаписатьТекст(стр.SERVICE_POINT);
				ЗаписьXML.ЗаписатьКонецЭлемента();
				ЗаписьXML.ЗаписатьНачалоЭлемента("cdpr_rep");
				ЗаписьXML.ЗаписатьТекст(стр.CDPR_Rep);
				ЗаписьXML.ЗаписатьКонецЭлемента();
				ЗаписьXML.ЗаписатьНачалоЭлемента("cdpr_rec");
				ЗаписьXML.ЗаписатьТекст(стр.CDPR_Rec);
				ЗаписьXML.ЗаписатьКонецЭлемента();
				ЗаписьXML.ЗаписатьНачалоЭлемента("perin");
				ЗаписьXML.ЗаписатьТекст(Строка(Формат(стр.PERIN, "ДФ=dd.MM.yyyy")));
				ЗаписьXML.ЗаписатьКонецЭлемента();
				ЗаписьXML.ЗаписатьНачалоЭлемента("peroff");
				ЗаписьXML.ЗаписатьТекст(Строка(Формат(стр.PEROFF, "ДФ=dd.MM.yyyy")));
				ЗаписьXML.ЗаписатьКонецЭлемента();
				ЗаписьXML.ЗаписатьНачалоЭлемента("debt_start");
				ЗаписьXML.ЗаписатьТекст(Строка(Формат(стр.PEROFF, "ДФ=dd.MM.yyyy")));
				ЗаписьXML.ЗаписатьКонецЭлемента();
				
				ЗаписьXML.ЗаписатьНачалоЭлемента("osobs");  // Початок Осбові рахунки
				    ЗаписьXML.ЗаписатьНачалоЭлемента("row_num");
					ЗаписьXML.ЗаписатьТекст(Строка(стр.ROW_NUM));
					ЗаписьXML.ЗаписатьКонецЭлемента();
					ЗаписьXML.ЗаписатьНачалоЭлемента("eic");
					ЗаписьXML.ЗаписатьТекст(стр.EIC);
					ЗаписьXML.ЗаписатьКонецЭлемента();
					ЗаписьXML.ЗаписатьНачалоЭлемента("osob");
					ЗаписьXML.ЗаписатьТекст(стр.OSOB);
					ЗаписьXML.ЗаписатьКонецЭлемента();
