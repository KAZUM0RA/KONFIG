&НаСервере
Функция ПолучитьМассивЛС(МассивЗданий = Неопределено)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	    "ВЫБРАТЬ
		|	ЛицевыеСчетаСрезПоследних.ЛицевойСчет КАК ЛицевойСчет
		|ИЗ
		|	РегистрСведений.ЛицевыеСчета.СрезПоследних(
		|			&ДатаКон,
		|			ЛицевойСчет.Владелец.Организация = &Организация
		|				И ВЫБОР
		|					КОГДА &Все
		|						ТОГДА ИСТИНА
		|					ИНАЧЕ ЛицевойСчет.Владелец В (&МассивЗданий)
		|				КОНЕЦ) КАК ЛицевыеСчетаСрезПоследних
		|ГДЕ
		|	ЛицевыеСчетаСрезПоследних.Действует
		|	И ЛицевыеСчетаСрезПоследних.ЛицевойСчет.ОбъектЛицевогоСчета.ЖилойФонд = &ЖилойФонд
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЛицевыеСчетаСрезПоследних.ЛицевойСчет.ОбъектЛицевогоСчета.Код";
	Запрос.УстановитьПараметр("ДатаКон",     НачалоМесяца(ТекущаяДата()));
	Запрос.УстановитьПараметр("Организация", Справочники.Организации.НайтиПоКоду("000000001"));
	Запрос.УстановитьПараметр("МассивЗданий", МассивЗданий);
	Запрос.УстановитьПараметр("ЖилойФонд", Перечисления.ЖилойНеЖилойФонд.Жилой);
	Если МассивЗданий = Неопределено Тогда
		Запрос.УстановитьПараметр("Все", Истина);
	Иначе
		Запрос.УстановитьПараметр("Все", Ложь);
	КонецЕсли;
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат.ВыгрузитьКолонку("ЛицевойСчет");
		
КонецФункции

&НаСервере
Функция ПолучитьУслугиПоЛС(ЛицевойСчет)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	    "ВЫБРАТЬ РАЗЛИЧНЫЕ
	    |	НазначенныеУслугиСрезПоследних.ЛицевойСчет,
	    |	НазначенныеУслугиСрезПоследних.Действует,
	    |	НазначенныеУслугиСрезПоследних.Период,
	    |	МАКСИМУМ(НазначенныеУслугиСрезПоследних.Период) КАК ДатаОкончанияДействия,
	    |	НазначенныеУслугиСрезПоследних.Услуга,
	    |	НазначенныеУслугиСрезПоследних.Услуга.КодУслугиПФУ КАК КодУслугиПФУ
	    |ИЗ
	    |	РегистрСведений.НазначенныеУслуги.СрезПоследних(&НаДату, ЛицевойСчет = &ЛицевойСчет) КАК НазначенныеУслугиСрезПоследних
	    |
	    |СГРУППИРОВАТЬ ПО
	    |	НазначенныеУслугиСрезПоследних.ЛицевойСчет,
	    |	НазначенныеУслугиСрезПоследних.Организация,
	    |	НазначенныеУслугиСрезПоследних.Действует,
	    |	НазначенныеУслугиСрезПоследних.Услуга,
	    |	НазначенныеУслугиСрезПоследних.Период,
	    |	НазначенныеУслугиСрезПоследних.Регистратор";
		
	Запрос.УстановитьПараметр("НаДату",      КонецМесяца(ТекущаяДата()));
	Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	тз = Новый ТаблицаЗначений;
	тз.Колонки.Добавить("Услуга");
	тз.Колонки.Добавить("КодПФУ");
	Пока Выборка.Следующий() Цикл
		Если Выборка.Действует = Истина Тогда
			НовСтрока = тз.Добавить();
			НовСтрока.Услуга = Выборка.Услуга;
			НовСтрока.КодПФУ = Выборка.КодУслугиПФУ;
		КонецЕсли;
	КонецЦикла;
	тз.Свернуть("КодУслугиПФУ");
	Возврат тз;
	
КонецФункции

&НаСервере
Функция РазложитьСтрокуВМассивПодстрок(Знач Стр, Разделитель = ",") Экспорт
	
	МассивСтрок = Новый Массив();
	Если Разделитель = " " Тогда
		Стр = СокрЛП(Стр);
		Пока 1=1 Цикл
			Поз = Найти(Стр,Разделитель);
			Если Поз=0 Тогда
				МассивСтрок.Добавить(Стр);
				Возврат МассивСтрок;
			КонецЕсли;
			МассивСтрок.Добавить(Лев(Стр,Поз-1));
			Стр = СокрЛ(Сред(Стр,Поз));
		КонецЦикла;
	Иначе
		ДлинаРазделителя = СтрДлина(Разделитель);
		Пока 1=1 Цикл
			Поз = Найти(Стр,Разделитель);
			Если Поз=0 Тогда
				МассивСтрок.Добавить(Стр);
				Возврат МассивСтрок;
			КонецЕсли;
			МассивСтрок.Добавить(Лев(Стр,Поз-1));
			Стр = Сред(Стр,Поз+ДлинаРазделителя);
		КонецЦикла;
	КонецЕсли;
	
КонецФункции // глРазложить

&НаСервере
Функция ПолучитьПредставлениеАдреса(Массив, Квартира, КодЯзыкаПечать) Экспорт 
	
	СтрокаАдрес = "";
	Сч = Массив.ВГраница();
	Пока НЕ(Сч < 0) Цикл
		Если Сч = 3 Тогда   //Массив.ВГраница()  Тогда
			СтрокаАдрес = Массив[Сч];
		Иначе
			Если Сч = 1 ИЛИ Сч = 0 Тогда
			    СтрокаАдрес = СтрокаАдрес+", "+Массив[Сч];
			КонецЕсли;
		КонецЕсли;
		Сч = Сч-1;
	КонецЦикла;
	//СтрокаАдрес = СтрокаАдрес + ?(Квартира.Подъезд = Справочники.Подъезды.ПустаяСсылка(),"",", "Квартира.Подъезд.Наименование)
			//+ Квартира.Наименование;
      СтрокаАдрес = СтрокаАдрес + ", " + Квартира;
			
			Если КодЯзыкаПечать = "uk" Тогда
				СтрокаАдрес = СтрЗаменить(СтрокаАдрес, "дом","");
				СтрокаАдрес = СтрЗаменить(СтрокаАдрес,"Подъезд","");
				СтрокаАдрес = СтрЗаменить(СтрокаАдрес,"Секция","");
			Иначе
				СтрокаАдрес = СтрЗаменить(СтрокаАдрес,"Під'їз","");
				СтрокаАдрес = СтрЗаменить(СтрокаАдрес,"Секція","");
			КонецЕсли;
			
	Возврат СтрокаАдрес; 
	
КонецФункции // ПолучитьПредставлениеАдреса()

&НаСервере
Функция ПолучитьТарифПоУслуге(Услуга , Здание) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТарифыСрезПоследних.ЗначениеТарифа,
		|	ТарифыСрезПоследних.НормаПотребления,
		|	ТарифыСрезПоследних.ЗначениеТарифаПоНорме
		|ИЗ
		|	РегистрСведений.Тарифы.СрезПоследних(
		|			&Период,
		|			Услуга.КодУслугиПФУ = &КодУслугиПФУ
		|				И Здание = &Здание) КАК ТарифыСрезПоследних";
	
	Запрос.УстановитьПараметр("Период", Новый Граница(ТекущаяДата(), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("КодУслугиПФУ", Услуга);
	Запрос.УстановитьПараметр("Здание", Здание);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Тарифы = Новый Структура;
	
	Пока Выборка.Следующий() Цикл
		Тарифы.Вставить("ЗначениеТарифа", Выборка.ЗначениеТарифа);
		Тарифы.Вставить("НормаПотребления", Выборка.НормаПотребления);
		Тарифы.Вставить("ЗначениеТарифаПоНорме", Выборка.ЗначениеТарифаПоНорме);
	КонецЦикла;
    Возврат Тарифы;
	
КонецФункции

&НаСервере
Функция ОтветственныйВладелец(ЛС) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
	    "ВЫБРАТЬ
	    |	ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ОтветственныйВладелец.ФизЛицо.Представление КАК ФИО,
	    |	ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ОтветственныйВладелец.ФизЛицо.ИНН КАК ИНН
	    |ИЗ
	    |	РегистрСведений.ОтветственныйВладелецЛицевогоСчета.СрезПоследних(
	    |			&НаДату,
	    |			Активность = ИСТИНА
	    |				И ЛицевойСчет = &ЛицевойСчет) КАК ОтветственныйВладелецЛицевогоСчетаСрезПоследних";
	Запрос.УстановитьПараметр("НаДату", НачалоМесяца(ТекущаяДата()));
	Запрос.УстановитьПараметр("ЛицевойСчет", ЛС);
	Результат = Запрос.Выполнить().Выбрать();
	ОтветственныйВладелец = Новый Структура;
	Пока Результат.Следующий() Цикл
		ОтветственныйВладелец.Вставить("ИНН", Результат.ИНН);
		ФИО = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(Результат.ФИО, " ");
		Если ФИО.Количество() = 3 Тогда
			ОтветственныйВладелец.Вставить("Фамилия", ФИО[0]);
			ОтветственныйВладелец.Вставить("Имя", ФИО[1]);
			ОтветственныйВладелец.Вставить("Отчество", ФИО[2]);
		ИначеЕсли ФИО.Количество() = 2 Тогда
			ОтветственныйВладелец.Вставить("Фамилия", ФИО[0]);
			ОтветственныйВладелец.Вставить("Имя", ФИО[1]);
			ОтветственныйВладелец.Вставить("Отчество", "");
		ИначеЕсли ФИО.Количество() = 2 Тогда
			ОтветственныйВладелец.Вставить("Фамилия", ФИО[0]);
			ОтветственныйВладелец.Вставить("Имя", "");
			ОтветственныйВладелец.Вставить("Отчество", "");
		КонецЕсли;
	КонецЦикла;
	Возврат ОтветственныйВладелец;
КонецФункции

