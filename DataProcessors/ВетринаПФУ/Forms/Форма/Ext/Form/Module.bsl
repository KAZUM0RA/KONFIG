&НаСервере
Функция ПолучитьОстатки(НаДату, ЛицевойСчет, Услуга) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
	    "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	    |	ВложенныйЗапрос.ЛицевойСчет,
	    |	СУММА(ВложенныйЗапрос.СуммаНачальныйОстаток) КАК СуммаНачальныйОстаток,
	    |	СУММА(ВложенныйЗапрос.СуммаНачисления) КАК СуммаНачисления,
	    |	СУММА(ВложенныйЗапрос.СуммаОплаты) КАК СуммаОплаты,
	    |	СУММА(ВложенныйЗапрос.Льготы) КАК Льготы,
	    |	СУММА(ВложенныйЗапрос.Субсидия) КАК Субсидия,
	    |	СУММА(ВложенныйЗапрос.Перерасчет) КАК Перерасчет
	    |ИЗ
	    |	(ВЫБРАТЬ
	    |		РасчетыПоЛицевымСчетамОстаткиИОбороты.ЛицевойСчет КАК ЛицевойСчет,
	    |		РасчетыПоЛицевымСчетамОстаткиИОбороты.СуммаНачальныйОстаток КАК СуммаНачальныйОстаток,
	    |		РасчетыПоЛицевымСчетамОстаткиИОбороты.СуммаПриход КАК СуммаНачисления,
	    |		РасчетыПоЛицевымСчетамОстаткиИОбороты.СуммаРасход КАК СуммаОплаты,
	    |		0 КАК Льготы,
	    |		0 КАК Субсидия,
	    |		0 КАК Перерасчет,
	    |		РасчетыПоЛицевымСчетамОстаткиИОбороты.Услуга.ВидУслуги КАК УслугаВидУслуги
	    |	ИЗ
	    |		РегистрНакопления.РасчетыПоЛицевымСчетам.ОстаткиИОбороты(&ДатаНачала, &ДатаОкончания, Авто, , ЛицевойСчет.ПометкаУдаления = ЛОЖЬ) КАК РасчетыПоЛицевымСчетамОстаткиИОбороты
	    |	ГДЕ
	    |		РасчетыПоЛицевымСчетамОстаткиИОбороты.Услуга.КодУслугиПФУ = &КодУслугиПФУ
	    |	
	    |	СГРУППИРОВАТЬ ПО
	    |		РасчетыПоЛицевымСчетамОстаткиИОбороты.ПериодГод,
	    |		РасчетыПоЛицевымСчетамОстаткиИОбороты.ЛицевойСчет,
	    |		РасчетыПоЛицевымСчетамОстаткиИОбороты.СуммаНачальныйОстаток,
	    |		РасчетыПоЛицевымСчетамОстаткиИОбороты.СуммаПриход,
	    |		РасчетыПоЛицевымСчетамОстаткиИОбороты.СуммаРасход,
	    |		РасчетыПоЛицевымСчетамОстаткиИОбороты.Услуга.ВидУслуги
	    |	
	    |	ОБЪЕДИНИТЬ ВСЕ
	    |	
	    |	ВЫБРАТЬ
	    |		РасчетыПоЛицевымСчетам.ЛицевойСчет,
	    |		0,
	    |		0,
	    |		0,
	    |		СУММА(ВЫБОР
	    |				КОГДА РасчетыПоЛицевымСчетам.ВидНачисления = ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Льгота)
	    |					ТОГДА РасчетыПоЛицевымСчетам.Сумма
	    |				ИНАЧЕ 0
	    |			КОНЕЦ),
	    |		ВЫБОР
	    |			КОГДА РасчетыПоЛицевымСчетам.ВидНачисления = ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Субсидия)
	    |				ТОГДА РасчетыПоЛицевымСчетам.Сумма
	    |			ИНАЧЕ 0
	    |		КОНЕЦ,
	    |		СУММА(ВЫБОР
	    |				КОГДА РасчетыПоЛицевымСчетам.ВидНачисления = ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Перерасчет)
	    |						ИЛИ РасчетыПоЛицевымСчетам.ВидНачисления = ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Корректировка)
	    |					ТОГДА РасчетыПоЛицевымСчетам.Сумма
	    |				ИНАЧЕ 0
	    |			КОНЕЦ),
	    |		РасчетыПоЛицевымСчетам.Услуга.ВидУслуги
	    |	ИЗ
	    |		РегистрНакопления.РасчетыПоЛицевымСчетам КАК РасчетыПоЛицевымСчетам
	    |	ГДЕ
	    |		РасчетыПоЛицевымСчетам.ЛицевойСчет.ПометкаУдаления = ЛОЖЬ
	    |		И РасчетыПоЛицевымСчетам.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
	    |		И РасчетыПоЛицевымСчетам.Услуга.КодУслугиПФУ = &КодУслугиПФУ
	    |	
	    |	СГРУППИРОВАТЬ ПО
	    |		РасчетыПоЛицевымСчетам.ЛицевойСчет,
	    |		ВЫБОР
	    |			КОГДА РасчетыПоЛицевымСчетам.ВидНачисления = ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Субсидия)
	    |				ТОГДА РасчетыПоЛицевымСчетам.Сумма
	    |			ИНАЧЕ 0
	    |		КОНЕЦ,
	    |		РасчетыПоЛицевымСчетам.Услуга.ВидУслуги) КАК ВложенныйЗапрос
	    |ГДЕ
	    |	ВложенныйЗапрос.ЛицевойСчет = &ЛицевойСчет
	    |
	    |СГРУППИРОВАТЬ ПО
	    |	ВложенныйЗапрос.ЛицевойСчет";
	Запрос.УстановитьПараметр("ДатаНачала", '20221001');
	Запрос.УстановитьПараметр("ДатаОкончания", КонецМесяца(НаДату));
	Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
	Запрос.УстановитьПараметр("КодУслугиПФУ", Услуга);
	Результат = Запрос.Выполнить();
	Если НЕ Результат.Пустой() Тогда
	    Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл
			Сумма = Выборка.СуммаНачисления - Выборка.СуммаОплаты;
		КонецЦикла;
		Если Сумма < 0 Тогда
			Сумма = 0;
		КонецЕсли;
	КонецЕсли;
	Возврат Сумма;
КонецФункции

&НаКлиенте
Процедура ВыгрузитьВФайл(Команда)
	
	Разделитель = ";";
	Текст = "";
	Таблица = Объект.ДанныеВетрины;
	
	Для Каждого Запись Из Таблица Цикл
		Если Текст = "" Тогда
			Текст = СоздатьЗаголовки(Таблица, Разделитель) + Символы.ПС;
		КонецЕсли;
		Текст = Текст + Запись.НомерСтроки + Разделитель + Запись.CDPR_Bas + Разделитель + Запись.CDPR_Sub + Разделитель + Запись.SERVICE_POINT + Разделитель +
		        Запись.OSOB + Разделитель + Запись.DIV_PER_ACC + Разделитель + Запись.EIC + Разделитель + Запись.LN_NAME + Разделитель + Запись.FN_NAME +
				Разделитель + Запись.SN_NAME + Разделитель + Запись.IPN + Разделитель + Запись.PASS_SERIAL + Разделитель + Запись.PASS_NUMBER + Разделитель +
				Запись.KATOTTG + Разделитель + Запись.REGION + Разделитель + Запись.DISTRICT + Разделитель + Запись.LOCAL_COMMUNITY + Разделитель +
				Запись.SETTLEMENT + Разделитель + Запись.STREET + Разделитель + Запись.HOUSE + Разделитель + Запись.CASE + Разделитель + Запись.APT_NUM +
				Разделитель + Запись.APT_FLOOR + Разделитель + Запись.HOUSE_FLOOR + Разделитель + Запись.PLZAG + Разделитель + Запись.PLOPAL + Разделитель +
				Запись.ZONE + Разделитель + Запись.ZABORG + Разделитель + Запись.RESTRUC + Разделитель + Запись.COD + Разделитель + Запись.TARIF + Разделитель +
				Запись.REASON + Разделитель + Запись.UNITS + Разделитель + Запись.BENEFIT + Разделитель + Запись.SUBSIDY + Разделитель + Запись.CDPR_Rep +
				Разделитель + Запись.CDPR_Rec + Разделитель + Запись.PERIN + Разделитель + Запись.PEROFF + Разделитель + Запись.POST_INDEX + Запись.DEBT_START;
	КонецЦикла;
	Кодировка = КодировкаТекста.ANSI;
	ТекстовыйФайлЗапись = Новый ЗаписьТекста(Объект.Файл, Кодировка);
	ТекстовыйФайлЗапись.Записать(Текст);
	ТекстовыйФайлЗапись.Закрыть();
	
КонецПроцедуры

&НаСервере
Функция СоздатьЗаголовки(ТаблицаДокументов, Разделитель)
	НоваяТаблица = ТаблицаДокументов.Выгрузить();
	КолонкиТЗ = НоваяТаблица.Колонки;
	Для каждого Колонка Из КолонкиТЗ Цикл
		Если Колонка.Имя = "НомерСтроки" ИЛИ Колонка.Имя = "ИсходныйНомерСтроки" Тогда
			Продолжить;
		Иначе
		    СтрКолонки = "" + СтрКолонки + Колонка.Имя + Разделитель;
		КонецЕсли;
	КонецЦикла; 
	Возврат СтрКолонки;
КонецФункции

&НаСервере
Функция ВыборДанныхОбщимЗапросом(ЛицевойСчет)

	Запрос = Новый Запрос;
	Запрос.Текст =
	    "ВЫБРАТЬ РАЗЛИЧНЫЕ
	    |	НазначенныеУслугиСрезПоследних.ЛицевойСчет,
	    |	НазначенныеУслугиСрезПоследних.Действует,
	    |	НазначенныеУслугиСрезПоследних.Период,
	    |	МАКСИМУМ(НазначенныеУслугиСрезПоследних.Период) КАК ДатаОкончанияДействия,
	    |	НазначенныеУслугиСрезПоследних.Услуга,
	    |	НазначенныеУслугиСрезПоследних.Услуга.КодУслугиПФУ КАК КодУслугиПФУ
	    |ИЗ
	    |	РегистрСведений.НазначенныеУслуги.СрезПоследних(&НаДату, ЛицевойСчет = &ЛицевойСчет) КАК НазначенныеУслугиСрезПоследних
	    |СГРУППИРОВАТЬ ПО
	    |	НазначенныеУслугиСрезПоследних.ЛицевойСчет,
	    |	НазначенныеУслугиСрезПоследних.Организация,
	    |	НазначенныеУслугиСрезПоследних.Действует,
	    |	НазначенныеУслугиСрезПоследних.Услуга,
	    |	НазначенныеУслугиСрезПоследних.Период,
	    |	НазначенныеУслугиСрезПоследних.Регистратор,
	    |	НазначенныеУслугиСрезПоследних.Услуга.КодУслугиПФУ
	    |;
	    |////////////////////////////////////////////////////////////////////////////////
	    |ВЫБРАТЬ
	    |	ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ОтветственныйВладелец.ФизЛицо.Представление КАК ФИО,
	    |	ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ОтветственныйВладелец.ФизЛицо.ИНН КАК ИНН
	    |ИЗ
	    |	РегистрСведений.ОтветственныйВладелецЛицевогоСчета.СрезПоследних(
	    |			&НаДату,
	    |			Активность = ИСТИНА
	    |				И ЛицевойСчет = &ЛицевойСчет) КАК ОтветственныйВладелецЛицевогоСчетаСрезПоследних
	    |;
	    |////////////////////////////////////////////////////////////////////////////////
	    |ВЫБРАТЬ
	    |	ПлощадьОбъектовЛицевыхСчетовСрезПоследних.Площадь,
	    |	ПлощадьОбъектовЛицевыхСчетовСрезПоследних.ВидПлощади
	    |ИЗ
	    |	РегистрСведений.ПлощадьОбъектовЛицевыхСчетов.СрезПоследних(
	    |			&НаДату,
	    |			Помещение.Владелец = &Здание
	    |				И Помещение = &Помещение) КАК ПлощадьОбъектовЛицевыхСчетовСрезПоследних";
	Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
	Запрос.УстановитьПараметр("НаДату", НачалоМесяца(ТекущаяДата()));
	Запрос.УстановитьПараметр("Здание", ЛицевойСчет.Владелец);
	Запрос.УстановитьПараметр("Помещение", ЛицевойСчет.ОбъектЛицевогоСчета);

	Возврат Запрос.ВыполнитьПакет();

КонецФункции

&НаСервере
Функция ТарифПоУслугеКеш(КодУслугиПФУ, Здание, Кеш)
	Ключ = Строка(КодУслугиПФУ) + "|" + Строка(Здание.УникальныйИдентификатор());
	Рез = Кеш.Получить(Ключ);
	Если Рез = Неопределено Тогда
		Рез = ПолучитьТарифПоУслуге(КодУслугиПФУ, Здание);
		Кеш.Вставить(Ключ, Рез);
	КонецЕсли;
	Возврат Рез;
КонецФункции

&НаСервере
Функция ОстатокКеш(НаДату, ЛицевойСчет, Услуга, Кеш)
	Ключ = Строка(НаДату) + "|" + Строка(ЛицевойСчет.УникальныйИдентификатор()) + "|" + Строка(Услуга.УникальныйИдентификатор());
	Рез = Кеш.Получить(Ключ);
	Если Рез = Неопределено Тогда
		Рез = ПолучитьОстатки(НаДату, ЛицевойСчет, Услуга);
		Кеш.Вставить(Ключ, Рез);
	КонецЕсли;
	Возврат Рез;
КонецФункции

&НаСервере
Функция ОтветственныйВладелецКеш(ЛС, Кеш)
	Ключ = Строка(ЛС.УникальныйИдентификатор());
	Рез = Кеш.Получить(Ключ);
	Если Рез = Неопределено Тогда
		Рез = ОтветственныйВладелец(ЛС);
		Кеш.Вставить(Ключ, Рез);
	КонецЕсли;
	Возврат Рез;
КонецФункции

&НаСервере
Функция ПлощадьКеш(Помещение, Здание, Кеш)
	Ключ = Строка(Помещение.УникальныйИдентификатор());
	Рез = Кеш.Получить(Ключ);
	Если Рез = Неопределено Тогда
		Рез = ПолучитьПлощадьОбъектовЛицевыхСчетов(Помещение, Здание);
		Кеш.Вставить(Ключ, Рез);
	КонецЕсли;
	Возврат Рез;
КонецФункции

&НаСервере
Функция ВыгрузитьВФайлЕксельНаСервере(Таб)
	
	ДанныеДляВыгрузки = Объект.ДанныеВетрины.Выгрузить(,"ROW_NUM, CDPR_Bas, CDPR_Sub, SERVICE_POINT, OSOB, DIV_PER_ACC, EIC, LN_NAME, FN_NAME, SN_NAME, IPN, PASS_SERIAL, PASS_NUMBER, KATOTTG, REGION, DISTRICT, LOCAL_COMMUNITY, SETTLEMENT, STREET, HOUSE, CASE, APT_NUM, APT_FLOOR, HOUSE_FLOOR, PLZAG, PLOPAL, ZONE, ZABORG, RESTRUC, COD, TARIF, REASON, UNITS, BENEFIT, SUBSIDY, CDPR_Rep, CDPR_Rec, PERIN, PEROFF, POST_INDEX, DEBT_START");
	КоличествоКолонок = ДанныеДляВыгрузки.Колонки.Количество();
	Для НомерКолонки = 1 По КоличествоКолонок Цикл
		Таб.Область(1, НомерКолонки).Текст = ДанныеДляВыгрузки.Колонки[НомерКолонки - 1].Имя;
	КонецЦикла;
	
	НомерСтроки = 2;
	Для Каждого Строки Из ДанныеДляВыгрузки Цикл
		Для НомерКолонки = 1 По КоличествоКолонок Цикл
			Таб.Область(НомерСтроки, НомерКолонки).Текст = Строки[НомерКолонки - 1];
		КонецЦикла;
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;
	
	Возврат Таб;
	
КонецФункции

