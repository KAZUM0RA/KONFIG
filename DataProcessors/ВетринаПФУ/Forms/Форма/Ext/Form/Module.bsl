
&НаКлиенте
Процедура ФайлНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Если Объект.Ексель Тогда
		ДиалогОткрытияФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
		ДиалогОткрытияФайла.ПолноеИмяФайла = Объект.Файл;
		Фильтр = "Электронная таблица Excel(*.xlsx)|*.xlsx";
		ДиалогОткрытияФайла.Фильтр = Фильтр;
		ДиалогОткрытияФайла.МножественныйВыбор = Ложь;
		ДиалогОткрытияФайла.Заголовок = НСтр("ru='Выберите файл';uk='Виберіть файл'");
		Если ДиалогОткрытияФайла.Выбрать() Тогда
			Объект.Файл = ДиалогОткрытияФайла.ПолноеИмяФайла;
		КонецЕсли;
	ИначеЕсли Объект.ХМЛ Тогда
		ДиалогОткрытияФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
		ДиалогОткрытияФайла.ПолноеИмяФайла = Объект.Файл;
		Фильтр = "Табличний документ XML(*.xml)|*.xml";
		ДиалогОткрытияФайла.Фильтр = Фильтр;
		ДиалогОткрытияФайла.МножественныйВыбор = Ложь;
		ДиалогОткрытияФайла.Заголовок = НСтр("ru='Выберите файл';uk='Виберіть файл'");
		Если ДиалогОткрытияФайла.Выбрать() Тогда
			Объект.Файл = ДиалогОткрытияФайла.ПолноеИмяФайла;
		КонецЕсли;
	Иначе
		ДиалогОткрытияФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
		ДиалогОткрытияФайла.ПолноеИмяФайла = Объект.Файл;
		Фильтр = "Электронная таблица Excel(*.csv)|*.csv";
		ДиалогОткрытияФайла.Фильтр = Фильтр;
		ДиалогОткрытияФайла.МножественныйВыбор = Ложь;
		ДиалогОткрытияФайла.Заголовок = НСтр("ru='Выберите файл';uk='Виберіть файл'");
		Если ДиалогОткрытияФайла.Выбрать() Тогда
			Объект.Файл = ДиалогОткрытияФайла.ПолноеИмяФайла;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДаннымиНаСервере()
	ДанныеДляВетрины = Объект.ДанныеВетрины.Выгрузить();
	МассивЛС         = ПолучитьМассивЛС();
	KATOTTG          = "UA53060230010027681";
	КодЯзыкаПечать   = Локализация.ПолучитьЯзыкФормированияПечатныхФорм();
	Номер            = 1;
	ЕДРПОУ           = Справочники.Организации.НайтиПоКоду("000000001").КодПоЕДРПОУ;
	ДатаОстатковZ    = НачалоМесяца(ТекущаяДата()) - 1;
	КешТарифов       = Новый Соответствие;
	КешОстатков      = Новый Соответствие;
	Для Каждого стр Из МассивЛС Цикл
		
		ОбщиеДанные             = ВыборДанныхОбщимЗапросом(стр.Ссылка);
		УслугиПоЛС              = ОбщиеДанные[0];
		ОтветственныйВладелецЛС = ОбщиеДанные[1];
		ПлощадиЛС               = ОбщиеДанные[2];
		
		НовСтрока = ДанныеДляВетрины.Добавить();
		НовСтрока.CDPR_BAS = ЕДРПОУ;
		НовСтрока.OSOB     = стр.Ссылка.Наименование;
		
		НовСтрока.POST_INDEX = "37600";
		
		// Відповідальний власник ОР
		ОтветственныйВладелец = Новый Структура;
		ВыборОтветственныйВладелец = ОтветственныйВладелецЛС.Выбрать();
		Пока ВыборОтветственныйВладелец.Следующий() Цикл
			ОтветственныйВладелец.Вставить("ИНН", ВыборОтветственныйВладелец.ИНН);
			ФИО = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ВыборОтветственныйВладелец.ФИО, " ");
			Если ФИО.Количество() = 3 Тогда
				ОтветственныйВладелец.Вставить("Фамилия", ФИО[0]);
				ОтветственныйВладелец.Вставить("Имя", ФИО[1]);
				ОтветственныйВладелец.Вставить("Отчество", ФИО[2]);
			ИначеЕсли ФИО.Количество() = 2 Тогда
				ОтветственныйВладелец.Вставить("Фамилия", ФИО[0]);
				ОтветственныйВладелец.Вставить("Имя", ФИО[1]);
				ОтветственныйВладелец.Вставить("Отчество", "");
			ИначеЕсли ФИО.Количество() = 1 Тогда
				ОтветственныйВладелец.Вставить("Фамилия", ФИО[0]);
				ОтветственныйВладелец.Вставить("Имя", "");
				ОтветственныйВладелец.Вставить("Отчество", "");
			КонецЕсли;
		КонецЦикла;
		//НовСтрока.LN_NAME     = ОтветственныйВладелец.Фамилия;
		//НовСтрока.FN_NAME     = ОтветственныйВладелец.Имя;
		//НовСтрока.SN_NAME     = ОтветственныйВладелец.Отчество;
		//НовСтрока.IPN         = ОтветственныйВладелец.ИНН;
		// Кінець Відповідальний власник ОР
		
		НовСтрока.KATOTTG = KATOTTG;
		МассивАдреса = РазложитьСтрокуВМассивПодстрок(стр.Владелец);
		Если МассивАдреса.Количество() <> 0 Тогда
			//НовСтрока.SETTLEMENT = Сред(МассивАдреса[3], 4);
			НовСтрока.STREET     = Сред(МассивАдреса[0], 5);
			НовСтрока.HOUSE      = Сред(МассивАдреса[1], 7);
		КонецЕсли;
		НовСтрока.APT_NUM = стр.Ссылка.ОбъектЛицевогоСчета.Код;
		НовСтрока.APT_FLOOR = стр.Ссылка.ОбъектЛицевогоСчета.Этаж;
		НовСтрока.HOUSE_FLOOR = стр.Владелец.КоличествоЭтажей;
		
		// Площі ОР
		ВыборПлощадиЛС = ПлощадиЛС.Выгрузить();
		Если ВыборПлощадиЛС.Количество() <> 0 Тогда
			Для Каждого стрПлощадь Из ВыборПлощадиЛС Цикл
				Если стрПлощадь.ВидПлощади      = Справочники.ВидыПлощадей.ОбщаяПлощадь Тогда
					НовСтрока.PLZAG  = стрПлощадь.Площадь;
				ИначеЕсли стрПлощадь.ВидПлощади = Справочники.ВидыПлощадей.ОтапливаемаяПлощадь Тогда
					НовСтрока.PLOPAL = стрПлощадь.Площадь;
				КонецЕсли;				
			КонецЦикла;
		КонецЕсли;
		// Кінець Площі ОР
		
		ВыборУслугиЛС = УслугиПоЛС.Выгрузить();
		Для Каждого стрУслуги Из ВыборУслугиЛС Цикл
			Если стрУслуги.Действует = Истина Тогда
				Если НЕ ЗначениеЗаполнено(НовСтрока.COD) Тогда
					НовСтрока.COD = стрУслуги.КодУслугиПФУ;
					//Если стрУслуги.Услуга.ЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду("233") Тогда
					//	НовСтрока.UNITS = "GKAL";
					//ИначеЕсли стрУслуги.Услуга.ЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду("113") Тогда
					//	НовСтрока.UNITS = "CUBMETER";
					//ИначеЕсли стрУслуги.Услуга.ЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду("214") Тогда
					//	НовСтрока.UNITS = "KILOWATT";
					//ИначеЕсли стрУслуги.Услуга.ЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду("055") Тогда
					//	НовСтрока.UNITS = "SQMENER";
					//Иначе
					//	НовСтрока.UNITS = "HOUSING";
					//КонецЕсли;
					Если стрУслуги.КодУслугиПФУ = "105" Тогда
						НовСтрока.UNITS = "CUBMETER";
					ИначеЕсли стрУслуги.КодУслугиПФУ = "107.1" Тогда
						НовСтрока.UNITS = "GKAL";
					ИначеЕсли стрУслуги.КодУслугиПФУ = "114" Тогда
						НовСтрока.UNITS = "HOUSING";
					ИначеЕсли стрУслуги.КодУслугиПФУ = "115" Тогда
						НовСтрока.UNITS = "HOUSING";
					КонецЕсли;
				    Тариф = ТарифПоУслугеКеш(стрУслуги.КодУслугиПФУ, стр.Владелец, КешТарифов);
					Если Тариф.Количество() <> 0  Тогда
					    НовСтрока.TARIF = Тариф.ЗначениеТарифа;
					Иначе
						НовСтрока.TARIF = 0;
					КонецЕсли;
					НовСтрока.ZABORG = ОстатокКеш(ДатаОстатковZ, стр.Ссылка, стрУслуги.Услуга, КешОстатков);
					НовСтрока.PERIN = НачалоМесяца(ТекущаяДата());
					НовСтрока.PEROFF = '20501231';
					НовСтрока.ROW_NUM  = Номер;
					НовСтрока.DEBT_START = ДатаНачалаЗадолженностиПоЛицевомуСчету(стр.Ссылка, стрУслуги.Услуга);
					Номер = Номер + 1;
				Иначе
					НовСтрока = ДанныеДляВетрины.Добавить();
					НовСтрока.ROW_NUM  = Номер;
					НовСтрока.CDPR_BAS = ЕДРПОУ;
					НовСтрока.OSOB     = стр.Ссылка.Наименование;
					ОтветственныйВладелец = ОтветственныйВладелец(стр.Ссылка);
					Если ТипЗнч(ОтветственныйВладелец) = Тип("Структура") Тогда
						//НовСтрока.LN_NAME     = ОтветственныйВладелец.Фамилия;
						//НовСтрока.FN_NAME     = ОтветственныйВладелец.Имя;
						//НовСтрока.SN_NAME     = ОтветственныйВладелец.Отчество;
						//НовСтрока.IPN         = ОтветственныйВладелец.ИНН;
					КонецЕсли;
					НовСтрока.KATOTTG = KATOTTG;
					МассивАдреса = РазложитьСтрокуВМассивПодстрок(стр.Владелец);
					Если МассивАдреса.Количество() <> 0 Тогда
					    //НовСтрока.SETTLEMENT = Сред(МассивАдреса[3], 4);
						НовСтрока.STREET     = Сред(МассивАдреса[0], 5);
						НовСтрока.HOUSE      = Сред(МассивАдреса[1], 7);
					КонецЕсли;
					НовСтрока.APT_NUM = стр.Ссылка.ОбъектЛицевогоСчета.Код;
					НовСтрока.APT_FLOOR = стр.Ссылка.ОбъектЛицевогоСчета.Этаж;
					НовСтрока.HOUSE_FLOOR = стр.Владелец.КоличествоЭтажей;
					
					ПлощадиЛС = ПолучитьПлощадьОбъектовЛицевыхСчетов(стр.Ссылка.ОбъектЛицевогоСчета, стр.Владелец);
					Если ПлощадиЛС.Количество() <> 0 Тогда
						Для Каждого стрПлощадь Из ПлощадиЛС Цикл
							Если стрПлощадь.ВидПлощади      = Справочники.ВидыПлощадей.ОбщаяПлощадь Тогда
								НовСтрока.PLZAG  = стрПлощадь.Площадь;
							ИначеЕсли стрПлощадь.ВидПлощади = Справочники.ВидыПлощадей.ОтапливаемаяПлощадь Тогда
								НовСтрока.PLOPAL = стрПлощадь.Площадь;
							КонецЕсли;				
						КонецЦикла;
					КонецЕсли;
					НовСтрока.COD = стрУслуги.КодУслугиПФУ;
					//Если стрУслуги.Услуга.ЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду("233") Тогда
					//	НовСтрока.UNITS = "GKAL";
					//ИначеЕсли стрУслуги.Услуга.ЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду("113") Тогда
					//	НовСтрока.UNITS = "CUBMETER";
					//ИначеЕсли стрУслуги.Услуга.ЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду("214") Тогда
					//	НовСтрока.UNITS = "KILOWATT";
					//ИначеЕсли стрУслуги.Услуга.ЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду("055") Тогда
					//	НовСтрока.UNITS = "SQMENER";
					//Иначе
					//	НовСтрока.UNITS = "HOUSING";
					//КонецЕсли;
					Если стрУслуги.КодУслугиПФУ = "105" Тогда
						НовСтрока.UNITS = "CUBMETER";
					ИначеЕсли стрУслуги.КодУслугиПФУ = "107.1" Тогда
						НовСтрока.UNITS = "GKAL";
					ИначеЕсли стрУслуги.КодУслугиПФУ = "114" Тогда
						НовСтрока.UNITS = "HOUSING";
					ИначеЕсли стрУслуги.КодУслугиПФУ = "115" Тогда
						НовСтрока.UNITS = "HOUSING";
					КонецЕсли;
				    Тариф = ТарифПоУслугеКеш(стрУслуги.КодУслугиПФУ, стр.Владелец, КешТарифов);
					Если Тариф.Количество() <> 0  Тогда
					    НовСтрока.TARIF = Тариф.ЗначениеТарифа;
					Иначе
						НовСтрока.TARIF = 0;
					КонецЕсли;
					НовСтрока.ZABORG = ОстатокКеш(ДатаОстатковZ, стр.Ссылка, стрУслуги.Услуга, КешОстатков);
					НовСтрока.POST_INDEX = "37600";
					НовСтрока.PERIN = НачалоМесяца(ТекущаяДата());
					НовСтрока.PEROFF = '20501231';
					НовСтрока.DEBT_START = ДатаНачалаЗадолженностиПоЛицевомуСчету(стр.Ссылка, стрУслуги.Услуга);
					
					Номер = Номер + 1;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
			
	КонецЦикла;
	Объект.ДанныеВетрины.Загрузить(ДанныеДляВетрины);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДаннымиНаСервере1()
	
	ДанныеДляВетрины = Объект.ДанныеВетрины.Выгрузить();
	МассивЛС = ПолучитьМассивЛС();
	KATOTTG = "UA53060230000098362";
	КодЯзыкаПечать = Локализация.ПолучитьЯзыкФормированияПечатныхФорм();
	ЕДРПОУ1 = Справочники.Организации.НайтиПоКоду("000000001").КодПоЕДРПОУ;
	ДатаОстатковZ1 = НачалоМесяца(ТекущаяДата()) - 1;
	ЕИ233 = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду("233");
	ЕИ113 = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду("113");
	ЕИ214 = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду("214");
	ЕИ055 = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду("055");
	КешТарифов1 = Новый Соответствие;
	КешОстатков1 = Новый Соответствие;
	КешВладельца1 = Новый Соответствие;
	КешПлощади1 = Новый Соответствие;
	Для Каждого стр Из МассивЛС Цикл
		
		
		НовСтрока = ДанныеДляВетрины.Добавить();
		НовСтрока.ROW_NUM  = НовСтрока.НомерСтроки;
		НовСтрока.CDPR_BAS = ЕДРПОУ1;
		НовСтрока.OSOB     = стр.Ссылка.Наименование;
		ОтветственныйВладелец = ОтветственныйВладелецКеш(стр.Ссылка, КешВладельца1);
		Если ТипЗнч(ОтветственныйВладелец) = Тип("Структура") Тогда
		    НовСтрока.LN_NAME     = ОтветственныйВладелец.Фамилия;
			НовСтрока.FN_NAME     = ОтветственныйВладелец.Имя;
			НовСтрока.SN_NAME     = ОтветственныйВладелец.Отчество;
			НовСтрока.IPN         = ОтветственныйВладелец.ИНН;
		КонецЕсли;
		НовСтрока.KATOTTG = KATOTTG;
		МассивАдреса = РазложитьСтрокуВМассивПодстрок(стр.Владелец);
		Если МассивАдреса.Количество() <> 0 Тогда
		    НовСтрока.SETTLEMENT = Сред(МассивАдреса[3], 4);
			НовСтрока.STREET     = Сред(МассивАдреса[0], 5);
			НовСтрока.HOUSE      = Сред(МассивАдреса[1], 7);
		КонецЕсли;
		НовСтрока.APT_NUM = стр.Ссылка.ОбъектЛицевогоСчета.Код;
		НовСтрока.APT_FLOOR = стр.Ссылка.ОбъектЛицевогоСчета.Этаж;
		НовСтрока.HOUSE_FLOOR = стр.Владелец.КоличествоЭтажей;
		
		ПлощадиЛС = ПлощадьКеш(стр.Ссылка.ОбъектЛицевогоСчета, стр.Владелец, КешПлощади1);
		Если ПлощадиЛС.Количество() <> 0 Тогда
			Для Каждого стрПлощадь Из ПлощадиЛС Цикл
				Если стрПлощадь.ВидПлощади      = Справочники.ВидыПлощадей.ОбщаяПлощадь Тогда
					НовСтрока.PLZAG  = стрПлощадь.Площадь;
				ИначеЕсли стрПлощадь.ВидПлощади = Справочники.ВидыПлощадей.ОтапливаемаяПлощадь Тогда
					НовСтрока.PLOPAL = стрПлощадь.Площадь;
				КонецЕсли;				
			КонецЦикла;
		КонецЕсли;
		
		УслугиЛС = ПолучитьУслугиПоЛС(стр.Ссылка);
		Для Каждого стрУслуги Из УслугиЛС Цикл
			Если НЕ ЗначениеЗаполнено(НовСтрока.COD) Тогда
				НовСтрока.COD = стрУслуги.КодПФУ;
			    Тариф = ТарифПоУслугеКеш(стрУслуги.КодПФУ, стр.Владелец, КешТарифов1);
				НовСтрока.TARIF = Тариф.ЗначениеТарифа;
				НовСтрока.ZABORG = ОстатокКеш(ДатаОстатковZ1, стр.Ссылка, стрУслуги.Услуга, КешОстатков1);
				НовСтрока.PERIN = НачалоМесяца(ТекущаяДата());
				НовСтрока.PEROFF = '20501231';
			Иначе
				НовСтрока = ДанныеДляВетрины.Добавить();
				НовСтрока.ROW_NUM  = НовСтрока.НомерСтроки;
				НовСтрока.CDPR_BAS = ЕДРПОУ1;
				НовСтрока.OSOB     = стр.Ссылка.Наименование;
				ОтветственныйВладелец = ОтветственныйВладелецКеш(стр.Ссылка, КешВладельца1);
				Если ТипЗнч(ОтветственныйВладелец) = Тип("Структура") Тогда
				    НовСтрока.LN_NAME     = ОтветственныйВладелец.Фамилия;
					НовСтрока.FN_NAME     = ОтветственныйВладелец.Имя;
					НовСтрока.SN_NAME     = ОтветственныйВладелец.Отчество;
					НовСтрока.IPN         = ОтветственныйВладелец.ИНН;
				КонецЕсли;
				НовСтрока.KATOTTG = KATOTTG;
				МассивАдреса = РазложитьСтрокуВМассивПодстрок(стр.Владелец);
				Если МассивАдреса.Количество() <> 0 Тогда
				    НовСтрока.SETTLEMENT = Сред(МассивАдреса[3], 4);
					НовСтрока.STREET     = Сред(МассивАдреса[0], 5);
					НовСтрока.HOUSE      = Сред(МассивАдреса[1], 7);
				КонецЕсли;
				НовСтрока.APT_NUM = стр.Ссылка.ОбъектЛицевогоСчета.Код;
				НовСтрока.APT_FLOOR = стр.Ссылка.ОбъектЛицевогоСчета.Этаж;
				НовСтрока.HOUSE_FLOOR = стр.Владелец.КоличествоЭтажей;
				
				ПлощадиЛС = ПлощадьКеш(стр.Ссылка.ОбъектЛицевогоСчета, стр.Владелец, КешПлощади1);
				Если ПлощадиЛС.Количество() <> 0 Тогда
					Для Каждого стрПлощадь Из ПлощадиЛС Цикл
						Если стрПлощадь.ВидПлощади      = Справочники.ВидыПлощадей.ОбщаяПлощадь Тогда
							НовСтрока.PLZAG  = стрПлощадь.Площадь;
						ИначеЕсли стрПлощадь.ВидПлощади = Справочники.ВидыПлощадей.ОтапливаемаяПлощадь Тогда
							НовСтрока.PLOPAL = стрПлощадь.Площадь;
						КонецЕсли;				
					КонецЦикла;
				КонецЕсли;
				НовСтрока.COD = стрУслуги.КодПФУ;
				Если стрУслуги.Услуга.ЕдиницаИзмерения = ЕИ233 Тогда
					НовСтрока.UNITS = "GKAL";
				ИначеЕсли стрУслуги.Услуга.ЕдиницаИзмерения = ЕИ113 Тогда
					НовСтрока.UNITS = "CUBMETER";
				ИначеЕсли стрУслуги.Услуга.ЕдиницаИзмерения = ЕИ214 Тогда
					НовСтрока.UNITS = "KILOWATT";
				ИначеЕсли стрУслуги.Услуга.ЕдиницаИзмерения = ЕИ055 Тогда
					НовСтрока.UNITS = "SQMENER";
				КонецЕсли;
			    Тариф = ТарифПоУслугеКеш(стрУслуги.КодПФУ, стр.Владелец, КешТарифов1);
				НовСтрока.TARIF = Тариф.ЗначениеТарифа;
				НовСтрока.ZABORG = ОстатокКеш(ДатаОстатковZ1, стр.Ссылка, стрУслуги.Услуга, КешОстатков1);
				НовСтрока.PERIN = НачалоМесяца(ТекущаяДата());
				НовСтрока.PEROFF = '20501231';
			КонецЕсли;
		КонецЦикла;		
	КонецЦикла;
	
	Объект.ДанныеВетрины.Загрузить(ДанныеДляВетрины);
	
КонецПроцедуры

