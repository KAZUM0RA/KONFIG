
&НаКлиенте
Процедура ФайлDBFНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	Режим = РежимДиалогаВыбораФайла.Открытие;
	ДиалогОткрытияФайла = Новый ДиалогВыбораФайла(Режим);
	ДиалогОткрытияФайла.ПолноеИмяФайла = Объект.ФайлDBF;
	Фильтр = "Электронная таблица DBF(*.dbf)|*.dbf";
	ДиалогОткрытияФайла.Фильтр = Фильтр;
	ДиалогОткрытияФайла.МножественныйВыбор = Ложь;
	ДиалогОткрытияФайла.Заголовок = НСтр("ru='Выберите файл';uk='Виберіть файл'");
	Если ДиалогОткрытияФайла.Выбрать() Тогда
		Объект.ФайлDBF = ДиалогОткрытияФайла.ПолноеИмяФайла;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИзФайла(Команда)
	Если НЕ ЗначениеЗаполнено(Объект.ФайлDBF) Тогда
		Сообщить(НСтр("ru='Укажите путь к файлу.';uk='Вкажіть шлях до файлу.'"));
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.Банк) Тогда
		Сообщить(НСтр("ru='Укажите банковский счет.';uk='Вкажіть банківський рахунок.'"));
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.ДатаВыпискиДок) Тогда
		Сообщить(НСтр("ru='Укажите дату выписки.';uk='Вкажіть дату виписки.'"));
		Возврат;
	КонецЕсли;
    Таб = Новый XBase;
	Таб.ОткрытьФайл(Объект.ФайлDBF,,Истина);
	Таб.Первая();
	Таб.Кодировка = КодировкаXBase.OEM;
	Объект.ПриватБанк.Очистить();
	Пока Не Таб.ВКонце() Цикл
		НоваяСтрока                   = Объект.ПриватБанк.Добавить();
		НоваяСтрока.ЛицевойСчет       = Таб.LS;
		НоваяСтрока.КодУслуги         = Таб.KOD_USLUGA;
		НоваяСтрока.ФИО               = Таб.FIO;
		НоваяСтрока.Город             = Таб.TOWN;
		НоваяСтрока.Улица             = Таб.VUL;
		НоваяСтрока.Дом               = Таб.BUD;
		НоваяСтрока.Квартира          = Таб.FLAT;
		НоваяСтрока.Счетчик1          = Таб.IDLICH1;
		НоваяСтрока.ПоказаниеДо1      = Таб.POKBEG1;
		НоваяСтрока.ПоказаниеПосле1   = Таб.POKEND1;
		НоваяСтрока.Счетчик2          = Таб.IDLICH2;
		НоваяСтрока.ПоказаниеДо2      = Таб.POKBEG2;
		НоваяСтрока.ПоказаниеПосле2   = Таб.POKEND2;
		НоваяСтрока.Счетчик3          = Таб.IDLICH3;
		НоваяСтрока.ПоказаниеДо3      = Таб.POKBEG3;
		НоваяСтрока.ПоказаниеПосле3   = Таб.POKEND3;
		НоваяСтрока.Счетчик4          = Таб.IDLICH4;
		НоваяСтрока.ПоказаниеДо4      = Таб.POKBEG4;
		НоваяСтрока.ПоказаниеПосле4   = Таб.POKEND4;
		НоваяСтрока.Счетчик5          = Таб.IDLICH5;
		НоваяСтрока.ПоказаниеДо5      = Таб.POKBEG5;
		НоваяСтрока.ПоказаниеПосле5   = Таб.POKEND5;
		НоваяСтрока.ДатаПлатежа       = Таб.D_PLAT;
		НоваяСтрока.НомерПлатежу      = Таб.N_PLAT;
		НоваяСтрока.СуммаПлатежа      = Таб.SUMA;
		НоваяСтрока.НазначениеПлатежа = Таб.DEST;
		НоваяСтрока.МФО               = Таб.MFO;
		Таб.Следующая();
	КонецЦикла;
	Таб.ЗакрытьФайл();
КонецПроцедуры

