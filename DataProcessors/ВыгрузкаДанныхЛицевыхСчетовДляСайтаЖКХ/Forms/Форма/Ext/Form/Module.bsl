//=============================  СФОРМИРОВАТЬ ФАЙЛ ВЫГРУЗКИ XML =============================================//
// Функция записывает данные по лицевым счетам в XML-файл
// Возвращает имя файла
//
&НаСервере
Функция СформироватьфайлДляВыгрузки()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	РасчетыПоЛицевымСчетам.ЛицевойСчет,
	               |	РасчетыПоЛицевымСчетам.Услуга,
	               |	РасчетыПоЛицевымСчетам.МесяцНачисления,
	               |	РасчетыПоЛицевымСчетам.Сумма,
	               |	РасчетыПоЛицевымСчетам.Тариф,
	               |	РасчетыПоЛицевымСчетам.ДнейНачислено,
	               |	РасчетыПоЛицевымСчетам.Услуга.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	               |	РасчетыПоЛицевымСчетам.ВидНачисления,
	               |	РасчетыПоЛицевымСчетам.Количество,
	               |	РасчетыПоЛицевымСчетам.Организация,
	               |	РасчетыПоЛицевымСчетам.ЛицевойСчет.Владелец,
	               |	ЛицевыеСчета.КоличествоПрописанных,
	               |	ЛицевыеСчета.КоличествоПроживающих
	               |ПОМЕСТИТЬ РасчетыПоЛицСчетам
	               |ИЗ
	               |	РегистрНакопления.РасчетыПоЛицевымСчетам КАК РасчетыПоЛицевымСчетам
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛицевыеСчета КАК ЛицевыеСчета
	               |		ПО РасчетыПоЛицевымСчетам.ЛицевойСчет = ЛицевыеСчета.ЛицевойСчет
	               |ГДЕ
	               |	РасчетыПоЛицевымСчетам.ЛицевойСчет В(&ЛицевойСчет)
	               |	И РасчетыПоЛицевымСчетам.ДатаНачалаПериода > ДОБАВИТЬКДАТЕ(НАЧАЛОПЕРИОДА(&Дата, МЕСЯЦ), СЕКУНДА, -1)
	               |	И РасчетыПоЛицевымСчетам.ДатаНачалаПериода < ДОБАВИТЬКДАТЕ(КОНЕЦПЕРИОДА(&Дата, МЕСЯЦ), СЕКУНДА, 1)
	               |	И РасчетыПоЛицевымСчетам.Сумма <> 0
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	РасчетыПоЛицСчетам.ЛицевойСчет КАК ЛицевойСчет,
	               |	РасчетыПоЛицСчетам.Услуга КАК Услуга,
	               |	РасчетыПоЛицСчетам.МесяцНачисления,
	               |	РасчетыПоЛицСчетам.Сумма КАК Сумма,
	               |	РасчетыПоЛицСчетам.Тариф,
	               |	РасчетыПоЛицСчетам.ДнейНачислено,
	               |	РасчетыПоЛицСчетам.ЕдиницаИзмерения,
	               |	РасчетыПоЛицСчетам.ВидНачисления КАК ВидНачисления,
	               |	РасчетыПоЛицСчетам.Количество,
	               |	ТарифыСрезПоследних.НормаПотребления,
	               |	ЕСТЬNULL(УстановленныеПриборыУчетаСрезПоследних.ПриборУчета, 0) КАК ПриборУчета,
	               |	ЕСТЬNULL(УстановленныеПриборыУчетаСрезПоследних.Действует, ЛОЖЬ) КАК Действует,
	               |	ЕСТЬNULL(Аванс.АвансИлиДолг, 0) КАК Аванс,
	               |	Аванс.Начислено КАК Начислено,
	               |	ЕСТЬNULL(Аванс.Оплачено, 0) КАК Оплачено,
	               |	Аванс.КВыплате КАК КВыплате,
	               |	РасчетыПоЛицСчетам.КоличествоПрописанных КАК КоличествоПрописанных,
	               |	РасчетыПоЛицСчетам.КоличествоПроживающих КАК КоличествоПроживающих,
	               |	РасчетыПоЛицевымСчетамОстаткиИОбороты.СуммаНачальныйОстаток КАК ОстатокНаначалоПериодаПоУслуге,
	               |	РасчетыПоЛицевымСчетамОстаткиИОбороты.СуммаПриход КАК НачисленоПоУслуге,
	               |	РасчетыПоЛицевымСчетамОстаткиИОбороты.СуммаРасход КАК ОплаченоПоУслуге,
	               |	РасчетыПоЛицевымСчетамОстаткиИОбороты.СуммаКонечныйОстаток КАК ОстатокНаКонецПериодаПоУслуге,
	               |	ЕСТЬNULL(ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ОтветственныйВладелец, """") КАК ОтветственныйВладелец,
	               |	ПоказанияПриборовУчета.Тек КАК ТекущиеПоказания,
	               |	ПоказанияПриборовУчета.Пред КАК ПредыдущиеПоказания
	               |ИЗ
	               |	РасчетыПоЛицСчетам КАК РасчетыПоЛицСчетам
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Тарифы.СрезПоследних(&Дата, ) КАК ТарифыСрезПоследних
	               |		ПО РасчетыПоЛицСчетам.Услуга = ТарифыСрезПоследних.Услуга
	               |			И РасчетыПоЛицСчетам.Организация = ТарифыСрезПоследних.Организация
	               |			И РасчетыПоЛицСчетам.ЛицевойСчетВладелец = ТарифыСрезПоследних.Здание
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УстановленныеПриборыУчета.СрезПоследних КАК УстановленныеПриборыУчетаСрезПоследних
	               |			ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |				Текущие.ПриборУчета КАК ПриборУчета,
	               |				ЕСТЬNULL(Текущие.Значение, 0) КАК Тек,
	               |				ЕСТЬNULL(Прошлые.Значение, 0) КАК Пред
	               |			ИЗ
	               |				РегистрСведений.ПоказанияПриборовУчета.СрезПоследних(КОНЕЦПЕРИОДА(&Дата, МЕСЯЦ), ) КАК Текущие
	               |					ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПоказанияПриборовУчета.СрезПоследних(ДОБАВИТЬКДАТЕ(КОНЕЦПЕРИОДА(&Дата, МЕСЯЦ), МЕСЯЦ, -1), ) КАК Прошлые
	               |					ПО Текущие.ПриборУчета = Прошлые.ПриборУчета
	               |						И Текущие.ВидТарифа = Прошлые.ВидТарифа) КАК ПоказанияПриборовУчета
	               |			ПО УстановленныеПриборыУчетаСрезПоследних.ПриборУчета = ПоказанияПриборовУчета.ПриборУчета
	               |		ПО РасчетыПоЛицСчетам.ЛицевойСчет = УстановленныеПриборыУчетаСрезПоследних.ОбъектУстановки
	               |			И РасчетыПоЛицСчетам.Услуга = УстановленныеПриборыУчетаСрезПоследних.ПриборУчета.Услуга
	               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			РасчетыПоЛицевымСчетамОстаткиИОбороты.СуммаНачальныйОстаток КАК АвансИлиДолг,
	               |			РасчетыПоЛицевымСчетамОстаткиИОбороты.СуммаПриход КАК Начислено,
	               |			РасчетыПоЛицевымСчетамОстаткиИОбороты.СуммаРасход КАК Оплачено,
	               |			РасчетыПоЛицевымСчетамОстаткиИОбороты.СуммаКонечныйОстаток КАК КВыплате,
	               |			НАЧАЛОПЕРИОДА(&Дата, МЕСЯЦ) КАК НачалоПериода,
	               |			КОНЕЦПЕРИОДА(&Дата, МЕСЯЦ) КАК КонецПериода,
	               |			РасчетыПоЛицевымСчетамОстаткиИОбороты.ЛицевойСчет КАК ЛицевойСчет
	               |		ИЗ
	               |			РегистрНакопления.РасчетыПоЛицевымСчетам.ОстаткиИОбороты(НАЧАЛОПЕРИОДА(&Дата, МЕСЯЦ), КОНЕЦПЕРИОДА(&Дата, МЕСЯЦ), Месяц, , ЛицевойСчет В (&ЛицевойСчет)) КАК РасчетыПоЛицевымСчетамОстаткиИОбороты) КАК Аванс
	               |		ПО РасчетыПоЛицСчетам.ЛицевойСчет = Аванс.ЛицевойСчет
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.РасчетыПоЛицевымСчетам.ОстаткиИОбороты КАК РасчетыПоЛицевымСчетамОстаткиИОбороты
	               |		ПО РасчетыПоЛицСчетам.Услуга = РасчетыПоЛицевымСчетамОстаткиИОбороты.Услуга
	               |			И РасчетыПоЛицСчетам.ЛицевойСчет = РасчетыПоЛицевымСчетамОстаткиИОбороты.ЛицевойСчет
	               |			И РасчетыПоЛицСчетам.Организация = РасчетыПоЛицевымСчетамОстаткиИОбороты.Организация
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОтветственныйВладелецЛицевогоСчета.СрезПоследних(&Дата, ) КАК ОтветственныйВладелецЛицевогоСчетаСрезПоследних
	               |		ПО РасчетыПоЛицСчетам.ЛицевойСчет = ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ЛицевойСчет
	               |ИТОГИ
	               |	СУММА(Сумма),
	               |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВидНачисления),
	               |	МАКСИМУМ(Действует),
	               |	МАКСИМУМ(Аванс),
	               |	МАКСИМУМ(Начислено),
	               |	МАКСИМУМ(Оплачено),
	               |	МАКСИМУМ(КВыплате),
	               |	МАКСИМУМ(КоличествоПрописанных),
	               |	МАКСИМУМ(КоличествоПроживающих),
	               |	МАКСИМУМ(ОстатокНаначалоПериодаПоУслуге),
	               |	МАКСИМУМ(НачисленоПоУслуге),
	               |	МАКСИМУМ(ОплаченоПоУслуге),
	               |	МАКСИМУМ(ОстатокНаКонецПериодаПоУслуге),
	               |	МАКСИМУМ(ОтветственныйВладелец)
	               |ПО
	               |	ЛицевойСчет,
	               |	Услуга";
	//Передаем параметры в Запрос ("Дата" и Список "ЛицевойСчет")
	Запрос.УстановитьПараметр("Дата", Объект.ПериодПросмотра);
	
	СписокЛицевыхСчетов = Новый СписокЗначений;
	Для каждого Строка Из Объект.ЛицевыеСчета Цикл
		СписокЛицевыхСчетов.Добавить(Строка.ЛицевойСчет);
	КонецЦикла; 
	
	Запрос.УстановитьПараметр("ЛицевойСчет", СписокЛицевыхСчетов);
	
	Выгрузка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	МассивЛС = Новый Структура;
	НомерЛС = 0;
	
	Пока Выгрузка.Следующий() Цикл
			СтруктураЛС = Новый Структура;
			
			Адрес = Выгрузка.ЛицевойСчет.Владелец.КонтактнаяИнформация.Найти(Справочники.ВидыКонтактнойИнформации.ПочтовыйАдресЗданияИСооружения,"Вид").ЗначенияПолей;
			
			ОтборПлощади = Новый Структура("Помещение", Выгрузка.ЛицевойСчет.ОбъектЛицевогоСчета);    
			ВыборкаПлощади = РегистрыСведений.ПлощадьОбъектовЛицевыхСчетов.СрезПоследних(ТекущаяДата(),ОтборПлощади);
			
			Для Каждого Строка Из ВыборкаПлощади Цикл
				Если Строка.ВидПлощади = Справочники.ВидыПлощадей.ОтапливаемаяПлощадь Тогда
					ПлощадьОтоп = Строка.Площадь;
				ИначеЕсли Строка.ВидПлощади = Справочники.ВидыПлощадей.ОбщаяПлощадь Тогда
					ПлощадьВся = Строка.Площадь;
				ИначеЕсли Строка.ВидПлощади = Справочники.ВидыПлощадей.ЖилаяПолощадь Тогда
					ЖилаяПлощадь = Строка.Площадь;
				КонецЕсли;
			КонецЦикла;
			
			СтруктураЛС.Вставить("ID", XMLСтрока(Выгрузка.ЛицевойСчет));
			СтруктураЛС.Вставить("AddressCity", НайтиЗначениеАдреса(Адрес, "Город="));
			СтруктураЛС.Вставить("AddressDistrict",НайтиЗначениеАдреса(Адрес, "Район="));
			СтруктураЛС.Вставить("AddressFlat",Выгрузка.ЛицевойСчет.ОбъектЛицевогоСчета.Наименование);
			СтруктураЛС.Вставить("AddressHouse",НайтиЗначениеАдреса(Адрес, "Дом="));
			СтруктураЛС.Вставить("AddressRegion",НайтиЗначениеАдреса(Адрес, "Регион="));
			СтруктураЛС.Вставить("AddressSettlement",НайтиЗначениеАдреса(Адрес, "Город="));
			СтруктураЛС.Вставить("AddressStreet",НайтиЗначениеАдреса(Адрес, "Улица="));
			
				//Опредиляем Штрихкод и параметры печати
				ШтрихкодНовый = Строка(Формат(НачалоМесяца(Объект.ПериодПросмотра),"ДФ=ddMMyyyy"))+"-"+Выгрузка.ЛицевойСчет.Наименование+"-"+((Выгрузка.КВыплате)*100);
				
				Штрихкод = СтрЗаменить(ШтрихкодНовый,"/","");
				
				ПараметрыПечати = Новый Структура();
				ПараметрыПечати.Вставить("ЛицевойСчет",Выгрузка.ЛицевойСчет);
				ПараметрыПечати.Вставить("ПериодПечати",Объект.ПериодПросмотра);
				
				//Добавляем в структуру ЛС параметры печати по которым будем выводит ПДФ файлы
				СтруктураЛС.Вставить("ПараметрыПечати", ПараметрыПечати);
			
			СтруктураЛС.Вставить("Barcode",Штрихкод);
			СтруктураЛС.Вставить("commonarea",XMLСтрока(ПлощадьВся));
			СтруктураЛС.Вставить("debtbeg",XMLСтрока(Выгрузка.Аванс));
			СтруктураЛС.Вставить("debtup",XMLСтрока(Выгрузка.Начислено));
			СтруктураЛС.Вставить("debtdown",XMLСтрока(Выгрузка.Оплачено));
			СтруктураЛС.Вставить("debtend",XMLСтрока(Выгрузка.КВыплате));
			
			ВладелецЛицевогоСчета = ?(Выгрузка.ОтветственныйВладелец.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ФизЛицо, Выгрузка.ОтветственныйВладелец.ФизЛицо, Выгрузка.ОтветственныйВладелец.ЮрЛицо);
			ИнфоЭлектронныйАдрес = ВладелецЛицевогоСчета.КонтактнаяИнформация.Найти(Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты,"Тип");
			
			СтруктураЛС.Вставить("email",?(ИнфоЭлектронныйАдрес = Неопределено, "null@mail.com", ИнфоЭлектронныйАдрес.АдресЭП));
			СтруктураЛС.Вставить("habarea",XMLСтрока(ЖилаяПлощадь));
			СтруктураЛС.Вставить("kod_ls",Выгрузка.ЛицевойСчет.Наименование);
			СтруктураЛС.Вставить("name",Выгрузка.ОтветственныйВладелец.Наименование);
			СтруктураЛС.Вставить("name_ls",Выгрузка.ЛицевойСчет.Наименование);
			СтруктураЛС.Вставить("password","");
			СтруктураЛС.Вставить("people_Living",XMLСтрока(Выгрузка.КоличествоПроживающих));
			СтруктураЛС.Вставить("people_Prescription",XMLСтрока(Выгрузка.КоличествоПрописанных));
			
			ВыгрузкаПоказания = Выгрузка.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			МассивУслуг = Новый Структура;
            УслугаЛС = 0;
			Пока ВыгрузкаПоказания.Следующий() Цикл
				
				СтруктураАктивныхУслугЛС = Новый Структура;
				
				ВыгрузкаУслуга = ВыгрузкаПоказания.Выбрать();
				
				Пока ВыгрузкаУслуга.Следующий() Цикл
					Количество 			= XMLСтрока(ВыгрузкаУслуга.Количество);
					ЕдИз 				= ВыгрузкаУслуга.ЕдиницаИзмерения.Наименование;
					Код 				= XMLСтрока(ВыгрузкаУслуга.Услуга.Ссылка);
					Наименование 		= ВыгрузкаУслуга.Услуга.Наименование;
					Норма 				= XMLСтрока(ВыгрузкаУслуга.НормаПотребления);
					СуммаОплачено 		= XMLСтрока(ВыгрузкаУслуга.ОплаченоПоУслуге);
					Тариф 				= XMLСтрока(ВыгрузкаУслуга.Тариф);
					НазначениеПлатежа	= ВыгрузкаУслуга.Услуга.НазначениеПлатежа;
				КонецЦикла; 
								
				СтруктураАктивныхУслугЛС.Вставить("ammount",Количество);
				СтруктураАктивныхУслугЛС.Вставить("edizm",ЕдИз);
				СтруктураАктивныхУслугЛС.Вставить("ID",Код);
				СтруктураАктивныхУслугЛС.Вставить("name",Наименование);
				СтруктураАктивныхУслугЛС.Вставить("DetailsOf_Payment",НазначениеПлатежа);
				СтруктураАктивныхУслугЛС.Вставить("norm",Норма);
				СтруктураАктивныхУслугЛС.Вставить("sum",XMLСтрока(ВыгрузкаПоказания.Сумма));
				СтруктураАктивныхУслугЛС.Вставить("sumpayed",СуммаОплачено);
				СтруктураАктивныхУслугЛС.Вставить("tarif",Тариф);
				СтруктураАктивныхУслугЛС.Вставить("ЭтоСчетчик", Ложь);
				
				Если ВыгрузкаПоказания.Действует Тогда
					СтруктураПоказанияСчетчика = Новый Структура;
					
					ВыгрузкаСчетчик = ВыгрузкаПоказания.Выбрать();
					Пока ВыгрузкаСчетчик.Следующий() Цикл
						Код 				= XMLСтрока(ВыгрузкаСчетчик.Услуга.Ссылка);
						Наименование 		= ВыгрузкаСчетчик.Услуга.Наименование;
						НомерСчетчика		= ВыгрузкаСчетчик.ПриборУчета.ЗаводскойНомер;
						ТекущиеПоказания = XMLСтрока(ВыгрузкаСчетчик.ТекущиеПоказания);
						ПредыдущиееПоказания = XMLСтрока(ВыгрузкаСчетчик.ПредыдущиеПоказания);
					КонецЦикла; 
					
					СтруктураПоказанияСчетчика.Вставить("value_count","1");
					СтруктураПоказанияСчетчика.Вставить("indicbef1",ПредыдущиееПоказания);
					СтруктураПоказанияСчетчика.Вставить("indiccur1",ТекущиеПоказания);
					СтруктураПоказанияСчетчика.Вставить("ID",Код);
					СтруктураПоказанияСчетчика.Вставить("name",НомерСчетчика);
					СтруктураПоказанияСчетчика.Вставить("service",Наименование);
					
					//Записываем структуру показания счетчика
					СтруктураАктивныхУслугЛС.Вставить("ЭтоСчетчик", Истина);
					СтруктураАктивныхУслугЛС.Вставить("ПоказанияСчетчика", СтруктураПоказанияСчетчика);
				КонецЕсли;
				УслугаЛС = УслугаЛС + 1;
				МассивУслуг.Вставить("Услуга"+УслугаЛС,СтруктураАктивныхУслугЛС);
			КонецЦикла;
			СтруктураЛС.Вставить("АктивныеУслуги", МассивУслуг);
			НомерЛС = НомерЛС +1;
			МассивЛС.Вставить("ЛС"+НомерЛС,СтруктураЛС);
		КонецЦикла;
			
	Возврат МассивЛС;
	
КонецФункции

&НаСервере
Функция  ПечатьПДФКвитанции(ПараметрыПечати)
	ТабличныйДокумент = Новый ТабличныйДокумент;
	Макет = Обработки.ВыгрузкаДанныхЛицевыхСчетовДляСайтаЖКХ.ПолучитьМакет("МакетКвитанцииНаОплату");
			
	//ШАПКА
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьШапка.Параметры.Месяц = Формат(ПараметрыПечати.ПериодПечати,"Л=uk_UA; ДФ=MMMM");
	ОбластьШапка.Параметры.год = Формат(ПараметрыПечати.ПериодПечати,"ДФ=yyyy");
	ОбластьШапка.Параметры.Получатель = Объект.Организация.НаименованиеПолное;
	ОбластьШапка.Параметры.ЄДРПОУ = Объект.Организация.КодПоЕДРПОУ;
	ТабличныйДокумент.Вывести(ОбластьШапка);

	//БанковскийСчет
	ОбластьБанковскийСчет = Макет.ПолучитьОбласть("БанковскийСчет");
	ОбластьБанковскийСчет.Параметры.Рр = ПараметрыПечати.ЛицевойСчет.Владелец.Организация.БанковскийСчетПоУмолчанию.НомерСчета;
	ОбластьБанковскийСчет.Параметры.Банк = ПараметрыПечати.ЛицевойСчет.Владелец.Организация.БанковскийСчетПоУмолчанию.Банк.Наименование;
	ОбластьБанковскийСчет.Параметры.МФО = ПараметрыПечати.ЛицевойСчет.Владелец.Организация.БанковскийСчетПоУмолчанию.Банк.Код;
	ТабличныйДокумент.Вывести(ОбластьБанковскийСчет);
	 

	//ШапкаОсновнойЧасти 
	ОтборПлощади = Новый Структура("Помещение",ПараметрыПечати.ЛицевойСчет.ОбъектЛицевогоСчета);    
	ВыборкаПлощади = РегистрыСведений.ПлощадьОбъектовЛицевыхСчетов.СрезПоследних(ТекущаяДата(),ОтборПлощади);

	ОбластьШапкаОсновнойЧасти = Макет.ПолучитьОбласть("ШапкаОсновнойЧасти");
	Для Каждого Строка Из ВыборкаПлощади Цикл
		Если Строка.ВидПлощади = Справочники.ВидыПлощадей.ОтапливаемаяПлощадь Тогда
			ОбластьШапкаОсновнойЧасти.Параметры.ПлощадьОтоп = Строка.Площадь;
		ИначеЕсли Строка.ВидПлощади = Справочники.ВидыПлощадей.ОбщаяПлощадь Тогда
			ОбластьШапкаОсновнойЧасти.Параметры.ПлощадьВся = Строка.Площадь;
		КонецЕсли;
	КонецЦикла;

	ОтборКолПроживающих = Новый Структура("ЛицевойСчет",ПараметрыПечати.ЛицевойСчет);
	ВыборкаКолПроживающих = РегистрыСведений.ЛицевыеСчета.СрезПоследних(ТекущаяДата(),ОтборКолПроживающих);
	Попытка
		ОбластьШапкаОсновнойЧасти.Параметры.Плательщик = РегистрыСведений.ОтветственныйВладелецЛицевогоСчета.СрезПоследних(ТекущаяДата(),Новый Структура("ЛицевойСчет",ПараметрыПечати.ЛицевойСчет))[0].ОтветственныйВладелец.Наименование;
	Исключение
	КонецПопытки;

	Для Каждого Строка Из ВыборкаКолПроживающих Цикл
		ОбластьШапкаОсновнойЧасти.Параметры.КолЧеловек = Строка.КоличествоПроживающих;
	КонецЦикла;
	ОбластьШапкаОсновнойЧасти.Параметры.КоличествоМестПаркинг = "";
	ОбластьШапкаОсновнойЧасти.Параметры.ЛицевойСчет = ПараметрыПечати.ЛицевойСчет;
	ОбластьШапкаОсновнойЧасти.Параметры.Адрес = ПараметрыПечати.ЛицевойСчет.Владелец.Наименование+" "+ПараметрыПечати.ЛицевойСчет.ОбъектЛицевогоСчета.Наименование;
	ТабличныйДокумент.Вывести(ОбластьШапкаОсновнойЧасти);

	//ШапкаТаблицыУслуг
	ОбластьШапкаТаблицыУслуг = Макет.ПолучитьОбласть("ШапкаТаблицыУслуг");
	ТабличныйДокумент.Вывести(ОбластьШапкаТаблицыУслуг);

	//СтрокаУслуг
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	РасчетыПоЛицевымСчетам.ЛицевойСчет,
	               |	РасчетыПоЛицевымСчетам.Услуга,
	               |	РасчетыПоЛицевымСчетам.МесяцНачисления,
	               |	РасчетыПоЛицевымСчетам.Сумма,
	               |	РасчетыПоЛицевымСчетам.Тариф,
	               |	РасчетыПоЛицевымСчетам.ДнейНачислено,
	               |	РасчетыПоЛицевымСчетам.Услуга.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	               |	РасчетыПоЛицевымСчетам.ВидНачисления,
	               |	РасчетыПоЛицевымСчетам.Количество,
	               |	РасчетыПоЛицевымСчетам.Организация,
	               |	РасчетыПоЛицевымСчетам.ЛицевойСчет.Владелец
	               |ПОМЕСТИТЬ РасчетыПоЛицСчетам
	               |ИЗ
	               |	РегистрНакопления.РасчетыПоЛицевымСчетам КАК РасчетыПоЛицевымСчетам
	               |ГДЕ
	               |	РасчетыПоЛицевымСчетам.ЛицевойСчет В(&ЛицевойСчет)
	               |	И РасчетыПоЛицевымСчетам.ДатаНачалаПериода > ДОБАВИТЬКДАТЕ(НАЧАЛОПЕРИОДА(&Дата, МЕСЯЦ), СЕКУНДА, -1)
	               |	И РасчетыПоЛицевымСчетам.ДатаНачалаПериода < ДОБАВИТЬКДАТЕ(КОНЕЦПЕРИОДА(&Дата, МЕСЯЦ), СЕКУНДА, 1)
	               |	И РасчетыПоЛицевымСчетам.Сумма <> 0
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	РасчетыПоЛицСчетам.ЛицевойСчет КАК ЛицевойСчет,
	               |	РасчетыПоЛицСчетам.Услуга КАК Услуга,
	               |	РасчетыПоЛицСчетам.МесяцНачисления,
	               |	РасчетыПоЛицСчетам.Сумма КАК Сумма,
	               |	РасчетыПоЛицСчетам.Тариф,
	               |	РасчетыПоЛицСчетам.ДнейНачислено,
	               |	ВЫБОР
	               |		КОГДА РасчетыПоЛицСчетам.ВидНачисления = ЗНАЧЕНИЕ(Перечисление.ВидыНачислений.Начисление)
	               |			ТОГДА ЕСТЬNULL(РасчетыПоЛицевымСчетамОстатки.СуммаОстаток, 0)
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК Долг,
	               |	РасчетыПоЛицСчетам.ЕдиницаИзмерения,
	               |	РасчетыПоЛицСчетам.ВидНачисления КАК ВидНачисления,
	               |	РасчетыПоЛицСчетам.Количество,
	               |	ТарифыСрезПоследних.НормаПотребления,
	               |	ЕСТЬNULL(УстановленныеПриборыУчетаСрезПоследних.ПриборУчета, 0) КАК ПриборУчета,
	               |	ЕСТЬNULL(УстановленныеПриборыУчетаСрезПоследних.Действует, ЛОЖЬ) КАК Действует,
	               |	ЕСТЬNULL(Аванс.АвансИлиДолг, 0) КАК Аванс,
	               |	Аванс.Начислено КАК Начислено,
	               |	Аванс.КВыплате КАК КВыплате,
	               |	ПоказанияПриборовУчета.Тек КАК ТекущиеПоказания,
	               |	ПоказанияПриборовУчета.Пред КАК ПредыдущиеПоказания
	               |ИЗ
	               |	РасчетыПоЛицСчетам КАК РасчетыПоЛицСчетам
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Тарифы.СрезПоследних(&Дата, ) КАК ТарифыСрезПоследних
	               |		ПО РасчетыПоЛицСчетам.Услуга = ТарифыСрезПоследних.Услуга
	               |			И РасчетыПоЛицСчетам.Организация = ТарифыСрезПоследних.Организация
	               |			И РасчетыПоЛицСчетам.ЛицевойСчетВладелец = ТарифыСрезПоследних.Здание
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УстановленныеПриборыУчета.СрезПоследних КАК УстановленныеПриборыУчетаСрезПоследних
	               |			ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |				Текущие.ПриборУчета КАК ПриборУчета,
	               |				ЕСТЬNULL(Текущие.Значение, 0) КАК Тек,
	               |				ЕСТЬNULL(Прошлые.Значение, 0) КАК Пред
	               |			ИЗ
	               |				РегистрСведений.ПоказанияПриборовУчета.СрезПоследних(КОНЕЦПЕРИОДА(&Дата, МЕСЯЦ), ) КАК Текущие
	               |					ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПоказанияПриборовУчета.СрезПоследних(ДОБАВИТЬКДАТЕ(КОНЕЦПЕРИОДА(&Дата, МЕСЯЦ), МЕСЯЦ, -1), ) КАК Прошлые
	               |					ПО Текущие.ПриборУчета = Прошлые.ПриборУчета
	               |						И Текущие.ВидТарифа = Прошлые.ВидТарифа) КАК ПоказанияПриборовУчета
	               |			ПО УстановленныеПриборыУчетаСрезПоследних.ПриборУчета = ПоказанияПриборовУчета.ПриборУчета
	               |		ПО РасчетыПоЛицСчетам.ЛицевойСчет = УстановленныеПриборыУчетаСрезПоследних.ОбъектУстановки
	               |			И РасчетыПоЛицСчетам.Услуга = УстановленныеПриборыУчетаСрезПоследних.ПриборУчета.Услуга
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.РасчетыПоЛицевымСчетам.Остатки(КОНЕЦПЕРИОДА(&Дата, МЕСЯЦ), ЛицевойСчет В (&ЛицевойСчет)) КАК РасчетыПоЛицевымСчетамОстатки
	               |		ПО РасчетыПоЛицСчетам.Услуга = РасчетыПоЛицевымСчетамОстатки.Услуга
	               |			И РасчетыПоЛицСчетам.ЛицевойСчет = РасчетыПоЛицевымСчетамОстатки.ЛицевойСчет
	               |			И РасчетыПоЛицСчетам.Организация = РасчетыПоЛицевымСчетамОстатки.Организация
	               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			РасчетыПоЛицевымСчетамОстаткиИОбороты.СуммаНачальныйОстаток КАК АвансИлиДолг,
	               |			РасчетыПоЛицевымСчетамОстаткиИОбороты.СуммаПриход КАК Начислено,
	               |			РасчетыПоЛицевымСчетамОстаткиИОбороты.СуммаРасход КАК Оплачено,
	               |			РасчетыПоЛицевымСчетамОстаткиИОбороты.СуммаКонечныйОстаток КАК КВыплате,
	               |			НАЧАЛОПЕРИОДА(&Дата, МЕСЯЦ) КАК НачалоПериода,
	               |			КОНЕЦПЕРИОДА(&Дата, МЕСЯЦ) КАК КонецПериода,
	               |			РасчетыПоЛицевымСчетамОстаткиИОбороты.ЛицевойСчет КАК ЛицевойСчет
	               |		ИЗ
	               |			РегистрНакопления.РасчетыПоЛицевымСчетам.ОстаткиИОбороты(КОНЕЦПЕРИОДА(&Дата, МЕСЯЦ), КОНЕЦПЕРИОДА(&Дата, МЕСЯЦ), , , ЛицевойСчет = &ЛицевойСчет) КАК РасчетыПоЛицевымСчетамОстаткиИОбороты) КАК Аванс
	               |		ПО РасчетыПоЛицСчетам.ЛицевойСчет = Аванс.ЛицевойСчет
	               |ИТОГИ
	               |	СУММА(Сумма),
	               |	СУММА(Долг),
	               |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВидНачисления),
	               |	МАКСИМУМ(Действует),
	               |	МАКСИМУМ(Аванс),
	               |	МАКСИМУМ(Начислено),
	               |	МАКСИМУМ(КВыплате)
	               |ПО
	               |	ЛицевойСчет,
	               |	Услуга";
	Запрос.УстановитьПараметр("ЛицевойСчет",ПараметрыПечати.ЛицевойСчет);
	Запрос.УстановитьПараметр("Дата",ПараметрыПечати.ПериодПечати);
	ВыборкаЛицевойСчет = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Аванс = 0;
	Долг = 0;
	ДолгВсего = 0;
	НачисленоВсего = 0;
	Пока ВыборкаЛицевойСчет.Следующий() Цикл
		ВыборкаУслуга = ВыборкаЛицевойСчет.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаУслуга.Следующий() Цикл
			Если ВыборкаУслуга.Аванс < 0 Тогда
				Аванс = ВыборкаУслуга.Аванс;
				Долг = 0;
			Иначе
				Долг = ВыборкаУслуга.Аванс;
				Аванс = 0;
			КонецЕсли;
			
			НачисленоВсего = ВыборкаУслуга.Начислено;
			КВыплатеВсего = ВыборкаУслуга.КВыплате;
			
			Если ВыборкаУслуга.Действует Тогда
				Продолжить;
			КонецЕсли;
			
			ОбластьСтрокаУслуг = Макет.ПолучитьОбласть("СтрокаУслуг");
			Начисленно = 0;
			ВыборкаДетальныеЗаписи = ВыборкаУслуга.Выбрать();
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				
				ОбластьСтрокаУслуг.Параметры.НаименованиеУслуг = ВыборкаДетальныеЗаписи.Услуга;
				ОбластьСтрокаУслуг.Параметры.Тариф = ВыборкаДетальныеЗаписи.Тариф;
				ОбластьСтрокаУслуг.Параметры.ЕдИзмер = ВыборкаДетальныеЗаписи.ЕдиницаИзмерения;
				ОбластьСтрокаУслуг.Параметры.КолДней = ВыборкаДетальныеЗаписи.ДнейНачислено;
				
				Если ВыборкаДетальныеЗаписи.ВидНачисления = Перечисления.ВидыНачислений.Льгота Тогда
					ОбластьСтрокаУслуг.Параметры.Льготы = ВыборкаДетальныеЗаписи.Сумма;
				ИначеЕсли ВыборкаДетальныеЗаписи.ВидНачисления = Перечисления.ВидыНачислений.Субсидия Тогда
					ОбластьСтрокаУслуг.Параметры.Субсидия = ВыборкаДетальныеЗаписи.Сумма;
				ИначеЕсли ВыборкаДетальныеЗаписи.ВидНачисления = Перечисления.ВидыНачислений.Перерасчет Тогда
					ОбластьСтрокаУслуг.Параметры.Пересчет = ВыборкаДетальныеЗаписи.Сумма;
				ИначеЕсли ВыборкаДетальныеЗаписи.ВидНачисления = Перечисления.ВидыНачислений.Начисление Тогда
					ОбластьСтрокаУслуг.Параметры.НачисленоГрн = ВыборкаДетальныеЗаписи.Сумма;
				КонецЕсли;
				
				Начисленно = Начисленно + ВыборкаДетальныеЗаписи.Сумма;
				ОбластьСтрокаУслуг.Параметры.Начислено = Начисленно;
				ОбластьСтрокаУслуг.Параметры.Долг = ВыборкаДетальныеЗаписи.Долг;
				ОбластьСтрокаУслуг.Параметры.НачисленоКОплате =  Начисленно + ВыборкаДетальныеЗаписи.Долг;
				
			КонецЦикла; 
			ТабличныйДокумент.Вывести(ОбластьСтрокаУслуг);
		КонецЦикла;
		
		//ШапкаОбщиеПоказателиСчетчика
		ОбластьШапкаОбщиеПоказателиСчетчика = Макет.ПолучитьОбласть("ШапкаОбщиеПоказателиСчетчика");
		ТабличныйДокумент.Вывести(ОбластьШапкаОбщиеПоказателиСчетчика);
		
		ВыборкаУслуга = ВыборкаЛицевойСчет.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаУслуга.Следующий() Цикл
			
			Если НЕ ВыборкаУслуга.Действует Тогда
				Продолжить;
			КонецЕсли;
			
			ОбластьСтрокаСчетчик = Макет.ПолучитьОбласть("СтрокаСчетчиков");
			Счет = 0;
			ВыборкаДетальныеЗаписи = ВыборкаУслуга.Выбрать();
			
			Если ВыборкаДетальныеЗаписи.Количество() > 1 И НЕ ВыборкаУслуга.ВидНачисления > 1 Тогда
				Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
					Если НЕ Счет > 0 Тогда
						ТабличныйДокумент.Вывести(ВыводСтрокиУслуги (ОбластьСтрокаСчетчик, ВыборкаДетальныеЗаписи, Ложь));
						
						Счет = Счет + 1;
						
						НачисленоВсего = НачисленоВсего + ВыборкаДетальныеЗаписи.Сумма;
						ДолгВсего = ДолгВсего + ВыборкаДетальныеЗаписи.Долг;
					КонецЕсли;
					
					ОбластьДетальныеЗаписи = Макет.ПолучитьОбласть("СтрокаСчетчиковДетальныеЗаписи");
					
					ТабличныйДокумент.Вывести(ВыводСтрокиРасшифровки(ОбластьДетальныеЗаписи, ВыборкаДетальныеЗаписи));
				КонецЦикла; 
			Иначе
				Льгота = 0;
				Начисление = 0;
				Субсидия = 0;
				Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
					
					//Получаем показания счетчика
					ТекущиеПоказания = ВыборкаДетальныеЗаписи.ТекущиеПоказания;
					ПредыдущиееПоказания = ВыборкаДетальныеЗаписи.ПредыдущиеПоказания;
										
					ОбластьСтрокаСчетчик.Параметры.Услуга = ВыборкаДетальныеЗаписи.Услуга.Наименование;
					ОбластьСтрокаСчетчик.Параметры.Коэффициент = ВыборкаДетальныеЗаписи.ПриборУчета.Коэффициент;
					ОбластьСтрокаСчетчик.Параметры.ЕдИзмерения = ВыборкаДетальныеЗаписи.ЕдиницаИзмерения.Наименование;
					ОбластьСтрокаСчетчик.Параметры.Тариф = ВыборкаДетальныеЗаписи.Тариф;
					ОбластьСтрокаСчетчик.Параметры.НормаПотребления = ВыборкаДетальныеЗаписи.НормаПотребления;
					ОбластьСтрокаСчетчик.Параметры.Долг = ВыборкаДетальныеЗаписи.Долг;
					ОбластьСтрокаСчетчик.Параметры.Поточные = ТекущиеПоказания;
					ОбластьСтрокаСчетчик.Параметры.Предыдущие = ПредыдущиееПоказания;
					ОбластьСтрокаСчетчик.Параметры.Разница = ВыборкаДетальныеЗаписи.Количество;
					ОбластьСтрокаСчетчик.Параметры.Счетчик = ВыборкаДетальныеЗаписи.ПриборУчета.ЗаводскойНомер;
					Если ВыборкаДетальныеЗаписи.ВидНачисления = Перечисления.ВидыНачислений.Начисление Тогда
						Начисление = Начисление + ВыборкаДетальныеЗаписи.Сумма;
						ОбластьСтрокаСчетчик.Параметры.Насчитано = Начисление;
					ИначеЕсли ВыборкаДетальныеЗаписи.ВидНачисления = Перечисления.ВидыНачислений.Льгота Тогда
						Льгота = Льгота + ВыборкаДетальныеЗаписи.Сумма;
						ОбластьСтрокаСчетчик.Параметры.Льготы = Льгота;
					ИначеЕсли ВыборкаДетальныеЗаписи.ВидНачисления = Перечисления.ВидыНачислений.Субсидия Тогда
						Субсидия = Субсидия + ВыборкаДетальныеЗаписи.Сумма;
						ОбластьСтрокаСчетчик.Параметры.Субсидии = Субсидия;
					КонецЕсли;
					
					ОбластьСтрокаСчетчик.Параметры.КОплате = ?(Начисление=Неопределено,0,Начисление)+ВыборкаДетальныеЗаписи.Долг + ?(Субсидия=Неопределено,0,Субсидия)+?(Льгота=Неопределено,0,Льгота);
					
				КонецЦикла; 
				ТабличныйДокумент.Вывести(ОбластьСтрокаСчетчик);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	//ПодвалОсновнойЧасти
	ОбластьПодвалОсновнойЧасти = Макет.ПолучитьОбласть("ПодвалОсновнойЧасти");
	ДолгВсего = ДолгВсего;
	НасчитаноЗаУслуги = НачисленоВсего;
	ОбластьПодвалОсновнойЧасти.Параметры.Нараховано = НачисленоВсего;
	ОбластьПодвалОсновнойЧасти.Параметры.Борг = Долг;
	ОбластьПодвалОсновнойЧасти.Параметры.Аванс = Аванс-(Аванс+Аванс);
	ОбластьПодвалОсновнойЧасти.Параметры.Всего = КВыплатеВсего;
	ТабличныйДокумент.Вывести(ОбластьПодвалОсновнойЧасти);

	//Подвал1
	ОбластьПодвал1 = Макет.ПолучитьОбласть("Подвал1");
	ОбластьПодвал1.Параметры.ЄДРПОУ = ПараметрыПечати.ЛицевойСчет.Владелец.Организация.КодПоЕДРПОУ;
	ОбластьПодвал1.Параметры.Получатель = ПараметрыПечати.ЛицевойСчет.Владелец.Организация.НаименованиеПолное;
	ОбластьПодвал1.Параметры.месяц = Формат(ПараметрыПечати.ПериодПечати,"Л=uk_UA; ДФ=MMMM");
	ОбластьПодвал1.Параметры.год = Формат(ПараметрыПечати.ПериодПечати,"ДФ=yyyy");
	ТабличныйДокумент.Вывести(ОбластьПодвал1);

	//Банковский Счет Подвал
		ОбластьБанковскийСчет = Макет.ПолучитьОбласть("БанковскийСчетПодвал");
		ОбластьБанковскийСчет.Параметры.Рр = ПараметрыПечати.ЛицевойСчет.Владелец.Организация.БанковскийСчетПоУмолчанию.НомерСчета;
		ОбластьБанковскийСчет.Параметры.Банк = ПараметрыПечати.ЛицевойСчет.Владелец.Организация.БанковскийСчетПоУмолчанию.Банк.Наименование;
		ОбластьБанковскийСчет.Параметры.МФО = ПараметрыПечати.ЛицевойСчет.Владелец.Организация.БанковскийСчетПоУмолчанию.Банк.Код;
		ТабличныйДокумент.Вывести(ОбластьБанковскийСчет);

	//ПОДВАЛ
	ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
	ОбластьПодвал.Параметры.месяц = Формат(ПараметрыПечати.ПериодПечати,"Л=uk_UA; ДФ=MMMM");
	ОбластьПодвал.Параметры.год = Формат(ПараметрыПечати.ПериодПечати,"ДФ=yyyy");
	ОбластьПодвал.Параметры.Нараховано = НачисленоВсего;
	ОбластьПодвал.Параметры.Борг = Долг;
	ОбластьПодвал.Параметры.Аванс = Аванс-(Аванс+Аванс);
	ОбластьПодвал.Параметры.Итого = КВыплатеВсего;
	ОбластьПодвал.Параметры.ЛицевойСчет = ПараметрыПечати.ЛицевойСчет;
	ОбластьПодвал.Параметры.Адрес = ПараметрыПечати.ЛицевойСчет.Владелец.Наименование+" "+ПараметрыПечати.ЛицевойСчет.ОбъектЛицевогоСчета.Наименование;
	Попытка
		ОбластьПодвал.Параметры.Плательщик = РегистрыСведений.ОтветственныйВладелецЛицевогоСчета.СрезПоследних(ТекущаяДата(),Новый Структура("ЛицевойСчет",ПараметрыПечати.ЛицевойСчет))[0].ОтветственныйВладелец.Наименование;
	Исключение
	КонецПопытки;

	Для Каждого Строка Из ВыборкаПлощади Цикл
		Если Строка.ВидПлощади = Справочники.ВидыПлощадей.ОтапливаемаяПлощадь Тогда
			ОбластьПодвал.Параметры.ПлощадьОтоп = Строка.Площадь;
		ИначеЕсли Строка.ВидПлощади = Справочники.ВидыПлощадей.ОбщаяПлощадь Тогда
			ОбластьПодвал.Параметры.ПлощадьВся = Строка.Площадь;
		КонецЕсли;
	КонецЦикла;

	Для Каждого Строка Из ВыборкаКолПроживающих Цикл
		ОбластьПодвал.Параметры.КолЧеловек = Строка.КоличествоПроживающих;
	КонецЦикла;
	ОбластьПодвал.Параметры.КоличествоМестПаркинг = "";

	ТабличныйДокумент.Вывести(ОбластьПодвал);
	
	Возврат ТабличныйДокумент;
	
КонецФункции

&НаКлиенте
Функция ПолучитьПутьКаталога(ПутьКФайлуВыгрузки)
	Путь = ПутьКФайлуВыгрузки;
	Каталог = "";
	Для Счет=1 По СтрЧислоВхождений(Путь,"\")Цикл
		Число = Найти(Путь,"\");
		Каталог = Каталог + Лев(Путь,СтрДлина(Путь)-(СтрДлина(Путь)-Число));
		Путь =  Прав(Путь,(СтрДлина(Путь)-Число));
	КонецЦикла;
	Возврат Каталог + "PDF\";
КонецФункции
 
Функция ВыводСтрокиУслуги (Макет, Услуга, ПоказанияСчет)
	Область = Макет;
	
	Льгота = 0;
	Начисление = 0;
	Субсидия = 0;
	
	//Получаем показания счетчика
	ТекущиеПоказания = Услуга.ТекущиеПоказания;
	ПредыдущиееПоказания = Услуга.ПредыдущиеПоказания;
	
	Область.Параметры.Услуга = Услуга.Услуга.Наименование;
	Область.Параметры.Коэффициент = Услуга.ПриборУчета.Коэффициент;
	Область.Параметры.ЕдИзмерения = Услуга.ЕдиницаИзмерения.Наименование;
	Область.Параметры.Тариф = Услуга.Тариф;
	Область.Параметры.НормаПотребления = Услуга.НормаПотребления;
	Область.Параметры.Долг = Услуга.Долг;
	Область.Параметры.Поточные = ?(ПоказанияСчет, ТекущиеПоказания, "-");
	Область.Параметры.Предыдущие = ?(ПоказанияСчет, ПредыдущиееПоказания, "-");
	Область.Параметры.Разница = Услуга.Количество;
	Область.Параметры.Счетчик = ?(ПоказанияСчет,"("+Услуга.ПриборУчета.ЗаводскойНомер+")","");
	Если Услуга.ВидНачисления = Перечисления.ВидыНачислений.Начисление Тогда
		Начисление = Начисление + Услуга.Сумма;
		Область.Параметры.Насчитано = Начисление;
	ИначеЕсли Услуга.ВидНачисления = Перечисления.ВидыНачислений.Льгота Тогда
		Льгота = Льгота + Услуга.Сумма;
		Область.Параметры.Льготы = Льгота;
	ИначеЕсли Услуга.ВидНачисления = Перечисления.ВидыНачислений.Субсидия Тогда
		Субсидия = Субсидия + Услуга.Сумма;
		Область.Параметры.Субсидии = Субсидия;
	КонецЕсли;
	Область.Параметры.КОплате = ?(Начисление=Неопределено,0,Начисление)+Услуга.Долг + ?(Субсидия=Неопределено,0,Субсидия)+?(Льгота=Неопределено,0,Льгота);
	
	Возврат Область;
КонецФункции 

Функция ВыводСтрокиРасшифровки(Макет, Счетчик)
	Область = Макет;//.ПолучитьОбласть("СтрокаСчетчиковДетальныеЗаписи");
	
	//Получаем показания счетчика
	ТекущиеПоказания = Счетчик.ТекущиеПоказания;
	ПредыдущиееПоказания = Счетчик.ПредыдущиеПоказания;
	
	Область.Параметры.Счетчик = Счетчик.ПриборУчета.ЗаводскойНомер;
	Область.Параметры.Поточные = ТекущиеПоказания;
	Область.Параметры.Предыдущие = ПредыдущиееПоказания;
	Область.Параметры.Разница = ТекущиеПоказания - ПредыдущиееПоказания;
	
	Возврат Область;
	
КонецФункции // ВыводСтрокиРозшифровки() 

&НаСервере
Функция НайтиЗначениеАдреса(Адрес, Значение)
	ЗначениеАдреса = "";
	Для Счет = 1 По СтрЧислоСтрок(Адрес) Цикл
		Строка = СтрПолучитьСтроку(Адрес, Счет);
		Если СтрЧислоВхождений(Строка, Значение)>0 Тогда
			Позиция = Найти(Строка, "=");
			ЗначениеАдреса = Прав(Строка,СтрДлина(Строка)-Позиция);
		КонецЕсли;
	КонецЦикла;
	Возврат ЗначениеАдреса;
КонецФункции 

&НаСервереБезКонтекста
Функция ДанныеХМЛБлокаОрганизации(Организация)
	СтруктураОрганизации = Новый Структура;
	СтруктураОрганизации.Вставить("Ссылка", XMLСтрока(Организация.Ссылка));
	СтруктураОрганизации.Вставить("ИНН", Организация.ИНН);
	СтруктураОрганизации.Вставить("НаименованиеПолное", Организация.НаименованиеПолное);
	Возврат СтруктураОрганизации;
КонецФункции  

&НаСервере
Функция  ПолучитьРеквизитыБанкаНаСервере(Банк)
	СтруктураРеквизитовБанка = Новый Структура;
	СтруктураРеквизитовБанка.Вставить("Receiver", Банк.Наименование);
