	Возврат СтруктураРеквизитовБанка;
КонецФункции
 
&НаСервере
Функция ПолучитьДокументыДляВыгрузки()

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЗаявкаНаПроведениеРемонта.Ссылка,
	               |	ЗаявкаНаПроведениеРемонта.Номер,
	               |	ВЫБОР
	               |		КОГДА ЗаявкаНаПроведениеРемонта.СтатусЗаявки = ЗНАЧЕНИЕ(Перечисление.ВидыСтатусовЗаявкиНаПроведениеРемонта.НоваяЗаявка)
	               |			ТОГДА ""5""
	               |		КОГДА ЗаявкаНаПроведениеРемонта.СтатусЗаявки = ЗНАЧЕНИЕ(Перечисление.ВидыСтатусовЗаявкиНаПроведениеРемонта.Принята)
	               |			ТОГДА ""7""
	               |		КОГДА ЗаявкаНаПроведениеРемонта.СтатусЗаявки = ЗНАЧЕНИЕ(Перечисление.ВидыСтатусовЗаявкиНаПроведениеРемонта.Выполнена)
	               |			ТОГДА ""8""
	               |		ИНАЧЕ ""9""
	               |	КОНЕЦ КАК Статус,
	               |	ЗаявкаНаПроведениеРемонта.ЛицевойСчет,
	               |	ЗаявкаНаПроведениеРемонта.ТекстЗаявки,
	               |	ЗаявкаНаПроведениеРемонта.ВремяУдобноеДляЗаказчика,
	               |	ЗаявкаНаПроведениеРемонта.ВремяФактическогоВыполнения,
	               |	ЗаявкаНаПроведениеРемонта.ДатаПоследнегоИзменения,
	               |	ЗаявкаНаПроведениеРемонта.Автор,
	               |	ЗаявкаНаПроведениеРемонта.АвторПоследнегоИзменения,
	               |	ЗаявкаНаПроведениеРемонта.ВидЗаявки,
	               |	ЗаявкаНаПроведениеРемонта.Здание,
	               |	ЕСТЬNULL(ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ОтветственныйВладелец.Наименование, """") КАК ОтветственныйВладелец
	               |ИЗ
	               |	Документ.ЗаявкаНаПроведениеРемонта КАК ЗаявкаНаПроведениеРемонта
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОтветственныйВладелецЛицевогоСчета.СрезПоследних(&Дата, ) КАК ОтветственныйВладелецЛицевогоСчетаСрезПоследних
	               |		ПО ЗаявкаНаПроведениеРемонта.ЛицевойСчет = ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ЛицевойСчет
	               |ГДЕ
	               |	ЗаявкаНаПроведениеРемонта.Проведен = ИСТИНА
	               |	И ЗаявкаНаПроведениеРемонта.ПометкаУдаления = ЛОЖЬ
	               |	И ЗаявкаНаПроведениеРемонта.Дата > ДОБАВИТЬКДАТЕ(НАЧАЛОПЕРИОДА(&Дата, МЕСЯЦ), СЕКУНДА, -1)
	               |	И ЗаявкаНаПроведениеРемонта.Дата < ДОБАВИТЬКДАТЕ(КОНЕЦПЕРИОДА(&Дата, МЕСЯЦ), СЕКУНДА, 1)";
	Запрос.УстановитьПараметр("Дата", Объект.ПериодПросмотра);
	Выборка = Запрос.Выполнить().Выбрать();
	
	ДокументЗаявкаНаРемонт = Новый Структура;
	
	Номер = 1;
	Пока Выборка.Следующий() Цикл
		Заявка = Новый Структура;
		Заявка.Вставить("Автор",Выборка.Автор.Наименование);
		Заявка.Вставить("АвторПоследнегоИзменения",Выборка.АвторПоследнегоИзменения.Наименование);
		Заявка.Вставить("ВидЗаявки",XMLСтрока(Выборка.ВидЗаявки));
		Заявка.Вставить("ВремяУдобноеДляЗаказчика",Выборка.ВремяУдобноеДляЗаказчика);
		Заявка.Вставить("ВремяФактическогоВыполнения",Выборка.ВремяФактическогоВыполнения);
		Заявка.Вставить("ДатаПоследнегоИзменения",Выборка.ДатаПоследнегоИзменения);
		Заявка.Вставить("Здание",Выборка.Здание.Наименование);
		Заявка.Вставить("Квартира",XMLСтрока(Выборка.ЛицевойСчет.ОбъектЛицевогоСчета.Код));
		Заявка.Вставить("ЛицевойСчет",Выборка.ЛицевойСчет.Наименование);
		Заявка.Вставить("Номер",Выборка.Номер);
		Заявка.Вставить("ОтветственныйВладелец",Выборка.ОтветственныйВладелец);
		Заявка.Вставить("Ссылка",XMLСтрока(Выборка.Ссылка));
		Заявка.Вставить("Статус",Выборка.Статус);
		Заявка.Вставить("ТекстЗаявки",Выборка.ТекстЗаявки);
		
		ДокументЗаявкаНаРемонт.Вставить("Заявка"+Номер, Заявка);
		
		Номер = Номер + 1;
	КонецЦикла; 
	
	Возврат ДокументЗаявкаНаРемонт;

КонецФункции // ПолучитьДокументыДляВыгрузки()

//============================ ФУНКЦИИ ДЛЯ РАБОТЫ ПОМОЩНИКА =======================================//
&НаКлиенте
Процедура КомандаДалее(Команда)
	Если ТекущийНомерСтраницы = 2 Тогда
		
		ИзменитьНомерСтраницы(+1);
		
	Иначе                             
		
		ИзменитьНомерСтраницы(+1);
		
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура КомандаНазад(Команда)
	Если ТекущийНомерСтраницы = 3 Тогда
		
		ИзменитьНомерСтраницы(-1);
		
	Иначе
		
		ИзменитьНомерСтраницы(-1);
		
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьНомерСтраницы(Итератор)
	
	Отказ = Ложь;
	
	// Изменяем номер текущей страницы.
	Инкремент(ТекущийНомерСтраницы, Итератор);
	
	// Обработчики событий при смене страницы мастера.
	ВыполнитьОбработчикиСобытийМастераПриСменеСтраницы(Отказ, Итератор > 0);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	// Отображаем новую страницу мастера.
	УстановитьВидимостьНаКлиенте();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьНаКлиенте()
	
	// устанавливаем текущую страницу мастера
	Элементы.СтраницыМастера.ТекущаяСтраница = СтраницыМастера[ТекущийНомерСтраницы];
	
	// устанавливаем текущую страницу кнопок мастера
	Элементы.КнопкиМастера.ТекущаяСтраница = КнопкиМастера[ТекущийНомерСтраницы];
		
КонецПроцедуры

&НаКлиенте
Процедура Инкремент(Число, Знач Итератор = 1)
	
	Число = Число + Итератор;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОбработчикиСобытийМастераПриСменеСтраницы(Отказ, ЭтоУвеличениеНомераСтраницы)
	
	Если ЭтоУвеличениеНомераСтраницы Тогда
		
		ВыполнитьПроверкиПриПереходеНаСледующуюСтраницу(Отказ);
		
	КонецЕсли;
	
	Если Отказ Тогда
		
		Инкремент(ТекущийНомерСтраницы, ?(ЭтоУвеличениеНомераСтраницы, -1, +1));
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПроверкиПриПереходеНаСледующуюСтраницу(Отказ)
	
	ОчиститьСообщения();
	
	Если ТекущийНомерСтраницы = 2 Тогда 
		Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
			Сообщение = НСтр("ru = 'Укажите наименование организации!'; uk='Вкажіть найменування організації!'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Сообщение,, "Объект.Организация",, Отказ);
		КонецЕсли;
		Если Не ЗначениеЗаполнено(МесяцСтрока) Тогда
			Сообщение = НСтр("ru = 'Укажите период выгрузки!'; uk='Вкажіть період вивантаження!'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Сообщение,, "МесяцСтрока",, Отказ);
		КонецЕсли;
	ИначеЕсли ТекущийНомерСтраницы = 3 Тогда 
		Если Объект.ЛицевыеСчета.Количество() = 0 Тогда
			Сообщение = НСтр("ru = 'Выберите хотя бы один лицевой счет!'; uk='Виберіть як мінімум один особовий рахунок!'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Сообщение,, "Объект.ЛицевыеСчета",, Отказ);
		КонецЕсли;
	ИначеЕсли ТекущийНомерСтраницы = 4 Тогда 
		Если Не ЗначениеЗаполнено(Объект.ИмяФайлаДанных) Тогда
			Сообщение = НСтр("ru = 'Укажите каталог и имя файла выгрузки!'; uk='Вкажіть директорію та ім’я файлу вивантаження!'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Сообщение,, "Объект.ИмяФайлаДанных",, Отказ);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИнициализацияМастераНаКлиенте()
	
	ТекущийНомерСтраницы = 1;
	
	СтраницыМастера = Новый Соответствие;
	КнопкиМастера   = Новый Соответствие;
	
	// СТРАНИЦЫ МАСТЕРА
	
	СтраницыМастера.Вставить(1, Элементы.СтраницаМастераНачало);
	СтраницыМастера.Вставить(2, Элементы.СтраницаМастераНастройкиВыборЛицевыхСчетов);
	СтраницыМастера.Вставить(3, Элементы.СтраницаМастераНастройкиВыбораКаталогаВыгрузки);
	
	// КНОПКИ МАСТЕРА
	
	КнопкиМастера.Вставить(1, Элементы.КнопкиНачала);
	КнопкиМастера.Вставить(2, Элементы.КнопкиПродолжения);
	КнопкиМастера.Вставить(3, Элементы.КнопкиОкончания);
	
КонецПроцедуры

&НаКлиенте
Процедура ЛицевыеСчетаЛицевойСчетПриИзменении(Элемент)
	Стр = Элементы.ЛицевыеСчета.ТекущиеДанные;
	                                               
	Стр.Владелец = ПолучитьВладельцаЛицевогоСчета(Стр.ЛицевойСчет);
	Стр.Адрес = ПолучитьАдресЛицевогоСчета(Стр.ЛицевойСчет);
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьВладельцаЛицевогоСчета(ЛицевойСчет)
	Возврат РегистрыСведений.ОтветственныйВладелецЛицевогоСчета.СрезПоследних(ТекущаяДата(),Новый Структура("ЛицевойСчет",ЛицевойСчет))[0].ОтветственныйВладелец.Наименование;
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьАдресЛицевогоСчета(ЛицевойСчет)
	Возврат ЛицевойСчет.Владелец.Наименование+", "+ЛицевойСчет.ОбъектЛицевогоСчета.Наименование;
КонецФункции

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	Объект.РасчетныйСчетОрганизации = ПолучитьРасчетныйСчетНаСервере(Объект.Организация);
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьРасчетныйСчетНаСервере(Организация)
	Возврат Организация.БанковскийСчетПоУмолчанию;
КонецФункции // ()


 
 
