&НаКлиенте
Перем ТекущийНомерСтраницы;

&НаКлиенте
Перем КнопкиМастера;

&НаКлиенте
Перем СтраницыМастера;

&НаКлиенте
Процедура КомандаГотово(Команда)
	
	Если НЕ ЗначениеЗаполнено(Объект.ИмяФайлаДанных) Тогда
		Сообщение=НСтр("ru=""Не выбран файл для выгрузки.""; uk=""Не вибраний файл для вивантаження""");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Сообщение,, "Объект.ИмяФайлаДанных",,);
		Возврат;
	КонецЕсли;
	
	ИмяФайла = Объект.ИмяФайлаДанных;
	
	ПутьКаталога = 	ПолучитьПутьКаталога(Объект.ИмяФайлаДанных);
	СоздатьКаталог(ПутьКаталога);
	
	ЗаписьХМЛ = Новый ЗаписьXML;
	
	ЗаписьХМЛ.ОткрытьФайл(ИмяФайла);
	ЗаписьХМЛ.ЗаписатьОбъявлениеXML();
	ЗаписьХМЛ.ЗаписатьНачалоЭлемента("ORG");
	
		//Получить данные на сервере об организации
		ДанныеОрганизации = ДанныеХМЛБлокаОрганизации(Объект.Организация);
		
		ЗаписьХМЛ.ЗаписатьАтрибут("ID", ДанныеОрганизации.Ссылка);
		ЗаписьХМЛ.ЗаписатьАтрибут("filedate",Строка(Формат(НачалоМесяца(Объект.ПериодПросмотра),"ДЛФ=Д")));
		ЗаписьХМЛ.ЗаписатьАтрибут("inn", ДанныеОрганизации.ИНН);
		ЗаписьХМЛ.ЗаписатьАтрибут("name", ДанныеОрганизации.НаименованиеПолное);
		
		//Получить реквизиты банка на сервере
		БанкДляРасчета = ПолучитьРеквизитыБанкаНаСервере(Объект.РасчетныйСчетОрганизации);
				
		ЗаписьХМЛ.ЗаписатьНачалоЭлемента("BeneficiaryBank");
			ЗаписьХМЛ.ЗаписатьАтрибут("Receiver", БанкДляРасчета.Receiver);
			ЗаписьХМЛ.ЗаписатьАтрибут("Code", БанкДляРасчета.Code);
			ЗаписьХМЛ.ЗаписатьАтрибут("AccountNumber", БанкДляРасчета.AccountNumber);
			ЗаписьХМЛ.ЗаписатьАтрибут("MFI_Bank", БанкДляРасчета.MFI_Bank);
		ЗаписьХМЛ.ЗаписатьКонецЭлемента();
		
		//Формируем файл выгрузки
		МассивЛицСчетов = СформироватьфайлДляВыгрузки();
		
		Для каждого ЛС Из МассивЛицСчетов Цикл
			ЛицевойСчет = ЛС.Значение;
			ЗаписьХМЛ.ЗаписатьНачалоЭлемента("PersAcc");
				ЗаписьХМЛ.ЗаписатьАтрибут("ID", ЛицевойСчет.ID);
				ЗаписьХМЛ.ЗаписатьАтрибут("AddressCity", ЛицевойСчет.AddressCity);
				ЗаписьХМЛ.ЗаписатьАтрибут("AddressDistrict", ЛицевойСчет.AddressDistrict);
				ЗаписьХМЛ.ЗаписатьАтрибут("AddressFlat", ЛицевойСчет.AddressFlat);
				ЗаписьХМЛ.ЗаписатьАтрибут("AddressHouse", ЛицевойСчет.AddressHouse);
				ЗаписьХМЛ.ЗаписатьАтрибут("AddressRegion", ЛицевойСчет.AddressRegion);
				ЗаписьХМЛ.ЗаписатьАтрибут("AddressSettlement", ЛицевойСчет.AddressSettlement);
				ЗаписьХМЛ.ЗаписатьАтрибут("AddressStreet", ЛицевойСчет.AddressStreet);
				ЗаписьХМЛ.ЗаписатьАтрибут("Barcode", ЛицевойСчет.Barcode);
				ЗаписьХМЛ.ЗаписатьАтрибут("commonarea", ЛицевойСчет.commonarea);
				ЗаписьХМЛ.ЗаписатьАтрибут("debtbeg", ЛицевойСчет.debtbeg);
				ЗаписьХМЛ.ЗаписатьАтрибут("debtup", ЛицевойСчет.debtup);
				ЗаписьХМЛ.ЗаписатьАтрибут("debtdown", ЛицевойСчет.debtdown);
				ЗаписьХМЛ.ЗаписатьАтрибут("debtend", ЛицевойСчет.debtend);
				ЗаписьХМЛ.ЗаписатьАтрибут("email", ЛицевойСчет.email);
				ЗаписьХМЛ.ЗаписатьАтрибут("habarea", ЛицевойСчет.habarea);
				ЗаписьХМЛ.ЗаписатьАтрибут("kod_ls", ЛицевойСчет.kod_ls);
				ЗаписьХМЛ.ЗаписатьАтрибут("name", ЛицевойСчет.name);
				ЗаписьХМЛ.ЗаписатьАтрибут("name_ls", ЛицевойСчет.name_ls);
				ЗаписьХМЛ.ЗаписатьАтрибут("password", ЛицевойСчет.password);
				ЗаписьХМЛ.ЗаписатьАтрибут("people_Living", ЛицевойСчет.people_Living);
				ЗаписьХМЛ.ЗаписатьАтрибут("people_Prescription", ЛицевойСчет.people_Prescription);
				
				Для каждого УслугаЛС Из ЛицевойСчет.АктивныеУслуги Цикл
					Услуга =  УслугаЛС.Значение;
					ЗаписьХМЛ.ЗаписатьНачалоЭлемента("item");
						ЗаписьХМЛ.ЗаписатьАтрибут("ammount", Услуга.ammount);
						ЗаписьХМЛ.ЗаписатьАтрибут("edizm", Услуга.edizm);
						ЗаписьХМЛ.ЗаписатьАтрибут("ID", Услуга.ID);
						ЗаписьХМЛ.ЗаписатьАтрибут("Name", Услуга.name);
						ЗаписьХМЛ.ЗаписатьАтрибут("DetailsOf_Payment", Услуга.DetailsOf_Payment);
						ЗаписьХМЛ.ЗаписатьАтрибут("norm", Услуга.norm);
						ЗаписьХМЛ.ЗаписатьАтрибут("sum", Услуга.sum);
						ЗаписьХМЛ.ЗаписатьАтрибут("sumpayed", Услуга.sumpayed);
						ЗаписьХМЛ.ЗаписатьАтрибут("tarif", Услуга.tarif);
						Если Услуга.ЭтоСчетчик Тогда
							ПоказанияСчетчика = Услуга.ПоказанияСчетчика;
							ЗаписьХМЛ.ЗаписатьНачалоЭлемента("meter");
								ЗаписьХМЛ.ЗаписатьАтрибут("value_count", ПоказанияСчетчика.value_count);
								ЗаписьХМЛ.ЗаписатьАтрибут("indicbef1", ПоказанияСчетчика.indicbef1);
								ЗаписьХМЛ.ЗаписатьАтрибут("indiccur1", ПоказанияСчетчика.indiccur1);
								ЗаписьХМЛ.ЗаписатьАтрибут("ID", ПоказанияСчетчика.ID);
								ЗаписьХМЛ.ЗаписатьАтрибут("name", ПоказанияСчетчика.name);
								ЗаписьХМЛ.ЗаписатьАтрибут("service", ПоказанияСчетчика.service);
							ЗаписьХМЛ.ЗаписатьКонецЭлемента();
						КонецЕсли;
					ЗаписьХМЛ.ЗаписатьКонецЭлемента();
				КонецЦикла;
				
				//Формируем ПДФ Квитанцию на оплату
				ТабДокПДФ = ПечатьПДФКвитанции(ЛицевойСчет.ПараметрыПечати);
				
				//Опридиляем путь сохранения пдф квитанций                             
				ТабДокПДФ.АвтоМасштаб = Истина;                                
				ТабДокПДФ.Записать(ПолучитьПутьКаталога(Объект.ИмяФайлаДанных)+ЛицевойСчет.Barcode+".pdf", ТипФайлаТабличногоДокумента.PDF);
				//Конец формирования ПДФ квитанции
				
			ЗаписьХМЛ.ЗаписатьКонецЭлемента();
		КонецЦикла;
		
		МассивДокументов = ПолучитьДокументыДляВыгрузки();
		
		//Выгружаем на сайт Заявки на проведения работ
		ЗаписьХМЛ.ЗаписатьНачалоЭлемента("requests");
			//ЗаписьХМЛ.ЗаписатьАтрибут("filedate", "Дата документа");
			//ЗаписьХМЛ.ЗаписатьАтрибут("filetype", "Тип документа");
			
			ЗаписьХМЛ.ЗаписатьНачалоЭлемента("statuses");
				// Цикл на 5 статусов
				ЗаписьХМЛ.ЗаписатьНачалоЭлемента("status");
					ЗаписьХМЛ.ЗаписатьАтрибут("id","5");
					ЗаписьХМЛ.ЗаписатьАтрибут("title","Новая заявка");
				ЗаписьХМЛ.ЗаписатьКонецЭлемента();
				ЗаписьХМЛ.ЗаписатьНачалоЭлемента("status");
					ЗаписьХМЛ.ЗаписатьАтрибут("id","6");
					ЗаписьХМЛ.ЗаписатьАтрибут("title","Передана на исполнение");
				ЗаписьХМЛ.ЗаписатьКонецЭлемента();
				ЗаписьХМЛ.ЗаписатьНачалоЭлемента("status");
					ЗаписьХМЛ.ЗаписатьАтрибут("id","7");
					ЗаписьХМЛ.ЗаписатьАтрибут("title","Принята на исполнения");
				ЗаписьХМЛ.ЗаписатьКонецЭлемента();
				ЗаписьХМЛ.ЗаписатьНачалоЭлемента("status");
					ЗаписьХМЛ.ЗаписатьАтрибут("id","8");
					ЗаписьХМЛ.ЗаписатьАтрибут("title","Выполнена");
				ЗаписьХМЛ.ЗаписатьКонецЭлемента();
				ЗаписьХМЛ.ЗаписатьНачалоЭлемента("status");
					ЗаписьХМЛ.ЗаписатьАтрибут("id","9");
					ЗаписьХМЛ.ЗаписатьАтрибут("title","Завершена");
				ЗаписьХМЛ.ЗаписатьКонецЭлемента();
				//Конец цикла на статусы
			ЗаписьХМЛ.ЗаписатьКонецЭлемента();
			
			ЗаписьХМЛ.ЗаписатьНачалоЭлемента("categories");
				ЗаписьХМЛ.ЗаписатьНачалоЭлемента("category");
					ЗаписьХМЛ.ЗаписатьАтрибут("id","");			// Номер категории
					ЗаписьХМЛ.ЗаписатьАтрибут("title","");		//категория
				ЗаписьХМЛ.ЗаписатьКонецЭлемента();
			ЗаписьХМЛ.ЗаписатьКонецЭлемента();
			
			Для каждого ДокументЗаявка Из МассивДокументов Цикл
				Заявка = ДокументЗаявка.Значение;
				
				ЗаписьХМЛ.ЗаписатьНачалоЭлемента("request");
					ЗаписьХМЛ.ЗаписатьАтрибут("id", Заявка.Ссылка); 	//id документа
					ЗаписьХМЛ.ЗаписатьАтрибут("number", Заявка.Номер); 	// Номер документа
					ЗаписьХМЛ.ЗаписатьАтрибут("status", Заявка.Статус); // статус документа
					ЗаписьХМЛ.ЗаписатьАтрибут("category", Заявка.ВидЗаявки); // категория документа
					ЗаписьХМЛ.ЗаписатьАтрибут("title",СтрПолучитьСтроку(Заявка.ТекстЗаявки,1)); // заголовок документа
					ЗаписьХМЛ.ЗаписатьАтрибут("text", Заявка.ТекстЗаявки); // текст заявки
					ЗаписьХМЛ.ЗаписатьАтрибут("date", Формат(Заявка.ВремяУдобноеДляЗаказчика,"ДФ='dd.MM.yyyy ЧЧ.мм.сс'")); //назанченая дата для исполнения
					ЗаписьХМЛ.ЗаписатьАтрибут("controldate", Формат(Заявка.ВремяФактическогоВыполнения,"ДФ='dd.MM.yyyy ЧЧ.мм.сс'")); //фактическая дата исполнения 
					
					ЗаписьХМЛ.ЗаписатьНачалоЭлемента("address");
						ЗаписьХМЛ.ЗаписатьАтрибут("building", Заявка.Здание); //адрес дома
						ЗаписьХМЛ.ЗаписатьАтрибут("flat", Заявка.Квартира); // квартира
					ЗаписьХМЛ.ЗаписатьКонецЭлемента();
					
					ЗаписьХМЛ.ЗаписатьНачалоЭлемента("correspondence");
						ЗаписьХМЛ.ЗаписатьАтрибут("text","текст переписки");
					ЗаписьХМЛ.ЗаписатьКонецЭлемента();

					ЗаписьХМЛ.ЗаписатьАтрибут("fio", Заявка.ОтветственныйВладелец); // ФИО владельца
					ЗаписьХМЛ.ЗаписатьАтрибут("account",Заявка.ЛицевойСчет); // Лицевой счет
					
					ЗаписьХМЛ.ЗаписатьНачалоЭлемента("status");
						ЗаписьХМЛ.ЗаписатьАтрибут("status", Заявка.Статус);
						ЗаписьХМЛ.ЗаписатьАтрибут("date",Формат(Заявка.ДатаПоследнегоИзменения,"ДФ='dd.MM.yyyy ЧЧ.мм.сс'"));
						ЗаписьХМЛ.ЗаписатьАтрибут("user", Заявка.Автор);
						ЗаписьХМЛ.ЗаписатьАтрибут("user_name", Заявка.АвторПоследнегоИзменения);
					ЗаписьХМЛ.ЗаписатьКонецЭлемента();
				ЗаписьХМЛ.ЗаписатьКонецЭлемента();
				
			КонецЦикла; 
		ЗаписьХМЛ.ЗаписатьКонецЭлемента();
	
	ЗаписьХМЛ.ЗаписатьКонецЭлемента();
	ЗаписьХМЛ.Закрыть();
	ЗаписатьПДФ = Новый ЗаписьZipФайла;
	ЗаписатьПДФ.Открыть(Лев(ПутьКаталога, СтрДлина(ПутьКаталога)-1)+".zip",Пароль);
	ЗаписатьПДФ.Добавить(ПутьКаталога);
	ЗаписатьПДФ.Добавить(ИмяФайла);
	ЗаписатьПДФ.Записать();
	УдалитьФайлы(ПутьКаталога);
	УдалитьФайлы(ИмяФайла);
	
	Режим = РежимДиалогаВопрос.ОК;
	Текст = "ru = 'Выгрузка данных в файл окончена!'; uk='Вивантаження даних в файл завершено!'";
	Ответ = Вопрос(НСтр(Текст), Режим, 0);
	
КонецПроцедуры

