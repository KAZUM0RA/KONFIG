// ВСПОМОГАТЕЛЬНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

// Записывает в глобальную переменную СтруктураОтвета информацию об ошибке
//
// Параметры:
//  ИнформацияОбОшибке			- ИнформацияОбОшибке, Строка.
Процедура ЗаписатьИнформациюОбОшибке(ИнформацияОбОшибке)
	
	Если ТипЗнч(ИнформацияОбОшибке) = Тип("ИнформацияОбОшибке") Тогда
		СтрокаОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке);
	Иначе
		СтрокаОшибки = ИнформацияОбОшибке;
	КонецЕсли;
	
	СтруктураОтвета.Отказ 				= Истина;
	СтруктураОтвета.ИнформацияОбОшибке 	= СтрокаОшибки;
	
КонецПроцедуры

// Добавляет к списку исключенных свойств, заданных пользователем, английские синонимы,
// т.к. предопределенные реквизиты в XDTO представляются в виде английских слов.
// Например, Имя - Name
//
// Параметры:
//  ИсключенныеСвойства - Структура - Список исключенных свойств
Процедура ДополнитьИсключенныеСвойстваАнгийскимиСинонимами(ИсключенныеСвойства)
	
	///////////// Набор записей /////////////
	Если ИсключенныеСвойства.НайтиПоЗначению("Период") <> Неопределено Тогда
		ИсключенныеСвойства.Добавить("Period");
	КонецЕсли;
	
	Если ИсключенныеСвойства.НайтиПоЗначению("Активность") <> Неопределено Тогда
		ИсключенныеСвойства.Добавить("Active");
	КонецЕсли;
	
	Если ИсключенныеСвойства.НайтиПоЗначению("Регистратор") <> Неопределено Тогда
		ИсключенныеСвойства.Добавить("Recorder");
	КонецЕсли;
	
	///////////// Справочники /////////////
	Если ИсключенныеСвойства.НайтиПоЗначению("Наименование") <> Неопределено Тогда
		ИсключенныеСвойства.Добавить("Name");
	КонецЕсли;
	
	Если ИсключенныеСвойства.НайтиПоЗначению("Код") <> Неопределено Тогда
		ИсключенныеСвойства.Добавить("Code");
	КонецЕсли;
	
	Если ИсключенныеСвойства.НайтиПоЗначению("ПометкаУдаления") <> Неопределено Тогда
		ИсключенныеСвойства.Добавить("DeletionMark");
	КонецЕсли;
	
	Если ИсключенныеСвойства.НайтиПоЗначению("Владелец") <> Неопределено Тогда
		ИсключенныеСвойства.Добавить("Owner");
	КонецЕсли;
	
	Если ИсключенныеСвойства.НайтиПоЗначению("Ссылка") <> Неопределено Тогда
		ИсключенныеСвойства.Добавить("ref");
	КонецЕсли;
	
	Если ИсключенныеСвойства.НайтиПоЗначению("Родитель") <> Неопределено Тогда
		ИсключенныеСвойства.Добавить("parent");
	КонецЕсли;
	
	Если ИсключенныеСвойства.НайтиПоЗначению("ЭтоГруппа") <> Неопределено Тогда
		ИсключенныеСвойства.Добавить("IsFolder");
	КонецЕсли;
	
	Если ИсключенныеСвойства.НайтиПоЗначению("ИмяПредопределенныхДанных") <> Неопределено Тогда
		ИсключенныеСвойства.Добавить("PredefinedDataName");
	КонецЕсли;

	
	///////////// Документы /////////////
	Если ИсключенныеСвойства.НайтиПоЗначению("Дата") <> Неопределено Тогда
		ИсключенныеСвойства.Добавить("Date");
	КонецЕсли;
	
	Если ИсключенныеСвойства.НайтиПоЗначению("Номер") <> Неопределено Тогда
		ИсключенныеСвойства.Добавить("Number");
	КонецЕсли;
	
	Если ИсключенныеСвойства.НайтиПоЗначению("Проведен") <> Неопределено Тогда
		ИсключенныеСвойства.Добавить("Posted");
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьМенеджер(ТипОбъекта)
	
	ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипОбъекта);
	
	Если ОбъектМетаданных = Неопределено Тогда
		ВызватьИсключение "Не удалось определить объект метаданных, соответствующий нужному тип объекта (" + ТипОбъекта + ").";
	КонецЕсли;
	
	// Объекты, которые есть на мобильной платформе
	Если Метаданные.Справочники.Содержит(ОбъектМетаданных) Тогда
		Возврат Справочники[ОбъектМетаданных.Имя];
		
	ИначеЕсли Метаданные.Документы.Содержит(ОбъектМетаданных) Тогда
		Возврат Документы[ОбъектМетаданных.Имя];
		
	ИначеЕсли Метаданные.РегистрыСведений.Содержит(ОбъектМетаданных) Тогда
		Возврат РегистрыСведений[ОбъектМетаданных.Имя];
		
	ИначеЕсли Метаданные.РегистрыНакопления.Содержит(ОбъектМетаданных) Тогда
		Возврат РегистрыНакопления[ОбъектМетаданных.Имя];
		
	ИначеЕсли Метаданные.Константы.Содержит(ОбъектМетаданных) Тогда
		Возврат Константы[ОбъектМетаданных.Имя];
	
	// Настольная платформа
	ИначеЕсли Метаданные.РегистрыБухгалтерии.Содержит(ОбъектМетаданных) Тогда
		Возврат РегистрыБухгалтерии[ОбъектМетаданных.Имя];
		
	ИначеЕсли Метаданные.РегистрыРасчета.Содержит(ОбъектМетаданных) Тогда
		Возврат РегистрыРасчета[ОбъектМетаданных.Имя];
		
	ИначеЕсли Метаданные.ПланыВидовХарактеристик.Содержит(ОбъектМетаданных) Тогда
		Возврат ПланыВидовХарактеристик[ОбъектМетаданных.Имя];
		
	ИначеЕсли Метаданные.БизнесПроцессы.Содержит(ОбъектМетаданных) Тогда
		Возврат БизнесПроцессы[ОбъектМетаданных.Имя];
		
	ИначеЕсли Метаданные.Задачи.Содержит(ОбъектМетаданных) Тогда
		Возврат Задачи[ОбъектМетаданных.Имя];
		
	ИначеЕсли Метаданные.ПланыСчетов.Содержит(ОбъектМетаданных) Тогда
		Возврат ПланыСчетов[ОбъектМетаданных.Имя];
		
	ИначеЕсли Метаданные.ПланыВидовРасчета.Содержит(ОбъектМетаданных) Тогда
		Возврат ПланыВидовРасчета[ОбъектМетаданных.Имя];
		
	ИначеЕсли Метаданные.ЖурналыДокументов.Содержит(ОбъектМетаданных) Тогда
		Возврат ЖурналыДокументов[ОбъектМетаданных.Имя];

	Иначе
		ВызватьИсключение "Не удалось определить принадлежность объекта к основным типам конфигурации (" + ТипОбъекта.ИмяТипа + ").";
	КонецЕсли;
	
	
КонецФункции

Функция ЭтоСсылочныйТип(Менеджер)
	
	Попытка
		Менеджер.ПустаяСсылка();
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
	Возврат Истина;
	
КонецФункции

Функция ПолучитьОбъектСсылочногоТипа(ОбъектXDTO, ТипОбъекта, Менеджер)
	
	// 1. Получам XDTO-объект этой базы
	ОбъектXDTOЭтойБазы = ПолучитьXDTOОбъектЭтойБазы(ТипОбъекта);
	
	// 2. Получим строку пустых свойств, и исключим их их списка копируемых,
	// чтобы процедура ЗаполнитьЗначениеСвойств отработала верно
	СписокИсключенныхСвойствXDTO = ПолучитьСписокИсключенныхСвойствXDTO(ОбъектXDTO);
	
	// 3. Заполняем полученные объект всеми возможными свойствами из загружаемого объекта
	ЗаполнитьЗначенияСвойств(ОбъектXDTOЭтойБазы, ОбъектXDTO);
	
	// 4. Незаполненные свойства дозаполняем пустыми значениями, чтобы объект смог сериализоваться.
	// Также получам список незаполненных свойств, чтобы в последствии заполнить их из существующего объекта ИБ (если он в ней был)
	СписокСвойств = ДозаполнитьИПолучитьСписокПустыхСвойств(ОбъектXDTOЭтойБазы, ОбъектXDTO, СписокИсключенныхСвойствXDTO, Менеджер);
	
	// 5. Сериализуем загружаемый объект
	ОбъектЭтойБазы = СериализаторXDTO.ПрочитатьXDTO(ОбъектXDTOЭтойБазы);
	
	// 6. Если объект существует в ИБ - заполняем отсутствующие в источнике свойства из ссылки.
	Если НЕ ОбъектЭтойБазы.ЭтоНовый() Тогда
		ЗаполнитьОтсутствующиеСвойстваОбъектаПоСписку(ОбъектЭтойБазы, ОбъектЭтойБазы.Ссылка, СписокСвойств);
	КонецЕсли;
	
	Возврат ОбъектЭтойБазы;
	
КонецФункции

Функция ПолучитьXDTOОбъектЭтойБазы(ТипXML)
	
	ТипXDTO = ФабрикаXDTO.Тип(ТипXML);
	Если ТипXDTO = Неопределено Тогда
		ВызватьИсключение "Не удалось получить нужный тип из фабрики XDTO (" + ТипXML.ИмяТипа + ").";
	КонецЕсли;
	
	Попытка
		ОбъектXDTO = ФабрикаXDTO.Создать(ТипXDTO);
	Исключение
		ВызватьИсключение "Не удалось получить объект XDTO.";
	КонецПопытки;
	
	Возврат ОбъектXDTO;
	
КонецФункции

