
////////////////////////////////////////////////////////////////////////////////
// ВСПОМОГАТЕЛЬНЫЕ ПЕРЕМЕННЫЕ МОДУЛЯ ДЛЯ НАПИСАНИЯ АЛГОРИТМОВ (ОБЩИЕ ДЛЯ ВЫГРУЗКИ И ЗАГРУЗКИ)

Перем НоваяФабрика;				// Фабрика XDTO конфигурации-приемника
Перем НовыйСериализатор;		// Сериализатор XDTO конфигурации-приемника
Перем ПустойУИД;				// Пустой Уникальный идентификатор

Перем ЗаписьXML;				// Предназначена для организации последовательной записи XML
Перем ЧтениеXML;				// Предназначена для организации последовательного чтения XML

Перем СтруктураОтвета;

Перем ИсключенныеСвойства;
Перем ТипУдалениеОбъекта;

Перем ПеременныеИнициализированы;

////////////////////////////////////////////////////////////////////////////////
// ТОЧКИ ВХОДА

// Возвращает сообщение обмена в виде строки
//
// Параметры:
//  Нет
// 
//  Возвращаемое значение:
// Структура, состоящая из 3-х элементов:
// Отказ 				- флаг сообщения об ошибке, 
// ИнформацияОбОшибке 	- текстовая информация об ошибке
// Данные 				- сформированный пакет обмена
Функция СформироватьПакетОбмена() Экспорт
	
	ИнициализацияРеквизитовИМодульныхПеременных();
	
	Если СтруктураОтвета.Отказ Тогда
		Возврат СтруктураОтвета;
	КонецЕсли;
	
	ЗаписьСообщения = ПланыОбмена.СоздатьЗаписьСообщения();
    ЗаписьСообщения.НачатьЗапись(ЗаписьXML, УзелОбмена);					
    
	ЗаписьXML.ЗаписатьСоответствиеПространстваИмен("xsi", "http://www.w3.org/2001/XMLSchema-instance");
	ЗаписьXML.ЗаписатьСоответствиеПространстваИмен("v8",  "http://v8.1c.ru/data");
	ЗаписьXML.ЗаписатьСоответствиеПространстваИмен("xs", "http://www.w3.org/2001/XMLSchema");
    
	ВыборкаИзменений = ПланыОбмена.ВыбратьИзменения(УзелОбмена, ЗаписьСообщения.НомерСообщения);
	Пока ВыборкаИзменений.Следующий() Цикл
		Попытка
			// Записываем данные в сообщение
			Данные = ВыборкаИзменений.Получить();
			ВыгрузитьОбъект(Данные);
		Исключение
			ЗаписатьИнформациюОбОшибке("Ошибка при выгрузке объекта """ + Строка(Данные) + """: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			Возврат СтруктураОтвета;
		КонецПопытки;
    КонецЦикла;
    
	ЗаписьСообщения.ЗакончитьЗапись();
	
	СтруктураОтвета.Данные = ЗаписьXML.Закрыть();
	
	Возврат СтруктураОтвета;
    
КонецФункции

// Читает сообщение обмена, переданное в виде строки
//
// Параметры:
//  ДанныеОбмена - Строка - сообщение обмена в виде строки
//
//  Возвращаемое значение:
// Структура, состоящая из 3-х элементов:
// Отказ 				- флаг сообщения об ошибке, 
// ИнформацияОбОшибке 	- текстовая информация об ошибке
// Данные 				- пустая строка
Функция ПринятьПакетОбмена(ДанныеОбмена) Экспорт
	
	ИнициализацияРеквизитовИМодульныхПеременных();
	
	ЧтениеXML.УстановитьСтроку(ДанныеОбмена);
    ЧтениеСообщения = ПланыОбмена.СоздатьЧтениеСообщения();
	Попытка
		ЧтениеСообщения.НачатьЧтение(ЧтениеXML);
	Исключение
		ЗаписатьИнформациюОбОшибке("Ошибка на сервере при получении данных: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат СтруктураОтвета;
	КонецПопытки;
		
	НачатьТранзакцию();
	
	Попытка
		ПрочитатьСообщениеОбмена(ЧтениеXML, ЧтениеСообщения.Отправитель);
	Исключение
		ЗаписатьИнформациюОбОшибке("Ошибка на сервере при получении данных: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		ОтменитьТранзакцию();
		Возврат СтруктураОтвета;
	КонецПопытки;
	
	ПланыОбмена.УдалитьРегистрациюИзменений(ЧтениеСообщения.Отправитель,ЧтениеСообщения.НомерПринятого);
	
	ЗафиксироватьТранзакцию();
    
    ЧтениеСообщения.ЗакончитьЧтение();
    ЧтениеXML.Закрыть();
	
	Возврат СтруктураОтвета;
    
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// ИНИЦИАЛИЗАЦИЯ

// Инициализирует реквизиты обработки и модульные переменные
//
// Параметры:
//  Нет.
// 
Процедура ИнициализацияРеквизитовИМодульныхПеременных()
	
	Если ПеременныеИнициализированы Тогда
		Возврат;
	КонецЕсли;
	
	// Возвращаемое значение. Содержит либо пакет обмена, либо информацию об ошибке
	СтруктураОтвета 					= Новый Структура("Отказ, ИнформацияОбОшибке, Данные");
	СтруктураОтвета.Отказ 				= Ложь;
	СтруктураОтвета.ИнформацияОбОшибке 	= "";
	СтруктураОтвета.Данные			 	= "";
	
	// Проверка обязательных реквизитов
	Если УзелОбмена.Пустая() Тогда
		ЗаписатьИнформациюОбОшибке("Не указан узел обмена данными.");
		Возврат;
	КонецЕсли;
	
	// Инициализация глобальных переменных модуля
	НоваяФабрика 		= ПолучитьФабрикуXDTO();
	
	Если НоваяФабрика = Неопределено Тогда
		// Информация об ошибке уже записана в структуре ответа, делаем возврат
		Возврат;
	КонецЕсли;
	
	НовыйСериализатор 	= Новый СериализаторXDTO(НоваяФабрика);
	
	ПустойУИД 			= "00000000-0000-0000-0000-000000000000";
	ТипОбъекта			= Тип("УдалениеОбъекта");
	
	ЗаписьXML 			= Новый ЗаписьXML;
	ЗаписьXML.УстановитьСтроку("UTF-8");
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	
	ЧтениеXML 			= Новый ЧтениеXML;
	
	ПеременныеИнициализированы = Истина;
	
КонецПроцедуры

// Получает фабрику XDTO на основании загруженной xsd-схемы из макета плана обмена.
//
// Параметры:
//  Нет.
// Возвращаемое значение:
// Фабрика XDTO
Функция ПолучитьФабрикуXDTO()
	
	// 1. Получаем макет, в котором хранится xsd-схема мобильного приложения
	Попытка
		МакетПравил = ПланыОбмена[УзелОбмена.Метаданные().Имя].ПолучитьМакет("XSDСхемаМобильногоПриложения");
		СхемаXMLСтрокой = МакетПравил.ПолучитьТекст();
	Исключение
		ЗаписатьИнформациюОбОшибке("Для плана обмена не найден макет с xsd-схемой мобильного приложения.");
		Возврат Неопределено;
	КонецПопытки;
	
	// 2. Читаем xsd-схему, используя DOM-модель
	Попытка
		ЧтениеXML = Новый ЧтениеXML;
		ЧтениеXML.УстановитьСтроку(СхемаXMLСтрокой);
		ПостроительDOM = Новый ПостроительDOM;
		ДокументDOM = ПостроительDOM.Прочитать(ЧтениеXML);
	Исключение
		ЗаписатьИнформациюОбОшибке("Ошибка при чтении xsd-схемы мобильного приложения: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Неопределено;
	КонецПопытки;
	
	// 3. Получаем схему xml-документа
	Попытка
		ПостроительСхемыXML = Новый ПостроительСхемXML;
		СхемаXML = ПостроительСхемыXML.СоздатьСхемуXML(ДокументDOM);
		НаборСхемXML = Новый НаборСхемXML;
		НаборСхемXML.Добавить(СхемаXML);
	Исключение
		ЗаписатьИнформациюОбОшибке("Ошибка при создании схемы xml-документа: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Неопределено;
	КонецПопытки;
	
	// 4. Создаем фабрику XDTO на основании прочитанной схемы
	Попытка
		Фабрика = Новый ФабрикаXDTO(НаборСхемXML);
	Исключение
		ЗаписатьИнформациюОбОшибке("Ошибка при создании Фабрики XDTO на основании схемы: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Неопределено;
	КонецПопытки;
	
	Возврат Фабрика;
	
КонецФункции



////////////////////////////////////////////////////////////////////////////////
// ВЫГРУЗКА ДАННЫХ

// Производит выгрузку объекта
//
// Параметры:
//  Данные					 - выгружаемые данные
Процедура ВыгрузитьОбъект(Данные) Экспорт
	
	// Инициализация внутренних переменных этой процедуры
	Отказ = Ложь;
	ИсключенныеСвойства = Новый СписокЗначений;
	
	// 1. Действия перед выгрузкой
	Попытка
		ОбработчикСобытияПередВыгрузкойОбъекта(Данные, Отказ, ИсключенныеСвойства);
	Исключение
		ВызватьИсключение "Ошибка в обработчике ""Перед выгрузкой объекта"": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ДополнитьИсключенныеСвойстваАнгийскимиСинонимами(ИсключенныеСвойства);
	
	// 2. Подготовка к выгрузке
	ОбъектXDTO  	= ПолучитьОбъектXDTO(Данные);
	
	// 3. Выгрузка
	ОбработчикСобытияПриВыгрузкеОбъекта(ОбъектXDTO, Данные, Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	НоваяФабрика.ЗаписатьXML(ЗаписьXML, ОбъектXDTO);
	
	// 4. После выгрузки
	ОбработчикСобытияПослеВыгрузкиОбъекта(Данные);
	
КонецПроцедуры

// Возвращает заполненный объект или значение XDTO, созданный из объекта ИБ
//
// Параметры:
//  Данные				- Произвольные данные
//  ТипXDTO				- Тип объекта, на основании которого требуется создать новую фабрику (не обязательный)
//
// Возвращаемое значение:
// заполненный объект или значение XDTO, созданный на основании полученных данных
Функция ПолучитьОбъектXDTO(Данные, ТипXDTO = Неопределено)
	
	ОбъектXDTO = ПолучитьПустойОбъектXDTO(ТипXDTO, Данные);
	ЗаполнитьСвойстваПриемника(ОбъектXDTO, Данные);
	Возврат ОбъектXDTO;
	
КонецФункции

// Заполняет все возможные свойства приемника - ОбъектXDTO свойствами Источника - Данные
//
// Параметры:
//  ОбъектXDTO						 - Приемник
//  Данные							 - Источник
Процедура ЗаполнитьСвойстваПриемника(ОбъектXDTO, Данные)
	
	Если ТипЗнч(ОбъектXDTO) = Тип("ЗначениеXDTO") Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		СвойстваПриемника = ОбъектXDTO.Свойства();
	Исключение
		Возврат;
	КонецПопытки;
	
	ЭтоРегистр			= ЭтоРегистр(Данные);
	ЭтоОтбор			= ТипЗнч(Данные) = Тип("Отбор");
	ЭтоЭлементОтбора	= ТипЗнч(Данные) = Тип("ЭлементОтбора");
	
	Для Каждого Свойство Из СвойстваПриемника Цикл
		
		Если ИсключенныеСвойства.НайтиПоЗначению(Свойство.Имя) <> Неопределено Тогда
			Продолжить;
		ИначеЕсли ЭтоЭлементОтбора Тогда
			// В отборе "ВидСравнения" всегда "равно", а "ЗначениеС" и "ЗначениеПо" пустые.
			// Если их выгрузить, то объект при загрузке не сериализуется.
			// Также нет смысла выгружать признак "Использование", т.к. он всегда установлен в Истина
			Если Свойство.Имя = "ComparisonType"
				ИЛИ Свойство.Имя = "ValueFrom"
				ИЛИ Свойство.Имя = "ValueTo"
				ИЛИ Свойство.Имя = "Usage" Тогда
				
				Продолжить;
				
			КонецЕсли;
			
			// Если это Период, то необходимо в объект записать англоязычный синоним Period, иначе объект не сериализуется
			Если Свойство.Имя = "Name" И Данные.Имя = "Период" Тогда
				
				ЗначениеСвойства = "Period";
				ЗначениеXDTO = ПолучитьОбъектXDTO(ЗначениеСвойства, Свойство.Тип);
				ОбъектXDTO.Установить(Свойство, ЗначениеXDTO);
				Продолжить;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если ТипЗнч(ОбъектXDTO[Свойство.Имя]) = Тип("СписокXDTO") Тогда // Свойство является коллекцией
			Для Каждого ЗначениеЭлемента Из ?(ЭтоРегистр ИЛИ ЭтоОтбор, Данные, Данные[Свойство.Имя]) Цикл
				ЗначениеXDTO = ПолучитьОбъектXDTO(ЗначениеЭлемента, Свойство.Тип);
				ОбъектXDTO[Свойство.Имя].Добавить(ЗначениеXDTO);
			КонецЦикла;
			Продолжить;
		КонецЕсли;
		
		// 1. Попытаемся получить значение свойства из источника по имени свойства в приемнике.
		// Если неудачно - то такого свойства в источнике нет, присваиваем ему пустое значение.
		Попытка
			ЗначениеСвойства = Данные[Свойство.Имя];
		Исключение
			
			Если Свойство.ВозможноПустое Тогда
				ЗначениеСвойства = Неопределено;
			Иначе
				ЗначениеСвойства = ПолучитьПустойОбъектXDTO(Свойство.Тип);
			КонецЕсли;
			
			Попытка
				ОбъектXDTO.Установить(Свойство, ЗначениеСвойства);
			Исключение
			КонецПопытки;
			
			Продолжить;
			
		КонецПопытки;
		
		// 2. Если полученное значение равно NULL, значит, это выгружается группа
		Если ЗначениеСвойства = NULL Тогда
			ОбъектXDTO.Сбросить(Свойство);
			Продолжить;
		КонецЕсли;
		
		// 3. Присваиваем полученное свойство источника свойству приемника
		Попытка
			ЗначениеXDTO = ПолучитьОбъектXDTO(ЗначениеСвойства, Свойство.Тип);
			ОбъектXDTO.Установить(Свойство, ЗначениеXDTO);
		Исключение
			ВызватьИсключение "Не удалось передать свойство " + Свойство.Имя + " по причине: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

// Возвращает пустой объект XDTO или значение XDTO. Если переданы данные, то созданный Объект XDTO будет заполнен 
//
// Параметры:
//  ТипXDTO				- Тип объекта, на основании которого требуется создать новую фабрику (не обязательный)
//  Данные				- Произвольные данные (не обязательный)
//
// Возвращаемое значение:
// пустой объект XDTO или значение XDTO, созданный на основании полученных данных
Функция ПолучитьПустойОбъектXDTO(Знач ТипXDTO = Неопределено, Знач Данные = Неопределено)
	
	ТипПередан = ТипXDTO <> Неопределено;
	
	Попытка
		
		Если НЕ ТипПередан Тогда
			ТипXDTO = ОпределитьТипXDTO(Данные);
		КонецЕсли;
		
		Если ТипЗнч(ТипXDTO) = Тип("ТипОбъектаXDTO") Тогда
			Данные = Неопределено;
		ИначеЕсли Данные = Неопределено Тогда
			Данные = ПолучитьПустоеЗначениеПоТипуXDTO(ТипXDTO);
		КонецЕсли;
		
		Попытка
			ОбъектXDTO = НоваяФабрика.Создать(ТипXDTO, Данные);
		Исключение
			Если ТипПередан Тогда
				// Возможно передан неверный тип. Определим тип самостоятельно,
				// и попытаемся создать объект XDTO на основании нашего типа
				ТипXDTO = ОпределитьТипXDTO(Данные);
				ОбъектXDTO = НоваяФабрика.Создать(ТипXDTO, Данные);
			Иначе
				ВызватьИсключение КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			КонецЕсли;
		КонецПопытки;
		
	Исключение
		ВызватьИсключение "Не удалось создать пустой объект XDTO для " + Строка(Данные) + " по причине: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
	Возврат ОбъектXDTO;
	
КонецФункции

// Возвращает тип объекта XDTO или тип значения XDTO для переданного объекта
//
// Параметры:
//  Данные				- Произвольные данные
//
// Возвращаемое значение:
// Тип объекта XDTO или Тип значения XDTO
Функция ОпределитьТипXDTO(Данные)
	
	ТипДанныхXML 	= НовыйСериализатор.XMLТипЗнч(Данные);
	Если ТипДанныхXML = Неопределено Тогда
		ВызватьИсключение "Не удалось определить тип XML для " + Строка(Данные) + ".";
	КонецЕсли;
	
	ТипXDTO = НоваяФабрика.Тип(ТипДанныхXML);
	Если ТипXDTO = Неопределено Тогда
		ВызватьИсключение "Не удалось определить тип XDTO для " + Строка(Данные) + ". Имя типа данных XML: " + ТипДанныхXML.ИмяТипа;
	КонецЕсли;
	
	Возврат ТипXDTO;
	
КонецФункции

// Возвращает пустое значение, соответствующее типу XDTO
//
// Параметры:
//  ТипXDTO				- Тип XDTO
//
// Возвращаемое значение:
// Пустое значение с типом Строка, Число, Булево, Дата, либо пустой УИД
Функция ПолучитьПустоеЗначениеПоТипуXDTO(ТипXDTO)
	
	// Возвращаемое значение
	Перем ПустоеЗначение;
	
	ПустоеЗначение = ПолучитьПустоеЗначениеПоИмениТипа(ТипXDTO.Имя);
	
	Если ПустоеЗначение = Неопределено Тогда
		ПустоеЗначение = ПолучитьПустоеЗначениеПоИмениТипа(ТипXDTO.БазовыйТип.Имя);
	КонецЕсли;
	
	Возврат ПустоеЗначение;

КонецФункции

// Возвращает пустое значение, соответствующее имени типа
//
// Параметры:
//  ИмяТипа				- Имя типа
//
// Возвращаемое значение:
// Пустое значение с типом Строка, Число, Булево, Дата, либо пустой УИД
Функция ПолучитьПустоеЗначениеПоИмениТипа(ИмяТипа)
	
	// Возвращаемое значение
	ПустоеЗначение = Неопределено;
	
	// Если это ссылочный тип, то присваиваем выгружаемому значению пустую ссылку
	Если ИмяТипа = "AnyRef"
		Или ИмяТипа = "UUID" Тогда
		
		ПустоеЗначение = ПустойУИД;
		
	// Если это простой тип, то присваиваем значение напрямую
	ИначеЕсли ИмяТипа = "string" Тогда
		
		ПустоеЗначение = "";
		
	ИначеЕсли ИмяТипа = "boolean" Тогда
		
		ПустоеЗначение = Ложь;
		
	ИначеЕсли ИмяТипа = "dateTime" Тогда
		
		ПустоеЗначение = Дата("00010101");
		
	ИначеЕсли ИмяТипа = "decimal" Тогда
		
		ПустоеЗначение = 0;
		
	ИначеЕсли ИмяТипа = "ValueStorage" Тогда
		
		ПустоеЗначение = Новый ХранилищеЗначения(Неопределено);
		
	Иначе
		
		// Какой-то неизвестный тип
		ПустоеЗначение = Неопределено;
		
	КонецЕсли;
	
	Возврат ПустоеЗначение;

КонецФункции


////////////////////////////////////////////////////////////////////////////////
// ЗАГРУЗКА ДАННЫХ

Процедура ПрочитатьСообщениеОбмена(ЧтениеXML, Отправитель)
	
	Отказ = Ложь;
	
	Пока НовыйСериализатор.ВозможностьЧтенияXML(ЧтениеXML) Цикл
		
		ТипОбъектаXML = ПолучитьXMLТип(ЧтениеXML);
		
		// Попытаемся получить Тип, соответствущий этой ИБ
		ТипОбъекта = СериализаторXDTO.ИзXMLТипа(ТипОбъектаXML);
		
		Если ТипОбъекта = Неопределено Тогда
			// Неизвестный тип. Выходим
			ВызватьИсключение "Не удалось определить тип объекта (" + ТипОбъекта.ИмяТипа + ").";
		КонецЕсли;
		
		Если ТипОбъекта = ТипУдалениеОбъекта Тогда
			//ОтработатьУдалениеОбъекта(Данные);
			Продолжить;
		КонецЕсли;
		
		Менеджер = ПолучитьМенеджер(ТипОбъекта);
		
		Попытка
			Данные = НоваяФабрика.ПрочитатьXML(ЧтениеXML);
		Исключение
			ВызватьИсключение "Не удалось прочитать объект; скорее всего, xsd-схема мобильного приложения устарела. Информация об ошибке: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
		
		Если ЭтоСсылочныйТип(Менеджер) Тогда
			ОбъектЭтойБазы = ПолучитьОбъектСсылочногоТипа(Данные, ТипОбъектаXML, Менеджер);
			ОбработчикСобытияПередЗаписьюОбъектаСсылочногоТипа(ОбъектЭтойБазы, Отказ);
			Если НЕ Отказ Тогда
				ЗаписатьОбъектВИБ(ОбъектЭтойБазы, Отправитель);
			КонецЕсли;
		Иначе
			НаборЗаписей = ПолучитьОбъектРегистр(Данные, ТипОбъектаXML, Менеджер);
			ОбработчикСобытияПередЗаписьюРегистра(НаборЗаписей, Отправитель, Отказ);
			Если НЕ Отказ Тогда
				ЗаписатьОбъектВИБ(НаборЗаписей, Отправитель);
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

