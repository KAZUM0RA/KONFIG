Процедура ОбработчикСобытияПередВыгрузкойОбъекта(Объект, Отказ, ИсключенныеСвойства)
	
	ТипОбъекта = ТипЗнч(Объект);
	
	Если ТипОбъекта = Тип("РегистрСведенийНаборЗаписей.ЗаданияНаСнятиеПоказанийПриборовУчета") Тогда
		
		ИсключенныеСвойства.Добавить("Регистратор"); // Дозаполним в обработчике "После отправки объекта"
		
		// Обработаем ситуацию, когда в документе поменяли исполнителя
		Если Объект.Количество() > 0 И Объект[0].Исполнитель <> УзелОбмена Тогда
			Отказ = Истина;
			// За компанию отправим инфу об очистке записей регистра
			УдаляемыйНабор = РегистрыСведений.ЗаданияНаСнятиеПоказанийПриборовУчета.СоздатьНаборЗаписей();
			УдаляемыйНабор.Отбор.Регистратор.Установить(Объект.Отбор.Регистратор.Значение);
			ВыгрузитьОбъект(УдаляемыйНабор);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработчикСобытияПриВыгрузкеОбъекта(ОбъектXDTO, Объект, Отказ)
	
	ТипОбъекта = ТипЗнч(Объект);
	
	Если ТипОбъекта = Тип("СправочникОбъект.ЗданияИСооружения") Тогда
		
		// Сформируем адрес для мобильного устройства вида <Улица>, <Дом>
		// Например, Дерибасовская, 22
		СтруктураПоиска = Новый Структура("Вид", Справочники.ВидыКонтактнойИнформации.ПочтовыйАдресЗданияИСооружения);
		НайденныеСтроки = Объект.КонтактнаяИнформация.НайтиСтроки(СтруктураПоиска);
		Если НайденныеСтроки.Количество() > 0 Тогда
			СписокПолей = УправлениеКонтактнойИнформацией.ПреобразоватьСтрокуВСписокПолей(НайденныеСтроки[0].ЗначенияПолей);
			МассивДомУлица = Новый Массив(2);
			Для Каждого Поле Из СписокПолей Цикл
				Если Поле.Представление = "Улица" Тогда
					МассивДомУлица[0] = Поле.Значение;
				ИначеЕсли Поле.Представление = "Дом" Тогда
					МассивДомУлица[1] = Поле.Значение;
				КонецЕсли;
			КонецЦикла;
			Если ЗначениеЗаполнено(МассивДомУлица[0]) И ЗначениеЗаполнено(МассивДомУлица[1]) Тогда
				ОбъектXDTO.Description = МассивДомУлица[0] + ", " + МассивДомУлица[1];
				
				// Попытаемся определить номер дома
				НомерЗдания = 0;
				Попытка
					НомерЗдания = Число(МассивДомУлица[1]);
				Исключение
					// Номер может храниться в формате "22ж" - попробуем выделить цифры из номера
					НомерСтрокой = "";
					Для Счетчик = 1 По СтрДлина(МассивДомУлица[1]) Цикл
						Символ = Сред(МассивДомУлица[1], Счетчик, 1);
						Если КодСимвола(Символ) >= 48 И КодСимвола(Символ) <= 57 Тогда
							НомерСтрокой = НомерСтрокой + Символ;
						КонецЕсли;
					КонецЦикла;
					Если НомерСтрокой <> 0 Тогда
						Попытка
							НомерЗдания = Число(НомерСтрокой);
						Исключение
						КонецПопытки;
					КонецЕсли;
				КонецПопытки;
				
				ОбъектXDTO.НомерЗдания = НомерЗдания;
			Иначе
				ОбъектXDTO.Description = Объект.Наименование;
				ОбъектXDTO.НомерЗдания = 0;
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли ТипОбъекта = Тип("СправочникОбъект.ОбъектыЛицевыхСчетов") Тогда
		
		ОбъектXDTO.Description = "Квартира " + Объект.Код + Объект.Суффикс;
		
		// Получение ФИО владельца лицевого счета
		
		// Для начала получим ссылку на лицевой счет
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		               |	ЛицевыеСчета.Ссылка
		               |ПОМЕСТИТЬ ВтСчет
		               |ИЗ
		               |	Справочник.ЛицевыеСчета КАК ЛицевыеСчета
		               |ГДЕ
		               |	ЛицевыеСчета.ОбъектЛицевогоСчета = &ОбъектЛицевогоСчета
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ОтветственныйВладелец.Наименование КАК ФИО,
		               |	ОтветственныйВладелецЛицевогоСчетаСрезПоследних.ЛицевойСчет.Наименование КАК НомерСчета
		               |ИЗ
		               |	РегистрСведений.ОтветственныйВладелецЛицевогоСчета.СрезПоследних(
		               |			&Период,
		               |			ЛицевойСчет В
		               |				(ВЫБРАТЬ
		               |					ВтСчет.Ссылка
		               |				ИЗ
		               |					ВтСчет КАК ВтСчет)) КАК ОтветственныйВладелецЛицевогоСчетаСрезПоследних";
					   
		Запрос.УстановитьПараметр("ОбъектЛицевогоСчета", Объект.Ссылка);
		Запрос.УстановитьПараметр("Период", ТекущаяДата());
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ОбъектXDTO.ВладелецЛицевогоСчета = Выборка.ФИО;
			ОбъектXDTO.НомерСчета = Выборка.НомерСчета;
		Иначе
			ОбъектXDTO.ВладелецЛицевогоСчета = "Аноним"; // Не оставлять же владельца пустым
			ОбъектXDTO.НомерСчета = "";
		КонецЕсли;
		
	ИначеЕсли ТипОбъекта = Тип("СправочникОбъект.ПриборыУчета") Тогда
		
		Если ЗначениеЗаполнено(Объект.Услуга) И ЗначениеЗаполнено(Объект.Услуга.ВидУслуги) Тогда
			ОбъектXDTO.ВидУслуги = Объект.Услуга.ВидУслуги.Наименование;
		Иначе
			ОбъектXDTO.ВидУслуги = "Неизвестный счетчик";
		КонецЕсли;
		
	ИначеЕсли ТипОбъекта = Тип("РегистрСведенийНаборЗаписей.ЗаданияНаСнятиеПоказанийПриборовУчета") Тогда
		
		Регистратор = Объект.Отбор[0].Значение;
		ТипСлужебныйРегистратор = НоваяФабрика.Тип("http://v8.1c.ru/8.1/data/enterprise/current-config", "DocumentRef.Служебный_РегистраторДляРегистра");
		ОбъектСлужебныйРегистратор = НоваяФабрика.Создать(ТипСлужебныйРегистратор, Регистратор.УникальныйИдентификатор());
		
		// Заполним отбор
		ОтборОбъектXDTO = НоваяФабрика.Создать(ОбъектXDTO.Свойства().Получить("filter").Тип);
		ЭлементОтбораXDTO = НоваяФабрика.Создать(ОтборОбъектXDTO.Свойства().Получить("filteritem").Тип);
		ЭлементОтбораXDTO.Name = "Recorder";
		ЭлементОтбораXDTO.Установить("Value", ОбъектСлужебныйРегистратор);
		ОтборОбъектXDTO.Filteritem.Добавить(ЭлементОтбораXDTO);
		ОбъектXDTO.Установить("Filter", ОтборОбъектXDTO);
		
		// Дозаполним набор записей
		Для Каждого ЗаписьXDTO Из ОбъектXDTO.Record Цикл
			ЗаписьXDTO.Установить("Recorder", ОбъектСлужебныйРегистратор);
		КонецЦикла;
		
		Если ОбъектXDTO.Record.Количество() > 0 Тогда
			ТипСлужебныйРегистратор = НоваяФабрика.Тип("http://v8.1c.ru/8.1/data/enterprise/current-config", "DocumentObject.Служебный_РегистраторДляРегистра");
			ОбъектСлужебныйРегистратор = НоваяФабрика.Создать(ТипСлужебныйРегистратор);
			ОбъектСлужебныйРегистратор.Ref = Регистратор.УникальныйИдентификатор();
			ОбъектСлужебныйРегистратор.Установить("Date", Регистратор.Дата);
			ОбъектСлужебныйРегистратор.Установить("Posted", Ложь);
			ОбъектСлужебныйРегистратор.Установить("DeletionMark", Ложь);
			НоваяФабрика.ЗаписатьXML(ЗаписьXML, ОбъектСлужебныйРегистратор);
		Иначе
			// Отправляем удаление документа
			ТипУдалениеОбъекта = НоваяФабрика.Тип("http://v8.1c.ru/8.1/data/enterprise", "ObjectDeletion");
			ОбъектУдалениеОбъекта = НоваяФабрика.Создать(ТипУдалениеОбъекта);
			ОбъектУдалениеОбъекта.Установить("Ref", ОбъектСлужебныйРегистратор);
			НоваяФабрика.ЗаписатьXML(ЗаписьXML, ОбъектУдалениеОбъекта);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработчикСобытияПослеВыгрузкиОбъекта(Объект)
	
	ТипОбъекта = ТипЗнч(Объект);
	
	Если ТипОбъекта = Тип("РегистрСведенийНаборЗаписей.ЗаданияНаСнятиеПоказанийПриборовУчета") И Объект.Количество() > 0 Тогда
		
		// Вручную выгружаем справочники, которые есть в записях
		// Выгружаем дом
		ВыгрузитьОбъект(Объект[0].Здание.ПолучитьОбъект());
		
		// Выгружаем квартиры и счетчики
		// Для квартир будем использовать кэш, т.к. у одной квартиры может быть несколько счетчиков
		КэшКвартир = Новый Соответствие;
		Для Каждого Запись Из Объект Цикл
			КлючВыгружаемыхДанных = ЗначениеВСтрокуВнутр(Запись.ОбъектЛицевогоСчета);
			Если КэшКвартир[КлючВыгружаемыхДанных] = Неопределено Тогда
				ВыгрузитьОбъект(Запись.ОбъектЛицевогоСчета.ПолучитьОбъект());
				КэшКвартир.Вставить(КлючВыгружаемыхДанных, Запись.ОбъектЛицевогоСчета);
			КонецЕсли;
			
			// Счетчик
			ВыгрузитьОбъект(Запись.ПриборУчета.ПолучитьОбъект());
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработчикСобытияПередЗаписьюОбъектаСсылочногоТипа(Объект, Отказ)
	
	
	
КонецПроцедуры

Процедура ОбработчикСобытияПередЗаписьюРегистра(ОбъектЭтойБазы, Отправитель, Отказ)
	
	Для Каждого Запись Из ОбъектЭтойБазы Цикл
		Запись.Исполнитель = Отправитель;
	КонецЦикла;
	
КонецПроцедуры

ПеременныеИнициализированы = Ложь;