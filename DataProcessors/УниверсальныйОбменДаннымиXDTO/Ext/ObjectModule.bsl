Функция ДозаполнитьИПолучитьСписокПустыхСвойств(ОбъектXDTOЭтойБазы, ОбъектXDTO, СписокИсключенныхСвойствXDTO, Менеджер)
	
	// Возвращаемое значение
	СписокПустыхСвойств = Новый СписокЗначений;
	
	ЭтоГруппа = ОбъектXDTO.Получить("IsFolder");
		
	Если ЭтоГруппа = "true" Тогда
		ЭтоГруппа = Истина;
	Иначе
		ЭтоГруппа = Ложь;
	КонецЕсли;
	
	Если ЭтоГруппа Тогда
		ПустойОбъектЭтойБазы = Менеджер.СоздатьГруппу();
		ВызватьИсключение "!";
	Иначе
		ПустойОбъектЭтойБазы = Менеджер.СоздатьЭлемент();
	КонецЕсли;
	
	Для Каждого Свойство Из ОбъектXDTOЭтойБазы.Свойства() Цикл
		Если ОбъектXDTOЭтойБазы.Получить(Свойство) = Неопределено
			И ПустойОбъектЭтойБазы[Свойство.Имя] <> NULL
			И СписокИсключенныхСвойствXDTO.НайтиПоЗначению(Свойство.Имя) = Неопределено Тогда
			СписокПустыхСвойств.Добавить(Свойство.Имя);
			ОбъектXDTOЭтойБазы[Свойство.Имя] = ПустойОбъектЭтойБазы[Свойство.Имя];
		КонецЕсли;
	КонецЦикла;
	
	Возврат СписокПустыхСвойств;
	
КонецФункции

Процедура ЗаполнитьОтсутствующиеСвойстваОбъектаПоСписку(Приемник, Источник, СписокСвойств)
	
	Для Каждого Свойство Из СписокСвойств Цикл
		Приемник[Свойство.Значение] = Источник[Свойство.Значение];
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаписатьОбъектВИБ(ОбъектЭтойБазы, Отправитель)
	
	Попытка
		УстановитьПризнакОбменаДанными(ОбъектЭтойБазы, Отправитель);
		ОбъектЭтойБазы.Записать();
	Исключение
		ВызватьИсключение "Не удалось записать объект: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;	
	
КонецПроцедуры

Функция ПолучитьОбъектРегистр(ОбъектXDTO, ТипОбъекта, Менеджер)
	
	// 1. Получам XDTO-объект этой базы
	ОбъектXDTOЭтойБазы = ПолучитьXDTOОбъектЭтойБазы(ТипОбъекта);
	
	// 2. Читаем отбор
	СвойствоОтбор = ОбъектXDTOЭтойБазы.Свойства().Получить("filter");
	ОбъектОтбор = ФабрикаXDTO.Создать(СвойствоОтбор.Тип);
	СвойствоЭлементОтбора = СвойствоОтбор.Тип.Свойства.Получить("filteritem");
	Для Каждого ЭлементОтбора Из ОбъектXDTO.filter.filteritem Цикл
		ОбъектЭлементОтбора = ФабрикаXDTO.Создать(СвойствоЭлементОтбора.Тип);
		Для Каждого Свойство Из ЭлементОтбора.Свойства() Цикл
			Попытка
				ОбъектЭлементОтбора[Свойство.Имя] = ЭлементОтбора[Свойство.Имя];
			Исключение
				ТипXML = СериализаторXDTO.XMLТипЗнч(ЭлементОтбора[Свойство.Имя]);
				ТипXDTO = ФабрикаXDTO.Тип(ТипXML.URIПространстваИмен, ТипXML.ИмяТипа);
				ЗначениеXDTO = ФабрикаXDTO.Создать(ТипXDTO, ЭлементОтбора[Свойство.Имя]);
				ОбъектЭлементОтбора[Свойство.Имя] = ЗначениеXDTO;
			КонецПопытки;
		КонецЦикла;
		ОбъектОтбор.filteritem.Добавить(ОбъектЭлементОтбора);
	КонецЦикла;
	
	ОбъектXDTOЭтойБазы.Установить(СвойствоОтбор, ОбъектОтбор);
	
	// 3. Читаем набор записей
	Если ОбъектXDTO.Свойства().Получить("Record") <> Неопределено Тогда // Самих записей может и не быть
		СвойствоЗапись = ОбъектXDTOЭтойБазы.Свойства().Получить("Record");
		ОбъектЗапись = ФабрикаXDTO.Создать(СвойствоЗапись.Тип);
		Для Каждого Свойство Из ОбъектXDTO.record.Свойства() Цикл
			Попытка
				ОбъектЗапись[Свойство.Имя] = ОбъектXDTO.record[Свойство.Имя];
			Исключение
				ТипXML = СериализаторXDTO.XMLТипЗнч(ОбъектXDTO.record[Свойство.Имя]);
				ТипXDTO = ФабрикаXDTO.Тип(ТипXML.URIПространстваИмен, ТипXML.ИмяТипа);
				ЗначениеXDTO = ФабрикаXDTO.Создать(ТипXDTO, ОбъектXDTO.record[Свойство.Имя]);
				ОбъектЗапись[Свойство.Имя] = ЗначениеXDTO;
			КонецПопытки;
		КонецЦикла;
		ОбъектXDTOЭтойБазы.record.Добавить(ОбъектЗапись);
	КонецЕсли;
	
	// 4. Незаполненные свойства дозаполняем пустыми значениями, чтобы объект смог сериализоваться.
	ДозаполнитьПустыеСвойстваРегистра(ОбъектXDTOЭтойБазы, ОбъектXDTO, Менеджер);
	
	// 5. Сериализуем загружаемый объект
	ОбъектЭтойБазы = СериализаторXDTO.ПрочитатьXDTO(ОбъектXDTOЭтойБазы);
	
	Возврат ОбъектЭтойБазы;
	
КонецФункции

Процедура ДозаполнитьПустыеСвойстваРегистра(ОбъектXDTOЭтойБазы, ОбъектXDTO, Менеджер)
	
	ПустойМенеджерЭтойБазы = Менеджер.СоздатьМенеджерЗаписи();
	
	Если ОбъектXDTOЭтойБазы.record.Количество() > 0 Тогда
	
		Для Каждого Свойство Из ОбъектXDTOЭтойБазы.record[0].Свойства() Цикл
			
			Если ОбъектXDTOЭтойБазы.record[0].Получить(Свойство) = Неопределено Тогда
				
				Для Каждого Запись Из ОбъектXDTOЭтойБазы.record Цикл
					Запись[Свойство.Имя] = ПустойМенеджерЭтойБазы[Свойство.Имя];
				КонецЦикла;
				
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура УстановитьПризнакОбменаДанными(Объект, Отправитель)
	
	Попытка
		Объект.ОбменДанными.Загрузка = Истина;
		Объект.ОбменДанными.Отправитель = Отправитель;
	Исключение
	КонецПопытки;
	
КонецПроцедуры

