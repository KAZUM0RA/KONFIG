		ДокОтменаУслуг.Автор = ПараметрыСеанса.ТекущийПользователь;
		ДокОтменаУслуг.Дата = Объект.НаДату;
		ДокОтменаУслуг.ДатаОкончания = Объект.НаДату;
		ДокОтменаУслуг.Здание = ЛС.Владелец;
		ДокОтменаУслуг.Организация = Объект.Организация;
		НовЛС = ДокОтменаУслуг.ЛицевыеСчета.Добавить();
		НовЛС.ЛицевойСчет = ЛС;
		Для Каждого стрУслуги Из НазначенныеУслуги Цикл
			НовСтрока = ДокОтменаУслуг.Услуги.Добавить();
			НовСтрока.Услуга = стрУслуги.Услуга;
		КонецЦикла;
