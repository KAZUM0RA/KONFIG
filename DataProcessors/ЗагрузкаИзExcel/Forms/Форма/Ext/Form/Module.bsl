//ГРУППА СОЗДАНИЯ ЭЛЕМЕНТОВ

&НаСервере
Процедура СоздатьЗдание()
	
	СообщениеОбОшибке = ПроверитьЗаполнениеРеквизитов("Здания");
	Если СообщениеОбОшибке <> "" Тогда
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru='Элементы справочника не удалось создать.';uk='Елементи довідника не вдалося створити.'")+СообщениеОбОшибке;
		Сообщение.Сообщить();
		Возврат;
		
