//ГРУППА ПРОВЕРКА УНИКАЛЬНОСТИ

&НаСервере
Процедура ПроверитьУникальность(МестоВызова)
	
	Если МестоВызова = "Здания" Тогда
		Таблица = Объект.ТаблицаЗданий;
	ИначеЕсли МестоВызова = "ОбъектыЛС" Тогда
		Таблица = Объект.ТаблицаОбъектовЛС;
    ИначеЕсли МестоВызова = "ФизЛица" Тогда
		Таблица = Объект.ТаблицаФизЛиц;
    ИначеЕсли МестоВызова = "ЛицевыеСчета" Тогда
		Таблица = Объект.ТаблицаЛицевыхСчетов;
	ИначеЕсли МестоВызова = "ПриборыУчета" Тогда
		Таблица = Объект.ТаблицаПриборовУчета;
    ИначеЕсли МестоВызова = "НачальныеОстатки" Тогда
		Таблица = Объект.ТаблицаНачальныхОстатков;
	КонецЕсли;
	
	Выборка = ПолучитьВыборкуДляПроверки(МестоВызова);
	Если Выборка = Ложь Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Строка из Таблица Цикл
		
		Если Выборка.Количество() = 0 Тогда
			Строка.Уникальность = Истина;
			Строка.Загружать = Истина;
		КонецЕсли;
		
		Выборка.Сбросить();
		
		Пока Выборка.Следующий() Цикл
			Если МестоВызова = "Здания" Тогда
				Если ПолучитьНаименованиеЗдания(Строка) = Выборка.Наименование Тогда
					Строка.Уникальность = Ложь;
					Строка.Загружать = Ложь;
					Прервать;
				КонецЕсли;
			ИначеЕсли МестоВызова = "ОбъектыЛС" Тогда
				Если Строка.НомерКвартиры = Строка(Выборка.Код) 
					И Строка.Суффикс = Выборка.Суффикс Тогда
					Строка.Уникальность = Ложь;
					Строка.Загружать = Ложь;
					Прервать;
				КонецЕсли;
			ИначеЕсли МестоВызова = "ФизЛица" Тогда
				Если Строка.ИНН = Выборка.ИНН Тогда
					Строка.Уникальность = Ложь;
					Строка.Загружать = Ложь;
					Прервать;
				ИначеЕсли Строка.ФИО = Выборка.Наименование 
					И Строка.ДатаРождения = Выборка.ДатаРождения Тогда
					Строка.Уникальность = Ложь;
					Строка.Загружать = Ложь;
					Прервать;
				КонецЕсли;
			ИначеЕсли МестоВызова = "ЛицевыеСчета" Тогда
				Если Строка.ОбъектЛицевогоСчета = Выборка.ОбъектЛицевогоСчета Тогда
					Строка.Уникальность = Ложь;
					Строка.Загружать = Ложь;
					Прервать;
				КонецЕсли;
			ИначеЕсли МестоВызова = "ПриборыУчета" Тогда
				Если Строка.ЗаводскойНомер = Выборка.ЗаводскойНомер Тогда
					Строка.Уникальность = Ложь;
					Строка.Загружать = Ложь;
					Прервать;
				КонецЕсли;
			ИначеЕсли МестоВызова = "НачальныеОстатки" Тогда
				Если Строка.ЛицевойСчет = Выборка.ЛицевойСчет 
					И Строка.Услуга = Выборка.Услуга 
					И Строка.МесяцНачисления = Выборка.МесяцНачисления Тогда
					Строка.Уникальность = Ложь;
					Строка.Загружать = Ложь;
					Прервать;
				КонецЕсли;
			КонецЕсли;
			Строка.Уникальность = Истина;
			Строка.Загружать = Истина;
		КонецЦикла;
				
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьВыборкуДляПроверки(МестоВызова)
	
	Попытка
		Если МестоВызова = "Здания" Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	ЗданияИСооруженияКонтактнаяИнформация.Ссылка,
			|	ЗданияИСооруженияКонтактнаяИнформация.Ссылка.Наименование КАК Наименование
			|ИЗ
			|	Справочник.ЗданияИСооружения.КонтактнаяИнформация КАК ЗданияИСооруженияКонтактнаяИнформация
			|ГДЕ
			|	ЗданияИСооруженияКонтактнаяИнформация.Ссылка.Организация = &Организация";
			
			Запрос.УстановитьПараметр("Организация", Объект.Организация);
			
		ИначеЕсли МестоВызова = "ОбъектыЛС" Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	ОбъектыЛицевыхСчетов.Ссылка,
			|	ОбъектыЛицевыхСчетов.Код,
			|	ОбъектыЛицевыхСчетов.Суффикс
			|ИЗ
			|	Справочник.ОбъектыЛицевыхСчетов КАК ОбъектыЛицевыхСчетов
			|ГДЕ
			|	ОбъектыЛицевыхСчетов.Владелец = &Владелец";
			
			Запрос.УстановитьПараметр("Владелец", Здание);
			
		ИначеЕсли МестоВызова = "ФизЛица" Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	ФизическиеЛица.Ссылка,
			|	ФизическиеЛица.ИНН,
			|	ФизическиеЛица.Наименование,
			|	ФизическиеЛица.ДатаРождения
			|ИЗ
			|	Справочник.ФизическиеЛица КАК ФизическиеЛица";
						
		ИначеЕсли МестоВызова = "ЛицевыеСчета" Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	ЛицевыеСчета.Ссылка,
			|	ЛицевыеСчета.ОбъектЛицевогоСчета
			|ИЗ
			|	Справочник.ЛицевыеСчета КАК ЛицевыеСчета
			|ГДЕ
			|	ЛицевыеСчета.Владелец = &Владелец";
			
			Запрос.УстановитьПараметр("Владелец", Здание);
			
		ИначеЕсли МестоВызова = "ПриборыУчета" Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	ПриборыУчета.Ссылка,
			|	ПриборыУчета.ЗаводскойНомер
			|ИЗ
			|	Справочник.ПриборыУчета КАК ПриборыУчета";

		ИначеЕсли МестоВызова = "НачальныеОстатки" Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	ВводНачальныхОстатковЛицевыеСчета.Ссылка.Ссылка КАК Ссылка,
			|	ВводНачальныхОстатковЛицевыеСчета.ЛицевойСчет КАК ЛицевойСчет,
			|	ВводНачальныхОстатковЛицевыеСчета.Услуга КАК Услуга,
			|	ВводНачальныхОстатковЛицевыеСчета.МесяцНачисления КАК МесяцНачисления
			|ИЗ
			|	Документ.ВводНачальныхОстатков.ЛицевыеСчета КАК ВводНачальныхОстатковЛицевыеСчета
			|ГДЕ
			|	ВводНачальныхОстатковЛицевыеСчета.Здание = &Здание";
			
			Запрос.УстановитьПараметр("Здание", Здание);
			
		КонецЕсли;
		
		Результат = Запрос.Выполнить();
		
		Выборка = Результат.Выбрать();
				
		Возврат Выборка;
	Исключение
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Табличный документ заполнен не правильно.";
		Сообщение.Сообщить();
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

