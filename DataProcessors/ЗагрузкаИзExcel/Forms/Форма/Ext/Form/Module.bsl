&НаСервере
Процедура ЗаписатьПлощадиЗдания(Сооружение, Строка)
	
	НаборВидыПлощадей = РегистрыСведений.ПлощадьЗданий.СоздатьНаборЗаписей();
	
	Если Строка.ЖилаяПлощадь <> 0 тогда
		
		НаборВидыПлощадей.Отбор.Здание.Установить(Сооружение);
		НаборВидыПлощадей.Отбор.ВидПлощади.Установить(Справочники.ВидыПлощадей.ЖилаяПолощадь);
		
		НаборВидыПлощадей.Прочитать();
		
		НоваяПлощадь = НаборВидыПлощадей.Добавить();
		НоваяПлощадь.Здание = Сооружение;
		НоваяПлощадь.ВидПлощади = Справочники.ВидыПлощадей.ЖилаяПолощадь;
		
		НоваяПлощадь.Площадь =  Строка.ЖилаяПлощадь;
		НаборВидыПлощадей.Записать();
		
	КонецЕсли;
	
	Если Строка.ОбщаяПлощадь <> 0 тогда
		
		НаборВидыПлощадей.Отбор.Здание.Установить(Сооружение);
		НаборВидыПлощадей.Отбор.ВидПлощади.Установить(Справочники.ВидыПлощадей.ОбщаяПлощадь);
		
		НаборВидыПлощадей.Прочитать();
		
		НоваяПлощадь = НаборВидыПлощадей.Добавить();
		НоваяПлощадь.Здание = Сооружение;
		НоваяПлощадь.ВидПлощади = Справочники.ВидыПлощадей.ОбщаяПлощадь;
		
		НоваяПлощадь.Площадь =  Строка.ОбщаяПлощадь;
		НаборВидыПлощадей.Записать();
		
	КонецЕсли;
	
	Если Строка.ОтапливаемаяПлощадь <> 0 тогда
		
		НаборВидыПлощадей.Отбор.Здание.Установить(Сооружение);
		НаборВидыПлощадей.Отбор.ВидПлощади.Установить(Справочники.ВидыПлощадей.ОтапливаемаяПлощадь);
		
		НаборВидыПлощадей.Прочитать();
		
		НоваяПлощадь = НаборВидыПлощадей.Добавить();
		НоваяПлощадь.Здание = Сооружение;
		НоваяПлощадь.ВидПлощади = Справочники.ВидыПлощадей.ОтапливаемаяПлощадь;
		
		НоваяПлощадь.Площадь =  Строка.ОтапливаемаяПлощадь;
		НаборВидыПлощадей.Записать();
		
	КонецЕсли;
	
	Если Строка.ДополнительнаяПлощадь <> 0 тогда
		
		НаборВидыПлощадей.Отбор.Здание.Установить(Сооружение);
		НаборВидыПлощадей.Отбор.ВидПлощади.Установить(Справочники.ВидыПлощадей.ДополнительнаяПлощадь);
		
		НаборВидыПлощадей.Прочитать();
		
		НоваяПлощадь = НаборВидыПлощадей.Добавить();
		НоваяПлощадь.Здание = Сооружение;
		НоваяПлощадь.ВидПлощади = Справочники.ВидыПлощадей.ДополнительнаяПлощадь;
		
		НоваяПлощадь.Площадь =  Строка.ДополнительнаяПлощадь;
		НаборВидыПлощадей.Записать();
		
	КонецЕсли;

КонецПроцедуры

