&НаКлиенте
Процедура ПутьКФайлуНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Режим = РежимДиалогаВыбораФайла.Открытие;
	ДиалогОткрытияФайла = Новый ДиалогВыбораФайла(Режим);
	ДиалогОткрытияФайла.ПолноеИмяФайла = Объект.ПутьКФайлу;
	Фильтр = "Электронная таблица Excel(*.xls)|*.xls";
	ДиалогОткрытияФайла.Фильтр = Фильтр;
	ДиалогОткрытияФайла.МножественныйВыбор = Ложь;
	ДиалогОткрытияФайла.Заголовок = НСтр("ru='Выберите файл';uk='Виберіть файл'");
	Если ДиалогОткрытияФайла.Выбрать() Тогда
		Объект.ПутьКФайлу = ДиалогОткрытияФайла.ПолноеИмяФайла;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПараметрыЗданий()
	
	Для каждого Строка из Объект.ТаблицаЗданий Цикл
		
		Если Строка.ТипСооруженияНаименование = "Здание" Тогда
			Строка.ТипСооружения = Перечисления.ТипыСооружений.Здание;
		ИначеЕсли Строка.ТипСооруженияНаименование = "Паркинг" Тогда
			Строка.ТипСооружения = Перечисления.ТипыСооружений.Паркинг;
		ИначеЕсли Строка.ТипСооруженияНаименование = "Общежитие" Тогда
			Строка.ТипСооружения = Перечисления.ТипыСооружений.Общежитие;
		Иначе
			Строка.ТипСооружения = Перечисления.ТипыСооружений.ПустаяСсылка();
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьНаименованиеЗдания(Строка)
	
	Наименование ="";
	
	Если Строка.НомерДома <> "" Тогда
		Наименование = Наименование + "дом №" + Строка.НомерДома;
	КонецЕсли;
	Если Строка.Корпус <> "" Тогда
		Наименование = Наименование + ", корпус" + Строка.Корпус;
	КонецЕсли;
	Если Строка.Улица <> "" Тогда
		Наименование = Наименование + ", " + Строка.Улица;
	КонецЕсли;
	Если Строка.Район <> "" Тогда
		Наименование = Наименование + ", " + Строка.Район;
	КонецЕсли;
	Если Строка.Город <> "" Тогда
		Наименование = Наименование + ", " + Строка.Город;
	КонецЕсли;
	Если Строка.Область <> "" Тогда
		Наименование = Наименование + ", " + Строка.Область;
	КонецЕсли;
	Если Строка.Индекс <> "" Тогда
		Наименование = Наименование + ", " + Строка.Индекс;
	КонецЕсли;
	
	Возврат Наименование;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьПараметрыОбъектовЛС()
		
	Для Каждого Строка из Объект.ТаблицаОбъектовЛС Цикл
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	Подъезды.Ссылка
		               |ИЗ
		               |	Справочник.Подъезды КАК Подъезды
		               |ГДЕ
		               |	Подъезды.Владелец = &Владелец
		               |	И Подъезды.НомерПодъезда = &НомерПодъезда";
		
		Запрос.УстановитьПараметр("Владелец",Здание);
		Запрос.УстановитьПараметр("НомерПодъезда",Строка.ПодъездКод);
		
		СсылкаНаПодьезд = Запрос.Выполнить().Выгрузить();
		
		Если СсылкаНаПодьезд.Количество() = 0 Тогда
			СсылкаНаПодьезд = Справочники.Подъезды.СоздатьЭлемент();
			СсылкаНаПодьезд.НомерПодъезда = Строка.ПодъездКод;
			СсылкаНаПодьезд.Вид = "Подъезд";
			СсылкаНаПодьезд.Владелец = Здание;
			СсылкаНаПодьезд.ОбменДанными.Загрузка = Истина;
			СсылкаНаПодьезд.Наименование = "Подъезд № " + Строка.ПодъездКод;
			
			СсылкаНаПодьезд.Записать();
			Строка.Подъезд = СсылкаНаПодьезд.Ссылка;
		Иначе
			Строка.Подъезд = СсылкаНаПодьезд[0].Ссылка;
		КонецЕсли;
		
		Если Строка.ЖилойФондНаименование = "Нежилой фонд" 
			ИЛИ Строка.ЖилойФондНаименование = "Нет" 
			ИЛИ Строка.ЖилойФондНаименование = 0 Тогда
			Строка.ЖилойФонд = Перечисления.ЖилойНеЖилойФонд.НеЖилой;	
		Иначе
			Строка.ЖилойФонд = Перечисления.ЖилойНеЖилойФонд.Жилой;
		КонецЕсли;
		
	КонецЦикла;	
КонецПроцедуры

&НаСервере
Функция ПроверитьПолФизЛица(Значение)
	
	Если Значение = "Жен" ИЛИ Значение = "Ж" ИЛИ Значение = "Женский" Тогда
		
		Возврат Перечисления.ПолФизическогоЛица.Женский;
		
	Иначе
		
		Возврат Перечисления.ПолФизическогоЛица.Мужской;
	
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция ПолучитьНаименованиеОбъектаЛС(Строка)

	Если Строка.ЖилойФонд = Перечисления.ЖилойНеЖилойФонд.Жилой Тогда
		Наименование = "кв. №" + Прав("    "+Строка.НомерКвартиры,4) + Строка.Суффикс;
	Иначе
		Наименование = "оф. №" + Прав("    "+Строка.НомерКвартиры,4) + Строка.Суффикс;
	КонецЕсли;

	Возврат Наименование;
	
КонецФункции

&НаСервере
Функция ПроверитьЗаполнениеРеквизитов(МестоВызова)
	
	Если МестоВызова = "ОбъектыЛС" Тогда
		
		Если НЕ ЗначениеЗаполнено(Здание) Тогда
			Возврат "Здание не указано."
		ИначеЕсли НЕ ЗначениеЗаполнено(Дата) Тогда
			Возврат "Дата (для площадей) не указана."
		Иначе
			Возврат ""
		КонецЕсли;
		
	ИначеЕсли МестоВызова = "Здания" Тогда
		
		Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
			Возврат "Организация не указана."
		Иначе
			Возврат ""
		КонецЕсли;
		
	ИначеЕсли МестоВызова = "НачальныеОстатки" Тогда
		
		Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
			Возврат "Организация не указана."
		ИначеЕсли НЕ ЗначениеЗаполнено(Здание) Тогда
			Возврат "Здание не указано."
		ИначеЕсли НЕ ЗначениеЗаполнено(Дата) Тогда
			Возврат "Дата не указана."
		ИначеЕсли НЕ ПроверитьРеквизитыТаблицы(МестоВызова) Тогда
			Возврат "В таблице заполнены не все реквизиты."
		Иначе
			Возврат ""
		КонецЕсли;
		
	ИначеЕсли МестоВызова = "ПриборыУчета" Тогда
		
		Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
			Возврат "Организация не указана."
		ИначеЕсли НЕ ЗначениеЗаполнено(Здание) Тогда
			Возврат "Здание не указано."
		ИначеЕсли НЕ ПроверитьРеквизитыТаблицы(МестоВызова) Тогда
			Возврат "В таблице заполнены не все реквизиты."
		Иначе
			Возврат ""
		КонецЕсли;

	Иначе
		
		Возврат ""

	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ОФорматеНажатие(Элемент)
	ОткрытьСправкуФормы();
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Услуги.Ссылка
		|ИЗ
		|	Справочник.Услуги КАК Услуги
		|ГДЕ
		|	Услуги.ЭтоГруппа = ЛОЖЬ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВидыПломбПриборовУчета.Ссылка
		|ИЗ
		|	Справочник.ВидыПломбПриборовУчета КАК ВидыПломбПриборовУчета
		|ГДЕ
		|	ВидыПломбПриборовУчета.ПометкаУдаления = ЛОЖЬ";

	Результат = Запрос.ВыполнитьПакет();

	Выборка = Результат[0].Выбрать();

	Пока Выборка.Следующий() Цикл
		Услуга = СоответствиеУслуг.Добавить();
		Услуга.Услуга = Выборка.Ссылка;
	КонецЦикла;
	
	ВыборкаПломбы = Результат[1].Выбрать();

	Пока ВыборкаПломбы.Следующий() Цикл
		ВидПломбы = ВидыПломб.Добавить();
		ВидПломбы.ВидПломбы = ВыборкаПломбы.Ссылка;
	КонецЦикла;


КонецПроцедуры

&НаСервере
Функция ЗаполнитьУслуги(МестоВызова)
	
	Если МестоВызова = "ПриборыУчета" Тогда
		Таблица = Объект.ТаблицаПриборовУчета;
	ИначеЕсли МестоВызова = "НачальныеОстатки" Тогда
		Таблица = Объект.ТаблицаНачальныхОстатков;
	КонецЕсли;
	
	Для каждого Строка из Таблица Цикл
		Для каждого СтрокаСоответствия Из СоответствиеУслуг Цикл
			Если Строка.УслугаНаименование = СтрокаСоответствия.Наименование Тогда
				Строка.Услуга = СтрокаСоответствия.Услуга;
				Продолжить;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьЛицевыеСчета(МестоВызова)
	
	Если МестоВызова = "ПриборыУчета" Тогда
		Таблица = Объект.ТаблицаПриборовУчета;
	ИначеЕсли МестоВызова = "НачальныеОстатки" Тогда
		Таблица = Объект.ТаблицаНачальныхОстатков;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛицевыеСчета.Ссылка,
		|	ЛицевыеСчета.ОбъектЛицевогоСчета.Код КАК НомерКвартиры,
		|	ЛицевыеСчета.ОбъектЛицевогоСчета.Суффикс КАК Суффикс
		|ИЗ
		|	Справочник.ЛицевыеСчета КАК ЛицевыеСчета
		|ГДЕ
		|	ЛицевыеСчета.Владелец = &Владелец
		|	И ЛицевыеСчета.ОбъектЛицевогоСчета.ЖилойФонд = &ЖилойФонд";
		
	Запрос.УстановитьПараметр("Владелец", Здание);
	Запрос.УстановитьПараметр("ЖилойФонд", ?(МестоВызова = "ПриборыУчета",ЖилойФондПриборыУчета,ЖилойФондНачальныеОстатки));

	Результат = Запрос.Выполнить();

	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Для Каждого Строка ИЗ Таблица Цикл	
			Если Строка.НомерКвартиры = Строка(Выборка.НомерКвартиры)
				И Строка.Суффикс = Выборка.Суффикс Тогда
				Строка.ЛицевойСчет = Выборка.Ссылка;
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПараметрыСчетчиков()
	
	Для каждого Строка из Объект.ТаблицаПриборовУчета Цикл
		//Строка.Услуга = Справочники.Услуги.НайтиПоНаименованию(Строка.УслугаНаименование);
		Строка.ЕдиницаИзмерения = Строка.Услуга.ЕдиницаИзмерения;
		
		Если Строка.СпособРегистрацииНаименование = "Расход за период расчета" Тогда	
			Строка.СпособРегистрацииПоказаний = Перечисления.СпособыРегистрацииПоказанийСчетчиков.РасходЗаПериодРасчета;
		Иначе
			Строка.СпособРегистрацииПоказаний = Перечисления.СпособыРегистрацииПоказанийСчетчиков.НарастающимИтогом;
		КонецЕсли;
		
		Если Строка.ТарифностьНаименование = "3" Тогда	
			Строка.Тарифность = Перечисления.ТарифностьСчетчиков.Трехтарифный;
		ИначеЕсли Строка.ТарифностьНаименование = "2" Тогда
			Строка.Тарифность = Перечисления.ТарифностьСчетчиков.Двухтарифный;
		Иначе
			Строка.Тарифность = Перечисления.ТарифностьСчетчиков.Однотарифный;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПараметрыЛС()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	""ОбъектЛС"" КАК Вид,
		|	ОбъектыЛицевыхСчетов.Ссылка,
		|	ОбъектыЛицевыхСчетов.Код КАК Код,
		|	ОбъектыЛицевыхСчетов.Суффикс
		|ИЗ
		|	Справочник.ОбъектыЛицевыхСчетов КАК ОбъектыЛицевыхСчетов
		|ГДЕ
		|	ОбъектыЛицевыхСчетов.Владелец = &Владелец
		|	И ОбъектыЛицевыхСчетов.ЖилойФонд = &ЖилойФонд
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	""Потребитель"",
		|	ПотребителиУслуг.Ссылка,
		|	ПотребителиУслуг.Наименование,
		|	NULL
		|ИЗ
		|	Справочник.ПотребителиУслуг КАК ПотребителиУслуг";

	Запрос.УстановитьПараметр("Владелец", Здание);
	Запрос.УстановитьПараметр("ЖилойФонд", ЖилойФондЛицевыеСчета);

	Результат = Запрос.Выполнить();
	
	Выборка = Результат.Выбрать();
	
	Для каждого Строка из Объект.ТаблицаЛицевыхСчетов Цикл
		Выборка.Сбросить();
		Пока Выборка.Следующий() Цикл
			Если ЗначениеЗаполнено(Строка.ОбъектЛицевогоСчета) 
				И ЗначениеЗаполнено(Строка.ОтветственныйВладелец) Тогда
				Прервать;
			ИначеЕсли Выборка.Вид = "ОбъектЛС" Тогда
				Если Число(Строка.НомерКвартиры) = Выборка.Код 
					И Строка.Суффикс = Выборка.Суффикс Тогда
					Строка.ОбъектЛицевогоСчета = Выборка.Ссылка;
				КонецЕсли;		
			ИначеЕсли Выборка.Вид = "Потребитель" Тогда
				Если Строка.ОтветственныйВладелецФИО = Выборка.Код Тогда
					Строка.ОтветственныйВладелец = Выборка.Ссылка;
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаПриборовУчетаУслугаПриИзменении(Элемент)
	ТекущиеДанные = Элементы.ТаблицаПриборовУчета.ТекущиеДанные;
	ТекущиеДанные.ЕдиницаИзмерения = ПолучитьЕдиницуИзмерения(ТекущиеДанные.Услуга);
КонецПроцедуры

&НаСервере
Функция ПолучитьЕдиницуИзмерения(Услуга)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Услуги.Ссылка,
		|	Услуги.ЕдиницаИзмерения
		|ИЗ
		|	Справочник.Услуги КАК Услуги
		|ГДЕ
		|	Услуги.Ссылка = &Ссылка";

	Запрос.УстановитьПараметр("Ссылка", Услуга);

	Результат = Запрос.Выполнить();

	Выборка = Результат.Выбрать();

	Пока Выборка.Следующий() Цикл
		Возврат Выборка.ЕдиницаИзмерения;
	КонецЦикла;

КонецФункции

&НаСервере
Функция ПроверитьРеквизитыТаблицы(МестоВызова)
	
	Если МестоВызова = "ПриборыУчета" Тогда
		
		Таблица = Объект.ТаблицаПриборовУчета;
		
		Для Каждого Строка из Таблица Цикл
			Если Строка.Загружать = Истина Тогда
				
				Если НЕ ЗначениеЗаполнено(Строка.ЗаводскойНомер) Тогда
					Возврат  Ложь;
				ИначеЕсли НЕ ЗначениеЗаполнено(Строка.Тарифность) Тогда
					Возврат  Ложь;
				ИначеЕсли НЕ ЗначениеЗаполнено(Строка.Разрядность) Тогда
					Возврат  Ложь;
				ИначеЕсли НЕ ЗначениеЗаполнено(Строка.Коэффициент) Тогда
					Возврат  Ложь;
				ИначеЕсли НЕ ЗначениеЗаполнено(Строка.СпособРегистрацииПоказаний) Тогда
					Возврат  Ложь;
				ИначеЕсли НЕ ЗначениеЗаполнено(Строка.ДатаВключения) Тогда
					Возврат  Ложь;
				ИначеЕсли НЕ ЗначениеЗаполнено(Строка.Услуга) Тогда
					Возврат  Ложь;
				ИначеЕсли НЕ ЗначениеЗаполнено(Строка.ЛицевойСчет) Тогда
					Возврат  Ложь;
				ИначеЕсли НЕ ЗначениеЗаполнено(Строка.ЕдиницаИзмерения) Тогда
					Возврат  Ложь;
				Иначе
					Возврат Истина;
				КонецЕсли;
			
			КонецЕсли;
		КонецЦикла;
		
	ИначеЕсли МестоВызова = "НачальныеОстатки" Тогда
		
		Таблица = Объект.ТаблицаНачальныхОстатков;
		
		Для Каждого Строка из Таблица Цикл
			Если Строка.Загружать = Истина Тогда
				
				Если НЕ ЗначениеЗаполнено(Строка.ЛицевойСчет) Тогда
					Возврат  Ложь;
				ИначеЕсли НЕ ЗначениеЗаполнено(Строка.Сумма) Тогда
					Возврат  Ложь;
				Иначе
					Возврат Истина;
				КонецЕсли;
				
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;

	Возврат Истина;
	
КонецФункции

&НаСервере
Функция ПроверитьТаблицуНаПустоту(МестоВызова)

	Если МестоВызова = "Здания" Тогда
		Таблица = Объект.ТаблицаЗданий;
	ИначеЕсли МестоВызова = "ОбъектыЛС" Тогда
		Таблица = Объект.ТаблицаОбъектовЛС;
    ИначеЕсли МестоВызова = "ФизЛица" Тогда
		Таблица = Объект.ТаблицаФизЛиц;
    ИначеЕсли МестоВызова = "ЛицевыеСчета" Тогда
		Таблица = Объект.ТаблицаЛицевыхСчетов;
	ИначеЕсли МестоВызова = "ПриборыУчета" Тогда
		Таблица = Объект.ТаблицаПриборовУчета;
    ИначеЕсли МестоВызова = "НачальныеОстатки" Тогда
		Таблица = Объект.ТаблицаНачальныхОстатков;
    КонецЕсли;
	
	ПустаяТаблица = Истина;
	
	Для каждого Строка из Таблица Цикл
		Если Строка.Загружать = Истина Тогда
			ПустаяТаблица = Ложь;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ПустаяТаблица;
	
КонецФункции

&НаКлиенте
Процедура ОтметитьПриборыУчета(Команда)
	Для каждого Строка из Объект.ТаблицаПриборовУчета Цикл
		Строка.Загружать = Истина;
	КонецЦикла;
КонецПроцедуры

