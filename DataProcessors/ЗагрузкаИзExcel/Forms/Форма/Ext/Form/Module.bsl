&НаСервере
Процедура СоздатьДокументУстановкиПрибораУчета(Счетчик,Строка)
		
	Установка = Документы.УправлениеПриборамиУчета.СоздатьДокумент();
	Установка.ВидОперации = Перечисления.ВидыОперацийУправленияПриборамиУчета.УстановкаПрибораУчета;
	Установка.ОбъектУстановки = Строка.ЛицевойСчет;
	Установка.Здание = Здание;
	Установка.Организация = Объект.Организация;
	Установка.Комментарий = "Документ сформирован обработкой ""Ввод начальных остатков"".";
	Установка.Дата = ТекущаяДата();
				
	НоваяСтрока = Установка.ПриборыУчета.Добавить();
	НоваяСтрока.ДатаВключения = Строка.ДатаВключения;
	НоваяСтрока.ВидТарифа = Перечисления.ВидыТарифов.Общий;
	НоваяСтрока.НачальноеПоказание = Строка.НачальноеПоказание;
	НоваяСтрока.ПриборУчета = Счетчик;
	
	Установка.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
	
КонецПроцедуры

&НаСервере
Процедура СоздатьДокументыУправленияУслугами()
	
	Если ПроверитьТаблицуНаПустоту("НачальныеОстатки") Тогда
		
		СообщениеОбОшибке = "Нет строк отмеченных для загрузки.";
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Документы управления услугами не удалось создать. "+СообщениеОбОшибке;
		Сообщение.Сообщить();
		Возврат;
		
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Дата) Тогда
		
		СообщениеОбОшибке = "Нет строк отмеченных для загрузки.";
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Документ управления услугами не удалось создать. Дата не указана.";
		Сообщение.Сообщить();
		Возврат;
		
	КонецЕсли;
	Таблица = Объект.ТаблицаНачальныхОстатков.Выгрузить();
	ТаблицаЛС = Таблица.Скопировать(,"ЛицевойСчет,Услуга");
	Менеджер=Новый МенеджерВременныхТаблиц;
	Запрос=Новый Запрос;
	Запрос.Текст=
	"ВЫБРАТЬ
	|	ТаблицаЛС.ЛицевойСчет,
	|	ТаблицаЛС.Услуга
	|ПОМЕСТИТЬ ТаблицаЛС
	|ИЗ
	|	&ТаблицаЛС КАК ТаблицаЛС";
	Запрос.УстановитьПараметр("ТаблицаЛС",ТаблицаЛС);
	Запрос.МенеджерВременныхТаблиц=Менеджер;
	Результат=Запрос.Выполнить();
	Запрос.Текст=
	"ВЫБРАТЬ
	|	ТаблицаЛС.ЛицевойСчет,
	|	ТаблицаЛС.Услуга
	|ИЗ
	|	ТаблицаЛС КАК ТаблицаЛС
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаЛС.ЛицевойСчет,
	|	ТаблицаЛС.Услуга
	|
	|УПОРЯДОЧИТЬ ПО
	|	ТаблицаЛС.ЛицевойСчет
	|АВТОУПОРЯДОЧИВАНИЕ";

	Результат = Запрос.Выполнить();

	Выборка = Результат.Выбрать();
    ПредыдущийЛС = Справочники.ЛицевыеСчета.ПустаяСсылка();
	Пока Выборка.Следующий() Цикл
		Если ПредыдущийЛС = Справочники.ЛицевыеСчета.ПустаяСсылка() Тогда
			ПредыдущийЛС = Выборка.ЛицевойСчет;
			
			Документ = Документы.УправлениеУслугами.СоздатьДокумент();
			Документ.Дата = Дата;
			Документ.Здание = ПредыдущийЛС.Владелец;
			Документ.Организация = Документ.Здание.Владелец;
			Документ.Комментарий = "Документ сформирован обработкой ""Ввод начальных остатков"".";
			НовыйСчет = Документ.ЛицевыеСчета.Добавить();
			НовыйСчет.ЛицевойСчет = ПредыдущийЛС;			
			НоваяУслуга = Документ.Услуги.Добавить();
			НоваяУслуга.Услуга = Выборка.Услуга;
					
		ИначеЕсли ПредыдущийЛС = Выборка.ЛицевойСчет Тогда
			
			НоваяУслуга = Документ.Услуги.Добавить();
			НоваяУслуга.Услуга = Выборка.Услуга;

		ИначеЕсли ПредыдущийЛС <> Выборка.ЛицевойСчет Тогда
			Документ.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
			
			ПредыдущийЛС = Выборка.ЛицевойСчет;
			
			Документ = Документы.УправлениеУслугами.СоздатьДокумент();
			Документ.Дата = Дата;
			Документ.Здание = ПредыдущийЛС.Владелец;
			Документ.Организация = Документ.Здание.Владелец;
			Документ.Комментарий = "Документ сформирован обработкой ""Ввод начальных остатков"".";
			НовыйСчет = Документ.ЛицевыеСчета.Добавить();
			НовыйСчет.ЛицевойСчет = ПредыдущийЛС;			
			НоваяУслуга = Документ.Услуги.Добавить();
			НоваяУслуга.Услуга = Выборка.Услуга;

		КонецЕсли;
	КонецЦикла;
	
	Документ.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
	
КонецПроцедуры

