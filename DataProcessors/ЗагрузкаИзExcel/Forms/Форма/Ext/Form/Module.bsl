&НаКлиенте
Процедура ЗаполнитьТаблицуЗданий(Команда)
	
	Если НЕ ЗначениеЗаполнено(Объект.ПутьКФайлу) Тогда
		
		Сообщить(НСтр("ru='Укажите путь к файлу.';uk='Вкажіть шлях до файлу.'"));
		Возврат;
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
		
		Сообщить(НСтр("ru='Укажите организацию.';uk='Вкажіть організацію'"));
		Возврат;
		
	КонецЕсли;
	
	Если Объект.ТаблицаЗданий.Количество() > 0 Тогда
		Ответ = Вопрос(НСтр("ru='Табличная часть будет очищена! Продолжить выполнение операции?';uk='Таблична частина буде очищена! Продовжити виконання операції'"), РежимДиалогаВопрос.ДаНет, 0);
		Если Ответ <> КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли; 
	КонецЕсли;
	
	Путь = Объект.ПутьКФайлу;
	Объект.ТаблицаЗданий.Очистить();
	Попытка
		Excel = Новый COMОбъект("Excel.application");	
	Исключение
		Сообщить(НСтр("ru='Не удалось подключиться';uk='Не вдалося підключитися'") + информацияОбОшибке());
		Возврат;
	КонецПопытки;
	
	Excel.Workbooks.Open(Путь);
	Sheet = Excel.Sheets(1);
	Sheet = Excel.ActiveWorkbook;
	КоличествоСтрок = Excel.Cells.CurrentRegion.Rows.Count;
	
	Для Счетчик=2 По КоличествоСтрок Цикл
		
		НоваяСтрока = Объект.ТаблицаЗданий.Добавить();
		НоваяСтрока.ТипСооруженияНаименование = Excel.Cells(Счетчик, 1).Value;
		НоваяСтрока.Область = Excel.Cells(Счетчик, 2).Value;
		НоваяСтрока.Город = Excel.Cells(Счетчик, 3).Value;
		НоваяСтрока.Район = Excel.Cells(Счетчик, 4).Value;
		НоваяСтрока.Улица = Excel.Cells(Счетчик, 5).Value;
		НоваяСтрока.Корпус = Excel.Cells(Счетчик, 6).Value;
		НоваяСтрока.НомерДома = Excel.Cells(Счетчик, 7).Value;
		НоваяСтрока.Индекс = Excel.Cells(Счетчик, 8).Value;
		НоваяСтрока.ДатаПринятияНаБаланс = Excel.Cells(Счетчик, 9).Value;
		НоваяСтрока.ДатаВводаВЭксплуатацию = Excel.Cells(Счетчик, 10).Value;
		НоваяСтрока.КоличествоПодъездов = Excel.Cells(Счетчик, 11).Value;
		НоваяСтрока.КоличествоЛифтов = Excel.Cells(Счетчик, 12).Value;
		НоваяСтрока.ОбщаяПлощадь = Excel.Cells(Счетчик, 13).Value;
		НоваяСтрока.ОтапливаемаяПлощадь = Excel.Cells(Счетчик, 14).Value;
		НоваяСтрока.ЖилаяПлощадь = Excel.Cells(Счетчик, 15).Value;
		НоваяСтрока.ДополнительнаяПлощадь = Excel.Cells(Счетчик, 16).Value;
		НоваяСтрока.Префикс = Excel.Cells(Счетчик, 17).Value;
		
	КонецЦикла;
	
	Excel.Workbooks.Close();
	ЗаполнитьПараметрыЗданий();
	ПроверитьУникальность("Здания");
		
КонецПроцедуры

